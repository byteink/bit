// compiler/validateattrsymbol.bit — FUNCTION-attribute name resolution and the
// `@symbol` pin (SPEC §10.3.1, §11.9), moved out of validateattr.bit. A sibling
// .bit file is the same module, so this needs no import and no call-site
// change.
//
// Split for the 800-line ceiling (spec/LINT.md E0200): #3879 widened the
// attribute argument grammar, which moved the "@symbol takes exactly one string
// literal" rule out of the parser and into `vSymbolAttrPin` here, and took
// validateattr.bit to 810.
//
// The seam is the attribute list itself: `vAttrNames` and everything it
// dispatches into. What is left behind in validateattr.bit is what the
// attributes IMPLY about the declaration they sit on — @naked's signature rule
// and @nosplit's call-graph walk — plus the type-node validation that file also
// carries. Nothing here knows about the field attributes of §10.5; those are
// resolved by ordinary name lookup and live in classfieldattr.bit.
//
// The block was reformatted on the way across (`bit fmt`): validateattr.bit is
// on the #4099 fmt debt list and every line moved carried that file's pre-fmt
// style, which a NEW file may not. The reformat is whitespace only — no line
// was added or removed except by wrapping, and the eight `@symbol`/`@naked`
// golden fixtures are byte-identical before and after.

// §11.9: a name C can actually refer to — a letter or '_', then letters, digits
// or '_'. Deliberately narrower than what ELF/Mach-O permit: a name outside this
// set assembles fine but cannot be spelled from C, which defeats the point of a
// pin, and '$' in particular is how this compiler's own mangling is written.
// Strict ASCII, so this cannot reuse the lexer's `isIdentStart` (which admits
// every byte >= 0x80 to keep non-ASCII identifiers lexing).
fn vIsValidSymbolName(s: string): bool {
  if (len(s) == 0) {
    return false
  }
  let f = s[0]
  if (!((f >= 'a' && f <= 'z') || (f >= 'A' && f <= 'Z') || f == '_')) {
    return false
  }
  let i = 1
  while (i < len(s)) {
    let ch = s[i]
    if (!((ch >= 'a' && ch <= 'z') ||
      (ch >= 'A' && ch <= 'Z') ||
      (ch >= '0' && ch <= '9') ||
      ch == '_')) {
      return false
    }
    i = i + 1
  }
  return true
}

// Resolves the attr list, reporting E0076 (§10.3.1) for any name other than
// @naked/@nosplit/@symbol and E0079 (§11.9) for a malformed argument, and
// returns the pinned symbol name ("" when the decl pins none). Mirrors the
// seed's collectAttrs, which likewise reports as it resolves and yields the pin
// only once the argument has passed both rules — so a malformed pin never also
// draws the signature diagnostics below.
fn vAttrNames(c: Checker, node: int): string {
  let list = vAttrList(c, node)
  if (list == 0) {
    return ""
  }
  let pin = ""
  let attrs = kidsOf(c.tree, list)
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i]) // [name_ident, arg...]
    if (vIdentText(c, ak[0]) == "symbol") {
      let text = vSymbolAttrPin(c, ak)
      if (text != "") {
        pin = text
      }
    } else {
      vPlainFuncAttr(c, ak)
    }
    i = i + 1
  }
  return pin
}

// `@symbol("name")`'s argument: the pinned name, or "" when the attribute is
// malformed (already reported). Split out of `vAttrNames` above, which #3879's
// widened argument grammar took to McCabe 12 — the two attribute FAMILIES
// (`@symbol`, which takes an argument, and the two that do not) are the natural
// seam, and each half is now readable on its own.
//
// Argument children are ELIDED when there are none, so an attr-with-no-argument
// keeps the exact 1-kid shape it had before arguments existed (parserdecl.bit).
// The grammar admits a LIST of expressions since #3879, because a FIELD
// attribute takes one — a FUNCTION attribute still takes at most one, and only
// `@symbol`, and only a string literal. Anything else is E0079 here rather than
// the parse error it used to be: that error could only say "expected a string
// literal argument" and could not say which attribute was at fault.
fn vSymbolAttrPin(c: Checker, ak: []int): string {
  let arg = 0
  if (len(ak) == 2 && getNode(c.tree, ak[1]).tag == Tag.StringLit) {
    arg = ak[1]
  }
  if (arg == 0) {
    // Distinguish "none given" from "the wrong thing given": the second
    // reports at the offending argument, which is what a reader needs.
    let at = ak[0]
    if (len(ak) > 1) {
      at = ak[1]
    }
    report(
      c.diags, ecSymbolAttrInvalid, vSpan(c, at),
      "attribute '@symbol' requires a string argument",
      "write @symbol(\"the_exported_name\")",
    )
    return ""
  }
  // The raw literal minus its quotes. A symbol name has no use for escapes, and
  // every escape introduces a '\', which vIsValidSymbolName rejects — so no
  // unescaping is needed.
  let raw = vIdentText(c, arg)
  let text = raw[1:len(raw) - 1]
  if (!vIsValidSymbolName(text)) {
    report(
      c.diags, ecSymbolAttrInvalid, vSpan(c, arg),
      "'${text}' is not a valid symbol name",
      "a symbol name must be a C identifier: a letter or '_' followed by letters, digits or '_'",
    )
    return ""
  }
  return text
}

// An attribute in FUNCTION position that is not `@symbol`: it takes no
// argument, and only `@naked` and `@nosplit` are recognized (E0076). Field
// attributes (§10.5, #3879) never reach here — they are resolved by ordinary
// name lookup and the compiler knows none of them by name.
fn vPlainFuncAttr(c: Checker, ak: []int) {
  let name = vIdentText(c, ak[0])
  if (len(ak) > 1) {
    reportNoHint(
      c.diags, ecSymbolAttrInvalid, vSpan(c, ak[1]),
      "attribute '@${name}' does not take an argument",
    )
  }
  if (name != "naked" && name != "nosplit") {
    report(
      c.diags, ecUnknownAttribute, vSpan(c, ak[0]),
      "unknown attribute '@${name}'",
      "the recognized attributes are @naked, @nosplit and @symbol",
    )
  }
}

// E0079/E0080 (§11.9): validates a `@symbol("name")` pin and claims the name
// project-wide. A pinned function DEFINES the C symbol `name`, so its signature
// has to be one the C ABI can actually carry — the same `vIsCAbiType` §11.7
// applies in the consuming direction, since both use the one shared C-ABI
// marshaller and neither marshals anything else.
//
// The `cannot be variadic` rule became reachable when parseParam learned
// `...name: T` (#1418), for the same reason it did in vExternFnDecl.
fn vPinnedSymbol(c: Checker, node: int, sym: string) {
  let k = kidsOf(c.tree, node) // [recv, name, generics, params, result, body, attrs]
  let name = vIdentText(c, k[1])
  // A generic function has no single body to give a single symbol: it is emitted
  // once per instantiation, each needing a distinct name.
  if (k[2] != 0) {
    report(
      c.diags, ecSymbolAttrInvalid, vSpan(c, k[1]),
      "generic function '${name}' cannot pin a symbol name",
      "each instantiation would need its own symbol",
    )
    return
  }
  let params = kidsOf(c.tree, k[3])
  let i = 0
  while (i < len(params)) {
    let pk = kidsOf(c.tree, params[i]) // [name, type]
    let pt = typeFromNode(c, pk[1])
    // A pinned symbol is called across the C ABI, which cannot carry a Bit
    // variadic. Reported at the whole param node, and it replaces the C-ABI
    // check for that parameter — the seed's else-if.
    if (getNode(c.tree, params[i]).tag == Tag.ParamRest) {
      reportNoHint(
        c.diags, ecSymbolAttrInvalid, vSpan(c, params[i]),
        "function '${name}' pinning a symbol cannot be variadic",
      )
    } else if (pt != 0 && !vIsCAbiType(c, pt)) {
      // An unresolved type (0) is bit2's inference gap, not the program's —
      // reporting it would be a false positive on code the seed accepts.
      report(
        c.diags, ecSymbolAttrInvalid, vSpan(c, pk[1]),
        "parameter of '${name}' must be a scalar or a raw pointer to pin a symbol",
        "the C ABI has no representation for a GC-managed Bit value",
      )
    }
    i = i + 1
  }
  // The RAW result node is what is checked, so a fallible `T!E` fails this too —
  // it returns through the thread-local error slot, not the C return register,
  // and is neither a prim nor a ptr.
  if (k[4] != 0) {
    let rt = typeFromNode(c, k[4])
    if (rt != 0 && !vIsCAbiType(c, rt)) {
      reportNoHint(
        c.diags, ecSymbolAttrInvalid, vSpan(c, k[4]),
        "'${name}' must return void, a scalar, or a raw pointer to pin a symbol",
      )
    }
  }
  // Claim the name. The identity packs the declaring module with the decl node:
  // node indices only mean something inside their own tree, so the module id is
  // what keeps two modules' node 7 apart. Re-registering the same decl is a
  // no-op, which is what makes a repeated `checkModule` over one tree safe.
  let owner = c.moduleId * 4294967296 + node
  let (prev, seen) = c.ctx.pinnedSymbols[sym]
  if (seen && prev != owner) {
    report(
      c.diags, ecDuplicateSymbol, vSpan(c, k[6]),
      "symbol '${sym}' is already pinned by another declaration",
      "each pinned symbol name must be defined exactly once",
    )
    return
  }
  c.ctx.pinnedSymbols[sym] = owner
}
