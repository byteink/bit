// In-Bit self-checks for the AArch64 signed-multiply overflow trap (#3084,
// SPEC §13.5). Split out of compiler/arm64selcheck.bit rather than added
// there directly: that file has too little headroom left under the 800-line
// limit for both the general-multiply and power-of-two-fold variants below.
// Sibling .bit file, same module: `selCtx`/`wantOverflowTrap` (arm64selcheck.bit)
// and `noPow2Factor`/`Pow2Factor` (x64call.bit) are used directly, no import.

// AArch64's MUL/MADD never sets flags, unlike ADD/SUB's ADDS/SUBS (#3080) or
// NEG's NEGS (#3081) — so width 8 needs SMULH (the true-high-64-bits check,
// arm64selectovf.bit's emitMulOverflowTrap64) rather than a B.VC. Narrower
// widths can never truly overflow 64 bits (both operands are already
// sign-extended values of that narrower type) and reuse `emitOverflowTrap`'s
// re-narrow-and-compare arm unchanged — same split `checkArm64UnaryOverflowTrapWidth`
// exercises for negation.
fn checkArm64MulOverflowTrapWidth(bytes: int) {
  let ws = mkWidth(bytes, RegClass.Int, true)
  let wu = mkWidth(bytes, RegClass.Int, false)

  // Release, signed: unchanged from before this ticket — the regression
  // guard for the release path (acceptance: byte-identical to pre-#3084).
  let cxRel = selCtx()
  emitMulInt(cxRel, 0, 1, 2, noPow2Factor(), ws)
  let wantRel = newByteBuf()
  mulRR(wantRel, 0, 1, 2)
  if (bytes < 8) {
    extendRegA(wantRel, 0, 0, bytes, true)
  }
  assertSameBytes(cxRel.code, wantRel)

  // Debug, signed: traps. At width 8, SMULH runs BEFORE the low-bits MUL
  // (arm64selectovf.bit's emitMulRR) so it still reads the original operands.
  let cxDbg = selCtx()
  cxDbg.debug = true
  emitMulInt(cxDbg, 0, 1, 2, noPow2Factor(), ws)
  let wantDbg = newByteBuf()
  if (bytes == 8) {
    smulhRR(wantDbg, scratch3(), 1, 2)
    mulRR(wantDbg, 0, 1, 2)
    asrImm(wantDbg, scratch2(), 0, 63)
    cmpRR(wantDbg, scratch3(), scratch2())
    wantOverflowTrap(wantDbg, condEq())
  } else {
    mulRR(wantDbg, 0, 1, 2)
    extendRegA(wantDbg, scratch2(), 0, bytes, true)
    cmpRR(wantDbg, scratch2(), 0)
    wantOverflowTrap(wantDbg, condEq())
    extendRegA(wantDbg, 0, 0, bytes, true) // canonNarrow's own re-narrow
  }
  assertSameBytes(cxDbg.code, wantDbg)

  // Debug, unsigned: SPEC 13.5 — unsigned multiply always wraps, even in a
  // debug build. Byte-identical to the release sequence at this width.
  let cxDbgU = selCtx()
  cxDbgU.debug = true
  emitMulInt(cxDbgU, 0, 1, 2, noPow2Factor(), wu)
  let wantU = newByteBuf()
  mulRR(wantU, 0, 1, 2)
  if (bytes < 8) {
    extendRegA(wantU, 0, 0, bytes, false)
  }
  assertSameBytes(cxDbgU.code, wantU)
  let cxRelU = selCtx()
  emitMulInt(cxRelU, 0, 1, 2, noPow2Factor(), wu)
  assertSameBytes(cxRelU.code, wantU)
}

// The `x * 2^k` strength-reduction fold (#3105) is genuinely different: LSL
// sets no flag a signed overflow check could read, at any width. Width 8
// shifts the result back down by `k` (arithmetic) and compares against a
// scratch3 copy of the pre-shift operand, preserved before the shift can
// clobber it (`emitPow2MulOverflowTrap64`, arm64selectovf.bit) — the ticket's
// own acceptance test (`i64 MAX * 2`) exercises exactly this path, not the
// general multiply above, since 2 is a power of two.
fn checkArm64Pow2MulOverflowTrapWidth(bytes: int) {
  let ws = mkWidth(bytes, RegClass.Int, true)
  let wu = mkWidth(bytes, RegClass.Int, false)
  let factor = Pow2Factor{ value: 1, k: 1 }

  // Release, signed: unchanged from before this ticket.
  let cxRel = selCtx()
  emitMulInt(cxRel, 0, 1, 2, factor, ws)
  let wantRel = newByteBuf()
  lslImm(wantRel, 0, 1, 1)
  if (bytes < 8) {
    extendRegA(wantRel, 0, 0, bytes, true)
  }
  assertSameBytes(cxRel.code, wantRel)

  // Debug, signed: traps. `v` (vreg 1) is copied to scratch3 BEFORE the
  // shift at width 8, since `d` (vreg 0) may alias it once spilled.
  let cxDbg = selCtx()
  cxDbg.debug = true
  emitMulInt(cxDbg, 0, 1, 2, factor, ws)
  let wantDbg = newByteBuf()
  if (bytes == 8) {
    movRR(wantDbg, scratch3(), 1)
    lslImm(wantDbg, 0, 1, 1)
    asrImm(wantDbg, scratch2(), 0, 1)
    cmpRR(wantDbg, scratch2(), scratch3())
    wantOverflowTrap(wantDbg, condEq())
  } else {
    lslImm(wantDbg, 0, 1, 1)
    extendRegA(wantDbg, scratch2(), 0, bytes, true)
    cmpRR(wantDbg, scratch2(), 0)
    wantOverflowTrap(wantDbg, condEq())
    extendRegA(wantDbg, 0, 0, bytes, true) // canonNarrow's own re-narrow
  }
  assertSameBytes(cxDbg.code, wantDbg)

  // Debug, unsigned: never traps (SPEC 13.5), byte-identical to release.
  let cxDbgU = selCtx()
  cxDbgU.debug = true
  emitMulInt(cxDbgU, 0, 1, 2, factor, wu)
  let wantU = newByteBuf()
  lslImm(wantU, 0, 1, 1)
  if (bytes < 8) {
    extendRegA(wantU, 0, 0, bytes, false)
  }
  assertSameBytes(cxDbgU.code, wantU)
  let cxRelU = selCtx()
  emitMulInt(cxRelU, 0, 1, 2, factor, wu)
  assertSameBytes(cxRelU.code, wantU)
}

fn checkArm64MulOverflowTrap() {
  checkArm64MulOverflowTrapWidth(8)
  checkArm64MulOverflowTrapWidth(1)
  checkArm64MulOverflowTrapWidth(2)
  checkArm64MulOverflowTrapWidth(4)
  checkArm64Pow2MulOverflowTrapWidth(8)
  checkArm64Pow2MulOverflowTrapWidth(1)
  checkArm64Pow2MulOverflowTrapWidth(2)
  checkArm64Pow2MulOverflowTrapWidth(4)
}
