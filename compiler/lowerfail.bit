// compiler/lowerfail.bit — split out of lowerctrl.bit (#2939) to keep it
// under the 800-line limit; see lowerctrl.bit for loop/binding/defer lowering.
// Sibling of lowerctrl.bit: same module, so this needs no imports and no
// call-site changes. The fallible-result error channel (SPEC §18): `fail`,
// `?`, `catch`, and the `err_get`/`err_set` runtime primitives underneath them.

// ---- fallible-result error channel (SPEC §18) -----------------------------

// `err_set(e)` — publish the pending error for the caller's `?`/`catch`. Under
// the word convention (`errInReg`) the slot is dead: the error travels as the
// last return word, so every `setErr`/`clearErr` below emits nothing (#6690).
fn setErr(fc: FnCtx, val: int) {
  if (errInReg(fc.lowerer)) {
    return
  }
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ins.name = "err_set"
  ins.args = [val]
  emitRtCall(fc, ins)
}

// `err_set(nil)` — an ok return / handled `catch` clears the slot.
fn clearErr(fc: FnCtx) {
  if (errInReg(fc.lowerer)) {
    return
  }
  let nl = mkInstr(Op.ConstNil, fc.c.ctx.errorId)
  setErr(fc, builderEmit(fc.b, nl))
}

// ---- #6686: the error as the LAST RETURN WORD (BIT_ERR_REG) ----------------
//
// A plain free function that returns its error in a register hands back its ok
// words followed by one error word typed `errSlotTy`; every direct caller binds
// that word with a trailing `Op.CallWord` and tests it, so the per-task slot is
// not read. The slot is neither written nor read under this convention
// (`setErr`/`clearErr` emit nothing, `takeCallErr` asserts a word exists); only
// x86_64-windows and BIT_ERR_REG=0 keep it (#6690). Decided from the declaration alone, like
// `explodesParams`, because the callee's `ret` and every call site are lowered
// in different functions and must agree.

// The rollout flag. Default on (#6693); `BIT_ERR_REG=0` selects the slot. The
// IR differentials pin it to 0 (scripts/selfhost-diffdump-setup.sh) because the
// pinned oracle still emits the slot. Delete the flag and that pin at the repin
// that carries #6693.
fn errRegEnabled(): bool {
  return envOr("BIT_ERR_REG", "1") != "0"
}

// Windows keeps the slot until `multiWordRet` is on there (#5875).
fn errInReg(lo: Lowerer): bool {
  return lo.multiWordRet && errRegEnabled()
}

// The `T!E` type `decl` declares when it returns its error as a word, else 0.
// EVERY declared function that is fallible and has a body to lower (an
// `extern` has none, so its callers must not look for a word): free
// functions (a fallible `main` included: `emitFallibleMainWrapper` binds its
// word), methods, static or not, and generic instances. The answer is the
// declared type, so for a generic declaration it is the TEMPLATE's (`T` still
// `T`): a call site types the word from its own substituted type instead
// (`errWordTy`).
//
// The rule is TOTAL on purpose. A call producer that appends the word to a
// callee that does not write it reads garbage, and the dual publish cannot
// repair that, so the callee's `ret` (`lowerFuncNamed` sets `fc.errReg` from
// this) and every producer decide from this one function, which reads the
// declaration alone. The VTABLE case is the one that cannot be seen from a
// call site: `emitIfaceMethodCall` appends the word for any interface
// signature with a fallible result, and the body it reaches is whatever the
// vtable names. Every such body is a declared method, lowered by
// `lowerFuncNamed`: the other `FnCtx`/IrFunc producers (closures in
// lowerfuncval.bit, the trampolines in lowertrampoline.bit, lowerentry.bit,
// lowerstartup.bit, lowertableregistry.bit, testgen.bit) build no methods. The
// checker refuses a method whose result is not fallible for a fallible
// interface signature (E0041: "'Fixed.read' is () => i64, but 'Reader' needs
// () => i64!"), so every implementation is fallible, is therefore a decl for
// which this answers non-zero, and writes the word.
fn errWordRaw(c: Checker, decl: int, lo: Lowerer): int {
  if (!errInReg(lo) || decl == 0 || isExternDecl(c.tree, decl)) {
    return 0
  }
  let rn = kidsOf(c.tree, decl)[4]
  if (rn == 0) {
    return 0
  }
  let raw = typeFromNode(c, rn)
  if (raw == 0 || c.ctx.types[raw].kind != TypeKind.Fallible) {
    return 0
  }
  return raw
}

fn errWordDecl(c: Checker, decl: int, lo: Lowerer): bool {
  return errWordRaw(c, decl, lo) != 0
}

// The fallible type a call site binds the error word of: `ty`, the call's own
// (substituted) result type, when it is a `T!E` and the callee `decl` returns
// the word; else 0 and the caller reads the slot, which the callee still
// publishes. Taken from the call, not the declaration, so a generic callee's
// word is typed with the instantiation's error type.
fn errWordTy(fc: FnCtx, owner: Checker, decl: int, ty: int): int {
  if (ty == 0 || fc.c.ctx.types[ty].kind != TypeKind.Fallible) {
    return 0
  }
  if (!errWordDecl(owner, decl, fc.lowerer)) {
    return 0
  }
  return ty
}

// Whether a fallible result's ok words, plus the one Int word the error takes,
// fit the return registers (`declPlainResultType`, lowerexplode.bit). With the
// flag off the error needs no register and only the ok words are asked.
fn fallibleOkWordsAdmitted(ctx: TypeContext, ok: int): bool {
  let words = fallibleOkWordTypes(ctx, ok)
  if (len(words) == 0) {
    return false
  }
  if (!errRegEnabled()) {
    return true
  }
  let withErr = []int(0)
  for w of words {
    withErr = append(withErr, w)
  }
  return retWordsFitRegisters(ctx, append(withErr, primType(ctx, 3)))
}

// `nil` of the error slot representation: the error word an ok `ret` carries.
fn okErrWord(fc: FnCtx): int {
  return builderEmit(fc.b, mkInstr(Op.ConstNil, errSlotTy(fc, fc.fallibleErr)))
}

// Appends the error word of a return to `r`, an `Op.Ret`, when this body
// returns its error as a word: `errw`, the failure a forwarding `return f(n)`
// hands on (`forwardedErrWord`), or `nil` for an ok return (`errw` -1).
fn publishOkErr(fc: FnCtx, r: IrInstr, errw: int) {
  if (!fc.errReg) {
    return
  }
  if (errw >= 0) {
    r.args = append(r.args, errw)
    return
  }
  r.args = append(r.args, okErrWord(fc))
}

// The error word a `return <call>` hands on when the call's own type is
// fallible (an arrow forwarding a failure, #4504: `retClearsErr` false), else
// -1 for an ok return. Taken right after the value is lowered and BEFORE the
// defers run, which lower calls of their own; the caller resets
// `fc.pendingErr` before lowering the value so a stale word is never read.
fn forwardedErrWord(fc: FnCtx, vty: int, operand: int): int {
  if (!fc.errReg || retClearsErr(fc, vty)) {
    return -1
  }
  return takeCallErr(fc, fc.fallibleErr, operand)
}

// A `ret` with no ok value: `()`'s ok return, a bare `return`, falling off the end.
// Falling off the end of a function with a non-void ok type is unreachable (it
// ends in `panic`, say) but still owes every `ret` the same width, so the ok
// words are zero: the verifier counts them (`callResultEscapesInFunc`).
fn emitBareOkRet(fc: FnCtx) {
  let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
  if (fc.errReg && fc.fallibleOk != fc.c.ctx.voidId) {
    r.args = fallibleZeroArgs(fc, pointSpan(0, 0))
  }
  publishOkErr(fc, r, -1)
  builderEmit(fc.b, r)
}

// The call's trailing `Op.CallWord` carrying the callee's error word, after
// `nOk` ok words (ival), emitted into `b`; returns its value id, or -1 for a
// callee on the slot convention. A void-ok callee has no ok word: its `Op.Call`
// IS the error word (typed by `errWordCallTy`), so nothing is appended. It must
// directly follow the ok words' run (`callWordPlaced`, verify.bit).
fn emitErrWord(fc: FnCtx, b: IrBuilder, raw: int, call: int, nOk: int): int {
  if (raw == 0) {
    return -1
  }
  if (fc.c.ctx.types[raw].result == fc.c.ctx.voidId) {
    return call
  }
  let w = mkInstr(Op.CallWord, errSlotTy(fc, fc.c.ctx.types[raw].errTy))
  w.args = [call]
  w.ival = nOk
  return builderEmit(b, w)
}

// `emitErrWord` for a call lowered into `fc.b`: records the word as
// `pendingErr` for the `?`/`catch` that consumes the call (`takeCallErr`).
fn appendErrWord(fc: FnCtx, raw: int, call: int, nOk: int) {
  if (raw != 0) {
    fc.pendingErr = emitErrWord(fc, fc.b, raw, call, nOk)
  }
}

// #6689: the `Op.CallValue` of the function value `fv` for the call `node`. A
// fallible function type means every body reachable through the value returns
// its error as the last word (closure bodies, both trampolines, a method used
// as a value), so the call binds it like any other producer; a one-handle ok
// result is word 1, and a void ok makes the call itself the word.
fn emitFuncValueCall(fc: FnCtx, node: int, fv: int, args: []int): int {
  let fty = nodeType(fc, node)
  let raw = 0
  if (errInReg(fc.lowerer) && fty != 0 && fc.c.ctx.types[fty].kind == TypeKind.Fallible) {
    raw = fty
  }
  let ins = mkInstr(Op.CallValue, errWordCallTy(fc, raw, unwrapFallible(fc.c, fty)))
  ins.lhs = fv
  ins.args = args
  let call = builderEmit(fc.b, ins)
  appendErrWord(fc, raw, call, 1)
  return call
}

// The IR type of the `Op.Call` itself: the error word's when the callee's ok
// type is void, else `ty` (the ok type or word 0).
fn errWordCallTy(fc: FnCtx, raw: int, ty: int): int {
  if (raw != 0 && fc.c.ctx.types[raw].result == fc.c.ctx.voidId) {
    return errSlotTy(fc, fc.c.ctx.types[raw].errTy)
  }
  return ty
}

// The span of `operand`, the expression node a `takeCallErr` consumes, or a
// zero point for the synthesized bodies (`main` wrapper, startup) that have none.
fn operandSpan(fc: FnCtx, operand: int): Span {
  if (operand < 0) {
    return pointSpan(0, 0)
  }
  return getNode(fc.c.tree, operand).span
}

// The error the fallible call just lowered returned: its word when the producer
// appended one, else the slot (a callee on the slot convention). `pendingErr`
// is reset BEFORE each operand is lowered (`lowerTryExpr`, `lowerCatch`), so it
// is never stale here. Under the word convention there is no slot to fall back
// to (`operand` is the call's expression node, -1 when synthesized), so a producer that bound no word fails the COMPILER here (`fcFail`, at the
// operand's span), not the program at exit 0.
fn takeCallErr(fc: FnCtx, errTy: int, operand: int): int {
  if (fc.pendingErr >= 0) {
    let w = fc.pendingErr
    fc.pendingErr = -1
    return w
  }
  if (errInReg(fc.lowerer)) {
    fcFail(
      fc,
      operandSpan(fc, operand),
      "a fallible call operand bound no error word under BIT_ERR_REG (its call producer was not converted)",
    )
    return 0
  }
  return getErr(fc, errTy)
}

// #2939: the err slot is one machine word tested against `nil` (`neNil`),
// sound only when every `errTy` value is a reachable pointer — true for any
// reference-shaped type (codegen.bit's `isRefType`: `error`/interface, class,
// payload-carrying enum) but not a bare C-like enum, a plain tag word whose
// discriminant-0 variant collides with nil. `fail Kind.NotFound` (tag 0, the
// common first-declared variant) was silently indistinguishable from "no
// error"; `fail Kind.Invalid` (tag 1) was not. Fix: box a non-ref-shaped error
// into a one-element cell (the same mechanism lowerclosure.bit's `allocBox`
// uses for captured locals) so the slot always holds a pointer.
// #4006/#4407: THIS FUNCTION HAS A SECOND UNCHECKED ASSUMPTION, deliberately
// not fixed here. "reference-shaped" and "fits in the slot's one machine
// word" are the same question only because nothing in the tree today makes a
// ref-shaped value wider than one word. #3901 (#4411) is planned to explode
// `string` into independent `ptr`/`len`/`base` words for locals, arguments
// and returns — `isRefType(string)` stays `true` (it is a type-level, not an
// SSA-level, classification: codegen.bit:146 never changes), so a `string`
// error type would keep reading as "already fits" and go straight into the
// one-word slot, silently truncating to whichever single word reaches
// `setErr` and dropping the rest.
//
// No fix lands here because the correct one depends on a design question
// #4411 has not settled: whether a `fail`/`err_set` boundary reboxes an
// exploded value the way #4404's `declareExplodedParam`/`localRead` already
// does for a captured-and-assigned local, or whether the one-word err slot
// itself grows. A generalization tried and rejected during #4407: gating on
// `len(explodedWordTypes(fc.c.ctx, errTy)) != 0` looks plausible but is
// WRONG today, not just premature — a 2-word tuple errTy is already boxed to
// one ordinary heap handle by the time it reaches `boxErrForSlot` (`fail`
// values are never routed through #4404's parameter-explosion path), so that
// condition would double-box it. Whoever lands #4411 must re-derive
// `errNeedsBox` against its actual value flow, not extend this comment's
// guess. Filed as #4432.
fn errNeedsBox(fc: FnCtx, errTy: int): bool {
  return !isRefType(fc.c.ctx, errTy)
}

// The type the raw `err_get`/`err_set` slot carries for `errTy`: `errTy`
// itself when reference-shaped, else the box cell's type — always a pointer.
fn errSlotTy(fc: FnCtx, errTy: int): int {
  if (errNeedsBox(fc, errTy)) {
    return boxTypeFor(fc, errTy)
  }
  return errTy
}

// Boxes a freshly `fail`ed value into slot representation, when needed. The
// propagate path (`lowerTryExpr`) never calls this: the value it re-publishes
// came straight out of `getErr`, already in slot representation.
//
// #4431/#4426: `errNeedsBox` answers `false` for `string` (it is `isRefType`
// unchanged, per this file's own header comment and #4432), which is the
// CORRECT answer for a plain boxed string — the one-word slot already holds
// it, and `val` already IS that word whether or not the string gate is on
// (lowerexplodestr.bit's banner derives why). #4431 routed it through a
// box/unbox round trip here; #4426 measured that round trip as a value-level
// no-op at every one-word position and removed it.
fn boxErrForSlot(fc: FnCtx, val: int, errTy: int): int {
  if (errNeedsBox(fc, errTy)) {
    return buildTuple(fc, boxTypeFor(fc, errTy), [val])
  }
  return val
}

// Reverses `boxErrForSlot`. The one place that needs it: binding `catch e { }`
// to the error's own value rather than its slot handle. A `string` error's
// slot word IS the boxed handle both ways, so `catch e { ... e ... }` reads
// exactly the value `boxErrForSlot` published.
fn unboxErrFromSlot(fc: FnCtx, raw: int, errTy: int): int {
  if (errNeedsBox(fc, errTy)) {
    return tupleElem(fc, boxTypeFor(fc, errTy), raw, 0)
  }
  return raw
}

// `err_get()` — read the pending error right after a fallible call. Typed at
// the slot representation, not always `errTy`, so a boxed error's pointer is
// tracked as a live GC reference (codegen.bit's `isRefType`-driven stack maps).
fn getErr(fc: FnCtx, errTy: int): int {
  let ins = mkInstr(Op.RtCall, errSlotTy(fc, errTy))
  ins.name = "err_get"
  return emitRtCall(fc, ins)
}

// `err != nil` — the test that decides the `?`/`catch` error path. `errv` and
// `slotTy` must both already be in slot representation (`errSlotTy`).
fn neNil(fc: FnCtx, errv: int, slotTy: int): int {
  let nl = mkInstr(Op.ConstNil, slotTy)
  let ne = mkInstr(Op.ICmpNe, primType(fc.c.ctx, 10))
  ne.lhs = errv
  ne.rhs = builderEmit(fc.b, nl)
  return builderEmit(fc.b, ne)
}

// Return from a fallible function on the err path: a zero ok value, or nothing
// when the ok type is void (`()!`).
//
// #4507: a class or tuple ok type returns a BARE NIL rather than a real zeroed
// object — `zeroValue`'s Struct arm allocates (and, since #4414, so does its
// Tuple arm), so `fail` from `fn g(): P!` emitted a `gc_alloc` plus one
// `field_set` per field on a value no caller can read. Post-opt on
// `_tests_/cases/wsframing.bit` that was seven instructions and a 24-byte
// allocation per error return, five times over in `readOneFrame` alone; the
// optimizer does not fold it, because the store-to-load pair it needs is split
// across the call boundary. `deferZeroValue` (lowerdefer.bit) applies the
// class/tuple half of the same test to its own placeholder slot.
//
// #6982 extends it to the other two kinds `zeroValueAllocates` names: an
// `[N]T` array (`newArray`, lowerlit.bit) and a boxed enum (`buildEnumObj`,
// lowerlayout.bit). Beyond the wasted allocation, under the error word that
// allocation sits between the call that produced the error and the `ret` that
// hands it on, so the word must survive a call in a callee-saved register.
// x86-64 has four: pkg/toml's readScalar, a `Toml!`, spilled its lexer handle
// to make room, 29 -> 36 spill/reload sites.
//
// THE DEADNESS IS STRUCTURAL, not a claim about today's callers. Every shape
// that consumes the ok value places its first read in the `err_get() == nil`
// successor, which the branch dominates: `?` gives the value only in `cont`,
// whose single predecessor is that edge (`lowerTryExpr` below); a value
// `catch` merges through a join whose err edge carries the HANDLER's value
// (`lowerCatch`); a discarded call and `spawn`'s thunk
// (`synthSpawnTrampoline`, lowerfuncval.bit) never read it; and the func-value
// trampoline (`emitTrampolineRet`, lowertrampoline.bit) passes it straight to its
// own `ret`. The precedent is already shipped and load bearing:
// `zeroValueEnumOrNil` returns this same `ConstNil` for an interface, pointer,
// func or unboxed-enum ok type, so `fn mk(): Shape!` has handed callers a nil
// on its error path since fallible results existed.
//
// #5874 made the width part of that argument, not an exception to it. A
// `(A, B)!` body whose result `explodedRetWords` (lowerexplode.bit) returns in
// W words gives every `ret` W operands (`fallibleZeroArgs`), and the zero BITS
// of each word are enough for the same reason the nil is: nothing reads them.
fn emitFallibleZeroRet(fc: FnCtx, span: Span, errv: int) {
  let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
  if (fc.fallibleOk != fc.c.ctx.voidId) {
    r.args = fallibleZeroArgs(fc, span)
  }
  // #6686: `errv` is the failure in slot representation, the last return word.
  if (fc.errReg) {
    r.args = append(r.args, errv)
  }
  builderEmit(fc.b, r)
  fc.terminated = true
}

// The err-path `ret`'s operands: one zero constant per return WORD when the ok
// value is returned in words, else one bare nil or the ok type's zero value.
//
// `zeroBitsConst` (lowerslicefill.bit) rather than `zeroValue`: a word is
// never a tuple, class or array, so there is nothing to build, and a
// reference word takes a `ConstNil` of its own type — the value `GcAlloc`'s
// zeroed slot would have held — with no allocation even under
// `--no-optimize`.
fn fallibleZeroArgs(fc: FnCtx, span: Span): []int {
  if (len(fc.retWords) != 0) {
    let out = []int(0)
    let i = 0
    while (i < len(fc.retWords)) {
      out = append(out, zeroBitsConst(fc, fc.retWords[i]))
      i = i + 1
    }
    return out
  }
  if (zeroValueAllocates(fc.c.ctx, fc.fallibleOk)) {
    return [builderEmit(fc.b, mkInstr(Op.ConstNil, fc.fallibleOk))]
  }
  return [zeroValue(fc, fc.fallibleOk, span)]
}

// The kinds whose `zeroValue` (lowerslicefill.bit) builds a heap object: a
// class, a tuple, an `[N]T` array and a boxed enum. Every other kind's zero is
// a constant with no allocation.
fn zeroValueAllocates(ctx: TypeContext, ty: int): bool {
  let td = ctx.types[ty]
  if (td.kind == TypeKind.Enum) {
    return td.enumBoxed
  }
  return td.kind == TypeKind.Struct || td.kind == TypeKind.Tuple || td.kind == TypeKind.Array
}

// `fail e` (§18.3): evaluate the error, run defers, publish it (boxed per
// `errNeedsBox`), return zero ok.
fn lowerFail(fc: FnCtx, node: int) {
  let errv = lowerExprH(fc, kidsOf(fc.c.tree, node)[0], fc.fallibleErr)
  if (fc.failed) {
    return
  }
  runDefers(fc)
  let slotv = boxErrForSlot(fc, errv, fc.fallibleErr)
  setErr(fc, slotv)
  emitFallibleZeroRet(fc, getNode(fc.c.tree, node).span, slotv)
}

// Right after a fallible call: branch on its error. On error propagate
// (defers, restore the error, return zero ok); on ok control continues in a
// fresh block whose single predecessor is that edge, so everything the call
// produced flows in without a block param. Shared by `?` (`lowerTryExpr`) and
// the fallible `for x of it?` header (`lowerForOfIterHeader`, lowerforiter.bit).
// `errv` is the callee's own returned word (`takeCallErr`), or the slot's
// `getErr` when the callee keeps the slot convention.
fn propagateErrWord(fc: FnCtx, errv: int, errTy: int, span: Span) {
  // `errv` is already in slot representation; `setErr` below re-publishes it
  // as-is, no reboxing per `?` hop.
  let isErr = neNil(fc, errv, errSlotTy(fc, errTy))
  let prop = builderNewBlock(fc.b)
  let cont = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = prop
  br.thenArgs = []int(0)
  br.ival2 = cont
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, prop)
  fc.terminated = false
  runDefers(fc)
  setErr(fc, errv)
  emitFallibleZeroRet(fc, span, errv)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, cont)
  fc.terminated = false
}

// `expr?` (§18.3): lower the fallible call (its ok value lands normally), then
// branch on the error slot — on error propagate (defers, restore the error,
// return zero ok); on ok the value is the call's ok result.
fn lowerTryExpr(fc: FnCtx, node: int): int {
  let operand = kidsOf(fc.c.tree, node)[0]
  let fty = nodeType(fc, operand)
  let errTy = fc.c.ctx.types[fty].errTy
  fc.pendingErr = -1
  let okv = lowerExpr(fc, operand)
  if (fc.failed) {
    return 0
  }
  // #5874: read BEFORE `getErr` — see `joinOkWords`.
  let okTy = fc.c.ctx.types[fty].result
  let words = joinOkWords(fc, okTy, okv)
  let okWords = okWordIds(fc, okTy, okv, words)
  propagateErrWord(fc, takeCallErr(fc, errTy, operand), errTy, getNode(fc.c.tree, node).span)
  // `cont` has a single predecessor (dominated by the branch), so the ok value
  // flows in directly — no block param. So do its words, and the aggregate is
  // rebuilt from them HERE, in the block its consumer's reads sit in.
  if (len(words) == 0) {
    return okv
  }
  return materializeExplodedLocal(fc, okTy, okWords)
}

// The block-param args for a catch/match-expr join edge: the live locals, plus
// the merged value unless the ok type is void. Copies `locals` (append can grow
// its input in place, and a caller reuses the snapshot for `restoreValues`).
fn catchEdgeArgs(fc: FnCtx, locals: []int, val: int, isVoid: bool): []int {
  let out = []int(0)
  let i = 0
  while (i < len(locals)) {
    out = append(out, locals[i])
    i = i + 1
  }
  if (!isVoid) {
    out = append(out, val)
  }
  return out
}

// ===========================================================================
// #5874: a `?`/`catch` join over an ok value that arrived in WORDS
//
// THE TRAP. `emitResolvedCall` (lowerprim.bit) rebuilds a word-returning
// call's result as a fresh box, and the consumer's reads of it sit past the
// `err_get` below and past the branch. Store-to-load forwarding
// (optstore.bit) is block-local and every `rt_call` clears its table, so those
// reads forward from nothing and the box survives: the callee stopped
// allocating and the caller started. A `catch` is worse: its join merges the
// value as a block argument, an escape optalloc.bit refuses outright, so both
// the call's box and the handler's survive.
//
// THE SHAPE, from #4601's spike (`5bc0518e`). The words are read out of the
// box ADJACENT to its `field_set`s, before `err_get`, where forwarding answers
// every read; they cross the branch as values — directly into `?`'s
// single-predecessor `cont`, as one block parameter per word into a `catch`
// join — and the aggregate is rebuilt at the top of that block, where its
// consumer's reads forward from the new `field_set`s. Where the consumer
// really wants a handle the rebuilt box stays, one box as before.
//
// Keyed on #4586's predicate: the ok value is a box this lowerer JUST built
// (`isFreshBox`, lowerexplodestr.bit), because killing that box is the only
// thing the words can buy. A one-handle callee hands back its `call` itself,
// which is never a `gc_alloc`, so every other fallible call keeps the join it
// always had, instruction for instruction.
// ===========================================================================

// The words a `T!` result returns its ok value in (`declPlainResultType`,
// lowerexplode.bit), or empty for one handle.
//
// #6730 admits an enum beside #5874's tuple. A fallible `next(): Option<T>!`
// built an `Option` box per call, which `for x of it?` (lowerforiter.bit) then
// took apart; the words let its `freshEnumBoxWords` read the call's registers
// and leave the caller's rebuilt box dead, and the error path returns zero
// words instead of a zeroed box. It is the trade the infallible enum return
// (#5313/#5445) already makes: a caller that keeps a handle rebuilds the box
// the callee stopped building. #4601's measured loss for `string` stands.
fn fallibleOkWordTypes(ctx: TypeContext, ok: int): []int {
  if (ok != 0 && ctx.types[ok].kind == TypeKind.Enum) {
    return explodedEnumWordTypes(ctx, ok)
  }
  return tupleWordTypes(ctx, ok)
}

// The per-word types a `?`/`catch` join threads its ok value through, or an
// empty list for the one-value form. Its reads must be emitted BEFORE
// `getErr`, adjacent to the box they take apart.
//
// #7142: keyed on the callee's own `fallibleOkWordTypes`, so an enum #6730
// returns in words crosses `?` in words; only where `freshEnumBoxWords`
// answers, since `okWordIds` takes the box's stored values. Without it every
// `return f()?` level kept a rebuilt box (pkg/toml: +182,040 objects/parse).
fn joinOkWords(fc: FnCtx, okTy: int, okv: int): []int {
  if (!isFreshBox(fc.b, okv)) {
    return []int(0)
  }
  let words = fallibleOkWordTypes(fc.c.ctx, okTy)
  if (len(words) != 0 && fc.c.ctx.types[okTy].kind == TypeKind.Enum) {
    if (len(freshEnumBoxWords(fc, okv, okTy)) == 0) {
      return []int(0)
    }
  }
  return words
}

// The ids of `val`'s ok words on a `?`/`catch` edge, or none for the
// one-value form. A fresh enum box answers with the values its own
// `field_set`s stored, so nothing reads it and dead-allocation elimination
// takes it. Anything else is read out of the handle, as `declareLetLocal`
// (lowerexplode.bit) reads an enum local.
fn okWordIds(fc: FnCtx, okTy: int, val: int, words: []int): []int {
  if (len(words) == 0) {
    return []int(0)
  }
  let fresh = freshEnumBoxWords(fc, val, okTy)
  if (len(fresh) != 0) {
    return fresh
  }
  return explodeValueWords(fc.c.ctx, fc.b, val, words)
}

// A `catch` join edge: the live locals, then `val` as its words at an exploded
// join, or `catchEdgeArgs`'s one handle (nothing for a void ok type).
fn catchJoinArgs(fc: FnCtx, locals: []int, val: int, words: []int, okTy: int): []int {
  if (len(words) == 0) {
    return catchEdgeArgs(fc, locals, val, okTy == fc.c.ctx.voidId)
  }
  let out = catchEdgeArgs(fc, locals, val, true)
  let ids = okWordIds(fc, okTy, val, words)
  let k = 0
  while (k < len(ids)) {
    out = append(out, ids[k])
    k = k + 1
  }
  return out
}

// The `catch` join's merged value: the one parameter every other join takes,
// or W word parameters put back together at the top of the join.
fn joinOkValue(fc: FnCtx, okTy: int, words: []int): int {
  if (len(words) == 0) {
    return builderAddParam(fc.b, okTy)
  }
  let ids = []int(0)
  let k = 0
  while (k < len(words)) {
    ids = append(ids, builderAddParam(fc.b, words[k]))
    k = k + 1
  }
  // #4406: a join MINTS new ids, so the edges recorded where the words were
  // read name values that do not exist on this side of it.
  recordWordKeepAlive(fc.c.ctx, fc.b, words, ids)
  return materializeExplodedLocal(fc, okTy, ids)
}

// The handler value and its type for `catch d` (bind=false) or
// `catch e { … }` (bind=true), split out of `lowerCatch` (E0201). Recomputes
// okTy/errTy from `fty` rather than taking them as separate params, to stay
// under the 5-param ceiling — `errv` cannot be recomputed the same way, since
// `getErr` emits IR and is not safe to call twice.
fn lowerCatchHandler(fc: FnCtx, k: []int, bind: bool, errv: int, fty: int): (int, int) {
  let okTy = fc.c.ctx.types[fty].result
  let errTy = fc.c.ctx.types[fty].errTy
  if (bind) {
    let mark = len(fc.env)
    let en = getNode(fc.c.tree, k[1])
    declareLocal(
      fc,
      fc.c.source[en.span.start:en.span.end],
      unboxErrFromSlot(fc, errv, errTy),
      errTy,
    )
    rebindCheckerName(fc, k[1], errTy)
    let handled = lowerCatchBlock(fc, k[2], okTy)
    let handledTy = catchBlockType(fc, k[2])
    truncateEnv(fc, mark)
    return (handled, handledTy)
  }
  let handled = lowerExprH(fc, k[1], okTy)
  let handledTy = defaultType(fc.c, nodeType(fc, k[1]))
  return (handled, handledTy)
}

// `expr catch d` / `expr catch e { … }` (§18.3): merge the ok value and the
// handled value at a join. A void ok type carries no value (the catch is a
// statement); the ok value stands in as the placeholder. `valueUsed` is
// false only for a discarded-statement `catch e { … }` (#6285) — see the
// `handled == -1` branch.
fn lowerCatch(fc: FnCtx, node: int, bind: bool, valueUsed: bool): int {
  let k = kidsOf(fc.c.tree, node)
  let fty = nodeType(fc, k[0])
  let okTy = fc.c.ctx.types[fty].result
  let errTy = fc.c.ctx.types[fty].errTy
  let isVoid = okTy == fc.c.ctx.voidId
  fc.pendingErr = -1
  let okv = coerceToIface(fc, lowerExpr(fc, k[0]), fty, okTy)
  if (fc.failed) {
    return 0
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  // #5874: the ok edge is built BEFORE `getErr` — see `joinOkWords`.
  let words = joinOkWords(fc, okTy, okv)
  let okEdge = catchJoinArgs(fc, orig, okv, words, okTy)
  // `errv` is in slot representation, unboxed below only where needed.
  let errv = takeCallErr(fc, errTy, k[0])
  let isErr = neNil(fc, errv, errSlotTy(fc, errTy))
  let errBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = errBlk
  br.thenArgs = []int(0)
  br.ival2 = join
  br.elseArgs = okEdge
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, errBlk)
  fc.terminated = false
  clearErr(fc)
  let (handled, handledTy) = lowerCatchHandler(fc, k, bind, errv, fty)
  if (fc.failed) {
    return 0
  }
  // A bind-catch block that produced no value. Harmless when nothing merges —
  // a void ok type carries no value, and a diverted block never reaches the
  // join. A non-void, non-diverting FALL-THROUGH with `valueUsed` is exactly
  // what E0067 rejects, so arriving here means the validator and the
  // lowerer's `terminated` disagree; stub the function rather than merge a
  // bogus operand (before #1519 that operand was value id 0). Without
  // `valueUsed` (#6285: the whole `catch` is a discarded statement) the
  // join still needs an `okTy`-typed operand, so a never-read placeholder
  // `zeroValue` stands in, the same reasoning `deferZeroValue`'s slot uses.
  if (handled == -1) {
    if (isVoid || fc.terminated) {
      handled = okv
      handledTy = okTy
    } else if (!valueUsed) {
      handled = zeroValue(fc, okTy, getNode(fc.c.tree, node).span)
      if (fc.failed) {
        return 0
      }
      handledTy = okTy
    } else {
      fcFail(
        fc,
        getNode(fc.c.tree, node).span,
        "a `catch` block that falls through without producing a value",
      )
      return 0
    }
  }
  if (!fc.terminated) {
    let merged = coerceToIface(fc, handled, handledTy, okTy)
    emitJump(fc, join, catchJoinArgs(fc, snapshotValues(fc, preLen), merged, words, okTy))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    return okv
  }
  return joinOkValue(fc, okTy, words)
}

// The body of a `catch e { … }`: a block of statements whose final expression (if
// the ok type is non-void) is the handled value. ponytail: a bind-catch body that
// yields a value uses its trailing expression statement.
// The value type a `catch e { … }` block yields: its trailing expression's type,
// or void.
fn catchBlockType(fc: FnCtx, block: int): int {
  let stmts = kidsOf(fc.c.tree, block)
  if (len(stmts) == 0) {
    return fc.c.ctx.voidId
  }
  let last = stmts[len(stmts) - 1]
  if (getNode(fc.c.tree, last).tag == Tag.ExprStmt) {
    return defaultType(fc.c, nodeType(fc, kidsOf(fc.c.tree, last)[0]))
  }
  return fc.c.ctx.voidId
}

// Returns the block's value, or -1 when it yields none — NOT 0, which is the
// value id of a function's first instruction and so a perfectly valid result
// (#1519, the same collision that produced the #1493 miscompile). The seed keeps
// the two apart with `?ir.ValueId`; here the sentinel must sit outside the id
// space. On `fc.failed` the return is meaningless and the caller re-checks the
// flag, so -1 is right there too.
fn lowerCatchBlock(fc: FnCtx, block: int, okTy: int): int {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) - 1 && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
  if (fc.failed || len(stmts) == 0) {
    return -1
  }
  // The last statement yields the value for a non-void catch; a void catch runs
  // it as a statement.
  let last = stmts[len(stmts) - 1]
  if (okTy == fc.c.ctx.voidId || fc.terminated) {
    lowerStmt(fc, last)
    return -1
  }
  if (getNode(fc.c.tree, last).tag == Tag.ExprStmt) {
    return lowerExprH(fc, kidsOf(fc.c.tree, last)[0], okTy)
  }
  lowerStmt(fc, last)
  return -1
}
