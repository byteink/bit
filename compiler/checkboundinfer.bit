// Inference of a type parameter from a SIBLING's generic bound (SPEC 11.3,
// #6396): in `fn load<T, S: Store<T>>(s: S, k: string): T` no value parameter
// mentions `T`, but `S` is bound by the argument and `S`'s bound is
// `Store<T>`, so `T` is whatever `S`'s methods return where `Store`'s declare
// `T`. Same module as the rest of the checker; no imports.

// The part of `conc` that sits where TypeParam `pid` sits in `pat`, or 0. A
// structural walk of the two types in step, the type-level twin of
// `bindTypeParamFromNode` (which walks a type NODE against a type). 0 means
// "this shape does not decide `pid`", never "bound to nothing": a mismatch of
// shapes is left for E0051 to report against the bound, not guessed at here.
fn typeBindParam(c: Checker, pat: int, conc: int, pid: int, depth: int): int {
  if (pat == pid) {
    return conc
  }
  if (pat == 0 || conc == 0 || pat == conc || depth >= maxTypeDepth()) {
    return 0
  }
  if (!typeBindSameShape(c, pat, conc)) {
    return 0
  }
  return typeBindParamList(c, typeComponents(c, pat), typeComponents(c, conc), pid, depth)
}

// Whether two types are built the same way, so their components line up: the
// same kind and, for a nominal generic instance, the same base name
// (`bindTypeParamFromNode` demands the same: binding `Opt<T>` against a
// `Box<string>` would be a guess).
fn typeBindSameShape(c: Checker, a: int, b: int): bool {
  let ta = c.ctx.types[a]
  let tb = c.ctx.types[b]
  if (ta.kind != tb.kind) {
    return false
  }
  if (typeIsNominal(ta.kind)) {
    return ta.hasName && tb.hasName && ta.name == tb.name
  }
  return true
}

fn typeIsNominal(k: TypeKind): bool {
  return k == TypeKind.Struct || k == TypeKind.Enum || k == TypeKind.Interface
}

// The types `ty` is built from, in a fixed order per kind: one element, a map's
// key and value, a fallible's ok and error, a tuple's members, a function's
// parameters then result, a nominal instance's type arguments. Empty for a
// leaf. Two types of the same shape (`typeBindSameShape`) answer lists of the
// same length, which is what lets `typeBindParam` walk them pairwise.
fn typeComponents(c: Checker, ty: int): []int {
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.Slice || k == TypeKind.Chan || k == TypeKind.Ptr || k == TypeKind.Array) {
    return [t.elem]
  }
  if (k == TypeKind.Map) {
    return [t.mapKey, t.mapVal]
  }
  if (k == TypeKind.Fallible) {
    return [t.result, t.errTy]
  }
  return typeComponentsMembers(c, ty)
}

// The tail of `typeComponents`: tuple, function and nominal shapes.
fn typeComponentsMembers(c: Checker, ty: int): []int {
  let t = c.ctx.types[ty]
  if (t.kind == TypeKind.Tuple) {
    return t.members
  }
  if (t.kind == TypeKind.Func) {
    // A fresh list: appending to `members` would write into the interned
    // type's own backing array.
    let out = []int(0)
    for m of t.members {
      out = append(out, m)
    }
    return append(out, t.result)
  }
  if (typeIsNominal(t.kind)) {
    return nominalArgsOf(c, ty)
  }
  return []int(0)
}

// First non-zero binding of `pid` across two parallel type lists, in order.
fn typeBindParamList(c: Checker, pats: []int, concs: []int, pid: int, depth: int): int {
  let i = 0
  while (i < len(pats) && i < len(concs)) {
    let b = typeBindParam(c, pats[i], concs[i], pid, depth + 1)
    if (b != 0) {
      return b
    }
    i = i + 1
  }
  return 0
}

// What bound node `bn` (a `Store<T>` of the generic whose own TypeParam ids
// include `pid`) says `pid` is, given that the bound's subject is the concrete
// type `cand`: each method the interface declares, in SOURCE order so two
// disagreeing methods always pick the same one, is read off `cand` and matched
// against the interface's own signature with `Self` bound to `cand`. 0 when
// `bn` is not a generic instance, `cand` has none of the methods, or no method
// mentions `pid`. A wrong `cand` binds nothing wrong here: whatever is bound,
// `vBoundLoop` then judges `cand` against the bound at the bound arguments and
// reports E0051.
//
// `oc` declares the generic and `bn` indexes its tree, with `oc.curGenericDecl`
// already at the generic's own `<...>` node (`bindBoundSiblings`) so `T` in
// `Store<T>` resolves to the declaration's own parameter.
fn bindFromOneBound(c: Checker, oc: Checker, bn: int, cand: int, pid: int): int {
  if (getNode(oc.tree, bn).tag != Tag.GenericInst) {
    return 0
  }
  let bound = typeFromNode(oc, bn)
  if (bound == 0 || c.ctx.types[bound].kind != TypeKind.Interface) {
    return 0
  }
  let recv = methodRecvType(c, cand)
  for m of vIfaceMethodNames(c, bound) {
    let have = methodSigLookup(c, "${recv}." + m)
    let want = methodSigLookup(c, "${bound}." + m)
    if (have == 0 || want == 0) {
      continue
    }
    let b = typeBindParam(c, vBindSelf(c, want, cand), have, pid, 0)
    if (b != 0) {
      return b
    }
  }
  return 0
}

// One generic declaration's type parameters as the binder sees them: the module
// that declares it, its `GenericParam` nodes and the TypeParam ids registered for
// them, in the same order. A class rather than three more parameters (E0202).
class GenericParamSet {
  oc: Checker,
  tps: []int,
  ids: []int,
}

// What the bounds of the type parameters OTHER than `idx` say parameter `idx`
// is: `args[s]` is sibling `s`'s concrete argument (0 while unbound), and each
// `Name<...>` bound of `s` is asked by `bindFromOneBound`. First answer wins, in
// declaration order.
fn bindParamFromBounds(c: Checker, ps: GenericParamSet, args: []int, idx: int): int {
  let oc = ps.oc
  let s = 0
  while (s < len(ps.tps)) {
    let group = kidsOf(oc.tree, ps.tps[s])[1]
    if (s != idx && args[s] != 0 && group != 0) {
      for bn of kidsOf(oc.tree, group) {
        let b = bindFromOneBound(c, oc, bn, args[s], ps.ids[idx])
        if (b != 0) {
          return b
        }
      }
    }
    s = s + 1
  }
  return 0
}

// Fills the holes (0) of `args`, the per-parameter bindings of one call of the
// generic whose `<...>` node is `gens` in `oc`, from the siblings' generic
// bounds. A hole filled can unlock another (`<A, B: P<A>, C: Q<B>>` with only
// `C` bound), so it rounds until nothing changes, at most once per parameter.
// `args` is edited in place and keeps its length.
fn bindBoundSiblings(c: Checker, oc: Checker, gens: int, args: []int) {
  let tps = kidsOf(oc.tree, gens)
  let ps = GenericParamSet{ oc = oc, tps = tps, ids = declGenericIds(oc, gens) }
  if (len(ps.ids) != len(tps) || len(args) != len(tps)) {
    return
  }
  let saved = oc.curGenericDecl
  oc.curGenericDecl = gens
  let round = 0
  let changed = true
  while (changed && round < len(tps)) {
    changed = false
    let i = 0
    while (i < len(tps)) {
      if (args[i] == 0) {
        args[i] = bindParamFromBounds(c, ps, args, i)
        changed = changed || args[i] != 0
      }
      i = i + 1
    }
    round = round + 1
  }
  oc.curGenericDecl = saved
}

// The type arguments call `callNode` of the generic function `decl` (declared
// in `oc`) binds, one per type parameter in declaration order, 0 where nothing
// bound: written arguments first, then the value arguments, then the siblings'
// generic bounds. THE binder `genericTypeArgs` and `genericResultAt` share.
fn genericArgsRaw(c: Checker, oc: Checker, decl: int, callNode: int): []int {
  let dk = kidsOf(oc.tree, decl)
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let explicit = explicitCallTypeArgs(c, callNode)
  let out = []int(0)
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let bound = 0
    if (ti < len(explicit)) {
      bound = explicit[ti]
    }
    if (bound == 0) {
      bound = bindTypeParamAtCall(oc, c, callNode, params, oc.source[tpn.span.start:tpn.span.end])
    }
    out = append(out, bound)
    ti = ti + 1
  }
  bindBoundSiblings(c, oc, dk[2], out)
  return out
}
