// ===========================================================================
// Loop-depth weights for spill cost (#5824; feeds codegenlive.bit's
// `buildIntervals`, read by regalloc.bit's `preferSpill`)
//
// A spilled value pays one stack access per read and one per write, and what
// those accesses cost is how often the block holding them runs. A STATIC
// count has none of that: #4503 ranked by (1 + reads) / register-time and
// measured json +1.30%, matrix +0.86% and x86-64 sort +3-5%, because the value
// it gave up was carried by an inner loop and its one "store at the
// definition" was a store per iteration. Weighing each access by the loop
// depth of its block is the term that measurement named as missing.
//
// Depth comes from back edges. Blocks reach codegen in RPO, so an edge to a
// target at or before its source closes a loop (`isBackEdge`, codegen.bit);
// the natural loop of a header is optloop.bit's `licmLoopBlocks`, and a block's
// depth is the number of those loops that contain it. Its own file because
// codegenlive.bit is the funnel it feeds, not the place a CFG walk belongs.
// ===========================================================================

// How much more often a block one loop deeper is assumed to run. Only the
// ORDER of costs matters to `preferSpill`, so the base need only make one
// access a level deeper outweigh the handful a level out.
const loopWeightBase = 8

// Depth past which a block gains no further weight. Bounds `preferSpill`'s
// cross-multiplied cost: 8^5 per access, times a function's accesses, times its
// instruction count stays far inside a 64-bit int.
const loopWeightMaxDepth = 5

// Per block, loopWeightBase^depth, depth capped at loopWeightMaxDepth.
fn blockLoopWeights(f: IrFunc): []int {
  let depth = loopDepths(f)
  let out = []int(0)
  for d of depth {
    let w = 1
    let k = 0
    while (k < d && k < loopWeightMaxDepth) {
      w = w * loopWeightBase
      k = k + 1
    }
    out = append(out, w)
  }
  return out
}

// Per block, how many natural loops contain it. Bounded by headers * blocks:
// each header's loop is walked once.
fn loopDepths(f: IrFunc): []int {
  let n = len(f.blocks)
  let depth = []int(0)
  let header = licmFalses(n)
  let bi = 0
  while (bi < n) {
    depth = append(depth, 0)
    for t of licmTargets(f, bi) {
      if (isBackEdge(bi, t)) {
        header[t] = true
      }
    }
    bi = bi + 1
  }
  let pm = licmPredMap(f)
  let h = 0
  while (h < n) {
    if (header[h]) {
      addLoopDepth(depth, licmLoopBlocks(f, pm, h))
    }
    h = h + 1
  }
  return depth
}

fn addLoopDepth(depth: []int, inLoop: []bool) {
  let b = 0
  while (b < len(inLoop)) {
    if (inLoop[b]) {
      depth[b] = depth[b] + 1
    }
    b = b + 1
  }
}

// The definition half of every interval's spill cost; `extendOne`
// (codegenlive.bit) adds the reads and `addEdgeCosts` the block edges. A
// spilled instruction result is stored once, after its instruction; the entry
// block's params arrive from the caller and are stored once in the prologue.
fn addDefCosts(intervals: []LiveInterval, f: IrFunc, weights: []int) {
  if (len(f.blocks) == 0) {
    return
  }
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    while (idx < b.instsStart + b.instsLen) {
      intervals[idx].cost = intervals[idx].cost + weights[bi]
      idx = idx + 1
    }
    bi = bi + 1
  }
  let p = f.blocks[0].instsStart
  while (p < f.blocks[0].instsStart + f.blocks[0].paramCount) {
    intervals[p].cost = intervals[p].cost + weights[0]
    p = p + 1
  }
}

// The block edges' half. An edge move reads its argument and writes the
// target's param at the predecessor's terminator — for a loop header, the back
// edge — unless both share one location (#3738's `roots`), in which case the
// sequencer drops the move and neither end pays. Counting those anyway priced
// every value a loop merely threads through its params as a reload per block.
// Only an argument `extendForwardArgs` treats as a read is priced.
fn addEdgeCosts(intervals: []LiveInterval, f: IrFunc, live: []bool, roots: []int, weights: []int) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    if (b.instsLen > 0) {
      let t = f.instrs[b.instsStart + b.instsLen - 1]
      let e = EdgeCost{ f = f, live = live, roots = roots, pred = bi, w = weights[bi] }
      if (t.op == Op.Jump) {
        addArgCosts(intervals, e, t.ival, t.args)
      }
      if (t.op == Op.Br) {
        addArgCosts(intervals, e, t.ival, t.thenArgs)
        addArgCosts(intervals, e, t.ival2, t.elseArgs)
      }
    }
    bi = bi + 1
  }
}

// One predecessor's view of its outgoing edges, bundled so `addArgCosts` stays
// within five parameters.
class EdgeCost {
  f: IrFunc,
  live: []bool,
  roots: []int,
  pred: int,
  w: int,
}

fn addArgCosts(intervals: []LiveInterval, e: EdgeCost, target: int, args: []int) {
  let k = 0
  while (k < len(args)) {
    let p = e.f.blocks[target].instsStart + k
    let moved = rootOf(e.roots, args[k]) != rootOf(e.roots, p)
    if (moved && argFeedsLiveTarget(e.f, e.live, e.pred, target, k)) {
      intervals[args[k]].cost = intervals[args[k]].cost + e.w
      intervals[p].cost = intervals[p].cost + e.w
    }
    k = k + 1
  }
}

// `v`'s location owner under `roots`; an empty `roots` coalesces nothing.
fn rootOf(roots: []int, v: int): int {
  if (len(roots) == 0) {
    return v
  }
  return roots[v]
}
