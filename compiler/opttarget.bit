// #5820: `onX64()` (runtime/syscalls/syscalls.bit) folded to the build
// target's answer, so a per-architecture `if (onX64())` costs nothing and its
// untaken arm is deleted before register allocation.
//
// WHY A CALL WAS NEVER FOLDED. `onX64` is an `asm` immediate, opaque to the
// optimizer: the inliner splices the block into an intra-module caller and a
// cross-object caller keeps its `bl`, so every site paid the call or the
// immediate, the compare and the branch, and carried the dead arm's register
// pressure into the live one (#5796 v4: `bit_rt_map_slot`'s frame 0x30 ->
// 0x40, +3.63% cycles on Graviton3 against +1.29% without the dispatch).
//
// WHY THE SOURCE STAYS AN `asm` BLOCK. The pinned stage0 compiles `runtime/**`
// (docs/development.md, "Bootstrap") and knows nothing of this pass, so the
// body is what a stage0-built archive runs, and what an out-of-tree caller
// linking the exported pin runs. This pass changes WHERE the answer is
// computed, never what it is: `targetIsX64` (build.bit) is the same predicate
// that decides which backend, and so which `asm` arm, the object carries.
//
// WHY AFTER LOWERING AND NOT IN IT. `--dump-ir-pre` of every runtime file
// stays identical to stage0's, so `scripts/selfhost-diffruntime.sh`'s IR walk
// is unmoved; and the fold runs in `optimizeModule`'s first phase, before the
// inliner snapshots a callee, so no caller ever receives the opaque body.
//
// KEYED ON THE PIN, GUARDED AGAINST A FORGERY. A ROOT module's own functions
// keep their bare names (`isPinnedName`, emit.bit), so a user function
// spelled `bit_rt_port_syscalls_on_x64` produces the same call name. The fold
// fires only when no function in the module carries that name UNPINNED; with
// the pinned definition in the module or no definition at all, the callee is
// the runtime's, because an unpinned cross-module reference is never emitted
// under a `$`-free name.

fn onX64Pin(): string {
  return "bit_rt_port_syscalls_on_x64"
}

// Whether a call named `onX64Pin()` in `m` must reach the runtime's pinned
// `onX64`: false iff the module defines that name unpinned.
fn onX64CallIsPinned(m: IrModule): bool {
  for f of m.funcs {
    if (f.name == onX64Pin() && !f.isPinned) {
      return false
    }
  }
  return true
}

// Replaces each zero-argument `call @bit_rt_port_syscalls_on_x64` in `m`
// with `const_bool m.x64`, in place: same value id, same `bool` type, no
// operand to rewire, so no other instruction changes. The fold/prune pair
// after this deletes the untaken arm. A no-op unless `setTargetArch`
// recorded a target.
fn foldTargetTests(m: IrModule) {
  if (!m.archKnown || !onX64CallIsPinned(m)) {
    return
  }
  for f of m.funcs {
    foldOnX64Calls(f, m.x64)
  }
}

fn foldOnX64Calls(f: IrFunc, x64: bool) {
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.Call && ins.name == onX64Pin() && len(ins.args) == 0) {
      let c = mkInstr(Op.ConstBool, ins.ty)
      c.bval = x64
      c.span = ins.span
      f.instrs[i] = c
    }
    i = i + 1
  }
}
