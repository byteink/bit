// In-Bit self-checks for x86-64 dispatch tables, function compilation and call
// lowering. Split out of selfcheck.bit (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly.

// SysV passes the first six integer arguments in registers; the rest overflow to
// an outgoing stack area the CALLER reserves and reclaims. The pieces
// (xStackReserve/xEmitStackArgStore) are unit-tested separately; this pins that
// xMarshalArgs actually wires them together.
// Which registers a function's body forbids the allocator from handing out.
fn checkX64ScanFlags() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let one = IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }

  // A self-loop is a back-edge, whose safepoint POLL is a real call — so it
  // restricts the file to callee-saved exactly as a user call does. Scanning only
  // for call ops missed this and left a loop-carried value in a caller-saved
  // register that the poll then destroyed (#1236).
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 0
  let loop = IrFunc{ name: "l", paramTypes: []int(0), result: ctx.voidId, blocks: [one],
    instrs: [jmp], isFallible: false }
  assert(xScanFuncFlags(loop).hasSafepoints)

  // A FORWARD jump is not a back-edge and forces nothing.
  let fwd = mkInstr(Op.Jump, ctx.voidId)
  fwd.ival = 1
  let two = IrFunc{ name: "f", paramTypes: []int(0), result: ctx.voidId,
    blocks: [one, IrBlock{ instsStart: 1, paramCount: 0, instsLen: 1 }],
    instrs: [fwd, mkInstr(Op.Ret, ctx.voidId)], isFallible: false }
  assert(!xScanFuncFlags(two).hasSafepoints)

  // Division fixes rax/rdx as idiv's operands.
  let dv = mkInstr(Op.SDiv, i64t)
  let dvf = IrFunc{ name: "d", paramTypes: []int(0), result: i64t, blocks: [one],
    instrs: [dv], isFallible: false }
  assert(xScanFuncFlags(dvf).needsRaxRdx)
  assert(!xScanFuncFlags(loop).needsRaxRdx)

  // cl is x86-64's ONLY variable shift count, so a non-constant amount reserves
  // rcx — but a CONSTANT amount uses the immediate form and reserves nothing.
  let amt = mkInstr(Op.ConstInt, i64t)
  amt.ival = 3
  let shC = mkInstr(Op.Shl, i64t)
  shC.lhs = 0
  shC.rhs = 0 // points at the const_int: an immediate shift
  let shConst = IrFunc{ name: "sc", paramTypes: []int(0), result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 }],
    instrs: [amt, shC], isFallible: false }
  assert(!xScanFuncFlags(shConst).needsRcx)

  let dyn = mkInstr(Op.BlockParam, i64t)
  let shV = mkInstr(Op.Shl, i64t)
  shV.lhs = 0
  shV.rhs = 0 // points at the block param: a variable shift
  let shVar = IrFunc{ name: "sv", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 }],
    instrs: [dyn, shV], isFallible: false }
  assert(xScanFuncFlags(shVar).needsRcx)
  checkX64ClobberPoints()
}

// #3171: the positions at which the allocator must treat caller-saved registers
// as destroyed. Every safepoint, PLUS the poll-address prefetch, which is a
// run of real calls (three since #3746, two before) that deliberately records
// no safepoint. They are contiguous, so they are ONE position, not three.
//
// Deleting that extra position is silent at the source level and NOT silent in
// the emitted code, which is why this is pinned here rather than by a program
// that prints a number. Removing it and rebuilding turns beforeLoop() in
// tests/x64 probing into:
//
//   callq <bit_rt_world_addr>      ; the prefetch run
//   callq <bit_rt_gc_addr>
//   callq <bit_rt_port_sched_preempt_any_addr>
//   movsd %xmm0, %xmm14            ; reads float param `a` OUT OF THE REGISTER
//   addsd %xmm1, %xmm14            ; the two calls were free to destroy
//
// against the correct form, which binds both params to spill slots BEFORE the
// pair and reloads them after. The broken build still printed the right answer,
// because those two runtime helpers happen not to touch xmm0/xmm1 today — so
// runtime output is the wrong instrument for this and the guard belongs here.
fn checkX64ClobberPoints() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)

  // Two entry params and a self-loop: the back edge means the prefetch run is
  // emitted, so the entry block's first NON-parameter index (2) is prepended.
  let p0 = mkInstr(Op.BlockParam, i64t)
  let p1 = mkInstr(Op.BlockParam, i64t)
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 0
  let loop = IrFunc{ name: "l", paramTypes: [i64t, i64t], result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 2, instsLen: 3 }],
    instrs: [p0, p1, jmp], isFallible: false }
  assert(hasBackEdgeSafepoint(loop))
  let withPoll = xClobberPoints(loop, [9])
  assert(len(withPoll) == 2, "a back-edge function must gain the prefetch clobber point")
  assert(withPoll[0] == 2, "the prefetch clobber point is the entry block's first non-parameter index")
  assert(withPoll[1] == 9, "the given safepoints must follow, in order")

  // A FORWARD jump emits no prefetch pair, so the list is the safepoints alone.
  let fwd = mkInstr(Op.Jump, ctx.voidId)
  fwd.ival = 1
  let straight = IrFunc{ name: "f", paramTypes: [i64t, i64t], result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 2, instsLen: 3 },
      IrBlock{ instsStart: 3, paramCount: 0, instsLen: 1 }],
    instrs: [p0, p1, fwd, mkInstr(Op.Ret, ctx.voidId)], isFallible: false }
  assert(!hasBackEdgeSafepoint(straight))
  let noPoll = xClobberPoints(straight, [9])
  assert(len(noPoll) == 1 && noPoll[0] == 9, "no back edge means no extra clobber point")
}

// Signed and unsigned compares are DIFFERENT condition codes for the same
// relation. Reading a signed compare with an unsigned code silently reorders
// every negative value — no crash, just wrong answers.
fn checkX64IcmpCc() {
  assert(xCcForIcmp(Op.ICmpEq) == ccE())
  assert(xCcForIcmp(Op.ICmpNe) == ccNe())
  assert(xCcForIcmp(Op.ICmpSlt) == ccL() && xCcForIcmp(Op.ICmpUlt) == ccB())
  assert(xCcForIcmp(Op.ICmpSle) == ccLe() && xCcForIcmp(Op.ICmpUle) == ccBe())
  assert(xCcForIcmp(Op.ICmpSgt) == ccG() && xCcForIcmp(Op.ICmpUgt) == ccA())
  assert(xCcForIcmp(Op.ICmpSge) == ccGe() && xCcForIcmp(Op.ICmpUge) == ccAe())
  // The pairs must not collide — that is the whole point.
  assert(ccL() != ccB() && ccLe() != ccBe() && ccG() != ccA() && ccGe() != ccAe())
}

// Every IR op must map to its OWN machine operation. A swap in these tables is
// pure silent wrongness — the code encodes fine and computes something else.
fn checkX64DispatchMaps() {
  assert(xArithForOp(Op.Add) == XArith.Add)
  assert(xArithForOp(Op.Sub) == XArith.Sub)
  assert(xArithForOp(Op.BAnd) == XArith.And)
  assert(xArithForOp(Op.BOr) == XArith.Or)
  assert(xArithForOp(Op.BXor) == XArith.Xor)

  assert(xShiftForOp(Op.Shl) == XShift.Shl)
  assert(xShiftForOp(Op.LShr) == XShift.Shr) // LOGICAL: zero-fills
  assert(xShiftForOp(Op.AShr) == XShift.Sar) // ARITHMETIC: sign-fills
  // shr and sar differ only in whether the sign propagates — mixing them is
  // invisible on positive values and wrong on every negative one.
  assert(XShift.Shr != XShift.Sar)

  assert(xDivOpForOp(Op.SDiv) == XDivOp.SDiv)
  assert(xDivOpForOp(Op.UDiv) == XDivOp.UDiv)
  assert(xDivOpForOp(Op.SRem) == XDivOp.SRem)
  assert(xDivOpForOp(Op.URem) == XDivOp.URem)

  assert(xFArithForOp(Op.FAdd) == XFArith.FAdd)
  assert(xFArithForOp(Op.FSub) == XFArith.FSub)
  assert(xFArithForOp(Op.FMul) == XFArith.FMul)
  assert(xFArithForOp(Op.FDiv) == XFArith.FDiv)

  assert(xFCmpForOp(Op.FCmpEq) == XFCmp.FEq)
  assert(xFCmpForOp(Op.FCmpNe) == XFCmp.FNe)
  assert(xFCmpForOp(Op.FCmpLt) == XFCmp.FLt)
  assert(xFCmpForOp(Op.FCmpLe) == XFCmp.FLe)
  assert(xFCmpForOp(Op.FCmpGt) == XFCmp.FGt)
  assert(xFCmpForOp(Op.FCmpGe) == XFCmp.FGe)
}

// A float compare's operand width comes from its OPERANDS, never from its own
// result — the result is a bool (1 byte), which would select the single-precision
// compare for a pair of doubles and read half of each value.
fn checkX64DispatchFcmpWidth() {
  let ctx = newTypeContext()
  let f64t = primType(ctx, 9)
  let boolt = primType(ctx, 10)
  let cmp = mkInstr(Op.FCmpLt, boolt)
  cmp.lhs = 0
  cmp.rhs = 1
  let cx = xFnCtx([f64t, f64t, boolt], [IrBlock{ instsStart: 0, paramCount: 2, instsLen: 3 }])
  cx.ctx = ctx
  cx.f.instrs[0] = mkInstr(Op.BlockParam, f64t)
  cx.f.instrs[1] = mkInstr(Op.BlockParam, f64t)
  cx.f.instrs[2] = cmp
  assert(xEmitInst(cx, 2))
  // ucomisd %xmm0, %xmm15 — note the REX (44) sits BETWEEN the 0x66 prefix and
  // the 0f opcode, so a "660f2e" probe never matches. Taking the width from the
  // bool result drops the 0x66, emitting ucomiss and comparing the low halves.
  assert(xHexHas(cx.buf, "66440f2ef8"))
}

// The dispatch must consult xConstShiftAmount per instruction: a CONSTANT amount
// takes the immediate form, a variable one must route through cl. Hard-wiring
// either way silently shifts by the wrong amount.
fn checkX64DispatchShift() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)

  // Variable: the amount is a block param, so it goes through cl (opcode d3).
  let shV = mkInstr(Op.Shl, i64t)
  shV.lhs = 0
  shV.rhs = 1
  let cv = xFnCtx([i64t, i64t, i64t], [IrBlock{ instsStart: 0, paramCount: 2, instsLen: 3 }])
  cv.ctx = ctx
  // xFnCtx fills every slot with a const_int, so the amount must be made a real
  // block param — otherwise xConstShiftAmount reads it as the constant 0 and this
  // "variable" case is not variable at all.
  cv.f.instrs[1] = mkInstr(Op.BlockParam, i64t)
  cv.f.instrs[2] = shV
  assert(xEmitInst(cv, 2))
  assert(xHexHas(cv.buf, "49d3e5"))   // shl %cl, %r13 (dst's own register)
  assert(!xHexHas(cv.buf, "49c1e5"))  // NOT the immediate form

  // Constant: the amount is a const_int, so it takes the immediate form (c1).
  let amt = mkInstr(Op.ConstInt, i64t)
  amt.ival = 3
  let shC = mkInstr(Op.Shl, i64t)
  shC.lhs = 1
  shC.rhs = 0
  let cc = xFnCtx([i64t, i64t, i64t], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 3 }])
  cc.ctx = ctx
  cc.f.instrs[0] = amt
  cc.f.instrs[2] = shC
  assert(xEmitInst(cc, 2))
  assert(xHexHas(cc.buf, "49c1e503")) // shl $3, %r13 (dst's own register)
  assert(!xHexHas(cc.buf, "49d3e5"))  // NOT the cl form
}

// An f32 constant must be narrowed and its 32-bit pattern used; handing the f64
// bits to a 4-byte movd loads the wrong half of the value.
fn checkX64FloatConstBits() {
  assert(xFloatConstBits(1.0, 8) == 4607182418800017408) // 0x3FF0000000000000
  assert(xFloatConstBits(1.0, 4) == 1065353216)          // 0x3F800000
  assert(xFloatConstBits(1.0, 4) != xFloatConstBits(1.0, 8))
  assert(xFloatConstBits(0.0, 8) == 0 && xFloatConstBits(0.0, 4) == 0)
}

// End-to-end on a self-loop: the back-edge poll, the safepoint's return address,
// and the jump patched back to the block's real offset.
fn checkX64CompileLoop() {
  let ctx = newTypeContext()
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 0
  let f = IrFunc{ name: "loop", paramTypes: []int(0), result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [jmp], isFallible: false }
  let m = IrModule{ funcs: [f], ctx: ctx, stringPool: []string(0),
    methodTables: []MethodTable(0), stubbed: []StubbedFn(0), sm: newSourceManager() }
  let fc = xCompileFunction(m, f, XCallConv.SysV, false)

  // push rbp; mov rsp,rbp; `sub rsp, 32` for #3169's poll-cache slots. #3746
  // took those from two to three (worldAddr, gcAddr, preemptAnyAddr), so the 24
  // raw bytes round up to 32. 11 bytes of prologue.
  //
  // #3860 removed FOUR pushes from this expectation — rbx/r13/r14/r15, the whole
  // callee-saved file, which the prologue used to preserve unconditionally. This
  // body is a bare `jump bb0`: it allocates no value into any register, so there
  // is nothing for the poll's clobber to destroy and nothing to restore. The
  // poll ladder itself reaches only r10/r11/rax (xEmitInlinedPollGuard's rTmp
  // and rGc, and the prefetch's return value), none of them callee-saved.
  let h = hexOfBytes(fc.code)
  assert(len(h) > 22 && h[0:22] == "554889e54881ec20000000")
  // The narrowing is the point, so assert the empty saved set directly rather
  // than reading it out of the prologue bytes above: a stack-map `saved` table
  // with a phantom entry would restore garbage into the walker's working
  // register file when it unwound past this frame.
  assert(len(fc.savedRegs) == 0)
  // #3169: the entry prefetch fills the slots, then the back edge's inlined
  // ladder replaces #2926's guard call. #3565 added the worker-preempt clause
  // (schedCurrentWorker + preemptRequested, both real calls) between the
  // stop-pending check and the gcAddr==0 check, so the ladder emits two more
  // relocations before the real poll; #3746 added a third PREFETCH call for
  // the preempt summary word's address. Six total, and only the LAST is a
  // safepoint: the three entry prefetches and the preempt clause's two calls
  // neither allocate nor park.
  assert(len(fc.relocs) == 6)
  assert(fc.relocs[0].symbol == "bit_rt_world_addr")
  assert(fc.relocs[1].symbol == "bit_rt_gc_addr")
  assert(fc.relocs[2].symbol == "bit_rt_port_sched_preempt_any_addr")
  assert(fc.relocs[3].symbol == "bit_rt_port_sched_current_worker")
  assert(fc.relocs[4].symbol == "bit_rt_port_sched_preempt_requested")
  assert(fc.relocs[5].symbol == "bit_rt_safepoint")
  // The guard call is GONE — that is the whole ticket, so assert its absence
  // rather than inferring it from the count.
  let ri = 0
  while (ri < len(fc.relocs)) {
    assert(fc.relocs[ri].symbol != "bit_rt_safepoint_needed")
    ri = ri + 1
  }
  // Still exactly one safepoint for the edge, at the REAL poll's return
  // address, matching the one position buildIntervals recorded.
  assert(len(fc.safepoints) == 1)
  // The jmp's rel32 is measured from the END of its 4-byte field, so it must
  // resolve to block 0's real offset. A blockOffsets table left at zero would
  // jump into the prologue instead. It is the last 5 bytes emitted, and it
  // targets block 0 — which starts after the prologue AND the prefetch, not at
  // byte 0, so the displacement is not the whole code length.
  assert(len(h) >= 10 && h[len(h) - 10:len(h) - 8] == "e9")
  // Three poll-cache slots (#3746) and no xmm saves: 24 raw bytes, rounded to
  // 32 behind an even number of pushes — still zero pushes after #3860, so the
  // parity argument is unchanged and the ladder's xPollCacheOffset reads land
  // in the same three words relative to rbp.
  assert(fc.frameSize == 32)
}

// End-to-end: the whole driver on the identity function `f(a: i64): i64 { a }`.
// IR: bb0(%0: i64) { ret %0 }.
fn checkX64CompileFunction() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [0]
  let f = IrFunc{ name: "ident", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 }],
    instrs: [mkInstr(Op.BlockParam, i64t), ret], isFallible: false }
  let m = IrModule{ funcs: [f], ctx: ctx, stringPool: []string(0),
    methodTables: []MethodTable(0), stubbed: []StubbedFn(0), sm: newSourceManager() }

  let fc = xCompileFunction(m, f, XCallConv.SysV, false)
  assert(fc.name == "ident")
  let h = hexOfBytes(fc.code)
  // Frame chain first: push rbp; mov rsp,rbp. The runtime stack walker reads
  // *(fp) as the caller's fp and *(fp+8) as the return address, so this pair is
  // not optional even for a leaf.
  assert(len(h) >= 8 && h[0:8] == "554889e5")
  // The incoming argument is bound out of rdi — without this the entry param
  // holds whatever the allocator left in its register and the function returns
  // garbage.
  assert(hexHasIn(h, "4889f8")) // mov %rdi, %rax
  // ...and it ends with the frame teardown.
  assert(h[len(h) - 4:len(h)] == "5dc3") // pop %rbp; ret
  // No safepoints: a leaf with no calls and no back-edge polls nothing.
  assert(len(fc.safepoints) == 0)
  assert(len(fc.relocs) == 0)
  // The callee-saved registers it preserved are reported frame-relative, so the
  // walker can restore them when unwinding past this frame.
  let si = 0
  while (si < len(fc.savedRegs)) {
    assert(fc.savedRegs[si].fpOff == -8 * (si + 1))
    si = si + 1
  }
}

fn checkX64MarshalStackArgs() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // Seven args, every one spilled, so each source is an rbp-relative load.
  let types = []int(0)
  let locs = []RegLoc(0)
  let args = []int(0)
  let i = 0
  while (i < 7) {
    types = append(types, i64t)
    locs = append(locs, RegLoc{ isSpill: true, index: i })
    args = append(args, i)
    i = i + 1
  }
  let cx = xFnCtx(types, [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 7 }])
  cx.ctx = ctx
  cx.alloc = RegAllocResult{ locations: locs, numSpillSlots: 8,
    stackMaps: []StackMapEntry(0) }
  cx.safepointCodeOffsets = [0]
  xEmitCallLike(cx, "f7", args, false, 0, 0, true)

  let h = xHex(cx.buf)
  // The reserve comes FIRST — before any store into the area it carves, and
  // before the register moves. 8 bytes of args round up to 16 to keep rsp
  // 16-aligned at the call boundary.
  assert(len(h) >= 14 && h[0:14] == "4881ec10000000") // sub $16, %rsp
  assert(xHexHas(cx.buf, "4881c410000000"))           // add $16, %rsp (reclaimed)
  assert(len(cx.relocs) == 1 && cx.relocs[0].symbol == "f7")
  // Exactly one arg overflowed, so exactly one reserve/reclaim pair.
  assert(xHexCount(cx.buf, "4881ec10000000") == 1)
  assert(xHexCount(cx.buf, "4881c410000000") == 1)

  // Six args fit entirely in registers: no outgoing area at all.
  let six = []int(0)
  let j = 0
  while (j < 6) {
    six = append(six, j)
    j = j + 1
  }
  let c6 = xFnCtx(types, [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 7 }])
  c6.ctx = ctx
  c6.alloc = RegAllocResult{ locations: locs, numSpillSlots: 8,
    stackMaps: []StackMapEntry(0) }
  c6.safepointCodeOffsets = [0]
  xEmitCallLike(c6, "f6", six, false, 0, 0, true)
  assert(!xHexHas(c6.buf, "4881ec10000000"))
  assert(!xHexHas(c6.buf, "4881c410000000"))
}

fn checkX64CallLike() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let boolt = primType(ctx, 10)

  // A void callee takes no result: nothing may be moved out of rax.
  let cx = xFnCtx([i64t], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }])
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0]
  xEmitCallLike(cx, "bit_rt_safepoint", []int(0), false, 0, 0, true)
  assert(cx.nextSafepointIdx == 1)
  assert(xHex(cx.buf) == "e800000000") // just the call — no marshalling, no result
  assert(cx.safepointCodeOffsets[0] == 5)

  // A bool return MUST be zero-extended: the C ABI returns it in `al` and leaves
  // rax's upper bits unspecified. bit_rt_string_eq happened to zero eax,
  // bit_rt_fs_exists did not, and `!fsExists(missing)` silently read false.
  let cb = xFnCtx([boolt], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }])
  cb.ctx = ctx
  cb.safepointCodeOffsets = [0]
  xEmitCallLike(cb, "bit_rt_fs_exists", []int(0), true, 0, boolt, true)
  assert(xHexHas(cb.buf, "480fb6c0")) // movzbq %al, %rax

  // An i64 return must NOT be — narrowing a real 64-bit value to its low byte
  // would be a silent truncation.
  let ci = xFnCtx([i64t], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }])
  ci.ctx = ctx
  ci.safepointCodeOffsets = [0]
  xEmitCallLike(ci, "bit_rt_time_mono_ns", []int(0), true, 0, i64t, true)
  assert(!xHexHas(ci.buf, "480fb6c0"))
}

// Goldens from clang + llvm-objdump. The indirect-call paths: a closure cell is
// {code, env} and an interface receiver's TypeInfo is *(recv - 32).
fn checkX64IndirectCalls() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let voidt = ctx.voidId
  let blocks = [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 }]

  // call_value: the cell's CODE is at +0 and its ENV at +8. Swapping them calls
  // the environment as if it were code.
  let cx = xFnCtx([i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0]
  xEmitCallValue(cx, 0, voidt, 0, []int(0))
  assert(xHexHas(cx.buf, "4c8b930800000")) // mov 8(%rbx), %r10   env  at +8
  assert(xHexHas(cx.buf, "4c8ba30000000")) // mov (%rbx),  %r12   code at +0
  // env goes in arg0, and the call is INDIRECT through r12 — neither r10 nor r12
  // is an argument register, so marshalling cannot disturb them.
  assert(xHexHas(cx.buf, "4c89d7"))        // mov %r10, %rdi
  assert(xHexHas(cx.buf, "41ffd4"))        // call *%r12
  assert(cx.nextSafepointIdx == 1)
  // #2018: one reloc now -- the nil-check's own call to bit_rt_panic_nil_call.
  // The real dispatch is still an indirect call through %r12 and names no
  // symbol of its own.
  assert(len(cx.relocs) == 1 && cx.relocs[0].symbol == "bit_rt_panic_nil_call")

  // An argument must land in arg1, NOT arg0 — arg0 is reserved for the
  // environment, which is moved in after marshalling and would overwrite it.
  let ca = xFnCtx([i64t, i64t], blocks)
  ca.ctx = ctx
  ca.safepointCodeOffsets = [0]
  xEmitCallValue(ca, 0, voidt, 0, [1]) // vreg 1 is spilled
  assert(xHexHas(ca.buf, "488bb5f0ffffff"))  // mov -16(%rbp), %rsi   -> arg1
  assert(!xHexHas(ca.buf, "488bbdf0ffffff")) // NOT   ...    , %rdi

  // call_iface: the receiver's TypeInfo lives at *(recv - 32) — the object
  // header's info field sits BELOW the body pointer (ABI.md §2.1).
  let ci = xFnCtx([i64t, i64t], blocks)
  ci.ctx = ctx
  ci.safepointCodeOffsets = [0]
  xEmitCallIface(ci, 0, voidt, 0, 7, []int(0))
  assert(xHexHas(ci.buf, "4c8b93e0ffffff")) // mov -32(%rbx), %r10
  assert(xHexHas(ci.buf, "48c7c607000000")) // mov $7, %rsi        the method id
  // #2240: the nil-check's own call to bit_rt_panic_nil_iface now precedes
  // the real bit_rt_iface_lookup call, so it is relocs[0].
  assert(ci.relocs[0].symbol == "bit_rt_panic_nil_iface")
  assert(ci.relocs[1].symbol == "bit_rt_iface_lookup")
  assert(xHexHas(ci.buf, "4989c4"))         // mov %rax, %r12      stash the target
  assert(xHexHas(ci.buf, "41ffd4"))         // call *%r12
  // Only the METHOD call is a safepoint — the lookup itself never collects.
  assert(ci.nextSafepointIdx == 1)

  // A SPILLED receiver must be RELOADED after the lookup: xGetInt hands it back
  // in scratch1 (r11), which the lookup call clobbers. With the receiver in a
  // callee-saved register the reload is a no-op, so only the spilled case can
  // tell a correct emitter from one that reuses the stale register.
  let cs = xFnCtx([i64t, i64t], blocks)
  cs.ctx = ctx
  cs.safepointCodeOffsets = [0]
  xEmitCallIface(cs, 0, voidt, 1, 7, []int(0)) // vreg 1 is spilled
  assert(xHexCount(cs.buf, "4c8b9df0ffffff") == 2) // mov -16(%rbp), %r11  TWICE
  assert(xHexHas(cs.buf, "4d8b93e0ffffff"))        // mov -32(%r11), %r10
}

fn checkX64ControlFlow() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // Two blocks: block 0 (one instr), block 1 (one param + one instr).
  let blocks = [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 },
    IrBlock{ instsStart: 1, paramCount: 1, instsLen: 2 }]

  // A FORWARD jump polls nothing — only a back-edge needs the collector.
  let cx = xFnCtx([i64t, i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0]
  cx.curBlock = 0
  xEmitJump(cx, 1, [0])
  assert(cx.nextSafepointIdx == 0)
  assert(!xHexHas(cx.buf, "e8")) // no call at all

  // A BACK-edge polls the collector before the edge moves, so an allocation-free
  // loop still yields. The poll is a call: running it after the moves would
  // observe a half-written param set.
  // #3169: the fast path no longer calls anything but the real poll (and, since
  // #3565, the worker-preempt clause's own two calls) — #2926's guard call is
  // replaced by stwPollNeeded's own condition, inlined.
  let cb = xFnCtx([i64t, i64t, i64t], blocks)
  cb.ctx = ctx
  cb.safepointCodeOffsets = [0]
  cb.curBlock = 1
  xEmitJump(cb, 1, [0]) // target == curBlock: a self-loop
  assert(cb.nextSafepointIdx == 1) // only the real poll is a safepoint
  assert(len(cb.relocs) == 3)
  assert(cb.relocs[0].symbol == "bit_rt_port_sched_current_worker")
  assert(cb.relocs[1].symbol == "bit_rt_port_sched_preempt_requested")
  assert(cb.relocs[2].symbol == "bit_rt_safepoint")

  // The ladder, rebuilt through the SAME emitters rather than as fixed hex, so
  // a future change to an encoding cannot silently desync the two (#2927's
  // concern on the arm64 side, carried forward). This is the load-bearing
  // check: a wrong word offset or an inverted condition here is a poll that
  // never fires or one that always does, and neither fails a build.
  let want = xFnCtx([i64t, i64t, i64t], blocks)
  want.ctx = ctx
  want.safepointCodeOffsets = [0]
  let rTmp = xScratch1()
  let rGc = xScratch2()
  let pollFx = []int(0)
  let skipFx = []int(0)
  xMovLoad(want.buf, rTmp, xMemB(XReg64.Rbp, xPollCacheOffset(want.frame, 0)), 8, false)
  xTestRR(want.buf, rTmp, rTmp)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccE()))   // waddr == 0
  xMovLoad(want.buf, rTmp, xMemB(rTmp, pgWorldStopWordWord() * 8), 8, false)
  xTestRR(want.buf, rTmp, rTmp)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccNe()))  // stop pending
  // #3565: the worker-preempt clause, rebuilt through the same emitters
  // xEmitPreemptClause uses — see that function's own comment for why each
  // step is there. want.cc is SysV (xCallTestCtx), so xShadowSpace(want.cc)
  // is 0 and neither call needs the shadow-space push/pop xEmitPreemptClause
  // guards with `if (shadow > 0)`.
  //
  // #3746's fast-path gate comes FIRST and is pinned here for the same reason
  // the rest of the ladder is: it is the load-bearing part of the fix, and a
  // silent loss of the `jz` past the two calls would restore the measured
  // 3.28x with every behavioural gate still green.
  xMovLoad(want.buf, rTmp, xMemB(XReg64.Rbp, xPollCacheOffset(want.frame, 2)), 8, false)
  xMovLoad(want.buf, rTmp, xMemB(rTmp, 0), 8, false)
  xTestRR(want.buf, rTmp, rTmp)
  let noneSkip = xJccRel32Placeholder(want, ccE())              // nothing pending
  xEmitCallLike(want, xSchedCurrentWorkerSymbol(), []int(0), false, 0, 0, false)
  xMovRR(want.buf, rTmp, XReg64.Rax)
  xTestRR(want.buf, rTmp, rTmp)
  let workerSkip = xJccRel32Placeholder(want, ccE())            // worker == 0
  xMovLoad(want.buf, rTmp, xMemB(rTmp, xPreemptWkIdWord() * 8), 8, false)
  xMovRR(want.buf, xArg0(want.cc), rTmp)
  xCallReloc(want, xPreemptRequestedSymbol())
  xMovzxb(want.buf, XReg64.Rax, XReg64.Rax)
  xTestRR(want.buf, XReg64.Rax, XReg64.Rax)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccNe()))   // preempt requested
  xPatchRel32Here(want, workerSkip)
  xPatchRel32Here(want, noneSkip)
  xMovLoad(want.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(want.frame, 1)), 8, false)
  xTestRR(want.buf, rGc, rGc)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccE()))   // gcAddr == 0
  xMovLoad(want.buf, rTmp, xMemB(rGc, pgGcCfgStressWord() * 8), 8, false)
  xTestRR(want.buf, rTmp, rTmp)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccNe()))  // stress mode
  xMovLoad(want.buf, rTmp, xMemB(rGc, pgGcCfgEnabledWord() * 8), 8, false)
  xTestRR(want.buf, rTmp, rTmp)
  skipFx = append(skipFx, xJccRel32Placeholder(want, ccE()))   // disabled -> skip
  xMovLoad(want.buf, rTmp, xMemB(rGc, pgGcHeapAddrWord() * 8), 8, false)
  xMovLoad(want.buf, rTmp, xMemB(rTmp, pgHeapLiveWordWord() * 8), 8, false)
  xMovLoad(want.buf, rGc, xMemB(rGc, pgGcNextBytesWord() * 8), 8, false)
  xArithRR(want.buf, XArith.Cmp, rTmp, rGc)
  skipFx = append(skipFx, xJccRel32Placeholder(want, ccL()))   // under trigger -> skip
  // #3359: the object half of the trigger. `liveBytes - nextBytes >= nextBytes`
  // IS `liveBytes >= nextBytes * 2` with no overflow, so no saturation guard
  // appears here; the object compare falls THROUGH to the poll.
  xArithRR(want.buf, XArith.Sub, rTmp, rGc)
  xArithRR(want.buf, XArith.Cmp, rTmp, rGc)
  pollFx = append(pollFx, xJccRel32Placeholder(want, ccGe()))  // second cycle -> poll
  xMovLoad(want.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(want.frame, 1)), 8, false)
  xMovLoad(want.buf, rTmp, xMemB(rGc, pgGcNumObjectsIdxWord() * 8), 8, false)
  xMovLoad(want.buf, rGc, xMemB(rGc, pgGcNextObjectsWord() * 8), 8, false)
  xArithRR(want.buf, XArith.Cmp, rTmp, rGc)
  skipFx = append(skipFx, xJccRel32Placeholder(want, ccL()))   // not caught up -> skip
  // Five exits converge on the real poll; three skip past it.
  let pi = 0
  while (pi < len(pollFx)) {
    xPatchRel32Here(want, pollFx[pi])
    pi = pi + 1
  }
  xEmitCallLike(want, safepointSymbol(), []int(0), false, 0, 0, true)
  pi = 0
  while (pi < len(skipFx)) {
    xPatchRel32Here(want, skipFx[pi])
    pi = pi + 1
  }
  // The edge's own moves come AFTER the poll — running them first would let the
  // collector observe a half-written param set — then the jump itself.
  xEmitParamMoves(want, 1, [0])
  xJmpRel32(want, 1)
  assert(xHex(cb.buf) == xHex(want.buf))
  // The real poll's return address is where the one safepoint sits — not the
  // end of the emitted edge, and not any point in the ladder.
  assert(cb.safepointCodeOffsets[0] == want.safepointCodeOffsets[0])
  assert(cb.safepointCodeOffsets[0] > 0)

  // A br tests the condition against ITSELF — `test r,r` sets ZF iff r is zero,
  // which is the whole condition; comparing against an immediate would need an
  // extra materialization.
  let cr = xFnCtx([i64t, i64t, i64t], blocks)
  cr.ctx = ctx
  cr.safepointCodeOffsets = [0, 0]
  cr.curBlock = 0
  xEmitBr(cr, 0, 1, [0], 1, [0])
  assert(xHexHas(cr.buf, "4885db")) // test %rbx, %rbx  (vreg 0 lives in rbx)
  assert(cr.nextSafepointIdx == 0)  // both targets are forward

  // ret moves the value into the ABI return register, then runs the epilogue —
  // in that order. The epilogue pops the callee-saved registers, so computing the
  // return value after it would read restored (caller-owned) values.
  let cq = xFnCtx([i64t], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }])
  cq.ctx = ctx
  assert(xEmitRet(cq, [0]))
  assert(xHexHas(cq.buf, "4889d8")) // mov %rbx, %rax  BEFORE the pops
  assert(xHexHas(cq.buf, "5b"))     // pop %rbx
  assert(xHexHas(cq.buf, "c3"))     // ret
  let hexq = xHex(cq.buf)
  assert(len(hexq) >= 6 && hexq[0:6] == "4889d8") // the move is FIRST

  // A multi-value ret has no settled packing: refuse rather than emit something.
  let cm = xFnCtx([i64t, i64t], [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 2 }])
  cm.ctx = ctx
  assert(!xEmitRet(cm, [0, 1]))
}

// #3411: xBindIncomingArgs mirrored xMarshalArgs (compiler/x64call.bit) for the
// register banks but was never updated for Win64's 32-byte shadow space, which
// the CALLER reserves between the return address and its outgoing stack args
// (xEmitCallLike) — so the callee's incoming stack params must skip it too.
// This is the fourth Win64 home-space bug (#3355, #3373, #3376) and pins the
// offset directly so a fifth cannot land unnoticed.
fn checkX64BindIncomingArgsWin64() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // Seven int params: SysV takes 6 in registers, Win64 only 4 — seven always
  // leaves at least one on the stack in both conventions.
  let types = [i64t, i64t, i64t, i64t, i64t, i64t, i64t]
  let entry = IrBlock{ instsStart: 0, paramCount: 7, instsLen: 7 }
  let instrs = []IrInstr(0)
  let i = 0
  while (i < 7) {
    instrs = append(instrs, mkInstr(Op.BlockParam, i64t))
    i = i + 1
  }
  // Destinations that collide with NO argument register in either convention
  // (rdi/rsi/rdx/rcx/r8/r9 SysV, rcx/rdx/r8/r9 Win64), so every incoming move
  // is independent of its own source and of every other move.
  let dsts = [XReg64.Rbx, XReg64.R10, XReg64.R11, XReg64.R12, XReg64.R13, XReg64.R14, XReg64.R15]

  // SysV: the 7th param (index 6) is the only one on the stack, and it must
  // stay at [rbp+16] — this fix must not move x86_64-linux/macos at all.
  let sv = newXCtx(XCallConv.SysV)
  sv.ctx = ctx
  sv.f = IrFunc{ name: "f7", paramTypes: types, result: i64t, blocks: [entry],
    instrs: instrs, isFallible: false }
  sv.intRegs = dsts
  let svLocs = []RegLoc(0)
  let p = 0
  while (p < 7) { svLocs = append(svLocs, RegLoc{ isSpill: false, index: p }); p = p + 1 }
  sv.alloc = RegAllocResult{ locations: svLocs, numSpillSlots: 0, stackMaps: []StackMapEntry(0) }
  xBindIncomingArgs(sv)
  let svWant = newXCtx(XCallConv.SysV)
  xMovLoad(svWant.buf, dsts[6], xMemB(XReg64.Rbp, 16), 8, false)
  assert(xHexHas(sv.buf, xHex(svWant.buf)))

  // Win64: only the first 4 params arrive in registers, so params 4, 5 and 6
  // are all on the stack, past the caller's 32-byte shadow space — at
  // [rbp+48], [rbp+56], [rbp+64]. Before this fix they read [rbp+16],
  // [rbp+24], [rbp+32]: the shadow space's own words, not the arguments.
  let win = newXCtx(XCallConv.Win64)
  win.ctx = ctx
  win.f = IrFunc{ name: "f7", paramTypes: types, result: i64t, blocks: [entry],
    instrs: instrs, isFallible: false }
  win.intRegs = dsts
  let winLocs = []RegLoc(0)
  let q = 0
  while (q < 7) { winLocs = append(winLocs, RegLoc{ isSpill: false, index: q }); q = q + 1 }
  win.alloc = RegAllocResult{ locations: winLocs, numSpillSlots: 0, stackMaps: []StackMapEntry(0) }
  xBindIncomingArgs(win)
  let w48 = newXCtx(XCallConv.Win64)
  xMovLoad(w48.buf, dsts[4], xMemB(XReg64.Rbp, 48), 8, false)
  assert(xHexHas(win.buf, xHex(w48.buf)))
  let w56 = newXCtx(XCallConv.Win64)
  xMovLoad(w56.buf, dsts[5], xMemB(XReg64.Rbp, 56), 8, false)
  assert(xHexHas(win.buf, xHex(w56.buf)))
  let w64 = newXCtx(XCallConv.Win64)
  xMovLoad(w64.buf, dsts[6], xMemB(XReg64.Rbp, 64), 8, false)
  assert(xHexHas(win.buf, xHex(w64.buf)))

  // The regression itself, pinned directly: the pre-fix code read the first
  // Win64 stack arg at [rbp+16] — assert that instruction is now absent.
  let wrong = newXCtx(XCallConv.Win64)
  xMovLoad(wrong.buf, dsts[4], xMemB(XReg64.Rbp, 16), 8, false)
  assert(!xHexHas(win.buf, xHex(wrong.buf)))
}

fn checkX64CallHelpers() {
  // A safepoint is recorded at the RETURN ADDRESS — the offset AFTER the call —
  // because that is what the collector's stack walker looks a frame up by
  // (runtime/ABI.md §5). Recording the call's own offset leaves every lookup
  // missing.
  let cx = newXCtx(XCallConv.SysV)
  xCallReloc(cx, "bit_rt_gc_alloc")
  cx.safepointCodeOffsets = [0]
  xRecordSafepoint(cx)
  assert(cx.nextSafepointIdx == 1)
  assert(cx.safepointCodeOffsets[0] == 5)                  // past the whole e8+rel32
  assert(cx.safepointCodeOffsets[0] != cx.relocs[0].offset) // NOT the reloc's field offset

  // The first argument register is the one place the conventions differ for a
  // single-argument runtime call.
  assert(xArg0(XCallConv.SysV) == XReg64.Rdi)
  assert(xArg0(XCallConv.Win64) == XReg64.Rcx)

  // The closure cell: {code_ptr at +0, env_ptr at +8}, 16 bytes, with the env
  // as its ONLY GC field — the code pointer points into .text and must never be
  // traced.
  assert(xClosureCellSize() == 16)
  assert(len(xClosureCellPtrOffsets()) == 1)
  assert(xClosureCellPtrOffsets()[0] == 8)
}
