// In-Bit self-checks for the x86-64 backend's per-function compile driver:
// xCompileFunction end-to-end (prologue, poll-cache slot, frame size,
// callee-saved reporting) and the outgoing stack-argument marshalling area.
// Split three ways out of this file (#5638), which sat at exactly the
// 800-line E0200 ceiling: dispatch tables, flag scanning and clobber points
// moved to x64dispatchcheck.bit; call emission, indirect calls and the
// Win64 incoming-args fix moved to x64callcheck.bit; br/jump/poll/ret
// control flow moved to x64controlflowcheck.bit.
//
// Split out of selfcheck.bit originally (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly and nothing here
// is imported.

// End-to-end on a self-loop: the back-edge poll, the safepoint's return address,
// and the jump patched back to the block's real offset.
fn checkX64CompileLoop() {
  let ctx = newTypeContext()
  let jmp = mkInstr(Op.Jump, ctx.voidId)
  jmp.ival = 0
  let f = IrFunc{
    name = "loop", paramTypes = []int(0), result = ctx.voidId,
    blocks = [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 1 }],
    instrs = [jmp], isFallible = false,
  }
  let m = IrModule{
    funcs = [f], ctx = ctx, stringPool = []string(0),
    methodTables = []MethodTable(0), stubbed = []StubbedFn(0), sm = newSourceManager(),
  }
  let fc = xCompileFunction(m, f, XCallConv.SysV, false)

  // push rbp; mov rsp,rbp; `sub rsp, 16` for #3169's poll-cache slot. #4203 took
  // those from four to ONE (the attention word's address), so 8 raw bytes round
  // up to 16. 11 bytes of prologue.
  //
  // #3860 removed FOUR pushes from this expectation — rbx/r13/r14/r15, the whole
  // callee-saved file, which the prologue used to preserve unconditionally. This
  // body is a bare `jump bb0`: it allocates no value into any register, so there
  // is nothing for the poll's clobber to destroy and nothing to restore. The
  // poll guard itself reaches only r11/rax (xEmitPollGuard's scratch
  // and rGc, and the prefetch's return value), none of them callee-saved.
  let h = hexOfBytes(fc.code)
  assert(len(h) > 22 && h[0:22] == "554889e54881ec10000000")
  // The narrowing is the point, so assert the empty saved set directly rather
  // than reading it out of the prologue bytes above: a stack-map `saved` table
  // with a phantom entry would restore garbage into the walker's working
  // register file when it unwound past this frame.
  assert(len(fc.savedRegs) == 0)
  // #3169/#4203: the entry prefetch fills the one slot, then the back edge
  // reads the word it points at. TWO relocations for a whole polling function,
  // where this pin read SIX before #4203 — three entry prefetches
  // (bit_rt_world_addr, bit_rt_gc_addr, bit_rt_port_sched_preempt_any_addr) and
  // the ladder's own two scheduler calls (#3565) on top of the real poll. Only
  // the LAST is a safepoint: the prefetch neither allocates nor parks.
  assert(len(fc.relocs) == 2)
  assert(fc.relocs[0].symbol == "bit_rt_port_sched_poll_attention_addr")
  assert(fc.relocs[1].symbol == "bit_rt_safepoint")
  // The guard call is GONE — that is the whole ticket, so assert its absence
  // rather than inferring it from the count.
  let ri = 0
  while (ri < len(fc.relocs)) {
    assert(fc.relocs[ri].symbol != "bit_rt_safepoint_needed")
    ri = ri + 1
  }
  // Still exactly one safepoint for the edge, at the REAL poll's return
  // address, matching the one position buildIntervals recorded.
  assert(len(fc.safepoints) == 1)
  // The jmp's rel32 is measured from the END of its 4-byte field, so it must
  // resolve to block 0's real offset. A blockOffsets table left at zero would
  // jump into the prologue instead. It is the last 5 bytes emitted, and it
  // targets block 0 — which starts after the prologue AND the prefetch, not at
  // byte 0, so the displacement is not the whole code length.
  assert(len(h) >= 10 && h[len(h) - 10:len(h) - 8] == "e9")
  // ONE poll-cache slot since #4203: 8 raw bytes, rounded up to 16 behind an
  // even number of pushes — still zero after #3860. This number DID move (it
  // was 32 for #3746's three addresses and again for #4200's four slots, which
  // is why the old comment warned that an unchanged 32 was not evidence of a
  // slot count), so it is real evidence here.
  assert(fc.frameSize == 16)
}

// End-to-end: the whole driver on the identity function `f(a: i64): i64 { a }`.
// IR: bb0(%0: i64) { ret %0 }.
fn checkX64CompileFunction() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [0]
  let f = IrFunc{
    name = "ident", paramTypes = [i64t], result = i64t,
    blocks = [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 2 }],
    instrs = [mkInstr(Op.BlockParam, i64t), ret], isFallible = false,
  }
  let m = IrModule{
    funcs = [f], ctx = ctx, stringPool = []string(0),
    methodTables = []MethodTable(0), stubbed = []StubbedFn(0), sm = newSourceManager(),
  }

  let fc = xCompileFunction(m, f, XCallConv.SysV, false)
  assert(fc.name == "ident")
  let h = hexOfBytes(fc.code)
  // Frame chain first: push rbp; mov rsp,rbp. The runtime stack walker reads
  // *(fp) as the caller's fp and *(fp+8) as the return address, so this pair is
  // not optional even for a leaf.
  assert(len(h) >= 8 && h[0:8] == "554889e5")
  // The incoming argument is bound out of rdi — without this the entry param
  // holds whatever the allocator left in its register and the function returns
  // garbage.
  assert(hexHasIn(h, "4889f8")) // mov %rdi, %rax
  // ...and it ends with the frame teardown.
  assert(h[len(h) - 4:len(h)] == "5dc3") // pop %rbp; ret
  // No safepoints: a leaf with no calls and no back-edge polls nothing.
  assert(len(fc.safepoints) == 0)
  assert(len(fc.relocs) == 0)
  // The callee-saved registers it preserved are reported frame-relative, so the
  // walker can restore them when unwinding past this frame.
  let si = 0
  while (si < len(fc.savedRegs)) {
    assert(fc.savedRegs[si].fpOff == -8 * (si + 1))
    si = si + 1
  }
}

fn checkX64MarshalStackArgs() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // Seven args, every one spilled, so each source is an rbp-relative load.
  let types = []int(0)
  let locs = []RegLoc(0)
  let args = []int(0)
  let i = 0
  while (i < 7) {
    types = append(types, i64t)
    locs = append(locs, RegLoc{ isSpill = true, index = i })
    args = append(args, i)
    i = i + 1
  }
  let cx = xFnCtx(types, [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 7 }])
  cx.ctx = ctx
  cx.alloc = RegAllocResult{
    locations = locs, numSpillSlots = 8,
    stackMaps = []StackMapEntry(0),
  }
  cx.safepointCodeOffsets = [0]
  xEmitCallLike(cx, "f7", args, false, 0, 0, true)

  let h = xHex(cx.buf)
  // The reserve comes FIRST — before any store into the area it carves, and
  // before the register moves. 8 bytes of args round up to 16 to keep rsp
  // 16-aligned at the call boundary.
  assert(len(h) >= 14 && h[0:14] == "4881ec10000000") // sub $16, %rsp
  assert(xHexHas(cx.buf, "4881c410000000"))           // add $16, %rsp (reclaimed)
  assert(len(cx.relocs) == 1 && cx.relocs[0].symbol == "f7")
  // Exactly one arg overflowed, so exactly one reserve/reclaim pair.
  assert(xHexCount(cx.buf, "4881ec10000000") == 1)
  assert(xHexCount(cx.buf, "4881c410000000") == 1)

  // Six args fit entirely in registers: no outgoing area at all.
  let six = []int(0)
  let j = 0
  while (j < 6) {
    six = append(six, j)
    j = j + 1
  }
  let c6 = xFnCtx(types, [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 7 }])
  c6.ctx = ctx
  c6.alloc = RegAllocResult{
    locations = locs, numSpillSlots = 8,
    stackMaps = []StackMapEntry(0),
  }
  c6.safepointCodeOffsets = [0]
  xEmitCallLike(c6, "f6", six, false, 0, 0, true)
  assert(!xHexHas(c6.buf, "4881ec10000000"))
  assert(!xHexHas(c6.buf, "4881c410000000"))
}

// #5667 end to end: a function whose whole frame carve is the 8-byte alignment
// pad must come out of here with the pad register PUSHED and REPORTED. The
// prologue and the stack map's recovery table are built from one list
// (xPadSavedGpr, x64frame.bit) precisely so they cannot disagree — a frame that
// pushes a register its unwind data does not name restores every register below
// it from an address 8 bytes off, which corrupts a stack walk rather than
// faulting where the bug is. checkX64FramePadPush (x64framecheck.bit) pins the
// selection rule; this pins that xCompileFunction actually carries it through.
fn checkX64CompilePadPush() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // bb0(p0): rtcall; t = p0 + p0; ret t. The call is a safepoint, so `p0` is
  // live across a clobber point and the allocator must give it a callee-saved
  // register — ONE of them, which is the odd count that asks for the pad.
  let call = mkInstr(Op.RtCall, ctx.voidId)
  call.name = "safepoint"
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 0
  add.rhs = 0
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [2]
  let f = IrFunc{
    name = "padded", paramTypes = [i64t], result = i64t,
    blocks = [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 4 }],
    instrs = [mkInstr(Op.BlockParam, i64t), call, add, ret], isFallible = false,
  }
  let m = IrModule{
    funcs = [f], ctx = ctx, stringPool = []string(0),
    methodTables = []MethodTable(0), stubbed = []StubbedFn(0), sm = newSourceManager(),
  }
  let fc = xCompileFunction(m, f, XCallConv.SysV, false)
  let h = hexOfBytes(fc.code)

  // The carve is gone entirely — that is the whole ticket. Not "smaller": a
  // frame of 8 would still cost the seven-byte sub and its add per return path.
  assert(fc.frameSize == 0)
  assert(!hexHasIn(h, "4881ec") && !hexHasIn(h, "4881c4"))

  // TWO registers reported, where the allocation used one: rbx for the value
  // live across the call, r13 for the pad. This count is what catches a pad
  // pushed without being recorded — nothing else in this file would, since the
  // prologue bytes of a 1-entry table are a PREFIX of the real 2-push prologue.
  assert(len(fc.savedRegs) == 2)
  assert(fc.savedRegs[0].reg == xRegNum(XReg64.Rbx) && fc.savedRegs[0].fpOff == -8)
  assert(fc.savedRegs[1].reg == xRegNum(XReg64.R13) && fc.savedRegs[1].fpOff == -16)
  // ...and both are really pushed, in that order, right after the frame chain.
  assert(len(h) > 14 && h[0:14] == "554889e5" + "53" + "4155")
  // The epilogue mirrors it: pop r13, pop rbx, pop rbp, ret.
  assert(h[len(h) - 10:len(h)] == "415d" + "5b" + "5d" + "c3")
}
