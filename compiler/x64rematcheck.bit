// In-Bit self-checks for x86-64 constant rematerialization (#5867): the
// allocator's mark at the real call site in `xBuildAllocPhase`, and the three
// emission paths that read a slotless constant (operand load, parallel move,
// outgoing stack argument). Sibling .bit file, same module: `selfcheck()` calls
// `checkX64Remat` directly and nothing here is imported.

fn checkX64Remat() {
  checkX64RematMarking()
  checkX64RematEmission()
}

// `bb0(%0: i64) { %1 = const_int <wide>; %2 = add %0, %1; ret %2 }` allocated
// out of ONE register, so %0 and %1 cannot both have one. The constant is too
// wide for any imm32 fold, so only the allocator's mark can keep its
// definition from materializing.
fn checkX64RematMarking() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let k = mkInstr(Op.ConstInt, i64t)
  k.ival = 0x1234567890abcdef
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 0
  add.rhs = 1
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [2]
  let f = IrFunc{
    name = "remat", paramTypes = [i64t], result = i64t,
    blocks = [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 4 }],
    instrs = [mkInstr(Op.BlockParam, i64t), k, add, ret], isFallible = false,
  }
  let m = IrModule{
    funcs = [f], ctx = ctx, stringPool = []string(0),
    methodTables = []MethodTable(0), stubbed = []StubbedFn(0), sm = newSourceManager(),
  }
  let regs = XFrameRegs{
    module = m, cc = XCallConv.SysV, ctx = ctx, flags = xScanFuncFlags(f),
    intRegs = [XReg64.Rbx], floatRegs = xBuildFloatRegs(),
  }
  let a = xBuildAllocPhase(f, regs)
  let loc = a.result.locations[1]
  assert(loc.isSpill && loc.index == -1, "x64 gives an evicted constant no slot")
  assert(a.skipConst[1], "a slotless constant's definition materializes nothing")
  assert(!a.skipConst[0] && !a.skipConst[2])
}

fn checkX64RematEmission() {
  // Operand load: the constant is recomputed into the scratch, no frame read.
  // movabs r11, 0x1234567890abcdef = 49 bb <imm64 LE>.
  let cx = newXCtx(XCallConv.SysV)
  let k = mkInstr(Op.ConstInt, 0)
  k.ival = 0x1234567890abcdef
  cx.f.instrs = [k]
  cx.alloc.locations = [RegLoc{ isSpill = true, index = -1 }]
  let r = xGetInt(cx, 0, xScratch1())
  assert(r == xScratch1())
  assert(xHex(cx.buf) == "49bbefcdab9078563412", "a slotless constant is recomputed")
  let p = xPlocOf(cx, 0, RegClass.Int)
  assert(p.isImm && p.v == 0x1234567890abcdef)

  // Parallel move: the immediate is written LAST, after the move that still
  // reads rax's old value. mov %rax, %rcx (48 89 c1), then mov $7, %rax
  // (48 c7 c0 07 00 00 00). Emitted first, it would hand rcx the 7.
  let cx2 = newXCtx(XCallConv.SysV)
  xSequentializeAndEmit(
    cx2,
    [
      PMove{ src = plocImm(7, RegClass.Int), dst = plocReg(0, RegClass.Int) },
      PMove{ src = plocReg(0, RegClass.Int), dst = plocReg(1, RegClass.Int) },
    ],
  )
  assert(xHex(cx2.buf) == "4889c148c7c007000000", "an immediate move runs last")

  // Outgoing stack argument: mov $7, %r11; mov %r11, 8(%rsp).
  let cx3 = newXCtx(XCallConv.SysV)
  xEmitStackArgStore(
    cx3,
    XStackArg{ src = plocImm(7, RegClass.Int), regClass = RegClass.Int, offset = 8 },
  )
  let h = xHex(cx3.buf)
  assert(len(h) > 14 && h[0:14] == "49c7c307000000", "a stack argument takes the immediate")
}
