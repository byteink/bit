// Self-host: validation of expression forms (#1503, split out of validate.bit).
// Interpolation, variant arity, generic bounds, enum inference and match arms,
// call/index receivers, and comparison operands. Unknown-member lookup (E0057)
// is compiler/validatemember.bit (#2476).

// ---- E0073 not-stringable: string interpolation operands (§5.7) ------------

// Whether `ty` has a `show(): string` method. Struct and interface method sets
// are keyed uniformly as `"${typeId}.method"`, so one lookup covers both; a
// wrong-shaped `show` (any parameters, or a non-string result) does not count.
fn vHasShow(c: Checker, ty: int): bool {
  let sig = methodSigLookup(c, "${ty}.show")
  if (sig == 0) { return false }
  let st = c.ctx.types[sig]
  return len(st.members) == 0 && st.result == primType(c.ctx, 11)
}

// §5.7: a value interpolates iff it is a primitive or has a `show(): string`
// method. The caller defaults untyped constants first (they adopt a prim), so
// only untyped nil, void, composites, and show-less named types reach false.
fn vStringConvertible(c: Checker, ty: int): bool {
  if (c.ctx.types[ty].kind == TypeKind.Prim) { return true }
  return vHasShow(c, ty)
}

// Does `ty` still mention a rigid type parameter, at any depth? A generic body
// is checked once against its own `T`, so an operand naming `T` cannot be judged
// here — the seed defers it to each monomorphization (which bit2 does not
// re-check). Skipping such operands leaves the generic interpolation MISSING
// (safe) instead of judging it against the un-substituted `T`.
//
// A NOMINAL type is open when any of its type ARGUMENTS is (#1556): `Box<T>` and
// the bare template `Box` both still mention `T`, while `Box<i64>` does not.
// Without the nominal arm this bottomed out at `false` for every struct, which
// let `fieldAccessType` keep a `Box<T>` / `[]Box<T>` declared field type in
// preference to the checker's substituted one.
fn vHasTypeParam(c: Checker, ty: int, depth: int): bool {
  if (depth >= 32) { return true } // undecided -> skip, never invent an error
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.TypeParam) { return true }
  if (k == TypeKind.Struct || k == TypeKind.Enum || k == TypeKind.Interface) {
    for a of nominalArgsOf(c, ty) {
      if (a != 0 && vHasTypeParam(c, a, depth + 1)) { return true }
    }
    return false
  }
  if (k == TypeKind.Slice || k == TypeKind.Chan || k == TypeKind.Array) {
    return vHasTypeParam(c, t.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vHasTypeParam(c, t.mapKey, depth + 1) || vHasTypeParam(c, t.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vHasTypeParam(c, t.result, depth + 1) || vHasTypeParam(c, t.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    for m of t.members {
      if (vHasTypeParam(c, m, depth + 1)) { return true }
    }
    if (k == TypeKind.Func) { return vHasTypeParam(c, t.result, depth + 1) }
    return false
  }
  return false
}

// Validates a `"...${expr}..."` interpolation: every operand part must convert to
// string. Parts alternate literal `StrPart` chunks and operand expressions.
fn vInterp(c: Checker, node: int) {
  for p of kidsOf(c.tree, node) {
    if (p == 0 || getNode(c.tree, p).tag == Tag.StrPart) { continue }
    // Prefer the type the SWEEP already cached for this node: it is the
    // authoritative one (it feeds --dump-types and matches the seed), and it is
    // present because the operand's node precedes this FuncDecl in arena order.
    // A fresh checkExprType recompute can diverge on a nested generic call —
    // genericResultAt re-binds a type param the cached pass left unbound, so
    // `unwrap(Opt<Opt<i64>>): i64` recomputes as 'Opt'. Fall back to a recompute
    // only for operands the sweep does not cache (a bare ident use).
    let ty = c.nodeTypes[p]
    if (ty == 0) { ty = checkExprType(c, p) }
    ty = defaultType(c, ty)
    // Undecidable operands are skipped (the safety rule): an inference gap
    // (`invalid`, bare or nested) or an open type param must never become a
    // spurious diagnostic on code the seed accepts.
    if (ty == 0 || vMentionsInvalid(c, ty, 0) || vHasTypeParam(c, ty, 0)) { continue }
    if (!vStringConvertible(c, ty)) {
      // The predeclared `error` interface (§10.6) carries `message(): string`,
      // not `show(): string` — the generic hint below names a method the value
      // does not have and stays silent about the one it does (#2156). Name it.
      let hint = "only primitives and types with a 'show(): string' method convert to string"
      if (ty == c.ctx.errorId) {
        hint = "'error' has 'message(): string', not 'show(): string' — write '.message()' to interpolate it"
      }
      report(c.diags, ecNotStringable, vSpan(c, p),
        "cannot interpolate a value of type '${typeName(c.ctx, ty)}'", hint)
    }
  }
}

// ---- E0050 variant-construction arity (§13.7) ------------------------------

// Checks `Enum.Variant(args)` builds the variant with the right number of
// payload values. Only a member callee whose base names an enum type and whose
// variant exists is judged (unknown variants are E0070's concern elsewhere); the
// span is the whole call, matching the seed. Method calls skip here — their base
// is a value, not a type, so userTypeLookup misses.
fn vVariantArity(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(c.tree, callee) // [base, name]
  let baseName = typeNodeName(c, mk[0])
  if (baseName == "") {
    return
  }
  let ut = userTypeLookup(c, baseName)
  if (ut == 0 || c.ctx.types[ut].kind != TypeKind.Enum) {
    return
  }
  let vn = getNode(c.tree, mk[1])
  let vname = c.source[vn.span.start:vn.span.end]
  if (vIndexOfName(vEnumVariantNames(c, ut), vname) < 0) {
    return
  }
  let want = len(variantPayloadTypes(c, ut, vname))
  let got = len(kidsOf(c.tree, kids[2]))
  if (want != got) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "variant '${vname}' takes ${want} argument(s), found ${got}")
  }
}

// ---- E0051 generic bound violation (§15.3) ---------------------------------

// Checks a generic free-function call's inferred type arguments against each
// type parameter's interface bound (E0051) — a direct port's
// `instantiateFunc`. The bound is read straight off the decl's type-param node
// (not the flat `typeParamConstraints`, which the last `<T: I>` in the module
// clobbers), and the arg comes from the same `genericTypeArgs` the sweep records
// instantiations with, so the pairing matches the seed's env exactly. The safety
// rule gates every judgement: only a confidently-concrete arg against a
// concrete, non-generic interface bound is tested — an unbound (void) or
// un-inferred arg is skipped so an inference gap never becomes a false positive
// (the seed emits E0068 for those, elsewhere). Method-call / member callees are
// left alone; only a bare-ident free generic reaches here.
fn vGenericBound(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]
  if (shadowedByValue(c, callee, name)) {
    return // a local value shadows the free function
  }
  if (!isGenericFuncAt(c, callee, name)) {
    return
  }
  let fr = funcRefAt(c, callee, name)
  let decl = fr.decl
  if (decl == 0) {
    return
  }
  // The decl's type-param and constraint nodes live in its OWNING module's tree.
  let oc = fr.owner
  let dk = kidsOf(oc.tree, decl) // [recv, name, generics, params, result, body]
  let tps = kidsOf(oc.tree, dk[2])
  let args = genericTypeArgs(c, name, node)
  if (len(args) != len(tps)) {
    return
  }
  let i = 0
  while (i < len(tps)) {
    let gk = kidsOf(oc.tree, tps[i]) // [name, constraint_group?]
    if (gk[1] != 0) {
      let cons = kidsOf(oc.tree, gk[1])
      if (len(cons) > 0) {
        let boundIface = typeFromNode(oc, cons[0])
        let arg = args[i]
        if (arg != 0 && arg != c.ctx.voidId && !vMentionsInvalid(c, arg, 0) &&
            !vHasTypeParam(c, arg, 0) && boundIface != 0 &&
            !vMentionsInvalid(c, boundIface, 0) && !vHasTypeParam(c, boundIface, 0) &&
            c.ctx.types[boundIface].kind == TypeKind.Interface &&
            !vSatisfies(c, arg, boundIface)) {
          report(c.diags, ecMissingMethod, vSpan(c, node),
            "type argument ${i} does not satisfy its interface bound",
            "check the interface's method set against this type")
        }
      }
    }
    i = i + 1
  }
}

// ---- E0068 cannot-infer enum type arguments (§14.7) ------------------------

// The number of `<...>` type parameters on an enum's declaration (0 for a plain
// enum). The generics node is kid 1 of the EnumDecl, in the declaring module's
// tree.
fn vEnumGenericArity(c: Checker, enumTy: int): int {
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, kidsOf(oc.tree, decl)[1]))
}

// Emits E0068 for `let x = Enum.Variant` where `Enum` is GENERIC and `Variant`
// carries no payload — derived from `checkVariantRef`/`enumInstance`.
// A bare no-payload variant reference carries no argument to solve the enum's
// type parameters, so without an annotated target the instantiation is
// unsolvable. Restricted to the un-annotated binding context precisely because
// that is the one place `expected` is provably absent: an annotation, a return
// target, or a call-argument slot all supply it, and check.bit does not thread
// that expectation, so judging any other context risks a false positive. A
// payload variant is a constructor CALL (handled elsewhere, and it can infer
// from its args); an unknown variant name is E0070's concern; a plain (non-
// generic) enum's variant is already concrete.
fn vInferEnum(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  if (kids[1] != 0) {
    return // annotated: the target type supplies the arguments
  }
  let init = kids[2]
  if (init == 0 || getNode(c.tree, init).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(c.tree, init) // [base, name]
  // A turbofish base `Opt<i64>.None` (a GenericInst) supplies the type arguments
  // explicitly — the seed resolves it via `enumTurbofish` before ever reaching
  // the cannot-infer path. Only a BARE enum name has nothing to solve `T` with.
  if (getNode(c.tree, mk[0]).tag != Tag.Ident) {
    return
  }
  let baseName = typeNodeName(c, mk[0])
  if (baseName == "") {
    return
  }
  let ut = userTypeLookup(c, baseName)
  if (ut == 0 || c.ctx.types[ut].kind != TypeKind.Enum) {
    return
  }
  if (vEnumGenericArity(c, ut) == 0) {
    return // a plain enum's variant is already concrete
  }
  let vn = getNode(c.tree, mk[1])
  let vname = c.source[vn.span.start:vn.span.end]
  if (vIndexOfName(vEnumVariantNames(c, ut), vname) < 0) {
    return // not a real variant — E0070's concern, elsewhere
  }
  if (len(variantPayloadTypes(c, ut, vname)) != 0) {
    return // a payload variant is a constructor call, which infers from its args
  }
  reportNoHint(c.diags, ecCannotInfer, vSpan(c, mk[1]),
    "cannot infer type arguments for '${baseName}'; annotate the target type")
}

// ---- E0070 / E0071: enum match arms (§13.8) --------------------------------

// The declared variant names of an enum, in declaration order. Variant nodes and
// their names live in the DECLARING module's tree, reached via typeOwner.
fn vEnumVariantNames(c: Checker, enumTy: int): []string {
  let out = []string(0)
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return out
  }
  for v of enumVariantNodes(oc, decl) {
    let vn = getNode(oc.tree, kidsOf(oc.tree, v)[0])
    out = append(out, oc.source[vn.span.start:vn.span.end])
  }
  return out
}

fn vIndexOfName(names: []string, name: string): int {
  let i = 0
  while (i < len(names)) {
    if (names[i] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// E0041 (§13.8): in a `match` expression every arm's body must yield one common
// type — the first arm fixes it (defaulted), the rest must be assignable. Runs
// for every match: a statement match's arm bodies are `expr_stmt`/`block` nodes,
// which `checkExprType` types as invalid (0), so `result` stays 0 and vExpect is
// a no-op — only a value-yielding expression match is judged. No position
// tracking needed.
fn vMatchExpr(c: Checker, node: int) {
  let arms = kidsOf(c.tree, kidsOf(c.tree, node)[1])
  let result = 0
  let i = 0
  while (i < len(arms)) {
    let body = kidsOf(c.tree, arms[i])[1]
    let got = checkExprType(c, body)
    if (result == 0) {
      result = defaultType(c, got)
    } else {
      vExpect(c, body, got, result)
    }
    i = i + 1
  }
}

// E0100 (§13.8): first free code above E0099 (validatecall.bit's
// ecInvalidLenCapOperand). A `_` wildcard arm written anywhere but last.
// Restricting `_` to the last position keeps lowering simple: `lowerMatch`/
// `lowerMatchExpr` already lower their LAST arm unconditionally, with no
// `variantOrdinal` lookup at all (every earlier arm's tag test is the only
// thing that makes the last one reachable-by-elimination). A non-last `_`
// would otherwise reach that per-arm ordinal lookup with a name that is not a
// real variant — the spanless-lowering-crash shape this repo has hit before
// (#2106, #2238, #2571) — so this is refused here, before lowering ever runs.
const ecWildcardNotLast = 100

// E0101 (§13.8): a `_` arm that discharges no variant, because every variant
// already has its own arm. `_` is the opt-in escape from exhaustiveness
// (§13.8's central guarantee); a match that already lists every variant gains
// nothing from also writing `_`, and ACCEPTING it would quietly disable E0071
// for that match forever — the next variant added to the enum would fall into
// the redundant `_` instead of raising a diagnostic. Refusing it keeps E0071's
// protection intact for every match that does not genuinely need `_`.
const ecWildcardUnreachable = 101

// Validates a `match` over an enum: the subject is an enum at all (E0069), every
// arm names a real variant (E0070) and every variant is handled (E0071) — unless
// a `_` wildcard arm discharges the rest (E0100/E0101 police its position and
// usefulness). The subject type is required to be a confidently-known enum — an
// open type param or an un-inferred component is skipped (safety rule). Every
// non-wildcard arm pattern is a VariantPat[name, binders], so the name
// extraction is uniform. E0069 and E0071 anchor on the subject, E0070/E0100 on
// the arm pattern, E0101 on the wildcard arm, and unhandled variants are
// reported in declaration order — matching the seed's checkMatch.
//
// E0069 renders the RAW subject type, not the defaulted one: the seed judges and
// names `checkExpr`'s result directly, so `match (1)` reports 'untyped int' and
// defaulting here would print 'i64' — a DIFF rather than a MATCH. The enum test
// is unaffected either way, since no untyped type defaults to an enum.
//
// `_` is recognized ONLY as a bare pattern with no payload group: `_(a, b)`
// falls through to the ordinary "no variant '_'" (E0070) path below, since `_`
// can never be a real variant name and a discard binds nothing to discard INTO.
fn vMatch(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [subject, arm_list]
  let rawTy = checkExprType(c, k[0])
  let subjectTy = defaultType(c, rawTy)
  if (subjectTy == 0 || vMentionsInvalid(c, subjectTy, 0) || vHasTypeParam(c, subjectTy, 0)) {
    return
  }
  if (c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    // A confidently-resolved non-enum subject. The type-param and invalid cases
    // already returned above, so nothing undecided reaches here.
    reportNoHint(c.diags, ecNotAnEnum, vSpan(c, k[0]),
      "'match' requires an enum subject, found '${typeName(c.ctx, rawTy)}'")
    return
  }
  let variants = vEnumVariantNames(c, subjectTy)
  if (len(variants) == 0) {
    return
  }
  let seen = []bool(len(variants))
  let arms = kidsOf(c.tree, k[1])
  let wildcard = 0
  let i = 0
  while (i < len(arms)) {
    let arm = arms[i]
    let pat = kidsOf(c.tree, arm)[0]
    if (getNode(c.tree, pat).tag != Tag.VariantPat) {
      i = i + 1
      continue
    }
    let vp = kidsOf(c.tree, pat) // [name, binders_or_none]
    let nameNode = getNode(c.tree, vp[0])
    let vname = c.source[nameNode.span.start:nameNode.span.end]
    if (vname == "_" && vp[1] == 0) {
      if (i != len(arms) - 1) {
        reportNoHint(c.diags, ecWildcardNotLast, vSpan(c, pat),
          "'_' arm must be the last arm in 'match'")
      }
      wildcard = pat
      i = i + 1
      continue
    }
    let idx = vIndexOfName(variants, vname)
    if (idx < 0) {
      reportNoHint(c.diags, ecUnknownVariant, vSpan(c, pat), "no variant '${vname}' on this enum")
      i = i + 1
      continue
    }
    seen[idx] = true
    vMatchArity(c, pat, subjectTy, vname, vp[1])
    i = i + 1
  }
  let unhandled = 0
  let j = 0
  while (j < len(variants)) {
    if (!seen[j]) {
      unhandled = unhandled + 1
      if (wildcard == 0) {
        reportNoHint(c.diags, ecNonExhaustive, vSpan(c, k[0]),
          "non-exhaustive 'match': variant '${variants[j]}' is not handled")
      }
    }
    j = j + 1
  }
  if (wildcard != 0 && unhandled == 0) {
    reportNoHint(c.diags, ecWildcardUnreachable, vSpan(c, wildcard),
      "'_' arm is unreachable: every variant is already handled")
  }
}

// §13.8: "the binder count must match the variant's payload arity." Neither
// direction was enforced (#3060): `typeMatchBinders` (checkmatch.bit) binds
// `min(len(binders), len(ptypes))` pairs and silently stops, so fewer binders
// than payload fields drops the trailing ones with no diagnostic, and more
// binders than payload fields leaves the extras UNBOUND — nothing ever typed
// them, yet lowering still binds a slot for each named binder, reading past
// the payload's own fields. With a reference-typed field last, that
// out-of-bounds word could reach the collector as if it were a non-reference
// int, the same hazard [[bit-gc-nongc-refs]] documents for markRoot.
//
// `binders == 0` is a bare `V` with no parens at all (§13.8's grammar makes
// the `(...)` group optional), which is arity 0 — identical to a no-payload
// variant's empty `variantPayloadTypes`.
fn vMatchArity(c: Checker, pat: int, subjectTy: int, vname: string, binders: int) {
  let want = len(variantPayloadTypes(c, subjectTy, vname))
  let got = 0
  if (binders != 0) {
    got = len(kidsOf(c.tree, binders))
  }
  if (want != got) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, pat),
      "variant '${vname}' takes ${want} binder(s), found ${got}")
  }
}

// ---- E0049 not-callable: call target (§18.1) -------------------------------

// A predeclared builtin function name (§5.3) — callable but not a user decl.
fn vIsBuiltinFunc(name: string): bool {
  for f of predeclaredFuncs() {
    if (f == name) {
      return true
    }
  }
  return false
}

// Emits E0049 when `x()` calls a value that is not a function. Only a bare-ident
// callee is judged. Every callable SPELLING is checked before the env probe — a
// user function, a first-class function value's name, a primitive conversion, a
// type used as a constructor, or a builtin — because bit2's env is flat: a param
// named `rounds` in one function would otherwise read back over a `function
// rounds`, inventing an error. Only a name that is none of those AND binds to a
// concrete non-func value reaches the emit. Member / type-node callees (method
// calls, `Enum.Variant(..)`, `chan<T>(..)`) are left to the checker's own paths.
fn vNotCallable(c: Checker, node: int) {
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let cn = getNode(c.tree, callee)
  let name = c.source[cn.span.start:cn.span.end]
  // The resolver bound this callee to a VALUE (#1555). Every name-keyed table
  // below describes a DIFFERENT binding — the free function §17.5 says this name
  // no longer denotes — so consulting them here excuses a call the seed rejects:
  // `funcSigLookup` finds the shadowed declaration's signature and returns, and
  // the env probe would then read whatever same-named binding the flat env last
  // saw. The callee's OWN resolved type is the only admissible signature, and
  // `checkExprType` reads it per-node via `declRefType`.
  if (shadowedByValue(c, callee, name)) {
    let vt = checkExprType(c, callee)
    // Permissive wherever the type is undecided, never a guess: an unyped
    // callee is bit2's gap, not the program's.
    if (vt == 0 || vMentionsInvalid(c, vt, 0) || vHasTypeParam(c, vt, 0)) {
      return
    }
    if (c.ctx.types[vt].kind == TypeKind.Func) {
      return // a func-typed value IS callable
    }
    reportNoHint(c.diags, ecNotCallable, vSpan(c, callee), "value is not callable")
    return
  }
  if (funcRefAt(c, callee, name).decl != 0 || funcSigLookup(c, name) != 0) {
    return // a user function (possibly imported) or first-class function value
  }
  if (primIndexByName(name) >= 0 || userTypeLookup(c, name) != 0 || vIsBuiltinFunc(name)) {
    return // a conversion `i64(x)`, a type constructor, or a builtin
  }
  let ev = envLookup(c, name)
  if (ev == 0 || vMentionsInvalid(c, ev, 0) || vHasTypeParam(c, ev, 0)) {
    return
  }
  if (c.ctx.types[ev].kind == TypeKind.Func) {
    return // a func-typed local value is callable
  }
  reportNoHint(c.diags, ecNotCallable, vSpan(c, callee), "value is not callable")
}

// ---- E0054 not-indexable: index receiver (§16.1) ---------------------------

// Only a slice, array, map, or string can be indexed (§16.1). The KIND TEST
// runs on the defaulted type (§15.4) so an untyped string literal receiver —
// `"abc"[0]` types as untypedStringId, kind UntypedString, never Prim — is
// correctly recognized as indexable instead of falsely rejected with E0054
// (#3167, sibling of #3165's identical gap in checkSliceExpr/checkIndex). The
// CALLER still reports the original, un-defaulted type name: `1[0]` reads
// 'untyped int' just as the seed renders it, because defaulting untyped int
// to i64 doesn't change indexability (still not Slice/Array/Map/string) and
// `vIndex`/`vInstIndex` pass their own `rt`/`sub`, not this function's local.
fn vIsIndexable(c: Checker, ty: int): bool {
  let t = c.ctx.types[defaultType(c, ty)]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array || t.kind == TypeKind.Map) {
    return true
  }
  return t.kind == TypeKind.Prim && t.prim == 11
}

// Emits E0054 at the receiver when `recv[i]` indexes a non-indexable value. The
// span is the receiver (kids[0]), matching the seed's one-caret anchor. An open
// type param is skipped (permissive): a bare `T` receiver is undecidable here.
fn vIndex(c: Checker, node: int) {
  let recv = kidsOf(c.tree, node)[0]
  let rt = checkExprType(c, recv)
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  if (!vIsIndexable(c, rt)) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, recv), "'${typeName(c.ctx, rt)}' cannot be indexed")
  }
}

// `t.N` (§13.4) needs a tuple receiver and an in-range index. Mirrors the seed's
// checkTupleIndex, including its two anchors: the receiver for a non-tuple
// (E0054, sharing vIndex's wording), the index leaf for out-of-range (E0059).
// An un-inferred or type-param receiver is skipped — permissive when undecided.
fn vTupleIndex(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let rt = checkExprType(c, kids[0])
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  let t = c.ctx.types[rt]
  if (t.kind != TypeKind.Tuple) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, kids[0]),
      "'${typeName(c.ctx, rt)}' cannot be indexed")
    return
  }
  let n = getNode(c.tree, kids[1])
  let i = parseIntText(c.source[n.span.start:n.span.end])
  if (i < 0 || i >= len(t.members)) {
    reportNoHint(c.diags, ecTupleIndexOutOfRange, vSpan(c, kids[1]),
      "tuple index ${i} out of range for a ${len(t.members)}-element tuple")
  }
}

// ---- E0052 / E0053 comparison operands (§14.6) -----------------------------

// Is `op` one of the four ORDERING operators? `==`/`!=` are equality and are
// admitted on a strictly wider set of types (§14.6), so the two are asked apart.
fn vIsOrderingOp(op: int): bool {
  return op == int(Kind.Lt) || op == int(Kind.LtEq) ||
    op == int(Kind.Gt) || op == int(Kind.GtEq)
}

// Is `op` `==` or `!=`?
fn vIsEqualityOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq)
}

// §14.6 grants the ordering operators to the NUMERICS and `string`, and to
// nothing else. `bool` is deliberately absent — `false < true` answers `true`
// today, and a boolean has no order to read that answer off. `rune` is an i32
// prim, so it arrives here as a numeric and keeps its ordering.
fn vHasOrdering(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Prim) {
    let p = c.ctx.types[ty].prim
    return vPrimIsInt(p) || vPrimIsFloat(p) || p == 11
  }
  return k == TypeKind.UntypedInt || k == TypeKind.UntypedFloat ||
    k == TypeKind.UntypedRune || k == TypeKind.UntypedString
}

// §14.6: "Maps and functions are not comparable EXCEPT AGAINST `nil`." The
// reference types that carry a null representation are exactly these; a SLICE is
// not among them, because its zero value is the empty slice (§13.4) and there is
// no `nil` slice for it to be distinguished from.
//
// A type parameter is admitted because a generic body is checked once against
// its rigid `T` and never re-checked per instantiation — judging one here would
// reject code the instantiation makes legal.
fn vNilComparable(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  return k == TypeKind.Map || k == TypeKind.Func || k == TypeKind.Chan ||
    k == TypeKind.Interface || k == TypeKind.Ptr || k == TypeKind.TypeParam ||
    k == TypeKind.UntypedNil
}

// The source spelling of a comparison operator, for the diagnostic text.
fn vCompareOpText(op: int): string {
  if (op == int(Kind.EqEq)) { return "==" }
  if (op == int(Kind.BangEq)) { return "!=" }
  if (op == int(Kind.Lt)) { return "<" }
  if (op == int(Kind.LtEq)) { return "<=" }
  if (op == int(Kind.Gt)) { return ">" }
  return ">="
}

// The `x == nil` / `x != nil` half of §14.6, reached when either operand is the
// `nil` literal. Ordering against `nil` is never defined; equality is defined
// only for the reference types that have a null representation.
fn vCompareNil(c: Checker, node: int, op: int, a: int, b: int) {
  let other = a
  if (c.ctx.types[a].kind == TypeKind.UntypedNil) { other = b }
  if (vIsOrderingOp(op)) {
    reportNoHint(c.diags, ecInvalidOperand, vSpan(c, node),
      "operator '${vCompareOpText(op)}' is not defined for 'nil'")
    return
  }
  if (vNilComparable(c, other)) { return }
  if (c.ctx.types[other].kind == TypeKind.Slice) {
    report(c.diags, ecNotComparable, vSpan(c, node),
      "a slice cannot be compared to 'nil'",
      "a slice's zero value is the empty slice, so there is no 'nil' slice; test 'len(s) == 0'")
    return
  }
  reportNoHint(c.diags, ecNotComparable, vSpan(c, node),
    "'${typeName(c.ctx, other)}' cannot be compared to 'nil'")
}

// §14.6 for `==`/`!=`/`<`/`<=`/`>`/`>=`. Three rules, in this order, because each
// one presupposes the last: the operand types must AGREE, the agreed type must be
// COMPARABLE, and an ordering operator additionally needs that type to be
// ORDERED.
//
// Agreement first is what closes the crash (#2232): `s < b` over a `string` and a
// `bool` reached lowering, where `mergeTypes` picks the left operand and
// `string_cmp` is handed a `bool` to dereference — a SIGSEGV from four lines that
// `bit check` reported clean. `i < s` over an `int` and a `string` was the quiet
// half of the same hole, answering `true`.
//
// The agreement+comparability half (everything but the ordering-specific check
// below) is `vCompareOperands` (validateswitch.bit, despite the name — a switch
// case label is the same rule under an implicit `subject == label`, #2428, and
// sharing the function is what keeps the E0053/E0052 wording to one copy).
fn vCompare(c: Checker, node: int, a: int, b: int) {
  let op = getNode(c.tree, node).main
  // `&&`/`||` are logical, not relational: their rule is bool-ness (§14.5) and is
  // not ported. They share `isComparisonOp` with the six handled here.
  if (!vIsEqualityOp(op) && !vIsOrderingOp(op)) { return }
  let kids = kidsOf(c.tree, node)
  let joined = vCompareOperands(c, node, op, kids[0], kids[1], a, b)
  if (joined == 0) { return }
  if (vIsOrderingOp(op) && !vHasOrdering(c, joined)) {
    report(c.diags, ecInvalidOperand, vSpan(c, node),
      "operator '${vCompareOpText(op)}' is not defined for '${typeName(c.ctx, joined)}'",
      "only numeric and string values have an ordering")
  }
}

