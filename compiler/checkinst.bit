// Per-instantiation NOMINAL type identity (#1540).
//
// `Stack<i64>` and `Stack<string>` are two distinct types, not one. Resolving a
// `Name<...>` type node straight to its base named type — which is what this
// checker did — collapses them onto a single TypeId, and since a method's link
// symbol is literally `<name>$t<receiverTypeId>` the two instantiations then
// share one mangled body. The seed emits one substituted body per receiver
// instantiation; that difference was the whole of the remaining IR differential.
//
// The seed's shape, ported: `instantiateGeneric` -> `instantiateRecursive`
// reserves a fresh TypeId, records `(generic, args) -> id` BEFORE filling its
// members (so a self-referential `List<T>` terminates), substitutes the
// template's fields/payloads/method signatures onto it, and gives it the BASE
// display name. That last part is why `--dump-types` cannot see any of this: it
// prints type NAMES, and an instantiation's name is `Stack`, same as its
// template's.
//
// THE SAFETY RULE applies throughout: every case this cannot decide falls back
// to the base template, which is exactly the id it returned before, so no
// previously-accepted program can start failing.

// The concrete type arguments written in a `Name<A, B>` node, resolved under
// `sub`. Parallel to the node's type-argument list, in order.
fn genericInstArgs(c: Checker, node: int, sub: TypeSubst): []int {
  let out = []int(0)
  let targs = kidsOf(c.tree, kidsOf(c.tree, node)[1])
  let i = 0
  while (i < len(targs)) {
    out = append(out, typeFromNodeIn(c, targs[i], sub))
    i = i + 1
  }
  return out
}

// The ordered type-param ids of named type `name`'s own declaration, or empty
// when it is not generic (or not declared in this module).
fn declTypeParamIds(c: Checker, name: string): []int {
  let decl = c.typeDecls[name]
  if (decl == 0) {
    return []int(0)
  }
  return declGenericIds(c, kidsOf(c.tree, decl)[1])
}

// The index into `ctx.typeInsts` of `(module, name, args)`, or -1. Identity is
// the declaring module plus the base name plus the argument list — the same key
// `instantiationIndexIn` uses for generic functions.
fn typeInstIndex(ctx: TypeContext, mod: int, name: string, args: []int): int {
  let i = 0
  while (i < len(ctx.typeInsts)) {
    let t = ctx.typeInsts[i]
    if (t.module == mod && t.name == name && intListEq(t.args, args)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The `ctx.typeInsts` entry that produced TypeId `ty`, or -1 — the seed's
// `inst_by_result`. Lets a nested generic recover the `(base, args)` behind an
// instantiation it was handed.
fn typeInstOfResult(ctx: TypeContext, ty: int): int {
  let i = 0
  while (i < len(ctx.typeInsts)) {
    if (ctx.typeInsts[i].result == ty) {
      return i
    }
    i = i + 1
  }
  return -1
}

// True when `args` is `name`'s own type parameters in order. `Stack<T>` written
// INSIDE `Stack`'s own body — a self-referential field, a method's result
// annotation — names the template itself, not a fresh instantiation:
// substituting a declaration's own rigid params changes nothing. Without this
// the two are distinct ids and `return s` fails against its own declared result
// type (the seed's `isOwnParams`).
//
// Matched by NAME, not by id, and that is the whole subtlety. The parser merges
// a receiver's `<T>` into the METHOD's generic list, so the `T` in `push`'s
// `Stack<T>` result is a different TypeId from the `T` the struct declared —
// comparing ids there mints a bogus `Stack<T_push>` instantiation, and lowering
// then emits a whole extra method body against unbound type params. Two type
// params spelled the same at the same position of the same declaration are the
// same parameter, which is exactly what the seed's rigid-id rebinding encodes.
//
// But the name test alone over-matches ACROSS declarations (#1556). `Box<T>`
// written as a field of `Pair<T>` names Box with PAIR's `T`, and the two spell
// their params the same, so this reported "Box's own template" and
// `instantiateNamed` handed back the bare template with no recorded args.
// Instantiating `Pair<i64>` then had nothing to rewrite — `Pair<i64>.a` stayed
// `Box`, `p.a.v` typed as the raw param, and `p.a.v + p.b` failed E0053 on code
// the seed accepts. Renaming either param to a distinct letter made it pass,
// which is the tell. `foreignTypeDeclParam` restores the distinction the name
// test loses without reintroducing the method-receiver false negative above.
fn isOwnTypeParams(c: Checker, name: string, args: []int): bool {
  let decl = c.typeDecls[name]
  if (decl == 0) {
    return false
  }
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[1])
  if (len(tps) == 0 || len(tps) != len(args)) {
    return false
  }
  let i = 0
  while (i < len(args)) {
    if (c.ctx.types[args[i]].kind != TypeKind.TypeParam) {
      return false
    }
    let pn = getNode(c.tree, kidsOf(c.tree, tps[i])[0])
    if (c.ctx.types[args[i]].name != c.source[pn.span.start:pn.span.end]) {
      return false
    }
    // Same spelling, but registered to a DIFFERENT type declaration: this is
    // another generic's param passed through, so `name` really is being
    // instantiated here.
    if (foreignTypeDeclParam(c, name, args[i]) || foreignFuncTypeParam(c, args[i])) {
      return false
    }
    i = i + 1
  }
  return true
}

// True when `id` is a type param registered by a TYPE declaration other than
// `name`.
//
// Only TYPE declarations are scanned, and that is what keeps the method case in
// `isOwnTypeParams` working: a method's re-declared `<T>` is registered against
// a FUNC decl's generics node, so it is never "foreign" and still compares equal
// by name. A sibling struct's `T` is registered against a type decl and so is.
fn foreignTypeDeclParam(c: Checker, name: string, id: int): bool {
  for (k, v) of c.typeDecls {
    if (k == name || v == 0) {
      continue
    }
    let ids = declGenericIds(c, kidsOf(c.tree, v)[1])
    let i = 0
    while (i < len(ids)) {
      if (ids[i] == id) {
        return true
      }
      i = i + 1
    }
  }
  return false
}

// True when `id` is a type param registered by a RECEIVERLESS free function's
// own generics list, in ANY module (#2832). `isOwnTypeParams` is called as
// `isOwnTypeParams(oc, name, args)` where `oc` is `name`'s DECLARING module
// (`instantiateNamed`'s `typeOwner` resolution) — a mentioning free function can
// live in a DIFFERENT, importing module (e.g. `seq.find<T>`'s own `<T>` mentions
// `core.Option<T>`), whose `funcDecls`/`genericParamIds` are on a separate
// `Checker` entirely. `c.mods` is the full per-module `Checker` list every front
// door (`resolveProject`) hands out before checking starts, so it is safe to walk
// here regardless of which module's checker `c` is.
//
// `c.funcDecls` only ever holds receiverless `Tag.FuncDecl`/extern-fn nodes
// (`collectFuncDecl`/`collectExternFnDecl` in checkbind.bit only write it from
// their no-receiver branch), so no `kid 0` check is needed — only the tag guard,
// to skip an extern fn's node (whose kid 2 is its result type, not a generics
// list, and could coincidentally match some other decl's genNode key in
// `genericParamIds`).
//
// A free function's own `<T>` can never legitimately BE `name`'s own rigid
// parameter — that identity only ever holds for `name`'s own declaration body or
// a METHOD's receiver-merged list (`mergeGenericParams`, parsertype.bit:231), so
// unlike `foreignTypeDeclParam` above this needs no same-name narrowing: any
// match here is foreign, unconditionally.
fn foreignFuncTypeParam(c: Checker, id: int): bool {
  let mi = 0
  while (mi < len(c.mods)) {
    let mc = c.mods[mi]
    for (_, v) of mc.funcDecls {
      if (v == 0 || getNode(mc.tree, v).tag != Tag.FuncDecl) {
        continue
      }
      let ids = declGenericIds(mc, kidsOf(mc.tree, v)[2])
      let i = 0
      while (i < len(ids)) {
        if (ids[i] == id) {
          return true
        }
        i = i + 1
      }
    }
    mi = mi + 1
  }
  return false
}

// Records `name` as having method `m`, so instantiating it knows what to copy.
// Idempotent: `checkModule` runs more than once over the same tree on some
// paths, and a duplicated name would copy the same signature twice.
fn noteTypeMethod(ctx: TypeContext, ty: int, m: string) {
  if (ty == 0) {
    return
  }
  let key = "${ty}"
  let cur = []string(0)
  for (k, v) of ctx.typeMethodNames {
    if (k == key) {
      cur = v
    }
  }
  let i = 0
  while (i < len(cur)) {
    if (cur[i] == m) {
      return
    }
    i = i + 1
  }
  ctx.typeMethodNames[key] = append(cur, m)
}

// The method names recorded for type `ty`, in registration order.
fn typeMethodNamesOf(ctx: TypeContext, ty: int): []string {
  let key = "${ty}"
  for (k, v) of ctx.typeMethodNames {
    if (k == key) {
      return v
    }
  }
  return []string(0)
}

// Copies the template's members onto instantiation `inst`, substituting `env`
// into each. Members are walked off the DECL node so they land in source order
// (the maps they live in have none), and their template types are read back
// from `structFields` / `variantPayloads` rather than re-resolved from the type
// node: re-resolving would intern composites in a different order than the
// seed's type-level `subst`.
fn fillInstMembers(c: Checker, base: int, inst: int, decl: int, env: TypeEnv) {
  let dn = getNode(c.tree, decl)
  if (dn.tag == Tag.StructDecl) {
    let fields = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
    let fi = 0
    while (fi < len(fields)) {
      let fld = fields[fi]
      if (getNode(c.tree, fld).tag == Tag.Export) {
        fld = kidsOf(c.tree, fld)[0]
      }
      let fnn = getNode(c.tree, kidsOf(c.tree, fld)[0])
      let fname = c.source[fnn.span.start:fnn.span.end]
      let ft = structFieldLookup(c, "${base}.${fname}")
      c.ctx.structFields["${inst}.${fname}"] = substType(c, ft, env, 0)
      fi = fi + 1
    }
  } else if (dn.tag == Tag.EnumDecl) {
    fillInstVariants(c, base, inst, decl, env)
  }
}

// Substitutes the template's variant payload types onto instantiation `inst`
// (#1560). This is the whole point of the ticket: after this, `Opt<i64>` and
// `Opt<string>` answer i64 and string for `Some`'s payload straight off the
// type table, so a match site reads a concrete binder type instead of
// re-deriving the enum's type arguments from the scrutinee's syntax.
//
// A payload-less variant records nothing, matching `resolveEnumPayloads`: the
// reader treats a missing key and an empty payload alike, so a variant that
// never had a payload needs no entry to stay correct.
fn fillInstVariants(c: Checker, base: int, inst: int, decl: int, env: TypeEnv) {
  let vs = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  let i = 0
  while (i < len(vs)) {
    let vn = getNode(c.tree, kidsOf(c.tree, vs[i])[0])
    let vname = c.source[vn.span.start:vn.span.end]
    let tmpl = variantPayloadLookup(c.ctx, "${base}.${vname}")
    if (len(tmpl) != 0) {
      let out = []int(0)
      let j = 0
      while (j < len(tmpl)) {
        out = append(out, substType(c, tmpl[j], env, 0))
        j = j + 1
      }
      c.ctx.variantPayloads["${inst}.${vname}"] = out
    }
    i = i + 1
  }
}

// The recorded payload types for "<typeId>.<variant>", or empty when the
// variant carries none (or nothing has been recorded for it yet).
fn variantPayloadLookup(ctx: TypeContext, key: string): []int {
  for (k, v) of ctx.variantPayloads {
    if (k == key) {
      return v
    }
  }
  return []int(0)
}

// Copies one method's result type and signature onto instantiation `inst`,
// substituted through `env`.
fn copyInstMethod(c: Checker, base: int, inst: int, m: string, env: TypeEnv) {
  let mr = methodResultLookup(c, "${base}.${m}")
  if (mr != 0) {
    c.ctx.methodResults["${inst}.${m}"] = substType(c, mr, env, 0)
  }
  let sig = methodSigLookup(c, "${base}.${m}")
  if (sig != 0) {
    c.ctx.methodSigs["${inst}.${m}"] = substType(c, sig, env, 0)
  }
  noteTypeMethod(c.ctx, inst, m)
  // Carry `export` visibility onto the instance (#1528): a method exported on
  // the template is exported on every instantiation, and `bit doc` filters on
  // it — the seed dropped this flag through its two instance paths and an
  // exported method vanished from the docs of a generic-instance alias.
  let (ex, exOk) = c.ctx.methodExported["${base}.${m}"]
  if (exOk && ex) {
    c.ctx.methodExported["${inst}.${m}"] = true
  }
}

// Copies every method of generic type `name` onto each of its instantiations —
// the seed's `copyMethodsToInstantiations`. Runs after signatures are built,
// because a method is declared after the struct it hangs off and an
// instantiation minted from a field or an annotation predates it.
//
// The substitution env is built PER METHOD DECL, not from the struct's type
// parameters, and that is load-bearing. The parser merges a receiver's `<T>`
// into the method's own generic list, so `get`'s `T` is a DIFFERENT TypeId from
// the `T` the struct declared even though both are spelled `T`; an env keyed on
// the struct's ids substitutes nothing and the method's result stays a bare type
// param. Position is what lines the two up (#1325).
fn copyMethodsToInsts(c: Checker, name: string) {
  let base = userTypeLookup(c, name)
  if (base == 0 || len(declTypeParamIds(c, name)) == 0) {
    return
  }
  let d = 1
  while (d < len(c.tree.nodes)) {
    let n = getNode(c.tree, d)
    if (n.tag != Tag.FuncDecl || kidsOf(c.tree, d)[0] == 0) {
      d = d + 1
      continue
    }
    let kids = kidsOf(c.tree, d)
    if (typeNodeName(c, kidsOf(c.tree, kids[0])[1]) != name) {
      d = d + 1
      continue
    }
    let mids = declGenericIds(c, kids[2])
    let mnn = getNode(c.tree, kids[1])
    let mname = c.source[mnn.span.start:mnn.span.end]
    let i = 0
    while (i < len(c.ctx.typeInsts)) {
      let t = c.ctx.typeInsts[i]
      if (t.module == c.moduleId && t.name == name && len(t.args) <= len(mids)) {
        copyInstMethod(c, base, t.result, mname, bothParamIds(c, name, mids, t.args))
      }
      i = i + 1
    }
    d = d + 1
  }
}

// Copies the method sets of generics declared by ALREADY-CHECKED modules onto
// the instantiations this module minted — the cross-module half of the pass
// above (#2306).
//
// `instantiateNamed` keys an instantiation on the module that DECLARES the
// generic, deliberately, so every importer lands on the same TypeId. But the
// instance is MINTED by whichever module first writes `GBox<int>`, and
// `copyMethodsToInsts` runs once per module over `typeInsts` filtered to that
// module's own id. An importer's `GBox<int>` therefore appeared in the ledger
// long after the declaring module's copy pass had run and could never run again:
// `methodSigs["<GBox<int>>.get2"]` was never written, and `vMember` answered
// `E0057: no field or method 'get2' on this type` at the call site. A method on
// a NON-generic struct exported from the same file resolved normally, which is
// what made it look like a lookup bug rather than a pass-order one.
//
// `t.module < c.moduleId` is the whole condition, and the strict `<` is
// load-bearing in both directions. Module ids are dependency order, so a LOWER
// id means that module is fully checked — its `buildSignatures` and
// `collectMethodExports` have run, which is what `copyInstMethod` reads. A
// HIGHER id means it has not been checked yet, and its own copy pass will find
// this instance already waiting in the ledger, so copying here would be both
// premature and redundant.
//
// Called from `checkModule` after this module's `GenericInst` nodes have been
// minted and before its main pass, because that main pass is what reports E0057
// — a re-copy after the whole project (`checkResolved`) would run long after the
// diagnostic. `copyInstMethod` overwrites with the same values, so a name
// reached twice costs a walk and changes nothing.
fn copyImportedMethodsToInsts(c: Checker) {
  // Keyed "<declaring module>.<generic name>": `copyMethodsToInsts` already
  // copies onto EVERY instance of that name, so one walk per name is enough and
  // repeating it per instance is the only real cost here.
  let seen = map<string, int>{}
  let i = 0
  while (i < len(c.ctx.typeInsts)) {
    let t = c.ctx.typeInsts[i]
    if (t.module >= 0 && t.module < c.moduleId && t.module < len(c.mods)) {
      let key = "${t.module}.${t.name}"
      if (seen[key] == 0) {
        seen[key] = 1
        copyMethodsToInsts(c.mods[t.module], t.name)
      }
    }
    i = i + 1
  }
}

// An env binding `args` to BOTH the ids a method declared for its receiver's
// type params and the ids the STRUCT declared, position by position.
//
// They are not the same ids. The struct's `items: []T` was typed against the
// struct's `T`; the method's `Stack<T>` result and its `v: T` parameter were
// typed against the method's own `T`, because the parser re-declares a
// receiver's params on the method. Binding only one set leaves the other's
// mentions as bare type params — which is how `push`'s `Stack<T>` result stayed
// the template and produced a call to a symbol nothing emits. Same reasoning as
// `genericEnvOf`'s double binding (#1485); a duplicate binding is a no-op.
fn bothParamIds(c: Checker, name: string, mids: []int, args: []int): TypeEnv {
  let env = TypeEnv{ params: []int(0), args: []int(0) }
  let sids = declTypeParamIds(c, name)
  let i = 0
  while (i < len(args)) {
    if (i < len(mids) && mids[i] != 0) {
      env.params = append(env.params, mids[i])
      env.args = append(env.args, args[i])
    }
    if (i < len(sids) && sids[i] != 0) {
      env.params = append(env.params, sids[i])
      env.args = append(env.args, args[i])
    }
    i = i + 1
  }
  return env
}

// The ordered type-param ids recorded for a `<...>` generics node, or empty.
fn declGenericIds(c: Checker, genNode: int): []int {
  if (genNode == 0) {
    return []int(0)
  }
  for (k, v) of c.genericParamIds {
    if (k == genNode) {
      return v
    }
  }
  return []int(0)
}

// Mints (or reuses) the nominal type for `name<args>`.
//
// Returns the BASE template — the pre-#1540 answer — for every shape this
// cannot instantiate: an unknown or non-nominal name, an arity mismatch (which
// E0058 reports separately; the type system stays permissive), an unresolved
// argument, or the declaration's own parameters. Falling back is always safe
// because the base is precisely the id every caller used to get.
//
// An IMPORTED generic type instantiates exactly like a local one (#1573):
// `oc` resolves `base`'s DECLARING module's Checker — the same resolution
// `typeOwner`/`declModule` already do for members — so `declTypeParamIds` /
// `isOwnTypeParams` / `fillInstMembers` read that module's `typeDecls` and
// tree instead of `c`'s, which only holds names `c` itself declares.
//
// Identity is keyed on the DECLARING module, not the calling one, matching
// `instantiationIndexIn`'s generic-function convention (`fr.owner.moduleId`):
// two different importers instantiating `Option<i64>` must land on the same
// TypeId, and `lowerMethodInstances`/`copyMethodsToInsts` — which run against
// the declaring module's checker and filter `typeInsts` by `inst.module ==
// c.moduleId` — must see every instantiation regardless of which module
// triggered it.
fn instantiateNamed(c: Checker, name: string, args: []int): int {
  let base = resolveNamed(c, name)
  if (base == 0 || len(args) == 0) {
    return base
  }
  let kind = c.ctx.types[base].kind
  if (kind != TypeKind.Struct && kind != TypeKind.Enum && kind != TypeKind.Interface) {
    return base // an alias is transparent: its target already absorbed the args
  }
  let oc = typeOwner(c, base)
  let params = declTypeParamIds(oc, name)
  if (len(params) != len(args)) {
    return base
  }
  let ai = 0
  while (ai < len(args)) {
    if (args[ai] == 0) {
      return base // an argument that did not resolve: undecided, so stay put
    }
    ai = ai + 1
  }
  if (isOwnTypeParams(oc, name, args)) {
    return base // the declaration's own rigid parameters — this IS the template
  }
  let declModule = c.ctx.types[base].declModule
  let found = typeInstIndex(c.ctx, declModule, name, args)
  if (found >= 0) {
    return c.ctx.typeInsts[found].result
  }
  // Reserve before filling. A generic whose field mentions itself (`Node<T>`
  // holding a `Node<T>`) re-enters here while its members are still being
  // substituted; the ledger entry is what terminates that.
  let t = leafType(kind)
  t.name = name
  t.hasName = true
  t.declModule = declModule
  t.enumBoxed = c.ctx.types[base].enumBoxed
  let inst = addType(c.ctx, t)
  c.ctx.typeInsts = append(c.ctx.typeInsts,
    TypeInst{ module: declModule, name: name, args: args, result: inst })
  let decl = oc.typeDecls[name]
  if (decl != 0) {
    fillInstMembers(oc, base, inst, decl, TypeEnv{ params: params, args: args })
  }
  return inst
}

// The type arguments standing behind nominal type `ty`: an instantiation's
// recorded args, or a TEMPLATE's own rigid parameters. Empty when `ty` is not
// generic at all, which is the common case and the one that must cost nothing.
//
// The template case reads `ty`'s DECLARING module (#1573): `ty` may be an
// imported generic's bare template id reached through a nested substitution,
// and `declTypeParamIds` only sees `c`'s own `typeDecls`.
fn nominalArgsOf(c: Checker, ty: int): []int {
  let idx = typeInstOfResult(c.ctx, ty)
  if (idx >= 0) {
    return c.ctx.typeInsts[idx].args
  }
  if (!c.ctx.types[ty].hasName) {
    return []int(0)
  }
  return declTypeParamIds(typeOwner(c, ty), c.ctx.types[ty].name)
}

// Substitutes `env` into a named struct/enum/interface by re-instantiating it at
// substituted arguments — the seed's `reinstantiate`.
//
// `Stack<T>` inside `Stack`'s own method is the TEMPLATE, and its arguments are
// the declaration's rigid params; binding `T -> i64` therefore yields
// `Stack<i64>`, a different nominal type with its own `$t<id>`. Before this,
// substitution returned the template untouched and a chained `s.push(1).size()`
// emitted `call @size$t<template>` — a symbol no body is ever emitted for, since
// only instantiations are lowered. A dangling call, not a type-printing nit.
fn substNominal(c: Checker, ty: int, env: TypeEnv, depth: int): int {
  let args = nominalArgsOf(c, ty)
  if (len(args) == 0) {
    return ty // not generic: nominal identity is already concrete
  }
  let changed = false
  let out = []int(0)
  let i = 0
  while (i < len(args)) {
    let na = substType(c, args[i], env, depth + 1)
    if (na != args[i]) {
      changed = true
    }
    out = append(out, na)
    i = i + 1
  }
  if (!changed) {
    return ty
  }
  return instantiateNamed(c, c.ctx.types[ty].name, out)
}

// Two nominal types that instantiate the same declaration — and a template
// against any of its own instantiations — are interchangeable for diagnostic
// purposes.
//
// This is not a claim that `Stack<i64>` and `Stack<string>` are the same type.
// It is THE SAFETY RULE made explicit: before per-instantiation identity every
// one of these was literally the same TypeId, so treating them as assignable
// preserves exactly the set of programs this checker accepted. Narrowing it to
// compare arguments is a real diagnostic (the seed's `sameInstantiation` path)
// and belongs with the rest of the generic-inference tail, not here — landing
// it inside a renumbering change would make any new diagnostic indistinguishable
// from a regression in the differential.
fn sameNominalDecl(ctx: TypeContext, a: int, b: int): bool {
  let ta = ctx.types[a]
  let tb = ctx.types[b]
  if (!ta.hasName || !tb.hasName) {
    return false
  }
  if (ta.kind != tb.kind) {
    return false
  }
  return ta.name == tb.name && ta.declModule == tb.declModule
}

// The template `ty` instantiates, or `ty` itself when it is not an
// instantiation. Lowering mangles a method by its RECEIVER's id, so it needs to
// get from an instantiation back to the declaration that owns the body.
fn nominalTemplateOf(c: Checker, ty: int): int {
  let idx = typeInstOfResult(c.ctx, ty)
  if (idx < 0) {
    return ty
  }
  return userTypeLookup(c, c.ctx.typeInsts[idx].name)
}
