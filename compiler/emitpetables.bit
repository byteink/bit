fn emPeStackMaps(gc: ByteBuf, fr: EmPeFuncsResult) {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  // ---- GC stack-map entries (runtime/ABI.md §4) -> .bit_gc -----------------
  // Per-MEMBER, not per-program: matches emitElfObject/emitMachoObject exactly
  // — one section, one LOCAL symbol per function, so the linker can drop an
  // entry whose function it dropped.
  assert(len(fr.emittedNames) == len(fr.stackmaps))
  let smCodeRelocs = writeStackMaps(gc, fr.stackmaps)
  let smi = 0
  while (smi < len(smCodeRelocs)) {
    let smOff = smCodeRelocs[smi]
    let smEnd = len(gc.bytes)
    if (smi + 1 < len(smCodeRelocs)) {
      smEnd = smCodeRelocs[smi + 1]
    }
    let smName = "__bitsm_${smi}"
    symbols = append(
      symbols,
      PeSymbol{
        name = smName, hasSection = true,
        section = PeSectionKind.GcMeta, offset = smOff, size = smEnd - smOff,
        binding = PeBinding.Local, kind = PeSymKind.Object,
      },
    )
    defined[smName] = true
    // Offsets are already section-relative, and an entry starts with its
    // codeAddr field — so the entry offset IS the reloc offset.
    relocs = append(
      relocs,
      PeRelocation{
        section = PeSectionKind.GcMeta,
        offset = smOff, symbol = fr.emittedNames[smi], kind = PeRelocKind.Addr64,
      },
    )
    smi = smi + 1
  }

  fr.symbols = symbols
  fr.relocs = relocs
}

fn emPeUndefined(fr: EmPeFuncsResult) {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  // ---- undefined externals (the runtime's bit_rt_* symbols, and §11.7
  // `extern function` declarations that will resolve to a kernel32 import at
  // link time) --------------------------------------------------------------
  let externs = map<string, bool>{}
  let ri = 0
  while (ri < len(relocs)) {
    let sym = relocs[ri].symbol
    let (_, isDef) = defined[sym]
    let (_, isExt) = externs[sym]
    if (!isDef && !isExt) {
      externs[sym] = true
      symbols = append(
        symbols,
        PeSymbol{
          name = sym, hasSection = false,
          section = PeSectionKind.Text, offset = 0, size = 0,
          binding = PeBinding.Global, kind = PeSymKind.Notype,
        },
      )
    }
    ri = ri + 1
  }

  fr.symbols = symbols
  fr.relocs = relocs
}
