// compiler/desugarjsx.bit — JSX desugaring, step one of #3944 (epic #3942,
// depends on #3943's parser). #3943's own header says it plainly: "these
// nodes are produced and nothing downstream consumes them yet: no typing, no
// desugaring, no formatting." This is the desugaring half.
//
// SCOPE OF THIS STEP: a self-closing LOWERCASE element with any number of
// attributes (string, `{expr}`, or bare/boolean) and NO children —
// `<div id="a" open />` desugars to `elem("id_word_removed...`. A
// non-self-closing element, a fragment, and an uppercase (component) tag are
// left as raw `jsx_elem`/`jsx_frag` nodes for now: children recursion, the
// named-argument component call, and the fragment spelling are each their own
// follow-up (children need a text-literal synthesis this step deliberately
// does not build; components need `Tag.NamedArg` wiring). Left alone, an
// unsupported shape keeps TODAY's resolver behaviour (walking into the tag's
// own `Ident` leaf) — not a regression, and not silently wrong: nothing here
// claims to have desugared what it did not touch.
//
// THE REWRITE IS IN PLACE. `t.nodes[idx]` is reassigned wholesale rather than
// building a new node and re-pointing every parent, mirroring the arena's own
// append-only shape: every JSX descendant was parsed (and so indexed) before
// its ancestor, so a single forward scan over `tree.nodes` visits attribute
// values before the element that owns them, and by the time it reaches an
// outer element any inner one has already become its Call.
//
// NAMES COME FROM THE SOURCE TEXT, NOT A REGISTRY (the ticket's own rule): the
// callee is a literal `elem`/`attr` identifier, which the ORDINARY resolver
// then looks up by ordinary scope rules — an unbound `elem` is the ordinary
// E0040, not a JSX-specific diagnostic. `elem`/`attr` and every tag/attribute
// name (quoted into a string literal) are words this module's source does not
// contain until `appendSynthText` puts them there, exactly as
// classfieldattr.bit's `validateFields` synthesis does for its own words.

// A lowercase-letter first byte marks an HTML-element tag; anything else
// (including a non-letter) is left to the component-call step.
fn jsxIsLowerTag(name: string): bool {
  return len(name) != 0 && name[0] >= 'a' && name[0] <= 'z'
}

// A tag/attribute identifier, quoted the way its `string_lit` must be spelled
// in the source. Safe with no escaping: the lexer only ever hands
// `parseJsxAttr`/`expectIdent` a `[A-Za-z_][A-Za-z0-9_]*` token, which
// contains neither `"` nor `\`.
fn jsxQuoteWord(name: string): string {
  return "\"" + name + "\""
}

// Self-closing (no children kid) and lowercase: the only shape this step
// desugars. A poisoned name (parser already reported E0021/E0023) is left
// alone rather than desugared against empty text.
fn jsxElemDesugarable(tree: Tree, source: string, node: int): bool {
  let k = kidsOf(tree, node)
  if (k[2] != 0 || k[0] == 0) {
    return false
  }
  return jsxIsLowerTag(identText(tree, source, k[0]))
}

// Every word this module's desugarable elements need appended to the source:
// `elem`/`attr` once each (only when at least one element needs them), `true`
// for a bare attribute's default value (SPEC §12.12), and one quoted word per
// distinct tag/attribute name. `appendSynthText` dedupes exact repeats, so
// this collects every occurrence with no set of its own.
fn jsxSynthWords(tree: Tree, source: string): []string {
  let out = []string(0)
  let needTrue = false
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.JsxElem && jsxElemDesugarable(tree, source, i)) {
      let k = kidsOf(tree, i)
      out = append(out, jsxQuoteWord(identText(tree, source, k[0])))
      for a of kidsOf(tree, k[1]) {
        let ak = kidsOf(tree, a)
        out = append(out, jsxQuoteWord(identText(tree, source, ak[0])))
        if (ak[1] == 0) {
          needTrue = true
        }
      }
    }
    i = i + 1
  }
  if (len(out) == 0) {
    return out
  }
  out = append(out, "elem")
  out = append(out, "attr")
  if (needTrue) {
    out = append(out, "true")
  }
  return out
}

// The file id every synthesized span in this module is stamped with — the
// first desugarable element's own file, mirroring synthtext.bit's
// `synthFileId`. Spans are module-global here just as they are for that
// pass, so the caller owes the identical `remapDiags` step.
fn jsxSynthFileId(tree: Tree, source: string): int {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.JsxElem && jsxElemDesugarable(tree, source, i)) {
      return getNode(tree, i).span.file
    }
    i = i + 1
  }
  return 0
}

// `Tag.Arg` around one already-built expression, the shape a real call's
// argument list holds (parser.bit's `parseArgItem`).
fn jsxArgWrap(tree: Tree, span: Span, expr: int): int {
  return addNode(tree, Tag.Arg, span, 0, [expr])
}

// `attr("name", value)` for one `jsx_attr` node — a bare attribute's value is
// the literal `true` (SPEC §12.12), and a `{expr}` value unwraps to the
// expression itself; a string-literal value is already a real `Tag.StringLit`
// the parser built and needs no rewriting at all.
fn jsxAttrCall(tree: Tree, source: string, st: SynthText, attrNode: int): int {
  let k = kidsOf(tree, attrNode)
  let sp = getNode(tree, attrNode).span
  let nameLit = markSynth(
    tree,
    addLeaf(tree, Tag.StringLit, synthSpan(st, jsxQuoteWord(identText(tree, source, k[0])))),
  )
  let value = k[1]
  if (value == 0) {
    value = markSynth(tree, addLeaf(tree, Tag.BoolLit, synthSpan(st, "true")))
  } else if (getNode(tree, value).tag == Tag.JsxExpr) {
    value = kidsOf(tree, value)[0]
  }
  let callee = synthIdent(tree, st, "attr")
  let argsNode = addNode(
    tree,
    Tag.Args,
    sp,
    0,
    [jsxArgWrap(tree, sp, nameLit), jsxArgWrap(tree, sp, value)],
  )
  return markSynth(tree, addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode]))
}

// Rewrites one desugarable `jsx_elem` node IN PLACE into `elem("name", attr(...), ...)`.
fn rewriteJsxElem(tree: Tree, source: string, st: SynthText, node: int) {
  let sp = getNode(tree, node).span
  let k = kidsOf(tree, node)
  let nameLit = markSynth(
    tree,
    addLeaf(tree, Tag.StringLit, synthSpan(st, jsxQuoteWord(identText(tree, source, k[0])))),
  )
  let argVals = [nameLit]
  for a of kidsOf(tree, k[1]) {
    argVals = append(argVals, jsxAttrCall(tree, source, st, a))
  }
  let argNodes = []int(0)
  for v of argVals {
    argNodes = append(argNodes, jsxArgWrap(tree, sp, v))
  }
  let callee = synthIdent(tree, st, "elem")
  let argsNode = addNode(tree, Tag.Args, sp, 0, argNodes)
  let call = markSynth(tree, addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode]))
  tree.nodes[node] = tree.nodes[call]
}

// Entry point, called from `resolveProject` (checkproject.bit) right after
// `injectSynthMembers` — same reason: every front end reaches the checker
// through there, so this is the one place the rewrite has to happen before
// resolve sees the tree. Each module either contains no desugarable JSX (the
// common case: `words` is empty, nothing is touched) or gets one
// `appendSynthText` call and one rewrite pass.
fn desugarJsxProject(p: Project) {
  let i = 0
  while (i < len(p.mods)) {
    desugarJsxInModule(p.mods[i])
    i = i + 1
  }
}

fn desugarJsxInModule(m: SrcModule) {
  let words = jsxSynthWords(m.tree, m.source)
  if (len(words) == 0) {
    return
  }
  let st = appendSynthText(m, jsxSynthFileId(m.tree, m.source), words)
  let i = 1
  while (i < len(m.tree.nodes)) {
    if (getNode(m.tree, i).tag == Tag.JsxElem && jsxElemDesugarable(m.tree, m.source, i)) {
      rewriteJsxElem(m.tree, m.source, st, i)
    }
    i = i + 1
  }
}
