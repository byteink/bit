// compiler/desugarjsx.bit — JSX desugaring (epic #3942, #3944), the whole of
// SPEC §12.12's "Desugaring" rule. #3943's own header says it plainly: "these
// nodes are produced and nothing downstream consumes them yet: no typing, no
// desugaring, no formatting." This is the desugaring.
//
// THE RULE, taken whole from the spec: a LOWERCASE tag desugars to a call to
// `elem`, its tag name as a quoted string, one call to `attr` per attribute,
// and the element's children as further positional arguments. An UPPERCASE
// tag is a component call — an ordinary call to the function the tag names,
// each attribute a named argument (SPEC §12.11), and (only when there is at
// least one) the children collected into a trailing `children` argument. A
// fragment desugars like a lowercase element but calls `frag` with no
// tag-name argument. A text child becomes a call to `text` with its content
// as a quoted string literal (#5154: a bare literal cannot satisfy a
// non-`string` child type, and the desugaring has no target type to check
// against); a `{expr}` child unwraps to the expression; an element/fragment
// child is already a `Call` by the time its parent is reached (below).
//
// THE REWRITE IS IN PLACE. `t.nodes[idx]` is reassigned wholesale rather than
// building a new node and re-pointing every parent, mirroring the arena's own
// append-only shape: every JSX descendant was parsed (and so indexed) before
// its ancestor, so a single forward scan over `tree.nodes` visits a child
// element/fragment/text/expr before the parent that owns it, and by the time
// the scan reaches an outer element any inner one has already become its
// `Call` — a child value is simply the child's own (by-then-rewritten) index,
// no re-visiting needed.
//
// NAMES COME FROM THE SOURCE TEXT, NOT A REGISTRY (the ticket's own rule):
// `elem`/`attr`/`frag`/`text`/`children` are literal identifiers the
// ORDINARY resolver looks up by ordinary scope rules — an unbound one is the
// ordinary E0040, not a JSX-specific diagnostic. They and every lowercase
// tag/attribute name (quoted into a string literal) or text child (escaped
// into one) are words this module's source does not contain until
// `appendSynthText` puts them there, exactly as classfieldattr.bit's
// `validateFields` synthesis does for its own words. An UPPERCASE element's
// attribute names need no synthesis at all: `parseJsxAttr` already built a
// real `Tag.Ident` leaf for each one, reused directly as the named
// argument's name — `namedargs.bit` matches it by TEXT and `resolvebody.bit`
// never resolves a `Tag.NamedArg`'s name as a variable, so the existing node
// is exactly the right shape.

// A spread attribute on a component (uppercase) element (#5172): Bit's named
// arguments are matched by a literal name at the call site (`namedargs.bit`),
// and there is no runtime mechanism to spread a value into a set of names, so
// `<Foo {...props} />` cannot desugar the way `<div {...props} />` does.
// Reported rather than left to `jsxNamedArg`, which would index a 2-kid shape
// on a 1-kid `JsxSpreadAttr` node and panic.
const ecJsxSpreadOnComponent = 25

// A lowercase-letter first byte marks an HTML-element tag; anything else
// (including a non-letter) is a component call.
fn jsxIsLowerTag(name: string): bool {
  return len(name) != 0 && name[0] >= 'a' && name[0] <= 'z'
}

// A tag/attribute identifier, quoted the way its `string_lit` must be spelled
// in the source. Safe with no escaping: the lexer only ever hands
// `parseJsxAttr`/`expectIdent` a `[A-Za-z_][A-Za-z0-9_]*` token, which
// contains neither `"` nor `\`.
fn jsxQuoteWord(name: string): string {
  return "\"" + name + "\""
}

// A JSX text child's raw bytes, quoted as an interpreted string literal (SPEC
// §5.7). Only `\` and `"` need escaping: this span is never re-lexed (the
// text is appended straight past parsing and read back only by
// `decodeStringContent`/`decodeEscapes`, lower.bit), which does not treat a
// literal newline as unterminating a string and does not touch `$` unless it
// follows the backslash escaped away here — so every other byte, including an
// embedded newline, survives unchanged.
fn jsxQuoteText(text: string): string {
  let out = []u8(0)
  out = append(out, u8('"'))
  let i = 0
  while (i < len(text)) {
    let c = text[i]
    if (c == '\\' || c == '"') {
      out = append(out, u8('\\'))
    }
    out = append(out, c)
    i = i + 1
  }
  out = append(out, u8('"'))
  return string(out)
}

// A `jsx_elem`'s name is not poisoned (the parser already reported
// E0021/E0023 on it) — the only reason an element is left alone, at any
// arity of attributes or children. A `jsx_frag` has no name to poison and is
// always desugarable.
fn jsxIsDesugarable(tree: Tree, node: int): bool {
  let tag = getNode(tree, node).tag
  if (tag == Tag.JsxFrag) {
    return true
  }
  return tag == Tag.JsxElem && kidsOf(tree, node)[0] != 0
}

// Every JSX text child of one `jsx_children` node (0 for a self-closing or
// explicitly empty element/fragment), quoted and ready for `appendSynthText`.
fn jsxChildTextWords(tree: Tree, source: string, childrenNode: int): []string {
  let out = []string(0)
  if (childrenNode == 0) {
    return out
  }
  for c of kidsOf(tree, childrenNode) {
    if (getNode(tree, c).tag == Tag.JsxText) {
      out = append(out, jsxQuoteText(identText(tree, source, c)))
    }
  }
  return out
}

// The number of children a `jsx_children` node holds (0 when absent) — an
// uppercase element needs the `children` word only when this is nonzero.
fn jsxChildCount(tree: Tree, childrenNode: int): int {
  if (childrenNode == 0) {
    return 0
  }
  return len(kidsOf(tree, childrenNode))
}

// The words ONE desugarable `jsx_elem` needs: for a lowercase element, its
// quoted tag name (and every synth pass needs `elem`/`attr` at all once one
// exists); either case's quoted text children (and, once any exist, `text`
// — #5154, see `jsxChildValue`); whether this element has a bare attribute
// (`true`) or, for an uppercase one, any child at all (`children`). A nested
// element/fragment's own requirements are collected on ITS OWN turn by the
// caller's scan — never recursed into here.
class JsxWordInfo {
  words: []string,
  needTrue: bool,
  needElemAttr: bool,
  needElemSpread: bool,
  needChildren: bool,
  needText: bool,
}

// One attribute's own contribution to `info`: a spread attribute (#5172) has
// no name to quote and no value slot, so it contributes nothing here at
// all — its own expression feeds the fold `rewriteJsxLowerElemSpread`
// builds instead, and `needElemSpread` (jsxElemSynthInfo) already requested
// that fold's helper words once for the whole element. Split out of
// `jsxElemSynthInfo`'s loop to keep that function's own complexity where it
// was before this ticket (spec/LINT.md's `max-complexity`).
fn jsxCollectAttrWord(tree: Tree, source: string, info: JsxWordInfo, lower: bool, a: int) {
  if (getNode(tree, a).tag == Tag.JsxSpreadAttr) {
    return
  }
  let ak = kidsOf(tree, a)
  if (lower) {
    info.words = append(info.words, jsxQuoteWord(identText(tree, source, ak[0])))
  }
  if (ak[1] == 0) {
    info.needTrue = true
  }
}

fn jsxElemSynthInfo(tree: Tree, source: string, node: int): JsxWordInfo {
  let k = kidsOf(tree, node)
  let lower = jsxIsLowerTag(identText(tree, source, k[0]))
  let info = JsxWordInfo{
    words: []string(0),
    needTrue: false,
    needElemAttr: lower,
    needElemSpread: lower && jsxHasSpreadAttr(tree, k[1]),
    needChildren: false,
    needText: false,
  }
  if (lower) {
    info.words = append(info.words, jsxQuoteWord(identText(tree, source, k[0])))
  }
  for a of kidsOf(tree, k[1]) {
    jsxCollectAttrWord(tree, source, info, lower, a)
  }
  let textWords = jsxChildTextWords(tree, source, k[2])
  for w of textWords {
    info.words = append(info.words, w)
  }
  if (len(textWords) != 0) {
    info.needText = true
  }
  if (!lower && jsxChildCount(tree, k[2]) != 0) {
    info.needChildren = true
  }
  return info
}

// The running totals `jsxSynthWords`' scan builds up, one desugarable node at
// a time, before the words that depend on a TOTAL (`elem`/`attr`, `frag`,
// `children`, `true`) are appended once each.
class JsxSynthState {
  words: []string,
  needElemAttr: bool,
  needElemSpread: bool,
  needFrag: bool,
  needChildren: bool,
  needTrue: bool,
  needText: bool,
}

fn jsxCollectFragWords(tree: Tree, source: string, st: JsxSynthState, node: int) {
  st.needFrag = true
  let textWords = jsxChildTextWords(tree, source, kidsOf(tree, node)[0])
  for w of textWords {
    st.words = append(st.words, w)
  }
  if (len(textWords) != 0) {
    st.needText = true
  }
}

fn jsxCollectElemWords(tree: Tree, source: string, st: JsxSynthState, node: int) {
  let info = jsxElemSynthInfo(tree, source, node)
  for w of info.words {
    st.words = append(st.words, w)
  }
  if (info.needTrue) {
    st.needTrue = true
  }
  if (info.needElemAttr) {
    st.needElemAttr = true
  }
  if (info.needElemSpread) {
    st.needElemSpread = true
  }
  if (info.needChildren) {
    st.needChildren = true
  }
  if (info.needText) {
    st.needText = true
  }
}

fn jsxFinalWords(st: JsxSynthState): []string {
  if (st.needElemAttr) {
    st.words = append(st.words, "elem")
    st.words = append(st.words, "attr")
  }
  // The fold `rewriteJsxLowerElemSpread` builds for a spread attribute
  // (#5172) calls `el` directly (skipping `elem`'s thin wrapper) and threads
  // its accumulator through `kidFrom`/`kid`/`kids` — four more names a module
  // with at least one spread element must have in scope.
  if (st.needElemSpread) {
    st.words = append(st.words, "el")
    st.words = append(st.words, "kidFrom")
    st.words = append(st.words, "kid")
    st.words = append(st.words, "kids")
  }
  if (st.needFrag) {
    st.words = append(st.words, "frag")
  }
  if (st.needChildren) {
    st.words = append(st.words, "children")
  }
  if (st.needTrue) {
    st.words = append(st.words, "true")
  }
  if (st.needText) {
    st.words = append(st.words, "text")
  }
  return st.words
}

// Every word this module's desugarable JSX needs appended to the source.
// `appendSynthText` dedupes exact repeats, so this collects every occurrence
// with no set of its own.
fn jsxSynthWords(tree: Tree, source: string): []string {
  let st = JsxSynthState{
    words: []string(0), needElemAttr: false, needElemSpread: false, needFrag: false,
    needChildren: false, needTrue: false, needText: false,
  }
  let i = 1
  while (i < len(tree.nodes)) {
    if (jsxIsDesugarable(tree, i)) {
      if (getNode(tree, i).tag == Tag.JsxFrag) {
        jsxCollectFragWords(tree, source, st, i)
      } else {
        jsxCollectElemWords(tree, source, st, i)
      }
    }
    i = i + 1
  }
  return jsxFinalWords(st)
}

// The file id every synthesized span in this module is stamped with — the
// first desugarable node's own file, mirroring synthtext.bit's
// `synthFileId`. Spans are module-global here just as they are for that
// pass, so the caller owes the identical `remapDiags` step.
fn jsxSynthFileId(tree: Tree, source: string): int {
  let i = 1
  while (i < len(tree.nodes)) {
    if (jsxIsDesugarable(tree, i)) {
      return getNode(tree, i).span.file
    }
    i = i + 1
  }
  return 0
}

// `Tag.Arg` around one already-built expression, the shape a real call's
// argument list holds (parser.bit's `parseArgItem`).
fn jsxArgWrap(tree: Tree, span: Span, expr: int): int {
  return addNode(tree, Tag.Arg, span, 0, [expr])
}

// The VALUE half of one `jsx_attr` (SPEC §12.12): a bare attribute defaults to
// the literal `true`, a `{expr}` value unwraps to the expression itself, and a
// string-literal value is already a real `Tag.StringLit` the parser built and
// needs no rewriting — shared by the lowercase `attr(...)` call and the
// uppercase named argument, since the rule does not depend on case.
//
// NEVER `markSynth` here or anywhere else in this file. That mark is
// `vCallArgExpect`'s (validatecall.bit) narrow #4583 exemption for a value
// classfieldattrbuild.bit already validated once and does not want reported
// twice — it is not a generic "the checker built this" flag, and setting it
// on a JSX-desugared argument makes `vCallArgExpect` skip the ONLY type check
// that argument will ever get (nothing validates a JSX attribute value before
// it becomes a call argument, unlike a class field). A bare-attribute `true`
// passed to a `string`-typed `attr` parameter must be an ordinary type
// mismatch, not a silently accepted argument that then reads a bool's bit
// pattern as a string header at runtime.
fn jsxAttrValue(tree: Tree, st: SynthText, attrNode: int): int {
  let value = kidsOf(tree, attrNode)[1]
  if (value == 0) {
    return addLeaf(tree, Tag.BoolLit, synthSpan(st, "true"))
  }
  if (getNode(tree, value).tag == Tag.JsxExpr) {
    return kidsOf(tree, value)[0]
  }
  return value
}

// `attr("name", value)` for one `jsx_attr` node, on a lowercase element.
fn jsxAttrCall(tree: Tree, source: string, st: SynthText, attrNode: int): int {
  let k = kidsOf(tree, attrNode)
  let sp = getNode(tree, attrNode).span
  let nameLit = addLeaf(
    tree,
    Tag.StringLit,
    synthSpan(st, jsxQuoteWord(identText(tree, source, k[0]))),
  )
  let value = jsxAttrValue(tree, st, attrNode)
  let callee = synthIdent(tree, st, "attr")
  let argsNode = addNode(
    tree, Tag.Args, sp, 0,
    [jsxArgWrap(tree, sp, nameLit), jsxArgWrap(tree, sp, value)],
  )
  return addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode])
}

// `name = value` for one `jsx_attr` node, on an uppercase (component)
// element. The attribute's own `Ident` leaf is reused directly as the named
// argument's name — see the file header for why nothing needs synthesizing
// here — spanned at the ATTRIBUTE itself, matching `jsxAttrCall`, so an
// unknown-name or wrong-type diagnostic points at the attribute the author
// wrote, not at the whole element.
fn jsxNamedArg(tree: Tree, st: SynthText, attrNode: int): int {
  let k = kidsOf(tree, attrNode)
  let sp = getNode(tree, attrNode).span
  return addNode(tree, Tag.NamedArg, sp, 0, [k[0], jsxAttrValue(tree, st, attrNode)])
}

// `text("...")` for one JSX text child (#5154). A bare quoted string literal
// cannot be the argument here: `elem`/`frag`/a component's `children` are
// typed by the LIBRARY, and Bit has no implicit conversion from an untyped
// string constant into anything but `string` itself (SPEC §15.4) — a target
// whose child type is a class or enum (`pkg/web`'s `Node`) would reject a
// bare literal with a type error, not resolve it. Routing every text child
// through the callee's own `text` — already the name `pkg/web/escape.bit`
// uses for exactly this ("a view fragment... `Text(s)` is already-escaped
// element text (built by `text()`)") — makes the argument's type whatever
// `text` returns, so the desugaring stays library-agnostic: a `string`-typed
// stand-in (`_tests_/cases/jsx_desugar_page.bit`) returns its argument
// unchanged and sees no behavior change.
fn jsxTextCall(tree: Tree, source: string, st: SynthText, child: int): int {
  let sp = getNode(tree, child).span
  let strLit = addLeaf(
    tree,
    Tag.StringLit,
    synthSpan(st, jsxQuoteText(identText(tree, source, child))),
  )
  let callee = synthIdent(tree, st, "text")
  let argsNode = addNode(tree, Tag.Args, sp, 0, [jsxArgWrap(tree, sp, strLit)])
  return addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode])
}

// One JSX child's VALUE node: raw text becomes a `text(...)` call (above), a
// `{expr}` child unwraps to the expression, and an element/fragment child has
// ALREADY been rewritten to a `Call` in place by this same forward pass (see
// the file header).
fn jsxChildValue(tree: Tree, source: string, st: SynthText, child: int): int {
  let tag = getNode(tree, child).tag
  if (tag == Tag.JsxText) {
    return jsxTextCall(tree, source, st, child)
  }
  if (tag == Tag.JsxExpr) {
    return kidsOf(tree, child)[0]
  }
  return child
}

// Every child VALUE of a `jsx_children` node (0 when the element/fragment is
// self-closing or explicitly empty).
fn jsxChildValues(tree: Tree, source: string, st: SynthText, childrenNode: int): []int {
  let out = []int(0)
  if (childrenNode == 0) {
    return out
  }
  for c of kidsOf(tree, childrenNode) {
    out = append(out, jsxChildValue(tree, source, st, c))
  }
  return out
}

// Whether a lowercase element's attribute list has a spread (#5172), which
// forces the FOLD desugaring (`rewriteJsxLowerElemSpread`) instead of the
// flat `elem(...)` call every other element still takes.
fn jsxHasSpreadAttr(tree: Tree, attrsNode: int): bool {
  for a of kidsOf(tree, attrsNode) {
    if (getNode(tree, a).tag == Tag.JsxSpreadAttr) {
      return true
    }
  }
  return false
}

// The three values every step of the spread fold (`rewriteJsxLowerElemSpread`
// below) needs and none of them changes mid-fold — grouped into one class so
// `jsxFoldStep` and its own helpers stay at 5 parameters or fewer (spec/
// LINT.md's `max-params`), not because `tree`/`st`/`sp` are related any other
// way than always traveling together here.
class JsxFoldCtx {
  tree: Tree,
  st: SynthText,
  sp: Span,
}

// One synthesized call `f(args...)`, the shape every `pkg/web` helper call in
// this file takes.
fn jsxHelperCall(fc: JsxFoldCtx, name: string, args: []int): int {
  let callee = synthIdent(fc.tree, fc.st, name)
  let argNodes = []int(0)
  for a of args {
    argNodes = append(argNodes, jsxArgWrap(fc.tree, fc.sp, a))
  }
  let argsNode = addNode(fc.tree, Tag.Args, fc.sp, 0, argNodes)
  return addNode(fc.tree, Tag.Call, fc.sp, 0, [callee, 0, argsNode])
}

// One step of the fold `rewriteJsxLowerElemSpread` threads through every
// attribute and child (#5172): `acc` is `0` before the first step, else the
// running `[]Node` a prior step built. An ordinary item pushes with
// `pkg/web`'s `kidFrom`/`kid`; a spread's own expression is ALREADY a
// `[]Node` (`elem`/`attr` share one flat list, SPEC §12.12), so the first
// step of a spread needs no call at all and a later one merges with `kids`.
// Three small named steps rather than one, matching the codebase's own
// per-purpose-function style (`jsxAttrCall`, `jsxNamedArg`, ...) instead of a
// single function branching on both `acc == 0` and `isSpread`.
fn jsxFoldFirst(fc: JsxFoldCtx, item: int, isSpread: bool): int {
  if (isSpread) {
    return item
  }
  return jsxHelperCall(fc, "kidFrom", [item])
}

fn jsxFoldNext(fc: JsxFoldCtx, acc: int, item: int, isSpread: bool): int {
  if (isSpread) {
    return jsxHelperCall(fc, "kids", [acc, item])
  }
  return jsxHelperCall(fc, "kid", [acc, item])
}

fn jsxFoldStep(fc: JsxFoldCtx, acc: int, item: int, isSpread: bool): int {
  if (acc == 0) {
    return jsxFoldFirst(fc, item, isSpread)
  }
  return jsxFoldNext(fc, acc, item, isSpread)
}

// Folds every attribute kid (spread or ordinary) into `acc`, one step per
// attribute, in source order.
fn jsxFoldAttrs(fc: JsxFoldCtx, source: string, attrsNode: int, acc0: int): int {
  let acc = acc0
  for a of kidsOf(fc.tree, attrsNode) {
    if (getNode(fc.tree, a).tag == Tag.JsxSpreadAttr) {
      acc = jsxFoldStep(fc, acc, kidsOf(fc.tree, a)[0], true)
    } else {
      acc = jsxFoldStep(fc, acc, jsxAttrCall(fc.tree, source, fc.st, a), false)
    }
  }
  return acc
}

// Rewrites one desugarable LOWERCASE `jsx_elem` with at least one spread
// attribute IN PLACE into `el("name", ...acc)` (SPEC §12.12, #5172), `acc`
// built by `jsxFoldAttrs`/`jsxFoldStep` from every attribute and child IN
// SOURCE ORDER. Necessary because Bit's call syntax allows a `...` spread
// only as the SOLE argument into a variadic parameter (SPEC §12.4): a spread
// attribute can never sit alongside an ordinary `attr(...)` call or a child
// in `elem`'s own `...kids`, the way `rewriteJsxLowerElem` builds it for
// every element with no spread at all.
fn rewriteJsxLowerElemSpread(tree: Tree, source: string, st: SynthText, node: int) {
  let sp = getNode(tree, node).span
  let k = kidsOf(tree, node)
  let fc = JsxFoldCtx{ tree: tree, st: st, sp: sp }
  let nameLit = addLeaf(
    tree, Tag.StringLit, synthSpan(st, jsxQuoteWord(identText(tree, source, k[0]))),
  )
  let acc = jsxFoldAttrs(fc, source, k[1], 0)
  for v of jsxChildValues(tree, source, st, k[2]) {
    acc = jsxFoldStep(fc, acc, v, false)
  }
  let callee = synthIdent(tree, st, "el")
  let argsNode = addNode(
    tree, Tag.Args, sp, 0, [
      jsxArgWrap(tree, sp, nameLit),
      addNode(tree, Tag.ArgSpread, sp, 0, [acc]),
    ],
  )
  let call = addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode])
  tree.nodes[node] = tree.nodes[call]
}

// Rewrites one desugarable LOWERCASE `jsx_elem` IN PLACE into
// `elem("name", attr(...), ..., child, ...)` (SPEC §12.12). A spread
// attribute (#5172) is handled entirely by `rewriteJsxLowerElemSpread`
// instead — this flat form is exactly what the seed already produced,
// unchanged, for every element `jsxHasSpreadAttr` says has none.
fn rewriteJsxLowerElem(tree: Tree, source: string, st: SynthText, node: int) {
  let sp = getNode(tree, node).span
  let k = kidsOf(tree, node)
  if (jsxHasSpreadAttr(tree, k[1])) {
    rewriteJsxLowerElemSpread(tree, source, st, node)
    return
  }
  let nameLit = addLeaf(
    tree,
    Tag.StringLit,
    synthSpan(st, jsxQuoteWord(identText(tree, source, k[0]))),
  )
  let argNodes = [jsxArgWrap(tree, sp, nameLit)]
  for a of kidsOf(tree, k[1]) {
    argNodes = append(argNodes, jsxArgWrap(tree, sp, jsxAttrCall(tree, source, st, a)))
  }
  for v of jsxChildValues(tree, source, st, k[2]) {
    argNodes = append(argNodes, jsxArgWrap(tree, sp, v))
  }
  let callee = synthIdent(tree, st, "elem")
  let argsNode = addNode(tree, Tag.Args, sp, 0, argNodes)
  let call = addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode])
  tree.nodes[node] = tree.nodes[call]
}

// Rewrites one desugarable UPPERCASE `jsx_elem` IN PLACE into an ordinary
// named-argument call: `Tag(attr = value, ..., children = [child, ...])`
// (SPEC §12.12) — `children` is added only when the element has at least one
// child, so a leaf component desugars to a plain call with no empty tail. A
// spread attribute is reported (E0025, `ecJsxSpreadOnComponent`) and dropped
// rather than passed to `jsxNamedArg`, which assumes every attribute has a
// name and a value slot.
fn rewriteJsxUpperElem(tree: Tree, source: string, st: SynthText, node: int, diags: Diagnostics) {
  let sp = getNode(tree, node).span
  let k = kidsOf(tree, node)
  let argNodes = []int(0)
  for a of kidsOf(tree, k[1]) {
    if (getNode(tree, a).tag == Tag.JsxSpreadAttr) {
      reportNoHint(
        diags, ecJsxSpreadOnComponent, getNode(tree, a).span,
        "a spread attribute cannot be used on a component element; Bit has no named-argument spread",
      )
      continue
    }
    argNodes = append(argNodes, jsxNamedArg(tree, st, a))
  }
  let childVals = jsxChildValues(tree, source, st, k[2])
  if (len(childVals) != 0) {
    let items = []int(0)
    for v of childVals {
      items = append(items, jsxArgWrap(tree, sp, v))
    }
    let sliceLit = addNode(tree, Tag.SliceLit, sp, 0, items)
    let childrenName = synthIdent(tree, st, "children")
    argNodes = append(argNodes, addNode(tree, Tag.NamedArg, sp, 0, [childrenName, sliceLit]))
  }
  let argsNode = addNode(tree, Tag.Args, sp, 0, argNodes)
  let call = addNode(tree, Tag.Call, sp, 0, [k[0], 0, argsNode])
  tree.nodes[node] = tree.nodes[call]
}

// Rewrites one `jsx_frag` IN PLACE into `frag(child, ...)` (SPEC §12.12) —
// the same shape a lowercase element's children take, with no tag-name
// argument and no attributes (a fragment has none).
fn rewriteJsxFrag(tree: Tree, source: string, st: SynthText, node: int) {
  let sp = getNode(tree, node).span
  let childrenNode = kidsOf(tree, node)[0]
  let argNodes = []int(0)
  for v of jsxChildValues(tree, source, st, childrenNode) {
    argNodes = append(argNodes, jsxArgWrap(tree, sp, v))
  }
  let callee = synthIdent(tree, st, "frag")
  let argsNode = addNode(tree, Tag.Args, sp, 0, argNodes)
  let call = addNode(tree, Tag.Call, sp, 0, [callee, 0, argsNode])
  tree.nodes[node] = tree.nodes[call]
}

// Dispatches one desugarable node (already filtered by `jsxIsDesugarable`) to
// its rewrite: a fragment, else a lowercase or uppercase element by its own
// tag's first letter. `diags` reaches only `rewriteJsxUpperElem` (#5172's
// spread-on-component diagnostic); every other rewrite cannot fail.
fn desugarJsxNode(tree: Tree, source: string, st: SynthText, node: int, diags: Diagnostics) {
  if (getNode(tree, node).tag == Tag.JsxFrag) {
    rewriteJsxFrag(tree, source, st, node)
    return
  }
  if (jsxIsLowerTag(identText(tree, source, kidsOf(tree, node)[0]))) {
    rewriteJsxLowerElem(tree, source, st, node)
  } else {
    rewriteJsxUpperElem(tree, source, st, node, diags)
  }
}

// Whether this module has ANY desugarable node at all. NOT the same question
// as "does it need synthesized words": an uppercase element with only
// explicit-value attributes and no children needs neither `elem`/`attr` nor
// `children`/`true` — every name it needs is already a real source Ident,
// reused as-is (see the file header) — so `jsxSynthWords` legitimately
// returns empty for it while it still has a `jsx_elem` that must become a
// `Call` before resolve ever sees the tree. Gating the rewrite on an empty
// word list instead of this left such an element's raw `jsx_elem`/`jsx_attr`
// nodes for the ordinary resolver to walk, which resolved the attribute's
// own name as a plain variable reference and reported a spurious E0040.
fn jsxModuleHasNodes(tree: Tree): bool {
  let i = 1
  while (i < len(tree.nodes)) {
    if (jsxIsDesugarable(tree, i)) {
      return true
    }
    i = i + 1
  }
  return false
}

// Entry point, called from `resolveProject` (checkproject.bit) right after
// `injectSynthMembers` — same reason: every front end reaches the checker
// through there, so this is the one place the rewrite has to happen before
// resolve sees the tree. Each module either contains no desugarable JSX (the
// common case) or gets one `appendSynthText` call (a no-op source append when
// no word is needed) and one rewrite pass.
fn desugarJsxProject(p: Project) {
  let i = 0
  while (i < len(p.mods)) {
    desugarJsxInModule(p.mods[i], p.diags)
    i = i + 1
  }
}

// `diags` is only ever written to by a spread attribute on a component
// element (#5172, `ecJsxSpreadOnComponent`). Its span, like every AST node's,
// is a MODULE-GLOBAL offset into `m.source`'s concatenation of this module's
// files (parser.bit never sees more than one file at a time, so that is the
// only kind of span it can produce) — remapDiags's own comment: "left alone
// they render against the wrong file and line the moment a module has more
// than one [file]". `injectSynthMembers` owes the identical call for exactly
// this reason; an earlier version of this comment claimed a real parsed span
// needed no remap, which is what a spread attribute on `<Foo>` in a
// single-file module with a prelude first proved wrong (E0025 rendered
// against stdlib/core/core.bit, module 0, instead of the caller's own file).
fn desugarJsxInModule(m: SrcModule, diags: Diagnostics) {
  if (!jsxModuleHasNodes(m.tree)) {
    return
  }
  let words = jsxSynthWords(m.tree, m.source)
  let st = appendSynthText(m, jsxSynthFileId(m.tree, m.source), words)
  let before = len(diags.list)
  let i = 1
  while (i < len(m.tree.nodes)) {
    if (jsxIsDesugarable(m.tree, i)) {
      desugarJsxNode(m.tree, m.source, st, i, diags)
    }
    i = i + 1
  }
  remapDiags(diags, before, m.files, m.fileStarts)
}
