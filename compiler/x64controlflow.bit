// Self-host Stage 3 (#1346): the x86-64 backend, control-flow lowering and
// the inlined back-edge safepoint poll. Split out of compiler/x64call.bit
// (#3365, to keep it under the 800-line limit); same module, so nothing here
// is imported.

// A block's params are written by each predecessor's edge move — all at once,
// as ONE parallel move covering both classes (#3182), because a param may
// still be READ as another param's source in the same edge, and an int and a
// float move here can share a spill-slot number (#3168) — splitting this into
// two independently-ordered calls is what let that alias silently.
fn xEmitParamMoves(cx: XCtx, target: int, args: []int) {
  xSequentializeAndEmit(cx, xBlockArgMoves(cx, target, args))
}

// The parallel move an edge to `target` performs, built but NOT emitted. Split
// out of xEmitParamMoves for #4372, which must know whether an edge emits
// anything before it commits to a branch shape — and the honest way to know is
// to build the moves and ask `pmovesAllIdentity`, not to guess from the
// argument count: on arm64 the `len(args) > 0` form left 9 of `matrix`'s 20
// sites standing, because an edge whose every argument already sits in its
// parameter's location emits nothing. Building this twice costs nothing beyond
// the work: xValueClass and xPlocOf only read.
fn xBlockArgMoves(cx: XCtx, target: int, args: []int): []PMove {
  let blk = cx.f.blocks[target]
  let moves = []PMove(0)
  let p = 0
  while (p < blk.paramCount) {
    let paramVal = blk.instsStart + p
    let regClass = xValueClass(cx, paramVal)
    moves = append(
      moves,
      PMove{
        src = xPlocOf(cx, args[p], regClass),
        dst = xPlocAt(cx, paramVal, regClass, paramVal),
      },
    )
    p = p + 1
  }
  for m of splitEdgeMoves(cx.alloc, cx.curInst, blk.instsStart) {
    let dst = xPlocAt(cx, m.vreg, RegClass.Int, blk.instsStart)
    if (!movesWrite(moves, dst)) {
      moves = append(moves, PMove{ src = xPlocAt(cx, m.vreg, RegClass.Int, cx.curInst), dst = dst })
    }
  }
  return moves
}

// #7186: per block, whether its lone jump (`loneJump`, jumpchain.bit) moves
// nothing, so `jumpChainEnd` may branch past it (#7732: and no register clear
// precedes it). The same build-and-ask as #4372's; xBlockArgMoves only reads.
fn xJumpsInPlace(cx: XCtx): []bool {
  let out = []bool(len(cx.f.blocks))
  let keep = cx.curInst
  let blk = 0
  while (blk < len(cx.f.blocks)) {
    let j = loneJump(cx.f, blk)
    if (j >= 0) {
      let ins = cx.f.instrs[j]
      cx.curInst = j // #7635: a split value's location depends on the edge's position
      out[blk] = regClearsAt(cx.alloc, j) == 0 &&
        pmovesAllIdentity(xBlockArgMoves(cx, ins.ival, ins.args))
    }
    blk = blk + 1
  }
  cx.curInst = keep
  return out
}

// #7189: the block this one falls into — the next one emitted, past every
// forwarder no branch names (`bypassedForwarders`, jumpchain.bit), or
// `len(f.blocks)` past the last.
fn xFallInto(cx: XCtx): int {
  let next = cx.curBlock + 1
  while (next < len(cx.bypassed) && cx.bypassed[next]) {
    next = next + 1
  }
  return next
}

// #7189: where xEmitFuncBody stops emitting block `bi`: at its params when it
// is a bypassed forwarder, which then emits nothing, else at its end.
fn xEmitEnd(cx: XCtx, bi: int): int {
  let b = cx.f.blocks[bi]
  if (bi < len(cx.bypassed) && cx.bypassed[bi]) {
    return b.instsStart + b.paramCount
  }
  return b.instsStart + b.instsLen
}

// Binds the incoming argument registers into the entry block's param vregs — the
// mirror of xEmitParamMoves, with the ABI argument registers as sources instead
// of another block's values. Without it the entry params hold whatever the
// allocator left in their registers, so every function that reads its own
// parameters returns garbage. Emitted right after the prologue, whose only
// register writes are callee-saved GPRs and rbp/rsp — never an argument register
// — so the incoming values are still live.
fn xBindIncomingArgs(cx: XCtx) {
  let entry = cx.f.blocks[0]
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let intOrdinal = 0
  let floatOrdinal = 0
  let stackIndex = 0
  let p = 0
  while (p < entry.paramCount) {
    let paramVal = entry.instsStart + p
    let regClass = xValueClass(cx, paramVal)
    let ordinal = intOrdinal
    if (regClass == RegClass.Float) {
      ordinal = floatOrdinal
    }
    let dst = xPlocAt(cx, paramVal, regClass, paramVal)
    let reg = xArgReg(cx.cc, regClass, p, ordinal)
    // The mirror of xMarshalArgs (compiler/x64call.bit): the first six int /
    // eight float params arrive in the ABI registers; the rest were pushed by
    // the caller and now sit just above the saved rbp and return address, at
    // [rbp+16], [rbp+24], … in argument order for SysV (a non-register PLoc
    // reads rbp-relative). Win64 additionally interposes the CALLER's 32-byte
    // shadow space between the return address and the outgoing stack args
    // (xEmitCallLike, compiler/x64call.bit), so there the first stack arg is
    // at [rbp+48]; xShadowSpace is 0 on SysV, so that target is unaffected.
    let src = plocReg(reg, regClass)
    if (reg < 0) {
      src = plocMem(16 + xShadowSpace(cx.cc) + 8 * stackIndex, regClass)
      stackIndex = stackIndex + 1
    }
    moves = append(moves, PMove{ src = src, dst = dst })
    if (regClass == RegClass.Int) {
      intOrdinal = intOrdinal + 1
    } else {
      floatOrdinal = floatOrdinal + 1
    }
    p = p + 1
  }
  xSequentializeAndEmit(cx, moves)
  cx.argFwd = xIntactArgStores(moves)
  cx.argFwdAt = len(cx.buf.code)
}

// #7057: the register-to-slot stores of a parallel move whose source register
// no move in it writes, so once the move is done that register still equals
// the slot. A spilled param's first use then reads the incoming register
// instead of reloading the word stored one instruction earlier. The store
// itself stays where it was, so a safepoint never sees the slot unwritten.
fn xIntactArgStores(moves: []PMove): []PMove {
  let out = []PMove(0)
  for m of moves {
    if (m.src.isReg && !m.dst.isReg && !xMovesWriteReg(moves, m.src)) {
      out = append(out, m)
    }
  }
  return out
}

fn xMovesWriteReg(moves: []PMove, r: PLoc): bool {
  for m of moves {
    if (m.dst.isReg && m.dst.v == r.v && m.dst.regClass == r.regClass) {
      return true
    }
  }
  return false
}

// #7057: the register number that still holds the spill slot at byte offset
// `off`, or -1. Only while nothing has been emitted since xBindIncomingArgs:
// any emitted byte may write the register or be a safepoint that rewrites the
// slot, and xEmitFuncBody clears the list when a branch can reach that offset.
// The register must be in the allocatable file: one outside it is a scratch or
// is reserved for idiv/shift, and a selector may write those before reading its
// operands. The current instruction's own home is refused for the same reason.
//
// #7235: so is any safepoint or asm position. Regalloc keeps the operands of
// a call, an allocation, a closure or an asm block in callee-saved registers
// (regallocpoints.bit `crossesPoint`), so such a selector may write an
// argument register before it reads an operand; a forward to that register
// would then be read clobbered. xMarshalArgs still forwards through
// xArgFwdAt: its parallel move orders a register source wherever it lives.
fn xArgFwd(cx: XCtx, off: int, regClass: RegClass): int {
  let op = cx.f.instrs[cx.curInst].op
  if (isSafepointOp(op) || op == Op.Asm) {
    return -1
  }
  return xArgFwdAt(cx, off, regClass)
}

// xArgFwd's lookup without the position refusal.
fn xArgFwdAt(cx: XCtx, off: int, regClass: RegClass): int {
  if (len(cx.buf.code) != cx.argFwdAt) {
    return -1
  }
  for m of cx.argFwd {
    if (m.dst.v == off && m.src.regClass == regClass) {
      let k = xFwdIndex(cx, m.src.v, regClass)
      let dst = locAt(cx.alloc, cx.curInst, cx.curInst)
      if (k < 0 || (!dst.isSpill && dst.index == k)) {
        return -1
      }
      return m.src.v
    }
  }
  return -1
}

// #7057: a spill-slot call-argument source as the register xArgFwd says
// still holds it (xMarshalArgs).
fn xArgFwdSrc(cx: XCtx, src: PLoc): PLoc {
  if (src.isReg || src.isImm) {
    return src
  }
  let r = xArgFwdAt(cx, src.v, src.regClass)
  if (r < 0) {
    return src
  }
  return plocReg(r, src.regClass)
}

// The index of register number `r` in this function's allocatable file of
// `regClass`, or -1.
fn xFwdIndex(cx: XCtx, r: int, regClass: RegClass): int {
  let i = 0
  if (regClass == RegClass.Int) {
    while (i < len(cx.intRegs)) {
      if (xRegNum(cx.intRegs[i]) == r) {
        return i
      }
      i = i + 1
    }
    return -1
  }
  while (i < len(cx.floatRegs)) {
    if (xmmNum(cx.floatRegs[i]) == r) {
      return i
    }
    i = i + 1
  }
  return -1
}

// #2921 (arm64) / #2926 (x64): the naked shim's full chain (five stack frames,
// see runtime/stw/stwpoll.bit) is only needed when a stop is pending or a
// collection is due — both rare. #2926 guarded it behind a call to
// `bit_rt_safepoint_needed`; #3169 inlined that call's own condition instead,
// porting what #2925 did on arm64; #4203 replaced the inlined condition with a
// single word the runtime publishes (xEmitPollGuard below) — see
// compiler/arm64call.bit's header there for why a call, even to a true leaf,
// remained ~0.50s of collatz's 0.86s. This file's comment claimed parity with
// arm64 for the month between #2925 and #3169 and was false for all of it.
//
// The safepoint bookkeeping is unchanged by either move: only the real poll
// passes isSafepoint=true to xEmitCallLike, so exactly one nextSafepointIdx
// advance happens per back edge — which is what buildIntervals
// (compiler/codegen.bit) recorded for that edge, independent of how many
// machine instructions this emits.
//
// #6463: `moves` is the edge's parallel move. When neither it nor a clear
// emits anything, the poll's own `je` takes the edge straight to `target` and
// the call falls through to the edge's jmp. The loop then runs one taken jump
// per iteration instead of a `je` over the call plus that jmp, and the jmp's
// pad no longer sits between a label and the jmp with nothing to prefix.
fn xEmitBackEdgeSafepointIfNeeded(cx: XCtx, curBlock: int, target: int, moves: []PMove) {
  // §10.3.1: a @naked/@nosplit function polls no safepoint on its back-edges.
  if (!emitsBackEdgePoll(cx.f, curBlock, target)) {
    return
  }
  let direct = pmovesAllIdentity(moves) && !edgeHasClears(cx.alloc.clears, curBlock, target)
  xEmitPollGuard(cx, target, direct)
}

// #4203: THE WHOLE BACK EDGE IS FOUR INSTRUCTIONS.
//
//   movq  <pollCache 0>(%rbp), %r11   the address of the attention word
//   movq  (%r11), %r11                load it
//   testq %r11, %r11
//   je    <past the call>             the answer is no, essentially always
//   call  bit_rt_safepoint            the answer is yes: find out why in there
//
// Clause for clause with arm64's emitPollGuard (compiler/arm64call.bit), which
// folds the compare into `cbz` and so emits three. What it replaces is a
// twenty-six-instruction ladder asking three independent questions of state the
// runtime had already computed, plus (#4200) an eight-instruction countdown
// that existed only to make asking them rarer. runtime/sched/pollreq.bit holds
// the design and the invariant.
//
// THE PLAIN `mov` IS THE ACQUIRE LOAD, under x86-64's TSO — no load may be
// reordered ahead of an earlier load, so the slow path's own reads of the state
// this word summarises cannot be satisfied before it. That is the same fact
// xEmitAtomicLoad (x64selectmem.bit) relies on for Op.AtomicLoad itself, and
// the same fact the ladder's two atomic reads already relied on. arm64 needs an
// explicit `ldar`; see emitPollGuard's header for why the acquire is required
// rather than decorative.
//
// r11 (xScratch1) is caller-saved in BOTH conventions, is an argument register
// in neither, and no vreg can live in it (it is outside xMasterGprs), so
// nothing live across the back edge is at risk. r12 (xScratch3) is not used: it
// is callee-saved, so only a function that saves it may write it (#6198).
fn xEmitPollGuard(cx: XCtx, target: int, direct: bool) {
  let r = xScratch1()
  xMovLoad(cx.buf, r, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), 8, false)
  xMovLoad(cx.buf, r, xMemB(r, 0), 8, false)
  xTestRR(cx.buf, r, r)
  if (direct) {
    xJccRel32(cx, ccE(), target) // nobody is asking -> the edge itself
    xEmitCallLike(cx, safepointSymbol(), []int(0), false, 0, 0, true)
    return
  }
  let skip = xJccRel32Placeholder(cx, ccE()) // nobody is asking -> past the call
  xEmitCallLike(cx, safepointSymbol(), []int(0), false, 0, 0, true)
  xPatchRel32Here(cx, skip)
}

// The cached poll-address slot sits at the TOP of the spill area, in the slot
// xCompileFunction carves ABOVE the ones the register allocator asked for.
// Reusing the spill area rather than adding a frame region keeps x64frame.bit's
// layout comment ("then spill slots, then saved XMMs") true as written and
// needs no new XFrame field — and it keeps this raw runtime address out of
// every stack map, because xCompileFunction builds a SafepointView's `slots`
// only from the indices the ALLOCATOR reports, which never reach this high. A
// GC that walked it would try to trace a scheduler module-state address as a
// managed object.
fn xPollCacheOffset(f: XFrame, i: int): int {
  // Sized by xCompileFunction on the same hasBackEdgeSafepoint predicate that
  // gates every caller here, so a frame reaching this point always has it.
  // Asserted rather than assumed: a silently negative index would address the
  // CALLER's frame.
  //
  // #4457 asks `pollCacheSlots`, not `numSpillSlots >= 1`. The weaker test
  // passed on any frame the ALLOCATOR gave a spill slot to, so a caller on a
  // frame with one real spill slot and no poll cache would read that spill slot
  // as a runtime address and get no complaint.
  assert(f.pollCacheSlots == 1 && f.numSpillSlots >= 1 && i >= 0 && i < 1)
  if (len(f.slotPos) == 0) {
    return xSlotOffset(f, f.numSpillSlots - 1 + i)
  }
  return xSlotOffset(f, f.pollPos + i) // #7565: `xPlaceSlots`
}

// #4457: `Op.PollAttention` — the attention word's VALUE, through the slot
// xEmitPollCachePrefetch already filled. Two loads, no call, no relocation, no
// safepoint; see pollAttentionAddrSymbol (codegen.bit) for what it is for and
// for why a relaxed read is the right one here.
//
//   movq <pollCache 0>(%rbp), %rD   the address of the attention word
//   movq (%rD), %rD                 the word itself
//
// Under TSO the plain `movq` is already an acquire load, so this and the
// guard's own load emit the same instruction on this target — the two differ
// only on arm64, where the guard needs an explicit `ldar`. xPollCacheOffset
// carries the bound check for the frame's precondition.
fn xEmitPollAttention(cx: XCtx, dst: int) {
  let acc = xIntAcc(cx, dst)
  xMovLoad(cx.buf, acc, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), 8, false)
  xMovLoad(cx.buf, acc, xMemB(acc, 0), 8, false)
  xPutInt(cx, dst, acc)
}

// Fetches the attention word's ADDRESS once per function invocation into that
// slot, rather than once per loop iteration. Safe because it is the address of
// a module global in runtime/sched/pollreq.bit — a per-process constant for the
// entire lifetime of every function this backend compiles.
//
// Emitted right after xBindIncomingArgs: the incoming args are already off
// rdi..r9 by then, so this call's ordinary caller-saved clobber is harmless to
// the INT file — every int vreg in a function that polls a back edge lives in a
// callee-saved register or a spill slot already (xBuildIntRegs under
// hasSafepoints).
//
// The FLOAT file is no longer covered by that argument (#3171): xBuildFloatRegs
// hands out xmm0..xmm13 in such a function, and under SysV none of them
// survives a call. What covers it instead is that this call is named as a
// clobber point in its own right — xClobberPoints (compiler/x64frame.bit)
// reports the entry block's first non-parameter instruction index, which is
// exactly this program point — so any parameter still read afterwards is
// allocated as live-across and never sits in an xmm here. Deleting that entry
// would silently destroy a float parameter, and no stack map would notice: the
// collector never sees float locations at all.
//
// bit_rt_port_sched_poll_attention_addr is itself a true leaf that never
// allocates or parks, so — like the #2926 guard call it descends from — it is
// not recorded as a safepoint.
//
// #4203 CUT THIS FROM THREE CALLS AND FOUR SLOTS TO ONE AND ONE.
fn xEmitPollCachePrefetch(cx: XCtx) {
  if (!hasBackEdgeSafepoint(cx.f)) {
    return
  }
  xEmitCallLike(cx, pollAttentionAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), XReg64.Rax, 8)
}

// A back-edge polls the collector BEFORE the edge moves: the poll is a call, and
// the moves may leave a param mid-write. `i` is the jump's own instruction id,
// which xJumpOrFallThrough needs to know it is the block's terminator.
fn xEmitJump(cx: XCtx, i: int, target: int, args: []int) {
  let moves = xBlockArgMoves(cx, target, args)
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, target, moves)
  xSequentializeAndEmit(cx, moves)
  xEmitEdgeClears(cx, cx.curBlock, target)
  xJumpOrFallThrough(cx, i, target)
}

// #5847: zeroes the dead spilled heap-word slots the edge `src` -> `target`
// ends (regallocclear.bit). After the moves, which may read one of them as an
// argument; before the jump.
fn xEmitEdgeClears(cx: XCtx, src: int, target: int) {
  for slot of edgeClearSlots(cx.alloc.clears, src, target) {
    xMovStoreImm(cx.buf, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, slot)), 0)
  }
}

// The conditional jump that reaches `target` by naming it, or, when the edge
// carries clears, names its out-of-line stub (ClearStub, regallocclear.bit).
fn xJccToEdge(cx: XCtx, cc: int, target: int) {
  let clears = cx.alloc.clears
  if (!edgeHasClears(clears, cx.curBlock, target)) {
    xJccRel32(cx, cc, jumpChainEnd(cx.f, clears, cx.jumpInPlace, cx.curBlock, target))
    return
  }
  let off = xJccRel32Placeholder(cx, cc)
  cx.clearStubs = append(
    cx.clearStubs, ClearStub{ patchOffset = off, src = cx.curBlock, dst = target },
  )
}

// After the last block, before xPatchJumpFixups resolves the stubs' jumps.
fn xEmitClearStubs(cx: XCtx) {
  for s of cx.clearStubs {
    xPatchRel32Here(cx, s.patchOffset)
    xEmitEdgeClears(cx, s.src, s.dst)
    xJmpRel32(cx, jumpChainEnd(cx.f, cx.alloc.clears, cx.jumpInPlace, s.src, s.dst))
  }
}

// The jump to `target`, elided when control would arrive there anyway: blocks
// are emitted in index order by xCompileFunction, so `xFallInto`'s block
// begins at exactly the byte after this block's last instruction. `i` must be
// that last instruction — a jump anywhere else in a block is jumping over the
// rest of it, not falling out of it.
//
// This is deliberately NOT used for the THEN edge of xEmitBr's both-edges-
// inline shape. There the else fixup is resolved by xPatchRel32Here to
// whatever follows the then edge, so dropping the then jump would patch that
// conditional jump to its own destination — an infinite loop, not a shorter
// one. xEmitBr calls this only on the tail edge, which nothing skips over.
//
// #7159: an emitted jump names `jumpChainEnd` (jumpchain.bit). #7189: its end
// is the fall-through block only when every forwarder between them is
// bypassed and so emits nothing: falling in then runs the same code.
fn xJumpOrFallThrough(cx: XCtx, i: int, target: int) {
  let b = cx.f.blocks[cx.curBlock]
  let dest = jumpChainEnd(cx.f, cx.alloc.clears, cx.jumpInPlace, cx.curBlock, target)
  let next = xFallInto(cx)
  if ((target == next || dest == next) && i == b.instsStart + b.instsLen - 1) {
    return
  }
  xJmpRel32(cx, dest)
}

// ===========================================================================
// #4372: one conditional jump, not a jcc to a jmp that jumps again
// ===========================================================================
//
// The both-edges-inline shape below is what `br` always emitted, and x86-64
// had no fall-through elision at all, so when NEITHER edge carries code it
// degenerates to three jumps doing one jump's work — 20 of the 56 conditional
// jumps in the `matrix` bench object's `main`:
//
//     testq %rbx, %rbx
//     je    L        <- 5 bytes down, straight over the jmp below it
//     jmp   THEN     <- and THEN is very often the very next block
//   L: jmp   ELSE
//
// An edge only needs code of its own for two reasons — a back-edge safepoint
// poll, and the target block's parameter moves — so when one edge needs
// neither, the conditional jump can name that edge's BLOCK directly
// (`xJccRel32`, whose fixup xPatchJumpFixups resolves against blockOffsets
// exactly as the unconditional `xJmpRel32`'s is) and the other edge takes the
// fall-through. This is #4348's restructure, mirrored; arm64 already had the
// fall-through half.
//
// Nothing here moves a safepoint. Every shape emits an edge's poll on that
// edge's own path and nowhere else, and the ORDER in which the two edges'
// polls are emitted is unchanged — which is what `recordSafepoint`'s
// `sm.pos == cx.safepointPositions[...]` assert checks, since the stack maps
// are consumed in the order `buildIntervals` collected them.
//
// Block order is untouched: this decides how to REACH a block, never where a
// block goes. And the reach is untouched too — a conditional jump here is the
// rel32 form (`xJccRel32`), the same displacement field `xJmpRel32` already
// aimed at the same blocks, so naming a block conditionally can reach exactly
// what naming it unconditionally could. That is the one place x86-64 differs
// from arm64, where the same change narrowed imm26's ±128 MB to imm19's ±1 MB
// and needed an assert.

// Does this `br`'s edge to `target` need any code emitted ON the edge? Two
// things decide it: a back-edge safepoint poll and the target block's
// parameter moves. `moves` is that edge's already-built parallel move, so this
// is exact rather than a guess from the argument count. #5847's dead-slot
// clears do not: a named edge carrying them reaches a stub (xJccToEdge).
fn xBrEdgeNeedsInlineCode(cx: XCtx, target: int, moves: []PMove): bool {
  if (emitsBackEdgePoll(cx.f, cx.curBlock, target)) {
    return true
  }
  return !pmovesAllIdentity(moves)
}

// ===========================================================================
// #4393: a compare that feeds a `br` branches on its own flags
// ===========================================================================
//
// Lowering emits every comparison as a value, so `if (a < b)` cost five
// instructions where two do:
//
//     cmpq   %rbx, %rax        <- sets the flags
//     setl   %r11b             <- materializes the boolean
//     movzbq %r11b, %r11       <- widens it to a clean 0/1
//     testq  %r11, %r11        <- puts "is that boolean zero" back in the flags
//     jne    <then>
//
// The middle three are pure round-tripping: `jl` reads exactly the flag state
// the first `cmp` already set. Fusing them leaves `cmpq %rbx, %rax` + `jl
// <then>`, which is what `clang -O2` emits. This is the x86-64 sibling of
// #3843 on arm64, and it reuses that ticket's `computeFuseCmpBranch`
// (arm64branch.bit) rather than copying it — the analysis is over the IR
// alone, and a fix applied to a copy does not reach its sibling.
//
// TWO conditions make the fusion exact, and both come from that function:
//
//   1. The boolean has exactly one use and that use is the branch's condition.
//      A boolean that is also stored, returned, passed as a call or block
//      argument, or read by a second branch is a real value and still needs
//      its `setcc`. Use counts come from `instrOperands` (opt.bit), the same
//      operand map DCE uses, so a use this backend forgot to think about is
//      still counted.
//
//   2. The flags are still live at the branch. The compare must be the
//      instruction immediately before the `br` IN THE SAME BLOCK — adjacency
//      in the instruction array alone is not enough, because a `br` that is
//      its block's only instruction is adjacent to the previous block's last
//      one and a different predecessor would reach it with arbitrary flags.
//
// EMISSION adjacency then follows from IR adjacency, and the claim is stronger
// than "nothing clobbers the flags in between": there IS no in between. The
// fused `xEmitIcmp` (x64selectarith.bit) ends with the flag-setting `cmp` and
// emits nothing after it — no `setcc`, no `movzx`, and no `xPutInt` spill
// store; `xEmitBrCondition` below emits nothing at all on that path; and
// `xEmitBr` puts its conditional jump FIRST in every one of its three shapes,
// before any edge move, any poll and any `xBlockArgMoves` (which builds and
// does not emit). xCompileFunction's block loop emits instructions in index
// order and puts nothing between two of them — `appendDebugLineIfChanged`
// records an offset and writes no code. So the `jcc` reads the flags at the
// very byte offset the deleted `test` occupied.
//
// A SAFEPOINT cannot land in that gap either, and for the same reason rather
// than by luck: a safepoint is emitted at a call, at `gc_alloc`, or on a back
// edge (runtime/ABI.md §4). The first two would be an instruction between two
// ADJACENT instruction indices, which cannot exist, and this `br`'s own
// back-edge poll is emitted after the conditional jump in every shape of
// `xEmitBr` — downstream of the read.
//
// FLOAT compares are deliberately NOT fused here, even though
// `computeFuseCmpBranch` marks them: `ucomis` decides FEq and FNe across two
// flags (ZF for equal-or-unordered, PF for unordered), which needs two
// conditional jumps rather than one, and xEmitFcmp still materializes its
// boolean for all six. `xBrFusesCmp` therefore re-tests `isIcmp` on the marked
// instruction; without that clause a branch on a fused fcmp would read flags
// no `test` ever set.

// The x86 condition that is true on exactly the flag states `cc` is false on.
// Every condition code pairs with its complement in the LOW BIT — E 0x4/NE
// 0x5, B 0x2/AE 0x3, BE 0x6/A 0x7, L 0xC/GE 0xD, LE 0xE/G 0xF, P 0xA/NP 0xB,
// O 0x0/NO 0x1 — which is the flag-level complement, not a negation of the
// source-level predicate. checkX64CcInvert pins every pair.
fn xCcInvert(cc: int): int {
  return cc ^ 1
}

// The fused-compare map for the function being emitted, computed on first
// demand. `newXCtx` builds a fresh XCtx per function (xCompileFunction) and
// `cx.f` never changes within one, so this runs exactly once per function —
// and a function with no compare at all never pays for the walk.
fn xFuseCmp(cx: XCtx): []bool {
  if (!cx.fuseCmpReady) {
    cx.fuseCmp = computeFuseCmpBranch(cx.f)
    cx.fuseCmpReady = true
  }
  return cx.fuseCmp
}

// Does the `br` at `i` read flags an INTEGER compare at `i - 1` already set?
// `cond == i - 1` is what ties the marked compare to this branch: a `br` whose
// condition is some earlier value is not the fused pair even when the
// instruction before it happens to be a fused compare for a different branch.
fn xBrFusesCmp(cx: XCtx, i: int, cond: int): bool {
  return cond == i - 1 && xFuseCmp(cx)[cond] && isIcmp(cx.f.instrs[cond].op)
}

// Puts the branch's condition into the flags, and returns the condition code
// its THEN edge is taken on. A fused compare has already set them and emitted
// nothing else, so this emits nothing and hands back the compare's own code.
// Otherwise the condition is a materialized 0/1 boolean and `test c, c` sets
// ZF iff it is zero, so THEN is `jne`.
fn xEmitBrCondition(cx: XCtx, i: int, cond: int): int {
  if (xBrFusesCmp(cx, i, cond)) {
    return xCcForIcmp(cx.f.instrs[cond].op)
  }
  let c = xGetInt(cx, cond, xScratch1())
  xTestRR(cx.buf, c, c)
  return ccNe()
}

// Emits the whole of `br`. `i` is its instruction id, which is its block's
// last, so either edge is a legal fall-through candidate.
//
// The ELSE edge is taken on the complement of the THEN condition — the same
// single flag test, read in either direction.
fn xEmitBr(cx: XCtx, i: int, ins: IrInstr) {
  let thenCc = xEmitBrCondition(cx, i, ins.lhs)
  let elseCc = xCcInvert(thenCc)
  let thenMoves = xBlockArgMoves(cx, ins.ival, ins.thenArgs)
  let elseMoves = xBlockArgMoves(cx, ins.ival2, ins.elseArgs)
  let thenInline = xBrEdgeNeedsInlineCode(cx, ins.ival, thenMoves)
  let elseInline = xBrEdgeNeedsInlineCode(cx, ins.ival2, elseMoves)
  // THEN needs nothing: jump straight to it and let ELSE have the tail.
  // Preferred over the mirror when ELSE is the next block, because then the
  // tail costs nothing either and the whole `br` is one jump.
  if (!thenInline && (elseInline || ins.ival2 == xFallInto(cx))) {
    xJccToEdge(cx, thenCc, ins.ival)
    xEmitBrEdgeTail(cx, i, ins.ival2, elseMoves)
    return
  }
  // ELSE needs nothing: jump straight to it and let THEN have the tail.
  if (!elseInline) {
    xJccToEdge(cx, elseCc, ins.ival2)
    xEmitBrEdgeTail(cx, i, ins.ival, thenMoves)
    return
  }
  // Both edges carry code, so one of them has to be jumped over. Jump over the
  // then-path when the condition is ZERO. The edge moves must sit on their own
  // side of this branch — emitting them before it would run the then-edge's
  // moves on the else path too.
  let skipOff = xJccRel32Placeholder(cx, elseCc)
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, ins.ival, thenMoves)
  xSequentializeAndEmit(cx, thenMoves)
  xEmitEdgeClears(cx, cx.curBlock, ins.ival)
  xJmpRel32(cx, jumpChainEnd(cx.f, cx.alloc.clears, cx.jumpInPlace, cx.curBlock, ins.ival))
  xPatchRel32Here(cx, skipOff)
  xEmitBrEdgeTail(cx, i, ins.ival2, elseMoves)
}

// The tail edge's own code, then its jump — elided when `target` is the next
// block, which is xJumpOrFallThrough's whole job.
fn xEmitBrEdgeTail(cx: XCtx, i: int, target: int, moves: []PMove) {
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, target, moves)
  xSequentializeAndEmit(cx, moves)
  xEmitEdgeClears(cx, cx.curBlock, target)
  xJumpOrFallThrough(cx, i, target)
}

// A multi-value ret lowers into the per-convention return-register lists
// (#5868); W == 1 stays the original single-value path byte for byte.
fn xEmitRet(cx: XCtx, vals: []int): bool {
  if (len(vals) > 1) {
    xEmitMultiWordRet(cx, vals)
  } else if (len(vals) == 1) {
    let v = vals[0]
    if (xValueClass(cx, v) == RegClass.Float) {
      let r = xGetFloat(cx, v, xFScratch1())
      xMovFRR(cx.buf, XmmReg.Xmm0, r, widthOf(cx.ctx, cx.f.instrs[v].ty).bytes)
    } else {
      let r = xGetInt(cx, v, xScratch1())
      xMovRR(cx.buf, XReg64.Rax, r)
    }
  }
  // §10.3.1 @naked: no epilogue teardown — the value is already in rax/xmm0;
  // emit only the raw `ret`. #7241: a frameless function has none to undo.
  if (!cx.f.isNaked && !cx.frame.frameless) {
    xEmitEpilogue(cx)
  }
  xRet(cx.buf)
  return true
}

// The W > 1 half of xEmitRet: one parallel move from each value's own
// location into the ABI return register of its class and ordinal
// (xRetRegsFor, compiler/x64.bit) — the arm64 twin is emitMultiWordRet
// (arm64call.bit). ONE parallel move, not W sequential ones: a value may
// already sit in another word's return register (e.g. a swapped pair of int
// results), and a left-to-right sequence would overwrite one before it is
// read. xSequentializeAndEmit resolves that through the reserved secondary
// scratch. There is no return-word spill path (#4238) — xRetRegsFor asserts
// the budget rather than falling back.
//
// #6839: a zero word is pulled out of the move and cleared last with the
// 2-byte `xor r32, r32` instead of the 7-byte `mov r64, 0`. Last is where the
// sequencer writes every immediate anyway, after each register it reads. The
// xor writes flags, which are dead here and only here among the parallel-move
// callers: only the epilogue and `ret` follow, nothing reads them there, and
// no ABI keeps status flags across a return. An edge move may sit between a
// compare and its branch, so `xEmitImmMove` stays flag-free.
fn xEmitMultiWordRet(cx: XCtx, vals: []int) {
  let classes = []RegClass(0)
  let i = 0
  while (i < len(vals)) {
    classes = append(classes, xValueClass(cx, vals[i]))
    i = i + 1
  }
  let regs = xRetRegsFor(cx.cc, classes)
  let moves = []PMove(0)
  let zeros = []int(0)
  i = 0
  while (i < len(vals)) {
    let src = xRetWordSrc(cx, vals[i], classes[i])
    if (src.isImm && src.v == 0 && classes[i] == RegClass.Int) {
      zeros = append(zeros, regs[i])
    } else {
      moves = append(moves, PMove{ src = src, dst = plocReg(regs[i], classes[i]) })
    }
    i = i + 1
  }
  xSequentializeAndEmit(cx, moves)
  for r of zeros {
    xZero32(cx.buf, xRegOf(r))
  }
}

// #6696: the x86-64 twin of `retWordSrc` (arm64call.bit). A constant word whose
// definition was skipped (`countRetConstFolds`) is written straight into its
// return register, so `return v, nil` no longer zeroes rax only to move it out.
fn xRetWordSrc(cx: XCtx, v: int, regClass: RegClass): PLoc {
  let ins = cx.f.instrs[v]
  if (opIsFoldConst(ins.op) && cx.skipConst[v]) {
    return plocImm(constIntValue(ins), regClass)
  }
  return xPlocOf(cx, v, regClass)
}

// #7716: zeroes the dead heap-word callee-saved registers the instruction at
// `i` owes (regallocclear.bit), only those the prologue saves. An `xor`, except
// before a `br` reading a fused compare's flags (#7732's loop-entry clear),
// where a `mov` leaves them intact (#7733).
fn xEmitRegClears(cx: XCtx, i: int) {
  let mask = regClearsAt(cx.alloc, i)
  let keepFlags = mask != 0 && xFlagsLiveAt(cx, i)
  let r = 0
  while (mask != 0 && r < len(cx.intRegs)) {
    if (((mask >> r) & 1) == 1 && xRegListHas(cx.frame.savedGpr, cx.intRegs[r])) {
      xZeroKeeping(cx.buf, cx.intRegs[r], keepFlags)
    }
    r = r + 1
  }
}

// The instruction at `i` reads flags an earlier one set: a `br` on the fused
// compare right before it (`xBrFusesCmp`), the only such reader.
fn xFlagsLiveAt(cx: XCtx, i: int): bool {
  let ins = cx.f.instrs[i]
  return ins.op == Op.Br && xBrFusesCmp(cx, i, ins.lhs)
}

fn xZeroKeeping(b: X64Buf, r: XReg64, keepFlags: bool) {
  if (keepFlags) {
    xMovRI(b, r, 0)
    return
  }
  xZero32(b, r)
}
