// Self-host Stage 3 (#1346): the x86-64 backend, control-flow lowering and
// the inlined back-edge safepoint poll. Split out of compiler/x64call.bit
// (#3365, to keep it under the 800-line limit); same module, so nothing here
// is imported.

// A block's params are written by each predecessor's edge move — all at once,
// as ONE parallel move covering both classes (#3182), because a param may
// still be READ as another param's source in the same edge, and an int and a
// float move here can share a spill-slot number (#3168) — splitting this into
// two independently-ordered calls is what let that alias silently.
fn xEmitParamMoves(cx: XCtx, target: int, args: []int) {
  let blk = cx.f.blocks[target]
  let moves = []PMove(0)
  let p = 0
  while (p < blk.paramCount) {
    let paramVal = blk.instsStart + p
    let regClass = xValueClass(cx, paramVal)
    moves = append(
      moves,
      PMove{ src: xPlocOf(cx, args[p], regClass), dst: xPlocOf(cx, paramVal, regClass) },
    )
    p = p + 1
  }
  xSequentializeAndEmit(cx, moves)
}

// Binds the incoming argument registers into the entry block's param vregs — the
// mirror of xEmitParamMoves, with the ABI argument registers as sources instead
// of another block's values. Without it the entry params hold whatever the
// allocator left in their registers, so every function that reads its own
// parameters returns garbage. Emitted right after the prologue, whose only
// register writes are callee-saved GPRs and rbp/rsp — never an argument register
// — so the incoming values are still live.
fn xBindIncomingArgs(cx: XCtx) {
  let entry = cx.f.blocks[0]
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let intOrdinal = 0
  let floatOrdinal = 0
  let stackIndex = 0
  let p = 0
  while (p < entry.paramCount) {
    let paramVal = entry.instsStart + p
    let regClass = xValueClass(cx, paramVal)
    let ordinal = intOrdinal
    if (regClass == RegClass.Float) {
      ordinal = floatOrdinal
    }
    let dst = xPlocOf(cx, paramVal, regClass)
    let reg = xArgReg(cx.cc, regClass, p, ordinal)
    // The mirror of xMarshalArgs (compiler/x64call.bit): the first six int /
    // eight float params arrive in the ABI registers; the rest were pushed by
    // the caller and now sit just above the saved rbp and return address, at
    // [rbp+16], [rbp+24], … in argument order for SysV (a non-register PLoc
    // reads rbp-relative). Win64 additionally interposes the CALLER's 32-byte
    // shadow space between the return address and the outgoing stack args
    // (xEmitCallLike, compiler/x64call.bit), so there the first stack arg is
    // at [rbp+48]; xShadowSpace is 0 on SysV, so that target is unaffected.
    let src = plocReg(reg, regClass)
    if (reg < 0) {
      src = plocMem(16 + xShadowSpace(cx.cc) + 8 * stackIndex, regClass)
      stackIndex = stackIndex + 1
    }
    moves = append(moves, PMove{ src: src, dst: dst })
    if (regClass == RegClass.Int) {
      intOrdinal = intOrdinal + 1
    } else {
      floatOrdinal = floatOrdinal + 1
    }
    p = p + 1
  }
  xSequentializeAndEmit(cx, moves)
}

// #2921 (arm64) / #2926 (x64): the naked shim's full chain (five stack frames,
// see runtime/stw/stwpoll.bit) is only needed when a stop is pending or a
// collection is due — both rare. #2926 guarded it behind a call to
// `bit_rt_safepoint_needed`; #3169 inlines that call's own condition instead
// (xEmitInlinedPollGuard), porting what #2925 did on arm64 — see
// compiler/arm64call.bit's header there for why a call, even to a true leaf,
// remained ~0.50s of collatz's 0.86s. This file's comment claimed parity with
// arm64 for the month between #2925 and #3169 and was false for all of it.
//
// The safepoint bookkeeping is unchanged by either move: only the real poll
// passes isSafepoint=true to xEmitCallLike, so exactly one nextSafepointIdx
// advance happens per back edge — which is what buildIntervals
// (compiler/codegen.bit) recorded for that edge, independent of how many
// machine instructions this emits.
fn xEmitBackEdgeSafepointIfNeeded(cx: XCtx, curBlock: int, target: int) {
  // §10.3.1: a @naked/@nosplit function polls no safepoint on its back-edges.
  if (!isBackEdge(curBlock, target) || needsNoSafepoints(cx.f)) {
    return
  }
  xEmitInlinedPollGuard(cx)
}

// ---------------------------------------------------------------------------
// #3169: the poll guard's condition, inlined at the call site
// ---------------------------------------------------------------------------

// The three cached poll addresses sit at the TOP of the spill area, in the
// slots xCompileFunction carves ABOVE the ones the register allocator asked
// for. Reusing the spill area rather than adding a frame region keeps
// x64frame.bit's layout comment ("then spill slots, then saved XMMs") true as
// written and needs no new XFrame field — and it keeps these raw runtime
// addresses out of every stack map, because xCompileFunction builds a
// SafepointView's `slots` only from the indices the ALLOCATOR reports, which
// never reach this high. A GC that walked them would try to trace the World,
// GC and scheduler module-state addresses as managed objects.
fn xPollCacheOffset(f: XFrame, i: int): int {
  // Sized by xCompileFunction on the same hasBackEdgeSafepoint predicate that
  // gates every caller here, so a frame reaching this point always has all
  // three. Asserted rather than assumed: a silently negative index would
  // address the CALLER's frame.
  assert(f.numSpillSlots >= 3 && i >= 0 && i < 3)
  return xSpillOffset(f, f.numSpillSlots - 3 + i)
}

// Fetches (worldAddr, gcAddr, preemptAnyAddr) ONCE per function invocation into
// those slots, rather than once per loop iteration. Safe because runtime/stw/stw.bit's
// stwBind runs exactly once at boot — before any compiled Bit function's entry
// can execute — and never unbinds (#2184): the two addresses are a per-process
// constant for the entire lifetime of every function this backend compiles, so
// re-fetching them on every iteration (what a per-iteration call would do)
// buys nothing.
//
// Emitted right after xBindIncomingArgs: the incoming args are already off
// rdi..r9 by then, so these calls' ordinary caller-saved clobber is harmless to
// the INT file — every int vreg in a function that polls a back edge lives in a
// callee-saved register or a spill slot already (xBuildIntRegs under
// hasSafepoints).
//
// The FLOAT file is no longer covered by that argument (#3171): xBuildFloatRegs
// now hands out xmm0..xmm13 in such a function, and under SysV none of them
// survives a call. What covers it instead is that these two calls are named as a
// clobber point in their own right — xClobberPoints (compiler/x64frame.bit)
// reports the entry block's first non-parameter instruction index, which is
// exactly this program point — so any parameter still read afterwards is
// allocated as live-across and never sits in an xmm here. Deleting that entry
// would silently destroy a float parameter, and no stack map would notice: the
// collector never sees float locations at all.
//
// bit_rt_world_addr/bit_rt_gc_addr/bit_rt_port_sched_preempt_any_addr are
// themselves true leaves that never allocate or park, so — like the #2926
// guard call they replace at the call site — none is recorded as a
// safepoint.
fn xEmitPollCachePrefetch(cx: XCtx) {
  if (!hasBackEdgeSafepoint(cx.f)) {
    return
  }
  xEmitCallLike(cx, worldAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), XReg64.Rax, 8)
  xEmitCallLike(cx, gcAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), XReg64.Rax, 8)
  // #3746: the preempt summary word's address, on the same terms as the two
  // above and for the same reason — a fixed module global in
  // runtime/sched/preempt.bit, so its ADDRESS is a per-process constant even
  // though the word it points at changes. One extra call per function ENTRY,
  // against the two per loop ITERATION it is here to remove. Clause for clause
  // with arm64's emitPollCachePrefetch, as this whole ladder must stay.
  xEmitCallLike(cx, preemptAnyAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 2)), XReg64.Rax, 8)
}

// ---------------------------------------------------------------------------
// #3565: the worker-preempt clause, split out of xEmitInlinedPollGuard below
// ---------------------------------------------------------------------------
//
// Mirrors stwPollNeeded's clause 3 (runtime/stw/stwpoll.bit, added by #3560):
//   let worker = schedCurrentWorker()
//   if (worker != 0) {
//     let workerId = *(taskAt(worker) + wkId)
//     if (preemptRequested(workerId)) { return true }
//   }
//
// The word offset (wkId) and the two runtime symbol names below are kept
// LOCAL to this file rather than joining pgWorldStopWordWord() etc. in
// compiler/codegen.bit: that file and compiler/arm64call.bit (the arm64
// mirror of this exact clause) were both being edited concurrently by #3564
// at the time this landed, and adding to a file two in-flight branches would
// both touch risks a same-module duplicate declaration neither branch can see
// coming (E0042). Reported on #3565's ticket as a follow-up consolidation
// once both land, not merged here.
fn xPreemptWkIdWord(): int { return 22 } // runtime/sched/worker.bit wkId
fn xSchedCurrentWorkerSymbol(): string { return "bit_rt_port_sched_current_worker" }
fn xPreemptRequestedSymbol(): string { return "bit_rt_port_sched_preempt_requested" }

// `schedCurrentWorker`/`preemptRequested` are real cross-module calls, not
// leaves (schedCurrentWorker walks a stack-tag table), so when this clause
// reaches them it pays two real `call`s where every other clause in the ladder
// is a plain load+compare -- the cost stwPollNeeded's own header documents for
// the reference function this mirrors.
//
// #3746 MOVED THEM OFF THE FAST PATH. #3565 (mirroring #3564) ran them on every
// guard evaluation; measured on arm64, the identical arm64 clause cost 3.28x on
// bench/cases/collatz and 2.36x on matrix. They now run only behind the summary
// load below. THIS BOX IS arm64 AND THE x64 NUMBER IS UNMEASURED -- the two
// ladders are required to stay clause-for-clause identical, so this change
// lands here on that contract, not on an x64 measurement.
//
// `worker == 0` (off-task) and `!preemptRequested(...)` both just fall
// through to the ladder's next clause, exactly like every other check here --
// this clause can only ever COMMIT to "poll", appending to `pollFixups`,
// never to "skip". `pollFixups` is threaded in and back out rather than
// mutated in place: `append` may reallocate its backing array, so the
// caller's own binding must be reassigned to the returned slice, the same
// rule every other `pollFixups = append(...)` call in this file already
// follows.
//
// The workerId load reads `[worker + wkId*8]` directly rather than
// replaying the runtime's `taskAt` shift-then-add: `worker` is a
// word-aligned raw address (taskAt's own comment, runtime/sched/task.bit), so
// `(worker >> 3) * 8 == worker` exactly, and `[worker + wkId*8]` IS
// `*(taskAt(worker) + wkId)` -- the same base+offset idiom every other field
// load in this ladder already uses (e.g. pgWorldStopWordWord() above it).
//
// preemptRequested's argument is a raw computed value, not an IR value
// xEmitCallLike's arg marshaller can see (xMarshalArgs indexes cx.f.instrs),
// so it is moved into xArg0(cx.cc) by hand -- the same manual-argument
// pattern xEmitCallValue (x64call.bit) already uses for its own indirect
// call. xArg0 is the one function in this file that already knows Win64
// (rcx) differs from SysV (rdi); using it here rather than a hardcoded
// register is what keeps this correct on both, unlike #3503/#3554.
fn xEmitPreemptClause(cx: XCtx, rTmp: XReg64, pollFixups: []int): []int {
  // #3746: THE FAST-PATH GATE, clause for clause with arm64's
  // emitInlinedPreemptCheck. Three leaf instructions — a frame load of the
  // cached address, a load of the summary word (a plain `mov` IS the acquire
  // load under x86-64 TSO, the same fact the ladder's other two atomic reads
  // already rely on), a test and a branch — decide whether this back edge
  // spends the two calls below at all. Correctness rests on ONE invariant,
  // proven where the word is declared (runtime/sched/preempt.bit): a set flag
  // implies a nonzero summary. A false positive costs one slow evaluation; a
  // false negative cannot occur.
  xMovLoad(cx.buf, rTmp, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 2)), 8, false)
  xMovLoad(cx.buf, rTmp, xMemB(rTmp, 0), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  let noneSkip = xJccRel32Placeholder(cx, ccE()) // nothing pending anywhere

  xEmitCallLike(cx, xSchedCurrentWorkerSymbol(), []int(0), false, 0, 0, false)
  xMovRR(cx.buf, rTmp, XReg64.Rax) // rTmp = worker (0 off-task)
  xTestRR(cx.buf, rTmp, rTmp)
  let workerSkip = xJccRel32Placeholder(cx, ccE())

  xMovLoad(cx.buf, rTmp, xMemB(rTmp, xPreemptWkIdWord() * 8), 8, false) // rTmp = workerId
  xMovRR(cx.buf, xArg0(cx.cc), rTmp)                                    // workerId -> arg0
  let shadow = xShadowSpace(cx.cc)
  if (shadow > 0) {
    xRspAddSub(cx.buf, true, shadow)
  }
  xCallReloc(cx, xPreemptRequestedSymbol())
  if (shadow > 0) {
    xRspAddSub(cx.buf, false, shadow)
  }
  // The C ABI leaves a bool return's upper bits unspecified (xTakeCallResult's
  // own rule, x64call.bit) -- normalize before testing the full register.
  xMovzxb(cx.buf, XReg64.Rax, XReg64.Rax)
  xTestRR(cx.buf, XReg64.Rax, XReg64.Rax)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccNe()))
  // Both no-op exits — off-task, and the #3746 fast-path gate — converge here,
  // at the ladder's next clause, exactly as stwPollNeeded's own
  // `if (worker != 0) { ... }` falls through, and exactly as arm64's mirror
  // patches its own two.
  xPatchRel32Here(cx, workerSkip)
  xPatchRel32Here(cx, noneSkip)
  return pollFixups
}

// The inlined equivalent of `stwPollNeeded` (runtime/stw/stwpoll.bit), clause
// for clause. compiler/arm64call.bit's emitInlinedPollGuard quotes that
// predicate in full and holds the rationale for the object half (#3359, whose
// omission here cost `matrix` 168.5 G instructions); this ladder emits the
// SAME clauses in the SAME order.
//
// `true` (poll needed) falls into the real `call bit_rt_safepoint`; `false`
// (skip) branches past it. Each of the runtime's two `atomicLoad`s is a PLAIN
// `mov` here and that is not a weakening: an ordinary x86-64 load already has
// acquire semantics under TSO, which is the same fact xEmitAtomicLoad
// (x64selectmem.bit) relies on for Op.AtomicLoad itself. arm64 needs `ldar`.
//
// Two scratch registers cover the whole ladder — r11 rotates through waddr and
// then each loaded field, r10 holds the cached gcAddr from its load until the
// final compare. Both are caller-saved in BOTH conventions and neither is an
// argument register in either, and no vreg can live in them (they are outside
// xMasterGprs), so nothing live across the back edge is at risk. r12
// (xScratch3) is deliberately not used: it is callee-saved under SysV.
//
// #3565: the worker-preempt clause (stwPollNeeded's clause 3, added by #3560)
// can pay two real `call`s -- `schedCurrentWorker`/`preemptRequested` are not
// leaves, unlike every other check in this ladder, though since #3746 it only
// reaches them when a preempt really is pending somewhere. That is SAFE against the
// register file this function's caller (xBuildIntRegs, compiler/x64frame.bit)
// already picked: any function with a back-edge safepoint restricts its WHOLE
// int register file to the callee-saved subset for its entire body, not just
// around the one call this ladder used to make, so no live vreg can ever
// occupy a register either new call clobbers, exactly like the existing
// scratch pair's own reasoning above. xClobberPoints (x64frame.bit) treats
// this whole back-edge lowering as ONE clobber point for the float file too,
// so the same holds for any xmm live across it. See xEmitPreemptClause for
// the clause itself.
fn xEmitInlinedPollGuard(cx: XCtx) {
  let rTmp = xScratch1() // r11: waddr, then every loaded field in turn
  let rGc = xScratch2()  // r10: the cached gcAddr, live to the last compare
  let pollFixups = []int(0)
  let skipFixups = []int(0)

  // waddr == 0 -> poll
  xMovLoad(cx.buf, rTmp, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccE()))

  // a stop is pending -> poll
  xMovLoad(cx.buf, rTmp, xMemB(rTmp, pgWorldStopWordWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccNe()))

  // a preempt is pending for THIS worker -> poll (#3560's clause 3, mirrored;
  // see xEmitPreemptClause). Before the GC-only checks below, same as the
  // runtime function, since preemption must work even with GC disabled.
  pollFixups = xEmitPreemptClause(cx, rTmp, pollFixups)

  // gcAddr == 0 -> poll
  xMovLoad(cx.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), 8, false)
  xTestRR(cx.buf, rGc, rGc)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccE()))

  // stress mode -> poll
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcCfgStressWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccNe()))

  // disabled -> skip (the one early-false; every exit above is early-true)
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcCfgEnabledWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccE()))

  // heapLive >= gcNextBytes -> poll, else skip. SIGNED, matching the runtime's
  // own `>=` on two i64s.
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcHeapAddrWord() * 8), 8, false)    // heap base
  xMovLoad(cx.buf, rTmp, xMemB(rTmp, pgHeapLiveWordWord() * 8), 8, false) // live bytes
  xMovLoad(cx.buf, rGc, xMemB(rGc, pgGcNextBytesWord() * 8), 8, false)    // trigger
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccL()))

  // The object half (#3292/#3359), same steps and order as arm64. Signed, like
  // the runtime's `>=`; `live - next >= next` IS `live >= next * 2` without
  // overflow; the object compare falls THROUGH to the poll.
  xArithRR(cx.buf, XArith.Sub, rTmp, rGc) // live - next
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccGe()))                 // 2x -> poll
  xMovLoad(cx.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), 8, false) // gcAddr again
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcNumObjectsIdxWord() * 8), 8, false)         // live objects
  xMovLoad(cx.buf, rGc, xMemB(rGc, pgGcNextObjectsWord() * 8), 8, false)            // object trigger
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccL())) // not caught up -> skip

  let i = 0
  while (i < len(pollFixups)) {
    xPatchRel32Here(cx, pollFixups[i])
    i = i + 1
  }
  xEmitCallLike(cx, safepointSymbol(), []int(0), false, 0, 0, true)
  i = 0
  while (i < len(skipFixups)) {
    xPatchRel32Here(cx, skipFixups[i])
    i = i + 1
  }
}

// A back-edge polls the collector BEFORE the edge moves: the poll is a call, and
// the moves may leave a param mid-write.
fn xEmitJump(cx: XCtx, target: int, args: []int) {
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, target)
  xEmitParamMoves(cx, target, args)
  xJmpRel32(cx, target)
}

fn xEmitBr(
  cx: XCtx, cond: int, thenBlk: int, thenArgs: []int, elseBlk: int,
  elseArgs: []int,
) {
  let c = xGetInt(cx, cond, xScratch1())
  xTestRR(cx.buf, c, c)
  // Jump over the then-path when the condition is ZERO. The edge moves must sit
  // on their own side of this branch — emitting them before it would run the
  // then-edge's moves on the else path too.
  let skipOff = xJccRel32Placeholder(cx, ccE())
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, thenBlk)
  xEmitParamMoves(cx, thenBlk, thenArgs)
  xJmpRel32(cx, thenBlk)
  xPatchRel32Here(cx, skipOff)
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, elseBlk)
  xEmitParamMoves(cx, elseBlk, elseArgs)
  xJmpRel32(cx, elseBlk)
}

// A multi-value ret is out of scope — codegen has not settled a packing.
fn xEmitRet(cx: XCtx, vals: []int): bool {
  if (len(vals) > 1) {
    return false
  }
  if (len(vals) == 1) {
    let v = vals[0]
    if (xValueClass(cx, v) == RegClass.Float) {
      let r = xGetFloat(cx, v, xFScratch1())
      xMovFRR(cx.buf, XmmReg.Xmm0, r, widthOf(cx.ctx, cx.f.instrs[v].ty).bytes)
    } else {
      let r = xGetInt(cx, v, xScratch1())
      xMovRR(cx.buf, XReg64.Rax, r)
    }
  }
  // §10.3.1 @naked: no epilogue teardown — the value is already in rax/xmm0;
  // emit only the raw `ret`.
  if (!cx.f.isNaked) {
    xEmitEpilogue(cx)
  }
  xRet(cx.buf)
  return true
}
