// Self-host Stage 2 (#1337): the type universe, ported from compiler/check.zig's
// TypeContext + describeType. A TypeId is an index into the context's `types`
// array. Bit has no tagged unions, so a Type is a struct with a `kind` tag and
// per-kind fields (only those the kind uses are meaningful). This is the
// foundation the checker's inference produces and `--dump-types` renders.

// The type-data discriminant (the seed's TypeData union tags).
enum TypeKind {
  Invalid,
  Void,
  UntypedInt,
  UntypedFloat,
  UntypedRune,
  UntypedBool,
  UntypedString,
  UntypedNil,
  Prim,
  Slice,
  Array,
  Map,
  Tuple,
  Func,
  Chan,
  Struct,
  Interface,
  TypeParam,
  Enum,
  Fallible,
  // A raw, untraced pointer `*T` (§11.4): a single word the GC never follows
  // (unlike every other reference type). Reuses the `elem` field for the
  // pointee type. Codegen classifies it is_ref=0.
  Ptr,
}

// The primitive scalar names (spec §15), indexed by the seed's Prim enum order.
function primName(prim: int): string {
  let names = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "string"]
  return names[prim]
}

// A type. `kind` selects which fields matter: Prim→prim; Slice/Chan/Array→elem
// (+arrayLen); Map→mapKey/mapVal; Tuple/Func→members (Func also result/variadic);
// Fallible→result(ok)/errTy; Struct/Interface/Enum/TypeParam→name (hasName marks
// a resolved display name). The full field/method/variant tables attach when
// inference lands; the renderer needs only the name.
struct Type {
  kind: TypeKind,
  prim: int,
  elem: int,
  arrayLen: int,
  mapKey: int,
  mapVal: int,
  members: []int,
  variadic: bool,
  result: int,
  errTy: int,
  name: string,
  hasName: bool,
  // Enum only: whether any variant carries a payload, so the value is a boxed
  // {tag, payloadPtr} object rather than a bare tag word (the seed's
  // `check.enumBoxed`). Codegen classifies GC references from the TypeContext
  // alone, so this must live on the type; not rendered by any dump, and never
  // compared by `compositeEq` (enums are named, not interned composites).
  enumBoxed: bool,
  // Named types (struct / enum / interface) only: the id of the module that
  // DECLARES this type, or -1. Field offsets, variant ordinals and payload types
  // are all read back from the decl NODE, and a node index only means something
  // in its own tree (the declOwner rule) — so an importer must resolve this
  // module's Checker before any such lookup. Recorded here rather than derived
  // from the name because a name cannot identify a module: an import may alias
  // it, and two modules may each declare a `Point`. Like `enumBoxed`: not
  // rendered by any dump, never compared by `compositeEq` (these types are
  // named, not interned composites).
  declModule: int,
}

// One nominal type instantiation: the module DECLARING the generic, its base
// name, the concrete type arguments in order, and the reserved TypeId standing
// for `Name<args>`. `result` doubles as the reverse map the seed keeps in
// `inst_by_result` — a linear scan over a handful of entries, matching how
// `instantiationIndexIn` already searches the function ledger.
struct TypeInst {
  module: int,
  name: string,
  args: []int,
  result: int,
}

// The interned type table plus the well-known ids seeded at init.
struct TypeContext {
  types: []Type,
  voidId: int,
  untypedIntId: int,
  untypedFloatId: int,
  untypedRuneId: int,
  untypedBoolId: int,
  untypedStringId: int,
  untypedNilId: int,
  primIds: []int,
  errorId: int,
  // A named type's members, shared across every module (#1345). These belong to
  // the TYPE, not to whichever module imported it: `newSha256()` can be imported
  // on its own, and `h.write()` must still resolve even though nothing imported
  // `Sha256` by name. Keyed "<typeId>.<member>" — by ID, not by name, because two
  // modules may each declare a `Point` and their members must not collide.
  // Mirrors the seed's TypeContext.method_sets, which is likewise TypeId-keyed.
  methodResults: map<string, int>,
  methodSigs: map<string, int>,
  structFields: map<string, int>,
  // An enum variant's payload types, keyed "<typeId>.<variant>" and stored
  // ALREADY SUBSTITUTED for an instantiation (#1560). This is what makes
  // `Opt<i64>` and `Opt<string>` answer i64 and string for `Some`, instead of
  // every match site re-deriving the enum's type arguments from the AST.
  // Keyed by ID for the same reason `structFields` is: two modules may each
  // declare an `Opt`. Only variants that CARRY a payload are recorded, so a
  // missing key and an empty payload are the same answer and need no sentinel.
  variantPayloads: map<string, []int>,
  // Generic-function instantiations discovered at call sites, in discovery
  // order — PROJECT-wide, like the seed's ctx.instantiations. Each records the
  // module that DECLARES the generic, so an instance is numbered once and
  // emitted once no matter how many modules call it. A per-module ledger would
  // number an imported generic in the caller and emit it in the callee, under
  // two different names.
  instantiations: []Instantiation,
  // Nominal TYPE instantiations — `Stack<i64>` and `Stack<string>` are two
  // distinct named types, not one. The seed's `ctx.instantiations` +
  // `inst_by_result` for struct/enum/interface, kept in its own ledger because
  // bit's `instantiations` above records generic FUNCTIONS only (its index is a
  // `$n` symbol suffix, so a type must not consume one). Each entry's `result`
  // is a reserved TypeId carrying the BASE name, which is why `--dump-types`
  // (name-keyed) is blind to this and stays byte-identical.
  typeInsts: []TypeInst,
  // A named type's method names in registration order, keyed by "<typeId>".
  // `methodResults`/`methodSigs` are keyed "<typeId>.<member>" and a map cannot
  // be asked which members a type has, so instantiating one needs this list to
  // know what to copy.
  typeMethodNames: map<string, []string>,
  // §11.9: pinned symbol name -> the packed identity of the decl that claimed
  // it. PROJECT-wide, like the seed's TypeContext.pinned_symbols: a pin names a
  // link-level symbol, and the linker sees every module at once, so two modules
  // pinning one name must collide even though neither can see the other. The
  // value is what makes a re-check idempotent — `checkModule` runs more than
  // once over the same tree on some paths, and re-registering the SAME decl is
  // not a duplicate.
  pinnedSymbols: map<string, int>,
  // Whether a concrete method carries `export`, keyed "<typeId>.<member>" (only
  // `true` is recorded; a missing key means private). A method set holds a
  // type's PRIVATE methods too — interface satisfaction needs them — and those
  // are no part of a module's public surface, so `bit doc` filters on this
  // (`compiler/doc.bit`). Mirrors the seed's `Method.exported`. Carried onto
  // instantiations by `copyInstMethod`, so an exported method survives an alias
  // of a generic instance (#1528). Read only by doc; never by lowering, so it
  // does not perturb any --dump-* surface.
  methodExported: map<string, bool>,
}

// A leaf type (no sub-parts) of the given kind.
function leafType(kind: TypeKind): Type {
  return Type{ kind: kind, prim: 0, elem: 0, arrayLen: 0, mapKey: 0, mapVal: 0,
    members: []int(0), variadic: false, result: 0, errTy: 0, name: "", hasName: false,
    enumBoxed: false, declModule: -1 }
}

// Appends `t` and returns its TypeId (no dedup — named types are one-per-decl).
function addType(ctx: TypeContext, t: Type): int {
  let id = len(ctx.types)
  ctx.types = append(ctx.types, t)
  return id
}

// True when two int lists are element-wise equal.
function intListEq(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Structural equality of two composite types (by their already-interned field
// ids — matches the seed's `intern` dedup, where TypeId equality is identity).
function compositeEq(a: Type, b: Type): bool {
  if (a.kind != b.kind) {
    return false
  }
  let k = a.kind
  if (k == TypeKind.Slice || k == TypeKind.Chan || k == TypeKind.Ptr) {
    return a.elem == b.elem
  }
  if (k == TypeKind.Array) {
    return a.arrayLen == b.arrayLen && a.elem == b.elem
  }
  if (k == TypeKind.Map) {
    return a.mapKey == b.mapKey && a.mapVal == b.mapVal
  }
  if (k == TypeKind.Tuple) {
    return intListEq(a.members, b.members)
  }
  if (k == TypeKind.Func) {
    return a.variadic == b.variadic && a.result == b.result && intListEq(a.members, b.members)
  }
  if (k == TypeKind.Fallible) {
    return a.result == b.result && a.errTy == b.errTy
  }
  return false
}

// Interns a composite type: reuses a structurally-identical existing id, else
// appends. The seed dedups all composites (`[]byte` referenced N× = one id at its
// first-touch position), which the touch-order type-id assignment relies on.
// ponytail: linear scan — a module has a few hundred types, O(n²) is negligible.
function internComposite(ctx: TypeContext, t: Type): int {
  let i = 0
  while (i < len(ctx.types)) {
    if (compositeEq(ctx.types[i], t)) {
      return i
    }
    i = i + 1
  }
  return addType(ctx, t)
}

// Seeds the context in the seed's exact order (invalid=0, void=1, untyped 2..7,
// prims 8..19, error=20) so well-known ids agree, then records the handles.
function newTypeContext(): TypeContext {
  let ctx = TypeContext{ types: []Type(0), voidId: 0, untypedIntId: 0, untypedFloatId: 0,
    untypedRuneId: 0, untypedBoolId: 0, untypedStringId: 0, untypedNilId: 0,
    primIds: []int(0), errorId: 0, methodResults: map<string, int>{},
    methodSigs: map<string, int>{}, structFields: map<string, int>{},
    variantPayloads: map<string, []int>{},
    instantiations: []Instantiation(0), typeInsts: []TypeInst(0),
    typeMethodNames: map<string, []string>{}, pinnedSymbols: map<string, int>{},
    methodExported: map<string, bool>{} }
  addType(ctx, leafType(TypeKind.Invalid))
  ctx.voidId = addType(ctx, leafType(TypeKind.Void))
  ctx.untypedIntId = addType(ctx, leafType(TypeKind.UntypedInt))
  ctx.untypedFloatId = addType(ctx, leafType(TypeKind.UntypedFloat))
  ctx.untypedRuneId = addType(ctx, leafType(TypeKind.UntypedRune))
  ctx.untypedBoolId = addType(ctx, leafType(TypeKind.UntypedBool))
  ctx.untypedStringId = addType(ctx, leafType(TypeKind.UntypedString))
  ctx.untypedNilId = addType(ctx, leafType(TypeKind.UntypedNil))
  let p = 0
  while (p < 12) {
    let t = leafType(TypeKind.Prim)
    t.prim = p
    ctx.primIds = append(ctx.primIds, addType(ctx, t))
    p = p + 1
  }
  // The predeclared `error` interface (a single `message(): string` method).
  // Only its display name matters to the renderer.
  let e = leafType(TypeKind.Interface)
  e.name = "error"
  e.hasName = true
  ctx.errorId = addType(ctx, e)
  return ctx
}

function primType(ctx: TypeContext, prim: int): int {
  return ctx.primIds[prim]
}

function mkSlice(ctx: TypeContext, elem: int): int {
  let t = leafType(TypeKind.Slice)
  t.elem = elem
  return internComposite(ctx, t)
}

function mkChan(ctx: TypeContext, elem: int): int {
  let t = leafType(TypeKind.Chan)
  t.elem = elem
  return internComposite(ctx, t)
}

// The raw untraced pointer `*T` (§11.4).
function mkPtr(ctx: TypeContext, elem: int): int {
  let t = leafType(TypeKind.Ptr)
  t.elem = elem
  return internComposite(ctx, t)
}

function mkArray(ctx: TypeContext, n: int, elem: int): int {
  let t = leafType(TypeKind.Array)
  t.arrayLen = n
  t.elem = elem
  return internComposite(ctx, t)
}

function mkMap(ctx: TypeContext, key: int, val: int): int {
  let t = leafType(TypeKind.Map)
  t.mapKey = key
  t.mapVal = val
  return internComposite(ctx, t)
}

function mkTuple(ctx: TypeContext, members: []int): int {
  let t = leafType(TypeKind.Tuple)
  t.members = members
  return internComposite(ctx, t)
}

function mkFunc(ctx: TypeContext, params: []int, variadic: bool, result: int): int {
  let t = leafType(TypeKind.Func)
  t.members = params
  t.variadic = variadic
  t.result = result
  return internComposite(ctx, t)
}

// A generic instantiation's bindings: `params[i]` (a TypeParam's TypeId) stands
// for `args[i]` (a concrete TypeId). Keyed by TypeId, not by name — two generics
// may each declare a `T`, and only the id tells them apart.
struct TypeEnv {
  params: []int,
  args: []int,
}

function emptyTypeEnv(): TypeEnv {
  return TypeEnv{ params: []int(0), args: []int(0) }
}

// The binding for TypeParam `ty`, or 0 when this env does not bind it. No real
// type interns at id 0, so 0 is an unambiguous miss.
function typeEnvLookup(env: TypeEnv, ty: int): int {
  let i = 0
  while (i < len(env.params)) {
    if (env.params[i] == ty) {
      return env.args[i]
    }
    i = i + 1
  }
  return 0
}

// A self-referential type (a generic struct whose field mentions itself) would
// otherwise recurse forever; the seed bounds the same walk.
function maxTypeDepth(): int {
  return 64
}

// Rebuilds `ty` with every TypeParam leaf bound in `env` replaced by its binding
// (SPEC §13.6), returning `ty` unchanged when nothing in it needs substituting.
//
// A generic function's body is type-checked exactly ONCE, against its own
// template's unbound type-param ids. To lower one concrete monomorphization,
// lowering re-derives each body node's CONCRETE type by calling this with that
// instantiation's bindings: the checker's cached type for `out: []T` says `[]<T>`
// forever, and only this turns it into `[]i64`. Without it a slice of a type
// param is classified as holding GC references (isRefType is true for every
// non-prim), so `slice_new` is handed is_ref=1 and the collector walks raw
// integers as if they were pointers.
//
// A struct/enum/interface is re-instantiated rather than returned unchanged
// (#1540) — see `substNominal`. Only a NON-generic named type is inert.
function substType(c: Checker, ty: int, env: TypeEnv, depth: int): int {
  let ctx = c.ctx
  if (len(env.params) == 0 || depth >= maxTypeDepth()) {
    return ty
  }
  let k = ctx.types[ty].kind
  // A named struct/enum/interface is NOT inert under substitution (#1540): a
  // method's `Stack<T>` result must become `Stack<i64>` on the i64 instance, or
  // the call site names a mangled symbol no body was emitted for. The seed does
  // the same through `inst_by_result` -> `reinstantiate`.
  if (k == TypeKind.Struct || k == TypeKind.Enum || k == TypeKind.Interface) {
    return substNominal(c, ty, env, depth)
  }
  if (k == TypeKind.TypeParam) {
    let b = typeEnvLookup(env, ty)
    if (b != 0) {
      return b
    }
    return ty
  }
  // Every field is read out BEFORE any mk* call: those intern into `ctx.types`,
  // which may move its backing array and strand a struct still aliasing the old
  // one (see the append-aliasing rule).
  if (k == TypeKind.Slice) {
    let elem = ctx.types[ty].elem
    let ne = substType(c, elem, env, depth + 1)
    if (ne == elem) {
      return ty
    }
    return mkSlice(ctx, ne)
  }
  if (k == TypeKind.Chan) {
    let elem = ctx.types[ty].elem
    let ne = substType(c, elem, env, depth + 1)
    if (ne == elem) {
      return ty
    }
    return mkChan(ctx, ne)
  }
  if (k == TypeKind.Ptr) {
    let elem = ctx.types[ty].elem
    let ne = substType(c, elem, env, depth + 1)
    if (ne == elem) {
      return ty
    }
    return mkPtr(ctx, ne)
  }
  if (k == TypeKind.Array) {
    let elem = ctx.types[ty].elem
    let n = ctx.types[ty].arrayLen
    let ne = substType(c, elem, env, depth + 1)
    if (ne == elem) {
      return ty
    }
    return mkArray(ctx, n, ne)
  }
  if (k == TypeKind.Map) {
    let key = ctx.types[ty].mapKey
    let val = ctx.types[ty].mapVal
    let nk = substType(c, key, env, depth + 1)
    let nv = substType(c, val, env, depth + 1)
    if (nk == key && nv == val) {
      return ty
    }
    return mkMap(ctx, nk, nv)
  }
  if (k == TypeKind.Fallible) {
    let ok = ctx.types[ty].result
    let err = ctx.types[ty].errTy
    let nok = substType(c, ok, env, depth + 1)
    let nerr = substType(c, err, env, depth + 1)
    if (nok == ok && nerr == err) {
      return ty
    }
    return mkFallible(ctx, nok, nerr)
  }
  if (k == TypeKind.Tuple) {
    let members = ctx.types[ty].members
    let changed = false
    let buf = []int(0)
    let i = 0
    while (i < len(members)) {
      let nm = substType(c, members[i], env, depth + 1)
      if (nm != members[i]) {
        changed = true
      }
      buf = append(buf, nm)
      i = i + 1
    }
    if (!changed) {
      return ty
    }
    return mkTuple(ctx, buf)
  }
  if (k == TypeKind.Func) {
    let params = ctx.types[ty].members
    let result = ctx.types[ty].result
    let variadic = ctx.types[ty].variadic
    let changed = false
    let buf = []int(0)
    let i = 0
    while (i < len(params)) {
      let np = substType(c, params[i], env, depth + 1)
      if (np != params[i]) {
        changed = true
      }
      buf = append(buf, np)
      i = i + 1
    }
    let nr = substType(c, result, env, depth + 1)
    if (nr != result) {
      changed = true
    }
    if (!changed) {
      return ty
    }
    return mkFunc(ctx, buf, variadic, nr)
  }
  return ty
}

// `substType` over a list, element-wise.
function substTypeList(c: Checker, tys: []int, env: TypeEnv): []int {
  if (len(env.params) == 0) {
    return tys
  }
  let out = []int(0)
  let i = 0
  while (i < len(tys)) {
    out = append(out, substType(c, tys[i], env, 0))
    i = i + 1
  }
  return out
}

function mkFallible(ctx: TypeContext, ok: int, err: int): int {
  let t = leafType(TypeKind.Fallible)
  t.result = ok
  t.errTy = err
  return internComposite(ctx, t)
}

// Joins the member type names with ", " (tuple/func parameter lists).
function joinTypeNames(ctx: TypeContext, ids: []int, depth: int): string {
  let s = ""
  let i = 0
  while (i < len(ids)) {
    if (i != 0) {
      s = s + ", "
    }
    s = s + typeNameDepth(ctx, ids[i], depth + 1)
    i = i + 1
  }
  return s
}

// Renders a TypeId to its canonical name, matching the seed's appendTypeName
// byte-for-byte. Recursion is capped at depth 128 (→ "...").
function typeNameDepth(ctx: TypeContext, id: int, depth: int): string {
  if (depth >= 128) {
    return "..."
  }
  let t = ctx.types[id]
  let k = t.kind
  if (k == TypeKind.Invalid) { return "<error>" }
  if (k == TypeKind.Void) { return "()" }
  if (k == TypeKind.UntypedInt) { return "untyped int" }
  if (k == TypeKind.UntypedFloat) { return "untyped float" }
  if (k == TypeKind.UntypedRune) { return "untyped rune" }
  if (k == TypeKind.UntypedBool) { return "untyped bool" }
  if (k == TypeKind.UntypedString) { return "untyped string" }
  if (k == TypeKind.UntypedNil) { return "nil" }
  if (k == TypeKind.Prim) { return primName(t.prim) }
  if (k == TypeKind.Slice) { return "[]" + typeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Ptr) { return "*" + typeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Chan) { return "chan<" + typeNameDepth(ctx, t.elem, depth + 1) + ">" }
  if (k == TypeKind.Array) { return "[${t.arrayLen}]" + typeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Map) {
    return "map<" + typeNameDepth(ctx, t.mapKey, depth + 1) + ", " + typeNameDepth(ctx, t.mapVal, depth + 1) + ">"
  }
  if (k == TypeKind.Tuple) { return "(" + joinTypeNames(ctx, t.members, depth) + ")" }
  if (k == TypeKind.Func) {
    return "(" + joinTypeNames(ctx, t.members, depth) + ") => " + typeNameDepth(ctx, t.result, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    let s = typeNameDepth(ctx, t.result, depth + 1) + "!"
    if (t.errTy != ctx.errorId) {
      s = s + typeNameDepth(ctx, t.errTy, depth + 1)
    }
    return s
  }
  if (k == TypeKind.TypeParam) { return t.name }
  // Struct / Interface / Enum: the display name, or a placeholder.
  if (t.hasName) {
    return t.name
  }
  if (k == TypeKind.Struct) { return "struct{...}" }
  if (k == TypeKind.Enum) { return "enum{...}" }
  return "interface{...}"
}

function typeName(ctx: TypeContext, id: int): string {
  return typeNameDepth(ctx, id, 0)
}
