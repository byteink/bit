// compiler/pmclilist.bit — `bit list` (#2271): a flat, read-only view of the
// current project's DIRECT dependencies — name, the spec declared in
// bit.json, and the commit bit.lock resolved it to — one line each. The
// smallest of the four read-only views this ticket's title names; `bit
// tree`/`bit why` are deliberately left for a later ticket (see the ticket's
// own "Ask, smallest first" list) and are not built here.
//
// Same module as pmcliup.bit/pmcli.bit/projectpkg.bit: `projectDeps`,
// `DepSpecNamed` (its `rawSpec` field), `checkManifestExists`,
// `loadLockEntries`, `manifestLockProblem` and `pmIsHelpFlag` are all
// visible here unqualified — importing any of them again would be `E0042
// already declared in this scope`.

// `bit list [--help]`. No `--dir`, unlike `add`/`up`/`remove`: this reads
// bit.json/bit.lock and writes nothing, so scoping it to another directory
// can wait for a real need rather than growing the surface speculatively.
// Returns the process exit code: 2 on a usage error, 1 when there is no
// project here or bit.lock disagrees with bit.json (never a partial or
// misleading listing), 0 on success — zero dependencies is success with no
// output, exactly like `bit lint` on a clean tree.
fn listCmd(a: []string): int {
  if (len(a) > 2 && pmIsHelpFlag(a[2])) {
    print(pmListUsage)
    return 0
  }
  if (len(a) > 2) {
    eprint("bit list: unexpected argument '${a[2]}'\n")
    eprint(pmListUsage)
    return 2
  }

  let rootDir = "."
  // The same refusal `bit add`/`bit up`/`bit remove` give outside a project
  // (#2751) — a dependency query with no bit.json to query is a usage
  // error, not silent empty output.
  checkManifestExists(rootDir) catch e {
    eprint("bit list: ${e.message()}\n")
    return 1
  }

  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  if (lockErr != "") {
    // `lockErr` (readLock, pmlock.bit) already reads "bit.lock: malformed
    // JSON: <path>" — no second "bit.lock: " prefix here.
    eprint("bit list: ${lockErr}\n")
    return 1
  }
  // The same manifest-vs-lock guard `bit doc`/`bit check`/`bit build`
  // already run (#2254, projectpkg.bit's `manifestLockProblem`): a
  // dependency bit.json declares but bit.lock never locked, or one
  // bit.json re-pins to a commit bit.lock disagrees with, is refused here
  // rather than printed as if bit.lock's stale answer were still current.
  let problem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (problem != "") {
    eprint("bit list: ${problem}\n")
    return 1
  }

  let deps = projectDeps(rootDir) catch e {
    eprint("bit list: ${e.message()}\n")
    return 1
  }
  printListEntries(pmListSortDeps(deps), lockEntries)
  return 0
}

// Printed after `manifestLockProblem` already confirmed every `deps[i].name`
// has a `lockEntries` entry, so the lookup below always finds one — no
// "(unresolved)" placeholder branch to fall into or to leave untested.
fn printListEntries(deps: []DepSpecNamed, lockEntries: map<string, LockEntry>) {
  let i = 0
  while (i < len(deps)) {
    let (entry, _) = lockEntries[deps[i].name]
    print("${deps[i].name} -> ${deps[i].rawSpec} (${pmListCommitText(entry)})\n")
    i = i + 1
  }
}

// A local-path dependency (#2244) has no commit at all — `entry.commit` is
// "" for one (pmlock.bit's `LockEntry.localPath` doc comment) — so this
// prints "local" instead, the exact word `bit up`'s own confirmation line
// already uses for the same case (pmcliup.bit's `UpResult{ ..., commit:
// "local" }`), rather than a blank field that reads as a bug.
fn pmListCommitText(e: LockEntry): string {
  if (len(e.localPath) > 0) {
    return "local"
  }
  return e.commit
}

const pmListUsage = "usage: bit list\n" +
  "  Prints each of this project's direct dependencies: its name, the spec\n" +
  "  recorded in bit.json, and the commit bit.lock resolved it to. Fails if\n" +
  "  there is no bit.json here, or if bit.lock disagrees with it (run\n" +
  "  `bit add`/`bit up` to relock first).\n"

// Insertion sort by name, on a fresh copy — mirrors `lockSortEntries`
// (pmlock.bit): an alphabetic listing is easier to scan, and is stable
// across runs regardless of bit.json's own key order, unlike printing
// `deps` (jsoncParse's insertion order) as-is.
fn pmListSortDeps(xs: []DepSpecNamed): []DepSpecNamed {
  let out = []DepSpecNamed(0)
  let i = 0
  while (i < len(xs)) {
    out = append(out, xs[i])
    i = i + 1
  }
  i = 1
  while (i < len(out)) {
    let j = i
    while (j > 0 && compare(out[j - 1].name, out[j].name) > 0) {
      let tmp = out[j - 1]
      out[j - 1] = out[j]
      out[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
  return out
}
