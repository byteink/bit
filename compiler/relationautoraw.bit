// compiler/relationautoraw.bit — #6366 (epic #6298): rows from raw SQL
// (`Db.query<T>`/`TxHandle.query<T>`, pkg/orm/rawsql.bit) as a flow the pass
// can follow and explain.
//
// Raw SQL has no `.with(...)`: nothing a developer can add to the query makes
// `post.author` load, so a read that reaches a raw row can never be proven, and
// the old hint ("add `.with(\"author\")` where the rows are queried") pointed
// at a call that has no such method. Before #6366 a raw row was simply an
// untraceable value and got that hint; now `relationAutoResolveCall`
// (relationauto.bit) answers a raw call with a holder flow keyed
// `holder:R:<module>:<call node>` that never has a writer. Everything that
// already follows a flow — a `let`, a `for-of`, an index, a return, an argument,
// a store — carries it unchanged, and the proof's failure (`RelationAutoBlame`,
// relationautoholder.bit) names the raw origin so the hint can say what does
// work (`relationAutoRawHint`).

const relationAutoRawPrefix = "holder:R:"

fn relationAutoIsRawName(name: string): bool {
  return relationAutoKeyIs(name, relationAutoRawPrefix)
}

// The class names `Db.query<T>` and `TxHandle.query<T>` are declared on
// (pkg/orm/db.bit), matched by name alone like `Repo` is (checkormrepokey.bit's
// own accepted narrow risk): a same-named user class only ever changes which
// hint an already-unprovable read gets.
fn relationAutoRawReceiverNames(): []string {
  return ["Db", "TxHandle"]
}

// Whether `callNode` is `recv.query<T>(...)` on a raw-SQL receiver.
fn relationAutoIsRawCall(c: Checker, callNode: int): bool {
  if (getNode(c.tree, callNode).tag != Tag.Call) {
    return false
  }
  let callee = kidsOf(c.tree, callNode)[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return false
  }
  let mk = kidsOf(c.tree, callee)
  if (identText(c.tree, c.source, mk[1]) != "query") {
    return false
  }
  let rt = checkExprType(c, mk[0])
  return rt != 0 &&
    c.ctx.types[rt].kind == TypeKind.Struct &&
    ormNameIn(c.ctx.types[rt].name, relationAutoRawReceiverNames())
}

// The rows a raw-SQL call hands back as a flow: a slice of `@table` rows with
// the holder key `holder:R:<module>:<call>`, or not-found for any other call
// (or a result that is not `[]T` of a `@table` class).
fn relationAutoRawCall(c: Checker, callNode: int): RelationAutoFlow {
  if (!relationAutoIsRawCall(c, callNode)) {
    return relationAutoNoFlow(c)
  }
  let ty = checkExprType(c, callNode)
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Fallible) {
    return relationAutoNoFlow(c)
  }
  let (cls, isSlice) = relationAutoParamTrackable(c, c.ctx.types[ty].result)
  if (!cls.found || !isSlice) {
    return relationAutoNoFlow(c)
  }
  return RelationAutoFlow{
    found = true, cls = cls, queryCall = 0, paramName = "${relationAutoRawPrefix}${c.moduleId}:${callNode}",
    isSlice = true, ownerModule = c.moduleId, path = "",
  }
}

// What a developer can do about a read of `need` on rows from raw SQL. `line`
// is where the raw rows were stored (0: the read is on them directly).
fn relationAutoRawHint(need: string, className: string, line: int): string {
  let lead = "rows from raw SQL do not load relations"
  if (line > 0) {
    lead = "the rows stored on line ${line} come from raw SQL, which does not load relations"
  }
  return "${lead}; read '${need}' through db.table<${className}>().with(\"${need}\"), " +
    "or select its columns in the SQL and read them as fields"
}
