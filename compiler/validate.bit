// Self-host: the checker's VALIDATION layer — the parts that REJECT a program,
// as opposed to the parts in check.bit that infer its types. Until this landed,
// bit2 was a type INFERENCER with no validator: it compiled
// `function f(): i32 { return "hi" }` to a binary that prints the string's raw
// pointer.
//
// Why the entry point is a hook in `checkModule`'s sweep rather than a pass of
// its own: `env` is flat (one map, no per-function scoping) and `nodeTypes` is
// only cached for Binding/Call/ArrowP, so a validator that ran afterwards would
// read whichever function bound a name LAST — typing `a`'s `return x` with
// `b`'s `x`. Children precede parents in arena order, so when the sweep reaches
// a FuncDecl node its whole body is already swept and `env` holds exactly that
// function's params and locals, with no later function's yet. Validating there
// gets the seed's scoping for free (§9). The one rule this owes the sweep: read
// types, never reorder them — the arena's id order reproduces the seed's touch
// order, which method-name mangling (`name$t{id}`) and the stage3==stage4 fixed
// point both depend on.
//
// The safety rule throughout: a validator that misses an error leaves a gap, but
// one that invents an error breaks a working build. Every predicate here is
// permissive when it cannot decide — `invalid` (TypeId 0, which is also what an
// un-inferred node holds) is assignable in both directions, and any construct
// not yet walked reports nothing.

// #5639 split the type/numeric predicates and structural assignability out
// to compiler/validatenumeric.bit and compiler/validateassignable.bit to
// keep this file under the 800-line E0200 ceiling; same-module siblings, so
// nothing here changed to call them. What stays here: vSpan, the shared
// E02xx registry every validateXxx.bit sibling reads directly, and the
// diagnostic surface — vMismatch's E0041 rendering, vNoteShadowedConversion's
// shadow note, and the vExpect/vExpectExpr/vExpectTupleLit/
// vArrowShapeMismatch expectation-pushdown entry points that report through
// it.

// Diagnostic codes, matching `Code` values — the
// numbers `E%04d` renders. Named rather than inline (the parser writes its two
// bare) because the checker's registry spans 40–73.
const ecTypeMismatch = 41
const ecArgCount = 50
const ecInvalidOperand = 53
const ecMissingReturn = 55
const ecInvalidBreakContinue = 56
const ecFailOutsideFallible = 60
const ecTryOutsideFallible = 61
const ecNotCallable = 49
const ecNotAnEnum = 69
const ecUnknownVariant = 70
const ecNonExhaustive = 71
const ecNotIndexable = 54
const ecTupleIndexOutOfRange = 59
const ecArrayIndexOutOfRange = 122
const ecInvalidSpread = 63
const ecNotStringable = 73
const ecMissingMethod = 51
const ecCannotInfer = 68
const ecUnknownMember = 57
const ecNakedFnInvalid = 74
const ecNosplitCallsAllocating = 75
const ecUnknownAttribute = 76
const ecExternFnInvalid = 77
const ecExternUnsupportedTarget = 78
const ecSymbolAttrInvalid = 79
const ecDuplicateSymbol = 80
const ecEntryOfInvalid = 81
const ecNonConstantExpr = 64
const ecModuleStateInvalid = 82
const ecInvalidExprStatement = 65
const ecExpectedCallExpr = 66
const ecCatchBlockIncomplete = 67
const ecNotComparable = 52
const ecInvalidArrayElement = 72
const ecGenericArityMismatch = 58
// E0083 (§13.4): a class type with a class-typed field, or a boxed enum whose
// declaration-order first variant carries a payload (#4182), has no zero
// value, so it can be neither default-constructed nor partially written by a
// literal that leaves that field out. First free code above the checker's
// 40–82 block; E0200+ is the lint registry (spec/LINT.md) and E0047 is the
// self-embedding rule, which means something else.
const ecNoZeroValue = 83

// E0084 (§15.4): a constant expression whose value does not fit i64, the widest
// integer the folder evaluates in. "Constant expressions are evaluated at compile
// time with no overflow", so this is a REPRESENTABILITY error and deliberately
// not E0064 — the expression is perfectly constant, its value just does not
// exist in the target type. First free code above E0083; E0200+ is the lint
// registry (spec/LINT.md).
const ecConstOverflow = 84

// A node's span, mapped from module-global offsets back to the file the text
// came from. A module is its files CONCATENATED, so every span the parser
// produced is module-global and would otherwise render against the wrong file
// and line.
fn vSpan(c: Checker, node: int): Span {
  let sp = getNode(c.tree, node).span
  let loc = fileOf(c.fileStarts, sp.start)
  return Span{
    file = c.files[loc.fileIdx],
    start = loc.offset,
    end = loc.offset + (sp.end - sp.start),
  }
}

// Emits E0041 with rendered expected/found type names — the one place that
// explains the class-or-enum interface rule (§14.3, owner ruling #5216).
fn vMismatch(c: Checker, node: int, expected: int, found: int) {
  let en = typeName(c.ctx, expected)
  let fnd = typeName(c.ctx, found)
  if (c.ctx.types[expected].kind == TypeKind.Interface && !vStorableInInterface(c, found)) {
    report(
      c.diags, ecTypeMismatch, vSpan(c, node),
      "cannot store '${fnd}' in interface '${en}': only a class or an enum can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a scalar has nothing to point to (§14.3)",
    )
    return
  }
  // Storable but not satisfying (#2242): say WHICH method is missing or
  // mismatched, rather than just the two type names. `vSatisfyReason` walks
  // the same method set `vAssignable` already judged `found` against to reach
  // here, so it only ever returns "" for the predeclared `error` (no
  // declaration to walk) — every other interface names its failing method.
  if (c.ctx.types[expected].kind == TypeKind.Interface) {
    let why = vSatisfyReason(c, found, expected)
    if (why != "") {
      report(c.diags, ecTypeMismatch, vSpan(c, node), "expected '${en}', found '${fnd}'", why)
      return
    }
  }
  reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node), "expected '${en}', found '${fnd}'")
  vNoteShadowedConversion(c, node)
}

// #3474: `node` may be a call that LOOKS like a builtin conversion — `f64(x)`
// — but whose callee actually resolves to the user's own `fn f64()`, shadowing
// the conversion (SPEC 17.5's own local>declaration>builtin precedence,
// `checkexprcall.bit`'s `checkCall`). The E0041 above then reports that function's
// return type ("found 'i64'") with nothing tying it back to the shadow, and
// the declaration-site E0048 warning is easy to miss once a module has other
// errors scrolling past it. Naming the shadow HERE, at the point of confusion,
// is the fix; see `shadowedConversionDecl` for why this never fires for a
// dependency's or an extern's declaration.
fn vNoteShadowedConversion(c: Checker, node: int) {
  let name = callIdentName(c, node)
  if (name == "") {
    return
  }
  let decl = shadowedConversionDecl(c, name)
  if (decl == 0) {
    return
  }
  let nameNode = kidsOf(c.tree, decl)[1]
  note(
    c.diags, vSpan(c, nameNode),
    "'${name}' resolves to the function declared here, not the builtin conversion (see E0048)",
  )
}

// #4596: an arrow literal whose OWN type could not be inferred is accepted
// against ANY target, in every expectation position. An unannotated parameter
// stays at invalid — `seedArrowParamTypes` (checkexpr.bit) seeds one only from
// a `TypeKind.Func` expectation — so the arrow interns as `(<error>) => i64`,
// `vAssignable`'s mentions-invalid escape fires, and `let a: int = (y) => y +
// 1`, `one((x) => x + 1)` and `return (y) => y + 1` all checked clean and then
// printed the closure's address as an `i64`.
//
// That escape is right about the PARAMETERS and wrong about the KIND: whatever
// `y` turns out to be, `(y) => …` is a function value and cannot be an `i64`.
// So a DECIDED non-`Func` target is judged on the arrow's shape alone. There is
// no inferred type to name on the found side, hence "found a function literal"
// rather than a quoted type; an arrow that DID infer its type is not this case
// and reports through `vMismatch` above with both names, as it always has.
//
// Everything genuinely undecidable stays permissive: `target == 0` (the
// caller's first guard), a target that itself mentions invalid, a target that
// still mentions a rigid type parameter (judged per monomorphization, not here
// — `vHasTypeParam`), and every `Func` target, whose members are exactly the
// gap the escape exists for.
fn vArrowShapeMismatch(c: Checker, node: int, ty: int, target: int) {
  if (getNode(c.tree, node).tag != Tag.ArrowFn || !vMentionsInvalid(c, ty, 0)) {
    return
  }
  if (c.ctx.types[target].kind == TypeKind.Func) {
    return
  }
  if (vMentionsInvalid(c, target, 0) || vHasTypeParam(c, target, 0)) {
    return
  }
  reportNoHint(
    c.diags, ecTypeMismatch, vSpan(c, node),
    "expected '${typeName(c.ctx, target)}', found a function literal",
  )
}

// Checks `node`'s type `ty` against `target`, emitting E0041 on failure.
// `target == 0` (invalid) means "no expectation" and is always a no-op, matching
// invalid's cascade-suppression contract.
fn vExpect(c: Checker, node: int, ty: int, target: int) {
  if (target == 0) {
    return
  }
  if (vNamespaceUsedAsValue(c, node, ty)) {
    return
  }
  if (!vAssignableNode(c, node, ty, target)) {
    vMismatch(c, node, target, ty)
    return
  }
  vArrowShapeMismatch(c, node, ty, target)
}

// The expectation-aware entry point: validates `node` against `want` in every
// context that has a declared target type (binding, return, argument).
//
// Why this exists rather than calling `vExpect` directly at each site: a bare
// `[a, b]` slice literal has no self-evident type. checkbindexpr.bit's `checkSliceLit`
// takes no expectation, so it always answers `[]E` with E defaulted from the
// FIRST element — `[1, 2]` is `[]i64` even where `[]i32` is wanted. Comparing
// that answer against the target rejects correct code (`function f(): []i32 {
// return [1,2] }`). The seed avoids this by threading `expected` into its
// checkSliceLit; the self-hosted split (inference in check.bit, diagnostics
// here) can't do that without an `expected` parameter on all of checkExprType,
// so the expectation is pushed into the literal's ELEMENTS here instead. Same
// rule, applied at the only place that knows the target.
//
// The array case is the #1470 divergence. SPEC.md §12.3: a bare `[ ... ]`
// element list IS a slice literal, and §22 defers "arrays are not yet
// constructible as values" — so `[N]T` is built only by the typed composite form
// `[N]T{...}` (§11.2). A bare list against an array annotation is therefore
// ILL-TYPED, which is what the seed has always said. Accepting it produced a
// silently wrong value (`arr[0] == 4.5` false, an f64 read through an f32 slot)
// and, on a length mismatch, a read of uninitialized heap.
fn vExpectExpr(c: Checker, node: int, want: int) {
  if (want == 0 || node == 0) {
    return
  }
  // An interface target is NOT special-cased away: `vAssignable` already has the
  // §14.3 branch and `vMismatch` already renders its wording, so vExpect answers
  // it correctly AND also catches an unsatisfied method set, which `vIfaceStore`
  // does not. Skipping interfaces here silently dropped the seed's diagnostic on
  // `return 7` from an `Any` result (_tests_/cases/check_iface_scalar.bit) — the
  // return path has no vIface* rule to fall back on.
  if (getNode(c.tree, node).tag == Tag.TupleLit) {
    vExpectTupleLit(c, node, want)
    return
  }
  if (getNode(c.tree, node).tag == Tag.SliceLit) {
    let wk = c.ctx.types[want].kind
    if (wk == TypeKind.Slice) {
      // Push the expectation down: each element against the declared element
      // type. Recursion handles `[][]i32` and a nested literal.
      let elem = c.ctx.types[want].elem
      for a of kidsOf(c.tree, node) {
        let e = a
        if (getNode(c.tree, e).tag == Tag.Arg) {
          e = kidsOf(c.tree, e)[0]
        }
        vExpectExpr(c, e, elem)
      }
      return
    }
    // Slice literal against an array (or anything else): report with the
    // literal's own inferred type, so the text matches the seed's
    // `expected '[2]f32', found '[]f64'` exactly.
    let got = checkExprType(c, node)
    // THE SAFETY RULE: an inference gap is undecidable, not an error.
    if (got == 0 || vMentionsInvalid(c, got, 0)) {
      return
    }
    vMismatch(c, node, want, got)
    return
  }
  vExpect(c, node, checkExprType(c, node), want)
}

// A tuple literal's push-down half of `vExpectExpr`, split out purely to keep
// THAT function's own McCabe complexity from growing (spec/LINT.md E0204,
// tools/build/complexity-debt.txt's baseline for `vExpectExpr`) — the
// identical reason SliceLit's own branch stays a bare `if` there rather than
// this whole body inline.
//
// Each element is pushed against ITS OWN position in the declared tuple type,
// unlike SliceLit's one shared element type, so `let t: (i32, string) = (1,
// "x")` accepts the untyped `1` at `i32` rather than comparing the literal's
// own defaulted `(i64, string)` against the annotation and rejecting correct
// code — the identical #1470-shaped gap SliceLit's push-down exists to close,
// here for a tuple's per-position element types instead of one shared one.
fn vExpectTupleLit(c: Checker, node: int, want: int) {
  let members = c.ctx.types[want].members
  let kids = kidsOf(c.tree, node)
  if (c.ctx.types[want].kind != TypeKind.Tuple || len(members) != len(kids)) {
    // Wrong shape entirely (not a tuple target, or the wrong arity): report
    // with the literal's own inferred type, same as SliceLit's fallback.
    let got = checkExprType(c, node)
    if (got == 0 || vMentionsInvalid(c, got, 0)) {
      return
    }
    vMismatch(c, node, want, got)
    return
  }
  let i = 0
  while (i < len(kids)) {
    vExpectExpr(c, kids[i], members[i])
    i = i + 1
  }
}

