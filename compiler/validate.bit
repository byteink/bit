// Self-host: the checker's VALIDATION layer, ported from the parts of
// that REJECT a program — as opposed to the parts in
// check.bit that infer its types. Until this landed, bit2 was a type
// INFERENCER with no validator: it compiled `function f(): i32 { return "hi" }`
// to a binary that prints the string's raw pointer.
//
// Why the entry point is a hook in `checkModule`'s sweep rather than a pass of
// its own: `env` is flat (one map, no per-function scoping) and `nodeTypes` is
// only cached for Binding/Call/ArrowP, so a validator that ran afterwards would
// read whichever function bound a name LAST — typing `a`'s `return x` with
// `b`'s `x`. Children precede parents in arena order, so when the sweep reaches
// a FuncDecl node its whole body is already swept and `env` holds exactly that
// function's params and locals, with no later function's yet. Validating there
// gets the seed's scoping for free (§9). The one rule this owes the sweep: read
// types, never reorder them — the arena's id order reproduces the seed's touch
// order, which method-name mangling (`name$t{id}`) and the stage3==stage4 fixed
// point both depend on.
//
// The safety rule throughout: a validator that misses an error leaves a gap, but
// one that invents an error breaks a working build. Every predicate here is
// permissive when it cannot decide — `invalid` (TypeId 0, which is also what an
// un-inferred node holds) is assignable in both directions, and any construct
// not yet walked reports nothing.

// Diagnostic codes, matching `Code` values — the
// numbers `E%04d` renders. Named rather than inline (the parser writes its two
// bare) because the checker's registry spans 40–73.
const ecTypeMismatch = 41
const ecArgCount = 50
const ecInvalidOperand = 53
const ecMissingReturn = 55
const ecInvalidBreakContinue = 56
const ecFailOutsideFallible = 60
const ecTryOutsideFallible = 61
const ecNotCallable = 49
const ecNotAnEnum = 69
const ecUnknownVariant = 70
const ecNonExhaustive = 71
const ecNotIndexable = 54
const ecTupleIndexOutOfRange = 59
const ecInvalidSpread = 63
const ecNotStringable = 73
const ecMissingMethod = 51
const ecCannotInfer = 68
const ecUnknownMember = 57
const ecNakedFnInvalid = 74
const ecNosplitCallsAllocating = 75
const ecUnknownAttribute = 76
const ecExternFnInvalid = 77
const ecExternUnsupportedTarget = 78
const ecSymbolAttrInvalid = 79
const ecDuplicateSymbol = 80
const ecEntryOfInvalid = 81
const ecNonConstantExpr = 64
const ecModuleStateInvalid = 82
const ecInvalidExprStatement = 65
const ecExpectedCallExpr = 66
const ecCatchBlockIncomplete = 67
const ecNotComparable = 52
const ecInvalidArrayElement = 72
const ecGenericArityMismatch = 58
// E0083 (§13.4): a struct type with a struct-typed field has no zero value, so
// it can be neither default-constructed nor partially written by a literal that
// leaves that field out. First free code above the checker's 40–82 block; E0200+
// is the lint registry (spec/LINT.md) and E0047 is the self-embedding rule,
// which means something else.
const ecNoZeroValue = 83

// E0084 (§15.4): a constant expression whose value does not fit i64, the widest
// integer the folder evaluates in. "Constant expressions are evaluated at compile
// time with no overflow", so this is a REPRESENTABILITY error and deliberately
// not E0064 — the expression is perfectly constant, its value just does not
// exist in the target type. First free code above E0083; E0200+ is the lint
// registry (spec/LINT.md).
const ecConstOverflow = 84

// A literal's value, or `ok: false` when the node is not one. Bit has no
// optional and no tuple return; a two-field struct is the whole story.
struct VLit {
  ok: bool,
  value: int,
}

// A folded compile-time constant (§15.4). `kind` is one of `vcInt`/`vcFloat`/
// `vcBool` and selects which payload is live — the seed's `ConstVal` union in
// the form Bit spells it. `ok: false` means "not a constant expression".
//
// `overflow` is a SECOND, distinct failure, and separating the two is the whole
// point of it (#2261). Both leave `ok: false`, but they are opposite statements
// about the program: `9223372036854775807 + 1` IS a constant expression — it is
// simply not representable — so reporting it as E0064 "must be a compile-time
// constant expression" would tell the user something false about their own code.
// A caller that only reads `ok` behaves exactly as it did before.
struct VConst {
  ok: bool,
  overflow: bool,
  kind: int,
  ival: int,
  fval: f64,
}

// A node's span, mapped from module-global offsets back to the file the text
// came from. A module is its files CONCATENATED, so every span the parser
// produced is module-global and would otherwise render against the wrong file
// and line.
function vSpan(c: Checker, node: int): Span {
  let sp = getNode(c.tree, node).span
  let loc = fileOf(c.fileStarts, sp.start)
  return Span{ file: c.files[loc.fileIdx], start: loc.offset, end: loc.offset + (sp.end - sp.start) }
}

// ---- prim predicates --------------------
// Indexed by the seed's Prim order: 0..3 i8/i16/i32/i64, 4..7 u8/u16/u32/u64,
// 8..9 f32/f64, 10 bool, 11 string.

function vPrimIsInt(p: int): bool {
  return p >= 0 && p <= 7
}

function vPrimIsFloat(p: int): bool {
  return p == 8 || p == 9
}

// Inclusive representable range for an integer prim (§15.4). Callers must gate
// on `vPrimIsInt` — a float/bool/string prim has no range (the seed's
// `unreachable`).
function vPrimMin(p: int): int {
  if (p == 0) { return 0 - 128 }
  if (p == 1) { return 0 - 32768 }
  if (p == 2) { return 0 - 2147483648 }
  if (p == 3) { return 0 - 9223372036854775807 - 1 }
  return 0
}

function vPrimMax(p: int): int {
  if (p == 0) { return 127 }
  if (p == 1) { return 32767 }
  if (p == 2) { return 2147483647 }
  if (p == 4) { return 255 }
  if (p == 5) { return 65535 }
  if (p == 6) { return 4294967295 }
  return 9223372036854775807
}

// ---- assignability (§14.2) -------------------------------------------------

// May `nil` occupy a slot of type `ty` (§13.4)? A bare type parameter cannot:
// only structs can satisfy a `<T: I>` bound (§10.4, methods attach to
// structs/aliases), and a struct's zero value is never `nil`.
// A raw pointer's zero value is the null pointer (§11.4), so `nil` seeds it —
// the only literal that produces a `*T` value.
function vIsNilable(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  return k == TypeKind.Slice || k == TypeKind.Map || k == TypeKind.Chan ||
    k == TypeKind.Func || k == TypeKind.Interface || k == TypeKind.Ptr
}

// Does `ty` mention `invalid` anywhere inside it?
//
// A composite whose COMPONENT failed to infer is just as undecidable as a bare
// `invalid`, and the top-level id alone does not show it: an arrow function
// whose parameter type did not resolve interns as a perfectly real func type
// `(<error>) => <error>`, whose id is non-zero and compares unequal to every
// concrete `(i64) => []u8`. Reporting that is a false positive on code the seed
// accepts — the gap is bit2's inference, not the program. Same contract as a
// bare invalid, one level down.
//
// Named types (struct/enum/interface) are NOT descended into: they are nominal,
// so a struct with an un-inferred field is still exactly that struct, and two
// mentions of it are still the same type. Descending would make every named type
// containing one bad field permanently unverifiable.
function vMentionsInvalid(c: Checker, ty: int, depth: int): bool {
  if (ty == 0) {
    return true
  }
  // Bounded like typeNameDepth: a recursive generic can cycle through its own
  // instantiation, and this must terminate (Power of 10). Undecided at the
  // bottom means "no" — the outer levels already answered for anything real.
  if (depth >= 32) {
    return false
  }
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.Invalid) {
    return true
  }
  if (k == TypeKind.Slice || k == TypeKind.Array || k == TypeKind.Chan) {
    return vMentionsInvalid(c, t.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vMentionsInvalid(c, t.mapKey, depth + 1) || vMentionsInvalid(c, t.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vMentionsInvalid(c, t.result, depth + 1) || vMentionsInvalid(c, t.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    for m of t.members {
      if (vMentionsInvalid(c, m, depth + 1)) {
        return true
      }
    }
    if (k == TypeKind.Func) {
      return vMentionsInvalid(c, t.result, depth + 1)
    }
    return false
  }
  return false
}

// Whether two types differ ONLY where a type parameter sits (#2041) — the
// structural form of `vAssignable`'s bare-TypeParam escape, and a strict
// superset of it: a bare parameter on either side still short-circuits at the
// top, so nothing the old test accepted is refused here.
//
// This can only ever turn a rejection into an acceptance, which is what makes it
// safe: the ids of two same-spelled type params cannot be compared at all (see
// vAssignable), so a composite over one carries exactly as little information as
// the parameter itself. Kind and arity must still agree, so `[]T` against
// `map<T,int>`, or `[]T` against `i64`, remains a real mismatch — this is not a
// blanket "anything mentioning a T".
//
// Bounded like vMentionsInvalid: a recursive generic can cycle through its own
// instantiation and this must terminate (Power of 10). Undecided at the bottom
// answers YES, matching the permissive direction of every rule it serves.
function vSameModuloTypeParams(c: Checker, a: int, b: int, depth: int): bool {
  if (depth >= 32) { return true }
  if (a == 0 || b == 0 || a == b) { return true }
  let ta = c.ctx.types[a]
  let tb = c.ctx.types[b]
  if (ta.kind == TypeKind.TypeParam || tb.kind == TypeKind.TypeParam) { return true }
  if (ta.kind != tb.kind) { return false }
  let k = ta.kind
  if (k == TypeKind.Slice || k == TypeKind.Chan) {
    return vSameModuloTypeParams(c, ta.elem, tb.elem, depth + 1)
  }
  if (k == TypeKind.Array) {
    return ta.arrayLen == tb.arrayLen && vSameModuloTypeParams(c, ta.elem, tb.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vSameModuloTypeParams(c, ta.mapKey, tb.mapKey, depth + 1) &&
      vSameModuloTypeParams(c, ta.mapVal, tb.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vSameModuloTypeParams(c, ta.result, tb.result, depth + 1) &&
      vSameModuloTypeParams(c, ta.errTy, tb.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    if (len(ta.members) != len(tb.members)) { return false }
    let i = 0
    while (i < len(ta.members)) {
      if (!vSameModuloTypeParams(c, ta.members[i], tb.members[i], depth + 1)) { return false }
      i = i + 1
    }
    if (k == TypeKind.Func) {
      return vSameModuloTypeParams(c, ta.result, tb.result, depth + 1)
    }
    return true
  }
  // Named types (struct/enum/interface) are NOT descended into: they are
  // nominal, and `sameNominalDecl` above already answers for them.
  return false
}

// Structural assignability with no source-literal awareness: identity, `nil`
// into a nilable type, or an untyped constant whose DEFAULT type matches `dst`
// exactly.
function vAssignable(c: Checker, src: int, dst: int): bool {
  // `invalid` suppresses cascades — and is the id an un-inferred node still
  // holds, so this is also what keeps an inference gap from becoming a false
  // error.
  if (src == 0 || dst == 0) { return true }
  if (src == dst) { return true }
  // #1540: two instantiations of one generic declaration — and a template
  // against its own instantiations — were literally the same TypeId before
  // per-instantiation nominal identity. Accepting them preserves exactly the
  // programs this validator accepted; narrowing it to compare type ARGUMENTS is
  // a new diagnostic, and belongs with the generic-inference tail rather than
  // inside a renumbering, where it would be indistinguishable from a regression.
  if (sameNominalDecl(c.ctx, src, dst)) { return true }
  // An `invalid` buried inside a composite is the same undecidable as a bare
  // one — see vMentionsInvalid. Checked after the identity test so two mentions
  // of the same broken type still compare equal rather than recursing.
  if (vMentionsInvalid(c, src, 0) || vMentionsInvalid(c, dst, 0)) { return true }
  // `nil` is answered before the interface branch: an interface is a reference
  // type, so `nil` is its zero value, but `nil` has no method set and would fail
  // a satisfaction test against any non-empty interface.
  if (src == c.ctx.untypedNilId) { return vIsNilable(c, dst) }
  // An interface target: the value must be storable behind an interface (a
  // struct, another interface, or nil — §14.3) AND satisfy its method set.
 // `nil` and `invalid` were
  // already answered above, so this only decides real value types.
  if (c.ctx.types[dst].kind == TypeKind.Interface) {
    return vStorableInInterface(c, src) && vSatisfies(c, src, dst)
  }
  // A type parameter on either side is accepted unchecked, and the same answer
  // must hold wherever one is REACHED, not only where one is the whole type
  // (#2041). Two decls that each declare `<T>` get two distinct TypeParam ids,
  // and `userTypes` keys them by BARE NAME, so the last `<T>` in the module wins
  // and an earlier decl's `T` resolves to the wrong id — `expected 'T', found
  // 'T'` on tests/cases/run_generic_nested.bit, where `Opt<T>` and `Box<T>`
  // coexist. Real fix is per-decl type-param scoping; until then the ids cannot
  // be compared and the only sound answer is yes.
  //
  // Written as a bare-kind test, this rule fired for `v: T` and not for
  // `items: []T`, which is why `struct Stack<T> { items: []T }` had no writable
  // constructor: the struct's field is `[]T_struct` and the constructor's
  // literal is `[]T_func`, two Slice ids, neither of them a TypeParam, so
  // identity failed and E0041 printed the SAME SPELLING on both sides.
  if (vSameModuloTypeParams(c, src, dst, 0)) {
    return true
  }
  if (isUntyped(c, src)) {
    if (defaultType(c, src) == dst) { return true }
    // A float constant is representable in either float width. An int/rune
    // constant is range-checked by `vAssignableNode` when the source literal is
    // in hand; here, with no node, only exact-width float widening is safe.
    if (src == c.ctx.untypedFloatId && c.ctx.types[dst].kind == TypeKind.Prim) {
      return vPrimIsFloat(c.ctx.types[dst].prim)
    }
    return false
  }
  return false
}

// Is `value` representable in `dst` (§15.4)?
function vRepresentable(c: Checker, value: int, dst: int): bool {
  let t = c.ctx.types[dst]
  if (t.kind != TypeKind.Prim) { return false }
  if (vPrimIsFloat(t.prim)) { return true } // int constant widened to float
  if (!vPrimIsInt(t.prim)) { return false }
  // ponytail: u64 goes unchecked. `int` is i64 here, so a u64 literal above
  // i64::max has already wrapped in `parseIntText` and would range-check as
  // negative — rejecting the crypto tables' 0xFFFFFFFFFFFFFFFF masks. Costs the
  // `let x: u64 = -1` diagnostic; needs an i128 literal path to do properly.
  if (t.prim == 7) { return true }
  return value >= vPrimMin(t.prim) && value <= vPrimMax(t.prim)
}

// Peels at most one leading unary `+`/`-` and reports the literal value beneath,
// for range-checking a directly-written literal against a sized target (§15.4).
// Not a constant folder: a compound constant expression default-types instead,
// matching the seed's deliberately narrow `literalValue`.
function vLiteralValue(c: Checker, node: int): VLit {
  let n = node
  let negate = false
  if (getNode(c.tree, n).tag == Tag.Unary) {
    let op = getNode(c.tree, n).main
    if (op != int(Kind.Minus) && op != int(Kind.Plus)) { return VLit{ ok: false, value: 0 } }
    negate = op == int(Kind.Minus)
    n = kidsOf(c.tree, n)[0]
  }
  let nn = getNode(c.tree, n)
  let tag = nn.tag
  if (tag != Tag.IntLit && tag != Tag.RuneLit) { return VLit{ ok: false, value: 0 } }
  let text = c.source[nn.span.start:nn.span.end]
  let v = parseIntText(text)
  if (tag == Tag.RuneLit) { v = parseRuneText(text) }
  if (negate) { v = 0 - v }
  return VLit{ ok: true, value: v }
}

// ---- module-state constant folding (§15.4) --------------------------------
//
// A faithful port of `constEval`, and it must STAY faithful:
// this decides both what §11.11 accepts and what byte image lowering renders,
// so any expression the seed folds and this does not becomes a `bit check`
// pass followed by a `bit build` failure (#1430).
//
// Deliberately NOT `vLiteralValue`, which peels one sign off a literal for
// range-checking and nothing more. That narrowness is right there and wrong
// here: `let x: i64 = 0 - 1` is a constant expression by §15.4 ("constant
// expressions are evaluated at compile time"), so refusing to fold it rejects a
// legal program rather than an illegal one.

const vcInt = 0
const vcFloat = 1
const vcBool = 2
// A constant string, carrying NO value — the mirror of the seed's payload-less
// `ConstVal.string`. The question this folder answers for a string is only "is
// it constant at all", which a bare literal always is; nothing decodes the
// content, so there is no field to hold and every arithmetic path below refuses
// this kind by falling through its `vcInt`/`vcFloat` guards.
//
// Added for #1534. It was missing because the only consumer until then was
// module `let` state, whose untraced-type rule (§11.11) rejects a string before
// the fold is ever reached — so `const s = "hi"` was the first caller able to
// see the hole, and it saw it as a false REJECTION of a valid program.
const vcString = 3
const vConstMaxDepth = 64

function vConstNone(): VConst {
  return VConst{ ok: false, overflow: false, kind: vcInt, ival: 0, fval: 0.0 }
}

// The other failure: a genuine constant expression whose value leaves i64.
function vConstOver(): VConst {
  return VConst{ ok: false, overflow: true, kind: vcInt, ival: 0, fval: 0.0 }
}

// ---- overflow-checked constant arithmetic (§15.4) --------------------------
//
// "Constant expressions are evaluated at compile time with no overflow (overflow
// of the final target type is the representability error)." Folding in wrapping
// i64 broke both halves at once (#2261): `300 * 365 * 24 * 60 * 60 * 1000000000`
// compiled clean and ran as -8985944073709551616, and the true value
// (9460800000000000000) was never seen by anything that could have judged it.
// The wrong value was not merely large, it was NEGATIVE — an expiry 300 years
// out landing 341 years in the past, with no diagnostic from check, build or
// lint.
//
// i64 is the widest the folder has, so "does not fit i64" is where detection has
// to live; §14.2's existing `vRepresentable` cannot help, because the WRAPPED
// value is representable in i64 by construction.
//
// Each predicate is written so the check itself cannot overflow — no operation
// below computes the very value it is trying to reject.

function vI64Min(): int { return vPrimMin(3) }
function vI64Max(): int { return vPrimMax(3) }

function vAddOverflows(x: int, y: int): bool {
  if (y > 0) { return x > vI64Max() - y }
  if (y < 0) { return x < vI64Min() - y }
  return false
}

// `y > 0` and `y < 0` are tested separately rather than via `vAddOverflows(x, -y)`
// because negating i64 MIN is itself the overflow being looked for.
function vSubOverflows(x: int, y: int): bool {
  if (y > 0) { return x < vI64Min() + y }
  if (y < 0) { return x > vI64Max() + y }
  return false
}

// The division test is only valid once `y == -1` is out of the way — `MIN / -1`
// is the one division that overflows — and `x == -1` is handled with it so the
// pair is symmetric.
function vMulOverflows(x: int, y: int): bool {
  if (x == 0 || y == 0) { return false }
  if (x == 0 - 1) { return y == vI64Min() }
  if (y == 0 - 1) { return x == vI64Min() }
  return (x * y) / y != x
}

// The initializer node of the module-level `const` named `name` in the module
// `c` describes, or 0 when there is none. Takes the OWNER's checker, never the
// referencing one: a node index only means anything in its own tree, so reading
// an imported decl against the importer's arena lands on an unrelated node (the
// declOwner rule). `vConstIdent` is what picks the right `c` before calling here.
//
// This used to be documented as single-module BY DESIGN, on the grounds that the
// seed's `constEval` refused cross-module folding, so following an import edge
// "would fold what the seed leaves alone and put the two compilers' images out of
// step". Both halves of that measured wrong when #2115 checked them:
//
//   - "images out of step" was the #1430 hazard — check accepts, lowering cannot
//     render. Lowering has rendered this since lowerdriver.bit's ident path
//     learned declOwner: an imported const inlines its initializer against ITS
//     module's checker, and a `const` over one already compiles and runs
//     correctly as a function-local. The drift ran the other way — the checker
//     was refusing what the back end was ready to emit.
//   - the divergence from the pinned oracle is MISSING in
//     scripts/selfhost-diffcheck.sh terms (oracle rejects, bit2 accepts), which
//     that gate counts and tolerates; only FALSEPOS fails it.
//
// Bounded by the node arena, per Power-of-10.
function vConstInitNode(c: Checker, name: string): int {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0 &&
            c.source[pat.span.start:pat.span.end] == name) {
          return bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return 0
}

// Folds `node` to a compile-time value, or `ok: false` when it is not constant.
function vConstEval(c: Checker, node: int, depth: int): VConst {
  if (node == 0 || depth >= vConstMaxDepth) { return vConstNone() }
  let n = getNode(c.tree, node)
  let tag = n.tag
  let text = c.source[n.span.start:n.span.end]

  if (tag == Tag.IntLit) {
    // §15.4: a literal wider than 64 bits has no representation in any
    // integer type the language has — `parseIntText` would otherwise wrap it
    // in i64 silently (#2358). Checked on the SAME text `parseIntText` reads,
    // via the one shared radix decision (`intTextForm`), so the two can never
    // disagree about what was parsed. Not "wider than i64": that would reject
    // the 169 legitimate `u64` literals (crypto round constants, uuid masks)
    // that already rely on `parseIntText` wrapping into their high bit.
    if (intTextOverflows(text)) { return vConstOver() }
    return VConst{ ok: true, overflow: false, kind: vcInt, ival: parseIntText(text), fval: 0.0 }
  }
  if (tag == Tag.RuneLit) {
    return VConst{ ok: true, overflow: false, kind: vcInt, ival: parseRuneText(text), fval: 0.0 }
  }
  if (tag == Tag.FloatLit) {
    return VConst{ ok: true, overflow: false, kind: vcFloat, ival: 0, fval: parseFloat(text) }
  }
  if (tag == Tag.BoolLit) {
    let b = 0
    if (text == "true") { b = 1 }
    return VConst{ ok: true, overflow: false, kind: vcBool, ival: b, fval: 0.0 }
  }
  if (tag == Tag.StringLit || tag == Tag.RawStringLit) {
    return VConst{ ok: true, overflow: false, kind: vcString, ival: 0, fval: 0.0 }
  }

  if (tag == Tag.Unary) {
    let v = vConstEval(c, kidsOf(c.tree, node)[0], depth + 1)
    // Propagate the operand's verdict rather than flattening it: an overflow
    // deeper in the tree must still be reported as an overflow at the top, not
    // demoted to "not a constant expression" by the enclosing operator.
    if (!v.ok) { return v }
    let op = n.main
    if (op == int(Kind.Plus)) { return v }
    if (op == int(Kind.Minus)) {
      // `0 - MIN` is the one negation that leaves i64.
      if (v.kind == vcInt && v.ival == vI64Min()) { return vConstOver() }
      if (v.kind == vcInt) { return VConst{ ok: true, overflow: false, kind: vcInt, ival: 0 - v.ival, fval: 0.0 } }
      if (v.kind == vcFloat) { return VConst{ ok: true, overflow: false, kind: vcFloat, ival: 0, fval: 0.0 - v.fval } }
      return vConstNone()
    }
    if (op == int(Kind.Bang)) {
      if (v.kind != vcBool) { return vConstNone() }
      let b = 1
      if (v.ival != 0) { b = 0 }
      return VConst{ ok: true, overflow: false, kind: vcBool, ival: b, fval: 0.0 }
    }
    return vConstNone()
  }

  if (tag == Tag.Binary) {
    let k = kidsOf(c.tree, node)
    let a = vConstEval(c, k[0], depth + 1)
    if (!a.ok) { return a }   // propagates `overflow`; see the Unary arm
    let b = vConstEval(c, k[1], depth + 1)
    if (!b.ok) { return b }
    // §15.4 names string among the kinds whose literals "(and `const`
    // expressions over them)" are untyped constants, so `+` over two constant
    // strings is a constant expression and may initialize a top-level `const`
    // (#2295). It answers with the payload-less `vcString` — see that constant's
    // declaration: the only question the const path asks of a string is "is it
    // constant at all", and the VALUE is re-lowered from the initializer node at
    // each use site, never rendered from this struct.
    //
    // Nothing can turn that missing payload into a wrong byte image. The two
    // functions that DO render images refuse vcString outright
    // (lowerglobal.bit's moduleGlobalImage and constArrayImage), and a
    // module-level `let` never reaches this fold at all — §11.11's untraced-type
    // rule rejects a string first. Every other operator on strings falls through
    // to non-constant, which is what keeps `<`, `==` and the rest out.
    if (a.kind == vcString && b.kind == vcString) {
      if (n.main == int(Kind.Plus)) {
        return VConst{ ok: true, overflow: false, kind: vcString, ival: 0, fval: 0.0 }
      }
      return vConstNone()
    }
    // Integer operands only — the seed folds no float binary either, and
    // matching it matters more than folding more.
    if (a.kind != vcInt || b.kind != vcInt) { return vConstNone() }
    let op = n.main
    let x = a.ival
    let y = b.ival
    // §15.4: no wrapping. Only the three arithmetic operators are checked.
    //
    // `<<` IS DELIBERATELY EXCLUDED, and the exclusion is the interesting part.
    // `1 << 63` is how a top-bit mask is spelled — this compiler writes it
    // itself (compiler/x64value.bit's xF64SignMask) and #2265 exists to make
    // `let m: u64 = 1 << 63` work — so treating the sign bit as an overflow
    // would reject the idiom the operator is for. Shifting is bit placement,
    // not arithmetic; §13.5's wrap discussion is about the latter. The bitwise
    // operators below are exact for the same reason.
    if (op == int(Kind.Plus)) {
      if (vAddOverflows(x, y)) { return vConstOver() }
      return vConstInt(x + y)
    }
    if (op == int(Kind.Minus)) {
      if (vSubOverflows(x, y)) { return vConstOver() }
      return vConstInt(x - y)
    }
    if (op == int(Kind.Star)) {
      if (vMulOverflows(x, y)) { return vConstOver() }
      return vConstInt(x * y)
    }
    // `MIN / -1` is the one quotient that leaves i64 (+2^63 has no i64), and on
    // x86 it is a hardware trap rather than a wrap — so it must be caught before
    // the division, not judged after it. `%` shares the guard: the mathematical
    // answer is 0, but the same instruction computes both.
    if (op == int(Kind.Slash)) {
      if (y == 0) { return vConstNone() }
      if (x == vI64Min() && y == 0 - 1) { return vConstOver() }
      return vConstInt(x / y)
    }
    if (op == int(Kind.Percent)) {
      if (y == 0) { return vConstNone() }
      if (x == vI64Min() && y == 0 - 1) { return vConstInt(0) }
      return vConstInt(x % y)
    }
    if (op == int(Kind.Amp)) { return vConstInt(x & y) }
    if (op == int(Kind.Pipe)) { return vConstInt(x | y) }
    if (op == int(Kind.Caret)) { return vConstInt(x ^ y) }
    if (op == int(Kind.Shl)) {
      if (y < 0 || y > 127) { return vConstNone() }
      return vConstInt(x << y)
    }
    if (op == int(Kind.Shr)) {
      if (y < 0 || y > 127) { return vConstNone() }
      return vConstInt(x >> y)
    }
    return vConstNone()
  }

  if (tag == Tag.Ident) {
    return vConstIdent(c, text, depth)
  }

  // `ns.member` where `ns` is a namespace import (§17.3): the same imported
  // const as the bare form, spelled through the alias. `bindNamespaceImport`
  // registers every export under the dotted key, so once `nsQualifiedName` has
  // rebuilt that key the lookup is identical — an ordinary field or method
  // access returns "" here and falls through to non-constant, as before.
  if (tag == Tag.Member) {
    let key = nsQualifiedName(c, node)
    if (key == "") { return vConstNone() }
    return vConstIdent(c, key, depth)
  }

  return vConstNone()
}

// Folds a reference to a module-level `const` by NAME, following an import edge
// when the name is not declared here (§15.4 over §17.3: an exported `const` is a
// `const`, and nothing in the spec carves imported ones out of constant
// expressions).
//
// The owner is resolved exactly as lowerdriver.bit's ident path resolves it when
// it inlines an imported const at a use site — `declOwner` for the module,
// `declName2` for the name that module spells it by, since this one may have
// imported it under an alias. Folding then CONTINUES IN THE OWNER: an initializer
// like `1024 * KB` names `KB` in its own module, and evaluating it against the
// importer would resolve that name in the wrong scope.
//
// A local declaration wins over an import (declOwner's own rule), so a shadowing
// same-module const is still found first by the `vConstInitNode(c, ...)` above.
// Recursion is bounded by `vConstMaxDepth`, which also bounds an import cycle.
function vConstIdent(c: Checker, name: string, depth: int): VConst {
  let init = vConstInitNode(c, name)
  if (init != 0) { return vConstEval(c, init, depth + 1) }
  let oc = declOwner(c, name)
  if (oc.moduleId == c.moduleId) { return vConstNone() }
  let oinit = vConstInitNode(oc, declName2(c, name))
  if (oinit == 0) { return vConstNone() }
  return vConstEval(oc, oinit, depth + 1)
}

function vConstInt(v: int): VConst {
  return VConst{ ok: true, overflow: false, kind: vcInt, ival: v, fval: 0.0 }
}

// The real assignability entry point: `node` is the source expression being
// assigned or returned, used to range-check a direct integer literal against a
// sized target; falls back to `vAssignable` otherwise.
function vAssignableNode(c: Checker, node: int, src: int, dst: int): bool {
  if (src == 0 || dst == 0) { return true }
  if (src == c.ctx.untypedIntId || src == c.ctx.untypedRuneId) {
    if (c.ctx.types[dst].kind == TypeKind.Prim) {
      let lit = vLiteralValue(c, node)
      if (lit.ok) { return vRepresentable(c, lit.value, dst) }
      // SPEC §15.4: a `const` expression over untyped literals is ITSELF an
      // untyped constant, "usable in any type in which it is representable". So
      // `1 << 63` must adapt to a `u64` exactly as `5` adapts to an `i32`
      // (#2265). `vLiteralValue` deliberately reads one literal and no more, and
      // on declining, control fell to `vAssignable`, whose untyped branch accepts
      // only `defaultType(src) == dst` — i.e. i64 and nothing else. Every sized
      // integer type was therefore unreachable by any expression: `let b: i32 =
      // 2 + 3` was E0041 on the line after `let a: i32 = 5` was accepted.
      //
      // The folder is the one §11.11 already trusts, so `check` and `build`
      // cannot disagree about what folds (the #1430 divergence class). It is
      // also the folder #2261 taught to REFUSE an overflowing fold, which is
      // what keeps this from turning `let x: u8 = 200 + 200` into a silent 144:
      // an out-of-range result is still caught by `vRepresentable` below, and an
      // i64-overflowing one never reaches it.
      let folded = vConstEval(c, node, 0)
      if (folded.ok && folded.kind == vcInt) { return vRepresentable(c, folded.ival, dst) }
    }
  }
  return vAssignable(c, src, dst)
}

// Only a struct (or another interface value, or nil) can be the concrete type
// behind an interface — an interface value IS the receiver's object pointer
// (ABI.md §2.1, §14.3), so a scalar has nothing to point to.
// storableInInterface.
function vStorableInInterface(c: Checker, src: int): bool {
  if (src == 0 || src == c.ctx.untypedNilId) {
    return true
  }
  let k = c.ctx.types[src].kind
  return k == TypeKind.Struct || k == TypeKind.Interface || k == TypeKind.Invalid
}

// Emits E0041 with rendered expected/found type names. Every assignability
// failure funnels through here, so this is the one place that explains the
// struct-only interface rule (§14.3) — mirroring `mismatch`, whose
// generic "expected 'Any', found 'i64'" reads as nonsense for an empty interface
// a scalar structurally "fits".
function vMismatch(c: Checker, node: int, expected: int, found: int) {
  let en = typeName(c.ctx, expected)
  let fnd = typeName(c.ctx, found)
  if (c.ctx.types[expected].kind == TypeKind.Interface && !vStorableInInterface(c, found)) {
    report(c.diags, ecTypeMismatch, vSpan(c, node),
      "cannot store '${fnd}' in interface '${en}': only a struct can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a non-struct has nothing to point to (§14.3)")
    return
  }
  reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node), "expected '${en}', found '${fnd}'")
}

// Checks `node`'s type `ty` against `target`, emitting E0041 on failure.
// `target == 0` (invalid) means "no expectation" and is always a no-op, matching
// invalid's cascade-suppression contract.
function vExpect(c: Checker, node: int, ty: int, target: int) {
  if (target == 0) { return }
  if (!vAssignableNode(c, node, ty, target)) {
    vMismatch(c, node, target, ty)
  }
}

// The expectation-aware entry point: validates `node` against `want` in every
// context that has a declared target type (binding, return, argument).
//
// Why this exists rather than calling `vExpect` directly at each site: a bare
// `[a, b]` slice literal has no self-evident type. check.bit's `checkSliceLit`
// takes no expectation, so it always answers `[]E` with E defaulted from the
// FIRST element — `[1, 2]` is `[]i64` even where `[]i32` is wanted. Comparing
// that answer against the target rejects correct code (`function f(): []i32 {
// return [1,2] }`). The seed avoids this by threading `expected` into its
// checkSliceLit; the self-hosted split (inference in check.bit, diagnostics
// here) can't do that without an `expected` parameter on all of checkExprType,
// so the expectation is pushed into the literal's ELEMENTS here instead. Same
// rule, applied at the only place that knows the target.
//
// The array case is the #1470 divergence. SPEC.md §12.3: a bare `[ ... ]`
// element list IS a slice literal, and §22 defers "arrays are not yet
// constructible as values" — so `[N]T` is built only by the typed composite form
// `[N]T{...}` (§11.2). A bare list against an array annotation is therefore
// ILL-TYPED, which is what the seed has always said. Accepting it produced a
// silently wrong value (`arr[0] == 4.5` false, an f64 read through an f32 slot)
// and, on a length mismatch, a read of uninitialized heap.
function vExpectExpr(c: Checker, node: int, want: int) {
  if (want == 0 || node == 0) { return }
  // An interface target is NOT special-cased away: `vAssignable` already has the
  // §14.3 branch and `vMismatch` already renders its wording, so vExpect answers
  // it correctly AND also catches an unsatisfied method set, which `vIfaceStore`
  // does not. Skipping interfaces here silently dropped the seed's diagnostic on
  // `return 7` from an `Any` result (tests/cases/check_iface_scalar.bit) — the
  // return path has no vIface* rule to fall back on.
  if (getNode(c.tree, node).tag == Tag.SliceLit) {
    let wk = c.ctx.types[want].kind
    if (wk == TypeKind.Slice) {
      // Push the expectation down: each element against the declared element
      // type. Recursion handles `[][]i32` and a nested literal.
      let elem = c.ctx.types[want].elem
      for a of kidsOf(c.tree, node) {
        let e = a
        if (getNode(c.tree, e).tag == Tag.Arg) { e = kidsOf(c.tree, e)[0] }
        vExpectExpr(c, e, elem)
      }
      return
    }
    // Slice literal against an array (or anything else): report with the
    // literal's own inferred type, so the text matches the seed's
    // `expected '[2]f32', found '[]f64'` exactly.
    let got = checkExprType(c, node)
    // THE SAFETY RULE: an inference gap is undecidable, not an error.
    if (got == 0 || vMentionsInvalid(c, got, 0)) { return }
    vMismatch(c, node, want, got)
    return
  }
  vExpect(c, node, checkExprType(c, node), want)
}

