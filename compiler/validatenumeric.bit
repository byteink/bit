// Self-host: numeric-prim VALIDATION helpers (#5639, split out of
// validate.bit to keep it under the 800-line E0200 ceiling with zero
// headroom — see validate.bit's own header for the layer this belongs to).
// Sibling .bit file, same module: nothing here needs an import.
//
// Two halves: the prim-kind predicates (§5.3's decimal is its own family, not
// int and not float — vPrimIsInt/vPrimIsFloat deliberately exclude it) and
// the numeric RANGE/DIGITS rules §15.4 and §5.3 use to decide whether a
// literal or a constant fits its target — vPrimMin/vPrimMax's inclusive
// i8..u64 bounds, vSignificantDigits/vDecimalMaxDigits' digit count for a
// decimal literal, and vRepresentable/vUntypedIntFits/vDecimalLiteralFits,
// which apply those bounds to an actual value or literal node. vBoolAnswer is
// vUntypedIntFits' own tri-state helper and travels with it.

// ---- prim predicates --------------------
// Indexed by the seed's Prim order: 0..3 i8/i16/i32/i64, 4..7 u8/u16/u32/u64,
// 8..9 f32/f64, 10 bool, 11 string.

fn vPrimIsInt(p: int): bool {
  return p >= 0 && p <= 7
}

fn vPrimIsFloat(p: int): bool {
  return p == 8 || p == 9
}

// §5.3's `decimal` (prim 12, #3981). Its own scalar family of one: NOT an
// integer and NOT a float, so the two predicates above exclude it and every
// rule that admits a decimal says so by name. That is what keeps the implicit
// conversions out — `vAssignable` accepts a numeric pair only through those.
fn vPrimIsDecimal(p: int): bool {
  return p == 12
}

// Is `ty` the `decimal` prim?
fn vIsDecimalType(c: Checker, ty: int): bool {
  return c.ctx.types[ty].kind == TypeKind.Prim && vPrimIsDecimal(c.ctx.types[ty].prim)
}

// §5.3: the significant decimal digits a float literal spells — every digit
// from the first non-zero one on, ignoring the sign, the point and the leading
// zeros that carry no information (`0.0019` spells two, `19.99` four). An
// exponent ends the count: it scales the mantissa, it does not extend it.
fn vSignificantDigits(text: string): int {
  let digits = 0
  let seen = false
  let i = 0
  while (i < len(text)) {
    let ch = text[i]
    if (ch == 'e' || ch == 'E') {
      return digits
    }
    if (ch >= '0' && ch <= '9') {
      if (ch != '0') {
        seen = true
      }
      if (seen) {
        digits = digits + 1
      }
    }
    i = i + 1
  }
  return digits
}

// §5.3: a `decimal` holds a signed 128-bit mantissa, so ~28 significant digits.
fn vDecimalMaxDigits(): int {
  return 28
}

// Inclusive representable range for an integer prim (§15.4). Callers must gate
// on `vPrimIsInt` — a float/bool/string prim has no range (the seed's
// `unreachable`).
fn vPrimMin(p: int): int {
  if (p == 0) {
    return 0 - 128
  }
  if (p == 1) {
    return 0 - 32768
  }
  if (p == 2) {
    return 0 - 2147483648
  }
  if (p == 3) {
    return 0 - 9223372036854775807 - 1
  }
  return 0
}

fn vPrimMax(p: int): int {
  if (p == 0) {
    return 127
  }
  if (p == 1) {
    return 32767
  }
  if (p == 2) {
    return 2147483647
  }
  if (p == 4) {
    return 255
  }
  if (p == 5) {
    return 65535
  }
  if (p == 6) {
    return 4294967295
  }
  return 9223372036854775807
}

// ---- assignability (§14.2) -------------------------------------------------

// May `nil` occupy a slot of type `ty` (§13.4)? A bare type parameter cannot:
// only structs can satisfy a `<T: I>` bound (§10.4, methods attach to
// structs/aliases), and a class's zero value is never `nil`.
// A raw pointer's zero value is the null pointer (§11.4), so `nil` seeds it —
// the only literal that produces a `*T` value.
fn vIsNilable(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  return k == TypeKind.Slice ||
    k == TypeKind.Map ||
    k == TypeKind.Chan ||
    k == TypeKind.Func ||
    k == TypeKind.Interface ||
    k == TypeKind.Ptr
}

// Is `value` representable in `dst` (§15.4)?
fn vRepresentable(c: Checker, value: int, dst: int): bool {
  let t = c.ctx.types[dst]
  if (t.kind != TypeKind.Prim) {
    return false
  }
  if (vPrimIsFloat(t.prim)) {
    return true
  } // int constant widened to float
  // Every integer constant reaching here is representable in `decimal` (§5.3):
  // `value` is an i64 by construction — a wider literal is E0084 before any of
  // this runs — and 19 digits sit well inside the 28 a decimal holds. The digit
  // rule bites only on a FLOAT constant, which has no `value` here at all.
  if (vPrimIsDecimal(t.prim)) {
    return true
  }
  if (!vPrimIsInt(t.prim)) {
    return false
  }
  // ponytail: u64 goes unchecked. `int` is i64 here, so a u64 literal above
  // i64::max has already wrapped in `parseIntText` and would range-check as
  // negative — rejecting the crypto tables' 0xFFFFFFFFFFFFFFFF masks. Costs the
  // `let x: u64 = -1` diagnostic; needs an i128 literal path to do properly.
  if (t.prim == 7) {
    return true
  }
  return value >= vPrimMin(t.prim) && value <= vPrimMax(t.prim)
}

// The real assignability entry point: `node` is the source expression being
// assigned or returned, used to range-check a direct integer literal against a
// sized target; falls back to `vAssignable` otherwise.
// §15.4 + §5.3 (#3981): an untyped FLOAT constant is arbitrary precision until
// it is placed, so `let p: decimal = 19.99` is exact where `f64` is not — but
// only while it fits the 28 significant digits a decimal holds. The literal
// NODE is the only place those digits still exist (its checked type is just
// `untyped float`), which is why this lives on the node path.
//
// A source that is not a direct `FloatLit` keeps no digit text to judge, so it
// is accepted — the stance `vAssignableNode` already takes when
// `vLiteralValue` declines.
fn vDecimalLiteralFits(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.FloatLit) {
    return true
  }
  let sp = getNode(c.tree, node).span
  return vSignificantDigits(c.source[sp.start:sp.end]) <= vDecimalMaxDigits()
}

// §15.4's range check for an untyped INT or RUNE constant against a sized
// prim, and only that: 1 = fits, 0 = does not, -1 = this rule has no opinion
// and the caller must go on to §14.2's ordinary assignability. A pure move out
// of `vAssignableNode`, whose own McCabe count (spec/LINT.md E0204) has no room
// left; the three-way answer is what keeps the move exact, because a constant
// that does NOT fit is a definite no here, not a fall-through.
fn vUntypedIntFits(c: Checker, node: int, src: int, dst: int): int {
  if (src == c.ctx.untypedIntId || src == c.ctx.untypedRuneId) {
    if (c.ctx.types[dst].kind == TypeKind.Prim) {
      let lit = vLiteralValue(c, node)
      if (lit.ok) {
        return vBoolAnswer(vRepresentable(c, lit.value, dst))
      }
      // SPEC §15.4: a `const` expression over untyped literals is ITSELF an
      // untyped constant, "usable in any type in which it is representable". So
      // `1 << 63` must adapt to a `u64` exactly as `5` adapts to an `i32`
      // (#2265). `vLiteralValue` deliberately reads one literal and no more, and
      // on declining, control fell to `vAssignable`, whose untyped branch accepts
      // only `defaultType(src) == dst` — i.e. i64 and nothing else. Every sized
      // integer type was therefore unreachable by any expression: `let b: i32 =
      // 2 + 3` was E0041 on the line after `let a: i32 = 5` was accepted.
      //
      // The folder is the one §11.11 already trusts, so `check` and `build`
      // cannot disagree about what folds (the #1430 divergence class). It is
      // also the folder #2261 taught to REFUSE an overflowing fold, which is
      // what keeps this from turning `let x: u8 = 200 + 200` into a silent 144:
      // an out-of-range result is still caught by `vRepresentable` below, and an
      // i64-overflowing one never reaches it.
      let folded = vConstEval(c, node, 0)
      if (folded.ok && folded.kind == vcInt) {
        return vBoolAnswer(vRepresentable(c, folded.ival, dst))
      }
    }
  }
  return -1
}

// A definite yes/no as `vUntypedIntFits`'s tri-state.
fn vBoolAnswer(b: bool): int {
  if (b) {
    return 1
  }
  return 0
}
