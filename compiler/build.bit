// bit — the build half of the driver: the target selection, the IR pipeline,
// and the `build` / `run` / `ar` subcommands (`test` is testrun.bit, #2247).
// Split out of main.bit (#1503); a sibling .bit file is the same module, so
// nothing else changes.

// The native binary target `build` produces. `--target` cross-produces the
// others, which only their own host can execute. X86_64Windows has a real
// backend since #3349 (compiler/emitpecode.bit + compiler/pelink.bit) — see
// isWindowsTarget below.
enum BuildTarget {
  X86_64Linux,
  Aarch64Linux,
  Aarch64Macos,
  X86_64Windows,
}

// The BuildTarget named by a triple, or -1. Bit has no int->enum cast, so this
// returns an ordinal that buildTargetOf maps back (see elfLoKindIndex for the
// same shape); the round-trip is asserted in selfcheck.
fn parseBuildTarget(s: string): int {
  if (s == "x86_64-linux") {
    return 0
  }
  if (s == "aarch64-linux" || s == "arm64-linux") {
    return 1
  }
  if (s == "aarch64-macos" || s == "arm64-macos") {
    return 2
  }
  if (s == "x86_64-windows") {
    return 3
  }
  return -1
}

fn buildTargetOf(i: int): BuildTarget {
  if (i == 0) {
    return BuildTarget.X86_64Linux
  }
  if (i == 1) {
    return BuildTarget.Aarch64Linux
  }
  if (i == 2) {
    return BuildTarget.Aarch64Macos
  }
  return BuildTarget.X86_64Windows
}

fn buildTargetIndex(t: BuildTarget): int {
  if (t == BuildTarget.X86_64Linux) {
    return 0
  }
  if (t == BuildTarget.Aarch64Linux) {
    return 1
  }
  if (t == BuildTarget.Aarch64Macos) {
    return 2
  }
  return 3
}

// The default `build` target: the host this bit binary runs on. Bit has no
// compile-time `builtin.target` (the seed's source), so the ordinal comes from
// `hostTarget()` — a runtime primitive baked into the per-target libbitrt this
// binary is linked against. Correct on any host, so `bit build` needs no
// `--target` on its native platform (the #365 requirement).
fn hostBuildTarget(): BuildTarget {
  return buildTargetOf(hostTarget())
}

fn isMachoTarget(t: BuildTarget): bool {
  return t == BuildTarget.Aarch64Macos
}

// #4405: whether `t` returns a small multi-word aggregate in REGISTERS, which
// is what lets the lowerer hand one back as W independent words instead of as
// one handle to a heap box.
//
// True for the two AArch64 targets and, since #5868/#5869/#5870, for
// x86_64-linux. This is a claim about the target's ABI and about what this
// compiler's backend for it implements, and for all three it coincides:
// AAPCS64 returns the words in x0.. / d0.. (`retRegsFor`/`bindCallResults`/
// `emitMultiWordRet`, arm64.bit/arm64call.bit) and SysV in
// rax/rdx/rcx/rsi/rdi/r8/r9 and xmm0-xmm7 (`xRetRegsFor`/`xEmitMultiWordRet`,
// x64.bit/x64controlflow.bit; `xTakeCallResult`/`xEmitCallWords`,
// x64call.bit), both against the one target-independent budget
// `retWordsFitRegisters` reads (`maxRetIntWords()`/`maxRetFloatWords()`,
// lowerexplode.bit).
//
// x86_64-windows is FALSE and stands on its own: Win64 does not allow this
// convention at all, aggregate or not — a result wider than eight bytes goes
// back through a hidden pointer the caller supplies, which is a different
// calling convention rather than a wider one. Its own ticket (#5875) is what
// flips it, once that convention is built.
fn targetReturnsInRegisters(t: BuildTarget): bool {
  return t == BuildTarget.Aarch64Macos ||
    t == BuildTarget.Aarch64Linux ||
    t == BuildTarget.X86_64Linux
}

// #4316: whether FEAT_LSE (ARMv8.1-A single-instruction atomics: `ldaddal`,
// `ldclral`, `ldsetal`, `swpal`, `casal`) is guaranteed present on every CPU
// this target can run on. A BUILD-TIME answer, not a runtime probe: the
// alternative costs a load and a branch on the allocator's own fast path, which
// is the path the change exists to shorten.
//
// TRUE for aarch64-macos alone. macOS/arm64 runs on Apple silicon only, whose
// baseline is ARMv8.4-A or later, so FEAT_LSE is mandatory there — `sysctl
// hw.optional.arm.FEAT_LSE` reads 1 and clang emits `ldsetal`/`casal` on this
// target with no `-march` flag at all. That is what a guaranteed feature looks
// like from the host toolchain.
//
// FALSE for aarch64-linux, and this is the case that decides the shape. The
// Linux AArch64 baseline is ARMv8.0-A, where LSE is OPTIONAL — a Cortex-A53 or
// A72 (Raspberry Pi 4, the older AWS A1 fleet) has no LSE and executes one as an
// UNDEFINED INSTRUCTION, SIGILL, at the first atomic the runtime touches. A
// release that ships one binary per triple cannot make that trade on a guess, so
// aarch64-linux keeps the `ldaxr`/`stlxr` LL/SC retry loop unchanged and pays
// the exclusive monitor. Raising it needs either a stated ARMv8.1-A minimum for
// that target or an ifunc-style dispatch, and neither exists today.
//
// FALSE for both x86_64 targets because the question does not arise: they never
// reach the ARM64 backend.
fn arm64HasLse(t: BuildTarget): bool {
  return t == BuildTarget.Aarch64Macos
}

// #5820: whether `t` is compiled by the x86-64 backend, and therefore which
// arm of an `asm { arm64 {...} x64 {...} }` block its objects carry. The one
// place the answer is written: `setTargetArch` below hands it to the
// optimizer, and `checkTargetIsX64Policy` (opttargetcheck.bit) asserts it
// agrees with the object writer each target reaches.
fn targetIsX64(t: BuildTarget): bool {
  return t == BuildTarget.X86_64Linux || t == BuildTarget.X86_64Windows
}

// #5820: records `t`'s architecture on `m` for `foldTargetTests`
// (opttarget.bit), which sees no target. Shared by `lowerForTarget` and
// `--dump-ir` (main.bit's `lowerRootModuleIr`), so the dump folds exactly
// what a host build folds.
fn setTargetArch(m: IrModule, t: BuildTarget) {
  m.archKnown = true
  m.x64 = targetIsX64(t)
}

// isMachoTarget's false branch falls through to the ELF emitter, and
// elfTargetOf/elfLinkTargetOf below have no Windows case — every caller of
// isMachoTarget below must check this FIRST and route to emitPeObject/linkPe
// (compiler/emitpecode.bit, compiler/pelink.bit), never fall through to ELF
// codegen with a Windows target.
fn isWindowsTarget(t: BuildTarget): bool {
  return t == BuildTarget.X86_64Windows
}

// The ELF target for a Linux BuildTarget. Only ever called for one.
fn elfTargetOf(t: BuildTarget): ElfTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfTarget.X86_64
  }
  return ElfTarget.Aarch64
}

fn elfLinkTargetOf(t: BuildTarget): ElfLinkTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfLinkTarget.X86_64Linux
  }
  return ElfLinkTarget.Aarch64Linux
}

fn buildTargetName(t: BuildTarget): string {
  if (t == BuildTarget.X86_64Linux) {
    return "x86_64-linux"
  }
  if (t == BuildTarget.Aarch64Linux) {
    return "aarch64-linux"
  }
  if (t == BuildTarget.Aarch64Macos) {
    return "aarch64-macos"
  }
  return "x86_64-windows"
}

// Why the operand `src` cannot be a module, or "" when it can be. Phrased
// path-free: every caller renders `<tool>: <path>: <reason>`, matching
// `bit lint`'s existing shape, so the path is named exactly once.
//
// `loadProject` is tolerant of a root that names nothing BY CONSTRUCTION. Given
// `(dir, only)` it skips an `only` it cannot read (project.bit's `continue // on
// an unreadable file`), leaving a module with zero files that parses clean — so
// `p.root >= 0 && len(p.mods) > 0` holds for `/tmp/typo.bit` and the "not a
// module" guard below never fires. Nothing is parsed, and nothing downstream can
// tell "checked, found nothing wrong" from "never looked".
//
// Every command that reads an operand as a module inherited that hole and each
// told a different lie about the same input: `bit check` exited 0 in silence
// (#2394 — a renamed directory turned a CI gate green over zero files),
// `run`/`build` reached the EMITTER, found no `main` in the empty module, and
// blamed the absent file for having no entry point (#2234), and `bit test`
// printed "no tests in <missing file>" and exited 0.
//
// One decision, one place, because the callers must agree and used not to. The
// CLI is the layer that owes the user this message: `loadProject`'s tolerance is
// relied on elsewhere (the language server builds projects over unsaved buffers).
fn moduleRootProblem(src: string): string {
  if (!fsExists(src)) {
    return "no such file or directory"
  }
  // A file that exists IS its own module (SPEC §17.1), whatever it is named —
  // an unparseable one gets diagnostics, which is a different, correct answer.
  if (!fsIsDir(src)) {
    return ""
  }
  if (len(listBitFiles(src)) == 0) {
    return "no .bit source files in this directory"
  }
  return ""
}

// The refusal both emitters raise for a module with no entry point, rendered by
// the `catch` blocks below as `bit: <path>: <this>`.
//
// ONE definition, in the file that formats every other CLI line, because the
// text used to be the bare identifier `newError("NoMain")` written twice —
// compiler/emitelf.bit and compiler/emitmacho.bit — so a fix to one copy left
// the other shipping an internal enum name to users (#2234). Shaped like
// `bit test`'s existing "no tests in x (a test is a 'test "name" { }'
// declaration in a .test.bit file)": name what was not found, then show
// what one is.
fn noMainMessage(): string {
  return "no `main` in this module (an entry point is a top-level `fn main()`)"
}

// `testBuild` (#2985): `bit test` compiles the package under test AS ROOT too
// — that is what lets `injectTestMain` (testgen.bit) discover the package's
// own `.test.bit` functions (§19, "never in an imported one") — so a
// root-level name that collides with a linked extern is exactly as real a
// hazard here as it is for `bit build`/`bit run`. `testBuild` does not
// exempt it: `rejectRootNameCollision`'s own scan (`collidingRootDecls`)
// still runs, and the result still gets fixed rather than ignored — it is
// handed to `demangleTestRootCollisions` (testgen.bit) AFTER lowering,
// instead of being reported and refused. false for every other caller, which
// keeps `bit build`/`bit run`/`bit check`/`--emit-obj` on the unchanged
// reject-and-fail path.
fn buildIr(
  src: string,
  target: BuildTarget,
  freestanding: bool,
  rtArchive: []u8,
  linking: bool,
  testBuild: bool,
): IrModule! {
  // Ahead of the loader, so a `main` that was never looked for is never reported
  // missing. See moduleRootProblem: `bit run mian.bit` used to say `NoMain`.
  let problem = moduleRootProblem(src)
  if (problem != "") {
    fail newError(problem)
  }
  let rootDir = src
  let rootOnly = ""
  if (!fsIsDir(src)) {
    rootDir = pathDir(src)
    rootOnly = pathBase(src)
  }
  // #2254: bit.json vs bit.lock, before anything else project-related — a
  // manifest problem is cheaper to detect than a package fetch and should
  // never be masked by one. See `manifestLockProblem` (projectpkg.bit) for
  // exactly what this does and does not catch.
  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  let manifestProblem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (manifestProblem != "") {
    fail newError(manifestProblem)
  }
  // #5711/#5713: bit.json's root-only "link" array. rootDir is buildIr's own
  // root, never a path loadProject recurses into for a dependency's own
  // directory — that IS the root-only enforcement (buildlink.bit's header).
  let extraArchives = resolveLinkArchives(rootDir)?
  // §17.6: freestanding withholds the stdlib root entirely, and that IS the
  // mechanism — loadProject loads the prelude FROM that root, so an empty root
  // means no prelude and no resolvable `std/*` import. A module reaching for
  // `println` then fails in the resolver with an ordinary undefined-name
  // diagnostic, because the name genuinely is not in scope. The managed/
  // unmanaged boundary is enforced by absence, not by a list of banned names
  // the checker would have to keep in sync with the prelude.
  let stdRoot = stdRootPath()
  if (freestanding) {
    stdRoot = ""
  }
  let p = loadProject(rootDir, rootOnly, stdRoot)
  if (p.root < 0 || len(p.mods) == 0) {
    fail newError("not a module: ${src}")
  }
  // Lex/parse errors first and alone: a tree the parser recovered through has
  // holes the checker reads as real nodes, so its errors would be noise on top
  // of the ones that caused them. The seed stops here for the same reason.
  if (reportCheckErrors(p.diags)) {
    fail newError("check failed")
  }
  let mods = checkProject(p)
  // The target gate reports into the same sink, so an E0078 renders beside any
  // check error rather than after a second, separate failure.
  rejectExternForTarget(p, target, rtArchive, extraArchives, linking)
  // Same sink, same reason (#2958): a root-module name that collides with a
  // linked extern renders beside E0078 and every check error too — UNLESS
  // this is `bit test`'s own build, where the collision is real but the fix
  // is a rename (below) rather than a refusal (#2985).
  let testCollisions = rootCollisionNames(mods[p.root], target, rtArchive, linking, testBuild)
  // Final gate: renders a warnings-only sink too (#2491), unlike the lex/parse
  // gate above.
  if (reportCheckDiagnostics(p.diags)) {
    fail newError("check failed")
  }
  let module = lowerForTarget(mods, p.root, target, freestanding)
  // Lowering has now given every function its real link name, so a collision
  // this build tolerated can be renamed exactly once, everywhere it appears
  // (demangleTestRootCollisions, testgen.bit).
  if (len(testCollisions) > 0) {
    demangleTestRootCollisions(module, testCollisions)
  }
  // lowerProject has no manifest field to thread through; set after the
  // fact, same as demangleTestRootCollisions above.
  module.linkArchives = extraArchives
  return module
}

// `lowerProject` for `target`, plus the per-target decisions `optimizeModule`
// reads off the module because it never sees a target: the `%` lowering
// (`remTakesMagic`, #5792) and the `onX64()` fold (`setTargetArch`, #5820).
// The one place a real build's module gets them, so
// no caller can lower for one target and optimize for another.
fn lowerForTarget(mods: []Checker, root: int, target: BuildTarget, freestanding: bool): IrModule {
  let m = lowerProject(mods, root, targetReturnsInRegisters(target), freestanding)
  m.remMagic = remTakesMagic(target)
  setTargetArch(m, target)
  return m
}

// E0092: first free code above E0091 (validateloop.bit's ecForIn). Unlike
// every other code in the 40-91 block, this one is not a CHECK-time
// rejection — `bit check` accepts the program; this is `bit build`'s
// refusal when a construct the checker admitted still defeats the lowerer
// (#2189). See StubbedFn (compiler/ir.bit) for the {name, span, reason} this
// renders, and the three guards below and in testrun.bit for where it fires.
//
// cannot lower function: the compiler cannot generate code for this
// construct, so it refuses to emit a binary.
const ecCannotLower = 92

// Renders one standard `error[E0092]` diagnostic per `module.stubbed` entry —
// code, `--> file:line:col`, source excerpt and a caret under the construct
// that defeated the lowerer — in place of the bare function-name list this
// used to print (#2189). Shared by the three sites that refuse a module with
// any stub: the two guards below and testrun.bit's, so the three render
// identically and cannot drift.
fn renderStubbed(module: IrModule) {
  for s of module.stubbed {
    eprint(
      renderOne(
        module.sm,
        Diagnostic{
          severity = 0, code = ecCannotLower, span = s.span,
          message = "cannot lower ${s.reason}", hint = "", hasHint = false, hasCode = true,
        },
      ),
    )
    // #4553: a refusal reached from a generic's monomorphization carries a
    // note pointing at the call that asked for that specialisation — the same
    // secondary-span shape #3827 renders for E0073, and the only part of this
    // message that names a file the reader can edit. Severity 2 and no code:
    // a note is not a second error and must not read as one.
    if (s.note != "") {
      eprint(
        renderOne(
          module.sm,
          Diagnostic{
            severity = 2, code = 0, span = s.noteSite,
            message = s.note, hint = "", hasHint = false, hasCode = false,
          },
        ),
      )
    }
  }
}

// Compiles `src` to a relocatable OBJECT at `out` (#1397): no `main` required,
// no entry trampoline, no runtime archive read, nothing linked. This is the
// half of the toolchain that feeds `bit ar`. Returns false on any failure
// (already reported).
fn buildObjCmd(
  src: string,
  out: string,
  target: BuildTarget,
  freestanding: bool,
  debug: bool,
  noOptimize: bool,
): bool {
  let module = buildIr(src, target, freestanding, []u8(0), false, false) catch e {
    eprint("bit: ${src}: ${e.message()}\n")
    return false
  }
  // -O1 (#1448): the seed runs this on every emit path and codegen depends on
  // it — see writeModuleExe for why an unoptimized module is not merely slower.
  // --no-optimize (#3535) skips it, for #2607's -O0/-O1 differential fuzzer.
  if (!noOptimize) {
    optimizeModule(module, debug)
  }
  // Same refusal as writeModuleExe: a signature-only stub computes nothing, so
  // an object containing one would silently link into a wrong program.
  if (len(module.stubbed) > 0) {
    eprint("bit: ${src}: refusing to emit an object\n")
    renderStubbed(module)
    return false
  }
  // The block-boundary invariant (#1925). A function whose IR names a value
  // from another block without receiving it as a block argument is
  // MISCOMPILED, silently — the register allocator has no live interval
  // covering that use. Refused here alongside the stub check because both
  // answer the same question: is this module safe to emit at all.
  if (!verifyModuleOk(module, src, "emit an object")) {
    return false
  }
  let obj = []u8(0)
  if (isMachoTarget(target)) {
    obj = emitMachoObject(module, false, freestanding, debug) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
  } else if (isWindowsTarget(target)) {
    obj = emitPeObject(module, false, freestanding, debug) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
  } else {
    obj = emitElfObject(module, elfTargetOf(target), false, freestanding, debug) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
  }
  writeFile(out, string(obj)) catch e {
    eprint("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  return true
}

// Compiles `src` (a file or a project directory) to a native executable at
// `out`. Returns false on any failure (already reported). `exclusive`
// (#5789) is `writeModuleExe`'s own flag, threaded through unchanged: true
// for `runCmd`'s scratch temp file, false for a user-named `bit build -o
// out` that expects to replace whatever is already there.
fn buildCmd(
  src: string,
  out: string,
  target: BuildTarget,
  debug: bool,
  noOptimize: bool,
  exclusive: bool,
): bool {
  // Read before the front end, not after it: the archive is what decides
  // §11.7's E0078 (a symbol it defines is linkable, one it does not is not), so
  // the gate inside `buildIr` needs it, and the link below needs the same bytes.
  // One read, one source of truth. Mirrors the seed, which reads the archive in
  // `main` ahead of `buildModule`.
  let rtPath = libbitrtPath(target)
  let rt = readRtArchive(rtPath) catch e {
    eprint("bit: runtime archive ${rtPath}: ${e.message()}\n")
    return false
  }
  let module = buildIr(src, target, false, rt, true, false) catch e {
    eprint("bit: ${src}: ${e.message()}\n")
    return false
  }
  return writeModuleExe(module, src, out, target, rt, debug, noOptimize, exclusive)
}

// The runtime archive's bytes at `path` (from `libbitrtPath`). Takes the
// already-resolved path, not a target, so a caller resolves it exactly once
// and reports the SAME string on failure — `libbitrtPath` probes the
// filesystem (`resolveNearExe`), and calling it a second time to build the
// error message let the two calls observe different disk state and report a
// path that was never the one actually opened (#5114).
fn readRtArchive(path: string): []u8! {
  return []byte(readFile(path)?)
}

// Emits an object for `target` and links it into an executable's bytes.
// Split out of writeModuleExe so the per-target dispatch (which differs in
// object format, static-data placement, and linker image) reads as one unit.
// The error message carries the SAME context writeModuleExe used to print
// directly ("${src}: ..." for an emit failure, "link ${out}: ..." for a link
// failure) so hoisting it here changes no observable text, only who prints it.
// The Mach-O link inputs: the compiled object, then libbitrt.a, then one
// archive input per entry of bit.json's "link" array (`module.linkArchives`,
// #5711/#5713), in that order. Order is resolution precedence, not just
// argument order: `linkMacho` resolves earlier inputs first (macholink.bit),
// so a name libbitrt.a already defines is bound to the RUNTIME's definition
// and an external archive can never shadow it — only a name libbitrt.a does
// NOT define can come from an external archive instead.
fn meLinkInputsFor(obj: []u8, rt: []u8, module: IrModule): []MeInput {
  let inputs = [meObjectInput(obj), meArchiveInput(rt)]
  let i = 0
  while (i < len(module.linkArchives)) {
    inputs = append(inputs, meArchiveInput(module.linkArchives[i]))
    i = i + 1
  }
  return inputs
}

// Windows twin of meLinkInputsFor, over PlLinkInput. Same resolution order.
fn plLinkInputsFor(obj: []u8, rt: []u8, module: IrModule): []PlLinkInput {
  let inputs = [plObjectInput(obj), plArchiveInput(rt)]
  let i = 0
  while (i < len(module.linkArchives)) {
    inputs = append(inputs, plArchiveInput(module.linkArchives[i]))
    i = i + 1
  }
  return inputs
}

// Linux twin of meLinkInputsFor, over ElfLinkInput. Same resolution order.
fn elfLinkInputsFor(obj: []u8, rt: []u8, module: IrModule): []ElfLinkInput {
  let inputs = [
    ElfLinkInput{ isArchive = false, bytes = obj },
    ElfLinkInput{ isArchive = true, bytes = rt },
  ]
  let i = 0
  while (i < len(module.linkArchives)) {
    inputs = append(inputs, ElfLinkInput{ isArchive = true, bytes = module.linkArchives[i] })
    i = i + 1
  }
  return inputs
}

fn emitAndLinkExe(
  module: IrModule,
  src: string,
  out: string,
  rt: []u8,
  target: BuildTarget,
  debug: bool,
): []u8! {
  if (isMachoTarget(target)) {
    let obj = emitMachoObject(module, true, false, debug) catch e {
      fail newError("${src}: ${e.message()}")
    }
    // §11.7 externs are the only names this program may leave for dyld; the
    // linker refuses anything else it left undefined rather than shipping a
    // binary that dies at load (#1445).
    return linkMacho(
      meLinkInputsFor(obj, rt, module),
      pathStem(out), machoImportNames(module),
    ) catch e {
      fail newError("link ${out}: ${e.message()}")
    }
  }
  if (isWindowsTarget(target)) {
    let obj = emitPeObject(module, true, false, debug) catch e {
      fail newError("${src}: ${e.message()}")
    }
    // §11.7 externs are the only names left undefined for the loader; no
    // decoration (unlike machoImportNames) since x64 COFF names them verbatim.
    return linkPe(
      plLinkInputsFor(obj, rt, module),
      module.externNames,
    ) catch e {
      fail newError("link ${out}: ${e.message()}")
    }
  }
  let obj = emitElfObject(module, elfTargetOf(target), true, false, debug) catch e {
    fail newError("${src}: ${e.message()}")
  }
  return linkElfExecutable(
    elfLinkTargetOf(target),
    elfLinkInputsFor(obj, rt, module),
  ) catch e {
    fail newError("link ${out}: ${e.message()}")
  }
}

// Emits, links, and writes a lowered module to a native executable at `out`.
// Split out of buildCmd so `bit test` can inject its synthetic `main` into the
// module first. Returns false on any failure (already reported).
//
// `exclusive` (#5789): true for an EPHEMERAL scratch path nothing but this
// process is meant to occupy (`bit run`/`bit test`'s nonce-keyed temp file)
// -- `out` is refused outright if anything already sits there, and created
// at its final mode in one call, never truncated or followed and never
// observable at a wider mode. False is the pre-#5789, still-correct
// contract for `bit build -o out`: the caller named `out` themselves and
// expects a repeated build to replace it. See `writeExeBytes` below.
fn writeModuleExe(
  module: IrModule,
  src: string,
  out: string,
  target: BuildTarget,
  rt: []u8,
  debug: bool,
  noOptimize: bool,
  exclusive: bool,
): bool {
  // -O1 (#1448). `optimizeModule` was reachable ONLY from `--dump-ir`, so every
  // binary the self-hosted compiler produced was built from raw lowering while
  // the IR differentials compared optimized dumps — the gap was invisible to
  // every gate by construction.
  //
  // This is not just a quality knob. `rebuild` renumbers blocks into the linear
  // schedule (ascending `instsStart`), and TWO codegen passes assume block id ==
  // position in that schedule: `isBackEdge` (`target <= curBlock`), which decides
  // where a GC safepoint poll goes, and the x64 linear-scan interval numbering.
  // Raw lowering IDs a loop's exit block BEFORE the body it is emitted after, so
  // without this call the else arm of an `if/else` in a loop looked like a
  // back-edge and got a spurious poll (~2x collector work, 81 corpus files).
  //
  // Called here rather than in `buildIr` so `bit test`'s injected `main` is
  // optimized too (this runs after `injectTestMain`).
  //
  // --no-optimize (#3535) skips it for #2607's -O0/-O1 differential fuzzer.
  // The block-id/schedule assumption above is a real, unverified risk on this
  // path — the caller is responsible for treating a --no-optimize build as
  // suspect until it is run and checked, not just compiled.
  if (!noOptimize) {
    optimizeModule(module, debug)
  }
  // A signature-only stub computes nothing and returns garbage. Emitting one
  // would hand back a binary that silently gives wrong answers, so refuse — the
  // construct it choked on has to be reported, not shipped.
  if (len(module.stubbed) > 0) {
    eprint("bit: ${src}: refusing to emit a binary\n")
    renderStubbed(module)
    return false
  }
  if (!verifyModuleOk(module, src, "emit a binary")) {
    return false
  }
  let exe = emitAndLinkExe(module, src, out, rt, target, debug) catch e {
    eprint("bit: ${e.message()}\n")
    return false
  }
  return writeExeBytes(out, exe, exclusive)
}

// The write half of `writeModuleExe`, split out so that function's own
// branching stays under this file's complexity ceiling (#5789). `exclusive`
// true: `out` must not already exist -- `createScratchExecutable` refuses a
// pre-existing file, directory or symlink outright and creates at 0700 in
// the same call, so there is never a wider-mode or truncate/follow window.
// `exclusive` false: the original `bit build -o out` contract -- overwrite
// whatever is there, `writeFile` leaves 0o644, then `fsChmod` widens it to
// 0755 so the kernel will exec it.
fn writeExeBytes(out: string, exe: []u8, exclusive: bool): bool {
  if (exclusive) {
    let f = createScratchExecutable(out) catch e {
      eprint("bit: cannot write ${out}: ${e.message()}\n")
      return false
    }
    f.write(string(exe)) catch e {
      eprint("bit: cannot write ${out}: ${e.message()}\n")
      f.close()
      return false
    }
    f.close()
    return true
  }
  writeFile(out, string(exe)) catch e {
    eprint("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  // A binary the kernel refuses to exec is not a build. writeFile leaves 0o644.
  if (fsChmod(out, 493) != 0) { // 0o755
    eprint("bit: cannot make ${out} executable\n")
    return false
  }
  return true
}

