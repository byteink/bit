// bit — the build half of the driver: the target selection, the IR pipeline,
// and the `build` / `run` / `ar` subcommands (`test` is testrun.bit, #2247).
// Split out of main.bit (#1503); a sibling .bit file is the same module, so
// nothing else changes.

// The native binary target `build` produces. `--target` cross-produces the
// others, which only their own host can execute.
enum BuildTarget {
  X86_64Linux,
  Aarch64Linux,
  Aarch64Macos,
}

// The BuildTarget named by a triple, or -1. Bit has no int->enum cast, so this
// returns an ordinal that buildTargetOf maps back (see elfLoKindIndex for the
// same shape); the round-trip is asserted in selfcheck.
fn parseBuildTarget(s: string): int {
  if (s == "x86_64-linux") { return 0 }
  if (s == "aarch64-linux" || s == "arm64-linux") { return 1 }
  if (s == "aarch64-macos" || s == "arm64-macos") { return 2 }
  return -1
}

fn buildTargetOf(i: int): BuildTarget {
  if (i == 0) { return BuildTarget.X86_64Linux }
  if (i == 1) { return BuildTarget.Aarch64Linux }
  return BuildTarget.Aarch64Macos
}

fn buildTargetIndex(t: BuildTarget): int {
  if (t == BuildTarget.X86_64Linux) { return 0 }
  if (t == BuildTarget.Aarch64Linux) { return 1 }
  return 2
}

// The default `build` target: the host this bit binary runs on. Bit has no
// compile-time `builtin.target` (the seed's source), so the ordinal comes from
// `hostTarget()` — a runtime primitive baked into the per-target libbitrt this
// binary is linked against. Correct on any host, so `bit build` needs no
// `--target` on its native platform (the #365 requirement).
fn hostBuildTarget(): BuildTarget {
  return buildTargetOf(hostTarget())
}

fn isMachoTarget(t: BuildTarget): bool {
  return t == BuildTarget.Aarch64Macos
}

// The ELF target for a Linux BuildTarget. Only ever called for one.
fn elfTargetOf(t: BuildTarget): ElfTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfTarget.X86_64
  }
  return ElfTarget.Aarch64
}

fn elfLinkTargetOf(t: BuildTarget): ElfLinkTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfLinkTarget.X86_64Linux
  }
  return ElfLinkTarget.Aarch64Linux
}

fn buildTargetName(t: BuildTarget): string {
  if (t == BuildTarget.X86_64Linux) { return "x86_64-linux" }
  if (t == BuildTarget.Aarch64Linux) { return "aarch64-linux" }
  return "aarch64-macos"
}

// Builds `src`'s IR. A directory and a lone file are both modules (SPEC §17.1),
// so both take the same project pipeline and both get the stdlib and its
// prelude; a file differs only in that its module holds exactly that one file,
// never its siblings. Mirrors the seed's `runBuild` — building a lone file as a
// self-contained module instead is what made `println` undefined there.
// E0078 (§11.7): an `extern function` binds a Bit name to a raw external symbol.
// On Mach-O that symbol is bound by dyld at load time, so the image has TWO
// sources for it — the merged archive and libSystem — and admissible means "in
// one of them", not "anything" (#1634). Bit's ELF output has no load-time
// resolution at all — no interpreter, no dynamic symbol table, no libc — but
// that is not the same as NO resolution: the static link already merges
// libbitrt.a, and a symbol DEFINED INSIDE THAT ARCHIVE resolves through the very
// same global symbol table as the runtime's own calls.
//
// So the predicate is where a symbol may come from, not the platform. A symbol
// present in the archive is accepted; one that is absent is still rejected here,
// with a real diagnostic naming it, rather than failing deep inside the linker.
// An empty or malformed `rtArchive` in a LINKING build leaves membership
// undecided, and an undecided case must REJECT — accepting on unknown would
// trade a compile error for a link error or a silent crash.
//
// Darwin has a SECOND legitimate source and therefore a WIDER predicate, not no
// predicate (#1634): the LC_LOAD_DYLIB libSystem every Mac carries, which is the
// whole reason §11.7 exists. Its surface is libsystemSymbols(), so a Darwin
// extern is admissible when the archive defines it OR libSystem exports it. A
// name in NEITHER used to be accepted here and then aborted at dyld load.
//
// `linking` is false for `--emit-obj`, and the gate then does not apply at all
// (#1645). Membership is a property of a LINK, and an object emit performs none:
// the artifact is a relocatable, whose undefined symbols are normal and are
// resolved by whatever link later consumes it — §17.6 already says an extern
// call in a freestanding object "stays an undefined relocation, resolved at
// link". Answering "absent" there is not conservatism, it is a category error:
// the archive was never read, so the diagnostic's own stated precondition ("not
// defined in the runtime archive") is false when it fires, and it fires for
// EVERY extern including the `bit_rt_*` ones §11.7 exists to admit. Nothing is
// weakened by skipping it, because both later gates remain: the linking build
// re-runs this predicate against the real archive, and a static ELF link that
// cannot resolve a reference fails outright (resolveGlobals -> undefined symbol).
//
// The gate lives here rather than in the checker because the checker is
// deliberately target-independent (it runs once and its output feeds every
// backend); this is the first point where the selected target and the AST are
// both in hand, and the archive path is a pure function of the target. Mirrors
// the seed's rejectExternForTarget.
fn rejectExternForTarget(p: Project, target: BuildTarget, rtArchive: []u8, linking: bool): bool {
  if (!linking) { return false }
  // Project-wide, not per-module: a §11.9 pin in one module is what resolves an
  // `extern` in another (tests/stress/pinsym is exactly that shape), and the
  // link merges them all.
  let pins = collectPinnedSymbols(p)
  let found = false
  let mi = 0
  while (mi < len(p.mods)) {
    let m = p.mods[mi]
    // A module's files are concatenated, so every tree span is module-global.
    // Mark the sink, report, then map this module's new spans back onto the file
    // each one's text actually came from — exactly what the loader does.
    let before = len(p.diags.list)
    for top of kidsOf(m.tree, m.tree.root) {
      if (top == 0) { continue }
      let inner = top
      if (getNode(m.tree, top).tag == Tag.Export) {
        inner = kidsOf(m.tree, top)[0]
      }
      if (getNode(m.tree, inner).tag != Tag.ExternFnDecl) { continue }
      // §11.7: an extern's Bit name IS the symbol, verbatim and never
      // module-qualified, so the declaration's identifier is exactly what the
      // linker will look for.
      let nameNode = kidsOf(m.tree, inner)[0]
      let nameSpan = getNode(m.tree, nameNode).span
      let symbol = m.source[nameSpan.start:nameSpan.end]
      // §10: `bit_main` is the process entry symbol, emitted per-program by the
      // entry trampoline (emit.bit) and resolved at the FINAL program link — it
      // is deliberately absent from libbitrt.a (`nm` shows `U bit_main`). The
      // ported boot layer (#1608), itself a libbitrt-resident module,
      // references it to spawn the user's `main`; every final link defines it,
      // so admitting this one designated symbol is not a hole in the gate. The
      // allowance is exactly this symbol — every other absent name is still
      // rejected, because the guarantee is specific to the entry, not to
      // externs at large.
      if (symbol == "bit_main") { continue }
      if (externResolvable(target, rtArchive, symbol, pins)) { continue }
      let what = "is not defined in the runtime archive for target"
      let note = "the Linux output is fully static: only a symbol already inside libbitrt.a can be resolved"
      if (target == BuildTarget.Aarch64Macos) {
        what = "is defined neither in the runtime archive nor by libSystem, for target"
        note = "dyld would bind it to libSystem and abort at load: only a symbol inside libbitrt.a or exported by libSystem can be resolved"
      }
      report(p.diags, ecExternUnsupportedTarget, getNode(m.tree, inner).span,
        "'extern function' ${symbol} ${what} ${buildTargetName(target)}", note)
      found = true
    }
    remapDiags(p.diags, before, m.files, m.fileStarts)
    mi = mi + 1
  }
  return found
}

// Whether the link this build is about to perform can resolve `symbol`, per
// SPEC §11.7. One function so the two targets' answers cannot drift into two AST
// walks: what differs between them is only where a symbol may legitimately come
// from.
//
//   - Every target: a §11.9 pin one of this build's own modules defines
//     (`pins`) — the final link resolves it out of the program's own object,
//     exactly the way `bit_main` is resolved above.
//   - Linux: otherwise the merged libbitrt.a, and nothing else — the image is
//     static, with no interpreter and no dynamic symbol table.
//   - Darwin: otherwise that same archive OR libSystem, which the Mach-O image
//     loads as LC_LOAD_DYLIB and dyld binds at load.
//
// Undecidable inputs (an empty or malformed archive) answer false on both, so
// the caller rejects — the sound direction, since accepting on unknown trades a
// compile error for a crash. The pin lookup runs first because it is O(1) while
// archiveDefines reparses every archive member, and a pinned name is by design
// absent from the archive. Mirrors the seed's externResolvable.
fn externResolvable(target: BuildTarget, rtArchive: []u8, symbol: string,
    pins: map<string, bool>): bool {
  let (_, pinned) = pins[symbol]
  if (pinned) { return true }
  if (target == BuildTarget.Aarch64Macos) {
    if (machoArchiveDefines(rtArchive, symbol)) { return true }
    return libsystemDefines(symbol)
  }
  return archiveDefines(elfLinkTargetOf(target), rtArchive, symbol)
}

// Every §11.9 @symbol("...") on a top-level declaration of this build's modules.
// An `extern` naming one is resolved by the final link out of the program's own
// object, so it is admissible even though no archive defines it. Mirrors the
// seed's collectPinnedSymbols.
fn collectPinnedSymbols(p: Project): map<string, bool> {
  let out = map<string, bool>{}
  let mi = 0
  while (mi < len(p.mods)) {
    let m = p.mods[mi]
    for top of kidsOf(m.tree, m.tree.root) {
      if (top == 0) { continue }
      let inner = top
      if (getNode(m.tree, top).tag == Tag.Export) {
        inner = kidsOf(m.tree, top)[0]
      }
      if (getNode(m.tree, inner).tag != Tag.FuncDecl) { continue }
      for kid of kidsOf(m.tree, inner) {
        if (kid == 0) { continue }
        if (getNode(m.tree, kid).tag != Tag.AttrList) { continue }
        for a of kidsOf(m.tree, kid) {
          let ak = kidsOf(m.tree, a) // [nameIdent, argStringLit?]
          if (len(ak) < 2) { continue }
          if (ak[1] == 0) { continue }
          let nameSpan = getNode(m.tree, ak[0]).span
          if (m.source[nameSpan.start:nameSpan.end] != "symbol") { continue }
          let argSpan = getNode(m.tree, ak[1]).span
          let raw = m.source[argSpan.start:argSpan.end]
          // The literal minus its quotes. §11.9 symbol names are C identifiers,
          // so there is nothing to unescape.
          if (len(raw) < 2) { continue }
          out[raw[1:len(raw) - 1]] = true
        }
      }
    }
    mi = mi + 1
  }
  return out
}

// Why the operand `src` cannot be a module, or "" when it can be. Phrased
// path-free: every caller renders `<tool>: <path>: <reason>`, matching
// `bit lint`'s existing shape, so the path is named exactly once.
//
// `loadProject` is tolerant of a root that names nothing BY CONSTRUCTION. Given
// `(dir, only)` it skips an `only` it cannot read (project.bit's `continue // on
// an unreadable file`), leaving a module with zero files that parses clean — so
// `p.root >= 0 && len(p.mods) > 0` holds for `/tmp/typo.bit` and the "not a
// module" guard below never fires. Nothing is parsed, and nothing downstream can
// tell "checked, found nothing wrong" from "never looked".
//
// Every command that reads an operand as a module inherited that hole and each
// told a different lie about the same input: `bit check` exited 0 in silence
// (#2394 — a renamed directory turned a CI gate green over zero files),
// `run`/`build` reached the EMITTER, found no `main` in the empty module, and
// blamed the absent file for having no entry point (#2234), and `bit test`
// printed "no tests in <missing file>" and exited 0.
//
// One decision, one place, because the callers must agree and used not to. The
// CLI is the layer that owes the user this message: `loadProject`'s tolerance is
// relied on elsewhere (the language server builds projects over unsaved buffers).
fn moduleRootProblem(src: string): string {
  if (!fsExists(src)) {
    return "no such file or directory"
  }
  // A file that exists IS its own module (SPEC §17.1), whatever it is named —
  // an unparseable one gets diagnostics, which is a different, correct answer.
  if (!fsIsDir(src)) {
    return ""
  }
  if (len(listBitFiles(src)) == 0) {
    return "no .bit source files in this directory"
  }
  return ""
}

// The refusal both emitters raise for a module with no entry point, rendered by
// the `catch` blocks below as `bit: <path>: <this>`.
//
// ONE definition, in the file that formats every other CLI line, because the
// text used to be the bare identifier `newError("NoMain")` written twice —
// compiler/emitelf.bit and compiler/emitmacho.bit — so a fix to one copy left
// the other shipping an internal enum name to users (#2234). Shaped like
// `bit test`'s existing "no tests in x (a test is a top-level
// `function test_<name>()`)": name what was not found, then show what one is.
fn noMainMessage(): string {
  return "no `main` in this module (an entry point is a top-level `fn main()`)"
}

fn buildIr(src: string, target: BuildTarget, freestanding: bool, rtArchive: []u8, linking: bool): IrModule! {
  // Ahead of the loader, so a `main` that was never looked for is never reported
  // missing. See moduleRootProblem: `bit run mian.bit` used to say `NoMain`.
  let problem = moduleRootProblem(src)
  if (problem != "") {
    fail newError(problem)
  }
  let rootDir = src
  let rootOnly = ""
  if (!fsIsDir(src)) {
    rootDir = pathDir(src)
    rootOnly = pathBase(src)
  }
  // #2254: bit.json vs bit.lock, before anything else project-related — a
  // manifest problem is cheaper to detect than a package fetch and should
  // never be masked by one. See `manifestLockProblem` (project.bit) for
  // exactly what this does and does not catch.
  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  let manifestProblem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (manifestProblem != "") {
    fail newError(manifestProblem)
  }
  // §17.6: freestanding withholds the stdlib root entirely, and that IS the
  // mechanism — loadProject loads the prelude FROM that root, so an empty root
  // means no prelude and no resolvable `std/*` import. A module reaching for
  // `println` then fails in the resolver with an ordinary undefined-name
  // diagnostic, because the name genuinely is not in scope. The managed/
  // unmanaged boundary is enforced by absence, not by a list of banned names
  // the checker would have to keep in sync with the prelude.
  let stdRoot = stdRootPath()
  if (freestanding) {
    stdRoot = ""
  }
  let p = loadProject(rootDir, rootOnly, stdRoot)
  if (p.root < 0 || len(p.mods) == 0) {
    fail newError("not a module: ${src}")
  }
  // Lex/parse errors first and alone: a tree the parser recovered through has
  // holes the checker reads as real nodes, so its errors would be noise on top
  // of the ones that caused them. The seed stops here for the same reason.
  if (reportCheckErrors(p.diags)) {
    fail newError("check failed")
  }
  let mods = checkProject(p)
  // The target gate reports into the same sink, so an E0078 renders beside any
  // check error rather than after a second, separate failure.
  rejectExternForTarget(p, target, rtArchive, linking)
  // Final gate: renders a warnings-only sink too (#2491), unlike the lex/parse
  // gate above.
  if (reportCheckDiagnostics(p.diags)) {
    fail newError("check failed")
  }
  return lowerProject(mods, p.root)
}

// Compiles `src` to a relocatable OBJECT at `out` (#1397): no `main` required,
// no entry trampoline, no runtime archive read, nothing linked. This is the
// half of the toolchain that feeds `bit ar`. Returns false on any failure
// (already reported).
fn buildObjCmd(src: string, out: string, target: BuildTarget, freestanding: bool): bool {
  let module = buildIr(src, target, freestanding, []u8(0), false) catch e {
    eprint("bit: ${src}: ${e.message()}\n")
    return false
  }
  // -O1 (#1448): the seed runs this on every emit path and codegen depends on
  // it — see writeModuleExe for why an unoptimized module is not merely slower.
  optimizeModule(module)
  // Same refusal as writeModuleExe: a signature-only stub computes nothing, so
  // an object containing one would silently link into a wrong program.
  if (len(module.stubbed) > 0) {
    eprint("bit: ${src}: cannot lower ${len(module.stubbed)} function(s); refusing to emit an object\n")
    for nm of module.stubbed {
      eprint("  ${nm}\n")
    }
    return false
  }
  // The block-boundary invariant (#1925). A function whose IR names a value
  // from another block without receiving it as a block argument is
  // MISCOMPILED, silently — the register allocator has no live interval
  // covering that use. Refused here alongside the stub check because both
  // answer the same question: is this module safe to emit at all.
  if (!verifyModuleOk(module, src, "emit an object")) {
    return false
  }
  let obj = []u8(0)
  if (isMachoTarget(target)) {
    obj = emitMachoObject(module, false, freestanding) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
  } else {
    obj = emitElfObject(module, elfTargetOf(target), false, freestanding) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
  }
  writeFile(out, string(obj)) catch e {
    eprint("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  return true
}

// Compiles `src` (a file or a project directory) to a native executable at
// `out`. Returns false on any failure (already reported).
fn buildCmd(src: string, out: string, target: BuildTarget): bool {
  // Read before the front end, not after it: the archive is what decides
  // §11.7's E0078 (a symbol it defines is linkable, one it does not is not), so
  // the gate inside `buildIr` needs it, and the link below needs the same bytes.
  // One read, one source of truth. Mirrors the seed, which reads the archive in
  // `main` ahead of `buildModule`.
  let rt = readRtArchive(target) catch e {
    eprint("bit: runtime archive ${libbitrtPath(target)}: ${e.message()}\n")
    return false
  }
  let module = buildIr(src, target, false, rt, true) catch e {
    eprint("bit: ${src}: ${e.message()}\n")
    return false
  }
  return writeModuleExe(module, src, out, target, rt)
}

// The per-target runtime archive's bytes. Split out so the E0078 gate and the
// link read it exactly once between them.
fn readRtArchive(target: BuildTarget): []u8! {
  return []byte(readFile(libbitrtPath(target))?)
}

// Emits, links, and writes a lowered module to a native executable at `out`.
// Split out of buildCmd so `bit test` can inject its synthetic `main` into the
// module first. Returns false on any failure (already reported).
fn writeModuleExe(module: IrModule, src: string, out: string, target: BuildTarget, rt: []u8): bool {
  // -O1 (#1448). `optimizeModule` was reachable ONLY from `--dump-ir`, so every
  // binary the self-hosted compiler produced was built from raw lowering while
  // the IR differentials compared optimized dumps — the gap was invisible to
  // every gate by construction.
  //
  // This is not just a quality knob. `rebuild` renumbers blocks into the linear
  // schedule (ascending `instsStart`), and TWO codegen passes assume block id ==
  // position in that schedule: `isBackEdge` (`target <= curBlock`), which decides
  // where a GC safepoint poll goes, and the x64 linear-scan interval numbering.
  // Raw lowering IDs a loop's exit block BEFORE the body it is emitted after, so
  // without this call the else arm of an `if/else` in a loop looked like a
  // back-edge and got a spurious poll (~2x collector work, 81 corpus files).
  //
  // Called here rather than in `buildIr` so `bit test`'s injected `main` is
 // optimized too (this runs after `injectTestMain`).
  optimizeModule(module)
  // A signature-only stub computes nothing and returns garbage. Emitting one
  // would hand back a binary that silently gives wrong answers, so refuse — the
  // construct it choked on has to be reported, not shipped.
  if (len(module.stubbed) > 0) {
    eprint("bit: ${src}: cannot lower ${len(module.stubbed)} function(s); refusing to emit a binary\n")
    for nm of module.stubbed {
      eprint("  ${nm}\n")
    }
    return false
  }
  if (!verifyModuleOk(module, src, "emit a binary")) {
    return false
  }
  // Mach-O and ELF differ in every layer below here: the object format, the
  // static-data placement (dyld-rebased __data vs read-only .rodata), and the
  // linker's image. The backend follows the target too — an ELF x86_64-linux
  // build is what drives x64.bit.
  let exe = []u8(0)
  if (isMachoTarget(target)) {
    let obj = emitMachoObject(module, true, false) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
    // §11.7 externs are the only names this program may leave for dyld; the
    // linker refuses anything else it left undefined rather than shipping a
    // binary that dies at load (#1445).
    exe = linkMacho([meObjectInput(obj), meArchiveInput(rt)],
      pathStem(out), machoImportNames(module)) catch e {
      eprint("bit: link ${out}: ${e.message()}\n")
      return false
    }
  } else {
    let obj = emitElfObject(module, elfTargetOf(target), true, false) catch e {
      eprint("bit: ${src}: ${e.message()}\n")
      return false
    }
    exe = linkElfExecutable(elfLinkTargetOf(target),
      [ElfLinkInput{ isArchive: false, bytes: obj },
       ElfLinkInput{ isArchive: true, bytes: rt }]) catch e {
      eprint("bit: link ${out}: ${e.message()}\n")
      return false
    }
  }
  writeFile(out, string(exe)) catch e {
    eprint("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  // A binary the kernel refuses to exec is not a build. writeFile leaves 0o644.
  if (fsChmod(out, 493) != 0) { // 0o755
    eprint("bit: cannot make ${out} executable\n")
    return false
  }
  return true
}

// A per-invocation nonce for scratch paths that are WRITTEN and then EXEC'd
// (`bit run`, `bit test`). A fixed name lets two concurrent processes clobber
// one file while another execs it — ETXTBSY, or a binary that is half one build
// and half another, surfacing as a hang rather than an error (#1459, #1463).
//
// Drawn from the OS entropy pool via the `cryptoRandomBytes` primitive rather
// than `crypto/rand`'s `randomU64`: the compiler's own module can only import
// `std/*`, and prelude primitives need no import at all.
fn scratchNonce(): uint {
  let b = []byte(cryptoRandomBytes(8))
  let x: uint = 0
  let i = 0
  while (i < 8) {
    x = (x << 8) | uint(b[i])
    i = i + 1
  }
  return x
}

// `bit run <src>`: build for the host, launch the binary, and exit with its
// exit code. Builds to a /tmp path keyed by the source stem plus a random
// nonce — a FIXED name is written and then exec'd, which is exactly the
// clobber/ETXTBSY shape #1459 records, and two agents running `bit run` on
// same-named modules is routine here. Returns the child's exit code, or 1 if
// the build failed.
fn runCmd(src: string): int {
  let tmp = "/tmp/bit-run-${pathStem(src)}-${scratchNonce()}"
  if (!buildCmd(src, tmp, hostBuildTarget())) {
    return 1
  }
  let code = osRun(tmp)
  // Best-effort cleanup; a leftover temp binary is harmless, so ignore errors.
  fsRemove(tmp)
  // `osRun`'s three outcomes (ABI.md §19). A signal death is NOT a launch
  // failure: the program ran, then crashed, so say which signal killed it and
  // exit 128+sig the way a shell would. Naming `tmp` is wrong in either case —
  // `fsRemove` above already deleted it (#2019).
  if (code <= 0 - 100) {
    let sig = 0 - code - 100
    eprint("bit: ${pathBase(src)} was killed by ${signalName(sig)}\n")
    return 128 + sig
  }
  if (code < 0) {
    eprint("bit: could not launch the program built from ${pathBase(src)}\n")
    return 1
  }
  return code
}

// The signals a `bit run` child realistically dies on, named. Anything else
// reports its number — the point is to stop saying "could not run", not to
// carry a full signal table. EVERY branch parenthesises the number, including
// the fallback: tests/bit/runcmd.bit reads it back out to assert the exit code
// is 128 plus the signal actually named, and one shape is all it has to parse.
fn signalName(sig: int): string {
  if (sig == 4) { return "SIGILL (4)" }
  if (sig == 6) { return "SIGABRT (6)" }
  if (sig == 8) { return "SIGFPE (8)" }
  if (sig == 9) { return "SIGKILL (9)" }
  if (sig == 10) { return "SIGBUS (10)" }
  if (sig == 11) { return "SIGSEGV (11)" }
  if (sig == 13) { return "SIGPIPE (13)" }
  return "an unnamed signal (${sig})"
}

// `bit test`'s CLI entry point (`testCmd`) and the directory walk behind its
// recursion into sub-modules (#2247) live in testrun.bit — it calls
// `buildIr`/`readRtArchive`/`writeModuleExe` above, and `moduleRootProblem`
// below, same as `run`/`build` do, but its own body outgrew what belonged
// beside them here.

// `bit ar <out.a> <obj...> [--target t]`: bundles already-emitted relocatable
// objects into an `ar` archive (#1398) — the `ar rcs` half of the toolchain
// that `bit build --emit-obj` feeds. The name encoding follows the target's own
// convention (BSD for Mach-O, GNU for ELF), which is what parseArchive and every
// platform `ar` expect. Each member is named by its file's basename. `a` is the
// whole argv, so a[2] is the output and a[3..] the inputs.
fn arCmd(a: []string): bool {
  let out = a[2]
  let members = []ArMember(0)
  let target = hostBuildTarget()
  let ai = 3
  while (ai < len(a)) {
    if ((a[ai] == "--target" || a[ai] == "-t") && ai + 1 < len(a)) {
      let ti = parseBuildTarget(a[ai + 1])
      if (ti < 0) {
        eprint("bit ar: unknown target '${a[ai + 1]}'\n")
        return false
      }
      target = buildTargetOf(ti)
      ai = ai + 2
      continue
    }
    let data = readFile(a[ai]) catch e {
      eprint("bit ar: ${a[ai]}: ${e.message()}\n")
      return false
    }
    // Refuse a member that is not an object (#1876). Checked here rather than
    // after the loop so the error names the offending file while it is in hand,
    // and so nothing is written when any input is bad — a partial archive is
    // worse than none, because it looks like a successful build.
    let raw = []byte(data)
    if (!arIsObject(raw)) {
      eprint("bit ar: ${a[ai]}: not a relocatable object (no ELF or Mach-O magic)\n")
      return false
    }
    members = append(members, ArMember{ name: pathBase(a[ai]), data: raw })
    ai = ai + 1
  }
  if (len(members) == 0) {
    eprint("bit ar: no input objects\n")
    return false
  }
  let format = arFormatGnu()
  if (isMachoTarget(target)) {
    format = arFormatBsd()
  }
  writeFile(out, string(writeArchive(members, format))) catch e {
    eprint("bit ar: cannot write ${out}: ${e.message()}\n")
    return false
  }
  return true
}

// The runtime archive this compiler links against, per target. Overridable so a
// build tree that keeps it elsewhere still works, matching the seed's
// BIT_LIBBITRT — though an override names ONE archive, so it only makes sense
// alongside a matching --target.
fn libbitrtPath(target: BuildTarget): string {
  let name = buildTargetName(target)
  let override = envOr("BIT_LIBBITRT", "")
  if (len(override) > 0) {
    return override
  }
  let near = resolveNearExe("lib/${name}/libbitrt.a")
  if (len(near) > 0) {
    return near
  }
  return "bit-out/lib/${name}/libbitrt.a"
}
