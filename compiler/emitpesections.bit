fn emPeReadonlySection(
  module: IrModule,
  freestanding: bool,
  rodata: ByteBuf,
  sections: []PeSection,
): []PeSection {
  if (len(rodata.bytes) > 0) {
    sections = append(
      sections,
      PeSection{
        kind = PeSectionKind.Rodata,
        data = rodata.bytes, size = 0,
        alignment = globalsAlign(module, storageReadonly(), freestanding),
      },
    )
  }
  return sections
}

fn emPeDataSections(
  module: IrModule,
  freestanding: bool,
  gdata: ByteBuf,
  bssSize: int,
  sections: []PeSection,
): []PeSection {
  if (len(gdata.bytes) > 0) {
    sections = append(
      sections,
      PeSection{
        kind = PeSectionKind.Data,
        data = gdata.bytes, size = 0, alignment = globalsAlign(module, 0, freestanding),
      },
    )
  }
  if (bssSize > 0) {
    sections = append(
      sections,
      PeSection{
        kind = PeSectionKind.Bss,
        data = []u8(0), size = bssSize,
        alignment = globalsAlignBss(module, 0, freestanding),
      },
    )
  }
  return sections
}

fn emPeGcSection(gc: ByteBuf, sections: []PeSection): []PeSection {
  if (len(gc.bytes) > 0) {
    // 8-aligned (#1927): writeStackMaps pads every entry to a multiple of 8.
    sections = append(
      sections,
      PeSection{
        kind = PeSectionKind.GcMeta,
        data = gc.bytes, size = 0, alignment = 8,
      },
    )
  }
  return sections
}
