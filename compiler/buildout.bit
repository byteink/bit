// Self-host: the default `-o` for a `bit build` DIRECTORY target (#2260).
// Split out of main.bit, which was at 820/800 lines with these three
// functions inline — the same over-limit shape #2740 hit in
// validatestmt.bit, fixed the same way (a sibling file, not a raised limit).
//
// `pathStem` (main.bit) derives the default output for a FILE target by
// stripping a `.bit` suffix and taking the last `/`-separated component. A
// directory has no such suffix, so that same logic yields the EMPTY string
// for ".", "./" and any argument ending in "/" — the "component after the
// last slash" is empty — and for a bare directory name it returns that same
// name, which then collides with the directory itself: `bit build p260`
// from the parent tried to create a FILE named `p260` where a DIRECTORY
// named `p260` already existed.
//
// The fix here writes the binary INSIDE the resolved directory, named from
// bit.json's "name" when the manifest has one (`manifestProjectName`), else
// the directory argument's own basename after trailing slashes are stripped
// (`stripTrailingSlashes`) — `buildDirDefaultOut` ties the two together.
// Preferring the manifest name whenever one exists, not only for the "."/
// "./" spellings that have no name in their own text, is what makes `bit
// build .` inside `myproject/`, `bit build ../myproject` and `bit build
// myproject` all land on the exact same output, `myproject/myproject`.
//
// A sibling .bit file is the same module (main.bit's own header notes this
// for pmfetch.bit/lint.bit), so `pathBase` (main.bit), `readManifest`
// (pmfetch.bit) and the JSON accessors (json.bit) are visible here with no
// import — a second import of something already bound module-wide is a
// redeclaration (E0042).

// Strips every trailing '/' from `p`, so "foo/", "foo//" and "foo" agree.
// `pathBase` alone does not: a trailing slash reads as "the component after
// it is empty" (#2260). Never strips the "/" root itself down to "".
fn stripTrailingSlashes(p: string): string {
  let end = len(p)
  while (end > 1 && p[end - 1] == '/') {
    end = end - 1
  }
  return p[0:end]
}

// bit.json's "name" field for the project rooted at `dir`, or "" when there
// is none: no manifest, a "name" that is missing or not a string, or a
// manifest `readManifest` could not parse. bit.json is JSONC by convention
// (comments allowed) but `readManifest` parses strict JSON, and naming a
// build output is a convenience, not the §17.7 dependency-resolution path —
// so a manifest this can't read degrades to "no name" rather than failing
// the build.
fn manifestProjectName(dir: string): string {
  let doc = readManifest(dir) catch _ {
    return ""
  }
  let id = jsonGet(doc, doc.root, "name")
  if (!jsonHas(doc, id) || jsonKindOf(doc, id) != JsonKind.Str) {
    return ""
  }
  return jsonStrOf(doc, id)
}

// The default `-o` for a directory target (§17.1's project-directory build
// mode): the project's own name, written INSIDE that directory so the output
// can never collide with the directory itself (#2260).
//
// The name is bit.json's "name" field when the manifest has one, else the
// directory argument's own last component. `.`/`./` (and any spelling that
// is only trailing slashes) carry no component of their own — pathBase on
// them is "" — so those two spellings are the only ones that MUST have a
// manifest name; every other directory argument's own basename is the
// fallback.
fn buildDirDefaultOut(dir: string): string! {
  let stripped = stripTrailingSlashes(dir)
  let name = manifestProjectName(dir)
  if (len(name) == 0 && stripped != ".") {
    name = pathBase(stripped)
  }
  if (len(name) == 0) {
    fail newError("cannot derive an output name for '${dir}'; pass -o <name>")
  }
  if (stripped == ".") {
    return name
  }
  return stripped + "/" + name
}
