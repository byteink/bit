// compiler/checkbind.bit — split out of check.bit (#1809), then split
// further (#5642, checkbindexpr.bit / checkbinddecl.bit / checkbindfunc.bit
// carried off member/literal checking, named-type declaration collection and
// function-signature collection). Sibling of check.bit: same module, so this
// needs no imports and no call-site changes. What is left: typing and
// binding a `let`/pattern binder — comma-ok/tuple destructuring, the
// module-vs-local classification a binding's env write depends on, and the
// two-pass (seed then main-sweep) decl-node bookkeeping that feeds it.

// Types each binder of a tuple pattern against the corresponding element of
// `tupTy`, recursing into nested patterns (SPEC §10.1). When the type is unknown
// or the arity disagrees the binders are left untyped rather than given a made-up
// type: an inferencer that guesses here turns a checker gap into a wrong answer,
// and the validator reports the mismatch on its own terms -- `vLetDestructure`
// (validatedestructure.bit) since #4718, which is what makes both silent
// returns below a deferral rather than the acceptance they used to be.
fn checkTupleBinders(c: Checker, binders: []int, tupTy: int) {
  if (tupTy == 0 || c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    return
  }
  let members = c.ctx.types[tupTy].members
  if (len(members) != len(binders)) {
    return
  }
  let i = 0
  while (i < len(binders)) {
    if (getNode(c.tree, binders[i]).tag == Tag.TuplePat) {
      checkTupleBinders(c, kidsOf(c.tree, binders[i]), members[i])
    } else {
      c.nodeTypes[binders[i]] = members[i]
      envBind(c, binders[i], members[i])
    }
    i = i + 1
  }
}

// Types one `binding` node whose pattern is a tuple: either a two-result
// comma-ok form (`<-ch` / `m[k]` / `x.(T)`, where the value binder gets the
// received/indexed/asserted element and the `ok` binder a bool), or the general
// positional destructure of a tuple-typed initializer.
fn checkCommaOk(c: Checker, pat: int, init: int) {
  let binders = kidsOf(c.tree, pat)
  if (init == 0) {
    return
  }
  let inNode = getNode(c.tree, init)
  let valType = 0
  let isTwoResult = false
  if (len(binders) == 2) {
    if (inNode.tag == Tag.Unary && inNode.main == int(Kind.ArrowLeft)) {
      let chT = checkExprType(c, kidsOf(c.tree, init)[0])
      if (chT != 0 && c.ctx.types[chT].kind == TypeKind.Chan) {
        valType = c.ctx.types[chT].elem
      }
      isTwoResult = true
    } else if (inNode.tag == Tag.Index) {
      // Only a MAP index is a two-result form. Indexing a slice of tuples is an
      // ordinary one-result read that happens to yield a tuple, and must fall
      // through to the tuple path below.
      let recvT = checkExprType(c, kidsOf(c.tree, init)[0])
      if (recvT != 0 && c.ctx.types[recvT].kind == TypeKind.Map) {
        valType = checkIndex(c, init)
        isTwoResult = true
      }
    } else if (inNode.tag == Tag.TypeAssert) {
      // `let (v, ok) = x.(T)` narrows to T with a success flag.
      valType = typeFromNode(c, kidsOf(c.tree, init)[1])
      isTwoResult = true
    }
  }
  // `let (a, b, ...) = <tuple>` (SPEC §10.1/§13.1) — bind each element to its own
  // declared type. Before this, ANY non-comma-ok initializer fell through with
  // `valType` still 0 and the second binder typed `bool` REGARDLESS, so a tuple
  // destructure silently bound a bool-typed name over a real element and the
  // wrong value was read back with no diagnostic anywhere.
  if (!isTwoResult) {
    checkTupleBinders(c, binders, checkExprType(c, init))
    return
  }
  c.nodeTypes[binders[0]] = valType
  c.nodeTypes[binders[1]] = primType(c.ctx, 10)
  // BIND them, not just type them. Recording `nodeTypes` feeds `--dump-types`,
  // but every expression that READS a name resolves through `env` — so without
  // this, `let (c, ok) = <- ch` left `c` typed by whatever else in the module
  // last bound that name (in stdlib/quic: a `c: quicconnCmd` param 1600 lines
  // up, making `return c` from a `StreamChunk!` method look like a mismatch).
  // Same omission the for-of and match-arm binders had; `envBind` also records
  // `binderTypes`, so the sweep re-applies each at its own node — which precedes
  // the body that reads it.
  envBind(c, binders[0], valType)
  envBind(c, binders[1], primType(c.ctx, 10))
}

// True iff `binding` is a module-level `let` binding (§11.11) — a static cell
// — as opposed to any local `let`, which is an ordinary SSA value. Both carry
// SymbolKind.LetBinding; only the resolver's `moduleScoped` separates them.
fn isModuleStateBinding(c: Checker, binding: int): bool {
  let pat = kidsOf(c.tree, binding)[0]
  if (pat >= 0 && pat < len(c.nodeSymbols)) {
    let sid = c.nodeSymbols[pat]
    if (sid > 0 && sid < len(c.symbols)) {
      let sym = c.symbols[sid]
      return sym.kind == SymbolKind.LetBinding && sym.moduleScoped
    }
  }
  // The dump entry points (`--dump-ir`, `--dump-types`) never run the resolver,
  // so `nodeSymbols` is empty there — see declRefType's note. Fall back to the
  // structural fact the resolver would have recorded: a module-level `let` is a
  // binding of a LetDecl that is a DIRECT child of the tree root. Any deeper
  // LetDecl is a local.
  return isTopLevelLetBinding(c, binding)
}

// True iff `binding` belongs to a `let` declared at module scope, determined
// structurally rather than through the resolver. Bounded by the top-level decl
// count.
// A binding of ANY module-level declaration — `let` (§11.11 module state) or
// `const`. isTopLevelLetBinding answers only the `let` half because module state
// is what it exists to identify; this is the one to ask when the question is
// merely "is this binding outside every function body", which is what decides
// whether the statement sweep will ever reach it.
fn isTopLevelBinding(c: Checker, binding: int): bool {
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(c.tree, inner).tag == Tag.Export) {
      inner = kidsOf(c.tree, inner)[0]
    }
    let dt = getNode(c.tree, inner).tag
    if (dt != Tag.LetDecl && dt != Tag.ConstDecl) {
      continue
    }
    for b of kidsOf(c.tree, inner) {
      if (b == binding) {
        return true
      }
    }
  }
  return false
}

fn isTopLevelLetBinding(c: Checker, binding: int): bool {
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(c.tree, inner).tag == Tag.Export) {
      inner = kidsOf(c.tree, inner)[0]
    }
    if (getNode(c.tree, inner).tag != Tag.LetDecl) {
      continue
    }
    for b of kidsOf(c.tree, inner) {
      if (b == binding) {
        return true
      }
    }
  }
  return false
}

// The `const` half, the mirror of isTopLevelLetBinding. The seed's checkBinding
// takes `is_const` and `is_top` as separate parameters and gates E0064's
// top-level arm on BOTH, so asking "module-level" (isTopLevelBinding) is not
// enough — a module `let` reaches its own E0064 through vModuleState, with a
// different message (#1534).
fn isTopLevelConstBinding(c: Checker, binding: int): bool {
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(c.tree, inner).tag == Tag.Export) {
      inner = kidsOf(c.tree, inner)[0]
    }
    if (getNode(c.tree, inner).tag != Tag.ConstDecl) {
      continue
    }
    for b of kidsOf(c.tree, inner) {
      if (b == binding) {
        return true
      }
    }
  }
  return false
}

fn checkBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  let ann = kids[1]
  let init = kids[2]
  if (getNode(c.tree, pat).tag == Tag.TuplePat) {
    checkCommaOk(c, pat, init)
    return
  }
  let ty = 0
  if (ann != 0) {
    ty = typeFromNode(c, ann)
  } else if (init != 0) {
    // `defaultLitType`, not `defaultType`, so `let y = 0xFFFFFFFFFFFFFFFF`
    // (#2487) gets `y` typed `u64` rather than `i64` — the literal's magnitude
    // needs the 64th bit and no signed type can hold it.
    ty = defaultLitType(c, init, checkExprType(c, init))
  }
  c.nodeTypes[pat] = ty
  // Record a simple-ident binding so later expressions resolve it.
  let pn = getNode(c.tree, pat)
  if (pn.tag == Tag.Ident) {
    let bname = c.source[pn.span.start:pn.span.end]
    c.env[bname] = ty
    if (isTopLevelBinding(c, node)) {
      c.moduleEnv[bname] = ty
    }
    c.declTypes[pat] = ty
  }
}

// Records where a simple `let` binding's type ARGUMENTS can later be read from:
// its declared type NODE (annotation, composite-literal type, or a generic-enum
// variant construction's receiver), else the initializing CALL. Feeds
// `argTypeNode`'s structural generic-function-argument binding.
//
// Called from pre-pass 3's `seedBindingDeclType` only (#1573): match and for-of
// binders are typed in pre-pass 3, long before the main sweep runs
// `checkBinding`, so a duplicate call from `checkBinding` itself only ever
// re-wrote the same keys from the same nodes — a no-op every time, since
// pre-pass 3 runs first in ascending arena order and always reaches a binding
// before the main sweep does.
fn recordBindingDeclNodes(c: Checker, pat: int, ann: int, init: int) {
  let tnode = ann
  if (tnode == 0 && init != 0 && getNode(c.tree, init).tag == Tag.CompositeLit) {
    tnode = kidsOf(c.tree, init)[0]
  }
  if (tnode != 0) {
    c.declTypeNodes[pat] = tnode
  } else if (init != 0) {
    // A generic-enum variant construction writes its type args on the
    // `Name<...>` RECEIVER — the same node an annotation would have supplied.
    // Both variant forms are the same shape one level apart: `Wrap<i64>.Only(5)`
    // puts the receiver under a Call's Member callee, `Two<i64>.Empty` (no
    // payload, so no call) is that Member itself. Recorded separately rather
    // than through `tnode` so the `declInitNodes` path below still fires
    // (#1498). Without this the binding has no type node at all, and
    // `argTypeNode` cannot structurally bind a later generic call's type
    // param from it (#1545).
    let recv = 0
    let inode = getNode(c.tree, init)
    if (inode.tag == Tag.Call) {
      let callee = kidsOf(c.tree, init)[0]
      if (getNode(c.tree, callee).tag == Tag.Member) {
        recv = kidsOf(c.tree, callee)[0]
      }
    } else if (inode.tag == Tag.Member) {
      recv = kidsOf(c.tree, init)[0]
    }
    // The GenericInst guard is what keeps this narrow: an ordinary
    // `let x = obj.field` has an Ident receiver and records nothing.
    if (recv != 0 && getNode(c.tree, recv).tag == Tag.GenericInst) {
      c.declTypeNodes[pat] = recv
    }
  }
  // No written type: remember the initializing CALL so a later generic call
  // taking this binding can re-derive the instance type-args it needs (#1498).
  if (tnode == 0 && init != 0 && getNode(c.tree, init).tag == Tag.Call) {
    c.declInitNodes[pat] = init
  }
}

// Pre-seeds a simple `let x = …` binding's type into `declTypes` — the decl-path
// (#1370) — during pre-pass 3, so a for-of / match binder typed in that same pass
// resolves its ITERABLE through the binding it actually refers to.
//
// Without this the iterable was unknowable at pre-pass 3 (bindings are typed in
// the main sweep, which runs later), so `checkExprType` fell through to the
// module-wide flat `env` and read whatever same-named binding another function
// had left there. The binder then got element type 0 — which ALSO suppressed the
// main sweep's `binderTypes` rebind, leaving the binder NAME resolving to an
// unrelated function's local. In stdlib/crypto that is #1375: `blocks` is
// `[]byte` in gcm.bit and `[]PemBlock` in truststore.bit, so `for b of blocks`
// typed `b` as u8 and every `b.label` looked like an unknown member.
//
// Only `declTypes` is written — never `env` or `nodeTypes` — so this is a
// resolution input, not an inference result. The main sweep's `checkBinding`
// overwrites the same slot with the authoritative value, so a best-effort miss
// here (an initializer not yet typeable) costs nothing.
//
// A type-param-bearing result is dropped rather than recorded: generic argument
// binding is not resolvable this early (`declTypeNodes` is filled by the main
// sweep), so `let evens = keep<i64>(squares, …)` reads back as the TEMPLATE
// `[]U`. Recording that would freeze a bogus binder type into `binderTypes`,
// which the main sweep re-applies — and the main sweep cannot undo it. Leaving
// the slot at 0 keeps the binder merely unknown, which every validator already
// treats permissively. Seed only what is confidently concrete.
fn seedBindingDeclType(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  if (getNode(c.tree, pat).tag != Tag.Ident) {
    return
  }
  recordBindingDeclNodes(c, pat, kids[1], kids[2])
  let ty = 0
  if (kids[1] != 0) {
    ty = typeFromNode(c, kids[1])
  } else if (kids[2] != 0) {
    ty = defaultType(c, checkExprType(c, kids[2]))
  }
  if (ty == 0 || vHasTypeParam(c, ty, 0) || vMentionsInvalid(c, ty, 0)) {
    return
  }
  c.declTypes[pat] = ty
}
