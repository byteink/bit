// Check the same cursors and field widths that the ELF writer consumes.
fn ewU32(value: int): int! { return objectAdd(value, 0, 0xffffffff)? }

fn ewDataEnd(cursor: int, size: int, alignment: int): int! {
  let off = objectAlign(cursor, alignment, objectByteLimit())?
  return objectAdd(off, size, objectByteLimit())?
}

fn ewRecordEnd(cursor: int, count: int, width: int): int! {
  return ewDataEnd(cursor, objectMul(count, width, objectByteLimit())?, 8)?
}

fn ewStringEnd(cursor: int, size: int): int! {
  ewU32(cursor)?
  return objectAdd(objectAdd(cursor, size, objectByteLimit())?, 1, objectByteLimit())?
}

fn ewSymbolSize(count: int, nLocal: int): int! {
  ewU32(count)?
  objectAdd(nLocal, 1, 0xffffffff)?
  return objectMul(objectAdd(count, 1, objectByteLimit())?, sizeofElfSym(), objectByteLimit())?
}

fn ewInternString(buf: ByteBuf, name: string): int! {
  ewStringEnd(len(buf.bytes), len(name))?
  return elfInternString(buf, name)
}

fn ewPad(out: ByteBuf, alignment: int): ()! {
  let off = objectAlign(len(out.bytes), alignment, objectByteLimit())?
  appendZeros(out, off - len(out.bytes))
}

fn ewAppend(out: ByteBuf, data: []u8): ()! {
  objectAdd(len(out.bytes), len(data), objectByteLimit())?
  appendBytes(out, data)
}

fn ewRealBounds(sec: ElfSection, cursor: int): int! {
  objectAdd(sec.size, 0, vI64Max())?
  let alignment = sec.alignment
  if (alignment == 0) {
    alignment = 1
  }
  let size = len(sec.data)
  if (sec.kind == ElfSectionKind.Bss) {
    size = 0
  }
  return ewDataEnd(cursor, size, alignment)?
}

fn ewPreflightSections(sections: ([]bool, []ElfSection)): int! {
  let (present, byKind) = sections
  let cursor = sizeofElfEhdr()
  for kind of elfCanonicalOrder() {
    let idx = elfKindIndex(kind)
    if (!present[idx]) {
      continue
    }
    cursor = ewRealBounds(byKind[idx], cursor)?
  }
  return cursor
}

fn ewRelocationCount(relocs: []ElfRelocation, idx: int): int! {
  let count = 0
  for r of relocs {
    if (elfKindIndex(r.section) == idx) {
      count = objectAdd(count, 1, objectByteLimit())?
    }
  }
  return count
}

fn ewPreflightRelocs(obj: ElfObject, cursor: int): int! {
  for kind of elfCanonicalOrder() {
    let n = ewRelocationCount(obj.relocations, elfKindIndex(kind))?
    if (n == 0) {
      continue
    }
    cursor = ewRecordEnd(cursor, n, sizeofElfRela())?
  }
  return cursor
}

fn ewNameSize(obj: ElfObject, present: []bool): int! {
  let names = 1
  for kind of elfCanonicalOrder() {
    let idx = elfKindIndex(kind)
    if (present[idx]) {
      names = ewStringEnd(names, len(elfSectionName(kind)))?
    }
    if (ewRelocationCount(obj.relocations, idx)? > 0) {
      names = ewStringEnd(names, len(".rela${elfSectionName(kind)}"))?
    }
  }
  for name of [".strtab", ".symtab", ".shstrtab"] {
    names = ewStringEnd(names, len(name))?
  }
  return names
}

fn ewHeaderCount(obj: ElfObject, present: []bool): int! {
  let count = 4 // null section and the three tables
  for kind of elfCanonicalOrder() {
    let idx = elfKindIndex(kind)
    if (present[idx]) {
      count = objectAdd(count, 1, 0xffff)?
    }
    if (ewRelocationCount(obj.relocations, idx)? > 0) {
      count = objectAdd(count, 1, 0xffff)?
    }
  }
  return count
}

fn ewPreflight(obj: ElfObject, sections: ([]bool, []ElfSection), symbols: ([]int, int)): int! {
  let (present, _) = sections
  let (order, nLocal) = symbols
  let cursor = ewPreflightRelocs(obj, ewPreflightSections(sections)?)?
  let strings = 1
  // Only name offsets are u32; the last string's size remains an ELF64 quantity.
  for idx of order {
    strings = ewStringEnd(strings, len(obj.symbols[idx].name))?
  }
  cursor = ewDataEnd(cursor, strings, 1)?
  cursor = ewDataEnd(cursor, ewSymbolSize(len(obj.symbols), nLocal)?, 8)?
  cursor = ewDataEnd(cursor, ewNameSize(obj, present)?, 1)?
  return ewRecordEnd(cursor, ewHeaderCount(obj, present)?, sizeofElfShdr())?
}
