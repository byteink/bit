// Self-host Stage 3 (#1346): the x86-64 backend, prologue/epilogue and calls.
// Split out of compiler/x64.bit; same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// Prologue and epilogue
// ---------------------------------------------------------------------------

// Establishes the frame: chain rbp, save the callee-saved GPRs, carve the
// frame, then stash the callee-saved XMMs into it.
//
// The XMM saves come AFTER `sub rsp` on purpose — they live inside the frame
// the sub just carved, so storing them first would write below rsp, into the
// red zone a signal handler may clobber.
//
// #3327: on Win64 the frame-carving sub becomes a page-probing sequence once
// the frame exceeds one page — see xEmitWinStackProbe in
// compiler/x64stackprobe.bit. It still sits in exactly this slot, between the
// GPR pushes and the XMM saves, so that ordering constraint is unaffected.
// SysV never probes: the kernel grows its stack on any fault in the mapped
// region, so a bare `sub rsp` is correct there regardless of frame size.
//
// #3345: on Win64 this ALSO builds the `.xdata` UNWIND_INFO describing this
// same prologue, in the SAME statements that emit it — see
// compiler/x64unwind.bit's module comment for why that matters. The result
// is empty (xEmptyUnwindInfo) for SysV, which has no `.pdata`/`.xdata` at all.
fn xEmitPrologue(cx: XCtx): XUnwindInfo {
  let win = cx.cc == XCallConv.Win64
  let ops = []XUnwindOp(0)

  xPush(cx.buf, XReg64.Rbp)
  if (win) { ops = append(ops, xPushNonvolOp(len(cx.buf.code), XReg64.Rbp)) }
  xMovRR(cx.buf, XReg64.Rbp, XReg64.Rsp)
  if (win) { ops = append(ops, xSetFpregOp(len(cx.buf.code))) }
  for r of cx.frame.savedGpr {
    xPush(cx.buf, r)
    if (win) { ops = append(ops, xPushNonvolOp(len(cx.buf.code), r)) }
  }
  if (cx.frame.frameSize > 0) {
    if (cx.cc == XCallConv.Win64 && cx.frame.frameSize > xWinStackGuardPageBytes()) {
      xEmitWinStackProbe(cx, cx.frame.frameSize)
    } else {
      xRspAddSub(cx.buf, true, cx.frame.frameSize)
    }
    if (win) { ops = append(ops, xAllocLargeOp(len(cx.buf.code), cx.frame.frameSize)) }
  }
  // XMM saves come after: they never move rsp, and x64unwind.bit's module
  // comment explains why they carry no unwind code.
  let prologueSize = len(cx.buf.code)
  let i = 0
  while (i < len(cx.frame.savedXmm)) {
    xMovFStore(cx.buf, xMemB(XReg64.Rbp, xXmmSaveOffset(cx.frame, i)), cx.frame.savedXmm[i], 8)
    i = i + 1
  }
  if (!win) {
    return xEmptyUnwindInfo()
  }
  return xPackUnwindInfo(ops, prologueSize)
}

// Tears it down in the exact mirror order. The GPR pops MUST run in reverse:
// the stack is LIFO, so popping in push order restores every register's value
// into the wrong register.
fn xEmitEpilogue(cx: XCtx) {
  let i = 0
  while (i < len(cx.frame.savedXmm)) {
    xMovFLoad(cx.buf, cx.frame.savedXmm[i], xMemB(XReg64.Rbp, xXmmSaveOffset(cx.frame, i)), 8)
    i = i + 1
  }
  if (cx.frame.frameSize > 0) {
    xRspAddSub(cx.buf, false, cx.frame.frameSize)
  }
  let j = len(cx.frame.savedGpr)
  while (j > 0) {
    j = j - 1
    xPop(cx.buf, cx.frame.savedGpr[j])
  }
  xPop(cx.buf, XReg64.Rbp)
}

// ---------------------------------------------------------------------------
// Call selectors
// ---------------------------------------------------------------------------

// Records a safepoint at the CURRENT code offset. Called immediately after a
// call instruction, so the offset is the RETURN ADDRESS — which is what the
// collector's stack walker looks a frame up by (runtime/ABI.md §5). Recording
// the call's own offset instead would leave every lookup missing.
// Records the CURRENT code offset as the next safepoint's return address. Call
// it immediately AFTER the call instruction: the collector's stack walker looks a
// frame up by its return address (runtime/ABI.md §5), so recording the call's own
// offset leaves every lookup missing and the frame's live pointers invisible.
fn xRecordSafepoint(cx: XCtx) {
  cx.safepointCodeOffsets[cx.nextSafepointIdx] = len(cx.buf.code)
  cx.nextSafepointIdx = cx.nextSafepointIdx + 1
}

// The register a call's first argument goes in — the one place the two
// conventions differ for a single-argument runtime call.
fn xArg0(cc: XCallConv): XReg64 {
  if (cc == XCallConv.Win64) {
    return XReg64.Rcx
  }
  return XReg64.Rdi
}

// The second argument register — needed by the interface path, which passes
// (typeinfo, methodId) to bit_rt_iface_lookup.
fn xArg1(cc: XCallConv): XReg64 {
  if (cc == XCallConv.Win64) {
    return XReg64.Rdx
  }
  return XReg64.Rsi
}

// A closure value is a pointer to a 16-byte GC cell {code_ptr, env_ptr}: the
// code pointer at +0 (into .text, never a GC reference) and the captured
// environment at +8 (the cell's one GC field). Keeping a closure one word lets
// it flow through the register allocator like any other reference.
fn xClosureCellSize(): int {
  return 16
}

fn xClosureCellPtrOffsets(): []int {
  return [8]
}

// The constant shift amount of `v`, or -1 when the amount is not a constant.
// x86-64's only variable shift count is cl, so a non-constant amount forces rcx
// out of the allocatable file (see xScanFuncFlags).
fn xConstShiftAmount(f: IrFunc, v: int): int {
  if (f.instrs[v].op != Op.ConstInt) {
    return -1
  }
  return f.instrs[v].ival & 63
}

// log2 of a value already known to be a nonzero power of two. Bounded at 64
// iterations (a u64 has at most 64 bits), never more.
fn xLog2Pow2(raw: u64): int {
  let v = raw
  let k = 0
  while (v > u64(1)) {
    v = v >> u64(1)
    k = k + 1
  }
  return k
}

// The log2 of `v`'s divisor value, or -1 unless it is a KNOWN, POSITIVE,
// power-of-two constant at `w`'s width — used to route SDiv/UDiv around a
// real idiv (#1702). Declining a non-power-of-two or non-positive divisor is
// correct, not merely conservative: those need a different (unimplemented)
// reduction and must keep dividing for real.
fn xConstPow2Divisor(f: IrFunc, v: int, w: Width): int {
  if (f.instrs[v].op != Op.ConstInt) {
    return -1
  }
  let raw = f.instrs[v].ival
  let bits = w.bytes * 8
  let magnitude = u64(0)
  if (w.signed) {
    if (raw <= 0) {
      return -1 // only a positive divisor's quotient is a plain shift
    }
    magnitude = u64(raw)
  } else if (bits >= 64) {
    magnitude = u64(raw)
  } else {
    magnitude = u64(raw) & ((u64(1) << u64(bits)) - u64(1))
  }
  if (magnitude == u64(0) || (magnitude & (magnitude - u64(1))) != u64(0)) {
    return -1 // zero, or not a power of two
  }
  let k = xLog2Pow2(magnitude)
  if (k == 0) {
    return -1 // divisor == 1: quotient is the dividend, no shift needed
  }
  return k
}

// A `Mul`'s operands resolved for strength reduction: `value` is the operand
// left to shift and `k` the log2 of the constant factor, or `k == -1` when
// neither operand is a power-of-two constant and a real multiply must be
// emitted. `value` is deliberately -1 in that case: an emitter that read it
// anyway would index out of bounds and abort, not silently shift the wrong
// operand.
struct Pow2Factor {
  value: int,
  k: int,
}

fn noPow2Factor(): Pow2Factor {
  return Pow2Factor{ value: -1, k: -1 }
}

// Whether `lhs * rhs` is a shift, for BOTH backends (#3105) — the multiply
// twin of `xConstPow2Divisor`, whose accept/decline rule it reuses verbatim
// rather than restating: a known, positive, power-of-two `ConstInt` at `w`'s
// width, `k >= 1`. The `x` prefix is that sibling's, not a claim about x86-64.
//
// Multiplication is COMMUTATIVE, so both operand positions are checked and
// `8 * x` reduces exactly as `x * 8` does; division is not, which is why its
// call sites ask about `rhs` alone. `rhs` is checked first so the ordinary
// `x * 8` spelling never pays the second lookup.
fn xConstPow2Factor(f: IrFunc, lhs: int, rhs: int, w: Width): Pow2Factor {
  let rk = xConstPow2Divisor(f, rhs, w)
  if (rk >= 0) {
    return Pow2Factor{ value: lhs, k: rk }
  }
  let lk = xConstPow2Divisor(f, lhs, w)
  if (lk >= 0) {
    return Pow2Factor{ value: rhs, k: lk }
  }
  return noPow2Factor()
}

// One pass over the body deciding which registers the allocator may NOT hand
// out. Every flag exists because some instruction hard-wires a register:
// division fixes rax/rdx, a variable shift fixes cl, and any safepoint restricts
// the whole file to callee-saved (a call destroys everything else).
fn xScanFuncFlags(f: IrFunc): XFuncFlags {
  let flags = XFuncFlags{ hasSafepoints: false, needsRaxRdx: false, needsRcx: false }
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let i = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (i < end) {
      let ins = f.instrs[i]
      if (isSafepointOp(ins.op)) {
        flags.hasSafepoints = true
      }
      if (ins.op == Op.SDiv || ins.op == Op.UDiv || ins.op == Op.SRem || ins.op == Op.URem) {
        flags.needsRaxRdx = true
      }
      // CMPXCHG (and the AND/OR CAS-retry loops) commandeer `rax` as the implicit
      // accumulator — reserve it for the whole function, exactly like `idiv`.
      if (ins.op == Op.AtomicCmpxchg || ins.op == Op.AtomicRmwAnd || ins.op == Op.AtomicRmwOr) {
        flags.needsRaxRdx = true
      }
      if (ins.op == Op.Shl || ins.op == Op.AShr || ins.op == Op.LShr) {
        if (xConstShiftAmount(f, ins.rhs) < 0) {
          flags.needsRcx = true
        }
      }
      // A back-edge's safepoint poll is a real call, so it restricts the file
      // exactly as a user call does. Scanning only for call ops missed this and
      // left a loop-carried value in a caller-saved register that the poll then
      // destroyed (#1236). §10.3.1: a @naked/@nosplit function takes no such
      // poll, so it never forces the callee-saved-only file.
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival) && !needsNoSafepoints(f)) {
        flags.hasSafepoints = true
      }
      if (ins.op == Op.Br && !needsNoSafepoints(f)) {
        if (isBackEdge(bi, ins.ival) || isBackEdge(bi, ins.ival2)) {
          flags.hasSafepoints = true
        }
      }
      i = i + 1
    }
    bi = bi + 1
  }
  return flags
}

// Which callee-saved registers the prologue must preserve. Every callee-saved
// register IN THE FILE is saved, not just the ones the allocation touched: when
// the function has safepoints the file IS the callee-saved subset, so this is
// the set the allocator could have used.
fn xBuildSavedGpr(cc: XCallConv, regs: []XReg64): []XReg64 {
  let out = []XReg64(0)
  for r of regs {
    if (xIsCalleeSavedInt(cc, r)) {
      out = append(out, r)
    }
  }
  return out
}

fn xBuildSavedXmm(cc: XCallConv, regs: []XmmReg): []XmmReg {
  let out = []XmmReg(0)
  for x of regs {
    if (xIsCalleeSavedFloat(cc, x)) {
      out = append(out, x)
    }
  }
  return out
}

// Bit i set means file register i is callee-saved. regalloc takes this as
// informative only, but it is part of its TargetRegs contract.
fn xCalleeSavedIntMask(cc: XCallConv, regs: []XReg64): int {
  let mask = 0
  let i = 0
  while (i < len(regs)) {
    if (xIsCalleeSavedInt(cc, regs[i])) {
      mask = mask | 1 << i
    }
    i = i + 1
  }
  return mask
}

fn xCalleeSavedFloatMask(cc: XCallConv, regs: []XmmReg): int {
  let mask = 0
  let i = 0
  while (i < len(regs)) {
    if (xIsCalleeSavedFloat(cc, regs[i])) {
      mask = mask | 1 << i
    }
    i = i + 1
  }
  return mask
}

// ---------------------------------------------------------------------------
// Argument marshalling, calls, and control flow
// ---------------------------------------------------------------------------

// Marshals `args` into the argument registers, starting at positional slot
// `basePosition` with the banks already `baseIntOrd`/`baseFloatOrd` deep.
// xEmitCallLike passes all zeros (a plain call); the closure/interface paths pass
// 1,1,0 to reserve arg0 for the environment or receiver they move in afterwards.
//
// Arguments past the ABI banks (SysV: the 7th+ int/ref, 9th+ float) overflow to
// the stack: reserve a 16-byte-aligned outgoing area with `sub rsp`, store each
// at [rsp + 8*k] in argument order so the callee reads them contiguously above
// its return address, then do the register moves. Returns the reserved byte count
// for the caller to reclaim with `add rsp` right after the call.
//
// Every source is guaranteed callee-saved-or-spill — a function containing any
// safepoint restricts its whole file to the callee-saved subset — so these
// parallel moves can never collide with the argument registers they target.
fn xMarshalArgs(cx: XCtx, args: []int, basePosition: int, baseIntOrd: int,
    baseFloatOrd: int): int {
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let stackArgs = []XStackArg(0)
  let intOrdinal = baseIntOrd
  let floatOrdinal = baseFloatOrd
  let stackIndex = 0
  let i = 0
  while (i < len(args)) {
    let class = xValueClass(cx, args[i])
    let ordinal = intOrdinal
    if (class == RegClass.Float) {
      ordinal = floatOrdinal
    }
    let src = xPlocOf(cx, args[i], class)
    let reg = xArgReg(cx.cc, class, basePosition + i, ordinal)
    if (reg >= 0) {
      moves = append(moves, PMove{ src: src, dst: plocReg(reg, class) })
    } else {
      stackArgs = append(stackArgs, XStackArg{ src: src, class: class, offset: 8 * stackIndex })
      stackIndex = stackIndex + 1
    }
    if (class == RegClass.Int) {
      intOrdinal = intOrdinal + 1
    } else {
      floatOrdinal = floatOrdinal + 1
    }
    i = i + 1
  }

  let reserve = 0
  if (stackIndex > 0) {
    reserve = xStackReserve(stackIndex)
    xRspAddSub(cx.buf, true, reserve)
    // Before the register moves: those recycle scratch1/scratch2 as parallel-move
    // temps, while a stack store only reads a source and writes the outgoing
    // area, so doing them first can never clobber a pending move's source.
    for sa of stackArgs {
      xEmitStackArgStore(cx, sa)
    }
  }
  xSequentializeAndEmit(cx, moves)
  return reserve
}

// Moves a call's return value out of rax/xmm0 into `dst`.
fn xTakeCallResult(cx: XCtx, dst: int, retTy: int) {
  if (regClassOf(cx.ctx, retTy) == RegClass.Float) {
    xPutFloat(cx, dst, XmmReg.Xmm0)
    return
  }
  // The C ABI returns a bool in `al` and leaves rax's upper bits UNSPECIFIED —
  // the same hazard ABI.md §2 records for a u8 return. A Bit bool is a full-width
  // 0/1 because `!b` and the branch tests read the whole register, so normalize
  // here, at the one boundary where a foreign callee's convention meets ours.
  // Whether a given callee happens to zero eax is not something to rely on:
  // bit_rt_string_eq did, bit_rt_fs_exists did not, and `!fsExists(missing)`
  // silently evaluated to false.
  if (xIsBoolTy(cx.ctx, retTy)) {
    xMovzxb(cx.buf, XReg64.Rax, XReg64.Rax)
  }
  xPutInt(cx, dst, XReg64.Rax)
}

// Whether `ty` is the bool primitive — the one integer-class type whose return
// register a C callee may leave partially undefined.
fn xIsBoolTy(ctx: TypeContext, ty: int): bool {
  return ctx.types[ty].kind == TypeKind.Prim && ctx.types[ty].prim == 10
}

// A direct `call`/`rt_call`: marshal, call, record the safepoint, reclaim, then
// take the result. `hasRet` is false for a void callee (Bit has no optionals).
// `isSafepoint` is false only for the back-edge poll-needed guard
// (xEmitBackEdgeSafepointIfNeeded, #2926): that call never allocates and never
// parks, so it can never be the frame a stopped world needs to scan, and
// recording it would desync `nextSafepointIdx` from `built.safepoints`, which
// has exactly one entry per back edge regardless of how many machine calls
// this emits (compiler/codegen.bit buildIntervals). Every other caller passes
// true, unchanged from before #2926.
fn xEmitCallLike(cx: XCtx, symbol: string, args: []int, hasRet: bool, dst: int,
    retTy: int, isSafepoint: bool) {
  let argReserve = xMarshalArgs(cx, args, 0, 0, 0)
  // Win64's 32-byte home space is reserved around just this call site rather than
  // baked into the frame: every other stack slot codegen touches is rbp-relative,
  // so a transient rsp shift never disturbs spill/local addressing. 32 is
  // 16-aligned, so the frame's alignment survives.
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, symbol)
  // The return address: the byte right after the call, BEFORE any home-space or
  // outgoing-arg teardown. Recording it after an `add rsp` pushes it past the
  // real return address and corrupts every stack-map lookup during a GC the
  // callee triggers.
  if (isSafepoint) {
    xRecordSafepoint(cx)
  }
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  if (argReserve > 0) {
    xRspAddSub(cx.buf, false, argReserve)
  }
  if (hasRet) {
    xTakeCallResult(cx, dst, retTy)
  }
}

// `call_value`: dispatch through a closure cell {code, env}. The env and code are
// loaded into scratch2/scratch3 (r10/r12) — neither is an argument register, so
// marshalling cannot disturb them, and r11 stays free as the move-cycle temp.
fn xEmitCallValue(cx: XCtx, dst: int, ty: int, callee: int, args: []int) {
  let cell = xGetInt(cx, callee, xScratch1())
  // #2018: a nil function value's cell is the null word (SPEC §13.4); calling
  // through it must panic (§18.4: "call of a nil function"), not dereference
  // address 0 for its {code, env} fields. `Op.CallValue` is already a full
  // safepoint/clobber point for regalloc, so this extra call on the cold path
  // needs no register preservation of its own.
  xTestRR(cx.buf, cell, cell)
  let ncSkip = xJccRel32Placeholder(cx, ccNe()) // non-nil -> skip the panic call
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, "bit_rt_panic_nil_call")
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  xPatchRel32Here(cx, ncSkip)
  xMovLoad(cx.buf, xScratch2(), xMemB(cell, 8), 8, false) // r10 = env
  xMovLoad(cx.buf, xScratch3(), xMemB(cell, 0), 8, false) // r12 = code
  let argReserve = xMarshalArgs(cx, args, 1, 1, 0)        // arg0 reserved for env
  xMovRR(cx.buf, xArg0(cx.cc), xScratch2())
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReg(cx, xScratch3())
  xRecordSafepoint(cx)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  if (argReserve > 0) {
    xRspAddSub(cx.buf, false, argReserve)
  }
  if (cx.ctx.types[ty].kind != TypeKind.Void) {
    xTakeCallResult(cx, dst, ty)
  }
}

// `call_iface`: structural interface dispatch (ABI.md §2.1). Load the receiver's
// TypeInfo (*(recv - 32), the header's info field), resolve the method id to a
// code address via bit_rt_iface_lookup, then call it with the receiver as arg0.
// The lookup never collects, so only the final indirect call records a safepoint.
// The receiver is RELOADED after the lookup: its home is a callee-saved register
// or a spill slot, both of which survive the call, but scratch1 does not.
fn xEmitCallIface(cx: XCtx, dst: int, ty: int, ifaceVal: int, methodId: int,
    args: []int) {
  let recv = xGetInt(cx, ifaceVal, xScratch1())
  // #2240: a nil interface value's receiver is the null word (ABI.md §2: an
  // interface value IS its receiver pointer); dispatching through it must
  // panic, not read `*(recv - 32)` as a TypeInfo pointer at address -32.
  // `Op.CallIface` is already a full safepoint/clobber point for regalloc, so
  // this extra call on the cold path needs no register preservation of its
  // own.
  xTestRR(cx.buf, recv, recv)
  let niSkip = xJccRel32Placeholder(cx, ccNe()) // non-nil -> skip the panic call
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, "bit_rt_panic_nil_iface")
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  xPatchRel32Here(cx, niSkip)
  xMovLoad(cx.buf, xScratch2(), xMemB(recv, -32), 8, false) // r10 = *(recv - 32)
  xMovRR(cx.buf, xArg0(cx.cc), xScratch2())
  xMovRI(cx.buf, xArg1(cx.cc), methodId)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, "bit_rt_iface_lookup") // rax = the method's code address
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  xMovRR(cx.buf, xScratch3(), XReg64.Rax) // r12 = fn, survives marshalling
  let argReserve = xMarshalArgs(cx, args, 1, 1, 0)
  let recv2 = xGetInt(cx, ifaceVal, xScratch1())
  xMovRR(cx.buf, xArg0(cx.cc), recv2)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReg(cx, xScratch3())
  xRecordSafepoint(cx)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  if (argReserve > 0) {
    xRspAddSub(cx.buf, false, argReserve)
  }
  if (cx.ctx.types[ty].kind != TypeKind.Void) {
    xTakeCallResult(cx, dst, ty)
  }
}

// A block's params are written by each predecessor's edge move — all at once,
// as ONE parallel move covering both classes (#3182), because a param may
// still be READ as another param's source in the same edge, and an int and a
// float move here can share a spill-slot number (#3168) — splitting this into
// two independently-ordered calls is what let that alias silently.
fn xEmitParamMoves(cx: XCtx, target: int, args: []int) {
  let blk = cx.f.blocks[target]
  let moves = []PMove(0)
  let p = 0
  while (p < blk.paramCount) {
    let paramVal = blk.instsStart + p
    let class = xValueClass(cx, paramVal)
    moves = append(moves, PMove{ src: xPlocOf(cx, args[p], class), dst: xPlocOf(cx, paramVal, class) })
    p = p + 1
  }
  xSequentializeAndEmit(cx, moves)
}

// Binds the incoming argument registers into the entry block's param vregs — the
// mirror of xEmitParamMoves, with the ABI argument registers as sources instead
// of another block's values. Without it the entry params hold whatever the
// allocator left in their registers, so every function that reads its own
// parameters returns garbage. Emitted right after the prologue, whose only
// register writes are callee-saved GPRs and rbp/rsp — never an argument register
// — so the incoming values are still live.
fn xBindIncomingArgs(cx: XCtx) {
  let entry = cx.f.blocks[0]
  // One parallel move covering both classes (#3182).
  let moves = []PMove(0)
  let intOrdinal = 0
  let floatOrdinal = 0
  let stackIndex = 0
  let p = 0
  while (p < entry.paramCount) {
    let paramVal = entry.instsStart + p
    let class = xValueClass(cx, paramVal)
    let ordinal = intOrdinal
    if (class == RegClass.Float) {
      ordinal = floatOrdinal
    }
    let dst = xPlocOf(cx, paramVal, class)
    let reg = xArgReg(cx.cc, class, p, ordinal)
    // The mirror of xMarshalArgs: the first six int / eight float params arrive in
    // the ABI registers; the rest were pushed by the caller and now sit just above
    // the saved rbp and return address, at [rbp+16], [rbp+24], … in argument
    // order (a non-register PLoc reads rbp-relative).
    let src = plocReg(reg, class)
    if (reg < 0) {
      src = plocMem(16 + 8 * stackIndex, class)
      stackIndex = stackIndex + 1
    }
    moves = append(moves, PMove{ src: src, dst: dst })
    if (class == RegClass.Int) {
      intOrdinal = intOrdinal + 1
    } else {
      floatOrdinal = floatOrdinal + 1
    }
    p = p + 1
  }
  xSequentializeAndEmit(cx, moves)
}

// #2921 (arm64) / #2926 (x64): the naked shim's full chain (five stack frames,
// see runtime/stw/stwpoll.bit) is only needed when a stop is pending or a
// collection is due — both rare. #2926 guarded it behind a call to
// `bit_rt_safepoint_needed`; #3169 inlines that call's own condition instead
// (xEmitInlinedPollGuard), porting what #2925 did on arm64 — see
// compiler/arm64call.bit's header there for why a call, even to a true leaf,
// remained ~0.50s of collatz's 0.86s. This file's comment claimed parity with
// arm64 for the month between #2925 and #3169 and was false for all of it.
//
// The safepoint bookkeeping is unchanged by either move: only the real poll
// passes isSafepoint=true to xEmitCallLike, so exactly one nextSafepointIdx
// advance happens per back edge — which is what buildIntervals
// (compiler/codegen.bit) recorded for that edge, independent of how many
// machine instructions this emits.
fn xEmitBackEdgeSafepointIfNeeded(cx: XCtx, curBlock: int, target: int) {
  // §10.3.1: a @naked/@nosplit function polls no safepoint on its back-edges.
  if (!isBackEdge(curBlock, target) || needsNoSafepoints(cx.f)) {
    return
  }
  xEmitInlinedPollGuard(cx)
}

// ---------------------------------------------------------------------------
// #3169: the poll guard's condition, inlined at the call site
// ---------------------------------------------------------------------------

// The two cached poll addresses sit at the TOP of the spill area, in the two
// slots xCompileFunction carves ABOVE the ones the register allocator asked
// for. Reusing the spill area rather than adding a frame region keeps
// x64frame.bit's layout comment ("then spill slots, then saved XMMs") true as
// written and needs no new XFrame field — and it keeps these two raw runtime
// addresses out of every stack map, because xCompileFunction builds a
// SafepointView's `slots` only from the indices the ALLOCATOR reports, which
// never reach this high. A GC that walked them would try to trace the World
// and GC module-state addresses as managed objects.
fn xPollCacheOffset(f: XFrame, i: int): int {
  // Sized by xCompileFunction on the same hasBackEdgeSafepoint predicate that
  // gates every caller here, so a frame reaching this point always has the
  // pair. Asserted rather than assumed: a silently negative index would
  // address the CALLER's frame.
  assert(f.numSpillSlots >= 2 && i >= 0 && i < 2)
  return xSpillOffset(f, f.numSpillSlots - 2 + i)
}

// Fetches (worldAddr, gcAddr) ONCE per function invocation into that pair,
// rather than once per loop iteration. Safe because runtime/stw/stw.bit's
// stwBind runs exactly once at boot — before any compiled Bit function's entry
// can execute — and never unbinds (#2184): the two addresses are a per-process
// constant for the entire lifetime of every function this backend compiles, so
// re-fetching them on every iteration (what a per-iteration call would do)
// buys nothing.
//
// Emitted right after xBindIncomingArgs: the incoming args are already off
// rdi..r9 by then, so these calls' ordinary caller-saved clobber is harmless,
// and every vreg in a function that polls a back edge lives in a callee-saved
// register or a spill slot already (xBuildIntRegs under hasSafepoints), so
// neither call can clobber a live value. bit_rt_world_addr/bit_rt_gc_addr are
// themselves true leaves that never allocate or park, so — like the #2926
// guard call they replace at the call site — neither is recorded as a
// safepoint.
fn xEmitPollCachePrefetch(cx: XCtx) {
  if (!hasBackEdgeSafepoint(cx.f)) {
    return
  }
  xEmitCallLike(cx, worldAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), XReg64.Rax, 8)
  xEmitCallLike(cx, gcAddrSymbol(), []int(0), false, 0, 0, false)
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), XReg64.Rax, 8)
}

// The inlined equivalent of `stwPollNeeded` (runtime/stw/stwpoll.bit), clause
// for clause. compiler/arm64call.bit's emitInlinedPollGuard quotes that
// predicate in full and holds the rationale for the object half (#3359, whose
// omission here cost `matrix` 168.5 G instructions); this ladder emits the
// SAME clauses in the SAME order.
//
// `true` (poll needed) falls into the real `call bit_rt_safepoint`; `false`
// (skip) branches past it. Each of the runtime's two `atomicLoad`s is a PLAIN
// `mov` here and that is not a weakening: an ordinary x86-64 load already has
// acquire semantics under TSO, which is the same fact xEmitAtomicLoad
// (x64selectmem.bit) relies on for Op.AtomicLoad itself. arm64 needs `ldar`.
//
// Two scratch registers cover the whole ladder — r11 rotates through waddr and
// then each loaded field, r10 holds the cached gcAddr from its load until the
// final compare. Both are caller-saved in BOTH conventions and neither is an
// argument register in either, and no vreg can live in them (they are outside
// xMasterGprs), so nothing live across the back edge is at risk. r12
// (xScratch3) is deliberately not used: it is callee-saved under SysV.
fn xEmitInlinedPollGuard(cx: XCtx) {
  let rTmp = xScratch1() // r11: waddr, then every loaded field in turn
  let rGc = xScratch2()  // r10: the cached gcAddr, live to the last compare
  let pollFixups = []int(0)
  let skipFixups = []int(0)

  // waddr == 0 -> poll
  xMovLoad(cx.buf, rTmp, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 0)), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccE()))

  // a stop is pending -> poll
  xMovLoad(cx.buf, rTmp, xMemB(rTmp, pgWorldStopWordWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccNe()))

  // gcAddr == 0 -> poll
  xMovLoad(cx.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), 8, false)
  xTestRR(cx.buf, rGc, rGc)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccE()))

  // stress mode -> poll
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcCfgStressWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccNe()))

  // disabled -> skip (the one early-false; every exit above is early-true)
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcCfgEnabledWord() * 8), 8, false)
  xTestRR(cx.buf, rTmp, rTmp)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccE()))

  // heapLive >= gcNextBytes -> poll, else skip. SIGNED, matching the runtime's
  // own `>=` on two i64s.
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcHeapAddrWord() * 8), 8, false)  // heap base
  xMovLoad(cx.buf, rTmp, xMemB(rTmp, pgHeapLiveWordWord() * 8), 8, false) // live bytes
  xMovLoad(cx.buf, rGc, xMemB(rGc, pgGcNextBytesWord() * 8), 8, false)  // trigger
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccL()))

  // The object half (#3292/#3359), same steps and order as arm64. Signed, like
  // the runtime's `>=`; `live - next >= next` IS `live >= next * 2` without
  // overflow; the object compare falls THROUGH to the poll.
  xArithRR(cx.buf, XArith.Sub, rTmp, rGc)                                // live - next
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  pollFixups = append(pollFixups, xJccRel32Placeholder(cx, ccGe()))      // 2x -> poll
  xMovLoad(cx.buf, rGc, xMemB(XReg64.Rbp, xPollCacheOffset(cx.frame, 1)), 8, false) // gcAddr again
  xMovLoad(cx.buf, rTmp, xMemB(rGc, pgGcNumObjectsIdxWord() * 8), 8, false) // live objects
  xMovLoad(cx.buf, rGc, xMemB(rGc, pgGcNextObjectsWord() * 8), 8, false)    // object trigger
  xArithRR(cx.buf, XArith.Cmp, rTmp, rGc)
  skipFixups = append(skipFixups, xJccRel32Placeholder(cx, ccL()))       // not caught up -> skip

  let i = 0
  while (i < len(pollFixups)) {
    xPatchRel32Here(cx, pollFixups[i])
    i = i + 1
  }
  xEmitCallLike(cx, safepointSymbol(), []int(0), false, 0, 0, true)
  i = 0
  while (i < len(skipFixups)) {
    xPatchRel32Here(cx, skipFixups[i])
    i = i + 1
  }
}

// A back-edge polls the collector BEFORE the edge moves: the poll is a call, and
// the moves may leave a param mid-write.
fn xEmitJump(cx: XCtx, target: int, args: []int) {
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, target)
  xEmitParamMoves(cx, target, args)
  xJmpRel32(cx, target)
}

fn xEmitBr(cx: XCtx, cond: int, thenBlk: int, thenArgs: []int, elseBlk: int,
    elseArgs: []int) {
  let c = xGetInt(cx, cond, xScratch1())
  xTestRR(cx.buf, c, c)
  // Jump over the then-path when the condition is ZERO. The edge moves must sit
  // on their own side of this branch — emitting them before it would run the
  // then-edge's moves on the else path too.
  let skipOff = xJccRel32Placeholder(cx, ccE())
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, thenBlk)
  xEmitParamMoves(cx, thenBlk, thenArgs)
  xJmpRel32(cx, thenBlk)
  xPatchRel32Here(cx, skipOff)
  xEmitBackEdgeSafepointIfNeeded(cx, cx.curBlock, elseBlk)
  xEmitParamMoves(cx, elseBlk, elseArgs)
  xJmpRel32(cx, elseBlk)
}

// A multi-value ret is out of scope — codegen has not settled a packing.
fn xEmitRet(cx: XCtx, vals: []int): bool {
  if (len(vals) > 1) {
    return false
  }
  if (len(vals) == 1) {
    let v = vals[0]
    if (xValueClass(cx, v) == RegClass.Float) {
      let r = xGetFloat(cx, v, xFScratch1())
      xMovFRR(cx.buf, XmmReg.Xmm0, r, widthOf(cx.ctx, cx.f.instrs[v].ty).bytes)
    } else {
      let r = xGetInt(cx, v, xScratch1())
      xMovRR(cx.buf, XReg64.Rax, r)
    }
  }
  // §10.3.1 @naked: no epilogue teardown — the value is already in rax/xmm0;
  // emit only the raw `ret`.
  if (!cx.f.isNaked) {
    xEmitEpilogue(cx)
  }
  xRet(cx.buf)
  return true
}

