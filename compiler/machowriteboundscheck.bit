fn checkMachoWriterBounds() {
  checkMachoWriterVm()
  checkMachoWriterBacked()
  checkMachoWriterFields()
  checkMachoWriterSites()
  checkMachoWriterPackedIndex()
  checkMachoWriterValues()
  checkMachoWriterWideBss()
}

fn checkMachoWriterVm() {
  let max = vI64Max()
  assert(
      (machoWriteVmEnd(max - 7, 7, 8) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteVmEnd(max - 7, 8, 8) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteVmEnd(max - 6, 0, 8) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteVmEnd(0, -1, 1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkMachoWriterBacked() {
  let max = objectByteLimit()
  assert(
      (machoWriteFileEnd(8, max - 8, 8) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteFileEnd(8, max - 7, 8) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteFileEnd(0xFFFFFFFF, 0, 1) catch _ {
        -1
      }) ==
      0xFFFFFFFF,
  )
  assert(
      (machoWriteFileEnd(0x100000000, 0, 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteRelocEnd(max, 0) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteRelocEnd(max + 1, 0) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkMachoWriterFields() {
  let max = 0xFFFFFFFF
  assert(
      (machoWriteU32(max) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteU32(max + 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteRelocEnd(max, max) catch _ {
        -1
      }) ==
      max * 9,
  )
  assert(
      (machoWriteRelocEnd(max + 1, 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteSymtabEnd(max - 7, 0, max) catch _ {
        -1
      }) ==
      2 * max - 7,
  )
  assert(
      (machoWriteSymtabEnd(max - 6, 0, 1) catch _ {
        -1
      }) ==
      -1,
  )
  checkMachoWriterNames()
}

fn checkMachoWriterNames() {
  let max = 0xFFFFFFFF
  assert(
      (machoWriteNameSize(1, max - 2) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteNameSize(1, max - 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteSymtabEnd(0, 0, max) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteSymtabEnd(0, 0, max + 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteRelocEnd(0, max + 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteSymtabEnd(0, max / 16, 1) catch _ {
        -1
      }) ==
      max - 14,
  )
  assert(
      (machoWriteSymtabEnd(0, max / 16 + 1, 1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkMachoWriterSites() {
  assert(
      (machoWriteRelocAddress(0x7FFFFFFF) catch _ {
        -1
      }) ==
      0x7FFFFFFF,
  )
  assert(
      (machoWriteRelocAddress(0x80000000) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteRelocAddress(-1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkMachoWriterPackedIndex() {
  assert(
      (machoWriteSymbolNumber(0xFFFFFF) catch _ {
        -1
      }) ==
      0xFFFFFF,
  )
  assert(
      (machoWriteSymbolNumber(0x1000000) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteSymbolNumber(-1) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkMachoWriterValues() {
  let max = vI64Max()
  assert(
      (machoWriteSymbolValue(max - 1, 1) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (machoWriteSymbolValue(max, 1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (machoWriteSymbolValue(0, -1) catch _ {
        -1
      }) ==
      -1,
  )
  assert(loRangeOk(max, max - 8, 8))
  assert(!loRangeOk(max, max - 7, 8))
  assert(!loRangeOk(max, -1, 0))
  assert(!loRangeOk(max, 0, -1))
}

fn checkMachoWriterWideBss() {
  let obj = MachoObject{
    sections = [
      MachoSection{ kind = MachoSectionKind.Bss, data = []u8(0), size = vI64Max(), alignment = 1 },
    ],
    symbols = [
      MachoSymbol{
        name = "end", hasSection = true, section = MachoSectionKind.Bss,
        offset = vI64Max(), size = 0, binding = MachoBinding.Global,
      },
    ],
    relocations = []MachoRelocation(0),
  }
  for target of [MachoTarget.X86_64, MachoTarget.Aarch64] {
    let b = writeMacho(target, obj) catch _ {
      assert(false)
      []u8(0)
    }
    assert(len(b) < 1024)
    let section = sizeofMachHeader64() + sizeofSegmentCommand64()
    assert(leAt(b, section + 40, 8) == vI64Max())
    assert(leAt(b, section + 48, 4) == 0)
    let symtab = section + sizeofSection64()
    assert(leAt(b, leAt(b, symtab + 8, 4) + 8, 8) == vI64Max())
  }
  checkMachoWriterWideSites(obj)
  obj.sections = append(
    obj.sections,
    MachoSection{ kind = MachoSectionKind.GcMeta, data = [u8(0)], size = 0, alignment = 1 },
  )
  assert(machoErr(MachoTarget.Aarch64, obj) == "ObjectSizeOverflow")
}

fn checkMachoWriterWideSites(obj: MachoObject) {
  obj.relocations = [
    MachoRelocation{
      section = MachoSectionKind.Bss, offset = 0x7FFFFFFF,
      symbol = "end", kind = MachoRelocKind.Unsigned64,
    },
  ]
  for target of [MachoTarget.X86_64, MachoTarget.Aarch64] {
    assert(machoErr(target, obj) == "")
    obj.relocations[0].offset = 0x80000000
    assert(machoErr(target, obj) == "ObjectSizeOverflow")
    obj.relocations[0].offset = -1
    assert(machoErr(target, obj) == "RelocOutOfBounds")
    obj.relocations[0].offset = vI64Max()
    assert(machoErr(target, obj) == "RelocOutOfBounds")
    obj.relocations[0].offset = 0x7FFFFFFF
  }
  obj.symbols[0].offset = -1
  assert(machoErr(MachoTarget.Aarch64, obj) == "SymbolOutOfBounds")
  obj.symbols[0].offset = vI64Max()
  obj.relocations = []MachoRelocation(0)
}
