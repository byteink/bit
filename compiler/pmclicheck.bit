// In-Bit self-checks for compiler/pmcli.bit's `bit add` flow (#1734). Sibling
// of pmcli.bit (same module), named to sort after it. Run by `selfcheck()`
// under `./make test`, the same convention pmfetchcheck.bit/
// pmresolvecheck.bit/pmlockcheck.bit already establish for this class of
// test: `bit add` shells out to git and touches the filesystem, so it is
// exercised here as a real in-Bit call against a local git fixture
// (`file://`, never network) — not as a golden `tests/cases/*.bit`
// single-file program, which cannot import `std/json` at all (see
// json_edit_set_existing.bit's own header) and so cannot reach the CST edit
// layer that is this whole file's point to prove.
//
// Reuses pmfetchcheck.bit's `pmCheckScratchDir`/`pmBuildFixture`/
// `pmCheckTimeoutMs` (same module) rather than re-deriving a fixture builder.
import { contains } from "std/strings"

function pmCliDeadAddResult(): AddResult {
  return AddResult{ name: "", specRef: "", url: "", commit: "" }
}

// A project directory with a `bit.json` carrying a user comment and TWO
// pre-existing dependencies (`kept` and `doomed`) plus a matching `bit.lock`
// — `bit remove doomed`'s fixture: it must delete `doomed` and leave `kept`
// (and every comment) byte-for-byte untouched.
function pmCliBuildRemovalProject(root: string): PmCliProject {
  let dir = root + "/removal-project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create removal project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + "    // kept dependency comment -- must survive untouched\n"
  bitJson = bitJson + "    \"kept\": \"github.com/byteink/kept@v1.0.0\",\n"
  bitJson = bitJson + "    // doomed dependency comment -- removed along with its entry\n"
  bitJson = bitJson + "    \"doomed\": \"github.com/byteink/doomed@v2.0.0\"\n"
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write removal project bit.json: " + e.message())
  }
  let seed = []LockEntry(0)
  seed = append(
    seed,
    LockEntry{
      name: "kept",
      url: "https://github.com/byteink/kept.git",
      commit: "1111111111111111111111111111111111111111",
      requires: []LockRequire(0),
    },
  )
  seed = append(
    seed,
    LockEntry{
      name: "doomed",
      url: "https://github.com/byteink/doomed.git",
      commit: "2222222222222222222222222222222222222222",
      requires: []LockRequire(0),
    },
  )
  writeLock(dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed removal project bit.lock: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

function pmCliExpectedBitJsonAfterRemoval(): string {
  let s = "{\n"
  s = s + "  // top-level project comment -- must survive untouched\n"
  s = s + "  \"name\": \"demo\",\n"
  s = s + "  \"dependencies\": {\n"
  s = s + "    // kept dependency comment -- must survive untouched\n"
  s = s + "    \"kept\": \"github.com/byteink/kept@v1.0.0\"\n"
  s = s + "  }\n"
  s = s + "}\n"
  return s
}

// `bit remove doomed` deletes only `doomed`'s entry from both bit.json (every
// other comment/entry byte-identical) and bit.lock.
function checkPmCliRemoveHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let proj = pmCliBuildRemovalProject(root)

  removeDependency(proj.dir, "doomed") catch e {
    panic("pmclicheck: removeDependency failed: " + e.message())
  }

  let newBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read bit.json after removal: " + e.message())
    ""
  }
  assert(newBitJson == pmCliExpectedBitJsonAfterRemoval())

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock after removal: " + e.message())
    []LockEntry(0)
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "kept")
}

// The message `removeDependency` failed with, or "" if it succeeded — mirrors
// `arErr` (archivecheck.bit)'s dead-value-in-catch pattern, needed because
// `removeDependency`'s success type is `()`, so its catch block must divert
// (here, `return`) rather than trail off with no value.
function pmCliTryRemoveMessage(dir: string, name: string): string {
  removeDependency(dir, name) catch e {
    return e.message()
  }
  return ""
}

// `bit remove` on a name absent from bit.json is a clean, named error — never
// a silent no-op — and neither file is touched.
function checkPmCliRemoveMissing() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let proj = pmCliBuildRemovalProject(root)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read bit.json before removal attempt: " + e.message())
    ""
  }

  let message = pmCliTryRemoveMessage(proj.dir, "nonexistent")
  assert(len(message) > 0)
  assert(contains(message, "nonexistent"))

  let unchangedBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
    ""
  }
  assert(unchangedBitJson == originalBitJson)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
    []LockEntry(0)
  }
  assert(len(entries) == 2)
}

// A project directory with a `bit.json` carrying a user comment and one
// pre-existing dependency, ready for `bit add` to touch.
struct PmCliProject { dir: string, bitJsonPath: string }

function pmCliBuildProject(root: string): PmCliProject {
  let dir = root + "/project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + "    // existing dependency comment -- must survive untouched\n"
  bitJson = bitJson + "    \"existing\": \"github.com/byteink/existing@v1.0.0\"\n"
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write project bit.json: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

function pmCliExpectedBitJson(): string {
  let s = "{\n"
  s = s + "  // top-level project comment -- must survive untouched\n"
  s = s + "  \"name\": \"demo\",\n"
  s = s + "  \"dependencies\": {\n"
  s = s + "    // existing dependency comment -- must survive untouched\n"
  s = s + "    \"existing\": \"github.com/byteink/existing@v1.0.0\",\n"
  s = s + "    \"fixture\": \"local/pmclicheck/fixture@main\"\n"
  s = s + "  }\n"
  s = s + "}\n"
  return s
}

// The full happy path: fetch a fixture dependency, add it to a project with
// an existing commented bit.json, and confirm both files land exactly as
// intended — every other byte of bit.json untouched, bit.lock carrying the
// resolved commit sha. A second add of the same dependency is idempotent:
// same commit, bit.json's entry overwritten in place rather than duplicated.
function checkPmCliAddHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", "main", true, url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency failed: " + e.message())
    pmCliDeadAddResult()
  }
  assert(result.name == "fixture")
  assert(result.commit == fx.sha)
  assert(result.specRef == "local/pmclicheck/fixture@main")

  let newBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
    ""
  }
  assert(newBitJson == pmCliExpectedBitJson())

  let lockPath = proj.dir + "/bit.lock"
  let entries = readLock(lockPath) catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
    []LockEntry(0)
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "fixture")
  assert(entries[0].commit == fx.sha)
  assert(entries[0].url == url)

  let again = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", "main", true, url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: second addDependency failed: " + e.message())
    pmCliDeadAddResult()
  }
  assert(again.commit == fx.sha)
  let entriesAgain = readLock(lockPath) catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
    []LockEntry(0)
  }
  assert(len(entriesAgain) == 1)
  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
    ""
  }
  assert(finalBitJson == pmCliExpectedBitJson())
}

// An omitted `@ref` resolves to the remote's current HEAD and is recorded as
// that exact commit sha in bit.json — never the literal string "HEAD" (spec
// §17.7 names only tag/branch/sha as legal ref forms).
function checkPmCliAddDefaultRef() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", "HEAD", false, url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency (default ref) failed: " + e.message())
    pmCliDeadAddResult()
  }
  assert(result.commit == fx.sha)
  assert(result.specRef == "local/pmclicheck/fixture@" + fx.sha)
}

// A version-shaped ref that undercuts an existing locked dependency's own
// transitive requirement fails loudly rather than silently locking the lower
// version — MVS's rule (spec §17.7 point 2).
function checkPmCliVersionConflict() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let seed = []LockEntry(0)
  seed = append(
    seed, LockEntry{
      name: "other", url: "https://example.com/other.git", commit: fx.sha,
      requires: [LockRequire{ name: "fixture", ref: "v2.0.0" }],
    },
  )
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let failed = false
  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", "v1.0.0", true, url, url,
    pmCheckTimeoutMs,
  ) catch e {
    failed = true
    pmCliDeadAddResult()
  }
  assert(failed)
  assert(len(result.name) == 0)
}

// ---- `bit up`/`bit update` checks (#1735) ------------------------------

function pmCliDeadUpResults(): []UpResult {
  return []UpResult(0)
}

// A project directory whose `bit.json` `dependencies` object is exactly
// `depsBody` (already indented, trailing newline included) — the custom-deps
// counterpart to `pmCliBuildProject` above, needed here so a test can name
// more than one dependency (or none) rather than always the fixed
// `existing`+`fixture` shape `bit add`'s own checks use.
function pmCliBuildProjectDeps(root: string, depsBody: string): PmCliProject {
  let dir = root + "/project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + depsBody
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write project bit.json: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

// Commits `content` to the fixture at `dir` (already `pmBuildFixture`-built),
// moving its HEAD forward — simulates an upstream branch moving between when
// a dependency was first locked and when `bit up` re-resolves it.
function pmAdvanceFixture(dir: string, content: string, timeoutMs: int): string! {
  writeFile(dir + "/hello.txt", content)?
  let add = runGit(defaultGitBin, ["-C", dir, "add", "hello.txt"], timeoutMs)?
  if (add.timedOut || add.exitCode != 0) {
    fail newError("pmclicheck: git add (advance fixture) failed")
  }
  let commit = runGit(defaultGitBin, ["-C", dir, "commit", "--quiet", "-m", "advance"], timeoutMs)?
  if (commit.timedOut || commit.exitCode != 0) {
    fail newError("pmclicheck: git commit (advance fixture) failed")
  }
  return revParseHead(defaultGitBin, dir, timeoutMs)?
}

// `bit up` on a project whose bit.lock is stale (its recorded SHA predates
// the fixture's current HEAD) rewrites bit.lock with the fresh SHA, leaving
// bit.json byte-for-byte untouched (comments included) — the acceptance bar
// ticket #1735 names first.
function checkPmCliUpStaleLock() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host (SPEC §17.7, #2068), not the "local" label the direct
  // function-call fixtures elsewhere in this file use — this string is fed
  // through the real `parseSpec` (`upDependencies` -> `projectDeps`), which
  // now classifies an unrecognized first segment as a vanity name rather
  // than a direct git-host spec. The actual fetch still reaches the local
  // `file://` fixture via the pre-seeded bit.lock `url`, exactly as before;
  // only the label written into bit.json changed.
  let deps = "    // fixture dependency comment -- must survive untouched\n" +
    "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read seeded bit.json: " + e.message())
    ""
  }

  let seed = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
    ""
  }
  assert(newSha != fx.sha)

  let results = upDependencies(proj.dir, cacheRoot, defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies failed: " + e.message())
    pmCliDeadUpResults()
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
    []LockEntry(0)
  }
  assert(len(entries) == 1)
  assert(entries[0].commit == newSha)
  assert(entries[0].url == url)

  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
    ""
  }
  assert(finalBitJson == originalBitJson)
}

// `bit up <name>` restricted to one dependency touches only that dependency's
// bit.lock entry — a sibling entry (never fetched, an unrelated commit that
// would fail if `upDependency` were ever called for it) survives byte-for-
// byte.
function checkPmCliUpSingleName() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\",\n" +
    "    \"other\": \"github.com/byteink/other@v1.0.0\"\n"
  let proj = pmCliBuildProjectDeps(root, deps)

  let otherCommit = "deadbeefdeadbeefdeadbeefdeadbeefdeadbeef"
  let seed = [
    LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) },
    LockEntry{
      name: "other", url: "https://github.com/byteink/other.git", commit: otherCommit,
      requires: []LockRequire(0),
    },
  ]
  writeLock(proj.dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed bit.lock: " + e.message())
  }

  let newSha = pmAdvanceFixture(fx.dir, "advanced for up single\n", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: cannot advance fixture: " + e.message())
    ""
  }

  let results = upDependencies(proj.dir, cacheRoot, defaultGitBin, "fixture", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (single) failed: " + e.message())
    pmCliDeadUpResults()
  }
  assert(len(results) == 1)
  assert(results[0].name == "fixture")
  assert(results[0].commit == newSha)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
    []LockEntry(0)
  }
  assert(len(entries) == 2)
  let i = 0
  let sawOther = false
  let sawFixture = false
  while (i < len(entries)) {
    if (entries[i].name == "other") {
      assert(entries[i].commit == otherCommit)
      assert(entries[i].url == "https://github.com/byteink/other.git")
      sawOther = true
    }
    if (entries[i].name == "fixture") {
      assert(entries[i].commit == newSha)
      sawFixture = true
    }
    i = i + 1
  }
  assert(sawOther && sawFixture)
}

// `bit update` is dispatched by main.bit to the exact same handler as
// `bit up` (`a[1] == "up" || a[1] == "update"` both call `upCmd(a)`, and
// `upCmd` never re-inspects `a[1]`), so the two commands are the same code
// path by construction. What remains to prove is that the shared entry point
// itself is deterministic: run it twice from byte-identical starting states
// (two independent project/cache/lock trees seeded the same way) and confirm
// both land the same resolved commit and the same bit.lock content — that is
// what "`bit update` produces identical output to `bit up`" cashes out to
// once the dispatch itself is a straight pass-through with no branch on the
// alias name.
function checkPmCliUpdateAliasMatchesUp() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  // A known git host, not "local" — see `checkPmCliUpStaleLock`'s comment.
  let deps = "    \"fixture\": \"github.com/pmclicheck/fixture@main\"\n"

  let projA = pmCliBuildProjectDeps(root + "/a", deps)
  let seedA = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projA.dir + "/bit.lock", seedA) catch e {
    panic("pmclicheck: cannot seed bit.lock A: " + e.message())
  }

  let projB = pmCliBuildProjectDeps(root + "/b", deps)
  let seedB = [LockEntry{ name: "fixture", url: url, commit: fx.sha, requires: []LockRequire(0) }]
  writeLock(projB.dir + "/bit.lock", seedB) catch e {
    panic("pmclicheck: cannot seed bit.lock B: " + e.message())
  }

  // Stands in for `bit up`.
  let resultsUp = upDependencies(projA.dir, root + "/cacheA", defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (up) failed: " + e.message())
    pmCliDeadUpResults()
  }
  // Stands in for `bit update` -- the identical call `upCmd` makes for the
  // alias, exercised a second time against an identical starting state.
  let resultsUpdate = upDependencies(projB.dir, root + "/cacheB", defaultGitBin, "", pmCheckTimeoutMs) catch e {
    panic("pmclicheck: upDependencies (update) failed: " + e.message())
    pmCliDeadUpResults()
  }

  assert(len(resultsUp) == len(resultsUpdate))
  assert(resultsUp[0].name == resultsUpdate[0].name)
  assert(resultsUp[0].ref == resultsUpdate[0].ref)
  assert(resultsUp[0].url == resultsUpdate[0].url)
  assert(resultsUp[0].commit == resultsUpdate[0].commit)

  let entriesA = readLock(projA.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock A: " + e.message())
    []LockEntry(0)
  }
  let entriesB = readLock(projB.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock B: " + e.message())
    []LockEntry(0)
  }
  assert(len(entriesA) == len(entriesB))
  assert(entriesA[0].commit == entriesB[0].commit)
  assert(entriesA[0].url == entriesB[0].url)
}

// ---- transitive dependency resolution (#2251) --------------------------
//
// `resolveTransitiveDeps` itself always derives an `https://` (or resolved
// vanity) URL from each requirement spec it discovers — unlike
// `addDependency`, which takes `url`/`fetchUrl` as plain parameters
// specifically so it is testable against a `file://` fixture, a transitive
// dependency has no override channel at all (matching a real `bit add`: only
// the ROOT spec can ever be pointed at `--url`). So there is no in-process,
// network-free way to drive the fetch itself here; what is covered below is
// every non-fetching piece — the extraction/graph-assembly logic that feeds
// `resolveMVS` — plus the empty-seed and already-locked no-op paths, which
// never reach a subprocess at all. The fetch-integrated behaviour this
// ticket's acceptance actually asks for (`bit add` on a dependency whose own
// `bit.json` names a further dependency resolves and locks it) is proven by
// #2251's own manual, mutation-tested repro against the real dispatched CLI
// (see the ticket) — #2315 tracks adding a permanent `tests/imports/`
// regression test for it, the same way `pmadd_e2e` covers `bit add` itself.

function checkPmCliPendingVersionTag() {
  let (v1, ok1) = pendingVersionTag("github.com/byteink/textutil@v1.2.3")
  assert(ok1)
  assert(v1.major == 1 && v1.minor == 2 && v1.patch == 3)

  let (v2, ok2) = pendingVersionTag("bitlang.org/pkg/http@v2.0.1")
  assert(ok2)
  assert(v2.major == 2 && v2.minor == 0 && v2.patch == 1)

  // A branch or a bare commit sha is not MVS-ordered (SPEC §17.7 point 2).
  let (_, ok3) = pendingVersionTag("github.com/byteink/textutil@main")
  assert(!ok3)
  let (_, ok4) = pendingVersionTag("github.com/byteink/textutil@a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2")
  assert(!ok4)

  // No '@' at all is malformed, not a crash.
  let (_, ok5) = pendingVersionTag("no-at-sign-here")
  assert(!ok5)

  // The bug `pendingVersionTag` exists to avoid repeating (#2250): calling
  // `parseVersionTag` directly on a FULL spec string never matches, even
  // though the ref itself is version-shaped, because a full spec's leading
  // byte is never 'v'. `pmToRequirements`/`pmExistingRequirementsFor`
  // (above, pre-existing) still have exactly this bug; #2250 tracks fixing
  // them, not this file.
  let (_, brokenOk) = parseVersionTag("github.com/byteink/textutil@v1.2.3")
  assert(!brokenOk)
}

function checkPmCliLockHasEntry() {
  let entries = [
    LockEntry{ name: "a", url: "https://example.com/a.git", commit: "1111111111111111111111111111111111111111", requires: []LockRequire(0) },
  ]
  assert(lockHasEntry(entries, "a"))
  assert(!lockHasEntry(entries, "b"))
  assert(!lockHasEntry([]LockEntry(0), "a"))
}

function checkPmCliEnqueueRequires() {
  let queue = [PendingReq{ name: "seed", spec: "github.com/x/seed@v1.0.0", fromRoot: true }]
  let rs = [
    LockRequire{ name: "b", ref: "github.com/x/b@v1.0.0" },
    LockRequire{ name: "c", ref: "github.com/x/c@main" },
  ]
  let out = enqueueRequires(queue, rs)
  assert(len(out) == 3)
  assert(out[0].name == "seed" && out[0].fromRoot)
  assert(out[1].name == "b" && !out[1].fromRoot && out[1].spec == "github.com/x/b@v1.0.0")
  assert(out[2].name == "c" && !out[2].fromRoot && out[2].spec == "github.com/x/c@main")
}

function checkPmCliVersionRequirementsOf() {
  let rs = [
    LockRequire{ name: "b", ref: "github.com/x/b@v1.0.0" },
    LockRequire{ name: "c", ref: "github.com/x/c@main" }, // not version-tagged, dropped
    LockRequire{ name: "d", ref: "bitlang.org/pkg/d@v2.5.1" },
  ]
  let out = versionRequirementsOf(rs)
  assert(len(out) == 2)
  assert(out[0].name == "b")
  assert(out[0].min.major == 1 && out[0].min.minor == 0 && out[0].min.patch == 0)
  assert(out[1].name == "d")
  assert(out[1].min.major == 2 && out[1].min.minor == 5 && out[1].min.patch == 1)
}

function checkPmCliFlattenRequires() {
  let entries = [
    LockEntry{
      name: "a", url: "https://example.com/a.git", commit: "1111111111111111111111111111111111111111",
      requires: [LockRequire{ name: "x", ref: "github.com/x/x@v1.0.0" }],
    },
    LockEntry{ name: "b", url: "https://example.com/b.git", commit: "2222222222222222222222222222222222222222", requires: []LockRequire(0) },
    LockEntry{
      name: "c", url: "https://example.com/c.git", commit: "3333333333333333333333333333333333333333",
      requires: [LockRequire{ name: "y", ref: "github.com/y/y@main" }],
    },
  ]
  let flat = flattenRequires(entries)
  assert(len(flat) == 2)
  assert(flat[0].name == "x")
  assert(flat[1].name == "y")
}

// An empty `seed` never enters the walk at all — no fetch, no error,
// `entries` returned unchanged.
function checkPmCliResolveTransitiveDepsEmptySeed() {
  let entries = [
    LockEntry{ name: "a", url: "https://example.com/a.git", commit: "1111111111111111111111111111111111111111", requires: []LockRequire(0) },
  ]
  let out = resolveTransitiveDeps("unused-cache-root", defaultGitBin, entries, []LockRequire(0), pmCheckTimeoutMs) catch e {
    panic("pmclicheck: resolveTransitiveDeps with an empty seed failed: " + e.message())
    []LockEntry(0)
  }
  assert(len(out) == 1)
  assert(out[0].name == "a")
  assert(out[0].commit == "1111111111111111111111111111111111111111")
}

function checkPmCli() {
  checkPmCliAddHappyPath()
  checkPmCliAddDefaultRef()
  checkPmCliVersionConflict()
  checkPmCliUpStaleLock()
  checkPmCliUpSingleName()
  checkPmCliUpdateAliasMatchesUp()
  checkPmCliRemoveHappyPath()
  checkPmCliRemoveMissing()
  checkPmCliPendingVersionTag()
  checkPmCliLockHasEntry()
  checkPmCliEnqueueRequires()
  checkPmCliVersionRequirementsOf()
  checkPmCliFlattenRequires()
  checkPmCliResolveTransitiveDepsEmptySeed()
}
