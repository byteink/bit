// In-Bit self-checks for compiler/pmcli.bit's `bit add` flow (#1734). Sibling
// of pmcli.bit (same module), named to sort after it. Run by `selfcheck()`
// under `./make test`, the same convention pmfetchcheck.bit/
// pmresolvecheck.bit/pmlockcheck.bit already establish for this class of
// test: `bit add` shells out to git and touches the filesystem, so it is
// exercised here as a real in-Bit call against a local git fixture
// (`file://`, never network) — not as a golden `tests/cases/*.bit`
// single-file program, which cannot import `std/json` at all (see
// json_edit_set_existing.bit's own header) and so cannot reach the CST edit
// layer that is this whole file's point to prove.
//
// Reuses pmfetchcheck.bit's `pmCheckScratchDir`/`pmBuildFixture`/
// `pmCheckTimeoutMs` (same module) rather than re-deriving a fixture builder.
//
// This file also crossed the 800-line limit (#2967, after #2244 landed
// dependency-spec forms) and split further, same module, sibling files:
//   - compiler/pmclichecktail.bit: the `bit remove` checks and the
//     non-fetching `resolveTransitiveDeps`-graph-assembly checks.
//   - compiler/pmcliaddedgecheck.bit: the `bit add` edge-case/security
//     checks (nested-group, ssh, MVS conflict, URL collision, the
//     transitive-local-dependency ban, and the manifest-precondition
//     checks). Both reuse this file's `import { contains } from "std/strings"`
//     / `import { readDir } from "std/fs"` and its shared fixtures
//     (`pmCliDeadAddResult`, `PmCliProject`, `pmCliBuildProject`,
//     `pmCliExpectedBitJson`) unqualified — an import is per-MODULE, not
//     per-file, so re-importing either name in a sibling would be
//     `E0042 already declared in this scope`.
import { contains } from "std/strings"
import { readDir } from "std/fs"

fn pmCliDeadAddResult(): AddResult {
  return AddResult{ name: "", specRef: "", url: "", commit: "" }
}

// A project directory with a `bit.json` carrying a user comment and one
// pre-existing dependency, ready for `bit add` to touch.
class PmCliProject { dir: string, bitJsonPath: string }

fn pmCliBuildProject(root: string): PmCliProject {
  let dir = root + "/project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + "    // existing dependency comment -- must survive untouched\n"
  bitJson = bitJson + "    \"existing\": \"github.com/byteink/existing@v1.0.0\"\n"
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write project bit.json: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

fn pmCliExpectedBitJson(): string {
  let s = "{\n"
  s = s + "  // top-level project comment -- must survive untouched\n"
  s = s + "  \"name\": \"demo\",\n"
  s = s + "  \"dependencies\": {\n"
  s = s + "    // existing dependency comment -- must survive untouched\n"
  s = s + "    \"existing\": \"github.com/byteink/existing@v1.0.0\",\n"
  s = s + "    \"fixture\": \"local/pmclicheck/fixture@main\"\n"
  s = s + "  }\n"
  s = s + "}\n"
  return s
}

// The full happy path: fetch a fixture dependency, add it to a project with
// an existing commented bit.json, and confirm both files land exactly as
// intended — every other byte of bit.json untouched, bit.lock carrying the
// resolved commit sha. A second add of the same dependency is idempotent:
// same commit, bit.json's entry overwritten in place rather than duplicated.
fn checkPmCliAddHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", true, "main", url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency failed: " + e.message())
  }
  assert(result.name == "fixture")
  assert(result.commit == fx.sha)
  assert(result.specRef == "local/pmclicheck/fixture@main")

  let newBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
  }
  assert(newBitJson == pmCliExpectedBitJson())

  let lockPath = proj.dir + "/bit.lock"
  let entries = readLock(lockPath) catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "fixture")
  assert(entries[0].commit == fx.sha)
  assert(entries[0].url == url)

  let again = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", "fixture", true, "main", url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: second addDependency failed: " + e.message())
  }
  assert(again.commit == fx.sha)
  let entriesAgain = readLock(lockPath) catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entriesAgain) == 1)
  let finalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
  }
  assert(finalBitJson == pmCliExpectedBitJson())
}

// #2367 rows 2-5 of the required-behaviour table: an explicit
// version-shaped ref resolves the HIGHEST available tag satisfying it and
// writes the constraint back canonically — never a `v` prefix under any
// spelling; `^`/`~` write exactly what was typed, never the version they
// happened to resolve to. One fixture, six tags across six commits, reused
// under four different dependency NAMES so the four adds never collide on
// the same bit.json/bit.lock key.
fn checkPmCliAddVersionForms() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"
  let proj = pmCliBuildProject(root)

  let tagV1 = runGit(
    defaultGitBin,
    ["-C", fx.dir, "tag", "-a", "v1.0.0", "-m", "v1.0.0"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: git tag v1.0.0 failed: " + e.message())
  }
  pmGitMustSucceed("tag v1.0.0", tagV1)
  let sha120 = pmCliCommitAndTag(fx.dir, "v1.2.0 commit", "v1.2.0")
  let sha123 = pmCliCommitAndTag(fx.dir, "v1.2.3 commit", "v1.2.3")
  let sha140 = pmCliCommitAndTag(fx.dir, "v1.4.0 commit", "v1.4.0")
  let sha150 = pmCliCommitAndTag(fx.dir, "v1.5.0 commit", "v1.5.0")
  let sha200 = pmCliCommitAndTag(fx.dir, "v2.0.0 commit", "v2.0.0")
  assert(isFullSha(sha120) && isFullSha(sha140) && isFullSha(sha200))

  // Row 2: bare exact -> written verbatim, resolves that exact tag.
  pmCliAssertAddedVersion(proj, cacheRoot, url, PmCliVersionRow{
    name: "fixture-exact", version: "1.2.3",
    wantCommit: sha123, wantSpecRef: "local/pmclicheck/fixture-exact@1.2.3",
  })

  // Row 3: v-prefixed exact -> canonicalised, same commit as row 2.
  pmCliAssertAddedVersion(proj, cacheRoot, url, PmCliVersionRow{
    name: "fixture-vexact", version: "v1.2.3",
    wantCommit: sha123, wantSpecRef: "local/pmclicheck/fixture-vexact@1.2.3",
  })

  // Row 4: caret -> written AS WRITTEN, resolves the highest tag inside
  // [1.2.0, 2.0.0) — v1.5.0, not the v2.0.0 tag caret's upper bound excludes.
  pmCliAssertAddedVersion(proj, cacheRoot, url, PmCliVersionRow{
    name: "fixture-caret", version: "^1.2.0",
    wantCommit: sha150, wantSpecRef: "local/pmclicheck/fixture-caret@^1.2.0",
  })

  // Row 5: tilde -> written AS WRITTEN, resolves the highest tag inside
  // [1.2.0, 1.3.0) — v1.2.3, not v1.4.0/v1.5.0 tilde's upper bound excludes.
  pmCliAssertAddedVersion(proj, cacheRoot, url, PmCliVersionRow{
    name: "fixture-tilde", version: "~1.2.0",
    wantCommit: sha123, wantSpecRef: "local/pmclicheck/fixture-tilde@~1.2.0",
  })

  // Confirms `rewriteManifest` actually persisted what `AddResult.specRef`
  // claims for all four rows — a project's PRE-EXISTING dependency
  // (`pmCliBuildProject`'s own "existing@v1.0.0") legitimately keeps its `v`
  // prefix untouched, so this checks the four NEW entries specifically
  // rather than scanning the whole file for "@v".
  let bitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
  }
  assert(contains(bitJson, "\"fixture-exact\": \"local/pmclicheck/fixture-exact@1.2.3\""))
  assert(contains(bitJson, "\"fixture-vexact\": \"local/pmclicheck/fixture-vexact@1.2.3\""))
  assert(contains(bitJson, "\"fixture-caret\": \"local/pmclicheck/fixture-caret@^1.2.0\""))
  assert(contains(bitJson, "\"fixture-tilde\": \"local/pmclicheck/fixture-tilde@~1.2.0\""))
}

// The dependency name, version-spec and expected outcome for one
// `addDependency` row in `checkPmCliAddVersionForms` — grouped into a class
// (per E0202) since the four rows share every other argument.
class PmCliVersionRow { name: string, version: string, wantCommit: string, wantSpecRef: string }

// Runs one row plus its two assertions, shared by all four version-form
// rows in `checkPmCliAddVersionForms` above — they differ only in `row`.
fn pmCliAssertAddedVersion(proj: PmCliProject, cacheRoot: string, url: string, row: PmCliVersionRow) {
  let result = addDependency(
    proj.dir, cacheRoot, defaultGitBin,
    "local", "pmclicheck", row.name, true, row.version, url, url,
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addDependency (" + row.name + ") failed: " + e.message())
  }
  assert(result.commit == row.wantCommit)
  assert(result.specRef == row.wantSpecRef)
}

// The message `addDependency` failed with, or "" if it unexpectedly
// succeeded — mirrors `pmCliTryRemoveMessage` (above); needed because
// `addDependency`'s success type is `AddResult`, so its catch block must
// divert (here, `return`) rather than trail off with no value.
fn pmCliTryAddMessage(
  projectDir: string, cacheRoot: string, gitBin: string,
  host: string, owner: string, repo: string, ref: string,
  url: string, fetchUrl: string, timeoutMs: int,
): string {
  addDependency(projectDir, cacheRoot, gitBin, host, owner, repo, true, ref, url, fetchUrl, timeoutMs) catch e {
    return e.message()
  }
  return ""
}

// As `pmCliTryAddMessage`, for `addLocalDependency` (#2244).
fn pmCliTryAddLocalMessage(
  projectDir: string, cacheRoot: string, name: string, rawSpec: string, localPath: string,
): string {
  addLocalDependency(projectDir, cacheRoot, defaultGitBin, name, rawSpec, localPath, pmCheckTimeoutMs) catch e {
    return e.message()
  }
  return ""
}

// A plain directory (never a git repo) with one exported function — the
// local-path/"file://" dependency fixture (#2244): neither form fetches at
// all, so there is nothing to `git init` here, unlike every other fixture in
// this file.
fn pmCliBuildLocalDepFixture(root: string): string {
  let dir = root + "/localdep"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create local dep fixture dir: " + e.message())
  }
  writeFile(dir + "/textutil.bit", "export fn hi(): string {\n  return \"hi from local dep\"\n}\n") catch e {
    panic("pmclicheck: cannot write local dep fixture module: " + e.message())
  }
  return dir
}

// #2244 acceptance: a RELATIVE local path — `bit add ../textutil`, the
// sibling-directory development loop the ticket exists for — resolves with
// no network and no `git` involved at all: `bit.lock` records a `path`
// entry with empty `url`/`commit`, and `bit.json` records the raw spec the
// user typed, byte for byte.
fn checkPmCliAddLocalPathHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  pmCliBuildLocalDepFixture(root)
  let proj = pmCliBuildProject(root)
  let cacheRoot = root + "/cache"

  // `depDir` (`root/localdep`) is a sibling of `proj.dir` (`root/project`).
  let relSpec = "../localdep"

  let result = addLocalDependency(
    proj.dir, cacheRoot, defaultGitBin, "localdep", relSpec, relSpec, pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addLocalDependency failed: " + e.message())
  }
  assert(result.name == "localdep")
  assert(result.specRef == relSpec)
  assert(len(result.commit) == 0)
  assert(len(result.url) == 0)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "localdep")
  assert(entries[0].localPath == relSpec)
  assert(len(entries[0].url) == 0)
  assert(len(entries[0].commit) == 0)
  assert(len(entries[0].vanity) == 0)

  let bitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read updated bit.json: " + e.message())
  }
  assert(contains(bitJson, "\"localdep\": \"../localdep\""))

  // The raw JSON on disk must literally record `path`, never an empty `url`
  // or `commit` — pmlock.bit's `lockAddEntry` omits both entirely for this
  // kind of entry.
  let rawLock = readFile(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read raw bit.lock: " + e.message())
  }
  assert(contains(rawLock, "\"path\""))
  assert(!contains(rawLock, "\"url\""))
  assert(!contains(rawLock, "\"commit\""))
}

// #2244 acceptance, through the REAL CLI dispatch this time: `addCmd`
// itself — argv parsing, `--dir`, `hasExplicitRef`/`parseAddSpec` routing,
// and the new `d.scheme == "local"` branch — rather than `addLocalDependency`
// called directly (every fixture above this one). Safe to call in-process
// (unlike a fetching form): `addCmd`'s local branch never uses the cache
// root it reads from the real environment (`defaultCacheRoot()`) for
// anything, since a local dependency is never fetched or cached, so this
// cannot write into — or collide with — the developer's real `~/.bit/pkg`.
// A fetching form (ssh/nested-group/direct/vanity) genuinely would, which is
// exactly why every other `addCmd` exercise in this repo
// (tests/bit/pmaddgit.bit, tests/bit/pmvanity.bit) runs as a real subprocess
// with `BIT_PKG_CACHE` overridden instead of an in-process call.
fn checkPmCliAddCmdLocalPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  pmCliBuildLocalDepFixture(root)
  let proj = pmCliBuildProject(root)

  let rc = addCmd(["bit", "add", "../localdep", "--dir", proj.dir])
  assert(rc == 0)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "localdep")
  assert(entries[0].localPath == "../localdep")

  // `--url` is meaningless for a local dependency and must be a usage error
  // (exit 2), never silently ignored.
  let rejected = addCmd(["bit", "add", "../localdep", "--dir", proj.dir, "--url", "file:///nowhere"])
  assert(rejected == 2)
}

// #2244 acceptance: a "file://" URL resolves through the identical
// local-path machinery as a bare path — `parseSpec` decodes it to the same
// kind of `DepSpec` (`scheme == "local"`), just with an absolute
// `localPath` instead of a relative one.
fn checkPmCliAddFileUrlHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let depDir = pmCliBuildLocalDepFixture(root)
  let proj = pmCliBuildProject(root)
  let cacheRoot = root + "/cache"

  let spec = "file://" + depDir
  let d = parseSpec(spec) catch e {
    panic("pmclicheck: parseSpec rejected a file:// spec: " + e.message())
  }
  assert(d.scheme == "local")
  assert(d.localPath == depDir)

  let result = addLocalDependency(
    proj.dir, cacheRoot, defaultGitBin, "localdep", spec, d.localPath, pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: addLocalDependency (file://) failed: " + e.message())
  }
  assert(result.specRef == spec)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].localPath == depDir)
  assert(isDir(entries[0].localPath))
}

// #2244 SECURITY: a local path that does not exist (or is not a directory)
// is refused before anything is written — never a silent, broken bit.lock
// entry pointing nowhere.
fn checkPmCliAddLocalPathMissing() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let proj = pmCliBuildProject(root)
  let cacheRoot = root + "/cache"

  let errMsg = pmCliTryAddLocalMessage(proj.dir, cacheRoot, "nope", "../does-not-exist", "../does-not-exist")
  assert(len(errMsg) > 0)
  assert(contains(errMsg, "does not exist"))

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock: " + e.message())
  }
  assert(len(entries) == 0)
}

fn checkPmCli() {
  checkPmCliAddHappyPath()
  checkPmCliAddMissingManifestLeavesNoDebris()
  checkPmCliAddInvalidManifestLeavesNoDebris()
  checkPmCliRewriteManifestNoDependenciesKey()
  checkPmCliAddDefaultRef()
  checkPmCliAddVersionForms()
  checkPmCliVersionConflict()
  checkPmCliDirectSpecUrlCollision()
  checkPmCliUpStaleLock()
  checkPmCliUpSingleName()
  checkPmCliUpdateAliasMatchesUp()
  checkPmCliRemoveHappyPath()
  checkPmCliRemoveMissing()
  checkPmCliPendingVersionTag()
  checkPmCliLockHasEntry()
  checkPmCliEnqueueRequires()
  checkPmCliVersionRequirementsOf()
  checkPmCliFlattenRequires()
  checkPmCliResolveTransitiveDepsEmptySeed()
  checkPmCliAddLocalPathHappyPath()
  checkPmCliAddCmdLocalPath()
  checkPmCliAddFileUrlHappyPath()
  checkPmCliAddLocalPathMissing()
  checkPmCliAddNestedGroupHappyPath()
  checkPmCliAddSshUrlRecorded()
  checkPmCliTransitiveLocalDependencyBanned()
}
