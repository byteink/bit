// compiler/optloopemit.bit — the REBUILD half of loop-invariant code motion
// (#4051), split out of optloop.bit under the 800-line file limit (#4063).
//
// optloop.bit decides WHAT moves and produces a `LicmPlan`. This file performs
// it, from inside opt.bit's `rebuildBlock`. The two halves share no state but
// that plan, which is why this is the seam.
//
// The three steps a hoist costs, and the block each one runs in:
//
//   `licmEmitHoisted`  in the PREHEADER, immediately before its terminator;
//   `licmAddParams`    in the HEADER, after its own params;
//   `licmExtendEdges`  in EVERY block whose terminator branches to a header.
//
// Nothing here re-derives a decision. `remap[I]` already holds the right new
// id at each point: the preheader's terminator is emitted while `remap[I]`
// still names the value `licmEmitHoisted` emitted, and every back-edge block
// is emitted after the header, by which time `licmAddParams` has overwritten
// it with the param id.
//
// A DUPLICATE (`plan.dupOf[k] >= 0`) is emitted nowhere and joins no parameter
// list: it takes the original's new id in `remap` and disappears. See
// optloop.bit's `licmDupOf` for what makes two hoists the same computation.

// True iff instruction `idx` is emitted somewhere other than `bi`, so `bi`'s
// own walk must skip it.
fn licmMovedAway(plan: LicmPlan, bi: int, idx: int): bool {
  return plan.home[idx] >= 0 && plan.home[idx] != bi
}

// The extra params `bi` carries as a hoist header, appended after its own. The
// walk order is `ids` order, matching `licmEdgeArgs`' append below.
fn licmAddParams(rc: RebuildCtx, bi: int) {
  let plan = rc.plan.licm
  let k = 0
  while (k < len(plan.ids)) {
    if (plan.hdr[plan.ids[k]] == bi) {
      rc.remap[plan.ids[k]] = builderAddParam(rc.b, rc.f.instrs[plan.ids[k]].ty)
    }
    k = k + 1
  }
}

// Emits the instructions hoisted into `bi`, immediately before its terminator.
//
// Each one reads an invariant param of the header it is being lifted out of, a
// value that does not exist here — so `remap` for that param slot is pointed
// at the preheader edge's argument first. The override is temporary by
// construction: the header is rebuilt after this block and `builderAddParam`
// writes the same slot again.
fn licmEmitHoisted(rc: RebuildCtx, bi: int) {
  let plan = rc.plan.licm
  let k = 0
  while (k < len(plan.ids)) {
    let id = plan.ids[k]
    if (plan.home[id] == bi) {
      rc.remap[rc.f.instrs[id].lhs] = rc.remap[plan.pre[k]]
      emitTranslated(rc.b, rc.f, rc.plan.known, rc.remap, rc.blockMap, id)
    }
    k = k + 1
  }
}

// `args` with one entry appended for every value hoisted onto `oldTarget`'s
// param list. `remap` already holds the right new id: the preheader's
// terminator is emitted while it still names the value emitted by
// `licmEmitHoisted`, and every back-edge block is emitted after the header, by
// which point `licmAddParams` has overwritten it with the param.
fn licmEdgeExtra(rc: RebuildCtx, args: []int, oldTarget: int): []int {
  let plan = rc.plan.licm
  let out = licmCopyInts(args)
  let k = 0
  while (k < len(plan.ids)) {
    if (plan.hdr[plan.ids[k]] == oldTarget) {
      out = append(out, rc.remap[plan.ids[k]])
    }
    k = k + 1
  }
  return out
}

// Extends the argument lists of the terminator `emitTranslated` has just
// emitted. Reading the EMITTED instruction rather than the original is what
// keeps this correct when a `br` with a known condition has collapsed to a
// `jump`: the surviving target is read off the result instead of the decision
// being duplicated here, where it could drift.
// A FRESH list, never `args` itself: the emitted terminator's argument slice is
// the builder's own, and `append` aliases its backing (SPEC §13.6), so growing
// it in place could write through to whatever else shares that array.
fn licmCopyInts(src: []int): []int {
  let out = []int(0)
  let i = 0
  while (i < len(src)) {
    out = append(out, src[i])
    i = i + 1
  }
  return out
}

fn licmExtendEdges(rc: RebuildCtx) {
  if (len(rc.plan.licm.ids) == 0) {
    return
  }
  let t = rc.b.instrs[len(rc.b.instrs) - 1]
  if (t.op == Op.Jump) {
    t.args = licmEdgeExtra(rc, t.args, rc.newToOld[t.ival])
    return
  }
  if (t.op == Op.Br) {
    t.thenArgs = licmEdgeExtra(rc, t.thenArgs, rc.newToOld[t.ival])
    t.elseArgs = licmEdgeExtra(rc, t.elseArgs, rc.newToOld[t.ival2])
  }
}
