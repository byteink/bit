// compiler/optloopemit.bit — the REBUILD half of loop-invariant code motion
// (#4051), split out of optloop.bit under the 800-line file limit (#4063).
//
// optloop.bit finds the loops and optloopcand.bit decides what may leave one,
// together producing a `LicmPlan`. This file performs it, from inside optrebuild.bit's
// `rebuildBlock`. The halves share no state but that plan, which is the seam.
//
// The three steps a hoist costs, and the block each one runs in:
//
//   `licmEmitHoisted`  in the PREHEADER, immediately before its terminator;
//   `licmAddParams`    in the HEADER, after its own params;
//   `licmExtendEdges`  in EVERY block whose terminator branches to a header.
//
// Nothing here re-derives a decision. `remap[I]` already holds the right new
// id at each point: the preheader's terminator is emitted while `remap[I]`
// still names the value `licmEmitHoisted` emitted, and every back-edge block
// is emitted after the header, by which time `licmAddParams` has overwritten
// it with the param id.
//
// A DUPLICATE (`plan.dupOf[k] >= 0`) is emitted nowhere and joins no parameter
// list: it takes the original's new id in `remap` and disappears. See
// optloopcand.bit's `licmDupOf` for what makes two hoists the same computation.

// True iff instruction `idx` is emitted somewhere other than `bi`, so `bi`'s
// own walk must skip it.
fn licmMovedAway(plan: LicmPlan, bi: int, idx: int): bool {
  return plan.home[idx] >= 0 && plan.home[idx] != bi
}

// The extra params `bi` carries as a hoist header, appended after its own. The
// walk order is `ids` order, matching `licmEdgeArgs`' append below.
//
// A DUPLICATE adds no param. It takes the original's id, which `remap` already
// holds: both entries name this same header, `ids` is walked in order, and
// `licmDupOf` only ever points backwards — so the original's branch below has
// run before the duplicate's reads it.
fn licmAddParams(rc: RebuildCtx, bi: int) {
  let plan = rc.plan.licm
  let k = 0
  while (k < len(plan.ids)) {
    if (plan.hdr[plan.ids[k]] == bi) {
      if (plan.dupOf[k] >= 0) {
        rc.remap[plan.ids[k]] = rc.remap[plan.dupOf[k]]
      } else {
        rc.remap[plan.ids[k]] = builderAddParam(rc.b, rc.f.instrs[plan.ids[k]].ty)
      }
    }
    k = k + 1
  }
}

// The new id an operand of a hoist takes in the preheader. An invariant param
// of the header being lifted out of does not exist here, so its slot is
// pointed at the preheader edge's argument (`pre`, optloopcand.bit).
//
// A COMPILE-TIME CONSTANT operand has no edge argument to read and `remap` has
// no answer for it — the `const_int` that defines it lives inside the loop and
// has not been emitted when the preheader is rebuilt. It is materialized here
// instead, exactly as `emitTranslated` would materialize it in the body.
//
// `pre == operand` is the discriminator, and it is exact rather than a
// heuristic: `licmPreSource` records the operand's own id for a constant and
// the preheader edge's argument for a param, and a header's own parameter id
// can never BE that argument — the argument is a value live in the preheader,
// and verify.bit rejects a block that reads a value the header defines.
//
// It is deliberately not `known[operand]`. `proveInductionBounds` (optbce.bit)
// writes new entries into this same `known` array AFTER `licmPlanFor` has
// read it, so that question has two different answers either side of the plan
// and this one has one.
fn licmPreValue(rc: RebuildCtx, operand: int, pre: int): int {
  if (pre == operand) {
    let c = rc.f.instrs[operand]
    return emitConst(rc.b, rc.plan.known[operand], c.ty, c.span)
  }
  return rc.remap[pre]
}

// Points `remap` at the preheader values of hoist `k`'s operands. Every
// override is temporary by construction: the header is rebuilt after this
// block and `builderAddParam` writes a param's slot again, and the body is
// rebuilt after that and re-emits a constant's own `const_int` into its slot.
//
// `preRhs` is -1 for a one-operand instruction, which is every `slice_len` and
// every `field_get`. An arithmetic hoist (#4052) has two, and missing the
// second would emit the preheader copy reading a header param that does not
// exist yet — value id 0, silently.
//
// A HOISTED CONSTANT (#4729) binds nothing: it has no operands, and
// `licmConstPre` (optloopcand.bit) is the negative entry that says so. Reading
// `ins.lhs` for one would overwrite `remap` for whatever value id happens to
// sit in that unused field.
fn licmBindOperands(rc: RebuildCtx, k: int) {
  let plan = rc.plan.licm
  if (plan.pre[k] < 0) {
    return
  }
  let ins = rc.f.instrs[plan.ids[k]]
  rc.remap[ins.lhs] = licmPreValue(rc, ins.lhs, plan.pre[k])
  if (plan.preRhs[k] >= 0) {
    rc.remap[ins.rhs] = licmPreValue(rc, ins.rhs, plan.preRhs[k])
  }
}

// Emits the instructions hoisted into `bi`, immediately before its terminator.
fn licmEmitHoisted(rc: RebuildCtx, bi: int) {
  let plan = rc.plan.licm
  let k = 0
  while (k < len(plan.ids)) {
    let id = plan.ids[k]
    if (plan.home[id] == bi && plan.dupOf[k] < 0) {
      licmBindOperands(rc, k)
      emitTranslated(rc.b, rc.f, rc.plan.known, rc.remap, rc.blockMap, id)
    }
    k = k + 1
  }
}

// `args` with one entry appended for every value hoisted onto `oldTarget`'s
// param list. `remap` already holds the right new id: the preheader's
// terminator is emitted while it still names the value emitted by
// `licmEmitHoisted`, and every back-edge block is emitted after the header, by
// which point `licmAddParams` has overwritten it with the param.
fn licmEdgeExtra(rc: RebuildCtx, args: []int, oldTarget: int): []int {
  let plan = rc.plan.licm
  let out = licmCopyInts(args)
  let k = 0
  while (k < len(plan.ids)) {
    if (plan.hdr[plan.ids[k]] == oldTarget && plan.dupOf[k] < 0) {
      out = append(out, rc.remap[plan.ids[k]])
    }
    k = k + 1
  }
  return out
}

// Extends the argument lists of the terminator `emitTranslated` has just
// emitted. Reading the EMITTED instruction rather than the original is what
// keeps this correct when a `br` with a known condition has collapsed to a
// `jump`: the surviving target is read off the result instead of the decision
// being duplicated here, where it could drift.
// A FRESH list, never `args` itself: the emitted terminator's argument slice is
// the builder's own, and `append` aliases its backing (SPEC §13.6), so growing
// it in place could write through to whatever else shares that array.
fn licmCopyInts(src: []int): []int {
  let out = []int(0)
  let i = 0
  while (i < len(src)) {
    out = append(out, src[i])
    i = i + 1
  }
  return out
}

fn licmExtendEdges(rc: RebuildCtx) {
  if (len(rc.plan.licm.ids) == 0) {
    return
  }
  let t = rc.b.instrs[len(rc.b.instrs) - 1]
  if (t.op == Op.Jump) {
    t.args = licmEdgeExtra(rc, t.args, rc.newToOld[t.ival])
    return
  }
  if (t.op == Op.Br) {
    t.thenArgs = licmEdgeExtra(rc, t.thenArgs, rc.newToOld[t.ival])
    t.elseArgs = licmEdgeExtra(rc, t.elseArgs, rc.newToOld[t.ival2])
  }
}
