// compiler/classjsonfield.bit — what one field of a `@json` class IS (#3976).
//
// Split out of classjson.bit, which was 30 lines under the repo's 800-line
// ceiling on the day it was written: this half answers "can this field be
// serialized, and as what", the other half answers "which classes and which
// keys". A sibling `.bit` file is the same module, so this is a pure move.
//
// Everything here is SYNTACTIC. It runs from `resolveProject` before any
// Checker exists, so a field's type is the node the parser built and never a
// TypeId — which is why a nested class is judged by looking up its
// DECLARATION (in this module, or in an already-parsed imported one) rather
// than by asking whether its type has a `toJson` member.

// ---- field classification --------------------------------------------------

// What a module-local type declaration is, as far as `@json` cares. A name
// ABSENT from `JsonCtx.marks` is not declared in this module at all, which is
// the only case this cannot judge syntactically — see `vJsonNestedMark`.
const jmJsonClass = 1
const jmPlainClass = 2
const jmOtherDecl = 3

// The module being synthesized for, threaded as one value so every function
// below stays inside LINT.md's max-params=5 while carrying the module-local
// type table each field's type has to be judged against.
class JsonCtx {
  proj: Project,
  mod: SrcModule,
  tree: Tree,
  source: string,
  diags: Diagnostics,
  marks: map<string, int>,
}

fn newJsonCtx(p: Project, m: SrcModule): JsonCtx {
  let tree = m.tree
  let source = m.source
  let marks = map<string, int>{}
  for d0 of kidsOf(tree, tree.root) {
    let d = d0
    if (d != 0 && getNode(tree, d).tag == Tag.Export) {
      d = kidsOf(tree, d)[0]
    }
    if (d == 0) {
      continue
    }
    let tag = getNode(tree, d).tag
    if (tag == Tag.StructDecl) {
      let mark = jmPlainClass
      if (classHasJson(tree, source, d)) {
        mark = jmJsonClass
      }
      marks[identText(tree, source, kidsOf(tree, d)[0])] = mark
      continue
    }
    if (tag == Tag.EnumDecl || tag == Tag.InterfaceDecl || tag == Tag.TypeAlias) {
      marks[identText(tree, source, kidsOf(tree, d)[0])] = jmOtherDecl
    }
  }
  return JsonCtx{
    proj: p, mod: m, tree: tree, source: source, diags: p.diags, marks: marks,
  }
}

// The node's source text — a type node's exact spelling, for a diagnostic that
// quotes the type the reader wrote rather than one the checker interned.
fn jsonNodeText(jx: JsonCtx, node: int): string {
  let sp = getNode(jx.tree, node).span
  return jx.source[sp.start:sp.end]
}

// The shape a declared type has, and its element/value/payload type node for
// the three container shapes (0 otherwise). Purely SYNTACTIC: this runs before
// any Checker exists, so it reads the type node the parser built and never a
// TypeId. A name it does not recognize is `jkNested` — a class expected to
// carry `@json` of its own, judged by `vJsonNestedMark`.
fn classifyJsonType(jx: JsonCtx, typeNode: int): (int, int) {
  if (typeNode == 0) {
    return (jkBad, 0)
  }
  let n = getNode(jx.tree, typeNode)
  if (n.tag == Tag.Ident) {
    return (scalarJsonKind(jsonNodeText(jx, typeNode)), 0)
  }
  if (n.tag == Tag.QualType) {
    return (jkNested, 0)
  }
  if (n.tag == Tag.SliceType) {
    return (jkSlice, kidsOf(jx.tree, typeNode)[0])
  }
  if (n.tag == Tag.MapType) {
    return mapJsonKind(jx, typeNode)
  }
  if (n.tag == Tag.GenericInst) {
    return genericJsonKind(jx, typeNode)
  }
  return (jkBad, 0)
}

// `map<K, V>`: a JSON object's keys are strings, so only a `string` key has an
// object to become. Its own function to keep `classifyJsonType` under LINT.md's
// max-complexity=10 as the type grammar grows.
fn mapJsonKind(jx: JsonCtx, typeNode: int): (int, int) {
  let mk = kidsOf(jx.tree, typeNode)
  if (getNode(jx.tree, mk[0]).tag != Tag.Ident || jsonNodeText(jx, mk[0]) != "string") {
    return (jkBad, 0)
  }
  return (jkMap, mk[1])
}

// `T<A, ...>`: `Option<T>` is the one instantiation with a JSON meaning of its
// own; every other one is a nested class, judged by `vJsonNestedMark` like any
// other named type.
fn genericJsonKind(jx: JsonCtx, typeNode: int): (int, int) {
  let gk = kidsOf(jx.tree, typeNode)
  let targs = kidsOf(jx.tree, gk[1])
  if (jsonNodeText(jx, gk[0]) == "Option" && len(targs) == 1) {
    return (jkOption, targs[0])
  }
  return (jkNested, 0)
}

// A predeclared name's JSON shape, or `jkNested` for any other bare name. Every
// integer kind maps to `jkInt` and both float kinds to `jkFloat`; the builder
// emits an explicit `i64(...)`/`f64(...)` conversion for the ones that are not
// already the payload type, so no kind reaches a `Json` constructor unconverted.
fn scalarJsonKind(name: string): int {
  if (name == "bool") {
    return jkBool
  }
  if (name == "string") {
    return jkString
  }
  if (name == "f32" || name == "f64") {
    return jkFloat
  }
  for n of ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "int", "uint", "byte", "rune"] {
    if (name == n) {
      return jkInt
    }
  }
  return jkNested
}

// True iff `kind` needs no accumulator and no loop — the shapes a container's
// element is allowed to have. `[]T`, `map<string, T>` and `Option<T>` each
// nest exactly one level deep: a `[][]T` would need a second accumulator whose
// name this file would have to invent, and no caller has asked for one.
fn simpleJsonKind(kind: int): bool {
  return kind == jkInt || kind == jkFloat || kind == jkBool || kind == jkString || kind == jkNested
}

// ---- per-field validation --------------------------------------------------

// One `@json` class's serializable fields, and whether every field passed.
// A single bad field fails the whole class: synthesizing a `toJson` that
// silently omits one is worse than synthesizing none, because the omission is
// invisible in the output.
fn collectJsonFields(jx: JsonCtx, d: int): ([]JsonField, bool) {
  let out = []JsonField(0)
  let ok = true
  let idx = 0
  for m of kidsOf(jx.tree, kidsOf(jx.tree, d)[2]) {
    let f = memberField(jx.tree, m)
    if (f == 0) {
      continue
    }
    let (jf, fok) = jsonFieldOf(jx, f, idx)
    if (!fok) {
      ok = false
      continue
    }
    out = append(out, jf)
    idx = idx + 1
  }
  return (out, ok)
}

// One field, classified and validated. `index` is its position among the
// class's ACCEPTED fields and is what the builder's per-field local names are
// numbered by, so two array fields never collide on an accumulator.
fn jsonFieldOf(jx: JsonCtx, field: int, index: int): (JsonField, bool) {
  let k = kidsOf(jx.tree, field)
  let bad = JsonField{
    nameNode: 0, typeNode: 0, keyLit: 0, keyWord: "",
    kind: jkBad, elemKind: jkBad, elem: 0, index: index,
  }
  let (keyLit, keyWord, keyOk) = jsonKeyOf(jx, field)
  if (!keyOk) {
    return (bad, false)
  }
  let (kind, elem) = classifyJsonType(jx, k[1])
  let elemKind = jkBad
  if (isJsonContainer(kind)) {
    let (ek, _) = classifyJsonType(jx, elem)
    elemKind = ek
  }
  let shape = JsonShape{ typeNode: k[1], kind: kind, elem: elem, elemKind: elemKind }
  if (!vJsonFieldShape(jx, field, shape)) {
    return (bad, false)
  }
  return (
    JsonField{
      nameNode: k[0], typeNode: k[1], keyLit: keyLit, keyWord: keyWord,
      kind: kind, elemKind: elemKind, elem: elem, index: index,
    },
    true,
  )
}

// The three shapes that hold another type. Named rather than spelled out at
// each of its two call sites, so the two can never drift apart.
fn isJsonContainer(kind: int): bool {
  return kind == jkSlice || kind == jkMap || kind == jkOption
}

// One field's classified type, bundled so `vJsonFieldShape` keeps LINT.md's
// max-params=5.
class JsonShape {
  typeNode: int,
  kind: int,
  elem: int,
  elemKind: int,
}

// Whether a classified field type is one `toJson` can serialize, reporting the
// reason when it is not. EXACTLY ONE diagnostic per bad field: a container whose
// element is an unmarked class is `vJsonNestedMark`'s to report, and the earlier
// shape of this code added a second "cannot be serialized" on top of it, naming
// the same mistake twice.
fn vJsonFieldShape(jx: JsonCtx, field: int, sh: JsonShape): bool {
  if (sh.kind == jkBad) {
    reportJsonFieldType(jx, field, sh.typeNode)
    return false
  }
  if (!isJsonContainer(sh.kind)) {
    return vJsonNestedMark(jx, sh.typeNode, sh.kind, field)
  }
  if (!simpleJsonKind(sh.elemKind)) {
    reportJsonFieldType(jx, field, sh.typeNode)
    return false
  }
  return vJsonNestedMark(jx, sh.elem, sh.elemKind, field)
}

// True iff a `jkNested` type node is one this may recurse into. A class
// declared in THIS module without `@json` is rejected by name — recursing into
// it would defeat the opt-in and ship a field the moment someone adds one. A
// name declared here as an enum, interface or alias is rejected too: none of
// them has a `toJson`.
//
// A name reached through a NAMED import (`import { Addr } from "./model"`) is
// judged the same way, in the module it came from — the loader has already
// parsed every module by the time this runs, and `SrcModule.imports` maps the
// import path to its id, so no resolution is needed to find the declaration.
//
// What is left unjudged is a name this cannot follow: a namespace-qualified
// `ns.Addr`, a re-export, or a generic instantiation. Those still emit the
// nested call and, if it has no `toJson`, get the ordinary E0057 — whose span
// is the synthesized member name and therefore renders past the end of the
// file. That is the one rough edge in this feature's diagnostics and it is a
// wrong LOCATION on a correct refusal, never a silent acceptance.
fn vJsonNestedMark(jx: JsonCtx, typeNode: int, kind: int, field: int): bool {
  if (kind != jkNested || getNode(jx.tree, typeNode).tag != Tag.Ident) {
    return true
  }
  let (mark, declared) = jsonNestedMark(jx, jsonNodeText(jx, typeNode))
  if (!declared || mark == jmJsonClass) {
    return true
  }
  let fname = identText(jx.tree, jx.source, kidsOf(jx.tree, field)[0])
  let tname = jsonNodeText(jx, typeNode)
  let why = "class '${tname}' does not carry '@json'"
  if (mark == jmOtherDecl) {
    why = "'${tname}' is not a class"
  }
  report(
    jx.diags, ecJsonFieldType, getNode(jx.tree, typeNode).span,
    "field '${fname}' cannot be serialized by '@json': ${why}",
    "mark '${tname}' with '@json' too, or drop '${fname}' — '@json' never recurses into a type that did not opt in",
  )
  return false
}

fn reportJsonFieldType(jx: JsonCtx, field: int, typeNode: int) {
  let fname = identText(jx.tree, jx.source, kidsOf(jx.tree, field)[0])
  let tname = "?"
  if (typeNode != 0) {
    tname = jsonNodeText(jx, typeNode)
  }
  report(
    jx.diags, ecJsonFieldType, getNode(jx.tree, field).span,
    "field '${fname}' of type '${tname}' cannot be serialized by '@json'",
    "'@json' serializes a scalar, 'string', 'bool', '[]T', 'map<string, T>', 'Option<T>' and a nested '@json' class, where T is itself one of those but not another container",
  )
}

// ---- judging a nested type across a module boundary ------------------------

// What a nested field type is, looked up first among this module's own
// declarations and then through its NAMED imports. `false` means "not found",
// which is the only answer that leaves the field to ordinary resolution.
fn jsonNestedMark(jx: JsonCtx, name: string): (int, bool) {
  let (mark, declared) = jx.marks[name]
  if (declared) {
    return (mark, true)
  }
  return importedClassMark(jx, name)
}

// The mark of a class this module imports under the local name `name`. Every
// module is already parsed by the time this runs (the loader is depth-first and
// finishes before `resolveProject`), and `SrcModule.imports` maps an import path
// to the module id it resolved to — so this reads a real declaration in a real
// tree, not a guess. Only the `{ a, b as c }` form is followed: a namespace
// import binds `ns`, not the type name, and reaches the type as a `QualType`,
// which `classifyJsonType` does not route here.
fn importedClassMark(jx: JsonCtx, name: string): (int, bool) {
  for d of kidsOf(jx.tree, jx.tree.root) {
    if (d == 0 || getNode(jx.tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let k = kidsOf(jx.tree, d)
    if (getNode(jx.tree, k[0]).tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(jx.tree, k[0]) {
      if (importItemLocalName(jx.tree, jx.source, item) != name) {
        continue
      }
      let path = stringLitText(jx.source, getNode(jx.tree, k[1]).span)
      let (mid, ok) = jx.mod.imports[path]
      if (!ok || mid < 0 || mid >= len(jx.proj.mods)) {
        return (0, false)
      }
      return targetClassMark(
        jx.proj.mods[mid],
        identText(jx.tree, jx.source, kidsOf(jx.tree, item)[0]),
      )
    }
  }
  return (0, false)
}

// The mark of the class `name` in an already-parsed module. A name that is not
// a class there is left to ordinary resolution — misreporting it as "not a
// class" would guess at a declaration this walk cannot see (a re-export).
fn targetClassMark(tm: SrcModule, name: string): (int, bool) {
  for tc of topClassDecls(tm.tree) {
    if (identText(tm.tree, tm.source, kidsOf(tm.tree, tc.decl)[0]) != name) {
      continue
    }
    if (classHasJson(tm.tree, tm.source, tc.decl)) {
      return (jmJsonClass, true)
    }
    return (jmPlainClass, true)
  }
  return (0, false)
}
