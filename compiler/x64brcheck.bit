// Self-host Stage 3: the shapes `br` lowers to on x86-64 (#4372). A sibling of
// compiler/x64compilecheck.bit, which is near the 800-line ceiling; same
// module, so nothing here is imported.
//
// The property under test is that an edge carrying no code of its own is
// reached by NAMING its block in the conditional jump, rather than by a
// conditional jump to an unconditional one — and, symmetrically, that an edge
// which does carry code (a back-edge poll, or a parameter move) still gets it,
// on its own path and in the same order as before. A wrong choice here is not
// a slower program: it is a poll that never fires, or an edge whose moves run
// on both paths, and neither fails a build.

// Four instructions, three blocks. Block 0 holds the `br` plus one filler, so
// "is this the block's last instruction" is a question with two answers;
// blocks 1 and 2 take no parameters, so an edge to either carries no code at
// all unless it is a back edge.
fn xBrTestCtx(ctx: TypeContext, i64t: int): XCtx {
  let blocks = [
    IrBlock{ instsStart = 0, paramCount = 0, instsLen = 2 },
    IrBlock{ instsStart = 2, paramCount = 0, instsLen = 1 },
    IrBlock{ instsStart = 3, paramCount = 0, instsLen = 1 },
  ]
  let cx = xFnCtx([i64t, i64t, i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0, 0]
  return cx
}

// The same three blocks, except block 2 takes one parameter — the only way an
// edge with no back edge on it can still need code.
fn xBrParamCtx(ctx: TypeContext, i64t: int): XCtx {
  let blocks = [
    IrBlock{ instsStart = 0, paramCount = 0, instsLen = 2 },
    IrBlock{ instsStart = 2, paramCount = 0, instsLen = 1 },
    IrBlock{ instsStart = 3, paramCount = 1, instsLen = 2 },
  ]
  let cx = xFnCtx([i64t, i64t, i64t, i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0, 0]
  return cx
}

// Both edges take a parameter, so neither can be named — and THEN is the next
// block, which is the one case in which eliding THEN's jump would compile.
fn xBrBothParamCtx(ctx: TypeContext, i64t: int): XCtx {
  let blocks = [
    IrBlock{ instsStart = 0, paramCount = 0, instsLen = 2 },
    IrBlock{ instsStart = 2, paramCount = 1, instsLen = 2 },
    IrBlock{ instsStart = 4, paramCount = 1, instsLen = 2 },
  ]
  let cx = xFnCtx([i64t, i64t, i64t, i64t, i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0, 0]
  return cx
}

fn xMkBr(cond: int, thenBlk: int, elseBlk: int, thenArgs: []int, elseArgs: []int): IrInstr {
  let ins = mkInstr(Op.Br, 0)
  ins.lhs = cond
  ins.ival = thenBlk
  ins.ival2 = elseBlk
  ins.thenArgs = thenArgs
  ins.elseArgs = elseArgs
  return ins
}

// `test %rbx, %rbx` — vreg 0 lives in the first int register.
fn xBrTestHex(): string { return "4885db" }

fn checkX64BrDirect() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let none = []int(0)

  // THEN carries nothing and ELSE is the next block: one conditional jump
  // naming THEN, ELSE fallen into, and the whole `br` is two instructions.
  // `test` sets ZF iff the condition is zero, so reaching THEN is `jne`.
  let ca = xBrTestCtx(ctx, i64t)
  ca.curBlock = 0
  xEmitBr(ca, 1, xMkBr(0, 2, 1, none, none))
  assert(xHex(ca.buf) == xBrTestHex() + "0f85" + "00000000")
  assert(len(ca.fixups) == 1 && ca.fixups[0].target == 2)
  assert(ca.nextSafepointIdx == 0)

  // THEN is the next block: the mirror, `je` naming ELSE, THEN fallen into.
  let cb = xBrTestCtx(ctx, i64t)
  cb.curBlock = 0
  xEmitBr(cb, 1, xMkBr(0, 1, 2, none, none))
  assert(xHex(cb.buf) == xBrTestHex() + "0f84" + "00000000")
  assert(len(cb.fixups) == 1 && cb.fixups[0].target == 2)

  // An edge whose parameter moves are ALL identity carries no code either, so
  // it still takes the direct shape. Deciding this from len(args) instead of
  // from the built moves is what left 9 of arm64's 20 `matrix` sites standing.
  let ci = xBrParamCtx(ctx, i64t)
  ci.curBlock = 0
  xEmitBr(ci, 1, xMkBr(0, 2, 1, [3], none)) // block 2's param IS vreg 3
  assert(xHex(ci.buf) == xBrTestHex() + "0f85" + "00000000")
  assert(len(ci.fixups) == 1 && ci.fixups[0].target == 2)
}

fn checkX64BrInline() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let none = []int(0)

  // A real parameter move on the THEN edge: THEN cannot be reached by naming
  // it, so ELSE is named and the THEN edge becomes the tail.
  let cp = xBrParamCtx(ctx, i64t)
  cp.curBlock = 0
  xEmitBr(cp, 1, xMkBr(0, 2, 1, [1], none)) // vreg 1 is spilled, the param is not
  let hp = xHex(cp.buf)
  assert(len(hp) > 18 && hp[0:18] == xBrTestHex() + "0f84" + "00000000")
  assert(len(cp.fixups) == 2)
  assert(cp.fixups[0].target == 1) // the named ELSE edge
  assert(cp.fixups[1].target == 2) // the tail's own jump to THEN
  assert(xHexHas(cp.buf, "e9"))    // THEN is not the next block, so it is jumped to

  // A back edge needs a poll, which is code on the edge, so the same applies —
  // and the poll must land AFTER the conditional jump, on the THEN path alone.
  let cq = xBrTestCtx(ctx, i64t)
  cq.curBlock = 1
  xEmitBr(cq, 2, xMkBr(0, 1, 2, none, none)) // THEN is a self-loop
  let hq = xHex(cq.buf)
  assert(len(hq) > 18 && hq[0:18] == xBrTestHex() + "0f84" + "00000000")
  assert(cq.nextSafepointIdx == 1)
  assert(len(cq.relocs) == 1 && cq.relocs[0].symbol == "bit_rt_safepoint")

  // THEN carries a parameter move AND is the next block. Its jump must still be
  // emitted: the local skip is patched to whatever follows the THEN edge, so
  // dropping it would send the ELSE path into the THEN edge's own tail rather
  // than to ELSE — and, on the arm64 side, patch the skip to its own address.
  let cj = xBrBothParamCtx(ctx, i64t)
  cj.curBlock = 0
  xEmitBr(cj, 1, xMkBr(0, 1, 2, [1], [1]))
  assert(xHexCount(cj.buf, "e9") == 2) // THEN's jump and the tail's, both present
  assert(len(cj.fixups) == 2)
  assert(cj.fixups[0].target == 1)
  assert(cj.fixups[1].target == 2)

  // BOTH edges back edges: neither can be named, so the shape is the original
  // one — the THEN edge inline behind a local skip, then the ELSE edge. The
  // two polls stay in THEN-then-ELSE order, which is the order buildIntervals
  // recorded them in and what recordSafepoint's assert checks.
  let cr = xBrTestCtx(ctx, i64t)
  cr.curBlock = 1
  xEmitBr(cr, 2, xMkBr(0, 0, 1, none, none))
  // #6463: neither edge moves anything, so each poll's own `je` names its
  // block as well, ahead of the jmp the call falls through to.
  assert(cr.nextSafepointIdx == 2)
  assert(len(cr.fixups) == 4)
  assert(cr.fixups[0].target == 0 && cr.fixups[1].target == 0) // THEN's first
  assert(cr.fixups[2].target == 1 && cr.fixups[3].target == 1) // then ELSE's
}

// #5848: dead-slot clears never change which way a `br` goes. THEN carries a
// clear and ELSE is the next block, a loop header's shape with THEN its exit:
// still one `jne` and ELSE fallen into, exactly as with no clear. The `jne`
// names an out-of-line stub, emitted after the last block, not THEN itself.
fn checkX64BrClearStub() {
  let ctx = newTypeContext()
  let cs = xBrTestCtx(ctx, primType(ctx, 3))
  cs.curBlock = 0
  cs.alloc.clears = [SlotClear{ src = 0, dst = 2, slot = 1 }]
  xEmitBr(cs, 1, xMkBr(0, 2, 1, []int(0), []int(0)))
  let head = xBrTestHex() + "0f85" + "00000000"
  assert(xHex(cs.buf) == head, "a clear on the exit edge flips no branch")
  assert(len(cs.fixups) == 0 && len(cs.clearStubs) == 1)

  // The stub lands right behind the `jne`, so its rel32 stays 0; it zeroes
  // the slot, then jumps to THEN.
  xEmitClearStubs(cs)
  let h = xHex(cs.buf)
  assert(h[0:len(head)] == head && h[len(head):len(head) + 4] == "48c7")
  assert(h[len(h) - 10:len(h)] == "e900000000")
  assert(len(cs.fixups) == 1 && cs.fixups[0].target == 2)
}

fn checkX64FallThrough() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)

  // Block 0's LAST instruction jumping to block 1 falls through: nothing is
  // emitted and no fixup is registered.
  let cl = xBrTestCtx(ctx, i64t)
  cl.curBlock = 0
  xEmitJump(cl, 1, 1, []int(0))
  assert(len(cl.buf.code) == 0 && len(cl.fixups) == 0)

  // The same jump from a NON-terminator instruction must still be emitted: a
  // jump in the middle of a block is jumping over the rest of it, not falling
  // out of it. This is the clause a fall-through that only compares block
  // indices would drop.
  let cm = xBrTestCtx(ctx, i64t)
  cm.curBlock = 0
  xEmitJump(cm, 0, 1, []int(0))
  assert(xHex(cm.buf) == "e9" + "00000000")
  assert(len(cm.fixups) == 1 && cm.fixups[0].target == 1)

  // And a jump to any block that is not the next one is always emitted.
  let cf = xBrTestCtx(ctx, i64t)
  cf.curBlock = 0
  xEmitJump(cf, 1, 2, []int(0))
  assert(xHex(cf.buf) == "e9" + "00000000")
  assert(len(cf.fixups) == 1 && cf.fixups[0].target == 2)
}

// ===========================================================================
// #4393: a compare whose only consumer is the `br` after it
// ===========================================================================
//
// The property under test is that the compare emits its `cmp` AND NOTHING
// ELSE, and that the branch reads the flags that `cmp` set with the compare's
// own condition code — not with `jne` on a boolean nobody materialized. A
// wrong condition code here is not a slower program: it is a branch that goes
// the other way, which no build fails on.

// One block holding two operands, a compare at slot 3 and the `br` at slot 4,
// plus a terminator for each of blocks 1 and 2. The compare's operands are
// vregs 0 and 2, which xFnCtx puts in the two allocatable registers, so no
// operand fetch is emitted and the buffer holds exactly what the two selectors
// wrote. `blk1Params` gives block 1 a parameter, which is how a `br` can pass
// its own condition along an edge and so become its SECOND consumer.
//
// Both operand slots are overwritten with a real `block_param`, because
// `xFnCtx` fills every slot with a `const_int` whose `ival` defaults to 0 and
// #5657 folds a constant compare operand into the flag-setting instruction.
// Left as stand-ins they made the compare emit `testq %rbx, %rbx`, which pins
// no operand order at all -- and operand order is exactly what
// `xFusedCmpHex` below exists to pin, since swapping it turns every `<` into
// a `>` with nothing to fail.
fn xFuseCtx(ctx: TypeContext, cmpOp: Op, br: IrInstr, blk1Params: int): XCtx {
  let i64t = primType(ctx, 3)
  let blocks = [
    IrBlock{ instsStart = 0, paramCount = 0, instsLen = 5 },
    IrBlock{ instsStart = 5, paramCount = blk1Params, instsLen = 1 + blk1Params },
    IrBlock{ instsStart = 6 + blk1Params, paramCount = 0, instsLen = 1 },
  ]
  let cx = xFnCtx([i64t, i64t, i64t, i64t, i64t, i64t, i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0, 0]
  cx.f.instrs[0] = mkInstr(Op.BlockParam, i64t)
  cx.f.instrs[2] = mkInstr(Op.BlockParam, i64t)
  let cmp = mkInstr(cmpOp, i64t)
  cmp.lhs = 0
  cmp.rhs = 2
  cx.f.instrs[3] = cmp
  cx.f.instrs[4] = br
  cx.curBlock = 0
  return cx
}

// `cmpq %r13, %rbx` — the fused compare's whole emission. Operand ORDER is
// pinned here too: swapping it turns every `<` into `>`.
fn xFusedCmpHex(): string { return "4c39eb" }

// `testq %r13, %r13` — the unfused shape's boolean test, on vreg 3's register.
fn xBrTest13Hex(): string { return "4d85ed" }

fn checkX64CcInvert() {
  // Every x86 condition code pairs with its complement in the LOW BIT. This is
  // the flag-level complement — what a `br`'s ELSE edge branches on.
  assert(xCcInvert(ccE()) == ccNe() && xCcInvert(ccNe()) == ccE())
  assert(xCcInvert(ccB()) == ccAe() && xCcInvert(ccAe()) == ccB())
  assert(xCcInvert(ccBe()) == ccA() && xCcInvert(ccA()) == ccBe())
  assert(xCcInvert(ccL()) == ccGe() && xCcInvert(ccGe()) == ccL())
  assert(xCcInvert(ccLe()) == ccG() && xCcInvert(ccG()) == ccLe())
  assert(xCcInvert(ccP()) == ccNp() && xCcInvert(ccNp()) == ccP())
  assert(xCcInvert(ccO()) == ccNo() && xCcInvert(ccNo()) == ccO())
  // On a compare it is the NEGATED RELATION, and signed stays signed: reading
  // a signed compare's complement with an unsigned code silently reorders
  // negative values, which is xCcForIcmp's own warning.
  assert(xCcInvert(xCcForIcmp(Op.ICmpSlt)) == xCcForIcmp(Op.ICmpSge))
  assert(xCcInvert(xCcForIcmp(Op.ICmpSle)) == xCcForIcmp(Op.ICmpSgt))
  assert(xCcInvert(xCcForIcmp(Op.ICmpUlt)) == xCcForIcmp(Op.ICmpUge))
  assert(xCcInvert(xCcForIcmp(Op.ICmpUle)) == xCcForIcmp(Op.ICmpUgt))
  assert(xCcInvert(xCcForIcmp(Op.ICmpEq)) == xCcForIcmp(Op.ICmpNe))
}

fn checkX64BrFused() {
  let ctx = newTypeContext()
  let none = []int(0)

  // THEN carries nothing and ELSE is the next block. The compare emits the
  // `cmp` alone — no setcc, no movzx, no spill store — and the branch is one
  // conditional jump on the compare's own condition. `0f 8c` is `jl`; a
  // polarity error reads `0f 8d`.
  let ca = xFuseCtx(ctx, Op.ICmpSlt, xMkBr(3, 2, 1, none, none), 0)
  xEmitIcmp(ca, xCcForIcmp(Op.ICmpSlt), 3, 0, 2)
  assert(xHex(ca.buf) == xFusedCmpHex())
  xEmitBr(ca, 4, ca.f.instrs[4])
  assert(xHex(ca.buf) == xFusedCmpHex() + "0f8c" + "00000000")
  assert(len(ca.fixups) == 1 && ca.fixups[0].target == 2)

  // The mirror: THEN is the next block, so ELSE is named and the jump carries
  // the COMPLEMENT — `0f 8d` is `jge`.
  let cb = xFuseCtx(ctx, Op.ICmpSlt, xMkBr(3, 1, 2, none, none), 0)
  xEmitBr(cb, 4, cb.f.instrs[4])
  assert(xHex(cb.buf) == "0f8d" + "00000000")
  assert(len(cb.fixups) == 1 && cb.fixups[0].target == 2)

  // Unsigned stays unsigned through the complement: `jae` (0f 83), never
  // `jge`. Using the signed code here compares 0xFFFFFFFFFFFFFFFF as -1.
  let cu = xFuseCtx(ctx, Op.ICmpUlt, xMkBr(3, 1, 2, none, none), 0)
  xEmitBr(cu, 4, cu.f.instrs[4])
  assert(xHex(cu.buf) == "0f83" + "00000000")
}

fn checkX64BrUnfused() {
  let ctx = newTypeContext()
  let none = []int(0)

  // A FLOAT compare is marked by computeFuseCmpBranch too and must NOT fuse:
  // ucomis decides FEq/FNe across two flags (ZF for equal-OR-unordered, PF for
  // unordered), so xEmitFcmp materializes a boolean for all six forms and the
  // branch has to test it. Without the isIcmp clause this branch would read
  // flags no `test` ever set.
  let cf = xFuseCtx(ctx, Op.FCmpLt, xMkBr(3, 2, 1, none, none), 0)
  xEmitBr(cf, 4, cf.f.instrs[4])
  assert(xHex(cf.buf) == xBrTest13Hex() + "0f85" + "00000000")

  // A compare with a SECOND consumer — here its own value passed along the
  // ELSE edge, which instrOperands counts — is a real value that still needs
  // its boolean, so the branch tests it. This is the sole-consumer gate, not
  // adjacency: the compare is still at idx - 1.
  let cm = xFuseCtx(ctx, Op.ICmpSlt, xMkBr(3, 2, 1, none, [3]), 1)
  xEmitBr(cm, 4, cm.f.instrs[4])
  assert(xHex(cm.buf) == xBrTest13Hex() + "0f85" + "00000000")
  assert(len(cm.fixups) == 1 && cm.fixups[0].target == 2)

  // A condition that is NOT the instruction before the `br` reads whatever the
  // flags happen to hold by then, so it is never fused however it was marked.
  // The map is set by hand here because `computeFuseCmpBranch` cannot produce
  // this state today: a compare it marks has exactly one use, and that use is
  // the `br` at its own idx + 1. The clause is a defence against a future
  // marker with a weaker rule, and this arm is the only thing that can see it.
  let cn = xFuseCtx(ctx, Op.ICmpSlt, xMkBr(1, 2, 1, none, none), 0)
  let decoy = mkInstr(Op.ICmpEq, primType(ctx, 3))
  decoy.lhs = 0
  decoy.rhs = 2
  cn.f.instrs[1] = decoy
  cn.fuseCmp = []bool(len(cn.f.instrs))
  cn.fuseCmp[1] = true
  cn.redundantBr = []bool(len(cn.f.instrs))
  cn.fuseCmpReady = true
  xEmitBr(cn, 4, cn.f.instrs[4])
  // vreg 1 is xFnCtx's spilled slot, so the unfused path reloads it into r11
  // and tests that. Fusing instead would branch on the decoy's `je` (0f 84).
  assert(xHexHas(cn.buf, "4d85db"))
  assert(xHexHas(cn.buf, "0f85"))
  assert(!xHexHas(cn.buf, "0f84"))
}

// Both guards share a condition and a panic block; the successful edge moves
// an argument into bb3. The unused body constant can become a distinct check.
fn xReuseBrCtx(ctx: TypeContext): XCtx {
  let it = primType(ctx, 3)
  let bt = primType(ctx, 10)
  let vt = ctx.voidId
  let blocks = [
    IrBlock{ instsStart = 0, paramCount = 2, instsLen = 4 },
    IrBlock{ instsStart = 4, paramCount = 0, instsLen = 2 },
    IrBlock{ instsStart = 6, paramCount = 0, instsLen = 2 },
    IrBlock{ instsStart = 8, paramCount = 1, instsLen = 2 },
  ]
  let cx = xFnCtx([it, it, bt, vt, it, vt, vt, vt, it, vt], blocks)
  cx.ctx = ctx
  cx.f.instrs[0] = mkInstr(Op.BlockParam, it)
  cx.f.instrs[1] = mkInstr(Op.BlockParam, it)
  let cmp = mkInstr(Op.ICmpUlt, bt)
  cmp.lhs = 0
  cmp.rhs = 1
  cx.f.instrs[2] = cmp
  cx.f.instrs[3] = xMkBr(2, 1, 2, []int(0), []int(0))
  cx.f.instrs[5] = xMkBr(2, 3, 2, [0], []int(0))
  let call = mkInstr(Op.Call, vt)
  call.name = "boundsPanic"
  cx.f.instrs[6] = call
  cx.f.instrs[7] = mkInstr(Op.Unreachable, vt)
  cx.f.instrs[8] = mkInstr(Op.BlockParam, it)
  let ret = mkInstr(Op.Ret, vt)
  ret.args = [8]
  cx.f.instrs[9] = ret
  cx.f = irFuncOf("boundsReuse", [it, it], it, blocks, cx.f.instrs)
  cx.module.ctx = ctx
  cx.module.funcs = [cx.f]
  cx.blockOffsets = [0, 0, 0, 0]
  cx.safepointCodeOffsets = [0, 0]
  return cx
}

fn checkX64BrRedundant() {
  let cx = xReuseBrCtx(newTypeContext())
  xEmitIcmp(cx, ccB(), 2, 0, 1)
  assert(cx.fuseCmp[2], "the first bounds comparison must fuse")
  assert(!cx.redundantBr[3] && cx.redundantBr[5])
  let cmpBytes = len(cx.buf.code)
  xEmitBr(cx, 3, cx.f.instrs[3])
  assert(len(cx.buf.code) == cmpBytes + 6, "the first check must still branch")
  assert(len(cx.fixups) == 1 && cx.fixups[0].target == 2)

  let folded = xReuseBrCtx(newTypeContext())
  folded.curBlock = 1
  xEmitBr(folded, 5, folded.f.instrs[5])
  let jump = xReuseBrCtx(newTypeContext())
  jump.curBlock = 1
  xEmitJump(jump, 5, 3, [0])
  assert(xHex(folded.buf) == xHex(jump.buf), "a repeated guard is only its true edge")
  assert(len(folded.fixups) == 1 && folded.fixups[0].target == 3)
  assert(folded.nextSafepointIdx == 0)
}

fn checkX64BrRedundantRefusals() {
  let bypass = xReuseBrCtx(newTypeContext())
  bypass.f.instrs[3].ival2 = 1
  let _ = xFuseCmp(bypass)
  assert(!bypass.redundantBr[5], "a second predecessor bypasses the successful check")

  let failed = xReuseBrCtx(newTypeContext())
  failed.f.instrs[3].ival = 2
  failed.f.instrs[3].ival2 = 1
  let _ = xFuseCmp(failed)
  assert(!failed.redundantBr[5], "a false edge proves no successful bound")

  let changed = xReuseBrCtx(newTypeContext())
  let cmp = mkInstr(Op.ICmpUlt, primType(changed.ctx, 10))
  cmp.lhs = 1
  cmp.rhs = 1
  changed.f.instrs[4] = cmp
  changed.f.instrs[5].lhs = 4
  let _ = xFuseCmp(changed)
  assert(!changed.redundantBr[5], "a changed index retains its own check")
  let length = xReuseBrCtx(newTypeContext())
  let cmpLen = mkInstr(Op.ICmpUlt, primType(length.ctx, 10))
  cmpLen.lhs = 0
  cmpLen.rhs = 0
  length.f.instrs[4] = cmpLen
  length.f.instrs[5].lhs = 4
  let _ = xFuseCmp(length)
  assert(!length.redundantBr[5], "a changed length retains its own check")
}

fn checkX64BrRedundantEdges() {
  let folded = xReuseBrCtx(newTypeContext())
  folded.curBlock = 1
  folded.alloc.clears = [SlotClear{ src = 1, dst = 3, slot = 1 }]
  xEmitBr(folded, 5, folded.f.instrs[5])
  let jump = xReuseBrCtx(newTypeContext())
  jump.curBlock = 1
  jump.alloc.clears = [SlotClear{ src = 1, dst = 3, slot = 1 }]
  xEmitJump(jump, 5, 3, [0])
  assert(xHex(folded.buf) == xHex(jump.buf), "true-edge moves and clears must survive")

  let carried = xReuseBrCtx(newTypeContext())
  carried.f.instrs[5].thenArgs = [2]
  carried.f.instrs[8].ty = primType(carried.ctx, 10)
  carried.f.result = carried.f.instrs[8].ty
  let _ = xFuseCmp(carried)
  assert(carried.redundantBr[5] && !carried.fuseCmp[2], "a carried condition stays materialized")
  carried.curBlock = 1
  xEmitBr(carried, 5, carried.f.instrs[5])
  let edge = xReuseBrCtx(newTypeContext())
  edge.f.instrs[8].ty = primType(edge.ctx, 10)
  edge.curBlock = 1
  xEmitJump(edge, 5, 3, [2])
  assert(xHex(carried.buf) == xHex(edge.buf))
}

fn checkX64BrRedundantPolls() {
  let folded = xReuseBrCtx(newTypeContext())
  folded.f.instrs[5].ival = 0
  folded.f.instrs[5].thenArgs = [0, 1]
  folded.curBlock = 1
  xEmitBr(folded, 5, folded.f.instrs[5])
  assert(folded.redundantBr[5])
  let jump = xReuseBrCtx(newTypeContext())
  jump.curBlock = 1
  xEmitJump(jump, 5, 0, [0, 1])
  assert(xHex(folded.buf) == xHex(jump.buf), "a folded true back edge must still poll")
  assert(folded.nextSafepointIdx == 1 && jump.nextSafepointIdx == 1)
  assert(len(folded.relocs) == 1 && folded.relocs[0].symbol == "bit_rt_safepoint")

  let otherwise = xReuseBrCtx(newTypeContext())
  otherwise.f.instrs[5].ival2 = 0
  otherwise.f.instrs[5].elseArgs = [0, 1]
  assert(computeRedundantBoundsBranch(otherwise.f)[5])
  otherwise.curBlock = 1
  xEmitBr(otherwise, 5, otherwise.f.instrs[5])
  assert(!otherwise.redundantBr[5], "an ELSE poll must retain its recorded position")
  assert(otherwise.nextSafepointIdx == 1)
}

fn checkX64BrRedundantStackMaps() {
  let cx = xReuseBrCtx(newTypeContext())
  let fc = xCompileFunction(cx.module, cx.f, XCallConv.SysV, false)
  assert(fc.name != "" && len(fc.safepoints) == 1)
  let panicCalls = 0
  for r of fc.relocs {
    if (r.symbol == "boundsPanic") {
      panicCalls = panicCalls + 1
      assert(fc.safepoints[0].retOffset == r.offset + 4)
    }
  }
  assert(panicCalls == 1, "the shared panic block and its stack map must stay emitted")
  assert(!fc.safepoints[0].isPoll)

  let loop = xReuseBrCtx(newTypeContext())
  loop.f.instrs[5].ival = 0
  loop.f.instrs[5].thenArgs = [0, 1]
  loop.f.blocks[3].paramCount = 0
  loop.f.instrs[8] = mkInstr(Op.ConstInt, primType(loop.ctx, 3))
  let lf = xCompileFunction(loop.module, loop.f, XCallConv.SysV, false)
  assert(lf.name != "" && len(lf.safepoints) == 2)
  assert(lf.safepoints[0].isPoll && !lf.safepoints[1].isPoll)
}

// #8400: a private dead panic precedes a call and a poll with different roots.
fn xPrivateBoundsCtx(): XCtx {
  let cx = xReuseBrCtx(newTypeContext())
  let ctx = cx.ctx
  let it = primType(ctx, 3)
  let rt = mkSlice(ctx, it)
  let bt = primType(ctx, 10)
  let vt = ctx.voidId
  let cmp = mkInstr(Op.ICmpUlt, bt)
  cmp.lhs = 0
  cmp.rhs = 1
  let live = mkInstr(Op.Call, vt)
  live.name = "liveBoundsPanic"
  live.args = [2]
  let dead = mkInstr(Op.Call, vt)
  dead.name = "deadBoundsPanic"
  dead.args = [2]
  let alloc = mkInstr(Op.Call, rt)
  alloc.name = "allocatingRoot"
  alloc.args = [2]
  let jump = mkInstr(Op.Jump, vt)
  jump.ival = 5
  let later = mkInstr(Op.Call, vt)
  later.name = "afterRoot"
  later.args = [10]
  let ret = mkInstr(Op.Ret, vt)
  ret.args = [0]
  cx.f = irFuncOf(
    "privateBounds", [it, it, rt], it,
    [
      IrBlock{ instsStart = 0, paramCount = 3, instsLen = 5 },
      IrBlock{ instsStart = 5, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 7, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 8, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 10, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 12, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 13, paramCount = 0, instsLen = 2 },
    ],
    [
      mkInstr(Op.BlockParam, it), mkInstr(Op.BlockParam, it),
      mkInstr(Op.BlockParam, rt), cmp, xMkBr(3, 2, 1, []int(0), []int(0)),
      live, mkInstr(Op.Unreachable, vt), xMkBr(3, 4, 3, []int(0), []int(0)),
      dead, mkInstr(Op.Unreachable, vt), alloc, jump,
      xMkBr(3, 5, 6, []int(0), []int(0)), later, ret,
    ],
  )
  cx.module.funcs = [cx.f]
  return cx
}

fn xCheckBoundsMapRoots(cx: XCtx, sm: SafepointView, pos: int, roots: []int) {
  assert(len(sm.regs) + len(sm.slots) == len(roots), "exact live root count")
  for v of roots {
    let loc = locAt(cx.alloc, v, pos)
    if (loc.isSpill) {
      assert(posInList(sm.slots, xSpillOffset(cx.frame, loc.index)), "live root slot")
    } else {
      assert(posInList(sm.regs, xRegNum(cx.intRegs[loc.index])), "live root register")
    }
  }
}

fn xCheckBoundsMapReturn(fc: FuncCode, idx: int, symbol: string) {
  let calls = 0
  for r of fc.relocs {
    if (r.symbol == symbol) {
      calls = calls + 1
      assert(fc.safepoints[idx].retOffset == r.offset + 4, "map names its actual call return")
    }
  }
  assert(calls == 1, "the live call must remain")
}

fn xCheckDeadBoundsFixture(fixture: XCtx, forceSpill: bool) {
  let f = fixture.f
  let regs = xBuildFrameRegs(fixture.module, f, XCallConv.SysV, false)
  if (forceSpill) {
    regs.intRegs = []XReg64(0)
  }
  let setup = xBuildFrameSetup(f, false, regs)
  let cx = xNewFuncCtx(f, false, regs, setup)
  xPlanFrameZeroes(cx, setup)
  assert(xEmitFuncBody(cx, f))
  let fc = xBuildFuncCode(cx, f)
  assert(cx.deadBlock[3] && !cx.deadBlock[1], "only the private panic is dead")
  assert(cx.blockOffsets[2] == cx.blockOffsets[4], "the dead body and skip jump emit nothing")
  assert(len(fc.safepoints) == 4, "only the dead panic loses its map")
  for r of fc.relocs {
    assert(r.symbol != "deadBoundsPanic", "the dead panic emits no call")
  }
  xCheckBoundsMapReturn(fc, 0, "liveBoundsPanic")
  xCheckBoundsMapReturn(fc, 1, "allocatingRoot")
  xCheckBoundsMapReturn(fc, 2, "bit_rt_safepoint")
  xCheckBoundsMapReturn(fc, 3, "afterRoot")
  xCheckBoundsMapRoots(cx, fc.safepoints[0], 5, [2])
  xCheckBoundsMapRoots(cx, fc.safepoints[1], 10, [2, 10])
  xCheckBoundsMapRoots(cx, fc.safepoints[2], 12, [10])
  xCheckBoundsMapRoots(cx, fc.safepoints[3], 13, [10])
  assert(fc.safepoints[2].isPoll && !fc.safepoints[3].isPoll)
  assert(!forceSpill || len(fc.safepoints[2].slots) > 0, "forced spill checks slot roots")
  let live = 0
  for v of [0, 3, 10] {
    let loc = locAt(cx.alloc, v, 12)
    if (!loc.isSpill) {
      live = live | (1 << xRegNum(cx.intRegs[loc.index]))
    }
  }
  assert(fc.safepoints[2].liveRegs == live, "the poll retains every live register")
}

fn checkX64DeadBounds() {
  for forceSpill of [false, true] {
    xCheckDeadBoundsFixture(xPrivateBoundsCtx(), forceSpill)
  }
}

fn xBoundsEntryCtx(): XCtx {
  let cx = xReuseBrCtx(newTypeContext())
  let ctx = cx.ctx
  let it = primType(ctx, 3)
  let rt = mkSlice(ctx, it)
  let vt = ctx.voidId
  let call = mkInstr(Op.Call, rt)
  call.name = "entryRoot"
  call.args = [2]
  let cmp = mkInstr(Op.ICmpUlt, primType(ctx, 10))
  cmp.lhs = 0
  cmp.rhs = 1
  let panicCall = mkInstr(Op.Call, vt)
  panicCall.name = "boundsPanic"
  panicCall.args = [3]
  let later = mkInstr(Op.Call, vt)
  later.name = "laterRoot"
  later.args = [3]
  let ret = mkInstr(Op.Ret, vt)
  ret.args = [0]
  cx.f = irFuncOf(
    "boundsEntry", [it, it, rt], it,
    [
      IrBlock{ instsStart = 0, paramCount = 3, instsLen = 6 },
      IrBlock{ instsStart = 6, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 7, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 9, paramCount = 0, instsLen = 2 },
    ],
    [
      mkInstr(Op.BlockParam, it), mkInstr(Op.BlockParam, it),
      mkInstr(Op.BlockParam, rt), call, cmp,
      xMkBr(4, 1, 2, []int(0), []int(0)),
      xMkBr(4, 3, 0, []int(0), [0, 1, 2]),
      panicCall, mkInstr(Op.Unreachable, vt), later, ret,
    ],
  )
  cx.module.funcs = [cx.f]
  return cx
}

fn checkX64BoundsEntry() {
  for nosplit of [false, true] {
    let fixture = xBoundsEntryCtx()
    let f = fixture.f
    f.isNosplit = nosplit
    let redundant = computeRedundantBoundsBranch(f)
    assert(redundant[6], "the repeated entry bound must qualify")
    assert(!computeDeadBoundsBlocks(f, redundant)[0], "entry keeps its implicit caller")
    let regs = xBuildFrameRegs(fixture.module, f, XCallConv.SysV, false)
    assert(regs.redundantBr[6] == nosplit, "a live ELSE poll retains its edge")
    let setup = xBuildFrameSetup(f, false, regs)
    let cx = xNewFuncCtx(f, false, regs, setup)
    xPlanFrameZeroes(cx, setup)
    assert(xEmitFuncBody(cx, f))
    let fc = xBuildFuncCode(cx, f)
    assert(cx.blockOffsets[0] < cx.blockOffsets[1], "entry instructions stay emitted")
    let polls = 0
    if (!nosplit) {
      polls = 1
      assert(fc.safepoints[1].isPoll)
      xCheckBoundsMapReturn(fc, 1, "bit_rt_safepoint")
      xCheckBoundsMapRoots(cx, fc.safepoints[1], 6, [2, 3])
    }
    assert(len(fc.safepoints) == 3 + polls, "all live entry and later maps stay")
    xCheckBoundsMapReturn(fc, 0, "entryRoot")
    xCheckBoundsMapReturn(fc, 1 + polls, "boundsPanic")
    xCheckBoundsMapReturn(fc, 2 + polls, "laterRoot")
    xCheckBoundsMapRoots(cx, fc.safepoints[0], 3, [2, 3])
    xCheckBoundsMapRoots(cx, fc.safepoints[1 + polls], 7, [3])
    xCheckBoundsMapRoots(cx, fc.safepoints[2 + polls], 9, [3])
  }
}

fn xBoundsEntryProofCtx(forwarded: bool): XCtx {
  let cx = xReuseBrCtx(newTypeContext())
  let it = primType(cx.ctx, 3)
  let bt = primType(cx.ctx, 10)
  let vt = cx.ctx.voidId
  let first = xMkBr(0, 0, 2, [0], []int(0))
  let back = mkInstr(Op.Unreachable, vt)
  if (forwarded) {
    first.ival = 1
    first.thenArgs = []int(0)
    back = mkInstr(Op.Jump, vt)
    back.ival = 0
    back.args = [0]
  }
  let one = mkInstr(Op.ConstInt, it)
  one.ival = 1
  let two = mkInstr(Op.ConstInt, it)
  two.ival = 2
  let yes = mkInstr(Op.Ret, vt)
  yes.args = [4]
  let no = mkInstr(Op.Ret, vt)
  no.args = [6]
  cx.f = irFuncOf(
    "boundsEntryProof", [bt], it,
    [
      IrBlock{ instsStart = 0, paramCount = 1, instsLen = 2 },
      IrBlock{ instsStart = 2, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 3, paramCount = 0, instsLen = 1 },
      IrBlock{ instsStart = 4, paramCount = 0, instsLen = 2 },
      IrBlock{ instsStart = 6, paramCount = 0, instsLen = 2 },
    ],
    [
      mkInstr(Op.BlockParam, bt), first, back,
      xMkBr(0, 3, 4, []int(0), []int(0)), one, yes, two, no,
    ],
  )
  cx.f.isNosplit = true
  cx.module.funcs = [cx.f]
  return cx
}

fn checkX64BoundsEntryProof() {
  for forwarded of [false, true] {
    let fixture = xBoundsEntryProofCtx(forwarded)
    let f = fixture.f
    assert(len(verifyIrFuncs([f], fixture.ctx)) == 0, "entry proof fixture is valid IR")
    assert(computeBlockPredCounts(f)[0] == 1, "entry has one explicit backedge")
    assert(!computeRedundantBoundsBranch(f)[3], "entry caller bypasses the earlier true edge")
    let regs = xBuildFrameRegs(fixture.module, f, XCallConv.SysV, false)
    let setup = xBuildFrameSetup(f, false, regs)
    let cx = xNewFuncCtx(f, false, regs, setup)
    xPlanFrameZeroes(cx, setup)
    assert(xEmitFuncBody(cx, f))
    let falseEdge = false
    for fixup of cx.fixups {
      if (fixup.target == 4 &&
        fixup.patchOffset >= cx.blockOffsets[2] &&
        fixup.patchOffset < cx.blockOffsets[3]) {
        falseEdge = true
      }
    }
    assert(falseEdge, "entry false path keeps its conditional return")
  }
}
