fn leaAddCtx(l: XReg64, r: XReg64, dst: XReg64): XCtx {
  let cx = xTestCtx()
  cx.intRegs = [l, r, dst]
  cx.alloc.locations = [
    RegLoc{ isSpill = false, index = 0 },
    RegLoc{ isSpill = false, index = 1 },
    RegLoc{ isSpill = false, index = 2 },
  ]
  cx.f.instrs = [mkInstr(Op.BlockParam, 0), mkInstr(Op.BlockParam, 0), mkInstr(Op.BlockParam, 0)]
  return cx
}

fn leaAddEmit(cx: XCtx, width: int = 8, signed: bool = false): string {
  xEmitBinaryInt(cx, XArith.Add, 2, 0, 1, mkWidth(width, RegClass.Int, signed))
  return xHex(cx.buf)
}

test "x64 register ADD fresh destination uses one LEA" {
  let cx = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  assert(leaAddEmit(cx) == "488d0c18", "fresh destination must use one LEA")
  let same = leaAddCtx(XReg64.Rax, XReg64.Rax, XReg64.Rcx)
  assert(leaAddEmit(same) == "488d0c00", "same input must be read twice")
}

test "x64 register ADD LEA permits rhs alias and high SIB registers" {
  let rhs = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rbx)
  assert(leaAddEmit(rhs) == "488d1c18", "rhs alias must retain both inputs")
  let high = leaAddCtx(XReg64.R13, XReg64.R12, XReg64.R15)
  assert(leaAddEmit(high) == "4f8d7c2500", "r12 index and r13 zero displacement")
  let doubled = leaAddCtx(XReg64.R13, XReg64.R13, XReg64.R12)
  assert(leaAddEmit(doubled) == "4f8d642d00", "high same input must be read twice")
}

test "x64 register ADD preserves lhs accumulator and other operations" {
  let lhs = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rax)
  assert(leaAddEmit(lhs) == "4801d8", "lhs accumulator already needs one ADD")
  let sub = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  xEmitBinaryInt(sub, XArith.Sub, 2, 0, 1, mkWidth(8, RegClass.Int, false))
  assert(xHex(sub.buf) == "4889c14829d9", "SUB must keep its flag-setting path")
}

test "x64 register ADD preserves spilled inputs and output" {
  let l = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  l.alloc.locations[0] = RegLoc{ isSpill = true, index = 0 }
  assert(leaAddEmit(l) == "4c8b5df0498d0c1b", "spilled lhs must reload before LEA")
  let r = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  r.alloc.locations[1] = RegLoc{ isSpill = true, index = 0 }
  assert(leaAddEmit(r) == "4c8b55f04a8d0c10", "spilled rhs must reload before LEA")
  let dst = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  dst.alloc.locations[2] = RegLoc{ isSpill = true, index = 1 }
  assert(leaAddEmit(dst) == "4c8d1c184c895de8", "spilled output must store LEA result")
}

test "x64 register ADD preserves overflow and width contracts" {
  let unsigned = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  unsigned.debug = true
  assert(leaAddEmit(unsigned) == "488d0c18", "unsigned debug arithmetic wraps")
  let release = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  assert(leaAddEmit(release, signed = true) == "488d0c18", "signed release may use LEA")
  let debug = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  debug.debug = true
  let encoded = leaAddEmit(debug, signed = true)
  assert(startsWith(encoded, "4889c14801d9"), "signed debug must retain ADD overflow flags")
  let narrow = leaAddCtx(XReg64.Rax, XReg64.Rbx, XReg64.Rcx)
  assert(leaAddEmit(narrow, 4) == "4889c14801d98bc9", "narrow arithmetic must canonicalize")
}
