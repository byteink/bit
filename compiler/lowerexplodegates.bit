// compiler/lowerexplodegates.bit — #6058: a generic instance's arguments
// passed as words, and the one constructor that pairs a declaration's gates.
//
// `explodesParams` (lowerexplode.bit) refused every generic declaration on the
// ground that its call site held template types where the instance's body held
// substituted ones. That stopped being true: every direct call site reads
// `genericParamTypes` (lowerglobal.bit) through `resolveCallTarget`
// (lowerprim.bit), and the instance body reads `substTypeList` over its
// `genEnv` (`lowerFuncNamed`, lowerfunc.bit), so both sides classify the same
// SUBSTITUTED types. A template's own `Option<T>` never reaches either:
// `enumExplosionEligible` (lowerlayout.bit) refuses a `TypeParam` payload.
// So `isNone(a)` on an exploded `Option<string>` passes the two words instead
// of a heap box the inliner could not delete afterwards.
//
// #7146 lifted the same refusal on the RESULT side (`explodedRetWords`,
// lowerexplode.bit): it classifies `declResultIn`, the declared result under
// the instance's own bindings, so the instance's `ret` (`lowerFuncNamed`,
// `genEnv`) and every call site (`callRetWords`, `CallTarget.targs`) read one
// substituted type. A generic level of a `?` chain stopped boxing its result.

// The argument gates for a direct call to, or the body of, `decl` in `c`.
// Every site that pairs them calls this, so the callee's parameter list and
// each of its call sites read the same two answers by construction.
fn explodeGatesFor(c: Checker, decl: int, lo: Lowerer): ArgExplodeGates {
  return ArgExplodeGates{ tuples = explodesParams(c, decl, lo), strings = lo.explodeStrings }
}

// `decl`'s declared result (a `T!E` whole) with `env` substituted, or 0 for a
// void result. A generic's `T` resolves to its OWN type parameter id only
// inside its window (`pushGenericDecl`), which is the id `genericEnvOf` binds:
// the same two steps `lowerInstance` takes before `lowerFuncNamed` reads it.
fn declResultIn(c: Checker, decl: int, env: TypeEnv): int {
  let rn = kidsOf(c.tree, decl)[4]
  if (rn == 0) {
    return 0
  }
  if (!isGenericFuncDecl(c, decl)) {
    return typeFromNode(c, rn)
  }
  let saved = pushGenericDecl(c, decl)
  let raw = substType(c, typeFromNode(c, rn), env, 0)
  popGenericDecl(c, saved)
  return raw
}

// The result words of the call `t` describes: its callee's `explodedRetWords`
// under this call's type arguments (none for a non-generic callee).
fn callRetWords(fc: FnCtx, t: CallTarget): []int {
  return explodedRetWords(t.owner, t.decl, fc.lowerer, genericEnvOf(t.owner, t.decl, t.targs))
}
