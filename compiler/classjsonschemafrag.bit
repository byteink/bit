// compiler/classjsonschemafrag.bit — the one-hop cross-module `$defs`
// closure `jsSchemaDocumentEntries` (classjsonschemacall.bit) needs (#6182).
//
// Split out of classjsonschemacall.bit, which this feature pushed past
// LINT.md's 800-line ceiling. A sibling `.bit` file is the same module, so
// this is a pure move plus the doc comments this section already had.
//
// Discovers every class a document ROOT's own closure reaches through
// another module — DIAGNOSTIC-FREE throughout (`classifyJsonType` reports
// nothing, and this never calls `collectJsonClasses`/`jsonFieldOf`): it runs
// once per project, ahead of every module's own (single) `@json` synthesis
// pass, and validating a field a second time here would report any bad one
// twice. A field's own module already validated it when IT ran; this only
// ever reads the SHAPE a validated field already has.

// The classes THIS module must export a bare `$defs` fragment function for
// (#6182): the ones some document root's closure reaches here, cross-module.
fn moduleSchemaFragClasses(
  sd: JsonSchemaDemand,
  mid: int,
  classes: []JsonClass,
  jx: JsonCtx,
): []JsonClass {
  let out = []JsonClass(0)
  for jc of classes {
    let name = identText(jx.tree, jx.source, jc.className)
    for n of sd.fragNeeds {
      if (n.classMod == mid && n.className == name) {
        out = append(out, jc)
        break
      }
    }
  }
  return out
}

// `fragFuncName`, once per frag need this module either calls or builds:
// building it needs its own declaration name registered as a synth word
// too (`synthJsonSchemaFragFunc`'s own `synthIdent`), the same as calling it
// does.
fn jsonSchemaFragCallWords(sd: JsonSchemaDemand, mid: int): []string {
  let out = []string(0)
  for n of sd.fragNeeds {
    if (n.needMod == mid || n.classMod == mid) {
      out = append(out, fragFuncName(n.className))
    }
  }
  return out
}

// The `@json` class declaration named `name` in `tree`, or 0 — the
// diagnostic-free counterpart of `jsonClassByName` for a module this walk
// has not (and must not) run `collectJsonClasses` on.
fn jsonClassDeclByName(tree: Tree, source: string, name: string): int {
  for tc of topClassDecls(tree) {
    if (identText(tree, source, kidsOf(tree, tc.decl)[0]) == name &&
      classHasJson(tree, source, tc.decl)) {
      return tc.decl
    }
  }
  return 0
}

// `typeNode`'s own text, or "" when it is not a bare name — the shape a
// cross-module nested reference (a NAMED import's local spelling) always
// has, mirroring `jsonDecTypeName`'s own guard.
fn jsonIdentNameOrEmpty(jx: JsonCtx, typeNode: int): string {
  if (typeNode == 0 || getNode(jx.tree, typeNode).tag != Tag.Ident) {
    return ""
  }
  return jsonNodeText(jx, typeNode)
}

// Every nested `@json` field's own type NAME on class decl `d` — direct or
// through a container's element — read purely SYNTACTICALLY
// (`classifyJsonType` reports nothing), matching `jsonDecNestedName`'s own
// two cases without needing a validated `JsonField` to do it.
fn jsonSchemaNestedNamesOf(jx: JsonCtx, d: int): []string {
  let out = []string(0)
  for m of kidsOf(jx.tree, kidsOf(jx.tree, d)[2]) {
    let f = memberField(jx.tree, m)
    if (f == 0) {
      continue
    }
    let k = kidsOf(jx.tree, f)
    let (kind, elem) = classifyJsonFieldType(jx, k[1])
    if (kind == jkNested) {
      out = append(out, jsonIdentNameOrEmpty(jx, k[1]))
    }
    if (isJsonContainer(kind)) {
      let (ek, _) = classifyJsonFieldType(jx, elem)
      if (ek == jkNested) {
        out = append(out, jsonIdentNameOrEmpty(jx, elem))
      }
    }
  }
  return out
}

// The mutable state one root's own walk threads through
// `addSchemaFragNeedsForClass` — a class (a Bit reference type), so a hop
// appending to `queue` or `out` is visible back in
// `collectSchemaFragNeedsForRoot`'s own loop without either function
// returning a tuple the other has to re-thread, keeping BOTH under
// LINT.md's max-complexity=10.
class SchemaFragWalk {
  rootMod: int,
  rootName: string,
  queue: []string,
  out: []JsonSchemaFragNeed,
  seenFrag: map<string, bool>,
}

// Every cross-module hop class decl `d` (in `rootJx`'s own module) names,
// added to `w.out` (a NEW cross-module class, deduped by `w.seenFrag`) or
// `w.queue` (a same-module class, to keep walking) — split out of
// `collectSchemaFragNeedsForRoot` to keep both under LINT.md's
// max-complexity=10.
fn addSchemaFragNeedsForClass(rootJx: JsonCtx, w: SchemaFragWalk, d: int) {
  for nested of jsonSchemaNestedNamesOf(rootJx, d) {
    if (nested == "") {
      continue
    }
    let site = jsonClassSiteOf(rootJx, w.rootMod, nested)
    if (!site.found || site.mark != jmJsonClass) {
      continue
    }
    if (site.mod == w.rootMod) {
      w.queue = append(w.queue, nested)
      continue
    }
    let fk = "${site.mod}:${site.name}"
    let (_, dupFrag) = w.seenFrag[fk]
    if (dupFrag) {
      continue
    }
    w.seenFrag[fk] = true
    w.out = append(
      w.out,
      JsonSchemaFragNeed{
        needMod = w.rootMod, rootName = w.rootName, classMod = site.mod, className = site.name,
        path = site.path,
      },
    )
  }
}

// Every cross-module class `rootName` (declared in `rootMod`) reaches, one
// hop from `rootMod`'s OWN scope — a same-module hop keeps walking (a chain
// of local classes can still end in a foreign one), a cross-module hop is
// recorded and NOT walked further (classjsonschemacall.bit's own header
// explains why: a call `rootMod`'s own tree builds can only use a path
// `rootMod` itself already imports, which a class two modules away is not
// guaranteed to have).
fn collectSchemaFragNeedsForRoot(p: Project, rootMod: int, rootName: string): []JsonSchemaFragNeed {
  let rootJx = newJsonCtx(p, p.mods[rootMod])
  let w = SchemaFragWalk{
    rootMod = rootMod, rootName = rootName, queue = [rootName],
    out = []JsonSchemaFragNeed(0), seenFrag = map<string, bool>{},
  }
  let seenLocal = map<string, bool>{}
  let i = 0
  let budget = 4096
  while (i < len(w.queue) && i < budget) {
    let name = w.queue[i]
    i = i + 1
    let (_, dupLocal) = seenLocal[name]
    if (dupLocal) {
      continue
    }
    seenLocal[name] = true
    let d = jsonClassDeclByName(rootJx.tree, rootJx.source, name)
    if (d == 0) {
      continue
    }
    addSchemaFragNeedsForClass(rootJx, w, d)
  }
  return w.out
}

// The frag needs `rootName`'s own document (built in module `mid`) owes a
// `$defs` entry for.
fn schemaFragNeedsForRoot(sd: JsonSchemaDemand, mid: int, rootName: string): []JsonSchemaFragNeed {
  let out = []JsonSchemaFragNeed(0)
  for n of sd.fragNeeds {
    if (n.needMod == mid && n.rootName == rootName) {
      out = append(out, n)
    }
  }
  return out
}

// The `dir`'s own last path segment — a stable, per-module qualifier for a
// `$defs` key two different modules' classes collide on (#6182), e.g.
// `models/b` -> `"b"`.
fn schemaDirQualifier(p: Project, mod: int): string {
  let dir = p.mods[mod].dir
  let i = len(dir)
  while (i > 0 && dir[i - 1:i] != "/") {
    i = i - 1
  }
  return dir[i:len(dir)]
}

// The `$defs` key every local name and every cross-module frag need
// resolves to for ONE document: a local (same-module) name is always its
// own bare text — unaffected, matching `jsonSchemaClosureNames`'s existing,
// already-gated behavior — and a cross-module one is its own bare class
// name UNLESS that text is already taken (by a local name OR another
// cross-module class of the same name from a different module), in which
// case it is qualified `"<dirBaseName>.<Name>"`; both are then globally
// unique within this one document, keyed `"<mod>:<name>"` for
// `schemaRefKey` (classjsonschema.bit) to find.
fn schemaDefsKeyMap(
  p: Project,
  localNames: []string,
  fragNeeds: []JsonSchemaFragNeed,
): map<string, string> {
  let counts = map<string, int>{}
  for n of localNames {
    let (c, _) = counts[n]
    counts[n] = c + 1
  }
  for n of fragNeeds {
    let (c, _) = counts[n.className]
    counts[n.className] = c + 1
  }
  let keys = map<string, string>{}
  for n of fragNeeds {
    let (c, _) = counts[n.className]
    if (c > 1) {
      keys["${n.classMod}:${n.className}"] = schemaDirQualifier(p, n.classMod) + "." + n.className
      continue
    }
    keys["${n.classMod}:${n.className}"] = n.className
  }
  return keys
}
