// Self-host `bit fmt` (#1345): the canonical formatter.
// AST -> source text, gofmt philosophy — one true style, zero configuration,
// idempotent. This file holds the printer substrate (comment collection, the
// Printer state, low-level output, the list/sequence/block helpers) and the
// public entry point; the per-node dispatch lives in the sibling files
// fmtdispatch.bit (declarations + statements) and fmtexpr.bit (expressions +
// types). Siblings are the same module, so this is a plain split.
//
// compiler/fmtwrap.bit (#2896): the width-aware wrap-decision machinery —
// flat lists, bracketed comma lists, and binary/logical chain flattening
// (#2889) — split out here only because this file outgrew the 800-line
// limit; it is the same module, so every function below still calls it
// unqualified.
//
// The style is byte-for-byte the seed's: the self-host formatter differential
// (scripts/selfhost-difffmt.sh) compares seed-fmt output against this over the
// whole corpus, so every choice here mirrors exactly rather than
// improving on it. Improving the output would break the differential.
//
// Comments are trivia the lexer discards, so they are re-derived by a second
// pass that re-lexes the source and scans the byte gaps between consecutive
// real tokens for `//` / `/*` (see collectComments). A gap between two tokens is
// pure trivia by the lexer's own contract, so this can never misfire on a
// string literal's contents.

// Columns after which a bracketed list wraps one item per line.
const fmtMaxWidth = 100
// Spaces per indent level.
const fmtIndentWidth = 2
// Recursion cap, mirroring ast.dump's: a well-formed tree is far shallower, so
// hitting it means a malformed tree, not deep real input.
const fmtMaxDepth = 256

// ---- comments --------------------------------------------------------------

// A `//` line comment or `/* */` block comment, as a byte range in the source.
class Comment {
  start: int,
  end: int,
  isLine: bool,
}

// Re-derives every comment in `src` by re-lexing it and scanning the byte gap
// between each pair of consecutive real tokens. The lexer synthesizes ASI
// semicolons and a final eof as tokens, exactly as the seed's `lx.next()` does,
// so the gaps — and therefore the comment set — match the seed byte for byte.
fn collectComments(src: string): []Comment {
  let toks = lexAll(src)
  let out = []Comment(0)
  let prevEnd = 0
  let i = 0
  while (i < len(toks)) {
    let t = toks[i]
    out = scanGap(out, src, prevEnd, t.start)
    if (t.kind == Kind.Eof) {
      break
    }
    prevEnd = t.end
    i = i + 1
  }
  return out
}

// Scans `src[from..to]` — a trivia-only gap between two real tokens — for line
// and block comments, appending each in source order.
fn scanGap(out: []Comment, src: string, lo: int, hi: int): []Comment {
  let acc = out
  let i = lo
  while (i < hi) {
    if (src[i] == '/' && i + 1 < hi && src[i + 1] == '/') {
      let start = i
      i = i + 2
      while (i < hi && src[i] != '\n') {
        i = i + 1
      }
      // bit:lint allow E0214 -- scanGap's only call site, fmt.bit:54, reassigns out = scanGap(out, ...) in place; out is seeded fresh from collectComments's own []Comment(0), and no caller keeps a pre-call reference
      acc = append(acc, Comment{ start: start, end: i, isLine: true })
    } else if (src[i] == '/' && i + 1 < hi && src[i + 1] == '*') {
      let start = i
      i = i + 2
      while (i + 1 < hi && !(src[i] == '*' && src[i + 1] == '/')) {
        i = i + 1
      }
      i = i + 2
      if (i > hi) {
        i = hi
      }
      // bit:lint allow E0214 -- same out, same single-owner accumulator seeded fresh from []Comment(0); no caller keeps a pre-call copy
      acc = append(acc, Comment{ start: start, end: i, isLine: false })
    } else {
      i = i + 1
    }
  }
  return acc
}

// Newlines strictly within `src[a..b]` — used to decide "same source line" (0)
// and "blank line present" (>= 2). Returns 0 when `a >= b`: a match-shaped node
// in expression position can leave `srcPos` ahead of a later node's start.
fn newlinesBetween(src: string, a: int, b: int): int {
  if (a >= b) {
    return 0
  }
  let n = 0
  let i = a
  while (i < b) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// Operator precedence for re-parenthesization, keyed by the stored `main` int
// (a Kind).
fn fmtPrec(m: int): int {
  if (m == int(Kind.Star) || m == int(Kind.Slash) || m == int(Kind.Percent) ||
    m == int(Kind.Shl) || m == int(Kind.Shr) || m == int(Kind.Amp)) {
    return 6
  }
  if (m == int(Kind.Plus) || m == int(Kind.Minus) || m == int(Kind.Pipe) ||
    m == int(Kind.Caret)) {
    return 5
  }
  if (m == int(Kind.EqEq) || m == int(Kind.BangEq) || m == int(Kind.Lt) ||
    m == int(Kind.LtEq) || m == int(Kind.Gt) || m == int(Kind.GtEq)) {
    return 4
  }
  if (m == int(Kind.AmpAmp)) {
    return 3
  }
  if (m == int(Kind.PipePipe)) {
    return 2
  }
  return 0
}

// The bitwise-and-shift operator family, whose mixed expressions the formatter
// parenthesizes for clarity regardless of precedence.
fn fmtIsBitOrShift(m: int): bool {
  return m == int(Kind.Amp) || m == int(Kind.Pipe) || m == int(Kind.Caret) ||
    m == int(Kind.Shl) || m == int(Kind.Shr)
}

// The boolean-connective family (`&&`, `||`). A `&&` group nested in a `||`
// (or vice versa) is parenthesized for clarity regardless of precedence, the
// same style rule as `fmtIsBitOrShift` and for the same reason (#2356): the
// two operators already produced a shipped precedence miscompile (#2344), so
// a reader should not have to hold the precedence table in their head to see
// which connective a subexpression belongs to.
fn fmtIsBoolConn(m: int): bool {
  return m == int(Kind.AmpAmp) || m == int(Kind.PipePipe)
}

// ---- printer ---------------------------------------------------------------

// The formatter's mutable state. A class is a reference in Bit, so the free
// functions below mutate it in place — the direct analogue of the seed's
// `*Printer` methods. `out` accumulates the canonical text.
class Printer {
  source: string,
  tree: Tree,
  // Accumulated output, byte-buffer backed (not `string`): `fmtRaw` runs once
  // per token/space, and Bit strings are immutable, so `out = out + text`
  // would copy the WHOLE accumulated file on every call — O(n) per call,
  // O(n^2) over a file. `append` grows a slice in place (runtime doubling,
  // see bit_rt_slice_append), so appending byte by byte is amortized O(1)
  // per byte and O(n) for the whole file. Read back via `string(p.out)`.
  out: []byte,
  comments: []Comment,
  ci: int,
  indent: int,
  col: int,
  // True at the start of a fresh output line: the indent has not been written
  // yet (written lazily by `fmtRaw` once real content is about to land).
  bol: bool,
  // Source byte offset just after the last real token or comment emitted.
  srcPos: int,
  depth: int,
  // One-shot hint from a caller that knows how many characters of fixed content
  // will follow a list's closing bracket on the same line. `fmtPrintCommaList`
  // folds it into its width check and resets it. Zero means "no known tail".
  nextListTail: int,
  // True while trial-rendering the sole item of an ancestor
  // `fmtPrintCommaList`/`fmtPrintFlatList` that already committed to keeping
  // it flat regardless of overflow (the `len(items) == 1` rule) — see
  // `fmtPrintBinaryChain`'s use of it (`#2894`).
  speculativeFlat: bool,
  // 0-based output line counter, advanced once per `fmtNewline` — the
  // adjacency signal `fmtComputeAlignCols` (fmtalign.bit) uses to tell a run
  // of trailing comments apart from two that merely happen to be nearby.
  outLine: int,
  // Every same-line trailing `//` comment recorded so far, in emission
  // (= ascending buffer offset) order — see `fmtGap`'s `sameLine` branch
  // below. `formatSource` feeds the finished list to `fmtApplyAlignment`
  // once the whole file is printed (#3673): alignment is a post-pass over
  // the buffer, not a change to this streaming printer's control flow.
  trailAligns: []TrailAlign,
  // One-shot hint from the Tag.FuncDecl case (fmtdispatch.bit) to the
  // Tag.Receiver case it is about to call into via `fmtPrintNode`: the
  // receiver-derived generic params (#3767) an explicit receiver clause's
  // type lost when `parseFuncDecl` folded them into the func_decl's merged
  // generics kid instead of attaching them to the receiver's own type node.
  // Set right before printing the receiver, consumed and cleared inside the
  // Tag.Receiver case — the same producer/consumer shape as `nextListTail`.
  // Empty means "no receiver-derived generics to reattach".
  pendingReceiverGenerics: []int,
}

// The last '\n' in `s`, or -1 if none.
fn fmtLastNl(s: string): int {
  let i = len(s) - 1
  while (i >= 0) {
    if (s[i] == '\n') {
      return i
    }
    i = i - 1
  }
  return -1
}

// Whether `s` contains a '\n'.
fn fmtHasNl(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      return true
    }
    i = i + 1
  }
  return false
}

// Appends every byte of `s` to the buffer `p.out` backs (see the `Printer.out`
// doc comment): amortized O(1) per byte via `append`'s in-place growth.
fn fmtAppendStr(p: Printer, s: string) {
  let i = 0
  while (i < len(s)) {
    p.out = append(p.out, s[i])
    i = i + 1
  }
}

// Appends `text`, writing the pending indent lazily on the first real content
// of a line and tracking the output column.
fn fmtRaw(p: Printer, text: string) {
  if (len(text) == 0) {
    return
  }
  if (p.bol) {
    p.bol = false
    let total = p.indent * fmtIndentWidth
    fmtAppendStr(p, repeatStr(" ", total))
    p.col = total
  }
  fmtAppendStr(p, text)
  let nl = fmtLastNl(text)
  if (nl >= 0) {
    p.col = len(text) - nl - 1
  } else {
    p.col = p.col + len(text)
  }
}

fn fmtNewline(p: Printer) {
  fmtAppendStr(p, "\n")
  p.col = 0
  p.bol = true
  p.outLine = p.outLine + 1
}

fn fmtHasCommentBefore(p: Printer, end: int): bool {
  return p.ci < len(p.comments) && p.comments[p.ci].start < end
}

// Flushes every comment starting before `nextStart` (trailing on the current
// line if contiguous, else on its own line — with one blank preserved when
// `allowBlank`), then leaves the cursor on a fresh line.
fn fmtGap(p: Printer, nextStart: int, allowBlank: bool) {
  while (p.ci < len(p.comments) && p.comments[p.ci].start < nextStart) {
    let c = p.comments[p.ci]
    let sameLine = !p.bol && newlinesBetween(p.source, p.srcPos, c.start) == 0
    if (sameLine) {
      // Record a line comment's own column so a later post-pass
      // (fmtalign.bit's fmtApplyAlignment, called once from formatSource)
      // can widen this single space into shared-column padding if this
      // line joins a run of others like it. A same-line block comment
      // (`isLine == false`) does not force a newline and code may continue
      // after it on the same output line, so it is never a trailing-comment
      // table candidate and is left exactly as before: one space, no
      // alignment.
      if (c.isLine) {
        p.trailAligns = append(p.trailAligns, TrailAlign{ pos: len(p.out), width: p.col, line: p.outLine })
      }
      fmtRaw(p, " ")
    } else {
      if (!p.bol) {
        fmtNewline(p)
      }
      if (allowBlank && newlinesBetween(p.source, p.srcPos, c.start) >= 2) {
        fmtNewline(p)
      }
    }
    fmtRaw(p, p.source[c.start:c.end])
    p.srcPos = c.end
    p.ci = p.ci + 1
    if (c.isLine) {
      fmtNewline(p)
    }
  }
  if (!p.bol) {
    fmtNewline(p)
  }
  if (allowBlank && newlinesBetween(p.source, p.srcPos, nextStart) >= 2) {
    fmtNewline(p)
  }
}

// Renders `idx` flat into a fresh buffer without touching real output, so a
// caller can measure width before deciding how something earlier wraps. This is
// the only render of `idx` — comments and `srcPos` advance for real — so the
// caller must reuse the returned text as its actual output.
fn fmtRenderFlat(p: Printer, idx: int): string {
  let colBefore = p.col
  let bolBefore = p.bol
  let savedOut = p.out
  // Unlike the swapped `p.out`, any comment rendered into this scratch
  // buffer is NOT re-replayed through fmtGap once the caller copies `text`
  // into the real output (see the doc comment above) -- so a trailAligns
  // entry recorded in here would carry a byte offset into a buffer that no
  // longer exists once `p.out` is restored below. Drop any such entries
  // rather than risk applying alignment padding at a stale, wrong offset:
  // the comment's TEXT still lands correctly either way, it just keeps its
  // default single space, same as the other comment kinds this feature
  // deliberately leaves untouched.
  let alignBefore = len(p.trailAligns)
  p.out = []byte(0)
  // Force bol false for the trial's own duration so no lazy indent bakes
  // into the captured text -- fmtRaw's lazy-indent write fires the same way
  // in this scratch render as it does for real (mirrors fmtInlineFits above).
  // Unlike fmtwrap.bit's trial sites (#2897), fmtRenderFlat never replays
  // `text` through fmtRaw itself -- it hands the string back to the caller,
  // which always writes further real content (e.g. the params list) before
  // eventually emitting it via its own fmtRaw calls -- so there is no risk
  // of the double-indent #2897's fix guards against there. Restoring the
  // true bol afterward still matters: it is live Printer state, and leaving
  // it forced false would wrongly skip the caller's own next lazy-indent
  // write if this function is ever invoked at bol == true.
  p.bol = false
  fmtPrintNode(p, idx)
  let text = string(p.out)
  p.out = savedOut
  p.col = colBefore
  p.bol = bolBefore
  p.trailAligns = p.trailAligns[0:alignBefore]
  return text
}

// The node dispatch entry: depth-guarded, then hands off to fmtDispatch, then
// advances srcPos past the node's span.
fn fmtPrintNode(p: Printer, idx: int) {
  if (idx == 0) {
    return
  }
  if (p.depth >= fmtMaxDepth) {
    return
  }
  p.depth = p.depth + 1
  let n = getNode(p.tree, idx)
  fmtDispatch(p, idx, n)
  if (n.span.end > p.srcPos) {
    p.srcPos = n.span.end
  }
  p.depth = p.depth - 1
}

// A postfix chain's receiver or a spawn/defer operand: atomic unless parens
// made it a binary/unary/catch/arrow/conditional underneath, in which case
// they must be re-added. `Tag.IntLit` is also wrapped: an int literal printed
// immediately before the bare `.` that `Tag.Member`/`Tag.TupleIndex` emit next
// re-lexes as the start of a float literal (`5.zzz`), changing the token
// stream, not just style.
fn fmtPrintAtomic(p: Printer, idx: int) {
  let t = getNode(p.tree, idx).tag
  let wrap = t == Tag.Binary ||
    t == Tag.Unary ||
    t == Tag.CatchDefault ||
    t == Tag.CatchBind ||
    t == Tag.ArrowFn ||
    t == Tag.CondExpr ||
    t == Tag.IntLit
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// `catch`'s left operand: only catch/arrow need re-parenthesizing there.
fn fmtPrintCatchLhs(p: Printer, idx: int) {
  let t = getNode(p.tree, idx).tag
  let wrap = t == Tag.CatchDefault || t == Tag.CatchBind || t == Tag.ArrowFn
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// True for a statement/declaration whose canonical form always ends in a
// block's closing `}` — printed with no trailing `;` (safe: `}` is an ASI
// terminator). The tag list itself is `fmtEndsInBlockTag` (fmtasm.bit,
// #4308), a sibling split purely so a new block-ending tag costs that
// function's complexity, never this one's own recorded baseline
// (tools/build/complexity-debt.txt).
fn fmtEndsInBlock(p: Printer, idx: int): bool {
  let t = getNode(p.tree, idx).tag
  if (fmtEndsInBlockTag(t)) {
    return true
  }
  if (t == Tag.Export) {
    return fmtEndsInBlock(p, kidsOf(p.tree, idx)[0])
  }
  return false
}

// Whether `idx`'s canonical form ends in a token after which ASI inserts a
// semicolon — so an explicit `;` can be omitted. The last token kind is
// invariant under canonicalization, so reading it from the source span is sound.
fn fmtEndsInTerminator(p: Printer, idx: int): bool {
  let sp = getNode(p.tree, idx).span
  if (sp.end <= sp.start) {
    return false
  }
  let toks = lexAll(p.source[sp.start:sp.end])
  let last = Kind.Eof
  let i = 0
  while (i < len(toks)) {
    if (toks[i].kind != Kind.Eof) {
      last = toks[i].kind
    }
    i = i + 1
  }
  // The lexer synthesizes a `.semicolon` at end-of-input after a terminator, so
  // a trailing synthesized `;` is the definitive signal ASI would fire. Fall
  // back to the raw terminator check for safety.
  return last == Kind.Semicolon || isTerminator(last)
}

// A `{ stmt }` block that canonicalizes onto one line: exactly one child, that
// child a simple statement (not block/control-flow, no inner match), and no
// comment inside the braces.
fn fmtBlockInlineable(p: Printer, idx: int): bool {
  let items = kidsOf(p.tree, idx)
  if (len(items) != 1) {
    return false
  }
  if (fmtEndsInBlock(p, items[0])) {
    return false
  }
  if (fmtContainsMatch(p, items[0])) {
    return false
  }
  return !fmtHasCommentBefore(p, getNode(p.tree, idx).span.end)
}

// Whether `idx`'s subtree contains a `match`, which always renders multi-line.
fn fmtContainsMatch(p: Printer, idx: int): bool {
  if (idx == 0) {
    return false
  }
  if (getNode(p.tree, idx).tag == Tag.MatchStmt) {
    return true
  }
  let kids = kidsOf(p.tree, idx)
  let i = 0
  while (i < len(kids)) {
    if (fmtContainsMatch(p, kids[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

// Prints a body that is either a `.block` (collapsed to `{ stmt }` when
// inlineable, else stacked) or a bare match-arm statement. `preserveSource`
// (function bodies) inlines only what the author wrote inline; match arms pass
// false, always collapsing a braced body.
fn fmtPrintBodyBlock(p: Printer, idx: int, preserveSource: bool) {
  let n = getNode(p.tree, idx)
  let sourceInline = !preserveSource || newlinesBetween(p.source, n.span.start, n.span.end) == 0
  if (n.tag == Tag.Block && fmtBlockInlineable(p, idx) && sourceInline) {
    let firstKid = kidsOf(p.tree, idx)[0]
    if (fmtInlineFits(p, firstKid)) {
      fmtRaw(p, "{ ")
      fmtPrintNode(p, firstKid)
      fmtRaw(p, " }")
      if (n.span.end > p.srcPos) {
        p.srcPos = n.span.end
      }
      return
    }
  }
  fmtPrintNode(p, idx)
}

// Whether the sole statement of an inline body renders on one line within the
// width, as `{ stmt }` at the current column. Trial-renders and fully restores
// every mutable field, so it is side-effect-free.
fn fmtInlineFits(p: Printer, stmt: int): bool {
  let col0 = p.col
  let sBol = p.bol
  let sIndent = p.indent
  let sSrc = p.srcPos
  let sCi = p.ci
  let sDepth = p.depth
  let savedOut = p.out
  p.out = []byte(0)
  p.col = col0 + 2
  p.bol = false
  fmtPrintNode(p, stmt)
  let text = string(p.out)
  p.out = savedOut
  p.col = col0
  p.bol = sBol
  p.indent = sIndent
  p.srcPos = sSrc
  p.ci = sCi
  p.depth = sDepth
  return !fmtHasNl(text) && col0 + 2 + len(text) + 2 <= fmtMaxWidth
}

// Like fmtPrintSeq but never keeps a blank before the first item. Used for
// switch/select clause lists and case/default bodies.
fn fmtPrintNoLeadBlank(p: Printer, items: []int, stmtStyle: bool) {
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, i != 0)
    fmtPrintNode(p, items[i])
    if (stmtStyle && !fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
}

// Statement/declaration sequence (top decls, block statements, case bodies): one
// per line, one blank line preserved from the source.
fn fmtPrintSeq(p: Printer, items: []int, stmtStyle: bool) {
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, true)
    fmtPrintNode(p, items[i])
    if (stmtStyle && !fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
}

// A brace block: `{`, the stacked statements (no blank kept right after `{`),
// then `}`.
fn fmtPrintBlock(p: Printer, idx: int) {
  let n = getNode(p.tree, idx)
  let items = kidsOf(p.tree, idx)
  fmtRaw(p, "{")
  if (len(items) == 0 && !fmtHasCommentBefore(p, n.span.end)) {
    fmtRaw(p, "}")
    return
  }
  p.indent = p.indent + 1
  fmtPrintNoLeadBlank(p, items, true)
  fmtGap(p, n.span.end, true)
  p.indent = p.indent - 1
  fmtRaw(p, "}")
}

// True when a class body's member list (fmtdispatch.bit's field_list case)
// holds at least one in-body method (SPEC §10.4, #3367) — a func_decl,
// possibly wrapped in export — or a `use` statement (SPEC §10.7, #3369),
// rather than only fields. Field-only classes keep the existing comma-list
// rendering unchanged; either addition switches to fmtPrintMemberBlock
// below, one member per line — `use A, B, x: f64` on a comma list would give
// no way to see where the traits end and the fields begin.
fn fmtFieldListHasMethod(t: Tree, idx: int): bool {
  let items = kidsOf(t, idx)
  let i = 0
  while (i < len(items)) {
    let it = items[i]
    if (getNode(t, it).tag == Tag.Export) {
      it = kidsOf(t, it)[0]
    }
    let itag = getNode(t, it).tag
    if (itag == Tag.FuncDecl || itag == Tag.UseStmt) {
      return true
    }
    i = i + 1
  }
  return false
}

// The two halves of a method's merged generics kid (mergeGenericParams's
// "receiver params first" contract, parsertype.bit): `prefix` is
// class-derived, `own` is the method's own trailing generics. One ordering
// fact recovers the split without a third AST shape or a parser change: a
// receiver-derived param's node always starts BEFORE the method's own name.
// (Before #3762 retired the written receiver form, `fn (s: Stack<T>)
// push(...)` reached this the same way — its own `<T>` parsed entirely
// before the name it preceded.) An in-body method's implicit receiver
// (parsertype.bit's dupGenericParams) reuses the class's own declared param
// nodes verbatim, spanned back at the class header — while the method's own
// generics (`maybeGenericParams` called immediately after the name) always
// start after it (#3767).
class FmtGenericsSplit {
  prefix: []int,
  own: []int,
}

fn fmtSplitGenerics(p: Printer, genericsNode: int, nameNode: int): FmtGenericsSplit {
  if (genericsNode == 0) {
    return FmtGenericsSplit{ prefix: []int(0), own: []int(0) }
  }
  let items = kidsOf(p.tree, genericsNode)
  let nameStart = getNode(p.tree, nameNode).span.start
  let prefix = []int(0)
  let own = []int(0)
  let i = 0
  while (i < len(items)) {
    if (getNode(p.tree, items[i]).span.start < nameStart) {
      prefix = append(prefix, items[i])
    } else {
      own = append(own, items[i])
    }
    i = i + 1
  }
  return FmtGenericsSplit{ prefix: prefix, own: own }
}

// Prints `items` as a `<...>` generics clause, or nothing when empty —
// `genericsNode` supplies the true closing position for the wrap-width/
// comment checks (safe even when `items` is a strict subset of its kids,
// since the case that matters, `items` non-empty, only arises when `items`
// IS the merged node's own trailing kids per fmtSplitGenerics above, so its
// span really does end where the last printed item does).
fn fmtPrintGenericsList(p: Printer, items: []int, genericsNode: int) {
  if (len(items) == 0) {
    return
  }
  fmtPrintCommaList(p, items, "<", ">", getNode(p.tree, genericsNode).span.end)
}

// Prints an in-body method from its desugared func_decl/receiver shape
// (parsertype.bit's parseMethodMember): no `fn` keyword and no receiver
// clause — just the member's own name, generics, signature and body, exactly
// as SPEC §10.4's in-body form is written. `idx` is the func_decl itself
// (export, if any, is the caller's concern — fmtPrintMemberBlock below).
// The generics kid is the merged (receiver + own) list — see
// fmtSplitGenerics — so only its `own` half is ever re-emitted here; the
// receiver-derived half is implicit for this form and already printed
// nowhere (#3767: printing the merged list whole re-declared the class's own
// `T` on every method, e.g. `get<T>(): T`, which the checker then rejected
// with E0042).
fn fmtPrintClassMethod(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [recv, name, generics, params, result, body]
  fmtPrintNode(p, k[1])
  fmtPrintGenericsList(p, fmtSplitGenerics(p, k[2], k[1]).own, k[2])
  let hasRet = k[4] != 0
  let retText = ""
  if (hasRet) {
    retText = fmtRenderFlat(p, k[4])
  }
  if (hasRet) {
    p.nextListTail = len(retText) + 2 + 2
  } else {
    p.nextListTail = 2
  }
  fmtPrintNode(p, k[3])
  if (hasRet) {
    fmtRaw(p, ": ")
    fmtRaw(p, retText)
  }
  fmtRaw(p, " ")
  fmtPrintBodyBlock(p, k[5], true)
}

// One class body member: a field prints exactly as it always has (the
// generic dispatch already handles `export` wrapping a field), but an
// in-body method must bypass fmtDispatch's ordinary func_decl case — that
// one prints a top-level function's plain `fn name` (and, before #3762
// retired it, the written `fn (recv) name` form) — and go through
// fmtPrintClassMethod instead, with `export` (if any) printed here first.
fn fmtPrintMember(p: Printer, raw: int) {
  let exported = getNode(p.tree, raw).tag == Tag.Export
  let inner = raw
  if (exported) {
    inner = kidsOf(p.tree, raw)[0]
  }
  if (getNode(p.tree, inner).tag != Tag.FuncDecl) {
    fmtPrintNode(p, raw)
    return
  }
  if (exported) {
    fmtRaw(p, "export ")
  }
  // 'init' (classinit.bit, #3371) prints its own compact fallible marker —
  // bare '!', never fmtPrintClassMethod's ': ()!' — since parseInitMember's
  // grammar has no colon to read one back from.
  if (isClassInitDecl(p.tree, p.source, inner)) {
    fmtPrintClassInit(p, inner)
    return
  }
  fmtPrintClassMethod(p, inner)
}

// A class body mixing fields and in-body methods (SPEC §10.4): one member per
// line, blank lines preserved, no trailing separator — a field's declared
// type and a method's closing `}` are both ASI terminators (§7), so `bit fmt`
// never needs to print one (fmtEndsInBlock/fmtEndsInTerminator, both already
// widened or already correct for a nested func_decl).
fn fmtPrintMemberBlock(p: Printer, items: []int, listSpan: Span) {
  fmtRaw(p, "{")
  if (len(items) == 0 && !fmtHasCommentBefore(p, listSpan.end)) {
    fmtRaw(p, "}")
    return
  }
  p.indent = p.indent + 1
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, true)
    fmtPrintMember(p, items[i])
    if (!fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
  fmtGap(p, listSpan.end, true)
  p.indent = p.indent - 1
  fmtRaw(p, "}")
}

// ---- public API ------------------------------------------------------------

// Canonical source on success, or rendered diagnostics when `src` does not parse
// (`failed` true) — fmt never guesses at malformed input.
class FmtResult {
  text: string,
  failed: bool,
}

// Formats `src` to Bit's one canonical style. On a parse error, `failed` is true
// and `text` holds the rendered diagnostics, matching the seed's `format`.
fn formatSource(path: string, src: string): FmtResult {
  src = stripBom(src)
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  let tree = parseSourceD(src, f, d)
  if (hasErrors(d)) {
    return FmtResult{ text: renderDiags(d), failed: true }
  }
  let comments = collectComments(src)
  let p = Printer{
    source: src,
    tree: tree,
    out: []byte(0),
    comments: comments,
    ci: 0,
    indent: 0,
    col: 0,
    bol: true,
    srcPos: 0,
    depth: 0,
    nextListTail: 0,
    speculativeFlat: false,
    outLine: 0,
    trailAligns: []TrailAlign(0),
    pendingReceiverGenerics: []int(0),
  }
  fmtPrintNode(p, tree.root)
  // Post-pass (#3673, fmtalign.bit): widen each recorded trailing comment's
  // single space into shared-column padding wherever it joined a run of
  // others like it. Done once, on the finished buffer, rather than woven
  // into the streaming printer above — a run's width is only known once
  // every member of it has been printed.
  let aligned = fmtApplyAlignment(p.out, p.trailAligns)
  return FmtResult{ text: string(aligned), failed: false }
}
