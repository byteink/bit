// Self-host `bit fmt` (#1345): the canonical formatter.
// AST -> source text, gofmt philosophy — one true style, zero configuration,
// idempotent. This file holds the printer substrate (comment collection, the
// Printer state, low-level output, the list/sequence/block helpers) and the
// public entry point; the per-node dispatch lives in the sibling files
// fmtdispatch.bit (declarations + statements) and fmtexpr.bit (expressions +
// types). Siblings are the same module, so this is a plain split.
//
// compiler/fmtwrap.bit (#2896): the width-aware wrap-decision machinery —
// flat lists, bracketed comma lists, and binary/logical chain flattening
// (#2889) — split out here only because this file outgrew the 800-line
// limit; it is the same module, so every function below still calls it
// unqualified.
//
// compiler/fmtprint.bit (#4322): the node-print entry point (fmtPrintNode)
// and the block/sequence/member printing helpers, split out here at 793
// lines against the 800-line limit; same module, no import needed.
//
// The style is byte-for-byte the seed's: the self-host formatter differential
// (scripts/selfhost-difffmt.sh) compares seed-fmt output against this over the
// whole corpus, so every choice here mirrors exactly rather than
// improving on it. Improving the output would break the differential.
//
// Comments are trivia the lexer discards, so they are re-derived by a second
// pass that re-lexes the source and scans the byte gaps between consecutive
// real tokens for `//` / `/*` (see collectComments). A gap between two tokens is
// pure trivia by the lexer's own contract, so this can never misfire on a
// string literal's contents.

// Columns after which a bracketed list wraps one item per line.
const fmtMaxWidth = 100
// Spaces per indent level.
const fmtIndentWidth = 2
// Recursion cap, mirroring ast.dump's: a well-formed tree is far shallower, so
// hitting it means a malformed tree, not deep real input.
const fmtMaxDepth = 256

// ---- comments --------------------------------------------------------------

// A `//` line comment or `/* */` block comment, as a byte range in the source.
class Comment {
  start: int,
  end: int,
  isLine: bool,
}

// Re-derives every comment in `src` by re-lexing it and scanning the byte gap
// between each pair of consecutive real tokens. The lexer synthesizes ASI
// semicolons and a final eof as tokens, exactly as the seed's `lx.next()` does,
// so the gaps — and therefore the comment set — match the seed byte for byte.
fn collectComments(src: string): []Comment {
  let toks = lexAll(src)
  let out = []Comment(0)
  let prevEnd = 0
  let i = 0
  while (i < len(toks)) {
    let t = toks[i]
    out = scanGap(out, src, prevEnd, t.start)
    if (t.kind == Kind.Eof) {
      break
    }
    prevEnd = t.end
    i = i + 1
  }
  return out
}

// Scans `src[from..to]` — a trivia-only gap between two real tokens — for line
// and block comments, appending each in source order.
fn scanGap(out: []Comment, src: string, lo: int, hi: int): []Comment {
  let acc = out
  let i = lo
  while (i < hi) {
    if (src[i] == '/' && i + 1 < hi && src[i + 1] == '/') {
      let start = i
      i = i + 2
      while (i < hi && src[i] != '\n') {
        i = i + 1
      }
      // bit:lint allow E0214 -- scanGap's only call site, fmt.bit:54, reassigns out = scanGap(out, ...) in place; out is seeded fresh from collectComments's own []Comment(0), and no caller keeps a pre-call reference
      acc = append(acc, Comment{ start: start, end: i, isLine: true })
    } else if (src[i] == '/' && i + 1 < hi && src[i + 1] == '*') {
      let start = i
      i = i + 2
      while (i + 1 < hi && !(src[i] == '*' && src[i + 1] == '/')) {
        i = i + 1
      }
      i = i + 2
      if (i > hi) {
        i = hi
      }
      // bit:lint allow E0214 -- same out, same single-owner accumulator seeded fresh from []Comment(0); no caller keeps a pre-call copy
      acc = append(acc, Comment{ start: start, end: i, isLine: false })
    } else {
      i = i + 1
    }
  }
  return acc
}

// Newlines strictly within `src[a..b]` — used to decide "same source line" (0)
// and "blank line present" (>= 2). Returns 0 when `a >= b`: a match-shaped node
// in expression position can leave `srcPos` ahead of a later node's start.
fn newlinesBetween(src: string, a: int, b: int): int {
  if (a >= b) {
    return 0
  }
  let n = 0
  let i = a
  while (i < b) {
    if (src[i] == '\n') {
      n = n + 1
    }
    i = i + 1
  }
  return n
}

// Operator precedence for re-parenthesization, keyed by the stored `main` int
// (a Kind).
fn fmtPrec(m: int): int {
  if (m == int(Kind.Star) || m == int(Kind.Slash) || m == int(Kind.Percent) ||
    m == int(Kind.Shl) || m == int(Kind.Shr) || m == int(Kind.Amp)) {
    return 6
  }
  if (m == int(Kind.Plus) || m == int(Kind.Minus) || m == int(Kind.Pipe) ||
    m == int(Kind.Caret)) {
    return 5
  }
  if (m == int(Kind.EqEq) || m == int(Kind.BangEq) || m == int(Kind.Lt) ||
    m == int(Kind.LtEq) || m == int(Kind.Gt) || m == int(Kind.GtEq)) {
    return 4
  }
  if (m == int(Kind.AmpAmp)) {
    return 3
  }
  if (m == int(Kind.PipePipe)) {
    return 2
  }
  return 0
}

// The bitwise-and-shift operator family, whose mixed expressions the formatter
// parenthesizes for clarity regardless of precedence.
fn fmtIsBitOrShift(m: int): bool {
  return m == int(Kind.Amp) || m == int(Kind.Pipe) || m == int(Kind.Caret) ||
    m == int(Kind.Shl) || m == int(Kind.Shr)
}

// The boolean-connective family (`&&`, `||`). A `&&` group nested in a `||`
// (or vice versa) is parenthesized for clarity regardless of precedence, the
// same style rule as `fmtIsBitOrShift` and for the same reason (#2356): the
// two operators already produced a shipped precedence miscompile (#2344), so
// a reader should not have to hold the precedence table in their head to see
// which connective a subexpression belongs to.
fn fmtIsBoolConn(m: int): bool {
  return m == int(Kind.AmpAmp) || m == int(Kind.PipePipe)
}

// ---- printer ---------------------------------------------------------------

// The formatter's mutable state. A class is a reference in Bit, so the free
// functions below mutate it in place — the direct analogue of the seed's
// `*Printer` methods. `out` accumulates the canonical text.
class Printer {
  source: string,
  tree: Tree,
  // Accumulated output, byte-buffer backed (not `string`): `fmtRaw` runs once
  // per token/space, and Bit strings are immutable, so `out = out + text`
  // would copy the WHOLE accumulated file on every call — O(n) per call,
  // O(n^2) over a file. `append` grows a slice in place (runtime doubling,
  // see bit_rt_slice_append), so appending byte by byte is amortized O(1)
  // per byte and O(n) for the whole file. Read back via `string(p.out)`.
  out: []byte,
  comments: []Comment,
  ci: int,
  indent: int,
  col: int,
  // True at the start of a fresh output line: the indent has not been written
  // yet (written lazily by `fmtRaw` once real content is about to land).
  bol: bool,
  // Source byte offset just after the last real token or comment emitted.
  srcPos: int,
  depth: int,
  // One-shot hint from a caller that knows how many characters of fixed content
  // will follow a list's closing bracket on the same line. `fmtPrintCommaList`
  // folds it into its width check and resets it. Zero means "no known tail".
  nextListTail: int,
  // True while trial-rendering the sole item of an ancestor
  // `fmtPrintCommaList`/`fmtPrintFlatList` that already committed to keeping
  // it flat regardless of overflow (the `len(items) == 1` rule) — see
  // `fmtPrintBinaryChain`'s use of it (`#2894`).
  speculativeFlat: bool,
  // True while rendering `fmtPrintBinaryChain`'s nested-comma-list trial
  // (`fmtTryChainNestedWrap`, fmtwrap.bit, #4367). That trial exists to find
  // a bracketed-list break INSTEAD of an operator break, so a chain nested
  // inside it must render flat and let the trial's own per-line width check
  // judge the result -- letting it break at an operator of its own just
  // moves the defect one level down.
  chainFlatOnly: bool,
  // How many bracketed comma lists have broken INTO THE OUTPUT since that
  // trial started (`fmtNoteChainListBreak`, fmtwrap.bit; a break inside a
  // trial that was then rejected is put back by `fmtTrialReject`, #4752).
  // The trial accepts at most one: past that the chain is simply too long
  // for a bracketed break to rescue, and one operand per line reads better
  // than two calls exploded mid-line.
  chainListBreaks: int,
  // 0-based output line counter, advanced once per `fmtNewline` — the
  // adjacency signal `fmtComputeAlignCols` (fmtalign.bit) uses to tell a run
  // of trailing comments apart from two that merely happen to be nearby.
  outLine: int,
  // Every same-line trailing `//` comment recorded so far, in emission
  // (= ascending buffer offset) order — see `fmtGap`'s `sameLine` branch
  // below. `formatSource` feeds the finished list to `fmtApplyAlignment`
  // once the whole file is printed (#3673): alignment is a post-pass over
  // the buffer, not a change to this streaming printer's control flow.
  trailAligns: []TrailAlign,
  // One-shot hint from the Tag.FuncDecl case (fmtdispatch.bit) to the
  // Tag.Receiver case it is about to call into via `fmtPrintNode`: the
  // receiver-derived generic params (#3767) an explicit receiver clause's
  // type lost when `parseFuncDecl` folded them into the func_decl's merged
  // generics kid instead of attaching them to the receiver's own type node.
  // Set right before printing the receiver, consumed and cleared inside the
  // Tag.Receiver case — the same producer/consumer shape as `nextListTail`.
  // Empty means "no receiver-derived generics to reattach".
  pendingReceiverGenerics: []int,
}

// The last '\n' in `s`, or -1 if none.
fn fmtLastNl(s: string): int {
  let i = len(s) - 1
  while (i >= 0) {
    if (s[i] == '\n') {
      return i
    }
    i = i - 1
  }
  return -1
}

// Whether `s` contains a '\n'.
fn fmtHasNl(s: string): bool {
  let i = 0
  while (i < len(s)) {
    if (s[i] == '\n') {
      return true
    }
    i = i + 1
  }
  return false
}

// Appends every byte of `s` to the buffer `p.out` backs (see the `Printer.out`
// doc comment): amortized O(1) per byte via `append`'s in-place growth.
fn fmtAppendStr(p: Printer, s: string) {
  let i = 0
  while (i < len(s)) {
    p.out = append(p.out, s[i])
    i = i + 1
  }
}

// Appends `text`, writing the pending indent lazily on the first real content
// of a line and tracking the output column.
fn fmtRaw(p: Printer, text: string) {
  if (len(text) == 0) {
    return
  }
  if (p.bol) {
    p.bol = false
    let total = p.indent * fmtIndentWidth
    fmtAppendStr(p, repeatStr(" ", total))
    p.col = total
  }
  fmtAppendStr(p, text)
  let nl = fmtLastNl(text)
  if (nl >= 0) {
    p.col = len(text) - nl - 1
  } else {
    p.col = p.col + len(text)
  }
}

fn fmtNewline(p: Printer) {
  fmtAppendStr(p, "\n")
  p.col = 0
  p.bol = true
  p.outLine = p.outLine + 1
}

fn fmtHasCommentBefore(p: Printer, end: int): bool {
  return p.ci < len(p.comments) && p.comments[p.ci].start < end
}

// Flushes every comment starting before `nextStart` (trailing on the current
// line if contiguous, else on its own line — with one blank preserved when
// `allowBlank`), then leaves the cursor on a fresh line.
fn fmtGap(p: Printer, nextStart: int, allowBlank: bool) {
  while (p.ci < len(p.comments) && p.comments[p.ci].start < nextStart) {
    let c = p.comments[p.ci]
    let sameLine = !p.bol && newlinesBetween(p.source, p.srcPos, c.start) == 0
    if (sameLine) {
      // Record a line comment's own column so a later post-pass
      // (fmtalign.bit's fmtApplyAlignment, called once from formatSource)
      // can widen this single space into shared-column padding if this
      // line joins a run of others like it. A same-line block comment
      // (`isLine == false`) does not force a newline and code may continue
      // after it on the same output line, so it is never a trailing-comment
      // table candidate and is left exactly as before: one space, no
      // alignment.
      if (c.isLine) {
        p.trailAligns = append(p.trailAligns, TrailAlign{ pos: len(p.out), width: p.col, line: p.outLine })
      }
      fmtRaw(p, " ")
    } else {
      if (!p.bol) {
        fmtNewline(p)
      }
      if (allowBlank && newlinesBetween(p.source, p.srcPos, c.start) >= 2) {
        fmtNewline(p)
      }
    }
    fmtRaw(p, p.source[c.start:c.end])
    p.srcPos = c.end
    p.ci = p.ci + 1
    if (c.isLine) {
      fmtNewline(p)
    }
  }
  if (!p.bol) {
    fmtNewline(p)
  }
  if (allowBlank && newlinesBetween(p.source, p.srcPos, nextStart) >= 2) {
    fmtNewline(p)
  }
}

// Renders `idx` flat into a fresh buffer without touching real output, so a
// caller can measure width before deciding how something earlier wraps. This is
// the only render of `idx` — comments and `srcPos` advance for real — so the
// caller must reuse the returned text as its actual output.
fn fmtRenderFlat(p: Printer, idx: int): string {
  let colBefore = p.col
  let bolBefore = p.bol
  let savedOut = p.out
  // Unlike the swapped `p.out`, any comment rendered into this scratch
  // buffer is NOT re-replayed through fmtGap once the caller copies `text`
  // into the real output (see the doc comment above) -- so a trailAligns
  // entry recorded in here would carry a byte offset into a buffer that no
  // longer exists once `p.out` is restored below. Drop any such entries
  // rather than risk applying alignment padding at a stale, wrong offset:
  // the comment's TEXT still lands correctly either way, it just keeps its
  // default single space, same as the other comment kinds this feature
  // deliberately leaves untouched.
  let alignBefore = len(p.trailAligns)
  p.out = []byte(0)
  // Force bol false for the trial's own duration so no lazy indent bakes
  // into the captured text -- fmtRaw's lazy-indent write fires the same way
  // in this scratch render as it does for real (mirrors fmtInlineFits above).
  // Unlike fmtwrap.bit's trial sites (#2897), fmtRenderFlat never replays
  // `text` through fmtRaw itself -- it hands the string back to the caller,
  // which always writes further real content (e.g. the params list) before
  // eventually emitting it via its own fmtRaw calls -- so there is no risk
  // of the double-indent #2897's fix guards against there. Restoring the
  // true bol afterward still matters: it is live Printer state, and leaving
  // it forced false would wrongly skip the caller's own next lazy-indent
  // write if this function is ever invoked at bol == true.
  p.bol = false
  fmtPrintNode(p, idx)
  let text = string(p.out)
  p.out = savedOut
  p.col = colBefore
  p.bol = bolBefore
  p.trailAligns = p.trailAligns[0:alignBefore]
  return text
}

// ---- public API ------------------------------------------------------------

// Canonical source on success, or rendered diagnostics when `src` does not parse
// (`failed` true) — fmt never guesses at malformed input.
class FmtResult {
  text: string,
  failed: bool,
}

// Formats `src` to Bit's one canonical style. On a parse error, `failed` is true
// and `text` holds the rendered diagnostics, matching the seed's `format`.
fn formatSource(path: string, src: string): FmtResult {
  src = stripBom(src)
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  let tree = parseSourceD(src, f, d)
  if (hasErrors(d)) {
    return FmtResult{ text: renderDiags(d), failed: true }
  }
  let comments = collectComments(src)
  let p = Printer{
    source: src,
    tree: tree,
    out: []byte(0),
    comments: comments,
    ci: 0,
    indent: 0,
    col: 0,
    bol: true,
    srcPos: 0,
    depth: 0,
    nextListTail: 0,
    speculativeFlat: false,
    chainFlatOnly: false,
    chainListBreaks: 0,
    outLine: 0,
    trailAligns: []TrailAlign(0),
    pendingReceiverGenerics: []int(0),
  }
  fmtPrintNode(p, tree.root)
  // Post-pass (#3673, fmtalign.bit): widen each recorded trailing comment's
  // single space into shared-column padding wherever it joined a run of
  // others like it. Done once, on the finished buffer, rather than woven
  // into the streaming printer above — a run's width is only known once
  // every member of it has been printed.
  let aligned = fmtApplyAlignment(p.out, p.trailAligns)
  return FmtResult{ text: string(aligned), failed: false }
}
