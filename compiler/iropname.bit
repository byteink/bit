// compiler/iropname.bit — the `Op` tag-name tables the IR dumper prints.
//
// Split out of ir.bit (#4729) under the 800-line file cap: canonical
// formatting (#4725) took ir.bit from 613 to 789 lines, and paying down
// `opName`'s E0201/E0204 debt -- one 45-branch chain becomes eight bounded
// tables -- took it past 800. Same module, so nothing here is imported and
// every caller is unchanged.
//
// A PURE MOVE plus that split: no name, no row and no answer changes.

// The tag-name spelling the seed's `@tagName(op)` yields (used for the bin/un/
// convert/compare op mnemonics in the dump). Only the ops printed via opName
// need a row; the rest are literal in dumpInst.
//
// #4729 PAID THIS DOWN rather than listing it. Canonical formatting (#4725)
// took the single chain to 138 lines, past E0201's 80-line cap, and it already
// carried a complexity-debt baseline of 49. A name lookup has no business
// holding 45 decision points, so the chain is eight tables of at most nine rows
// each, all of them under both caps, and `compiler/ir.bit opName 49` is gone
// from tools/build/complexity-debt.txt. An unmatched op answers "" and the next
// table is tried; the chain ends at `opNameAtomicRmw`, which was split out
// earlier for the same reason.
fn opName(op: Op): string {
  let s0 = opNameIntArith(op)
  if (s0 != "") {
    return s0
  }
  let s1 = opNameFloatArith(op)
  if (s1 != "") {
    return s1
  }
  let s2 = opNameBitwise(op)
  if (s2 != "") {
    return s2
  }
  let s3 = opNameUnary(op)
  if (s3 != "") {
    return s3
  }
  let s4 = opNameRound(op)
  if (s4 != "") {
    return s4
  }
  let s5 = opNameICmpSigned(op)
  if (s5 != "") {
    return s5
  }
  let s6 = opNameICmpUnsigned(op)
  if (s6 != "") {
    return s6
  }
  let s7 = opNameFCmp(op)
  if (s7 != "") {
    return s7
  }
  return opNameAtomicRmw(op)
}

// the integer arithmetic ops, or "" when `op` is none of them.
fn opNameIntArith(op: Op): string {
  if (op == Op.Add) {
    return "add"
  }
  if (op == Op.Sub) {
    return "sub"
  }
  if (op == Op.Mul) {
    return "mul"
  }
  if (op == Op.SMulHi) {
    return "smulhi"
  }
  if (op == Op.UMulHi) {
    return "umulhi"
  }
  if (op == Op.SDiv) {
    return "sdiv"
  }
  if (op == Op.UDiv) {
    return "udiv"
  }
  if (op == Op.SRem) {
    return "srem"
  }
  if (op == Op.URem) {
    return "urem"
  }
  return ""
}

// the float arithmetic ops, or "" when `op` is none of them.
fn opNameFloatArith(op: Op): string {
  if (op == Op.FAdd) {
    return "fadd"
  }
  if (op == Op.FSub) {
    return "fsub"
  }
  if (op == Op.FMul) {
    return "fmul"
  }
  if (op == Op.FDiv) {
    return "fdiv"
  }
  return ""
}

// the bitwise and shift ops, or "" when `op` is none of them.
fn opNameBitwise(op: Op): string {
  if (op == Op.BAnd) {
    return "band"
  }
  if (op == Op.BOr) {
    return "bor"
  }
  if (op == Op.BXor) {
    return "bxor"
  }
  if (op == Op.Shl) {
    return "shl"
  }
  if (op == Op.AShr) {
    return "ashr"
  }
  if (op == Op.LShr) {
    return "lshr"
  }
  return ""
}

// the one-operand ops `Neg`..`Bitcast`, or "" when `op` is none of them.
fn opNameUnary(op: Op): string {
  if (op == Op.Neg) {
    return "neg"
  }
  if (op == Op.FNeg) {
    return "fneg"
  }
  if (op == Op.BNot) {
    return "bnot"
  }
  if (op == Op.FSqrt) {
    return "fsqrt"
  }
  if (op == Op.Bitcast) {
    return "bitcast"
  }
  return ""
}

// the float rounding ops and `convert`, or "" when `op` is none of them.
fn opNameRound(op: Op): string {
  if (op == Op.FFloor) {
    return "ffloor"
  }
  if (op == Op.FCeil) {
    return "fceil"
  }
  if (op == Op.FTrunc) {
    return "ftrunc"
  }
  if (op == Op.FRound) {
    return "fround"
  }
  if (op == Op.Convert) {
    return "convert"
  }
  return ""
}

// the equality and SIGNED integer comparisons, or "" when `op` is none of them.
fn opNameICmpSigned(op: Op): string {
  if (op == Op.ICmpEq) {
    return "icmp_eq"
  }
  if (op == Op.ICmpNe) {
    return "icmp_ne"
  }
  if (op == Op.ICmpSlt) {
    return "icmp_slt"
  }
  if (op == Op.ICmpSle) {
    return "icmp_sle"
  }
  if (op == Op.ICmpSgt) {
    return "icmp_sgt"
  }
  if (op == Op.ICmpSge) {
    return "icmp_sge"
  }
  return ""
}

// the UNSIGNED integer comparisons, or "" when `op` is none of them.
fn opNameICmpUnsigned(op: Op): string {
  if (op == Op.ICmpUlt) {
    return "icmp_ult"
  }
  if (op == Op.ICmpUle) {
    return "icmp_ule"
  }
  if (op == Op.ICmpUgt) {
    return "icmp_ugt"
  }
  if (op == Op.ICmpUge) {
    return "icmp_uge"
  }
  return ""
}

// the float comparisons, or "" when `op` is none of them.
fn opNameFCmp(op: Op): string {
  if (op == Op.FCmpEq) {
    return "fcmp_eq"
  }
  if (op == Op.FCmpNe) {
    return "fcmp_ne"
  }
  if (op == Op.FCmpLt) {
    return "fcmp_lt"
  }
  if (op == Op.FCmpLe) {
    return "fcmp_le"
  }
  if (op == Op.FCmpGt) {
    return "fcmp_gt"
  }
  if (op == Op.FCmpGe) {
    return "fcmp_ge"
  }
  return ""
}

// The read-modify-write atomics' tag names, split out of `opName` so that
// function's complexity keeps SHRINKING as ops are added to the enum -- the
// debt baseline in tools/build/complexity-debt.txt only ever comes down.
fn opNameAtomicRmw(op: Op): string {
  if (op == Op.AtomicRmwAdd) {
    return "atomic_rmw_add"
  }
  if (op == Op.AtomicRmwSub) {
    return "atomic_rmw_sub"
  }
  if (op == Op.AtomicRmwAnd) {
    return "atomic_rmw_and"
  }
  if (op == Op.AtomicRmwOr) {
    return "atomic_rmw_or"
  }
  if (op == Op.AtomicRmwXchg) {
    return "atomic_rmw_xchg"
  }
  return "?"
}
