// #7920: definite facts follow reaching branches; lexical blocks only pop
// bindings. The shared transfers live in compiler/relationautoassign.bit.

fn relationAutoWalkBlock(c: Checker, node: int, st: RelationAutoState) {
  let save = len(st.bindings)
  for k of kidsOf(c.tree, node) {
    relationAutoWalk(c, k, st)
  }
  st.bindings = st.bindings[0:save]
}

fn relationAutoWalkScoped(c: Checker, node: int, tag: Tag, st: RelationAutoState): bool {
  if (relationAutoWalkConditional(c, node, tag, st)) {
    return true
  }
  if (tag == Tag.Block) {
    relationAutoWalkBlock(c, node, st)
    return true
  }
  if (tag == Tag.LetDecl) {
    relationAutoWalkLet(c, node, st)
    return true
  }
  if (tag == Tag.MatchStmt) {
    relationAutoWalkMatch(c, node, st)
    return true
  }
  if (tag == Tag.Assign) {
    relationAutoWalkAssign(c, node, st)
    return true
  }
  return false
}

fn relationAutoWalk(c: Checker, node: int, st: RelationAutoState) {
  if (node == 0) {
    return
  }
  let tag = getNode(c.tree, node).tag
  if (lintIsNestedFuncBoundary(tag)) {
    return
  }
  if (relationAutoWalkScoped(c, node, tag, st)) {
    return
  }
  if (tag == Tag.Member) {
    relationAutoCheckMemberRead(c, node, st)
  }
  if (tag == Tag.Call) {
    relationAutoCheckCallArgs(c, node, st)
  }
  if (tag == Tag.ReturnStmt) {
    relationAutoWalkReturn(c, node, st)
  }
  for k of kidsOf(c.tree, node) {
    relationAutoWalk(c, k, st)
  }
}

fn relationAutoWalkIf(c: Checker, node: int, st: RelationAutoState) {
  let k = kidsOf(c.tree, node)
  relationAutoWalk(c, k[0], st)
  let entry = st.assigned
  relationAutoWalk(c, k[1], st)
  let left = st.assigned
  st.assigned = entry
  relationAutoWalk(c, k[2], st)
  if (vDiverges(c, k[1], false)) {
    return
  }
  if (vDiverges(c, k[2], false)) {
    st.assigned = left
    return
  }
  st.assigned = relationAutoFactsMeet(left, st.assigned)
}

fn relationAutoWalkLoop(c: Checker, node: int, st: RelationAutoState) {
  let tag = getNode(c.tree, node).tag
  let k = kidsOf(c.tree, node)
  if (tag == Tag.ForC) {
    relationAutoWalk(c, k[0], st)
  }
  let entry = relationAutoLoopFacts(c, node, st.assigned)
  st.assigned = entry
  if (tag == Tag.ForOf) {
    relationAutoWalkForOf(c, node, st)
  } else if (tag == Tag.ForC) {
    relationAutoWalk(c, k[1], st)
    relationAutoWalk(c, k[3], st)
    relationAutoWalk(c, k[2], st)
  } else {
    for child of k {
      relationAutoWalk(c, child, st)
    }
  }
  st.assigned = entry
}

fn relationAutoWalkCases(c: Checker, node: int, st: RelationAutoState) {
  let tag = getNode(c.tree, node).tag
  let clauses = kidsOf(c.tree, node)
  let hasDefault = tag == Tag.SelectStmt
  if (tag == Tag.SwitchStmt) {
    relationAutoWalk(c, clauses[0], st)
    clauses = kidsOf(c.tree, clauses[1])
  }
  let entry = st.assigned
  let joined = []RelationAutoErrLoaded(0)
  let seen = false
  for clause of clauses {
    st.assigned = entry
    relationAutoWalk(c, clause, st)
    let ck = kidsOf(c.tree, clause)
    let ct = getNode(c.tree, clause).tag
    if (ct == Tag.SwitchDefault || ct == Tag.CommDefault) {
      hasDefault = true
    }
    let body = ck[len(ck) - 1]
    if (!vBlockDiverges(c, body, false)) {
      joined = relationAutoJoinCaseFacts(joined, st.assigned, seen)
      seen = true
    }
  }
  if (!hasDefault) {
    joined = relationAutoJoinCaseFacts(joined, entry, seen)
  }
  st.assigned = joined
}

fn relationAutoWalkConditional(c: Checker, node: int, tag: Tag, st: RelationAutoState): bool {
  if (tag == Tag.IfStmt) {
    relationAutoWalkIf(c, node, st)
    return true
  }
  if (relationAutoIsLoop(tag)) {
    relationAutoWalkLoop(c, node, st)
    return true
  }
  if (tag == Tag.SwitchStmt || tag == Tag.SelectStmt) {
    relationAutoWalkCases(c, node, st)
    return true
  }
  if (tag == Tag.DeferStmt || tag == Tag.CatchBind) {
    let entry = st.assigned
    for child of kidsOf(c.tree, node) {
      relationAutoWalk(c, child, st)
    }
    st.assigned = relationAutoFactsMeet(entry, st.assigned)
    return true
  }
  return false
}
