// bit lsp (#1547) — the dependency-free substrate: LSP position math and URI
// mapping. Sorts first among the `lsp*.bit` siblings
// so the server and query files that lean on it are lowered after it. Every
// function here is pure (no filesystem, no checker), which is why they are the
// layer the selfcheck (lspcheck.bit) mutation-tests directly.
//
// Positions are LSP's: 0-based line, and a CHARACTER measured in UTF-16 code
// units (a codepoint above U+FFFF counts as 2), not bytes. The seed derives the
// unit count by decoding each codepoint; the lead byte alone suffices — a 4-byte
// UTF-8 sequence is exactly the U+10000.. range that costs two UTF-16 units, so
// no decode is needed.

// A 0-based line and UTF-16 character offset within a line.
class LspPos {
  line: int,
  character: int,
}

// A half-open [start, end) range in LSP position space.
class LspRange {
  start: LspPos,
  end: LspPos,
}

// The UTF-8 sequence length implied by lead byte `b` (1..4). A continuation or
// invalid lead byte is treated as length 1, matching the seed's `catch 1`.
fn lspUtf8SeqLen(b: u8): int {
  let c = int(b)
  if (c < 0x80) {
    return 1
  }
  if (c >= 0xF0) {
    return 4
  }
  if (c >= 0xE0) {
    return 3
  }
  if (c >= 0xC0) {
    return 2
  }
  return 1
}

// Byte offset -> LSP position. Counts newlines for the line, then UTF-16 units
// from the line start to `offset`. A 4-byte sequence contributes 2 units, every
// other sequence 1 — the seed's `cp > 0xFFFF ? 2 : 1` without decoding.
fn byteToLspPos(source: string, offset: int): LspPos {
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset && i < len(source)) {
    if (source[i] == u8('\n')) {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  let character = 0
  let j = lineStart
  while (j < offset && j < len(source)) {
    let seq = lspUtf8SeqLen(source[j])
    if (j + seq > offset) {
      seq = offset - j
    }
    if (seq == 4) {
      character = character + 2
    } else {
      character = character + 1
    }
    j = j + seq
  }
  return LspPos{ line: line, character: character }
}

// LSP position -> byte offset. Walks to the requested line, then consumes
// UTF-16 units up to `character` (or the line's newline, whichever first).
fn lspPosToByte(source: string, pos: LspPos): int {
  let line = 0
  let i = 0
  while (line < pos.line && i < len(source)) {
    if (source[i] == u8('\n')) {
      line = line + 1
    }
    i = i + 1
  }
  let character = 0
  while (character < pos.character && i < len(source) && source[i] != u8('\n')) {
    let seq = lspUtf8SeqLen(source[i])
    if (i + seq > len(source)) {
      seq = len(source) - i
    }
    if (seq == 4) {
      character = character + 2
    } else {
      character = character + 1
    }
    i = i + seq
  }
  return i
}

// A byte range [start, end) rendered as an LSP range over `source`.
fn lspSpanToRange(source: string, start: int, end: int): LspRange {
  return LspRange{ start: byteToLspPos(source, start), end: byteToLspPos(source, end) }
}

// The JSON object text for an LSP range: {"start":{...},"end":{...}}.
fn lspRangeJson(r: LspRange): string {
  return "{\"start\":{\"line\":${r.start.line},\"character\":${r.start.character}}," +
    "\"end\":{\"line\":${r.end.line},\"character\":${r.end.character}}}"
}

// ---- URI <-> filesystem path ----------------------------------------------

// True for a URI byte that needs no percent-encoding: alphanumerics plus the
// unreserved set and `/` (a path separator, kept literal). Matches the seed's
// isUnreservedUriByte.
fn lspUnreservedUriByte(c: u8): bool {
  if ((c >= u8('a') && c <= u8('z')) || (c >= u8('A') && c <= u8('Z')) ||
      (c >= u8('0') && c <= u8('9'))) {
    return true
  }
  return c == u8('-') || c == u8('.') || c == u8('_') || c == u8('~') || c == u8('/')
}

// Percent-decodes `s` (`%XX` -> the byte). A stray `%` or a non-hex digit after
// it is passed through literally, matching the seed's tolerant percentDecode.
fn lspPercentDecode(s: string): string {
  let out = []u8(0)
  let i = 0
  while (i < len(s)) {
    if (s[i] == u8('%') && i + 2 < len(s)) {
      let hi = hexDigitVal(s[i + 1])
      let lo = hexDigitVal(s[i + 2])
      if (hi >= 0 && lo >= 0) {
        out = append(out, u8((hi << 4) | lo))
        i = i + 3
        continue
      }
    }
    out = append(out, s[i])
    i = i + 1
  }
  return string(out)
}

// A `file://` URI -> its filesystem path, or "" for any other scheme (the seed
// errors; "" is the caller's not-a-file sentinel).
fn lspUriToPath(uri: string): string {
  let prefix = "file://"
  if (len(uri) < len(prefix) || uri[0:len(prefix)] != prefix) {
    return ""
  }
  return lspPercentDecode(uri[len(prefix):len(uri)])
}

// A filesystem path -> its `file://` URI, percent-encoding every reserved byte
// (uppercase hex), matching the seed's pathToUri byte for byte.
fn lspPathToUri(path: string): string {
  let hex = "0123456789ABCDEF"
  let out = "file://"
  let i = 0
  while (i < len(path)) {
    let c = path[i]
    if (lspUnreservedUriByte(c)) {
      out = out + path[i:i + 1]
    } else {
      out = out + "%" + hex[(int(c) >> 4) & 15:((int(c) >> 4) & 15) + 1] +
        hex[int(c) & 15:(int(c) & 15) + 1]
    }
    i = i + 1
  }
  return out
}
