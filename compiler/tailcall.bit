// #6676: tail calls out of a frameless function. A call whose result this
// function returns at once (`v = call f(args); ret v`) needs no return address
// here: emitted as `b f` it leaves for good, and `f` returns straight to this
// function's caller. A function whose ONLY calls are of that shape therefore
// needs no frame record, and stays frameless exactly as a #2929 leaf does.
// schedCurrentScratch (runtime/sched/scratch.bit) is the case: one cold call
// on its last line used to put a frame on every hit path.
//
// Three refusals, each on the whole function:
//   - not @nosplit: a tail call drops this function from a panic backtrace
//     (runtime/root/backtrace.bit), which only a runtime-internal @nosplit
//     function may give up.
//   - @naked: the body owns its frame, so there is nothing to decide.
//   - an `asm` block naming x29: before a prologue x29 is the CALLER's, so a
//     block reading it as this function's own frame record
//     (runtime/sched/boundary.bit's boundaryArm) is only correct with a frame.
//     An sp read stays sound: with no frame at all, sp is the same word
//     everywhere in the body, as in any frameless leaf.
// Whether a planned tail call is EMITTED as one is the frameless decision
// (`tailCallsKept`): a function that keeps a frame for any other reason
// emits every call as an ordinary `bl`.

// Per instruction, whether the call there qualifies as an arm64 tail call.
fn a64TailCallPlan(module: IrModule, f: IrFunc): []bool {
  let out = []bool(len(f.instrs))
  if (!f.isNosplit || f.isNaked || asmNamesX29(module, f)) {
    return out
  }
  let i = 0
  while (i + 1 < len(f.instrs)) {
    out[i] = isTailCallShape(module.ctx, f, i) &&
      stackArgSlots(module.ctx, f, f.instrs[i].args, 0, 0) == 0
    i = i + 1
  }
  return out
}

// The IR shape of a tail call, shared by every backend: a direct call to a
// real symbol, immediately returned, one integer word that needs no
// normalising at the boundary (bindCallResult's `bool` fix-up would be lost).
fn isTailCallShape(ctx: TypeContext, f: IrFunc, i: int): bool {
  let ins = f.instrs[i]
  if (ins.op != Op.Call || ins.name == gcThreadTokenSymbol()) {
    return false
  }
  let ret = f.instrs[i + 1]
  if (ret.op != Op.Ret || len(ret.args) != 1 || ret.args[0] != i) {
    return false
  }
  return regClassOf(ctx, ins.ty) == RegClass.Int && !isBoolTy(ctx, ins.ty)
}

// Conservative on purpose: a word counts when ANY of its 5-bit register
// fields (Rd/Rt, Rn, Rt2/Ra, Rm/Rs) holds 29, whatever the instruction, and
// so does a declared `input`, `result` or `clobber` of x29. A false positive
// only keeps a frame.
fn asmNamesX29(module: IrModule, f: IrFunc): bool {
  for ins of f.instrs {
    if (ins.op == Op.Asm && asmBlockNamesX29(module.asmBlocks[ins.ival])) {
      return true
    }
  }
  return false
}

fn asmBlockNamesX29(blk: AsmBlock): bool {
  for w of blk.arm64Words {
    for sh of [0, 5, 10, 16] {
      if (((w >> sh) & 31) == 29) {
        return true
      }
    }
  }
  if (blk.hasResult && blk.resultArm64 == 29) {
    return true
  }
  return posInList(blk.inArm64, 29) || posInList(blk.clobArm64, 29)
}

// Whether any safepoint in `points` is NOT a planned tail call: a call that
// returns here, or a back-edge poll, either of which needs the frame record.
fn hasFramedSafepoint(points: []int, tails: []bool): bool {
  for p of points {
    if (!tails[p]) {
      return true
    }
  }
  return false
}

// The tail calls a function emits: all of its planned ones when it is
// frameless, none otherwise.
fn tailCallsKept(tails: []bool, frameless: bool): []bool {
  if (frameless) {
    return tails
  }
  return []bool(0)
}

// Whether instruction `i` is a call `fr`'s function emits as a tail call.
fn isTailCall(fr: FrameInfo, i: int): bool {
  return i >= 0 && i < len(fr.tailCalls) && fr.tailCalls[i]
}

// #7241: the x86-64 plan, on the same three refusals with rbp for x29. The
// arguments must all travel in registers under `cc` (SysV: six int, eight
// float; Win64: four positions), so the `jmp` leaves rsp exactly where it was
// at entry and the callee finds the caller's return address, and on Win64 the
// caller's 32-byte home area, where a direct call from that caller puts them.
fn xTailCallPlan(module: IrModule, f: IrFunc, cc: XCallConv): []bool {
  let out = []bool(len(f.instrs))
  if (!f.isNosplit || f.isNaked || asmNamesRbp(module, f)) {
    return out
  }
  let i = 0
  while (i + 1 < len(f.instrs)) {
    out[i] = isTailCallShape(module.ctx, f, i) &&
      xArgsAllInRegs(module.ctx, f, cc, f.instrs[i].args)
    i = i + 1
  }
  return out
}

// Whether every one of `args` gets an argument register (xArgReg) under `cc`.
fn xArgsAllInRegs(ctx: TypeContext, f: IrFunc, cc: XCallConv, args: []int): bool {
  let ints = 0
  let floats = 0
  let i = 0
  while (i < len(args)) {
    let rc = regClassOf(ctx, f.instrs[args[i]].ty)
    let ord = ints
    if (rc == RegClass.Float) {
      ord = floats
      floats = floats + 1
    } else {
      ints = ints + 1
    }
    if (xArgReg(cc, rc, i, ord) < 0) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether any `asm` block in `f` may name rbp. The x64 payload is raw bytes
// with no decoder here, so this is deliberately loose: a byte whose ModRM/SIB
// field (bits 0-2 or 3-5) is 5 may name rbp (or r13, or a disp32 form), and a
// VEX/EVEX/XOP prefix (0xC4, 0xC5, 0x62, 0x8F) or `enter`/`leave` (0xC8,
// 0xC9) is counted outright, as is a declared `input`, `result` or `clobber`
// of rbp. A false positive only keeps a frame.
fn asmNamesRbp(module: IrModule, f: IrFunc): bool {
  for ins of f.instrs {
    if (ins.op == Op.Asm && asmBlockNamesRbp(module.asmBlocks[ins.ival])) {
      return true
    }
  }
  return false
}

fn asmBlockNamesRbp(blk: AsmBlock): bool {
  let rbp = xRegNum(XReg64.Rbp)
  for b of blk.x64Bytes {
    if ((b & 7) == rbp ||
      ((b >> 3) & 7) == rbp ||
      posInList([0xC4, 0xC5, 0x62, 0x8F, 0xC8, 0xC9], b)) {
      return true
    }
  }
  if (blk.hasResult && blk.resultX64 == rbp) {
    return true
  }
  return posInList(blk.inX64, rbp) || posInList(blk.clobX64, rbp)
}
