// compiler/lowerexpr.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.
//
// The tuple ABI (layout/build/read), `let` destructuring and the two-result
// binder forms were split out again into lowertuple.bit (#5432, this file hit
// the 800-line E0200 ceiling); same module, so still no imports or call-site
// changes.

// Emits a `string_concat` runtime call over two already-lowered `string`
// values. `string` `+` is concatenation, never a raw pointer `add` (the two
// operands are boxed string headers, not addressable words) — the ONE place
// that decides so, shared by ordinary `a + b` (the Binary arm of `lowerExprH`
// below) and compound `a += b` (`lowerAssign`, compiler/lowerflow.bit). Before
// #4438 the compound-assign path had no such interception and fell through to
// a plain `binOpFor`/`Op.Add` over the two pointers instead.
fn emitStringConcat(fc: FnCtx, ty: int, l: int, r: int): int {
  let sc = mkInstr(Op.RtCall, ty)
  sc.name = "string_concat"
  sc.args = [l, r]
  return emitRtCall(fc, sc)
}

// The compound-assign half of `lowerAssign` (compiler/lowerflow.bit) —
// `+= -= *= /= %= &= |= ^= <<= >>=` (SPEC §13.1): resolve the target once,
// read-modify-write it. Covers every lvalue shape — local, module global,
// class field, slice/array index, map entry. Split out (#4444) to keep
// `lowerAssign`'s own complexity (E0204) from counting these branches too:
// #4438's string interception below pushed the combined function past its
// recorded baseline in tools/build/complexity-debt.txt.
fn lowerCompoundAssign(fc: FnCtx, node: int, opKind: int, lhsItem: int, rhsItem: int) {
  let base = compoundBase(opKind)
  if (base == -1) {
    fcFail(fc, getNode(fc.c.tree, node).span, "an unrecognized compound-assignment operator")
    return
  }
  let lv = resolveLvalue(fc, lhsItem)
  if (fc.failed) {
    return
  }
  let cur = readLvalue(fc, lv, getNode(fc.c.tree, lhsItem).span)
  let ty = nodeType(fc, lhsItem)
  let rhs = lowerExprH(fc, rhsItem, ty)
  if (fc.failed) {
    return
  }
  // `s += "x"` (SPEC §13.1): string `+` concatenates via the runtime, never a
  // raw `add` over the two boxed string headers — the same interception
  // `lowerExprH`'s Binary arm applies to ordinary `+`, reached through the ONE
  // shared emitter (`emitStringConcat` above) so the two paths cannot diverge
  // again (#4438). `vCompoundAssign` (validateoperator.bit) has already rejected
  // every other compound operator on a string lvalue, so `base` is `Plus`
  // whenever `ty` is `string` here.
  if (base == int(Kind.Plus) &&
    fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    fc.c.ctx.types[ty].prim == 11) {
    writeLvalue(fc, lv, emitStringConcat(fc, ty, cur, rhs))
    return
  }
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fcFail(
      fc,
      getNode(fc.c.tree, lhsItem).span,
      "an unsupported compound-assignment operator for this operand type",
    )
    return
  }
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = rhs
  writeLvalue(fc, lv, builderEmit(fc.b, ins))
}

// Whether a type id is a concrete numeric prim (i8..f64), so an untyped literal
// can be materialized at that context type instead of its default.
fn isNumericPrim(fc: FnCtx, ty: int): bool {
  return ty != 0 && fc.c.ctx.types[ty].kind == TypeKind.Prim && fc.c.ctx.types[ty].prim <= 9
}

// Whether a type id is `f32`/`f64` — the context types an untyped constant
// EXPRESSION may adopt (see the Binary arm of `lowerExprH`).
fn isFloatPrimType(fc: FnCtx, ty: int): bool {
  return ty != 0 &&
    fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
}

// The register code (`check.asmRegX64`/`asmRegArm64`) for one `asm` operand's
// register-name ident; an unknown name (validator's job, #1374) falls back to 0.
fn asmRegCode(fc: FnCtx, ident: int, isArm64: bool): int {
  let sp = getNode(fc.c.tree, ident).span
  let name = fc.c.source[sp.start:sp.end]
  let code = -1
  if (isArm64) {
    code = asmRegArm64(name)
  } else {
    code = asmRegX64(name)
  }
  if (code < 0) {
    return 0
  }
  return code
}

// The pre-encoded byte/word values of an `asm_code` block (empty if none).
fn asmCodeVals(fc: FnCtx, code: int): []int {
  let out = []int(0)
  if (code == 0) {
    return out
  }
  let lits = kidsOf(fc.c.tree, code)
  let i = 0
  while (i < len(lits)) {
    let sp = getNode(fc.c.tree, lits[i]).span
    out = append(out, parseIntText(fc.c.source[sp.start:sp.end]))
    i = i + 1
  }
  return out
}

// The register codes of an `asm_clobber` list (empty if none).
fn asmRegVals(fc: FnCtx, list: int, isArm64: bool): []int {
  let out = []int(0)
  if (list == 0) {
    return out
  }
  let regs = kidsOf(fc.c.tree, list)
  let i = 0
  while (i < len(regs)) {
    out = append(out, asmRegCode(fc, regs[i], isArm64))
    i = i + 1
  }
  return out
}

// Lowers an `asm` block (§11.6) into an `IrModule.asmBlocks` entry plus the
// `Op.Asm` that references it. Both target sub-blocks are pooled; the backend
// reads only its own arch's. Result type is the checker's type for `result`, or
// void when there is none.
fn lowerAsm(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node) // [x64_code, arm64_code, result?, clob_x64, clob_arm64, input...]
  let inX64 = []int(0)
  let inArm64 = []int(0)
  let inVals = []int(0)
  let i = 5
  while (i < len(k)) {
    let ik = kidsOf(fc.c.tree, k[i]) // [arm64_reg, x64_reg, value]
    inArm64 = append(inArm64, asmRegCode(fc, ik[0], true))
    inX64 = append(inX64, asmRegCode(fc, ik[1], false))
    inVals = append(inVals, lowerExpr(fc, ik[2]))
    i = i + 1
  }
  let hasResult = false
  let resultX64 = 0
  let resultArm64 = 0
  let ty = fc.c.ctx.voidId
  if (k[2] != 0) {
    let rk = kidsOf(fc.c.tree, k[2]) // [arm64_reg, x64_reg, type]
    hasResult = true
    resultArm64 = asmRegCode(fc, rk[0], true)
    resultX64 = asmRegCode(fc, rk[1], false)
    ty = nodeType(fc, node)
  }
  let blk = AsmBlock{
    x64Bytes = asmCodeVals(fc, k[0]),
    arm64Words = asmCodeVals(fc, k[1]),
    hasResult = hasResult,
    resultX64 = resultX64,
    resultArm64 = resultArm64,
    inX64 = inX64,
    inArm64 = inArm64,
    clobX64 = asmRegVals(fc, k[3], false),
    clobArm64 = asmRegVals(fc, k[4], true),
  }
  fc.lowerer.asmBlocks = append(fc.lowerer.asmBlocks, blk)
  let blockIdx = len(fc.lowerer.asmBlocks) - 1
  let ins = mkInstr(Op.Asm, ty)
  ins.ival = blockIdx
  ins.args = inVals
  if (hasResult) {
    ins.ival2 = 1
  }
  return builderEmit(fc.b, ins)
}

// Lowers an expression with no type context.
fn lowerExpr(fc: FnCtx, node: int): int {
  return lowerExprH(fc, node, 0)
}

// Is `ty` the §5.3 `decimal` prim, asked of a lowering context. The predicate
// itself is `isDecimalPrim` (lowerdecimal.bit); this is the `FnCtx` spelling
// every site in this file wants.
fn lowerIsDecimal(fc: FnCtx, ty: int): bool {
  return isDecimalPrim(fc.c.ctx, ty)
}

// Whether this expression is a decimal one, judged on its OWN type and on the
// type it is being placed into — only the second sees `let d: decimal = 3`,
// where the expression is an untyped int constant and `decimal` is the hint.
fn lowerIsDecimalExpr(fc: FnCtx, node: int, hint: int): bool {
  return lowerIsDecimal(fc, hint) || lowerIsDecimal(fc, nodeType(fc, node))
}

// Lowers an expression to its SSA value id under an optional expected type
// `hint` (0 = none), which types an otherwise-untyped numeric literal — the
// seed's lowerExprH. Trips `failed` (returning 0) for unhandled constructs.
fn lowerExprH(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  // #3982: a decimal value is TWO words and every SSA value here is one
  // register, so a decimal expression never takes the ordinary path — it is
  // lowered against the list `lowerDecimalExpr` (lowerdecimal.bit) owns, and
  // any position not on that list still fails with a span rather than
  // truncating to one register at exit 0.
  if (lowerIsDecimalExpr(fc, node, hint)) {
    return lowerDecimalExpr(fc, node, hint, n)
  }
  return lowerExprByTag(fc, node, hint, n)
}

// Dispatches on the node's tag; the body of the seed's lowerExprH.
fn lowerExprByTag(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  if (tag == Tag.StrInterp) {
    return lowerStrInterp(fc, node)
  }
  if (tag == Tag.IntLit) {
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ival = parseIntText(fc.c.source[n.span.start:n.span.end])
    // An untyped int constant adapting to an f32/f64 context (SPEC §15.4 — `let
    // x: f64 = 1`, `h(1)` where `h(x: f64)`, a class field, an array element)
    // must materialize the FLOAT VALUE, not the integer bit pattern. `isNumericPrim`
    // deliberately admits f32/f64 too (it only gates INTEGER width selection), so
    // `ty` above can already be a float here — and emitting `const_int <f64> 1`
    // stored the raw bits 0x1 into an f64 slot: `${x}` printed a denormal near
    // zero (or crashed a class/array store outright), `x == 1` compared two
    // int-shaped operands and was wrongly true, and `x == 1.0` compared those
    // bits against the real double and was false (#2429).
    if (isFloatPrimType(fc, ty)) {
      let fins = mkInstr(Op.ConstFloat, ty)
      fins.fval = f64(ival)
      return builderEmit(fc.b, fins)
    }
    let ins = mkInstr(Op.ConstInt, ty)
    ins.ival = ival
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.BoolLit) {
    let ins = mkInstr(Op.ConstBool, primType(fc.c.ctx, 10))
    ins.bval = fc.c.source[n.span.start:n.span.end] == "true"
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.RuneLit) {
    // A rune's code point is a `const_int`, materialized at the context width
    // (`p[0] == '/'` over u8 -> const_int u8 47), like an int literal.
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ival = parseRuneText(fc.c.source[n.span.start:n.span.end])
    // Same float-hint hazard as IntLit above (#2429): `vRepresentable` accepts
    // any int/rune constant into a float destination unconditionally, so
    // `let x: f64 = 'A'` type-checks and must adopt the FLOAT value, not the
    // code point's bit pattern.
    if (isFloatPrimType(fc, ty)) {
      let fins = mkInstr(Op.ConstFloat, ty)
      fins.fval = f64(ival)
      return builderEmit(fc.b, fins)
    }
    let ins = mkInstr(Op.ConstInt, ty)
    ins.ival = ival
    return builderEmit(fc.b, ins)
  }
  return lowerExprByTagOps2(fc, node, hint, n)
}

fn lowerExprByTagOps2(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  if (tag == Tag.NilLit) {
    // `nil` adopts its context type (a ref/interface); the dump shows no type.
    let ty = hint
    if (ty == 0) {
      ty = defaultType(fc.c, nodeType(fc, node))
    }
    return builderEmit(fc.b, mkInstr(Op.ConstNil, ty))
  }
  if (tag == Tag.FloatLit) {
    // An untyped float literal defaults to f64; an f32/f64 context adopts the
    // hint. `parseFloat` yields the same bits the seed does (both format via
    // `{d}`), so the const_float dump matches byte-for-byte.
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstFloat, ty)
    ins.fval = parseFloat(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.StringLit) {
    let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
    ins.sval = decodeStringContent(fc.c.source, n.span.start, n.span.end)
    ins.ival = internPoolString(fc, ins.sval)
    return builderEmit(fc.b, ins)
  }
  // A raw string `` `...` `` has no escape processing (SPEC 5.6); only a CRLF
  // pair normalizes to a lone LF, so the source text between the backticks is
  // the value. Mirrors seed `normalizeRaw`.
  if (tag == Tag.RawStringLit) {
    let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
    ins.sval = normalizeRawString(fc.c.source[n.span.start + 1:n.span.end - 1])
    ins.ival = internPoolString(fc, ins.sval)
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.Call) {
    return lowerCall(fc, node, hint)
  }
  if (tag == Tag.AsmStmt) {
    return lowerAsm(fc, node)
  }
  if (tag == Tag.CompositeLit) {
    return lowerCompositeLit(fc, node)
  }
  return lowerExprByTagOps3(fc, node, hint, n)
}

fn lowerExprByTagOps3(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  if (tag == Tag.SliceLit) {
    let st = defaultType(fc.c, nodeType(fc, node))
    // A `[]Shape` context types `[nil]` as `[]Shape`, not the inferred
    // `[]untyped_nil`; prefer the hint slice type.
    if (hint != 0 && fc.c.ctx.types[hint].kind == TypeKind.Slice) {
      st = hint
    }
    if (fc.c.ctx.types[st].kind != TypeKind.Slice) {
      fcFail(fc, n.span, "a slice literal whose target type is not a slice")
      return 0
    }
    return lowerSliceElems(fc, st, kidsOf(fc.c.tree, node))
  }
  if (tag == Tag.Member) {
    return lowerFieldAccess(fc, node, hint)
  }
  if (tag == Tag.Index) {
    return lowerIndex(fc, node)
  }
  if (tag == Tag.SliceExpr) {
    return lowerSliceExpr(fc, node)
  }
  if (tag == Tag.Ident) {
    return lowerNamedValue(fc, node, fc.c.source[n.span.start:n.span.end])
  }
  if (tag == Tag.Unary) {
    return lowerUnary(fc, node, hint)
  }
  return lowerExprByTagOps4(fc, node, hint, n)
}

fn lowerExprByTagOps4(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  if (tag == Tag.Binary) {
    return lowerExprByTagBinary(fc, node, hint, n)
  }
  return lowerExprByTagOps5(fc, node, hint, n)
}

// The Binary arm's own dispatch: short-circuit and relational ops delegate
// immediately; everything else resolves the operation's type before the
// string/pointer/generic split in lowerExprByTagBinaryOp.
fn lowerExprByTagBinary(fc: FnCtx, node: int, hint: int, n: Node): int {
  if (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe)) {
    return lowerShortCircuit(fc, node)
  }
  if (isRelationalOp(n.main)) {
    return lowerComparison(fc, node)
  }
  let raw = nodeType(fc, node)
  let ty = defaultType(fc.c, raw)
  // An UNTYPED constant expression in an `f32`/`f64` context is materialized at
  // that float type, exactly as an untyped literal is by the `FloatLit` arm
  // above and by `lowerUnary`. Without it `let e: f32 = 1.0 + 0.5` produced an
  // f64-typed value sitting in an f32 binding: the fold emitted
  // `const_float f64 1.5`, and every consumer that trusts the STATIC type then
  // read it as an f32. Interpolation's f32->f64 widening became `fcvt d30, d8`
  // — a same-precision FCVT is an unallocated AArch64 encoding, so the binary
  // died with SIGILL from a build that reported success — and appending the
  // value to a `[]f32` stored the double's bits, so the element compared
  // unequal to the identical literal (#2376). After this, the expression and
  // the equivalent literal lower to the same `const_float f32 1.5`.
  //
  // INTEGERS deliberately keep their i64 operation type. An untyped constant
  // expression is evaluated at full precision and only its RESULT has to fit
  // the target (`let a: u8 = 300 / 2` is 150, and is accepted): retyping the
  // operation would make the folder wrap each step to 8 bits and answer 22.
  // Only float folding is width-independent — `foldBinaryArith` computes every
  // float op in f64 whatever the type says, so for a float the adopted type
  // narrows the result and nothing else.
  if (isUntyped(fc.c, raw) && isFloatPrimType(fc, hint)) {
    ty = hint
  }
  return lowerExprByTagBinaryOp(fc, node, n, ty)
}

fn lowerExprByTagBinaryOp(fc: FnCtx, node: int, n: Node, ty: int): int {
  // String `+` is concatenation via the runtime, not an `add`.
  if (fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    fc.c.ctx.types[ty].prim == 11 &&
    n.main == int(Kind.Plus)) {
    let kids = kidsOf(fc.c.tree, node)
    let l = lowerExpr(fc, kids[0])
    let r = lowerExpr(fc, kids[1])
    if (fc.failed) {
      return 0
    }
    return emitStringConcat(fc, ty, l, r)
  }
  // Pointer arithmetic (§11.4): `p ± n` scales `n` by sizeOf(elem) and offsets
  // the raw address. A `*T` is an int-classed word (is_ref=0), so this is plain
  // integer add/sub. The scaled byte offset is retyped to the pointer type with
  // a no-op `convert` so add/sub's operands and result share a type.
  if (fc.c.ctx.types[ty].kind == TypeKind.Ptr &&
    (n.main == int(Kind.Plus) || n.main == int(Kind.Minus))) {
    return lowerExprByTagBinaryPtrArith(fc, node, n, ty)
  }
  return lowerExprByTagBinaryGeneric(fc, node, n, ty)
}

fn lowerExprByTagBinaryPtrArith(fc: FnCtx, node: int, n: Node, ty: int): int {
  let pk = kidsOf(fc.c.tree, node)
  let elemTy = fc.c.ctx.types[ty].elem
  let scale = fieldLayoutFor(fc.c.ctx, elemTy).size
  let i64ty = primType(fc.c.ctx, 3)
  let baseVal = lowerExprH(fc, pk[0], ty)
  let off = lowerExprH(fc, pk[1], i64ty)
  if (fc.failed) {
    return 0
  }
  if (scale != 1) {
    off = emitScaledOffset(fc, off, scale, i64ty)
  }
  let paConv = mkInstr(Op.Convert, ty)
  paConv.lhs = off
  let offPtr = builderEmit(fc.b, paConv)
  let pop = Op.Add
  if (n.main == int(Kind.Minus)) {
    pop = Op.Sub
  }
  let ins = mkInstr(pop, ty)
  ins.lhs = baseVal
  ins.rhs = offPtr
  return builderEmit(fc.b, ins)
}

fn lowerExprByTagBinaryGeneric(fc: FnCtx, node: int, n: Node, ty: int): int {
  let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
  let signed = !(fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    fc.c.ctx.types[ty].prim >= 4 &&
    fc.c.ctx.types[ty].prim <= 7)
  let op = binOpFor(n.main, isFloat, signed)
  if (op == Op.BlockParam) {
    fcFail(fc, n.span, "an unsupported binary operator")
    return 0
  }
  let kids = kidsOf(fc.c.tree, node)
  // Operands take the operation's type as context, so an untyped literal
  // operand materializes at the same width (`a + 1` over i32 -> const_int i32).
  let lhs = lowerExprH(fc, kids[0], ty)
  let rhs = lowerExprH(fc, kids[1], ty)
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(op, ty)
  ins.lhs = lhs
  ins.rhs = rhs
  return builderEmit(fc.b, ins)
}

fn lowerExprByTagOps5(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  if (tag == Tag.TypeAssert) {
    return lowerTypeAssert(fc, node)
  }
  if (tag == Tag.ArrowFn) {
    return lowerArrowFn(fc, node)
  }
  if (tag == Tag.TryExpr) {
    return lowerTryExpr(fc, node)
  }
  if (tag == Tag.CatchDefault) {
    return lowerCatch(fc, node, false)
  }
  if (tag == Tag.CatchBind) {
    return lowerCatch(fc, node, true)
  }
  if (tag == Tag.MatchStmt) {
    return lowerMatchExpr(fc, node)
  }
  return lowerExprByTagOps6(fc, node, hint, n)
}

fn lowerExprByTagOps6(fc: FnCtx, node: int, hint: int, n: Node): int {
  let tag = n.tag
  // `t.0` — a field read at the element's offset in the boxed tuple (ABI.md
  // §1.1). The checker has already range-checked the index against the arity.
  if (tag == Tag.TupleIndex) {
    return lowerExprByTagTupleIndex(fc, node, n)
  }
  return lowerExprHExtra(fc, node, tag, hint, n)
}

fn lowerExprByTagTupleIndex(fc: FnCtx, node: int, n: Node): int {
  let tk = kidsOf(fc.c.tree, node)
  let tupTy = nodeType(fc, tk[0])
  if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    fcFail(fc, n.span, "a tuple index on a non-tuple value")
    return 0
  }
  let idxNode = getNode(fc.c.tree, tk[1])
  let idx = parseIntText(fc.c.source[idxNode.span.start:idxNode.span.end])
  if (idx < 0 || idx >= len(fc.c.ctx.types[tupTy].members)) {
    fcFail(fc, idxNode.span, "a tuple index out of range")
    return 0
  }
  let recv = lowerExpr(fc, tk[0])
  if (fc.failed) {
    return 0
  }
  return tupleElem(fc, tupTy, recv, idx)
}

// The tail of `lowerExprH`'s if-chain, split out purely to keep that
// function's own McCabe complexity from growing every time one more tag
// joins the dispatch (spec/LINT.md E0204, tools/build/complexity-debt.txt's
// baseline for `lowerExprH`): a new arm here costs THIS function's
// complexity, never `lowerExprH`'s, since the call above is its
// unconditional tail.
fn lowerExprHExtra(fc: FnCtx, node: int, tag: Tag, hint: int, n: Node): int {
  if (tag == Tag.CondExpr) {
    return lowerConditional(fc, node, hint)
  }
  if (tag == Tag.TupleLit) {
    return lowerTupleLit(fc, node, hint)
  }
  fcFail(fc, n.span, "an expression form the lowerer does not yet handle")
  return 0
}

// Emits a `type_info` for class type `ty`: `disc` is the type id, `size` and
// `ptrs` its GC layout (ABI.md §2). Typed `u64` — it is a `.rodata` address, not
// a traced reference. The checker restricts assertion targets to structs.
fn lowerTypeInfo(fc: FnCtx, ty: int, span: Span): int {
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    fcFail(fc, span, "a type assertion to a target that is not a class")
    return 0
  }
  // `ty` is the INSTANTIATION (`Box<i64>`), but `structDeclOf` resolves it back
  // to the `Box` template by name, whose field is declared `v: T`. Laying that
  // out unsubstituted classifies the bare param as a traced pointer, so
  // `Box<i64>`'s integer would be walked as a heap reference — a GC precision
  // bug baked into a static .rodata descriptor, not a compile error (#1565).
  let oc = typeOwner(fc.c, ty)
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, ty))
  let ti = mkInstr(Op.TypeInfo, primType(fc.c.ctx, 7))
  ti.ival = ty
  ti.ival2 = layout.size
  ti.offsets = layout.ptrOffsets
  return builderEmit(fc.b, ti)
}
