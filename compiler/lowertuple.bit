// compiler/lowertuple.bit — split out of lowerexpr.bit (#5432, at the 800-line
// E0200 ceiling). Sibling of lowerexpr.bit: same module, so this needs no
// imports and no call-site changes. Everything a boxed tuple needs: the ABI
// layout and constructor (ABI.md §1.1), element reads, `let` destructuring
// (SPEC §10.1) and the two-result forms it shares a binder with (§12.6/§14.4/
// §16.2) — `buildTuple`/`buildTupleIn`/`tupleElem` are called from across the
// module (lowerclosure.bit, lowerctrl.bit, lowerdecimal.bit,
// lowerdecimalarith.bit, lowerdecimaldiv.bit, lowerfail.bit, lowerflow.bit,
// lowerforin.bit, lowerfunc.bit, lowerfuncval.bit, lowerslicefill.bit), which
// is why this is its own file rather than staying inline.

// The two-result forms `<- c` / `m[k]` / `iface.(T)` (SPEC §12.6/§14.4/§16.2),
// returning [value, ok] — or an empty list if `node` is none of them. The
// chan/interface `ok` comes from a call reporting the immediately preceding one
// (ABI.md §2.2/§11), so those two pairs are emitted back to back. The MAP form
// is not that shape: `emitMapCommaOk` gets both answers out of a single probe
// (#4019), so nothing about it depends on call adjacency.
fn lowerTwoResult(fc: FnCtx, node: int): []int {
  let n = getNode(fc.c.tree, node)
  let k = kidsOf(fc.c.tree, node)
  let valTy = nodeType(fc, node)
  let boolTy = primType(fc.c.ctx, 10)
  if (n.tag == Tag.Unary && n.main == int(Kind.ArrowLeft)) {
    let ch = lowerExpr(fc, k[0])
    if (fc.failed) {
      return []int(0)
    }
    let rv = mkInstr(Op.RtCall, valTy)
    rv.name = "chan_recv"
    rv.args = [ch]
    let v = emitRtCall(fc, rv)
    let okI = mkInstr(Op.RtCall, boolTy)
    okI.name = "chan_recv_ok"
    return [v, emitRtCall(fc, okI)]
  }
  if (n.tag == Tag.Index) {
    let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
    if (fc.c.ctx.types[recvTy].kind != TypeKind.Map) {
      return []int(0)
    }
    let m = lowerExpr(fc, k[0])
    let key = lowerExprH(fc, k[1], fc.c.ctx.types[recvTy].mapKey)
    if (fc.failed) {
      return []int(0)
    }
    return emitMapCommaOk(fc, valTy, m, key, n.span)
  }
  if (n.tag == Tag.TypeAssert) {
    return lowerTypeAssertTwo(fc, node, valTy)
  }
  return []int(0)
}

// Rebinds a name in the CHECKER for the body being lowered, so a later
// `checkExprType` on that name sees the type this scope/instance actually gives
// it (see lowerFunc). Both of the checker's name paths are written: the flat
// `env` by name, and `declTypes` at the binder's own node — the decl path a
// reference resolves through (nodeSymbols -> Symbol.decl -> declTypes, #1502).
// Writing only the env would leave the decl path holding the check pass's
// best-effort type, which for a monomorphized instance is the bare template.
fn rebindCheckerName(fc: FnCtx, identNode: int, ty: int) {
  let n = getNode(fc.c.tree, identNode)
  fc.c.env[fc.c.source[n.span.start:n.span.end]] = ty
  if (identNode > 0 && identNode < len(fc.c.declTypes)) {
    fc.c.declTypes[identNode] = ty
  }
}

// Binds a two-result binder unless it is the blank `_` (which discards).
fn declareUnlessBlank(fc: FnCtx, patNode: int, val: int, ty: int) {
  let pn = getNode(fc.c.tree, patNode)
  let name = fc.c.source[pn.span.start:pn.span.end]
  if (name == "_") {
    return
  }
  declareLocal(fc, name, val, ty)
  rebindCheckerName(fc, patNode, ty)
}

// The body layout of a boxed tuple (ABI.md §1.1) — a tuple is laid out exactly
// like a class, so its element types go straight to `layoutFields`.
fn tupleLayout(fc: FnCtx, ty: int): StructLayout {
  return layoutFields(fc, fc.c.ctx.types[ty].members)
}

// Boxes `vals` into a fresh tuple record of type `tupTy` (ABI.md §1.1): the same
// `gc_alloc` + one store per element that a class composite literal emits,
// because a tuple is a class without names.
fn buildTuple(fc: FnCtx, tupTy: int, vals: []int): int {
  return buildTupleIn(fc, fc.b, tupTy, vals)
}

// The same into an explicit builder, for the synthesized bodies (#4405's
// function-value trampoline) that are emitted into their own `IrBuilder`
// rather than into `fc.b`. One implementation, so a change to the tuple's
// representation cannot reach one caller and miss the other.
//
// #5429: a decimal member is 16 inline bytes, but `vals[i]` is the two-word
// tuple every decimal VALUE is — a bare `FieldSet` off `layout.types[i]` asked
// the backend for a 16-byte store from an 8-byte pointer (`gpSizeOpc: width
// 16`). Explode and store two i64 words, as `lowerClassLitFieldInit` already
// does. Also the closure-capture path: `allocBox` boxes a capture here too.
fn buildTupleIn(fc: FnCtx, b: IrBuilder, tupTy: int, vals: []int): int {
  let layout = tupleLayout(fc, tupTy)
  let ga = mkInstr(Op.GcAlloc, tupTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(b, ga)
  let i = 0
  while (i < len(vals)) {
    if (isDecimalPrim(fc.c.ctx, layout.types[i])) {
      let words = explodeValueWords(fc.c.ctx, b, vals[i], decimalWordTypes(fc.c.ctx))
      emitDecimalFieldSet(fc.c.ctx, b, obj, layout.offsets[i], words)
      i = i + 1
      continue
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[i]
    fs.rhs = vals[i]
    fs.ival2 = layout.types[i]
    builderEmit(b, fs)
    i = i + 1
  }
  return obj
}

// A tuple literal `(a, b, ...)` (SPEC §12.10, #4105): boxes its elements the
// same way a multi-value `return` already does (`buildTuple` above, ABI.md
// §1.1) — a tuple has one representation everywhere it is built. `hint`
// mirrors SliceLit's own preference below (`lowerExprH`'s `Tag.SliceLit` arm):
// a matching-kind target type is preferred over the literal's own bare
// inference, so `let t: (i32, string) = (1, "x")` stores an i32, not the
// defaulted i64 `nodeType` alone would answer. Elements are then lowered
// against their own member type exactly as a `return`'s tuple-building values
// are (`lowerfunc.bit`), including the array value-semantics copy
// (`arrayValueForBind`).
fn lowerTupleLit(fc: FnCtx, node: int, hint: int): int {
  let tupTy = nodeType(fc, node)
  if (hint != 0 && fc.c.ctx.types[hint].kind == TypeKind.Tuple) {
    tupTy = hint
  }
  let n = getNode(fc.c.tree, node)
  if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    fcFail(fc, n.span, "a tuple literal whose inferred type is not a tuple")
    return 0
  }
  let members = fc.c.ctx.types[tupTy].members
  let kids = kidsOf(fc.c.tree, node)
  if (len(members) != len(kids)) {
    fcFail(fc, n.span, "a tuple literal with the wrong number of elements for its target type")
    return 0
  }
  let elems = []int(0)
  let i = 0
  while (i < len(kids) && !fc.failed) {
    elems = append(
      elems,
      arrayValueForBind(fc, kids[i], lowerExprH(fc, kids[i], members[i]), members[i]),
    )
    i = i + 1
  }
  if (fc.failed) {
    return 0
  }
  return buildTuple(fc, tupTy, elems)
}

// Reads element `idx` out of the boxed tuple `recv` (ABI.md §1.1).
//
// #5429: the read-side twin of `buildTupleIn`'s write fix (same `gpSizeOpc:
// width 16` panic, from `loadImm`). Read a decimal member's two i64 words
// back and rebox them, the same shape `lowerDecimalFieldGet`
// (lowerdecimal.bit) uses for a class field. Also the closure-capture read:
// `localRead` (lowerclosure.bit) calls this on the boxed cell.
fn tupleElem(fc: FnCtx, tupTy: int, recv: int, idx: int): int {
  let layout = tupleLayout(fc, tupTy)
  let mty = fc.c.ctx.types[tupTy].members[idx]
  if (isDecimalPrim(fc.c.ctx, mty)) {
    let words = decimalFieldWords(fc, recv, layout.offsets[idx])
    return buildTuple(fc, decimalTupleType(fc.c.ctx), words)
  }
  let fg = mkInstr(Op.FieldGet, mty)
  fg.lhs = recv
  fg.ival = layout.offsets[idx]
  return builderEmit(fc.b, fg)
}

// Binds each of `pats` to the corresponding element of the boxed tuple `val`,
// recursing into nested patterns (SPEC §10.1 `pat = IDENT | "_" | tuple_pat`).
// Arity is checker-enforced; a mismatch is refused rather than read past the end
// of the layout.
fn destructureTuple(fc: FnCtx, pats: []int, tupTy: int, val: int) {
  // Patterns always have at least one element (SPEC §10.1's tuple_pat is never
  // empty), so `pats[0]`'s span stands in for the whole pattern list.
  let span = getNode(fc.c.tree, pats[0]).span
  if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    fcFail(fc, span, "a tuple destructure whose right side is not a tuple")
    return
  }
  let members = fc.c.ctx.types[tupTy].members
  if (len(members) != len(pats)) {
    fcFail(fc, span, "a tuple destructure with the wrong number of patterns for the tuple's arity")
    return
  }
  let i = 0
  while (i < len(pats)) {
    let pn = getNode(fc.c.tree, pats[i])
    if (pn.tag == Tag.TuplePat) {
      destructureTuple(fc, kidsOf(fc.c.tree, pats[i]), members[i], tupleElem(fc, tupTy, val, i))
      if (fc.failed) {
        return
      }
    } else {
      // `_` discards: skip the load entirely rather than emit a dead one.
      if (fc.c.source[pn.span.start:pn.span.end] != "_") {
        declareUnlessBlank(fc, pats[i], tupleElem(fc, tupTy, val, i), members[i])
      }
    }
    i = i + 1
  }
}

// `let (v, ok) = <two-result>` (SPEC §12.6/§14.4/§16.2), or the general
// `let (a, b, ...) = <tuple>` destructure (§10.1).
//
// The two-result forms are tried first and only at arity 2: `m[k]` and `<- c`
// are not tuple-typed — they are a value plus a separate presence flag — so they
// can never fall through to the tuple path, and a tuple can never be mistaken
// for one.
fn lowerTwoResultLet(fc: FnCtx, binding: int) {
  let bk = kidsOf(fc.c.tree, binding)
  let pats = kidsOf(fc.c.tree, bk[0])
  if (bk[2] == 0) {
    fcFail(fc, getNode(fc.c.tree, bk[0]).span, "a `let` destructure with no initializer")
    return
  }
  if (len(pats) == 2 && allIdentPats(fc, pats)) {
    let two = lowerTwoResult(fc, bk[2])
    if (fc.failed) {
      return
    }
    if (len(two) == 2) {
      declareUnlessBlank(fc, pats[0], two[0], nodeType(fc, bk[2]))
      declareUnlessBlank(fc, pats[1], two[1], primType(fc.c.ctx, 10))
      return
    }
  }
  let tupTy = nodeType(fc, bk[2])
  let val = lowerExpr(fc, bk[2])
  if (fc.failed) {
    return
  }
  destructureTuple(fc, pats, tupTy, val)
}

// Rebinds an existing local destructuring target to `val`. `_` discards, so it
// names no slot to rebind.
fn assignEnvSlot(fc: FnCtx, target: int, val: int) {
  let tn = getNode(fc.c.tree, target)
  if (tn.tag != Tag.Ident) {
    fcFail(fc, tn.span, "a reassignment target that is not a plain name")
    return
  }
  let name = fc.c.source[tn.span.start:tn.span.end]
  if (name == "_") {
    return
  }
  let ix = envIndex(fc, name)
  if (ix == -1) {
    fcFail(fc, tn.span, "a reassignment to a name that is not a known local")
    return
  }
  localWrite(fc, ix, val)
}

// True when every pattern is a plain identifier (so the two-result shape, which
// binds exactly two names, applies).
fn allIdentPats(fc: FnCtx, pats: []int): bool {
  let i = 0
  while (i < len(pats)) {
    if (getNode(fc.c.tree, pats[i]).tag != Tag.Ident) {
      return false
    }
    i = i + 1
  }
  return true
}
