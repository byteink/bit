// #7713: the compiler binary's OWN SHA-256, against FIPS 180-4 vectors.
//
// The compiler imports `std/crypto` (pmfetch's TLS and x509 paths), and that
// stdlib is compiled by the PINNED stage0 against the tree's runtime, so the
// layout stage0 gives a `[]u32` and the layout the runtime's hardware SHA-256
// routine reads must agree. When #7574 packed `[]u32` at 4 bytes and
// `stdlib/crypto/sha256.bit` began handing `ptrOf(state)` straight to
// `bit_rt_sha256_hw_blocks`, they stopped agreeing for this binary alone: every
// digest it computed was wrong, so every certificate signature check in
// `bit add` failed with "x509: signature verification failed", while the
// stdlib's own unit tests (compiled by the NEW compiler, which agrees with the
// runtime) stayed green. The differentials compare programs the compiler
// compiles, never the compiler's own code, so only a check that runs inside this
// binary can see it. The vectors are FIPS 180-4 / RFC 4231 values, derived with
// shasum and openssl, which share no code with Bit.
import { Sha256, HashAlg, digest, hmac, encodeHex } from "std/crypto"

// `digest` of `msg` as lowercase hex.
fn sha256Hex(msg: []byte): string {
  return encodeHex(digest(Sha256(), msg))
}

fn checkCompilerSha256() {
  // FIPS 180-4 Appendix B.1 (one block), and the empty message.
  assert(sha256Hex([]byte("abc")) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
  assert(sha256Hex([]byte("")) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")

  // Appendix B.2: 448 bits, whose padding spills into a second block.
  let two = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
  assert(sha256Hex([]byte(two)) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

  // The same message fed in uneven pieces: the buffered head and tail paths.
  let h = Sha256()
  let b = []byte(two)
  h.write(b[0:1])
  h.write(b[1:30])
  h.write(b[30:])
  assert(encodeHex(h.sum()) == "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")

  // Appendix B.3: one million 'a' in a single write, so the hardware path
  // folds 15625 blocks in one call.
  let big = []byte(1000000)
  let i = 0
  while (i < 1000000) {
    big[i] = 97
    i = i + 1
  }
  assert(sha256Hex(big) == "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")

  // RFC 4231 test case 2: HMAC rides the same hasher.
  let tag = hmac(HashAlg.Sha256, []byte("Jefe"), []byte("what do ya want for nothing?"))
  assert(encodeHex(tag) == "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
}
