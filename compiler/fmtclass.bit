// compiler/fmtclass.bit — class/interface declaration printing, split out of
// fmtdispatch.bit's if-chain (#4066): `readonly`'s own +5 lines there tipped
// that file from 799 to 804, over the repo's 800-line ceiling. Sliced out as
// its own chain-of-responsibility function rather than folded elsewhere,
// mirroring how fmtDispatch itself falls through to fmtDispatchExpr
// (fmtexpr.bit) for the tags it does not handle — a sibling .bit file is the
// same module, so this needs no import and no other call-site change.

// Prints `idx` (whose tag is already known to be `n.tag`) if it is one of the
// class/interface-declaration node kinds, returning whether it did. Called
// from fmtDispatch in place of the five `if` blocks this used to be.
fn fmtDispatchClass(p: Printer, idx: int, n: Node): bool {
  if (n.tag == Tag.StructDecl) {
    let k = kidsOf(p.tree, idx)
    // The class attribute list (SPEC §10.3.1, #3976), the 4th kid and elided
    // when absent. Printed INLINE ahead of `class`, exactly as a function's own
    // attributes print ahead of `fn` (fmtdispatch.bit's FuncDecl arm) — the
    // `Tag.AttrList` arm already emits the trailing space, and an `export`
    // wrapper prints before all of it, so `export @json class C {}` reads as
    // one line rather than splitting the marker off from what it marks.
    if (classAttrList(p.tree, idx) != 0) {
      fmtPrintNode(p, k[3])
    }
    fmtRaw(p, "class ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return true
  }
  if (n.tag == Tag.FieldList) {
    // A class body mixing fields with an in-body method (SPEC §10.4, #3367)
    // switches to fmtPrintMemberBlock (fmt.bit); a field-only class keeps the
    // comma-list rendering unchanged.
    if (fmtFieldListNeedsBlock(p.tree, idx)) {
      fmtPrintMemberBlock(p, kidsOf(p.tree, idx), n.span)
    } else {
      fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    }
    return true
  }
  if (n.tag == Tag.Field) {
    fmtPrintField(p, idx, n)
    return true
  }
  if (n.tag == Tag.InterfaceDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "interface ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return true
  }
  if (n.tag == Tag.MethodSigList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return true
  }
  return false
}

// An attribute's parenthesized argument list, given the `Tag.Attr` node's kid
// vector `[name, arg...]`. Argument children are elided when there are none, so
// a bare attribute prints exactly as it did before arguments existed — and
// `@foo()` parses to that same shape and therefore prints as `@foo`, since the
// empty list carries nothing and the canonical spelling of nothing is nothing.
//
// Here rather than inline in fmtdispatch.bit's `Tag.Attr` arm: that file's
// `fmtDispatch` is one function at McCabe 112 against a pinned debt of 117
// (tools/build/complexity-debt.txt), and a loop plus two `if`s inline would
// have spent most of the remaining headroom on printing a comma.
fn fmtPrintAttrArgs(p: Printer, k: []int) {
  if (len(k) <= 1) {
    return
  }
  fmtRaw(p, "(")
  let i = 1
  while (i < len(k)) {
    if (i > 1) {
      fmtRaw(p, ", ")
    }
    fmtPrintNode(p, k[i])
    i = i + 1
  }
  fmtRaw(p, ")")
}

// An `export`ed declaration's own printing. A FIELD is the one member whose
// halves straddle the keyword: `field = [ attr_list ] [ "export" ] ...` (SPEC
// §10.5, #3879), so its attributes print ABOVE `export` and its body after it.
// Everything else prints `export` then itself.
//
// Here rather than inline in fmtdispatch.bit's `Tag.Export` arm, for the same
// complexity-headroom reason as `fmtPrintAttrArgs` above.
fn fmtPrintExport(p: Printer, inner: int) {
  let n = getNode(p.tree, inner)
  if (n.tag == Tag.Field) {
    fmtPrintFieldAttrs(p, inner)
    fmtRaw(p, "export ")
    fmtPrintFieldBody(p, inner, n)
    return
  }
  fmtRaw(p, "export ")
  fmtPrintNode(p, inner)
}

// A field's attribute list (SPEC §10.5, #3879), one attribute per line, each
// on its own line ABOVE the field — never joined onto it, the way a function
// attribute is (`@naked fn f()`). A field commonly carries several and the
// stack is the readable form. Nothing is printed when the field has none.
//
// Its own function, separate from the field body below, because the two are
// printed with `export` BETWEEN them: the grammar is
// `[attr_list] [export] [readonly] IDENT`, so an exported attributed field
// prints its attributes, then `export`, then the body. fmtdispatch.bit's
// `Tag.Export` arm is what interleaves them.
fn fmtPrintFieldAttrs(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx)
  if (len(k) <= 3 || k[3] == 0) {
    return
  }
  let attrs = kidsOf(p.tree, k[3])
  let i = 0
  while (i < len(attrs)) {
    fmtPrintNode(p, attrs[i])
    fmtNewline(p)
    i = i + 1
  }
}

// One class or trait field's own text: `[readonly] name: type [= default]`,
// with any attributes already printed by `fmtPrintFieldAttrs` above. Its own
// function rather than an arm in the chain above, which the default's `!= 0`
// test took to McCabe 11 (spec/LINT.md E0204) — the same reason this whole
// file was split out of fmtdispatch.bit for `readonly`, one limit over.
fn fmtPrintFieldBody(p: Printer, idx: int, n: Node) {
  let k = kidsOf(p.tree, idx)
  // `readonly` rides in `n.main` (parsertype.bit's parseField, #4066); a
  // trait field never sets it, so this is a no-op there.
  if (n.main == 1) {
    fmtRaw(p, "readonly ")
  }
  fmtPrintNode(p, k[0])
  fmtRaw(p, ": ")
  fmtPrintNode(p, k[1])
  // The default value (SPEC §10.5, #3838), absent as 0. Canonical spelling is
  // one space either side of `=`, matching a `let` binding's initializer.
  if (k[2] != 0) {
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[2])
  }
}

// A whole unexported field. The exported spelling goes through the `Tag.Export`
// arm instead, which has to put `export` between the two halves.
fn fmtPrintField(p: Printer, idx: int, n: Node) {
  fmtPrintFieldAttrs(p, idx)
  fmtPrintFieldBody(p, idx, n)
}
