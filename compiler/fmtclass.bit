// compiler/fmtclass.bit — class/interface declaration printing, split out of
// fmtdispatch.bit's if-chain (#4066): `readonly`'s own +5 lines there tipped
// that file from 799 to 804, over the repo's 800-line ceiling. Sliced out as
// its own chain-of-responsibility function rather than folded elsewhere,
// mirroring how fmtDispatch itself falls through to fmtDispatchExpr
// (fmtexpr.bit) for the tags it does not handle — a sibling .bit file is the
// same module, so this needs no import and no other call-site change.

// Prints `idx` (whose tag is already known to be `n.tag`) if it is one of the
// class/interface-declaration node kinds, returning whether it did. Called
// from fmtDispatch in place of the five `if` blocks this used to be.
fn fmtDispatchClass(p: Printer, idx: int, n: Node): bool {
  if (n.tag == Tag.StructDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "class ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return true
  }
  if (n.tag == Tag.FieldList) {
    // A class body mixing fields with an in-body method (SPEC §10.4, #3367)
    // switches to fmtPrintMemberBlock (fmt.bit); a field-only class keeps the
    // comma-list rendering unchanged.
    if (fmtFieldListHasMethod(p.tree, idx)) {
      fmtPrintMemberBlock(p, kidsOf(p.tree, idx), n.span)
    } else {
      fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    }
    return true
  }
  if (n.tag == Tag.Field) {
    let k = kidsOf(p.tree, idx)
    // `readonly` rides in `n.main` (parsertype.bit's parseField, #4066); a
    // trait field never sets it, so this is a no-op there.
    if (n.main == 1) {
      fmtRaw(p, "readonly ")
    }
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return true
  }
  if (n.tag == Tag.InterfaceDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "interface ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return true
  }
  if (n.tag == Tag.MethodSigList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return true
  }
  return false
}
