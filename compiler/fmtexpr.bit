// Self-host `bit fmt` (#1345): the node dispatch for expressions and types,
// derived from `dispatch`. Reached from fmtDispatch (fmtdispatch.bit)
// for any tag it does not handle itself. A sibling .bit file is the same module.

fn fmtDispatchExpr(p: Printer, idx: int, n: Node) {
  // ---- types ----
  if (n.tag == Tag.SliceType) {
    fmtRaw(p, "[]")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.PtrType) {
    fmtRaw(p, "*")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ArrayType) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "[")
    fmtPrintNode(p, k[0])
    fmtRaw(p, "]")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.MapType) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "map<")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ", ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, ">")
    return
  }
  if (n.tag == Tag.TupleType) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.VoidType) {
    fmtRaw(p, "()")
    return
  }
  if (n.tag == Tag.FuncType) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.ChanType) {
    fmtRaw(p, "chan<")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, ">")
    return
  }
  if (n.tag == Tag.QualType) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.GenericInst) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeArgs) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "<", ">", n.span.end)
    return
  }

  // ---- expressions ----
  if (n.tag == Tag.Binary) {
    fmtPrintBinaryChain(p, idx)
    return
  }
  if (n.tag == Tag.Unary) {
    let op = n.main
    let operand = kidsOf(p.tree, idx)[0]
    fmtRaw(p, opSymbol(op))
    // `<- ch` reads as a word and mirrors the send's spacing; the other prefix
    // operators bind tight to their operand.
    if (op == int(Kind.ArrowLeft)) {
      fmtRaw(p, " ")
    }
    let child = getNode(p.tree, operand)
    if (fmtUnaryOperandWrap(child.tag)) {
      fmtRaw(p, "(")
      fmtPrintNode(p, operand)
      fmtRaw(p, ")")
    } else {
      // Avoid a nested `-`/`+` unary merging into `--`/`++`.
      if (child.tag == Tag.Unary &&
        child.main == n.main &&
        (op == int(Kind.Minus) || op == int(Kind.Plus))) {
        fmtRaw(p, " ")
      }
      fmtPrintNode(p, operand)
    }
    return
  }
  if (n.tag == Tag.CatchDefault) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCatchLhs(p, k[0])
    fmtRaw(p, " catch ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.CatchBind) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCatchLhs(p, k[0])
    fmtRaw(p, " catch ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ArrowFn) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ArrowParams) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.ArrowP) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.Call) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.Args) {
    let args = kidsOf(p.tree, idx)
    if (!fmtPrintArgsTrailingArrow(p, args)) {
      fmtPrintCommaList(p, args, "(", ")", n.span.end)
    }
    return
  }
  if (n.tag == Tag.Arg) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ArgSpread) {
    fmtRaw(p, "...")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  // `name = expr` (SPEC §12.11, #3839) — always `=`, never `:`: unlike
  // `Tag.FieldInit`, which for one release accepts both spellings and
  // canonicalizes to `:` (#3840), a named argument has only ever had one.
  if (n.tag == Tag.NamedArg) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.Index) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, "[")
    fmtPrintNode(p, k[1])
    fmtRaw(p, "]")
    return
  }
  if (n.tag == Tag.SliceExpr) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, "[")
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, ":")
    if (k[2] != 0) {
      fmtPrintNode(p, k[2])
    }
    fmtRaw(p, "]")
    return
  }
  if (n.tag == Tag.Member) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TupleIndex) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeAssert) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".(")
    fmtPrintNode(p, k[1])
    fmtRaw(p, ")")
    return
  }
  if (n.tag == Tag.TryExpr) {
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "?")
    return
  }
  if (n.tag == Tag.CompositeLit) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    let body = getNode(p.tree, k[1])
    fmtPrintCommaList(p, kidsOf(p.tree, k[1]), "{", "}", body.span.end)
    return
  }
  if (n.tag == Tag.FieldInits) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.FieldInit) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    // `main == 1` marks the shorthand `IDENT` form the parser desugars to
    // `IDENT: IDENT` (#3735) — print it back bare, never expanded, or
    // reformatting a file would silently rewrite every shorthand field.
    if (n.main == 1) {
      return
    }
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.MapEntries) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.MapEntry) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.SliceLit) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "[", "]", n.span.end)
    return
  }
  if (n.tag == Tag.StrInterp) {
    fmtRaw(p, "\"")
    let k = kidsOf(p.tree, idx)
    let i = 0
    while (i < len(k)) {
      let kn = getNode(p.tree, k[i])
      if (kn.tag == Tag.StrPart) {
        fmtRaw(p, p.source[kn.span.start:kn.span.end])
      } else if (kn.tag == Tag.MatchStmt) {
        // A `match` renders multi-line, which cannot live inside a string
        // literal; copy its (necessarily single-line) source verbatim.
        fmtRaw(p, "\${")
        fmtRaw(p, p.source[kn.span.start:kn.span.end])
        fmtRaw(p, "}")
        if (kn.span.end > p.srcPos) {
          p.srcPos = kn.span.end
        }
      } else {
        fmtRaw(p, "\${")
        fmtPrintNode(p, k[i])
        fmtRaw(p, "}")
      }
      i = i + 1
    }
    fmtRaw(p, "\"")
    return
  }
  fmtDispatchExprExtra(p, idx, n)
}

// Whether a `Unary`'s operand `tag` needs re-parenthesizing — pulled out of
// the `Unary` arm above purely to keep `fmtDispatchExpr`'s own McCabe
// complexity from growing every time one more tag joins the wrap set
// (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `fmtDispatchExpr`): each `||` here costs THIS function's complexity, never
// `fmtDispatchExpr`'s.
fn fmtUnaryOperandWrap(tag: Tag): bool {
  return tag == Tag.Binary ||
    tag == Tag.CatchDefault ||
    tag == Tag.CatchBind ||
    tag == Tag.ArrowFn ||
    tag == Tag.CondExpr
}

// The tail of `fmtDispatchExpr`'s if-chain, split out for the identical
// reason `fmtUnaryOperandWrap` above is — an unconditional call, so a new tag
// here costs nothing at the call site.
//
// `cond ? then : else` (§12, #3941). `then` and `else` never need
// re-parenthesizing here — `then` is parsed as a full `expression` and
// `else` recurses through `conditional`, so both cover everything
// `parseBinary`/`parseExpr` can naturally produce with no source parens to
// restore (fmtPrintCondCond, fmtwrap.bit, is only for `cond`).
fn fmtDispatchExprExtra(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.CondExpr) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCondCond(p, k[0])
    fmtRaw(p, " ? ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " : ")
    fmtPrintNode(p, k[2])
    return
  }
  // A tuple literal `(a, b, ...)` (SPEC §12.10, #4105) — same comma-list shape
  // as `TupleType` above and `SliceLit`, just parenthesized.
  if (n.tag != Tag.TupleLit) {
    return
  }
  fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
}

// #4968: the arrow function a call's LAST argument holds, when that argument
// is a plain one (not named, not spread) and the arrow's body is a brace
// block — the one shape allowed to stay attached to its call head. 0 when the
// shape does not match, which is every other argument list.
fn fmtTrailingArrowFn(p: Printer, item: int): int {
  if (getNode(p.tree, item).tag != Tag.Arg) {
    return 0
  }
  let inner = kidsOf(p.tree, item)[0]
  if (getNode(p.tree, inner).tag != Tag.ArrowFn) {
    return 0
  }
  if (getNode(p.tree, kidsOf(p.tree, inner)[1]).tag != Tag.Block) {
    return 0
  }
  return inner
}

// The head of an attached trailing-arrow call rendered flat — the earlier
// arguments with their separators, then the arrow's parameters and ` => `,
// i.e. everything between the `(` and the body's `{`. Rendered for real
// through fmtPrintNode (the caller keeps this text on the accept path and
// calls fmtTrialReject on the reject path, exactly like every other trial in
// fmtwrap.bit).
fn fmtRenderArgsHead(p: Printer, items: []int, params: int): string {
  let savedOut = p.out
  p.out = []byte(0)
  let savedSpeculative = p.speculativeFlat
  p.speculativeFlat = false
  let i = 0
  while (i < len(items) - 1) {
    fmtPrintNode(p, items[i])
    fmtRaw(p, ", ")
    i = i + 1
  }
  fmtPrintNode(p, params)
  fmtRaw(p, " => ")
  p.speculativeFlat = savedSpeculative
  let text = string(p.out)
  p.out = savedOut
  return text
}

// #4968: a call whose last argument is a block-bodied arrow keeps its head on
// one line — `f(a, (x) => {` — with the body indented once under it and `})`
// closing, the shape a closure-taking API reads best in, instead of paying
// three lines and two indent levels for one argument per line. Returns false
// when the shape does not match or the head does not fit the width budget, so
// the caller falls back to the generic comma list (fmtwrap.bit) unchanged.
fn fmtPrintArgsTrailingArrow(p: Printer, items: []int): bool {
  if (len(items) == 0) {
    return false
  }
  let arrow = fmtTrailingArrowFn(p, items[len(items) - 1])
  if (arrow == 0) {
    return false
  }
  let k = kidsOf(p.tree, arrow)
  // A comment before the body's `{` — between two arguments, or inside the
  // arrow head — has nowhere to go on a joined head line. Comments INSIDE the
  // body are fmtPrintBlock's business and do not disqualify the shape.
  if (fmtHasCommentBefore(p, getNode(p.tree, k[1]).span.start)) {
    return false
  }
  let tail = p.nextListTail
  p.nextListTail = 0
  let t = fmtTrialBegin(p)
  // Same bol rule as fmtPrintFlatList (fmtwrap.bit): a trial that starts on a
  // fresh line must render indent-free and measure from the indent baseline.
  let col = t.col
  if (t.bol) {
    col = p.indent * fmtIndentWidth
    p.bol = false
  }
  let text = fmtRenderArgsHead(p, items, k[0])
  fmtTrialRestoreCursor(p, t)
  // The head line is `(` + this text + the body's `{`; the closing `})` and
  // whatever trails the call land on the body's last line, so `tail` is not
  // part of this budget.
  if (fmtHasNl(text) || col + len(text) + 2 > fmtMaxWidth) {
    fmtTrialReject(p, t)
    p.nextListTail = tail
    return false
  }
  fmtNoteChainListBreak(p)
  fmtRaw(p, "(")
  fmtRaw(p, text)
  fmtPrintNode(p, k[1])
  fmtRaw(p, ")")
  return true
}
