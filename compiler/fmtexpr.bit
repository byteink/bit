// Self-host `bit fmt` (#1345): the node dispatch for expressions and types,
// derived from `dispatch`. Reached from fmtDispatch (fmtdispatch.bit)
// for any tag it does not handle itself. A sibling .bit file is the same module.

fn fmtDispatchExpr(p: Printer, idx: int, n: Node) {
  // ---- types ----
  if (n.tag == Tag.SliceType) {
    fmtRaw(p, "[]")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.PtrType) {
    fmtRaw(p, "*")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ArrayType) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "[")
    fmtPrintNode(p, k[0])
    fmtRaw(p, "]")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.MapType) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "map<")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ", ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, ">")
    return
  }
  if (n.tag == Tag.TupleType) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.VoidType) {
    fmtRaw(p, "()")
    return
  }
  if (n.tag == Tag.FuncType) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.ChanType) {
    fmtRaw(p, "chan<")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, ">")
    return
  }
  if (n.tag == Tag.QualType) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.GenericInst) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeArgs) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "<", ">", n.span.end)
    return
  }

  // ---- expressions ----
  if (n.tag == Tag.Binary) {
    fmtPrintBinaryChain(p, idx)
    return
  }
  if (n.tag == Tag.Unary) {
    let op = n.main
    let operand = kidsOf(p.tree, idx)[0]
    fmtRaw(p, opSymbol(op))
    // `<- ch` reads as a word and mirrors the send's spacing; the other prefix
    // operators bind tight to their operand.
    if (op == int(Kind.ArrowLeft)) {
      fmtRaw(p, " ")
    }
    let child = getNode(p.tree, operand)
    if (fmtUnaryOperandWrap(child.tag)) {
      fmtRaw(p, "(")
      fmtPrintNode(p, operand)
      fmtRaw(p, ")")
    } else {
      // Avoid a nested `-`/`+` unary merging into `--`/`++`.
      if (child.tag == Tag.Unary &&
        child.main == n.main &&
        (op == int(Kind.Minus) || op == int(Kind.Plus))) {
        fmtRaw(p, " ")
      }
      fmtPrintNode(p, operand)
    }
    return
  }
  if (n.tag == Tag.CatchDefault) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCatchLhs(p, k[0])
    fmtRaw(p, " catch ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.CatchBind) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCatchLhs(p, k[0])
    fmtRaw(p, " catch ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ArrowFn) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ArrowParams) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.ArrowP) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.Call) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.Args) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.Arg) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ArgSpread) {
    fmtRaw(p, "...")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  // `name = expr` (SPEC §12.11, #3839) — always `=`, never `:`: unlike
  // `Tag.FieldInit`, which for one release accepts both spellings and
  // canonicalizes to `:` (#3840), a named argument has only ever had one.
  if (n.tag == Tag.NamedArg) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.Index) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, "[")
    fmtPrintNode(p, k[1])
    fmtRaw(p, "]")
    return
  }
  if (n.tag == Tag.SliceExpr) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, "[")
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, ":")
    if (k[2] != 0) {
      fmtPrintNode(p, k[2])
    }
    fmtRaw(p, "]")
    return
  }
  if (n.tag == Tag.Member) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TupleIndex) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.TypeAssert) {
    let k = kidsOf(p.tree, idx)
    fmtPrintAtomic(p, k[0])
    fmtRaw(p, ".(")
    fmtPrintNode(p, k[1])
    fmtRaw(p, ")")
    return
  }
  if (n.tag == Tag.TryExpr) {
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "?")
    return
  }
  if (n.tag == Tag.CompositeLit) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    let body = getNode(p.tree, k[1])
    fmtPrintCommaList(p, kidsOf(p.tree, k[1]), "{", "}", body.span.end)
    return
  }
  if (n.tag == Tag.FieldInits) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.FieldInit) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    // `main == 1` marks the shorthand `IDENT` form the parser desugars to
    // `IDENT: IDENT` (#3735) — print it back bare, never expanded, or
    // reformatting a file would silently rewrite every shorthand field.
    if (n.main == 1) {
      return
    }
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.MapEntries) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.MapEntry) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.SliceLit) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "[", "]", n.span.end)
    return
  }
  if (n.tag == Tag.StrInterp) {
    fmtRaw(p, "\"")
    let k = kidsOf(p.tree, idx)
    let i = 0
    while (i < len(k)) {
      let kn = getNode(p.tree, k[i])
      if (kn.tag == Tag.StrPart) {
        fmtRaw(p, p.source[kn.span.start:kn.span.end])
      } else if (kn.tag == Tag.MatchStmt) {
        // A `match` renders multi-line, which cannot live inside a string
        // literal; copy its (necessarily single-line) source verbatim.
        fmtRaw(p, "\${")
        fmtRaw(p, p.source[kn.span.start:kn.span.end])
        fmtRaw(p, "}")
        if (kn.span.end > p.srcPos) {
          p.srcPos = kn.span.end
        }
      } else {
        fmtRaw(p, "\${")
        fmtPrintNode(p, k[i])
        fmtRaw(p, "}")
      }
      i = i + 1
    }
    fmtRaw(p, "\"")
    return
  }
  fmtDispatchExprExtra(p, idx, n)
}

// Whether a `Unary`'s operand `tag` needs re-parenthesizing — pulled out of
// the `Unary` arm above purely to keep `fmtDispatchExpr`'s own McCabe
// complexity from growing every time one more tag joins the wrap set
// (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `fmtDispatchExpr`): each `||` here costs THIS function's complexity, never
// `fmtDispatchExpr`'s.
fn fmtUnaryOperandWrap(tag: Tag): bool {
  return tag == Tag.Binary ||
    tag == Tag.CatchDefault ||
    tag == Tag.CatchBind ||
    tag == Tag.ArrowFn ||
    tag == Tag.CondExpr
}

// The tail of `fmtDispatchExpr`'s if-chain, split out for the identical
// reason `fmtUnaryOperandWrap` above is — an unconditional call, so a new tag
// here costs nothing at the call site.
//
// `cond ? then : else` (§12, #3941). `then` and `else` never need
// re-parenthesizing here — `then` is parsed as a full `expression` and
// `else` recurses through `conditional`, so both cover everything
// `parseBinary`/`parseExpr` can naturally produce with no source parens to
// restore (fmtPrintCondCond, fmtwrap.bit, is only for `cond`).
fn fmtDispatchExprExtra(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.CondExpr) {
    let k = kidsOf(p.tree, idx)
    fmtPrintCondCond(p, k[0])
    fmtRaw(p, " ? ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " : ")
    fmtPrintNode(p, k[2])
    return
  }
  // A tuple literal `(a, b, ...)` (SPEC §12.10, #4105) — same comma-list shape
  // as `TupleType` above and `SliceLit`, just parenthesized.
  if (n.tag != Tag.TupleLit) {
    return
  }
  fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
}
