// compiler/validatetypemember.bit — the checker's judgement of `T.name` when `T`
// is a TYPE name rather than a value (#6392). Sibling of validatemember.bit
// (`vMember` dispatches here): same module, so this needs no imports.
//
// A type name has no value type, so `vMember` returned on it untouched and the
// only judge left was the lowerer, which stops at E0092 for most spellings and
// for one of them accepts a wrong answer: `E.Z`, an unknown variant, lowered to
// variant 0 because `variantOrdinal` (lowerlayout.bit) answers 0 for a name it
// cannot find, so `E.Z == E.A` ran and was true, at exit 0.
//
// What a type name's member may be (SPEC §12.5):
//   - a class: a STATIC method, and only CALLED — `K.f(1)`, `m.K.f(1)`. An
//     instance method or a field needs a value receiver, and a static method
//     is no first-class value (a method value is bound to its receiver);
//   - an enum: one of its variants, `E.A` / `E.C(1)`, written through the enum's
//     own name. Namespace-qualified enum names exist in type position only
//     (§11 `qual_type_name`), so `m.E.A` is refused with the spelling that works;
//   - a class reached through a namespace is never a value or a constructor,
//     `m.K(1)`, for the same reason: `import { K }` is the spelling that builds one.
// Everything here judges by PRESENCE in the signature tables, the same ones
// `vIsUnknownMember` reads for a value receiver, so the two cannot disagree on
// what a class has.

// The node whose kid list holds `node`, or 0. Children precede parents in
// arena order (validate.bit), so the scan starts after `node` and ends at its
// parent, which is within a statement's width of it.
fn vParentOf(c: Checker, node: int): int {
  let i = node + 1
  while (i < len(c.tree.nodes)) {
    for k of kidsOf(c.tree, i) {
      if (k == node) {
        return i
      }
    }
    i = i + 1
  }
  return 0
}

// Is `node` the callee of a call? Answered permissively: a node with no parent
// found reads as a callee, so a tree the scan cannot place is never refused.
fn vIsCallee(c: Checker, node: int): bool {
  let p = vParentOf(c, node)
  if (p == 0) {
    return true
  }
  return getNode(c.tree, p).tag == Tag.Call && kidsOf(c.tree, p)[0] == node
}

// Does `recv` spell a TYPE as the receiver of a member access: a generic
// instance (`Pair<i64, string>`), a name the resolver bound to a class, enum or
// imported item rather than to a local value, or `ns.K` naming a type exported
// through a namespace import? A local `let K = ...` is a value and judged as one.
fn vIsTypeReceiver(c: Checker, recv: int): bool {
  let tag = getNode(c.tree, recv).tag
  if (tag == Tag.GenericInst) {
    return true
  }
  if (tag == Tag.Member) {
    return userTypeLookup(c, nsQualifiedName(c, recv)) != 0
  }
  let k = vNodeSymbolKind(c, recv)
  let named = k == SymbolKind.StructType ||
    k == SymbolKind.EnumType ||
    k == SymbolKind.ImportItem ||
    k == SymbolKind.GenericParam
  return named && userTypeLookup(c, typeNodeName(c, recv)) != 0
}

// `T.name` where `T` is a type: entry point from `vMember`.
fn vTypeMember(c: Checker, node: int, kids: []int) {
  let recv = kids[0]
  let cls = staticRecvName(c, recv)
  let ut = userTypeLookup(c, cls)
  if (cls == "" || ut == 0) {
    return
  }
  if (c.ctx.types[ut].kind == TypeKind.Enum) {
    vEnumTypeMember(c, recv, ut, cls, kids[1])
    return
  }
  // A type parameter dispatches through its bound's static requirements, which
  // `staticReceiverType` answers as the constraint interface (SPEC §10.4.1).
  if (c.ctx.types[ut].kind == TypeKind.Struct || c.ctx.types[ut].kind == TypeKind.TypeParam) {
    vStructTypeMember(c, node, recv, cls, kids[1])
  }
}

// `E.name`: a variant of `E`, or a method it declares. A name neither is
// E0070, the code a `match` arm naming a missing variant already gets.
fn vEnumTypeMember(c: Checker, recv: int, ut: int, cls: string, nameNode: int) {
  let mname = nodeText(c.tree, c.source, nameNode)
  if (getNode(c.tree, recv).tag == Tag.Member) {
    let simple = nodeText(c.tree, c.source, kidsOf(c.tree, recv)[1])
    reportNoHint(
      c.diags, ecUnknownVariant, vSpan(c, nameNode),
      "'${cls}' is an enum reached through a namespace; a variant is written through the enum's own name, so import it by name and write ${simple}.${mname}",
    )
    return
  }
  let variants = vEnumVariantNames(c, ut)
  let key = "${ut}.${mname}"
  if (len(variants) == 0 || vIndexOfName(variants, mname) >= 0 || vHasKnownMember(c, key)) {
    return
  }
  if (staticMethodLookup(c, key)) {
    return
  }
  reportNoHint(
    c.diags,
    ecUnknownVariant,
    vSpan(c, nameNode),
    "no variant '${mname}' on enum '${cls}'",
  )
}

// `K.name` on a class: the one legal shape is a static method that is called.
fn vStructTypeMember(c: Checker, node: int, recv: int, cls: string, nameNode: int) {
  let mname = nodeText(c.tree, c.source, nameNode)
  let sst = staticReceiverType(c, recv, mname)
  if (sst == 0 || vBoundClash(c, userTypeLookup(c, cls), nameNode)) {
    return
  }
  let key = "${sst}.${mname}"
  if (staticMethodLookup(c, key)) {
    if (!vIsCallee(c, node)) {
      reportNoHint(
        c.diags, ecUnknownMember, vSpan(c, node),
        "static method '${mname}' of '${cls}' is not a value; call it as ${cls}.${mname}(...)",
      )
    }
    return
  }
  let why = vMemberKindClause(c, key, mname)
  if (why == "" && !vIsUnknownMember(c, sst, mname)) {
    return // a member the tables do not model (`isPersisted` on a `@table` class)
  }
  reportNoHint(
    c.diags,
    ecUnknownMember,
    vSpan(c, nameNode),
    "no static method '${mname}' on '${cls}'${why}",
  )
}

// What a non-static member is, as the clause that tells the reader the spelling
// that works; "" when `key` is neither a method nor a field.
fn vMemberKindClause(c: Checker, key: string, mname: string): string {
  if (methodSigLookup(c, key) != 0) {
    return "; '${mname}' is an instance method and needs a value receiver"
  }
  if (vHasMember(c.ctx.structFields, key)) {
    return "; '${mname}' is a field and needs a value receiver"
  }
  return ""
}

// `ns.K` where `K` is a type the namespace exports, used as a VALUE. SPEC §11
// gives it type position (`QualType`) only, so a class is not built through its
// namespace (`m.K(1)`) and a type is not an operand (`let t = m.K`); both used
// to check clean and stop in the lowerer at E0092. A `m.K.f` / `m.E.A` receiver
// is the enclosing `Member`'s to judge (`vTypeMember`), not this one's.
fn vNsTypeValue(c: Checker, node: int) {
  let qn = nsQualifiedName(c, node)
  if (qn == "" || userTypeLookup(c, qn) == 0) {
    return
  }
  let p = vParentOf(c, node)
  if (p == 0) {
    return
  }
  let pk = kidsOf(c.tree, p)
  let isHead = pk[0] == node
  let pt = getNode(c.tree, p).tag
  if (isHead && pt == Tag.Member) {
    return
  }
  let simple = nodeText(c.tree, c.source, kidsOf(c.tree, node)[1])
  if (isHead && pt == Tag.Call) {
    reportNoHint(
      c.diags, ecNotCallable, vSpan(c, node),
      "cannot build '${qn}' through its namespace: a namespace-qualified type is a type, not a constructor; import it by name and write ${simple}(...)",
    )
    return
  }
  reportNoHint(c.diags, ecNotCallable, vSpan(c, node), "'${qn}' names a type, not a value")
}

// The exported class of namespace `alias` declaring a static method `mname`, or
// "": the answer to `m.mk(1)` when `mk` is no free function but `K`'s static,
// so the diagnostic can name `m.K.mk(...)`, the spelling that resolves.
fn vNsStaticOwner(c: Checker, alias: string, mname: string): string {
  let (mid, ok) = c.namespaces[alias]
  if (!ok || mid < 0 || mid >= len(c.mods)) {
    return ""
  }
  // Two exported classes can both declare `mname`; the smallest name wins so the
  // diagnostic does not depend on map order (#7396).
  let best = ""
  for (n, _) of c.mods[mid].exports {
    let ut = userTypeLookup(c, alias + "." + n)
    if (ut != 0 &&
      c.ctx.types[ut].kind == TypeKind.Struct &&
      staticMethodLookup(c, "${ut}.${mname}") &&
      (best == "" || n < best)) {
      best = n
    }
  }
  return best
}
