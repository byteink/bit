// compiler/lowerdesc.bit — split out of lowerprim.bit for #3759 (E0200: lowerprim.bit
// hit 825 lines after adding zero-arg guards to lowerAtomic/lowerEntryOf/lowerPtrOf).
// Sibling of lowerprim.bit/lower.bit: same module, so this needs no imports and no
// call-site changes. Structural comparison descriptors (SPEC §14.6), used by
// lowerValueEq (lowerprim.bit) and by lowerlit.bit's map-literal key/value programs.

// ===========================================================================
// Structural comparison descriptors (SPEC §14.6)
//
// §14.6 makes a class comparable FIELD-WISE and a tuple ELEMENT-WISE, but both
// are one traced handle to a heap box, so the plain word compare `lowerComparison`
// emits answered "same allocation?" instead (#2105, #2113) — and the runtime map
// hashed the same handle, so an equal key missed and re-inserting it GREW the map
// (#2111).
//
// All three are fixed by one runtime walk (`descEqAgg` / `descHashAgg` in
// runtime/root/maps.bit), and that walk needs the type's shape. It cannot recover
// it at run time: the GC's `TypeInfo` distinguishes reference words from scalar
// words but not a `string` from a nested class, and a string LITERAL is a static
// `{ptr,len}` pair with no GC header to read at all. So the shape is compiled
// here into a DESCRIPTOR PROGRAM — a string constant, one byte per body word —
// and handed to the runtime at the comparison site and at `map_new`.
//
// runtime/root/maps.bit owns the grammar; this is its only producer. ONE producer
// and ONE consumer is what makes the map's hash and its equality agree by
// construction rather than by review.
// ===========================================================================

// How deep the generator will follow nested aggregates. Below the runtime's own
// `descMaxDepth` (8) on purpose, so a program can never out-nest its interpreter.
// A self-referential type (`class N { next: N }`) is what this bounds: it stops
// at 'r' — identity — which is also what Go gives such a field, since a
// recursive Go record type must reach itself through a pointer.
const descMaxDepth: int = 6

// The token budget for one whole program, counted in body words. Each nested
// aggregate is handed an equal share of what is left, so the total output is
// bounded by this number however wide or deep the type is (Power of 10 rule 3).
const descMaxWords: int = 96

// The descriptor token for a value of type `ty` occupying ONE body word.
// `budget` is the number of further words this token's own subtree may describe.
fn descToken(fc: FnCtx, ty: int, depth: int, budget: int): string {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return "s"
  }
  if (depth < descMaxDepth && (t.kind == TypeKind.Struct || t.kind == TypeKind.Tuple)) {
    let inner = descProgram(fc, ty, depth + 1, budget)
    if (inner != "") {
      return inner
    }
  }
  // Everything else reachable through a traced word — a slice, map, chan,
  // function, interface, payload enum or bare type parameter — has no value
  // equality of its own (§14.6), so it keeps the identity comparison it has
  // today. Blowing the depth or the budget lands here too, which degrades to the
  // pre-fix answer rather than to a wrong one.
  return "r"
}

// The body word slots of aggregate `ty`: `out[i]` is the type of the traced
// value occupying body word `i`, or 0 when that word holds raw bytes (scalars,
// packed sub-word fields, padding). Returns an empty slice when the layout
// cannot be read, which the caller treats as "not describable".
fn descSlots(fc: FnCtx, ty: int): []int {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Tuple) {
    return descSlotsFrom(fc, layoutFields(fc, t.members), t.members)
  }
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    return []int(0)
  }
  let oc = typeOwner(fc.c, ty)
  // `ty` is the INSTANTIATION (`Box<i64>`), whose declaration still spells the
  // field `v: T`; laying it out unsubstituted would call that integer a traced
  // reference, the same trap `lowerTypeInfo` records for the GC descriptor.
  let sub = structTySubst(fc, oc, decl, ty)
  let fields = structFieldNodes(oc, decl)
  let ftypes = []int(0)
  let i = 0
  while (i < len(fields)) {
    ftypes = append(ftypes, typeFromNodeIn(oc, kidsOf(oc.tree, fields[i])[1], sub))
    i = i + 1
  }
  return descSlotsFrom(fc, structLayout(fc, oc, decl, sub), ftypes)
}

// Records the word slots an inlined `[N]T` field at body offset `at` occupies.
// `structLayout` INLINES an array field into the class's own body rather than
// storing a handle, and does not add its elements to the GC pointer map — so this
// walk is the only thing that describes them. A scalar element leaves its word
// raw; only a reference element needs a slot. `out` is a slice, so the write is
// the caller's (SPEC §13.3).
fn descSlotsArrayInto(fc: FnCtx, out: []int, at: int, arrTy: int) {
  let ft = fc.c.ctx.types[arrTy]
  if (!fieldLayoutFor(fc, ft.elem).isPtr) {
    return
  }
  let k = 0
  while (k < ft.arrayLen) {
    let w = (at + k * 8) / 8
    if (w < len(out)) {
      out[w] = ft.elem
    }
    k = k + 1
  }
}

// The shared half of `descSlots`, over a computed layout and its field types.
fn descSlotsFrom(fc: FnCtx, layout: StructLayout, ftypes: []int): []int {
  let out = []int(layout.size / 8)
  let i = 0
  while (i < len(ftypes) && i < len(layout.offsets)) {
    if (fc.c.ctx.types[ftypes[i]].kind == TypeKind.Array) {
      descSlotsArrayInto(fc, out, layout.offsets[i], ftypes[i])
    } else if (fieldLayoutFor(fc, ftypes[i]).isPtr) {
      let w = layout.offsets[i] / 8
      if (w < len(out)) {
        out[w] = ftypes[i]
      }
    }
    i = i + 1
  }
  return out
}

// The descriptor program for the aggregate type `ty`, e.g. `"{ws}"` for
// `class P { x: int, name: string }`. Empty when `ty` has no describable
// layout or when `budget` will not cover it.
fn descProgram(fc: FnCtx, ty: int, depth: int, budget: int): string {
  let slots = descSlots(fc, ty)
  let n = len(slots)
  if (n > budget) {
    return ""
  }
  // Each word's own subtree gets an equal share of what this level leaves over,
  // so the whole program is bounded by the budget it started with.
  let share = 0
  if (n > 0) {
    share = (budget - n) / n
  }
  let out = "{"
  let i = 0
  while (i < n) {
    if (slots[i] == 0) {
      out = out + "w"
    } else {
      out = out + descToken(fc, slots[i], depth, share)
    }
    i = i + 1
  }
  return out + "}"
}

// The descriptor program for a type compared BY VALUE, or "" for a type that
// keeps its word comparison. Structs and tuples are the two §14.6 admits with a
// field/element-wise rule and a boxed representation; everything else — scalars,
// `string`, C-like enums, interfaces (identity today, see #2105's note) — is
// already handled by `lowerComparison` or has no value equality.
fn descForType(fc: FnCtx, ty: int): string {
  let k = fc.c.ctx.types[ty].kind
  if (k != TypeKind.Struct && k != TypeKind.Tuple) {
    return ""
  }
  return descProgram(fc, ty, 0, descMaxWords)
}

// Materializes a descriptor program as a pooled string constant.
fn descConst(fc: FnCtx, prog: string): int {
  let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
  ins.sval = prog
  ins.ival = internPoolString(fc, prog)
  return builderEmit(fc.b, ins)
}
