// compiler/validatetest.bit — SPEC §19's test-signature rule (#2080). Sibling
// of validate.bit and validateentry.bit: same module, so this needs no imports
// and no call-site changes beyond the one hook in `checkModule`.
//
// WHAT WAS WRONG. `injectTestMain` (compiler/testgen.bit) discovers a root
// module's tests by scanning the LOWERED IR for `test_`-named functions that
// take no parameters, return nothing, and are not fallible (SPEC §19), and
// silently drops anything else — `isTestFunc` just returns false, and the
// rejected name is gone. `bit check`, `bit build` and `bit lint` all say
// nothing about the drop, so a `test_*` function with a parameter, a non-void
// result, or a fallible `()!` result vanishes with no diagnostic anywhere. If
// the module has at least one OTHER, well-formed test, `bit test` still prints
// a green summary — the dropped test is never named, never run, and never
// counted, including when its body would have failed the suite.
//
// WHY THE CHECKER AND NOT `testCmd`. Same reasoning as validateentry.bit's
// `main` rule: the permitted shape is a property of the DECLARATION, decidable
// from the signature alone with no IR in hand, and a `test_`-prefixed function
// `bit test` cannot invoke is never intentional — the prefix is the
// declaration of intent (if a helper was meant, it would not be named
// `test_*`). Rejecting in the checker is also what makes `bit build`, `bit
// run`, `bit check` and the LSP agree with `bit test`, instead of only the
// last one ever saying anything.

// E0093: first free code above E0092 (build.bit's ecCannotLower).
const ecTestSignature = 93

// SPEC §19's permitted shape, as one hint fragment shared by every rejection
// below so the wording cannot drift between them.
fn vTestForms(): string {
  return "a test is a top-level 'fn test_<name>()', taking no parameters and returning nothing (SPEC §19)"
}

// Validates every root-module top-level `test_`-prefixed function against
// SPEC §19. No-op for every module but the root's — the same restriction
// `vEntrySignature` applies to `main`, and for the same reason here: a badly
// shaped `test_*` function in an IMPORTED module is never a candidate `bit
// test` would have discovered anyway (SPEC §19, "never in an imported one").
//
// Top-level children of the Program node, not an arena walk: this is about the
// module's own declarations, and a `Tag.MethodSig` (an interface member) must
// not be mistaken for one.
fn vTestSignature(c: Checker) {
  if (!c.entryModule) {
    return
  }
  for d of kidsOf(c.tree, c.tree.root) {
    let decl = vUnwrapExport(c, d)
    if (decl == 0 || getNode(c.tree, decl).tag != Tag.FuncDecl) {
      continue
    }
    // [recv, name, generics, params, result, body(, attrs)] — the 7th child is
    // elided when the decl carries no `@attr`, so every index read here is
    // below the width both shapes share (parser.bit).
    let kids = kidsOf(c.tree, decl)
    // A method (non-zero receiver) is never a test candidate: `isTestFunc`
    // (testgen.bit) only ever sees bare root-module names, and a method's
    // lowered name is mangled with the receiver type (`nameHasDollar`), so a
    // method named `test_x` was already excluded from discovery before this
    // rule existed and stays excluded here — the same carve-out
    // `vEntrySignature` makes for a `main` method.
    if (kids[0] != 0) {
      continue
    }
    let name = vIdentText(c, kids[1])
    if (len(name) < 5 || name[0:5] != "test_") {
      continue
    }
    vTestParams(c, name, kids)
    vTestResult(c, name, kids)
  }
}

// SPEC §19: "taking no parameters". The synthesized dispatcher
// (testgen.bit's `buildDispatch`) calls every discovered test with an empty
// argument list, so a declared parameter is never given a value. Spanning the
// Params node carets the whole list, matching `vEntryParams`'s treatment of
// `main`'s parameter list.
fn vTestParams(c: Checker, name: string, kids: []int) {
  if (kids[3] == 0 || len(kidsOf(c.tree, kids[3])) == 0) {
    return
  }
  report(c.diags, ecTestSignature, vSpan(c, kids[3]),
    "'${name}' cannot take parameters", vTestForms())
}

// The result annotation's span, falling back to the function's NAME when the
// annotation's own span is degenerate. `(): ()!` is exactly this: its `()`
// child is an empty TupleType, and `spanOfKids` (parser.bit) cannot derive a
// span from zero kids, so it falls back to `pointSpan(0, 0)` — which `vSpan`
// then renders at the MODULE's first byte, not this function's. Measured: an
// unpatched `(): ()!` carets line 1 of a multi-file module, wherever that
// happens to be, rather than the function that was actually rejected. Every
// message here already names the function, so its identifier is always a
// sound, never-degenerate place to point instead.
fn vTestResultSpan(c: Checker, kids: []int): Span {
  let raw = getNode(c.tree, kids[4]).span
  if (raw.start == 0 && raw.end == 0) {
    return vSpan(c, kids[1])
  }
  return vSpan(c, kids[4])
}

// SPEC §19: "returning nothing" — and never fallible, because `?` is only
// legal inside a fallible function (SPEC §18), so `(): ()!` is the shape a
// developer reaches for the moment a test wants to call something fallible.
// Permissive when the annotation did not resolve, THE SAFETY RULE
// (validate.bit): the undefined type name is already reported at its own
// span, and a second diagnostic naming `<error>` states nothing true about
// the program.
fn vTestResult(c: Checker, name: string, kids: []int) {
  if (kids[4] == 0) {
    return
  }
  let declared = typeFromNode(c, kids[4])
  if (vMentionsInvalid(c, declared, 0)) {
    return
  }
  if (c.ctx.types[declared].kind == TypeKind.Fallible) {
    report(c.diags, ecTestSignature, vTestResultSpan(c, kids),
      "'${name}' cannot be fallible", vTestForms())
    return
  }
  if (declared == c.ctx.voidId) {
    return
  }
  report(c.diags, ecTestSignature, vTestResultSpan(c, kids),
    "'${name}' cannot return '${typeName(c.ctx, declared)}'", vTestForms())
}
