// compiler/ircheckfailret.bit — #6982's selfcheck arm: the error path of a
// fallible function returns its ok value as a bare `const_nil` and allocates
// nothing, for every ok kind whose `zeroValue` (lowerslicefill.bit) would build
// a heap object (`zeroValueAllocates`, lowerfail.bit).
//
// The class and tuple kinds have done so since #4507 and are pinned
// behaviourally by `_tests_/cases/run_fallible_zero_ret.bit`. This pins the
// two kinds #6982 added, a boxed enum and an `[N]T` array, on the IR itself,
// because a `run` case prints the same lines whether the dead zero value is
// allocated or not. Both error-path producers are covered: `fail` and the
// propagation path of `?`.
//
// The pre-opt dump, not the optimized one: the property is that lowering
// never emits the allocation, not that a later pass happens to remove it. It
// holds with the error word on or off (`errRegEnabled`, lowerfail.bit): only
// the error's own transport differs. Every ok path here returns a value the
// function was handed, and the error is a parameter too, so a `gc_alloc`
// anywhere in these four bodies can only be the zero value.
//
// `Shape`'s variants carry payloads of different types, as pkg/toml's `Toml`
// does, so it stays one handle. An enum with one common one-word payload type
// is returned in words (`explodedEnumWordTypes`, lowerlayout.bit): its error
// path already returned zero words, and its ok path rebuilds and reads back a
// box in the pre-opt dump, which this check would misread as the zero value.
fn failRetSource(): string {
  return "enum Shape { Dot, Disc(i64), Name(string) }\n" +
    "class Oops {\n" +
    "  code: i64\n" +
    "  message(): string { return \"oops\" }\n" +
    "}\n" +
    "fn pick(s: Shape, e: Oops, n: i64): Shape! {\n" +
    "  if (n < 0) {\n" +
    "    fail e\n" +
    "  }\n" +
    "  return s\n" +
    "}\n" +
    "fn pickFwd(s: Shape, e: Oops, n: i64): Shape! {\n" +
    "  return pick(s, e, n)?\n" +
    "}\n" +
    "fn mkGrid(n: i64): [2]i64 {\n" +
    "  return [2]i64{ n, n }\n" +
    "}\n" +
    "fn grid(e: Oops, n: i64): [2]i64! {\n" +
    "  if (n < 0) {\n" +
    "    fail e\n" +
    "  }\n" +
    "  return mkGrid(n)\n" +
    "}\n" +
    "fn gridFwd(e: Oops, n: i64): [2]i64! {\n" +
    "  return grid(e, n)?\n" +
    "}\n"
}

// The dump text of function `name`, from its `func` header through its
// closing brace, or "" when the dump has no such function.
fn funcDumpSection(dump: string, name: string): string {
  let at = indexOf(dump, "func ${name}(")
  if (at < 0) {
    return ""
  }
  let rest = dump[at:len(dump)]
  let end = indexOf(rest, "\n}\n")
  if (end < 0) {
    return ""
  }
  return rest[0:end + 3]
}

fn checkFailRetNoAlloc() {
  let dump = lowerSourceDump(failRetSource())
  for name of ["pick", "pickFwd", "grid", "gridFwd"] {
    let body = funcDumpSection(dump, name)
    assert(body != "", "the dump must carry `${name}`: ${dump}")
    assert(
      indexOf(body, "gc_alloc") < 0,
      "`${name}`'s error path must allocate no zero ok value (#6982): ${body}",
    )
  }
}
