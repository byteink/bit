// compiler/checkbinddecl.bit — split out of checkbind.bit (#5642). Sibling
// of checkbind.bit and check.bit: same module, so this needs no imports and
// no call-site changes. Named-type declaration collection: minting a
// class/enum/interface's TypeId, its generics, and its members (struct
// fields, enum payloads, interface signatures) — the seed's declTypeOf tree.

// Mints a TypeId for `name`/`kind` without publishing it anywhere — the
// shared minting step behind `registerNamedType` (which also writes
// `userTypes`) and `registerGenerics`'s TypeParam arm (#5703, which must
// not: see that function).
fn mintNamedType(c: Checker, name: string, kind: TypeKind): int {
  let t = leafType(kind)
  t.name = name
  t.hasName = true
  t.declModule = c.moduleId
  return addType(c.ctx, t)
}

// Registers a class/enum/interface declaration as a named type so references
// to it resolve. Called in a pre-pass (types may be referenced before their
// declaration, §9).
// Mints a named type (class / enum / interface) and publishes it under `name`
// in `userTypes`. Records the declaring module: fields, variants and payloads
// are all read back from the decl node later, and only this module's tree can
// be indexed by it (see typeOwner).
//
// #5703: `registerGenerics` no longer routes a generic declaration's own
// parameters through here — `userTypes` now holds only names outside a
// `Checker.genericParamIds` entry. The one remaining `TypeKind.TypeParam`
// caller is `selfTypeId` (checktype.bit), minting the predeclared `Self`
// placeholder: it is not any declaration's OWN type parameter (no `genNode`
// owns it, so `genericParamIds` never lists it), it is looked up by bare name
// from anywhere in the interface body rather than from one open
// `curGenericDecl` window, and it is deliberately memoized module-wide — the
// same shape the collect pass used to have, kept because giving `Self` a
// synthetic per-declaration scope is a wider change than this ticket's.
fn registerNamedType(c: Checker, name: string, kind: TypeKind) {
  c.userTypes[name] = mintNamedType(c, name, kind)
}

// The source text of a declaration's name (kid 0 is the name leaf).
fn declName(c: Checker, node: int): string {
  let nm = getNode(c.tree, kidsOf(c.tree, node)[0])
  return c.source[nm.span.start:nm.span.end]
}

// Walks every node and types the bindings. (arrow-param and call typing land
// with expression inference; a flat arena walk catches bindings at any nesting.)
// Resolves a named-type reference, reserving+resolving it on first touch if it
// is a not-yet-seen forward reference (the seed's declTypeOf recursion). After
// the collect pass every named type is reserved, so this is a plain lookup.
fn resolveNamed(c: Checker, name: string): int {
  let id = userTypeLookup(c, name)
  if (id != 0) {
    return id
  }
  if (c.typeDecls[name] != 0) {
    return declTypeOf(c, name)
  }
  return 0
}

// Registers a `<T, U: Bound>` list: every param name first (its OWN distinct
// id), then each constraint interface — the seed's buildOwnGenericEnv order.
// `reuse` is empty for a TYPE decl's own list; for a METHOD's receiver-merged
// prefix, `collectFuncDecl` passes the receiver's OWN ids instead (#5330) —
// else sibling methods' `Query2<T>` cannot substitute at lowering time.
//
// #5703: ids are kept in `ids`/`genericParamIds` only, never published into
// `userTypes` under `pname` — that was the flat, module-wide slot the next
// same-spelled generic would overwrite (#1551/#4602). The caller
// (`declTypeOf`/`collectFuncDecl`) has already pointed `curGenericDecl` at
// `genNode` before calling this, so the constraint loop just below, which can
// reference a sibling param by name (`<T, U: Cmp<T>>`), resolves it through
// `userTypeLookup` -> `typeParamIdOf` against THIS decl's own `ids`, not a
// table write here.
fn registerGenerics(c: Checker, genNode: int, reuse: []int) {
  if (genNode == 0) {
    return
  }
  let ps = kidsOf(c.tree, genNode)
  let ids = []int(0)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    let pname = c.source[nm.span.start:nm.span.end]
    let id = 0
    if (i < len(reuse) && reuse[i] != 0) {
      id = reuse[i]
    } else {
      id = mintNamedType(c, pname, TypeKind.TypeParam)
    }
    ids = append(ids, id)
    i = i + 1
  }
  c.genericParamIds[genNode] = ids
  i = 0
  while (i < len(ps)) {
    let gk = kidsOf(c.tree, ps[i])
    if (gk[1] != 0) {
      let cons = kidsOf(c.tree, gk[1])
      if (len(cons) > 0) {
        // Key off THIS decl's param id (ids[i], minted above in the same order),
        // never the name — a name key is module-wide (#1551).
        c.typeParamConstraints[ids[i]] = typeFromNode(c, cons[0])
      }
    }
    i = i + 1
  }
}

// Puts a decl's OWN type params back in scope, by pointing `curGenericDecl` at
// this generics node instead of writing each param name into the module-wide
// `userTypes` table (#4602/#5701). Before this the name table was flat, so
// after the collect pass every `T` in the module resolved to the LAST decl to
// declare one (#1551 — `first<T: Boxy>`'s body was checked against `Wordy`'s
// `T`, and with it that param's constraint). All three check-side sweeps walk
// the arena in source order and a decl's generics node precedes its params,
// result and body, so setting the field here scopes every `userTypeLookup`
// that follows to the decl it was written in — until the sweep clears it at
// this decl's own node (checkmodule.bit), the same node arena order puts last.
fn bindGenericScope(c: Checker, genNode: int) {
  // Comma-ok, not a bare index: a lazily-resolved type decl may never have been
  // collected, and this map's value is a SLICE — a miss yields a null one, which
  // `len` faults on (both compilers, #1557).
  let (ids, ok) = c.genericParamIds[genNode]
  if (!ok) {
    return // leave curGenericDecl alone: this genNode registered nothing
  }
  let ps = kidsOf(c.tree, genNode)
  if (len(ids) != len(ps)) {
    return // not this decl's own list: leave curGenericDecl alone
  }
  c.curGenericDecl = genNode
}

// True for the five node tags a `Tag.GenericParams` list can belong to — the
// only tags `curGenericDecl` must be cleared at (#5701). Shared by every
// ascending sweep that sets the field, so the clear side names the same set
// everywhere rather than each sweep re-deriving it.
// The clear side of every ascending sweep's `isGenericDeclTag` arm (#5701):
// children precede parents in arena order, so a decl's own node is the
// last one in its subtree and ends the window `bindGenericScope` opened at
// its generics node — never leaking into whatever the next declaration
// mentions. The three call sites (`mintNominalInstantiations` and
// checkModule's pre-pass 3 and main sweep, checkmodule.bit) each point back
// here instead of repeating this paragraph.
fn isGenericDeclTag(tag: Tag): bool {
  return tag == Tag.StructDecl ||
    tag == Tag.EnumDecl ||
    tag == Tag.InterfaceDecl ||
    tag == Tag.TypeAlias ||
    tag == Tag.FuncDecl
}

// Resolves a class's field types into `structFields` (interning each in field
// order). An exported field is wrapped `export[field[name, type]]`.
fn resolveStructFields(c: Checker, node: int, sname: string) {
  let fields = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let fi = 0
  while (fi < len(fields)) {
    let fld = fields[fi]
    // The wrapper is the ONLY record that the field carries `export`, and
    // unwrapping it used to drop that fact on the floor — every consumer of
    // `structFields` then saw a private field and a public one as the same
    // thing, which is why SPEC 10.5's field visibility went unenforced for a
    // foreign read (#4631). Captured before the unwrap, recorded below.
    let exported = getNode(c.tree, fld).tag == Tag.Export
    if (exported) {
      fld = kidsOf(c.tree, fld)[0]
    }
    // An in-body method (SPEC §10.4, #3367) shares this list with fields; it
    // is a func_decl, registered separately by collectFuncDecl's own arena
    // walk (checkmodule.bit) — reading it as a field would read its receiver
    // node as a name and its generics-or-none as a type.
    if (getNode(c.tree, fld).tag != Tag.Field) {
      fi = fi + 1
      continue
    }
    let fk = kidsOf(c.tree, fld)
    let fnn = getNode(c.tree, fk[0])
    let fieldKey = "${userTypeLookup(c, sname)}." + c.source[fnn.span.start:fnn.span.end]
    c.ctx.structFields[fieldKey] = typeFromNode(c, fk[1])
    // `readonly` (SPEC §10.5, #4066) rides in the field node's own `main`
    // (parsertype.bit's parseField) — only `true` is ever recorded, the same
    // sparse convention `methodExported` uses.
    if (getNode(c.tree, fld).main == 1) {
      c.ctx.readonlyFields[fieldKey] = true
    }
    // `export` (SPEC 10.5, #4631) — same sparse convention: only `true` is
    // stored, so a missing key means module-private.
    if (exported) {
      c.ctx.exportedFields[fieldKey] = true
    }
    fi = fi + 1
  }
}

// Interns an enum's variant payload types (in variant then payload order) —
// matching the seed's buildEnumTemplate — records on the type whether any
// variant carries a payload (so the value is boxed), which codegen reads to
// classify GC references, and stores each variant's payload types in
// `ctx.variantPayloads` under the TEMPLATE's id.
//
// The template's entry holds the declaration's own bare type params; an
// instantiation gets its own substituted entry from `fillInstMembers`. This is
// the seed's `buildEnumTemplate` -> `instantiateRecursive` split. Interning
// order is unchanged: the ids still come from `typeFromNode` in the same walk,
// so recording them costs no new id.
fn resolveEnumPayloads(c: Checker, node: int, enumTy: int) {
  // `enumVariantNodes` (lowerlayout.bit) filters out any in-body method
  // (owner ruling #5216) sharing the variant_list — a method has no
  // payload_or_none kid to read as one.
  let vs = enumVariantNodes(c, node)
  let i = 0
  while (i < len(vs)) {
    let payload = kidsOf(c.tree, vs[i])[1]
    if (payload != 0) {
      c.ctx.types[enumTy].enumBoxed = true
      let types = kidsOf(c.tree, payload)
      let ptypes = []int(0)
      let j = 0
      while (j < len(types)) {
        ptypes = append(ptypes, typeFromNode(c, types[j]))
        j = j + 1
      }
      let vn = getNode(c.tree, kidsOf(c.tree, vs[i])[0])
      c.ctx.variantPayloads["${enumTy}." + c.source[vn.span.start:vn.span.end]] = ptypes
    }
    i = i + 1
  }
}

// Resolves an interface's method results into methodResults, interning each
// sig's params (source order) then result — the seed's walk. The func-type sig
// wrapper is deferred to buildSignatures (see collectFuncDecl).
fn resolveInterfaceSigs(c: Checker, node: int, iname: string) {
  let sigs = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let mi = 0
  while (mi < len(sigs)) {
    let mk = kidsOf(c.tree, sigs[mi])
    let mnn = getNode(c.tree, mk[0])
    paramTypeIds(c, mk[1])
    let mres = c.ctx.voidId
    if (mk[2] != 0) {
      mres = typeFromNode(c, mk[2])
    }
    let sname = c.source[mnn.span.start:mnn.span.end]
    c.ctx.methodResults["${userTypeLookup(c, iname)}.${sname}"] = mres
    noteTypeMethod(c.ctx, userTypeLookup(c, iname), sname)
    mi = mi + 1
  }
}

// The seed's declTypeOf: reserves `name`'s TypeId (memoized via userTypes
// presence) BEFORE resolving its members, so members' composites/forward-named
// refs intern after it (source touch order) and self/mutual references
// terminate. An alias resolves transparently to its underlying (no reserved id).
fn declTypeOf(c: Checker, name: string): int {
  let existing = userTypeLookup(c, name)
  if (existing != 0) {
    return existing
  }
  let node = c.typeDecls[name]
  if (node == 0) {
    return 0
  }
  let dn = getNode(c.tree, node)
  let k = kidsOf(c.tree, node)
  if (dn.tag == Tag.TypeAlias) {
    let u = typeFromNode(c, k[2])
    c.userTypes[name] = u
    return u
  }
  let kind = TypeKind.Struct
  if (dn.tag == Tag.EnumDecl) {
    kind = TypeKind.Enum
  } else if (dn.tag == Tag.InterfaceDecl) {
    kind = TypeKind.Interface
  }
  registerNamedType(c, name, kind)
  // #5703: opened BEFORE registerGenerics, not after — its own constraint
  // loop (`<T, U: Cmp<T>>`) and every field/payload/signature resolved below
  // need `curGenericDecl` pointed at `k[1]` to see this decl's own params via
  // `typeParamIdOf`, now that they are no longer in `userTypes`. Saved and
  // restored, not cleared to 0: `declTypeOf` recurses for a forward reference
  // (a field naming an as-yet-uncollected type triggers `declTypeOf` for it
  // from inside this decl's own field loop), so an inner call's window must
  // hand this decl's window back exactly as it found it, not blow it away —
  // the three ascending sweeps that clear-to-0 elsewhere (checkmodule.bit)
  // are not reentrant this way and do not need to.
  let saved = c.curGenericDecl
  c.curGenericDecl = k[1]
  registerGenerics(c, k[1], []int(0))
  if (dn.tag == Tag.StructDecl) {
    resolveStructFields(c, node, name)
  } else if (dn.tag == Tag.EnumDecl) {
    resolveEnumPayloads(c, node, userTypeLookup(c, name))
  } else if (dn.tag == Tag.InterfaceDecl) {
    resolveInterfaceSigs(c, node, name)
  }
  c.curGenericDecl = saved
  return userTypeLookup(c, name)
}
