fn emPeGlobals(
  module: IrModule,
  freestanding: bool,
  cellBinding: PeBinding,
  gdata: ByteBuf,
  fr: EmPeFuncsResult,
): int! {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  // ---- module-level state (§11.11) -> writable .data / zero-fill .bss -----
  // §11.11/§17.6 (#1630): a cell is never a pin, so a freestanding object
  // keeps its own module state LOCAL.
  // #2949: an all-zero cell goes to `.bss` (no file bytes), matching the ELF
  // and Mach-O paths.
  let egs = placeGlobals(module, 0, gdata, freestanding, true)?
  let egi = 0
  while (egi < len(egs.data)) {
    symbols = append(
      symbols,
      PeSymbol{
        name = egs.data[egi].name, hasSection = true,
        section = PeSectionKind.Data, offset = egs.data[egi].offset,
        size = egs.data[egi].size, binding = cellBinding, kind = PeSymKind.Object,
      },
    )
    defined[egs.data[egi].name] = true
    egi = egi + 1
  }
  relocs = peFixups(gdata, egs.fixups, PeSectionKind.Data, relocs)
  let ebi = 0
  while (ebi < len(egs.bss)) {
    symbols = append(
      symbols,
      PeSymbol{
        name = egs.bss[ebi].name, hasSection = true,
        section = PeSectionKind.Bss, offset = egs.bss[ebi].offset,
        size = egs.bss[ebi].size, binding = cellBinding, kind = PeSymKind.Object,
      },
    )
    defined[egs.bss[ebi].name] = true
    ebi = ebi + 1
  }

  fr.symbols = symbols
  fr.relocs = relocs
  return egs.bssSize
}

fn emPeReadonlyGlobals(
  module: IrModule,
  freestanding: bool,
  cellBinding: PeBinding,
  rodata: ByteBuf,
  fr: EmPeFuncsResult,
): ()! {
  let symbols = fr.symbols
  let relocs = fr.relocs
  let defined = fr.defined
  // ---- read-only module state (§11.11) -> .rdata ---------------------------
  // Placed before the string pool/TypeInfo/GC blobs so a table's own
  // alignment padding is measured from the start of the section (mirrors
  // emitElfObject's ordering).
  let ro = placeReadonlyGlobals(module, rodata, freestanding)?
  for rp of ro.placements {
    symbols = append(
      symbols,
      PeSymbol{
        name = rp.name, hasSection = true,
        section = PeSectionKind.Rodata, offset = rp.offset, size = rp.size,
        binding = cellBinding, kind = PeSymKind.Object,
      },
    )
    defined[rp.name] = true
  }
  relocs = peFixups(rodata, ro.fixups, PeSectionKind.Rodata, relocs)

  fr.symbols = symbols
  fr.relocs = relocs
}
