// Copy-root ALIASES for the linear-scan allocator (#3738): the private scan
// copy, each root widened over its aliases, the scan order without them, and
// the location every alias takes from its root. Moved verbatim out of
// compiler/regalloc.bit (#7781) at the 800-line limit; same module, see
// regalloc.bit for the allocator overview.

// A private, element-wise copy of the caller's intervals. LiveInterval is a
// class, so widening one in place below would reach back into the array
// codegen keeps and re-reads (arm64compile.bit's savedGpr scan walks it).
fn copyIntervals(intervals: []LiveInterval): []LiveInterval {
  let out = []LiveInterval(0)
  let i = 0
  while (i < len(intervals)) {
    let iv = intervals[i]
    out = append(
      out,
      LiveInterval{
        vreg = iv.vreg, regClass = iv.regClass, start = iv.start,
        end = iv.end, isRef = iv.isRef, uses = iv.uses, remat = iv.remat,
        rematWide = iv.rematWide,
        heapDerived = iv.heapDerived, weight = iv.weight, freq = iv.freq,
        folded = iv.folded, filler = iv.filler, hint = iv.hint, tie = iv.tie,
        use1 = iv.use1, use2 = iv.use2, last1 = iv.last1, last2 = iv.last2,
      },
    )
    i = i + 1
  }
  return out
}

// Folds alias `i`'s range, reads and flags into its root's interval `rp`; see
// `mergeAliases` for why the root must cover every alias it shares a register
// with.
fn widenRoot(scan: []LiveInterval, rp: int, i: int) {
  if (scan[i].start < scan[rp].start) {
    scan[rp].start = scan[i].start
  }
  if (scan[i].end > scan[rp].end) {
    scan[rp].end = scan[i].end
  }
  // The reads move with the range: root and alias share ONE location, so
  // spilling the root reloads at the alias's use sites too. Leaving them
  // behind would price a coalesced interval below what it costs.
  scan[rp].uses = scan[rp].uses + scan[i].uses
  mergeLastReads(scan[rp], scan[i])
  scan[rp].weight = scan[rp].weight + scan[i].weight
  // #4666: and the root loses `remat`. Rematerialization is per-USE and
  // reads the DEFINITION of the vreg being read — `getInt` asks
  // `rematSpilledConst(cx, vreg, ...)` about `f.instrs[vreg]`. An alias
  // reads through its own vreg, whose instruction is a `block_param`, not a
  // constant; with no slot behind it that read has nothing to recompute and
  // nothing to load. So a root that acquires an alias is no longer
  // rematerializable, whatever its own definition is -- unless the alias
  // is too: #5786's threaded-constant parameter (arm64remat.bit), whose
  // value is its root's because only copies join a root.
  scan[rp].remat = scan[rp].remat && scan[i].remat
  scan[rp].rematWide = scan[rp].rematWide || scan[i].rematWide
  scan[rp].folded = false // #6839: the alias's reads are not folds
  // The reference moves to the root along with the range. Clearing it here
  // rather than filtering aliases out of the stack-map walk is what keeps
  // that walk exactly as it was: an alias would otherwise report the shared
  // register a second time at the same safepoint.
  if (scan[i].isRef) {
    scan[rp].isRef = true
    scan[i].isRef = false
  }
  scan[rp].heapDerived = scan[rp].heapDerived || scan[i].heapDerived
  if (scan[rp].hint < 0) {
    scan[rp].hint = scan[i].hint // #7274: one location, so one preference
  }
}

// Widens each root's interval in `scan` to the union of its own and every alias
// that shares it, and reports which positions are aliases. The union is what
// keeps the shared register reserved for as long as ANY of them is live; without
// it the root expires early and the scan hands the register away while the alias
// still reads it.
fn mergeAliases(scan: []LiveInterval, posOf: []int, roots: []int): []bool {
  let alias = []bool(0)
  let i = 0
  while (i < len(scan)) {
    alias = append(alias, false)
    i = i + 1
  }
  if (len(roots) == 0) {
    return alias
  }
  assert(len(roots) == len(scan))
  i = 0
  while (i < len(scan)) {
    let v = scan[i].vreg
    let r = roots[v]
    if (r != v) {
      assert(r >= 0 && r < len(scan))
      assert(roots[r] == r) // computeCopyRoots normalizes; a chain would alias a spilled entry
      let rp = posOf[r]
      assert(scan[rp].regClass == scan[i].regClass)
      widenRoot(scan, rp, i)
      alias[i] = true
    }
    i = i + 1
  }
  return alias
}

// The scan order with every alias and every folded value dropped: an alias
// takes its root's location afterwards, a folded value (#6839) needs none, and
// neither may compete for a register of its own. A filler stays (#7577): the
// scan visits it for `relieveAt`, never for a register.
fn rootOrder(order: []int, alias: []bool, scan: []LiveInterval): []int {
  let out = []int(0)
  let i = 0
  while (i < len(order)) {
    let iv = scan[order[i]]
    if (!alias[order[i]] && (!iv.folded || iv.filler)) {
      out = append(out, order[i])
    }
    i = i + 1
  }
  return out
}

// Hands every alias the location its root was given.
fn propagateAliasLocations(locations: []RegLoc, scan: []LiveInterval, alias: []bool, roots: []int) {
  let i = 0
  while (i < len(scan)) {
    if (alias[i]) {
      locations[scan[i].vreg] = locations[roots[scan[i].vreg]]
    }
    i = i + 1
  }
}
