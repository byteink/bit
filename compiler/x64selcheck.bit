// In-Bit self-checks for x86-64 canonicalization and instruction selection.
// Split out of selfcheck.bit (#1503); sibling .bit files are the same module,
// so `selfcheck()` still calls these directly.
//
// compiler/x64selcheckmem.bit holds the checks for conversion, constant
// materialization, shifts, memory access, the prologue/epilogue, and the
// value/gc-alloc selectors, split out of this file at 797 lines against the
// 800-line limit (#3141).

fn checkX64Canon() {
  // Goldens from the assembler. These restore the width-canonical invariant —
  // the SHA-256/ChaCha20 prerequisite (#1158). Without it a narrow add followed
  // by a rotate reads the overflow bits the add left above the type width.

  // movsbq %al, %rax -> 48 0f be c0 ; movzbq -> 48 0f b6 c0
  let b = newX64Buf()
  xExtendReg(b, XReg64.Rax, 1, true)
  assert(xHex(b) == "480fbec0")
  let b2 = newX64Buf()
  xExtendReg(b2, XReg64.Rax, 1, false)
  assert(xHex(b2) == "480fb6c0")

  // movswq %ax, %rax -> 48 0f bf c0 ; movzwq -> 48 0f b7 c0
  let b3 = newX64Buf()
  xExtendReg(b3, XReg64.Rax, 2, true)
  assert(xHex(b3) == "480fbfc0")
  let b4 = newX64Buf()
  xExtendReg(b4, XReg64.Rax, 2, false)
  assert(xHex(b4) == "480fb7c0")

  // movslq %eax, %rax -> 48 63 c0
  let b5 = newX64Buf()
  xExtendReg(b5, XReg64.Rax, 4, true)
  assert(xHex(b5) == "4863c0")

  // The 32-bit UNSIGNED case is a plain 32-bit mov: it zero-extends into the
  // full 64 for free. REX.W here would keep all 64 bits and defeat the point,
  // leaving a value that is NOT canonical for a u32.
  // (The assembler writes `mov %eax,%eax` as 89 c0 — the same instruction with
  // the direction bit flipped; identical effect when src == dst.)
  let b6 = newX64Buf()
  xExtendReg(b6, XReg64.Rax, 4, false)
  assert(xHex(b6) == "8bc0")
  assert(b6.code[0] != u8(0x48)) // no REX.W

  // Extended registers: movsbq %r13b, %r13 -> 4d 0f be ed
  let b7 = newX64Buf()
  xExtendReg(b7, XReg64.R13, 1, true)
  assert(xHex(b7) == "4d0fbeed")
  // mov %r13d, %r13d -> 45 8b ed (REX.R and REX.B, no W)
  let b8 = newX64Buf()
  xExtendReg(b8, XReg64.R13, 4, false)
  assert(xHex(b8) == "458bed")

  // 8 bytes: nothing to do, the register width already IS the type width.
  let b9 = newX64Buf()
  xExtendReg(b9, XReg64.Rax, 8, true)
  assert(len(b9.code) == 0)

  // Signed and unsigned must never encode the same at any width — that is the
  // difference between -1 and 255.
  let w = 1
  while (w <= 4) {
    let s = newX64Buf()
    let u = newX64Buf()
    xExtendReg(s, XReg64.Rax, w, true)
    xExtendReg(u, XReg64.Rax, w, false)
    assert(xHex(s) != xHex(u))
    w = w * 2
  }
}

fn checkX64CanonNarrow() {
  // canonNarrow is a no-op at 64 bits and for floats: the register width
  // already equals the type width there.
  let b = newX64Buf()
  xCanonNarrow(b, XReg64.Rax, mkWidth(8, RegClass.Int, true))
  assert(len(b.code) == 0)
  let b2 = newX64Buf()
  xCanonNarrow(b2, XReg64.Rax, mkWidth(8, RegClass.Float, false))
  assert(len(b2.code) == 0)
  // A float of any width never narrows — it is not an integer register.
  let b3 = newX64Buf()
  xCanonNarrow(b3, XReg64.Rax, mkWidth(4, RegClass.Float, false))
  assert(len(b3.code) == 0)

  // Narrow ints DO narrow, and signedness picks the extension.
  let b4 = newX64Buf()
  xCanonNarrow(b4, XReg64.Rax, mkWidth(1, RegClass.Int, true))
  assert(xHex(b4) == "480fbec0") // movsbq
  let b5 = newX64Buf()
  xCanonNarrow(b5, XReg64.Rax, mkWidth(2, RegClass.Int, false))
  assert(xHex(b5) == "480fb7c0") // movzwq
}

fn checkX64Operands() {
  // A vreg with a register: getInt returns it and emits NOTHING — no reload.
  let cx = xTestCtx()
  let r = xGetInt(cx, 0, xScratch1())
  assert(r == XReg64.Rax)
  assert(len(cx.buf.code) == 0)

  // A SPILLED vreg: reloaded into the scratch, which is what is returned. One
  // saved GPR sits above the spill area, so slot 0 is at rbp-16, not rbp-8 —
  // a reload from the wrong offset reads the saved register instead.
  let cx2 = xTestCtx()
  let r2 = xGetInt(cx2, 1, xScratch1())
  assert(r2 == xScratch1())
  assert(xSpillOffset(cx2.frame, 0) == -16)
  // {disp32} mov -16(%rbp), %r11 -> 4c 8b 9d f0 ff ff ff
  assert(xHex(cx2.buf) == "4c8b9df0ffffff")

  // putInt to a register vreg is a plain move...
  let cx3 = xTestCtx()
  xPutInt(cx3, 0, xScratch1())
  assert(xHex(cx3.buf) == "4c89d8") // mov %r11, %rax
  // ...and to a spilled one, a store to its slot.
  let cx4 = xTestCtx()
  xPutInt(cx4, 1, xScratch1())
  // {disp32} mov %r11, -16(%rbp) -> 4c 89 9d f0 ff ff ff
  assert(xHex(cx4.buf) == "4c899df0ffffff")

  // A put to a vreg already in the target register emits nothing.
  let cx5 = xTestCtx()
  xPutInt(cx5, 0, XReg64.Rax)
  assert(len(cx5.buf.code) == 0)

  // Floats take the same shape but through the xmm file: a register operand
  // costs nothing, a spilled one reloads through the float scratch.
  let cx6 = xTestCtx()
  let f = xGetFloat(cx6, 0, xFScratch1())
  assert(f == XmmReg.Xmm0 && len(cx6.buf.code) == 0)
  let cx7 = xTestCtx()
  let f2 = xGetFloat(cx7, 1, xFScratch1())
  assert(f2 == xFScratch1() && len(cx7.buf.code) > 0)
  assert(cx7.buf.code[0] == u8(0xF2)) // movsd, not a GPR load
}

fn checkX64Ploc() {
  // plocOf bridges to the architecture-neutral parallel-move sequencer: a
  // register vreg becomes a reg PLoc, a spilled one an rbp-relative mem PLoc.
  let cx = xTestCtx()
  let p = xPlocOf(cx, 0, RegClass.Int)
  assert(p.isReg && p.v == xRegNum(XReg64.Rax))
  let p2 = xPlocOf(cx, 1, RegClass.Int)
  assert(!p2.isReg && p2.v == -16)

  // The SAME vreg index resolves through a different file per class — reading
  // the int file for a float vreg would name an unrelated register.
  let p3 = xPlocOf(cx, 0, RegClass.Float)
  assert(p3.isReg && p3.v == xmmNum(XmmReg.Xmm0))
  // rax is 0 and xmm0 is 0, so pick an index where the two files disagree.
  cx.intRegs = [XReg64.R13]
  cx.floatRegs = [XmmReg.Xmm7]
  let p4 = xPlocOf(cx, 0, RegClass.Int)
  let p5 = xPlocOf(cx, 0, RegClass.Float)
  assert(p4.v == 13 && p5.v == 7)
}

fn checkX64BinarySel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // dst=0 (rax), lhs=0 (rax), rhs=1 (spilled). Both operands route through
  // scratch, the op computes there, the result is written back.
  let cx = xTestCtx()
  xEmitBinaryInt(cx, XArith.Add, 0, 0, 1, w64)
  // reload rhs from -16(%rbp) into r10, mov rax->r11, add r10 into r11,
  // mov r11->rax.
  //   4c 8b 95 f0 ff ff ff   mov -16(%rbp), %r10
  //   49 89 c3               mov %rax, %r11
  //   4d 01 d3               add %r10, %r11
  //   4c 89 d8               mov %r11, %rax
  assert(xHex(cx.buf) == "4c8b95f0ffffff4989c34d01d34c89d8")

  // A 64-bit add needs no re-narrowing: the register width IS the type width.
  let cx2 = xTestCtx()
  xEmitBinaryInt(cx2, XArith.Add, 0, 0, 0, w64)
  assert(len(cx2.buf.code) == 3 + 3 + 3) // mov, add, mov — no extend

  // A NARROW add must re-narrow: an add can carry bits past the type width, and
  // leaving them breaks every later shift/compare (#1158).
  let cx3 = xTestCtx()
  xEmitBinaryInt(cx3, XArith.Add, 0, 0, 0, mkWidth(4, RegClass.Int, false))
  assert(len(cx3.buf.code) > len(cx2.buf.code))

  // Bitwise ops carry canonical inputs to a canonical output, so they add NO
  // narrowing even at a narrow width — that is the point of the invariant.
  let cx4 = xTestCtx()
  xEmitBinaryInt(cx4, XArith.And, 0, 0, 0, mkWidth(4, RegClass.Int, false))
  assert(len(cx4.buf.code) == 9)
  let cx5 = xTestCtx()
  xEmitBinaryInt(cx5, XArith.Xor, 0, 0, 0, mkWidth(1, RegClass.Int, true))
  assert(len(cx5.buf.code) == 9)

  // A product overflows its width readily, so mul always re-narrows when narrow.
  let cx6 = xTestCtx()
  xEmitMulInt(cx6, 0, 0, 0, noPow2Factor(), mkWidth(2, RegClass.Int, true))
  let cx7 = xTestCtx()
  xEmitMulInt(cx7, 0, 0, 0, noPow2Factor(), w64)
  assert(len(cx6.buf.code) > len(cx7.buf.code))

  // #1853: a constant RHS within imm32 range folds into a single group-1
  // immediate op -- no separate reload of the constant into a register.
  // Overwrites vreg 1's fixture slot (normally a BlockParam) with a real
  // const_int so xConstIntOf reads genuine IR rather than a fixture
  // stand-in that could never be const -- the vacuous-guard trap: with
  // #1853 fully reverted, a fixture that never carries a const_int would
  // still pass every check above without ever exercising the fold.
  let cxFold = xTestCtx()
  let cFold = mkInstr(Op.ConstInt, 0)
  cFold.ival = 5
  cxFold.f.instrs[1] = cFold
  xEmitBinaryInt(cxFold, XArith.Add, 0, 0, 1, w64)
  // mov %rax,%r11 ; add $5,%r11 (always the imm32 form, never the shorter
  // imm8 -- the encoder is uniform on purpose, like checkX64GcAlloc's
  // shadow-space probe below) ; mov %r11,%rax.
  assert(xHex(cxFold.buf) == "4989c34981c3050000004c89d8")
  assert(len(cxFold.buf.code) < len(cx.buf.code)) // no reload of the constant

  // Out of imm32 range: the constant cannot fit a single immediate op, so it
  // must still materialize through the same register+register path as an
  // ordinary (non-const) operand -- byte-identical to the very first check.
  let cxBig = xTestCtx()
  let cBig = mkInstr(Op.ConstInt, 0)
  cBig.ival = 4294967296 // 2^32, outside the signed imm32 range
  cxBig.f.instrs[1] = cBig
  xEmitBinaryInt(cxBig, XArith.Add, 0, 0, 1, w64)
  assert(xHex(cxBig.buf) == xHex(cx.buf))

  // Add is commutative, so a leading literal (`5 + x`) folds the same way
  // with the operands swapped -- vreg 1 becomes the constant and vreg 0 (the
  // cheap, already-in-register operand) is what gets kept, so this reduces
  // to the identical instruction sequence as the rhs-const case above.
  let cxLhs = xTestCtx()
  let cLhs = mkInstr(Op.ConstInt, 0)
  cLhs.ival = 5
  cxLhs.f.instrs[1] = cLhs
  xEmitBinaryInt(cxLhs, XArith.Add, 0, 1, 0, w64)
  assert(xHex(cxLhs.buf) == xHex(cxFold.buf))

  // Sub is NOT commutative (`k - x` != `x - k`), so only its rhs is ever
  // folded -- a constant lhs must still take the full register+register path,
  // the same length as Add's (the opcode differs, the shape does not).
  let cxSubLhs = xTestCtx()
  let cSubLhs = mkInstr(Op.ConstInt, 0)
  cSubLhs.ival = 5
  cxSubLhs.f.instrs[0] = cSubLhs
  xEmitBinaryInt(cxSubLhs, XArith.Sub, 0, 0, 1, w64)
  assert(len(cxSubLhs.buf.code) == len(cx.buf.code))
}

fn checkX64DivSel() {
  let w64 = mkWidth(8, RegClass.Int, true)

  // The dividend's HIGH half must be primed correctly or the quotient is wildly
  // wrong rather than faulting: cqo sign-extends rax into rdx:rax for signed,
  // xor zeroes rdx for unsigned. Using one for the other is the bug.
  let cx = xTestCtx()
  xEmitDivInt(cx, XDivOp.SDiv, 0, 0, 0, -1, w64)
  // mov %rax,%rax (elided), cqo (48 99), idiv %rax (48 f7 f8), mov %rax,%rax
  // (elided) — so just the two middle instructions, as a SUFFIX: #2016's
  // div-zero check (test/jcc/call) now precedes them.
  assert(xHex(cx.buf)[len(xHex(cx.buf)) - 10:len(xHex(cx.buf))] == "489948f7f8")

  let cx2 = xTestCtx()
  xEmitDivInt(cx2, XDivOp.UDiv, 0, 0, 0, -1, w64)
  // xor %edx,%edx (31 d2), div %rax (48 f7 f0), as a suffix for the same reason.
  assert(xHex(cx2.buf)[len(xHex(cx2.buf)) - 10:len(xHex(cx2.buf))] == "31d248f7f0")
  // Signed and unsigned must differ — both in the priming AND the opcode.
  assert(xHex(cx.buf) != xHex(cx2.buf))

  // The quotient comes from rax, the REMAINDER from rdx. Taking the wrong one
  // returns a plausible number that is simply not the answer.
  let cx3 = xTestCtx()
  cx3.intRegs = [XReg64.Rbx] // dst vreg 0 -> rbx, so the final move is visible
  xEmitDivInt(cx3, XDivOp.SDiv, 0, 0, 0, -1, w64)
  let cx4 = xTestCtx()
  cx4.intRegs = [XReg64.Rbx]
  xEmitDivInt(cx4, XDivOp.SRem, 0, 0, 0, -1, w64)
  assert(xHex(cx3.buf) != xHex(cx4.buf))
  // sdiv's result move is `mov %rax, %rbx` (48 89 c3); srem's is
  // `mov %rdx, %rbx` (48 89 d3).
  assert(xHex(cx3.buf)[len(xHex(cx3.buf)) - 6:len(xHex(cx3.buf))] == "4889c3")
  assert(xHex(cx4.buf)[len(xHex(cx4.buf)) - 6:len(xHex(cx4.buf))] == "4889d3")

  // #1702: xConstPow2Divisor recognizes ONLY a known, positive, power-of-two
  // divisor -- everything else must keep dividing for real (a wrong "yes"
  // here would silently change what the program computes, not just how).
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let oneBlock = [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }]

  let c8 = mkInstr(Op.ConstInt, i64t)
  c8.ival = 8
  let fEight = IrFunc{ name: "e", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c8], isFallible: false }
  assert(xConstPow2Divisor(fEight, 0, w64) == 3) // 8 == 2^3

  let c7 = mkInstr(Op.ConstInt, i64t)
  c7.ival = 7
  let fSeven = IrFunc{ name: "s", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c7], isFallible: false }
  assert(xConstPow2Divisor(fSeven, 0, w64) == -1) // not a power of two

  let cNeg8 = mkInstr(Op.ConstInt, i64t)
  cNeg8.ival = -8
  let fNeg8 = IrFunc{ name: "n", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [cNeg8], isFallible: false }
  assert(xConstPow2Divisor(fNeg8, 0, w64) == -1) // signed: negative divisor declined

  let c1 = mkInstr(Op.ConstInt, i64t)
  c1.ival = 1
  let fOne = IrFunc{ name: "o", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c1], isFallible: false }
  assert(xConstPow2Divisor(fOne, 0, w64) == -1) // divisor 1: no shift needed

  let c0 = mkInstr(Op.ConstInt, i64t)
  c0.ival = 0
  let fZero = IrFunc{ name: "z", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c0], isFallible: false }
  assert(xConstPow2Divisor(fZero, 0, w64) == -1) // divide-by-zero must still panic at runtime

  let notConst = mkInstr(Op.BlockParam, i64t)
  let fVar = IrFunc{ name: "v", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 1 }],
    instrs: [notConst], isFallible: false }
  assert(xConstPow2Divisor(fVar, 0, w64) == -1) // a non-constant divisor is never recognized

  // The fast path really does bypass idiv: no cqo/idiv/div bytes appear, and
  // the signed and unsigned forms differ (the signed one needs the extra
  // bias-then-shift instructions the unsigned one does not).
  let cxU = xTestCtx()
  xEmitDivInt(cxU, XDivOp.UDiv, 0, 0, 0, 3, w64)
  let cxS = xTestCtx()
  xEmitDivInt(cxS, XDivOp.SDiv, 0, 0, 0, 3, w64)
  assert(xHex(cxU.buf) != xHex(cxS.buf))
  assert(xHex(cxU.buf) != xHex(cx2.buf)) // not the real udiv sequence
  assert(xHex(cxS.buf) != xHex(cx.buf)) // not the real sdiv sequence

  // #1704: SRem/URem by the same known power-of-two divisor take the
  // identical fast path -- no idiv/cqo, and distinct from both each other
  // and from the SDiv/UDiv sequences above (URem is a single AND; SRem needs
  // the bias-then-mask-then-subtract sequence).
  let cxUR = xTestCtx()
  xEmitDivInt(cxUR, XDivOp.URem, 0, 0, 0, 3, w64)
  let cxSR = xTestCtx()
  xEmitDivInt(cxSR, XDivOp.SRem, 0, 0, 0, 3, w64)
  assert(xHex(cxUR.buf) != xHex(cxSR.buf))
  assert(xHex(cxUR.buf) != xHex(cxU.buf))
  assert(xHex(cxSR.buf) != xHex(cxS.buf))
  assert(xHex(cxUR.buf) != xHex(cx2.buf)) // not the real urem sequence
  assert(xHex(cxSR.buf) != xHex(cx4.buf)) // not the real srem sequence

  // #2263: a narrow signed div re-narrows its quotient -- INT_MIN/-1 is the
  // one operand pair where the 64-bit idiv (operands live sign-extended)
  // leaves a result outside the declared width, so it needs the same
  // re-canonicalization every other width-breaking op already gets.
  let w32s = mkWidth(4, RegClass.Int, true)
  let cxNarrow = xTestCtx()
  xEmitDivInt(cxNarrow, XDivOp.SDiv, 0, 0, 0, -1, w32s)
  assert(len(cxNarrow.buf.code) > len(cx.buf.code)) // extra movsxd over the w64 sequence
}

// #3105, the multiply twin of the divisor lookup above. Multiplication is
// COMMUTATIVE, so BOTH operand positions are checked and `8 * x` reduces like
// `x * 8`, shifting the operand LEFT -- shifting the constant would compute
// 8 << 3, a plausible number that is not the answer. Reusing
// xConstPow2Divisor's rule keeps 7, -8, 1, 0 and a non-constant on imul.
fn checkX64Pow2MulSel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let c8 = mkInstr(Op.ConstInt, i64t)
  c8.ival = 8
  // instr 0 is the variable operand, instr 1 the constant 8.
  let f = IrFunc{ name: "m", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 2 }],
    instrs: [mkInstr(Op.BlockParam, i64t), c8], isFallible: false }
  let byRhs = xConstPow2Factor(f, 0, 1, w64)
  assert(byRhs.k == 3 && byRhs.value == 0) // x * 8
  let byLhs = xConstPow2Factor(f, 1, 0, w64)
  assert(byLhs.k == 3 && byLhs.value == 0) // 8 * x — same verdict, same operand
  assert(xConstPow2Factor(f, 0, 0, w64).k == -1) // x * x stays a real multiply

  // The fast path bypasses imul (0f af) entirely, and needs no bias at any
  // width or signedness the way xEmitPow2DivInt does: mov %rax,%r11 ;
  // shl $3,%r11 ; mov %r11,%rax.
  let cxM = xTestCtx()
  xEmitPow2MulInt(cxM, 0, 0, 3, w64)
  assert(xHex(cxM.buf) == "4989c349c1e3034c89d8")
}

fn checkX64UnarySel() {
  // neg and not both set bits above the type width, so both re-narrow.
  let narrow = mkWidth(1, RegClass.Int, true)
  let cxN = xTestCtx()
  xEmitUnaryInt(cxN, true, 0, 0, narrow)
  let cxW = xTestCtx()
  xEmitUnaryInt(cxW, true, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(len(cxN.buf.code) > len(cxW.buf.code))

  // neg (F7 /3) and not (F7 /2) share a group and differ only by the digit.
  let cx1 = xTestCtx()
  xEmitUnaryInt(cx1, true, 0, 0, mkWidth(8, RegClass.Int, true))
  let cx2 = xTestCtx()
  xEmitUnaryInt(cx2, false, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(xHex(cx1.buf) != xHex(cx2.buf))
}

fn checkX64Icmp() {
  // cmp, setcc, movzx — in that order. The movzx comes AFTER because setcc must
  // read the flags cmp set; zeroing the destination first would clobber them.
  let cx = xTestCtx()
  xEmitIcmp(cx, ccE(), 0, 0, 0)
  //   48 39 c0        cmp %rax, %rax
  //   41 0f 94 c3     sete %r11b (REX.B — r11 is an extended register)
  //   4d 0f b6 db     movzbq %r11b, %r11
  //   4c 89 d8        mov %r11, %rax
  assert(xHex(cx.buf) == "4839c0410f94c34d0fb6db4c89d8")

  // Signed and unsigned compares must differ — that is -1 vs a huge positive.
  let cxS = xTestCtx()
  xEmitIcmp(cxS, ccL(), 0, 0, 0)
  let cxU = xTestCtx()
  xEmitIcmp(cxU, ccB(), 0, 0, 0)
  assert(xHex(cxS.buf) != xHex(cxU.buf))
}

fn checkX64Fcmp() {
  // IEEE, not just "icmp with float codes". ucomis sets PF when either operand
  // is NaN (unordered), and each case handles it.

  // GT/GE use the unsigned above codes directly, operands in order.
  let cxGt = xTestCtx()
  xEmitFcmp(cxGt, XFCmp.FGt, 0, 0, 0, 8)
  let cxGe = xTestCtx()
  xEmitFcmp(cxGe, XFCmp.FGe, 0, 0, 0, 8)
  assert(xHex(cxGt.buf) != xHex(cxGe.buf))

  // LT/LE SWAP the operands rather than use the signed codes — the signed codes
  // read TRUE on an unordered result, so `NaN < x` would come out true.
  // With both operands the same vreg the swap is invisible, so use distinct
  // ones: vreg 0 is in a register, vreg 1 is spilled.
  let cxLt = xTestCtx()
  xEmitFcmp(cxLt, XFCmp.FLt, 0, 0, 1, 8)
  let cxGt2 = xTestCtx()
  xEmitFcmp(cxGt2, XFCmp.FGt, 0, 0, 1, 8)
  // Both use `seta`, so they differ ONLY in the ucomis operand order — which is
  // exactly the swap.
  assert(xHex(cxLt.buf) != xHex(cxGt2.buf))

  // EQ is "equal AND ordered": ucomis sets ZF for equal AND for unordered, so
  // `sete` alone would make NaN == NaN true. Two setccs combined with and8.
  let cxEq = xTestCtx()
  xEmitFcmp(cxEq, XFCmp.FEq, 0, 0, 0, 8)
  // NE is "not-equal OR unordered", so NaN != NaN stays true.
  let cxNe = xTestCtx()
  xEmitFcmp(cxNe, XFCmp.FNe, 0, 0, 0, 8)
  assert(xHex(cxEq.buf) != xHex(cxNe.buf))
  // Both emit TWO setccs plus a combine — strictly more than an ordered
  // compare, which is the cost of getting NaN right.
  assert(len(cxEq.buf.code) > len(cxGt.buf.code))
  assert(len(cxNe.buf.code) > len(cxGt.buf.code))

  // The COMBINE op is where eq and ne actually diverge, and it must be checked
  // directly: eq is (equal AND ordered) via and8 (0x20), ne is (not-equal OR
  // unordered) via or8 (0x08). Comparing the two sequences wholesale is not
  // enough — they already differ in their setcc codes, so a swapped combine
  // slips through. Using and8 for ne makes NaN != NaN false, which is wrong.
  assert(xEmitContains(cxEq.buf, 0x20)) // and8
  assert(!xEmitContains(cxEq.buf, 0x08))
  assert(xEmitContains(cxNe.buf, 0x08)) // or8
  assert(!xEmitContains(cxNe.buf, 0x20))
}
