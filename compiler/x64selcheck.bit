// In-Bit self-checks for x86-64 canonicalization and instruction selection.
// Split out of selfcheck.bit (#1503); sibling .bit files are the same module,
// so `selfcheck()` still calls these directly.

function checkX64Canon() {
  // Goldens from the assembler. These restore the width-canonical invariant —
  // the SHA-256/ChaCha20 prerequisite (#1158). Without it a narrow add followed
  // by a rotate reads the overflow bits the add left above the type width.

  // movsbq %al, %rax -> 48 0f be c0 ; movzbq -> 48 0f b6 c0
  let b = newX64Buf()
  xExtendReg(b, XReg64.Rax, 1, true)
  assert(xHex(b) == "480fbec0")
  let b2 = newX64Buf()
  xExtendReg(b2, XReg64.Rax, 1, false)
  assert(xHex(b2) == "480fb6c0")

  // movswq %ax, %rax -> 48 0f bf c0 ; movzwq -> 48 0f b7 c0
  let b3 = newX64Buf()
  xExtendReg(b3, XReg64.Rax, 2, true)
  assert(xHex(b3) == "480fbfc0")
  let b4 = newX64Buf()
  xExtendReg(b4, XReg64.Rax, 2, false)
  assert(xHex(b4) == "480fb7c0")

  // movslq %eax, %rax -> 48 63 c0
  let b5 = newX64Buf()
  xExtendReg(b5, XReg64.Rax, 4, true)
  assert(xHex(b5) == "4863c0")

  // The 32-bit UNSIGNED case is a plain 32-bit mov: it zero-extends into the
  // full 64 for free. REX.W here would keep all 64 bits and defeat the point,
  // leaving a value that is NOT canonical for a u32.
  // (The assembler writes `mov %eax,%eax` as 89 c0 — the same instruction with
  // the direction bit flipped; identical effect when src == dst.)
  let b6 = newX64Buf()
  xExtendReg(b6, XReg64.Rax, 4, false)
  assert(xHex(b6) == "8bc0")
  assert(b6.code[0] != u8(0x48)) // no REX.W

  // Extended registers: movsbq %r13b, %r13 -> 4d 0f be ed
  let b7 = newX64Buf()
  xExtendReg(b7, XReg64.R13, 1, true)
  assert(xHex(b7) == "4d0fbeed")
  // mov %r13d, %r13d -> 45 8b ed (REX.R and REX.B, no W)
  let b8 = newX64Buf()
  xExtendReg(b8, XReg64.R13, 4, false)
  assert(xHex(b8) == "458bed")

  // 8 bytes: nothing to do, the register width already IS the type width.
  let b9 = newX64Buf()
  xExtendReg(b9, XReg64.Rax, 8, true)
  assert(len(b9.code) == 0)

  // Signed and unsigned must never encode the same at any width — that is the
  // difference between -1 and 255.
  let w = 1
  while (w <= 4) {
    let s = newX64Buf()
    let u = newX64Buf()
    xExtendReg(s, XReg64.Rax, w, true)
    xExtendReg(u, XReg64.Rax, w, false)
    assert(xHex(s) != xHex(u))
    w = w * 2
  }
}

function checkX64CanonNarrow() {
  // canonNarrow is a no-op at 64 bits and for floats: the register width
  // already equals the type width there.
  let b = newX64Buf()
  xCanonNarrow(b, XReg64.Rax, mkWidth(8, RegClass.Int, true))
  assert(len(b.code) == 0)
  let b2 = newX64Buf()
  xCanonNarrow(b2, XReg64.Rax, mkWidth(8, RegClass.Float, false))
  assert(len(b2.code) == 0)
  // A float of any width never narrows — it is not an integer register.
  let b3 = newX64Buf()
  xCanonNarrow(b3, XReg64.Rax, mkWidth(4, RegClass.Float, false))
  assert(len(b3.code) == 0)

  // Narrow ints DO narrow, and signedness picks the extension.
  let b4 = newX64Buf()
  xCanonNarrow(b4, XReg64.Rax, mkWidth(1, RegClass.Int, true))
  assert(xHex(b4) == "480fbec0") // movsbq
  let b5 = newX64Buf()
  xCanonNarrow(b5, XReg64.Rax, mkWidth(2, RegClass.Int, false))
  assert(xHex(b5) == "480fb7c0") // movzwq
}

function checkX64Operands() {
  // A vreg with a register: getInt returns it and emits NOTHING — no reload.
  let cx = xTestCtx()
  let r = xGetInt(cx, 0, xScratch1())
  assert(r == XReg64.Rax)
  assert(len(cx.buf.code) == 0)

  // A SPILLED vreg: reloaded into the scratch, which is what is returned. One
  // saved GPR sits above the spill area, so slot 0 is at rbp-16, not rbp-8 —
  // a reload from the wrong offset reads the saved register instead.
  let cx2 = xTestCtx()
  let r2 = xGetInt(cx2, 1, xScratch1())
  assert(r2 == xScratch1())
  assert(xSpillOffset(cx2.frame, 0) == -16)
  // {disp32} mov -16(%rbp), %r11 -> 4c 8b 9d f0 ff ff ff
  assert(xHex(cx2.buf) == "4c8b9df0ffffff")

  // putInt to a register vreg is a plain move...
  let cx3 = xTestCtx()
  xPutInt(cx3, 0, xScratch1())
  assert(xHex(cx3.buf) == "4c89d8") // mov %r11, %rax
  // ...and to a spilled one, a store to its slot.
  let cx4 = xTestCtx()
  xPutInt(cx4, 1, xScratch1())
  // {disp32} mov %r11, -16(%rbp) -> 4c 89 9d f0 ff ff ff
  assert(xHex(cx4.buf) == "4c899df0ffffff")

  // A put to a vreg already in the target register emits nothing.
  let cx5 = xTestCtx()
  xPutInt(cx5, 0, XReg64.Rax)
  assert(len(cx5.buf.code) == 0)

  // Floats take the same shape but through the xmm file: a register operand
  // costs nothing, a spilled one reloads through the float scratch.
  let cx6 = xTestCtx()
  let f = xGetFloat(cx6, 0, xFScratch1())
  assert(f == XmmReg.Xmm0 && len(cx6.buf.code) == 0)
  let cx7 = xTestCtx()
  let f2 = xGetFloat(cx7, 1, xFScratch1())
  assert(f2 == xFScratch1() && len(cx7.buf.code) > 0)
  assert(cx7.buf.code[0] == u8(0xF2)) // movsd, not a GPR load
}

function checkX64Ploc() {
  // plocOf bridges to the architecture-neutral parallel-move sequencer: a
  // register vreg becomes a reg PLoc, a spilled one an rbp-relative mem PLoc.
  let cx = xTestCtx()
  let p = xPlocOf(cx, 0, RegClass.Int)
  assert(p.isReg && p.v == xRegNum(XReg64.Rax))
  let p2 = xPlocOf(cx, 1, RegClass.Int)
  assert(!p2.isReg && p2.v == -16)

  // The SAME vreg index resolves through a different file per class — reading
  // the int file for a float vreg would name an unrelated register.
  let p3 = xPlocOf(cx, 0, RegClass.Float)
  assert(p3.isReg && p3.v == xmmNum(XmmReg.Xmm0))
  // rax is 0 and xmm0 is 0, so pick an index where the two files disagree.
  cx.intRegs = [XReg64.R13]
  cx.floatRegs = [XmmReg.Xmm7]
  let p4 = xPlocOf(cx, 0, RegClass.Int)
  let p5 = xPlocOf(cx, 0, RegClass.Float)
  assert(p4.v == 13 && p5.v == 7)
}

function checkX64BinarySel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // dst=0 (rax), lhs=0 (rax), rhs=1 (spilled). Both operands route through
  // scratch, the op computes there, the result is written back.
  let cx = xTestCtx()
  xEmitBinaryInt(cx, XArith.Add, 0, 0, 1, w64)
  // reload rhs from -16(%rbp) into r10, mov rax->r11, add r10 into r11,
  // mov r11->rax.
  //   4c 8b 95 f0 ff ff ff   mov -16(%rbp), %r10
  //   49 89 c3               mov %rax, %r11
  //   4d 01 d3               add %r10, %r11
  //   4c 89 d8               mov %r11, %rax
  assert(xHex(cx.buf) == "4c8b95f0ffffff4989c34d01d34c89d8")

  // A 64-bit add needs no re-narrowing: the register width IS the type width.
  let cx2 = xTestCtx()
  xEmitBinaryInt(cx2, XArith.Add, 0, 0, 0, w64)
  assert(len(cx2.buf.code) == 3 + 3 + 3) // mov, add, mov — no extend

  // A NARROW add must re-narrow: an add can carry bits past the type width, and
  // leaving them breaks every later shift/compare (#1158).
  let cx3 = xTestCtx()
  xEmitBinaryInt(cx3, XArith.Add, 0, 0, 0, mkWidth(4, RegClass.Int, false))
  assert(len(cx3.buf.code) > len(cx2.buf.code))

  // Bitwise ops carry canonical inputs to a canonical output, so they add NO
  // narrowing even at a narrow width — that is the point of the invariant.
  let cx4 = xTestCtx()
  xEmitBinaryInt(cx4, XArith.And, 0, 0, 0, mkWidth(4, RegClass.Int, false))
  assert(len(cx4.buf.code) == 9)
  let cx5 = xTestCtx()
  xEmitBinaryInt(cx5, XArith.Xor, 0, 0, 0, mkWidth(1, RegClass.Int, true))
  assert(len(cx5.buf.code) == 9)

  // A product overflows its width readily, so mul always re-narrows when narrow.
  let cx6 = xTestCtx()
  xEmitMulInt(cx6, 0, 0, 0, mkWidth(2, RegClass.Int, true))
  let cx7 = xTestCtx()
  xEmitMulInt(cx7, 0, 0, 0, w64)
  assert(len(cx6.buf.code) > len(cx7.buf.code))
}

function checkX64DivSel() {
  let w64 = mkWidth(8, RegClass.Int, true)

  // The dividend's HIGH half must be primed correctly or the quotient is wildly
  // wrong rather than faulting: cqo sign-extends rax into rdx:rax for signed,
  // xor zeroes rdx for unsigned. Using one for the other is the bug.
  let cx = xTestCtx()
  xEmitDivInt(cx, XDivOp.SDiv, 0, 0, 0, -1, w64)
  // mov %rax,%rax (elided), cqo (48 99), idiv %rax (48 f7 f8), mov %rax,%rax
  // (elided) — so just the two middle instructions, as a SUFFIX: #2016's
  // div-zero check (test/jcc/call) now precedes them.
  assert(xHex(cx.buf)[len(xHex(cx.buf)) - 10:len(xHex(cx.buf))] == "489948f7f8")

  let cx2 = xTestCtx()
  xEmitDivInt(cx2, XDivOp.UDiv, 0, 0, 0, -1, w64)
  // xor %edx,%edx (31 d2), div %rax (48 f7 f0), as a suffix for the same reason.
  assert(xHex(cx2.buf)[len(xHex(cx2.buf)) - 10:len(xHex(cx2.buf))] == "31d248f7f0")
  // Signed and unsigned must differ — both in the priming AND the opcode.
  assert(xHex(cx.buf) != xHex(cx2.buf))

  // The quotient comes from rax, the REMAINDER from rdx. Taking the wrong one
  // returns a plausible number that is simply not the answer.
  let cx3 = xTestCtx()
  cx3.intRegs = [XReg64.Rbx] // dst vreg 0 -> rbx, so the final move is visible
  xEmitDivInt(cx3, XDivOp.SDiv, 0, 0, 0, -1, w64)
  let cx4 = xTestCtx()
  cx4.intRegs = [XReg64.Rbx]
  xEmitDivInt(cx4, XDivOp.SRem, 0, 0, 0, -1, w64)
  assert(xHex(cx3.buf) != xHex(cx4.buf))
  // sdiv's result move is `mov %rax, %rbx` (48 89 c3); srem's is
  // `mov %rdx, %rbx` (48 89 d3).
  assert(xHex(cx3.buf)[len(xHex(cx3.buf)) - 6:len(xHex(cx3.buf))] == "4889c3")
  assert(xHex(cx4.buf)[len(xHex(cx4.buf)) - 6:len(xHex(cx4.buf))] == "4889d3")

  // #1702: xConstPow2Divisor recognizes ONLY a known, positive, power-of-two
  // divisor -- everything else must keep dividing for real (a wrong "yes"
  // here would silently change what the program computes, not just how).
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let oneBlock = [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }]

  let c8 = mkInstr(Op.ConstInt, i64t)
  c8.ival = 8
  let fEight = IrFunc{ name: "e", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c8], isFallible: false }
  assert(xConstPow2Divisor(fEight, 0, w64) == 3) // 8 == 2^3

  let c7 = mkInstr(Op.ConstInt, i64t)
  c7.ival = 7
  let fSeven = IrFunc{ name: "s", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c7], isFallible: false }
  assert(xConstPow2Divisor(fSeven, 0, w64) == -1) // not a power of two

  let cNeg8 = mkInstr(Op.ConstInt, i64t)
  cNeg8.ival = -8
  let fNeg8 = IrFunc{ name: "n", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [cNeg8], isFallible: false }
  assert(xConstPow2Divisor(fNeg8, 0, w64) == -1) // signed: negative divisor declined

  let c1 = mkInstr(Op.ConstInt, i64t)
  c1.ival = 1
  let fOne = IrFunc{ name: "o", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c1], isFallible: false }
  assert(xConstPow2Divisor(fOne, 0, w64) == -1) // divisor 1: no shift needed

  let c0 = mkInstr(Op.ConstInt, i64t)
  c0.ival = 0
  let fZero = IrFunc{ name: "z", paramTypes: []int(0), result: i64t,
    blocks: oneBlock, instrs: [c0], isFallible: false }
  assert(xConstPow2Divisor(fZero, 0, w64) == -1) // divide-by-zero must still panic at runtime

  let notConst = mkInstr(Op.BlockParam, i64t)
  let fVar = IrFunc{ name: "v", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 1 }],
    instrs: [notConst], isFallible: false }
  assert(xConstPow2Divisor(fVar, 0, w64) == -1) // a non-constant divisor is never recognized

  // The fast path really does bypass idiv: no cqo/idiv/div bytes appear, and
  // the signed and unsigned forms differ (the signed one needs the extra
  // bias-then-shift instructions the unsigned one does not).
  let cxU = xTestCtx()
  xEmitDivInt(cxU, XDivOp.UDiv, 0, 0, 0, 3, w64)
  let cxS = xTestCtx()
  xEmitDivInt(cxS, XDivOp.SDiv, 0, 0, 0, 3, w64)
  assert(xHex(cxU.buf) != xHex(cxS.buf))
  assert(xHex(cxU.buf) != xHex(cx2.buf)) // not the real udiv sequence
  assert(xHex(cxS.buf) != xHex(cx.buf)) // not the real sdiv sequence

  // #1704: SRem/URem by the same known power-of-two divisor take the
  // identical fast path -- no idiv/cqo, and distinct from both each other
  // and from the SDiv/UDiv sequences above (URem is a single AND; SRem needs
  // the bias-then-mask-then-subtract sequence).
  let cxUR = xTestCtx()
  xEmitDivInt(cxUR, XDivOp.URem, 0, 0, 0, 3, w64)
  let cxSR = xTestCtx()
  xEmitDivInt(cxSR, XDivOp.SRem, 0, 0, 0, 3, w64)
  assert(xHex(cxUR.buf) != xHex(cxSR.buf))
  assert(xHex(cxUR.buf) != xHex(cxU.buf))
  assert(xHex(cxSR.buf) != xHex(cxS.buf))
  assert(xHex(cxUR.buf) != xHex(cx2.buf)) // not the real urem sequence
  assert(xHex(cxSR.buf) != xHex(cx4.buf)) // not the real srem sequence

  // #2263: a narrow signed div re-narrows its quotient -- INT_MIN/-1 is the
  // one operand pair where the 64-bit idiv (operands live sign-extended)
  // leaves a result outside the declared width, so it needs the same
  // re-canonicalization every other width-breaking op already gets.
  let w32s = mkWidth(4, RegClass.Int, true)
  let cxNarrow = xTestCtx()
  xEmitDivInt(cxNarrow, XDivOp.SDiv, 0, 0, 0, -1, w32s)
  assert(len(cxNarrow.buf.code) > len(cx.buf.code)) // extra movsxd over the w64 sequence
}

function checkX64UnarySel() {
  // neg and not both set bits above the type width, so both re-narrow.
  let narrow = mkWidth(1, RegClass.Int, true)
  let cxN = xTestCtx()
  xEmitUnaryInt(cxN, true, 0, 0, narrow)
  let cxW = xTestCtx()
  xEmitUnaryInt(cxW, true, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(len(cxN.buf.code) > len(cxW.buf.code))

  // neg (F7 /3) and not (F7 /2) share a group and differ only by the digit.
  let cx1 = xTestCtx()
  xEmitUnaryInt(cx1, true, 0, 0, mkWidth(8, RegClass.Int, true))
  let cx2 = xTestCtx()
  xEmitUnaryInt(cx2, false, 0, 0, mkWidth(8, RegClass.Int, true))
  assert(xHex(cx1.buf) != xHex(cx2.buf))
}

function checkX64Icmp() {
  // cmp, setcc, movzx — in that order. The movzx comes AFTER because setcc must
  // read the flags cmp set; zeroing the destination first would clobber them.
  let cx = xTestCtx()
  xEmitIcmp(cx, ccE(), 0, 0, 0)
  //   48 39 c0        cmp %rax, %rax
  //   41 0f 94 c3     sete %r11b (REX.B — r11 is an extended register)
  //   4d 0f b6 db     movzbq %r11b, %r11
  //   4c 89 d8        mov %r11, %rax
  assert(xHex(cx.buf) == "4839c0410f94c34d0fb6db4c89d8")

  // Signed and unsigned compares must differ — that is -1 vs a huge positive.
  let cxS = xTestCtx()
  xEmitIcmp(cxS, ccL(), 0, 0, 0)
  let cxU = xTestCtx()
  xEmitIcmp(cxU, ccB(), 0, 0, 0)
  assert(xHex(cxS.buf) != xHex(cxU.buf))
}

function checkX64Fcmp() {
  // IEEE, not just "icmp with float codes". ucomis sets PF when either operand
  // is NaN (unordered), and each case handles it.

  // GT/GE use the unsigned above codes directly, operands in order.
  let cxGt = xTestCtx()
  xEmitFcmp(cxGt, XFCmp.FGt, 0, 0, 0, 8)
  let cxGe = xTestCtx()
  xEmitFcmp(cxGe, XFCmp.FGe, 0, 0, 0, 8)
  assert(xHex(cxGt.buf) != xHex(cxGe.buf))

  // LT/LE SWAP the operands rather than use the signed codes — the signed codes
  // read TRUE on an unordered result, so `NaN < x` would come out true.
  // With both operands the same vreg the swap is invisible, so use distinct
  // ones: vreg 0 is in a register, vreg 1 is spilled.
  let cxLt = xTestCtx()
  xEmitFcmp(cxLt, XFCmp.FLt, 0, 0, 1, 8)
  let cxGt2 = xTestCtx()
  xEmitFcmp(cxGt2, XFCmp.FGt, 0, 0, 1, 8)
  // Both use `seta`, so they differ ONLY in the ucomis operand order — which is
  // exactly the swap.
  assert(xHex(cxLt.buf) != xHex(cxGt2.buf))

  // EQ is "equal AND ordered": ucomis sets ZF for equal AND for unordered, so
  // `sete` alone would make NaN == NaN true. Two setccs combined with and8.
  let cxEq = xTestCtx()
  xEmitFcmp(cxEq, XFCmp.FEq, 0, 0, 0, 8)
  // NE is "not-equal OR unordered", so NaN != NaN stays true.
  let cxNe = xTestCtx()
  xEmitFcmp(cxNe, XFCmp.FNe, 0, 0, 0, 8)
  assert(xHex(cxEq.buf) != xHex(cxNe.buf))
  // Both emit TWO setccs plus a combine — strictly more than an ordered
  // compare, which is the cost of getting NaN right.
  assert(len(cxEq.buf.code) > len(cxGt.buf.code))
  assert(len(cxNe.buf.code) > len(cxGt.buf.code))

  // The COMBINE op is where eq and ne actually diverge, and it must be checked
  // directly: eq is (equal AND ordered) via and8 (0x20), ne is (not-equal OR
  // unordered) via or8 (0x08). Comparing the two sequences wholesale is not
  // enough — they already differ in their setcc codes, so a swapped combine
  // slips through. Using and8 for ne makes NaN != NaN false, which is wrong.
  assert(xEmitContains(cxEq.buf, 0x20)) // and8
  assert(!xEmitContains(cxEq.buf, 0x08))
  assert(xEmitContains(cxNe.buf, 0x08)) // or8
  assert(!xEmitContains(cxNe.buf, 0x20))
}

function checkX64ConvertSel() {
  let i8s = mkWidth(1, RegClass.Int, true)
  let i64s = mkWidth(8, RegClass.Int, true)
  // Named wF8/wF4 rather than f64/f32: those are predeclared type names, and
  // shadowing one is a warning this build treats as an error.
  let wF8 = mkWidth(8, RegClass.Float, false)
  let wF4 = mkWidth(4, RegClass.Float, false)

  // int->int recovers the source's true value, then re-canonicalizes to the
  // destination. Doing only one of the two breaks either widening or narrowing.
  let cx = xTestCtx()
  xEmitConvert(cx, 0, 0, i8s, i64s)
  assert(len(cx.buf.code) > 0)

  // int->float and float->int route through the float scratch and back.
  let cx2 = xTestCtx()
  xEmitConvert(cx2, 0, 0, i64s, wF8)
  assert(cx2.buf.code[3] == u8(0xF2) || cx2.buf.code[0] == u8(0xF2)) // cvtsi2sd
  let cx3 = xTestCtx()
  xEmitConvert(cx3, 0, 0, wF8, i64s)
  assert(cx3.buf.code[0] == u8(0xF2)) // cvttsd2si

  // float->float of the SAME width is a move, not a conversion: cvtsd2sd does
  // not exist.
  let cx4 = xTestCtx()
  xEmitConvert(cx4, 0, 0, wF8, wF8)
  let cx5 = xTestCtx()
  xEmitConvert(cx5, 0, 0, wF8, wF4)
  assert(xHex(cx4.buf) != xHex(cx5.buf))
  // cvtsd2ss: F2 prefix, then a REX byte (fscratch1 is xmm14, an extended
  // register), then the 0F 5A opcode — so the opcode is at index 2, not 1.
  assert(cx5.buf.code[0] == u8(0xF2))
  assert(cx5.buf.code[2] == u8(0x0F) && cx5.buf.code[3] == u8(0x5A))
}

function checkX64MovXG() {
  // movq %rax, %xmm0 -> 66 48 0f 6e c0 ; movd %eax, %xmm0 -> 66 0f 6e c0.
  // REX.W is the ONLY difference between moving 64 bits and 32 — and for a
  // float constant that is the difference between an f64's bits and an f32's.
  let b = newX64Buf()
  xMovXG(b, XmmReg.Xmm0, XReg64.Rax, 8)
  assert(xHex(b) == "66480f6ec0")
  let b2 = newX64Buf()
  xMovXG(b2, XmmReg.Xmm0, XReg64.Rax, 4)
  assert(xHex(b2) == "660f6ec0")
  // movq %r11, %xmm14 -> 66 4d 0f 6e f3 (both extended)
  let b3 = newX64Buf()
  xMovXG(b3, XmmReg.Xmm14, XReg64.R11, 8)
  assert(xHex(b3) == "664d0f6ef3")
}

function checkX64ConstSel() {
  // A small int uses the 7-byte imm32 form...
  let cx = xTestCtx()
  xEmitConstInt(cx, 0, 5)
  assert(len(cx.buf.code) == 7 + 3) // movabs-short + mov to rax
  // ...and a big one the 10-byte movabs; picking the short form for a value out
  // of imm32 range would sign-extend it into a different number.
  let cx2 = xTestCtx()
  xEmitConstInt(cx2, 0, 0x123456789)
  assert(len(cx2.buf.code) == 10 + 3)

  // A float constant is materialized by its BITS: the exact IEEE pattern into a
  // GPR, then moved across. No conversion is involved — cvtsi2sd here would
  // turn the bit pattern into the float of that integer VALUE, a wildly
  // different number.
  let cx3 = xTestCtx()
  xEmitConstFloat(cx3, 0, 0x3FF0000000000000, 8) // 1.0
  assert(xEmitContains(cx3.buf, 0x6E))  // movq xmm <- gpr
  assert(!xEmitContains(cx3.buf, 0x2A)) // NOT cvtsi2sd
}

function checkX64ShiftSel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // A constant amount uses the immediate form — no rcx traffic at all.
  let cx = xTestCtx()
  xEmitShiftInt(cx, XShift.Shl, 0, 0, 0, 5, w64)
  //   49 89 c3       mov %rax, %r11
  //   49 c1 e3 05    shl $5, %r11
  //   4c 89 d8       mov %r11, %rax
  assert(xHex(cx.buf) == "4989c349c1e3054c89d8")

  // A variable amount must route through cl — the only variable shift count on
  // x86-64, and why such a function excludes rcx from allocation.
  //   49 89 c3    mov %rax, %r11
  //   48 89 c1    mov %rax, %rcx   <- the count into cl
  //   49 d3 e3    shl %cl, %r11    <- D3, the shift-by-cl opcode
  //   4c 89 d8    mov %r11, %rax
  // Pinned as a sequence, not by byte presence: 0xC1 is the shift-by-imm opcode
  // AND the ModRM byte of `mov %rax,%rcx`, so "does 0xC1 appear" answers the
  // wrong question entirely.
  let cx2 = xTestCtx()
  xEmitShiftInt(cx2, XShift.Shl, 0, 0, 0, -1, w64)
  assert(xHex(cx2.buf) == "4989c34889c149d3e34c89d8")

  // Only a LEFT shift can push bits past the type width. The right shifts carry
  // a canonical operand to a canonical result and add no narrowing — which is
  // the payoff of maintaining the invariant at all.
  let narrow = mkWidth(2, RegClass.Int, false)
  let cxShl = xTestCtx()
  xEmitShiftInt(cxShl, XShift.Shl, 0, 0, 0, 3, narrow)
  let cxShr = xTestCtx()
  xEmitShiftInt(cxShr, XShift.Shr, 0, 0, 0, 3, narrow)
  assert(len(cxShl.buf.code) > len(cxShr.buf.code))
  let cxSar = xTestCtx()
  xEmitShiftInt(cxSar, XShift.Sar, 0, 0, 0, 3, narrow)
  assert(len(cxSar.buf.code) == len(cxShr.buf.code))
}

function checkX64FieldSel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // A plain field load: base into the secondary scratch, value into the primary.
  let cx = xTestCtx()
  xEmitFieldGet(cx, 0, 0, 16, w64, false, false)
  //   49 89 c2                mov %rax, %r10   (base fetch is elided: rax IS the
  //                                             reg, so getInt returns it)
  //   4d 8b 98 10 00 00 00    mov 16(%r10), %r11 -- actually base is rax here
  // The base register is rax (vreg 0 lives there), so no fetch move at all:
  //   4c 8b 98 10 00 00 00    mov 16(%rax), %r11
  //   4c 89 d8                mov %r11, %rax
  assert(xHex(cx.buf) == "4c8b98100000004c89d8")

  // An ARRAY field is inline storage: its value is the interior ADDRESS, formed
  // with lea. Loading a word there would read the array's first element as if
  // it were the array itself.
  let cx2 = xTestCtx()
  xEmitFieldGet(cx2, 0, 0, 16, w64, true, false)
  assert(xEmitContains(cx2.buf, 0x8D))  // lea
  assert(!xEmitContains(cx2.buf, 0x8B)) // no load
  assert(xHex(cx.buf) != xHex(cx2.buf))

  // A narrow field load extends to its declared width and signedness — the
  // width-canonical invariant holds at every definition site, loads included.
  let cxS = xTestCtx()
  xEmitFieldGet(cxS, 0, 0, 0, mkWidth(1, RegClass.Int, true), false, false)
  let cxU = xTestCtx()
  xEmitFieldGet(cxU, 0, 0, 0, mkWidth(1, RegClass.Int, false), false, false)
  assert(xHex(cxS.buf) != xHex(cxU.buf)) // movsbq vs movzbq

  // len(slice) is the word at offset 8 of the header — shared by slices and
  // strings (runtime/ABI.md §2) — guarded so a NULL header reads as 0 rather
  // than faulting (#1564; a zeroed struct's slice/string field is null).
  //   49 c7 c3 00000000   mov  r11, 0        ; the null answer
  //   48 85 c0            test rax, rax
  //   74 07               jz   +7            ; skip the load, keeping the 0
  //   4c 8b 98 08000000   mov  r11, [rax+8]
  //   4c 89 d8            mov  rax, r11
  let cx3 = xTestCtx()
  xEmitSliceLen(cx3, 0, 0)
  assert(xHex(cx3.buf) ==
    "49c7c300000000" + "4885c0" + "7407" + "4c8b9808000000" + "4c89d8")

  // cap(slice) rides field_get at offset 24 on the header itself, so it takes
  // the SAME null guard — only the displacement differs (#1564).
  let cx3c = xTestCtx()
  xEmitFieldGet(cx3c, 0, 0, 24, w64, false, true)
  assert(xHex(cx3c.buf) ==
    "49c7c300000000" + "4885c0" + "7407" + "4c8b9818000000" + "4c89d8")

  // A non-slice base keeps the bare, unguarded load: a struct field read must
  // pay nothing for the guard.
  let cx3s = xTestCtx()
  xEmitFieldGet(cx3s, 0, 0, 24, w64, false, false)
  assert(xHex(cx3s.buf) == "4c8b9818000000" + "4c89d8")

  // Indexed access scales by the ELEMENT width: base + index*width.
  let cx4 = xTestCtx()
  xEmitIndexGet(cx4, 0, 0, 0, mkWidth(8, RegClass.Int, true))
  let cx5 = xTestCtx()
  xEmitIndexGet(cx5, 0, 0, 0, mkWidth(4, RegClass.Int, true))
  assert(xHex(cx4.buf) != xHex(cx5.buf)) // scale 8 vs 4 in the SIB byte
}

function checkX64Prologue() {
  // A leaf with no saves and no frame: just the rbp chain.
  let cx = newXCtx(XCallConv.SysV)
  xEmitPrologue(cx)
  //   55        push %rbp
  //   48 89 e5  mov %rsp, %rbp
  assert(xHex(cx.buf) == "554889e5")

  // With saves and a frame, the order is: chain, push saves, carve, THEN stash
  // the XMMs — they live inside the frame the sub just carved, so storing them
  // before it would write below rsp, into the red zone a signal handler may
  // clobber.
  let cx2 = newXCtx(XCallConv.Win64)
  cx2.frame = XFrame{ savedGpr: [XReg64.Rbx, XReg64.R13], savedXmm: [XmmReg.Xmm6],
    numSpillSlots: 1, frameSize: 32 }
  xEmitPrologue(cx2)
  //   55                       push %rbp
  //   48 89 e5                 mov %rsp, %rbp
  //   53                       push %rbx
  //   41 55                    push %r13
  //   48 81 ec 20 00 00 00     sub $32, %rsp
  //   f2 0f 11 b5 e0 ff ff ff  movsd %xmm6, -32(%rbp)   <- AFTER the sub
  assert(xHex(cx2.buf) == "554889e55341554881ec20000000f20f11b5e0ffffff")
}

function checkX64Epilogue() {
  let cx = newXCtx(XCallConv.SysV)
  cx.frame = XFrame{ savedGpr: [XReg64.Rbx, XReg64.R13], savedXmm: []XmmReg(0),
    numSpillSlots: 0, frameSize: 16 }
  xEmitEpilogue(cx)
  //   48 81 c4 10..   add $16, %rsp
  //   41 5d           pop %r13     <- REVERSE of the push order
  //   5b              pop %rbx
  //   5d              pop %rbp
  // The stack is LIFO: popping in push order restores each saved value into the
  // WRONG register, which is silent and catastrophic.
  assert(xHex(cx.buf) == "4881c410000000" + "415d" + "5b" + "5d")

  // Prologue and epilogue mirror exactly: the prologue pushes rbx THEN r13, so
  // the epilogue pops r13 THEN rbx.
  let cxP = newXCtx(XCallConv.SysV)
  cxP.frame = cx.frame
  xEmitPrologue(cxP)
  // 55 | 48 89 e5 | 53 (push rbx) | 41 55 (push r13) | 48 81 ec 10 00 00 00
  assert(xHex(cxP.buf) == "554889e55341554881ec10000000")
}

function checkX64ValueSelectors() {
  // fneg flips the sign BIT: materialize the sign mask in a GPR, move it into
  // fscratch2, XOR. It is NOT `0.0 - x`, which is what this emitted until
  // #1442 and which is wrong twice — `0.0 - 0.0` is `+0.0`, so negating zero
  // lost the sign, and subtraction returns a NaN operand with its sign bit
  // CLEARED. See `xEmitFneg`. vreg 0 lives in floatRegs[0] = xmm0, so the
  // operand IS xmm0 here and is copied into fscratch1; only a SPILLED operand
  // reloads (pinned separately below).
  let cx = xTestCtx()
  xEmitFneg(cx, 0, 0, 4)
  assert(xHexHas(cx.buf, "66450f6efb")) // movd  %r11d,  %xmm15  (mask 0x80000000)
  assert(xHexHas(cx.buf, "450f57f7"))   // xorps %xmm15, %xmm14

  let cx8 = xTestCtx()
  xEmitFneg(cx8, 0, 0, 8)
  // REX.W and the 0x66 prefix select the double forms of the same two ops.
  assert(xHexHas(cx8.buf, "664d0f6efb"))  // movq  %r11,   %xmm15 (mask 1<<63)
  assert(xHexHas(cx8.buf, "66450f57f7"))  // xorpd %xmm15, %xmm14

  // A spilled operand reloads into fscratch1 — the accumulator it is XORed
  // into — with fscratch2 holding the mask. That is the reverse of the old
  // `0.0 - x` shape, which needed the accumulator kept clear.
  let cxs2 = xTestCtx()
  xEmitFneg(cxs2, 0, 1, 4) // vreg 1 is spilled
  // movsd -16(%rbp), %xmm14 — always-disp32 (b5 f0ffffff), never the shorter
  // disp8 form: -16 and not -8 because xTestCtx saves one GPR below rbp. The
  // reload is the 8-byte form even at width 4, as it was before this change:
  // the extra bytes are masked off by the 4-byte store on the way out.
  assert(xHexHas(cxs2.buf, "f2440f10b5f0ffffff"))
  assert(xHexHas(cxs2.buf, "450f57f7")) // xorps %xmm15, %xmm14

  // nil is the null pointer via `xor r32, r32` — the 32-bit write zero-extends,
  // clearing all 64 bits.
  let cxn = xTestCtx()
  xEmitConstNil(cxn, 0)
  assert(xHexHas(cxn.buf, "4531db")) // xor %r11d, %r11d

  // A string literal is a static .rodata header address, named by pool index.
  let cxs = xTestCtx()
  xEmitConstString(cxs, 0, 7)
  assert(len(cxs.relocs) == 1)
  assert(cxs.relocs[0].symbol == "__bitstr_7")
  assert(cxs.relocs[0].kind == RelocKind.Abs64) // movabs names an address outright

  // type_info is NOT a call and NOT a GC point: no safepoint may be recorded, or
  // every later safepoint's stack map lands on the wrong return address.
  let cxt = xTestCtx()
  cxt.safepointCodeOffsets = [0, 0]
  xEmitTypeInfo(cxt, 0, 21, 16, [8])
  assert(cxt.nextSafepointIdx == 0)
  assert(cxt.relocs[0].symbol == "__bittype_21_16_8")
}

function checkX64GcAlloc() {
  // gc_alloc IS a call and a GC point. The safepoint must be recorded at the
  // RETURN address — a collection triggered by this very allocation walks the
  // caller's frame by that address (runtime/ABI.md §5).
  let cx = xCallTestCtx()
  cx.safepointCodeOffsets = [0]
  xEmitGcAlloc(cx, 0, 21, 24, [0, 8])
  assert(cx.nextSafepointIdx == 1)
  // The RETURN address: past the movabs (10) and the whole e8+rel32 (5). Do not
  // derive this from len(code) — the trailing put of rax into rax is elided, so
  // the safepoint lands at the end of the buffer here by coincidence, not rule.
  assert(cx.safepointCodeOffsets[0] == 15)
  // Strictly past the reloc's field, which sits INSIDE the call instruction.
  // Recording before the call would give 10, failing both of these.
  assert(cx.safepointCodeOffsets[0] > cx.relocs[1].offset)
  // The TypeInfo symbol encodes the SHAPE, so two sites with identical layout
  // share one blob.
  assert(cx.relocs[0].symbol == "__bittype_21_24_0_8")
  assert(cx.relocs[1].symbol == "bit_rt_gc_alloc")
  assert(cx.relocs[1].kind == RelocKind.Branch)

  // Win64 hands the callee 32 bytes of shadow space above the return address;
  // SysV has none. Omitting it lets the callee scribble on our frame.
  let cw = xCallTestCtx()
  cw.cc = XCallConv.Win64
  cw.safepointCodeOffsets = [0]
  xEmitGcAlloc(cw, 0, 21, 24, [0, 8])
  // Always the imm32 form (48 81 /5 imm32), never the assembler's shorter imm8 —
  // the encoder is uniform on purpose, like its always-disp32 addressing.
  assert(xHexHas(cw.buf, "4881ec20000000")) // sub $32, %rsp
  assert(xHexHas(cw.buf, "4881c420000000")) // add $32, %rsp
  let cs = xCallTestCtx()
  cs.safepointCodeOffsets = [0]
  xEmitGcAlloc(cs, 0, 21, 24, [0, 8])
  assert(!xHexHas(cs.buf, "4881ec20000000")) // SysV reserves no shadow space

  // make_closure fills the cell AFTER the call: rax is the cell, and the env is
  // loaded post-call because a caller-saved register would not survive it.
  let cc = xCallTestCtx()
  cc.safepointCodeOffsets = [0]
  xEmitMakeClosure(cc, 0, "myfn", 0, 21)
  assert(cc.relocs[0].symbol == "__bittype_21_16_8") // 16-byte cell, one GC field at +8
  assert(cc.relocs[1].symbol == "bit_rt_gc_alloc")
  assert(cc.relocs[2].symbol == "myfn")
  assert(xHexHas(cc.buf, "4c899800000000")) // mov %r11, (%rax)   code at +0
  assert(xHexHas(cc.buf, "48899808000000")) // mov %rbx, 8(%rax)  env  at +8

  // func_addr is the same address materialization minus the cell: no call, so no
  // safepoint slot is consumed.
  let cf = xCallTestCtx()
  cf.safepointCodeOffsets = [0]
  xEmitFuncAddr(cf, 0, "target")
  assert(cf.nextSafepointIdx == 0)
  assert(len(cf.relocs) == 1 && cf.relocs[0].symbol == "target")
}
