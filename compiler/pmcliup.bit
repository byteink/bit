// compiler/pmcliup.bit — `bit up`/`bit update` (#1735), split off
// compiler/pmcli.bit under the 800-line limit (#2967 — pmcli.bit crossed it
// again after #2244 landed dependency-spec forms). Same module, sibling
// file: this reuses pmcli.bit's `std/json` import (`jsoncParse`, `jsonGet as
// jsonGetC`, `jsonAsString`, `Json`) and its shared helpers
// (`pmIsHelpFlag`, `parseDirFlag`, `pmCliDefaultTimeoutMs`,
// `upsertLockEntry`, `AddResult`'s sibling `UpResult`) unqualified — an
// import is per-MODULE, not per-file, so re-importing any of those names
// here would be `E0042 already declared in this scope`.
//
// `bit up [name]` (alias `update`) re-resolves every dependency `bit.json`
// names (or, with an argument, just that one) against its CURRENT
// constraint, moving to the highest tag that still satisfies it — and
// rewrites bit.lock with the refreshed commit, version and transitive
// requirements. `bit.json` itself is never touched by plain `bit up`: the
// ref an entry names only changes if the user edits it by hand, or passes
// `--latest` (below).

// `--latest` (#2368) additionally rewrites a version-shaped entry's
// `bit.json` constraint to `^<newest published>`, crossing whatever ceiling
// the old constraint had — the only way to leave a range without hand-
// editing bit.json (SPEC §17.7).
fn cliLooksLikeUpFlag(s: string): bool {
  return s == "--dir" || s == "--latest"
}

// `bit up`'s/`bit update`'s own argument parse: an optional positional
// `name` (never flag-shaped — #2107's "unknown flag read as an operand"
// guard, same as `add`/`remove`) plus `--dir <path>`/`--latest` accepted in
// ANY order and any position relative to `name`, mirroring `parseAddFlags`'s
// interleaved-flags shape rather than `parseDirFlag`'s single-flag one (this
// command now has two). Returns `(name, projectDir, latest, badArg,
// hasBadArg)` — `badArg` is empty and `hasBadArg` false when every token
// parsed.
fn parseUpArgs(a: []string, start: int): (string, string, bool, string, bool) {
  let name = ""
  let projectDir = "."
  let latest = false
  let ai = start
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else if (a[ai] == "--latest") {
      latest = true
      ai = ai + 1
    } else if (len(name) == 0 && !cliLooksLikeFlag(a[ai])) {
      name = a[ai]
      ai = ai + 1
    } else {
      return name, projectDir, latest, a[ai], true
    }
  }
  return name, projectDir, latest, "", false
}

// `bit up [name] [--dir <path>] [--latest]` / `bit update [name]
// [--dir <path>] [--latest]` — `update` is an exact alias, both routed here
// by main.bit's dispatch. With no `name`, refreshes every dependency
// `bit.json` names; with one, restricts the refresh to that dependency
// alone. Returns the process exit code: 2 on a usage error, 1 on a
// fetch/resolve/write failure, 0 on success.
fn upCmd(a: []string): int {
  // #2267: `bit up --help`/`bit update --help` must print usage, not be
  // parsed as a dependency name — before this, it failed with "bit up: no
  // such dependency '--help' in bit.json", the same "flag read as an operand"
  // shape `bit add --help` had.
  if (len(a) > 2 && pmIsHelpFlag(a[2])) {
    print("usage: bit up [<name>] [--dir <path>] [--latest]\n")
    return 0
  }
  let (name, projectDir, latest, badArg, hasBadArg) = parseUpArgs(a, 2)
  if (hasBadArg) {
    if (cliLooksLikeFlag(badArg) && !cliLooksLikeUpFlag(badArg)) {
      cliRejectFlagOperand("up", badArg, "usage: bit up [<name>] [--dir <path>] [--latest]\n")
      return 2
    }
    eprint("bit up: unexpected argument '${badArg}'\n")
    return 2
  }

  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let ctx = UpCtx{
    projectDir: projectDir, cacheRoot: cacheRoot, gitBin: defaultGitBin,
    latest: latest, timeoutMs: pmCliDefaultTimeoutMs,
  }
  let results = upDependencies(ctx, name) catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let i = 0
  while (i < len(results)) {
    print("bit up: ${results[i].name} -> ${results[i].ref} (${results[i].commit})\n")
    i = i + 1
  }
  return 0
}

// ---- the up flow, independent of argv/exit codes -----------------------

// One dependency `bit up`/`bit update` refreshed — enough to print a
// confirmation, mirroring `AddResult`.
class UpResult { name: string, ref: string, url: string, commit: string }

// One `bit.json` `dependencies` entry, decoded. `rawSpec` is the exact
// string bit.json holds for this entry (`e.value`, before `parseSpec`
// takes it apart into `spec`) — `bit list` (#2271, pmclilist.bit) prints
// this rather than reconstructing a spec string from `spec`'s fields,
// which would risk a display form that does not match what the user
// actually wrote (e.g. an ssh:// spec's exact user@host spelling).
class DepSpecNamed { name: string, spec: DepSpec, rawSpec: string }

// Every dependency `<projectDir>/bit.json` names, decoded through
// `jsoncParse` (std/json) — unlike `readManifest` (pmfetch.bit), which reads
// a FETCHED dependency's manifest through the strict local JSON parser, this
// reads the PROJECT's OWN bit.json, which routinely carries the user's
// comments (JSONC, not plain JSON — same format the CST edit layer preserves
// for `bit add`). Each value is decoded through pmfetch.bit's own `parseSpec`
// — the identical `host/owner/repo@ref` shape `bit add` already validates —
// so a malformed entry fails the same way it would on `add`. Fails if the
// project has no `bit.json` at all: `bit up` refreshes an existing project,
// it does not scaffold one.
fn projectDeps(projectDir: string): []DepSpecNamed! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit up: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let doc = jsoncParse(src)?
  let depsField = jsonGetC(doc, "dependencies")
  match (depsField) {
    Some(deps) => return projectDepsOf(deps)?
    None => return []DepSpecNamed(0)
  }
}

fn projectDepsOf(deps: Json): []DepSpecNamed! {
  let out = []DepSpecNamed(0)
  match (deps) {
    JsonObject(entries) => {
      for e of entries {
        let refStr = jsonAsString(e.value)
        match (refStr) {
          Some(specRef) => {
            let spec = parseSpec(specRef)?
            out = append(out, DepSpecNamed{ name: e.key, spec: spec, rawSpec: specRef })
          }
          None => fail newError("bit up: bit.json dependency '${e.key}' is not a string")
        }
      }
    }
    JsonNull => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonBool(_) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonInt(_) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonFloat(_) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonString(_) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonArray(_) => fail newError("bit up: bit.json 'dependencies' is not an object")
  }
  return out
}

// `deps` narrowed to the single entry named `name`. Fails if there is none —
// `bit up <name>` on a dependency `bit.json` doesn't name is a usage error,
// not a silent no-op.
fn onlyNamed(deps: []DepSpecNamed, name: string): []DepSpecNamed! {
  let i = 0
  while (i < len(deps)) {
    if (deps[i].name == name) {
      return [deps[i]]
    }
    i = i + 1
  }
  fail newError("bit up: no such dependency '${name}' in bit.json")
}

// `bit up [name]`'s and `bit up --latest [name]`'s shared ref resolution
// (#2368, #3584): what to actually fetch, what version that resolves to
// (for bit.lock's `version` field, #2856), and — only for `--latest` on a
// version-shaped ref — the new constraint string to write back into
// bit.json. Both callers (vanity, direct) share this rather than
// duplicating the `latest`/`isVersion` branching twice.
//
// Plain `bit up` (`latest: false`) resolves `refIn` against ITS OWN
// constraint via `resolveAddRef(..., hasRef: true, refIn, ...)` — the exact
// #3584 fix: a `^`/`~`/exact-version ref moves to the highest tag inside
// that constraint (never crossing it), a branch name or bare sha passes
// through unresolved. `bit up --latest` on a version-shaped ref instead
// calls `resolveAddRef(..., hasRef: false, "", ...)` — `bit add`'s own bare-
// add path, which finds the highest tag PUBLISHED AT ALL and writes a fresh
// `^<newest>` constraint, deliberately crossing whatever ceiling the old
// constraint had (SPEC §17.7, "the only way to leave a range"). `--latest`
// on a branch/bare-sha ref is a no-op beyond plain `bit up`'s own passthrough
// — there is no constraint to widen.
class UpRefResolution {
  fetchRef: string,
  resolvedVersion: string,
  writtenRef: string,
  rewritten: bool,
}

fn resolveUpRef(
  gitBin: string,
  url: string,
  refIn: string,
  latest: bool,
  timeoutMs: int,
): UpRefResolution! {
  let (_, isVersion) = parseAddVersionRef(refIn)
  if (latest && isVersion) {
    let picked = resolveAddRef(gitBin, url, false, "", timeoutMs)?
    return UpRefResolution{
      fetchRef: picked.fetchRef, resolvedVersion: picked.resolvedVersion,
      writtenRef: picked.writtenRef, rewritten: true,
    }
  }
  let resolved = resolveAddRef(gitBin, url, true, refIn, timeoutMs)?
  return UpRefResolution{
    fetchRef: resolved.fetchRef, resolvedVersion: resolved.resolvedVersion,
    writtenRef: refIn, rewritten: false,
  }
}

// `rawSpec` (`DepSpecNamed`'s exact bit.json string, e.g.
// `github.com/o/r@^1.2.0`, `some/vanity/name@1.0.0`, or
// `ssh://git@host/o/r@main`) with everything after its LAST "@" replaced by
// `newRef` — the same ref-separator rule `pmfetch.bit`'s `parseSpec`/
// `hasExplicitRef` use (an ssh spec's user@host "@" always precedes the
// path's first "/", so it is never the last "@"). Scheme-agnostic on
// purpose: reconstructing a spec from `host`/`owner`/`repo` alone would
// silently drop an `ssh://` prefix and its user, and a vanity name has no
// such fields at all.
fn specWithRef(rawSpec: string, newRef: string): string {
  let at = lastIndexByte(rawSpec, '@')
  return rawSpec[0:at + 1] + newRef
}

// Every `upDependencies` (below) run's own parameters, EXCEPT `only` (a
// per-call filter, not "how to resolve") — bundled (per E0202) so
// `upVanityDep`/`upDirectDep` take 3 params instead of 7, and
// `upDependencies` itself takes 2 instead of 6.
class UpCtx { projectDir: string, cacheRoot: string, gitBin: string, latest: bool, timeoutMs: int }

// A local dependency has no ref/commit/version to refresh — only its own
// `bit.json` requirements are re-read (`resolveLocalDependency`, pmz.bit).
// `--latest` has no effect here; there is no remote and no constraint. Takes
// `projectDir` directly rather than a full `UpCtx`: nothing else in it applies.
fn upLocalDep(projectDir: string, d: DepSpecNamed, entries: []LockEntry): ([]LockEntry, UpResult)! {
  let entry = resolveLocalDependency(projectDir, d.name, d.spec.localPath)?
  let updated = upsertLockEntry(
    entries,
    d.name,
    entry.url,
    entry.commit,
    "",
    entry.requires,
    "",
    entry.localPath,
    "",
  )
  return updated, UpResult{ name: d.name, ref: d.spec.localPath, url: "", commit: "local" }
}

// A vanity name always re-resolves its `bit-import:` document (there is no
// non-network way to "refresh" it); `resolveVanityDependency` is what
// refuses a resolution that disagrees with the URL bit.lock already records
// for this name. `resolveVanityUrl` is called here, once, rather than
// inside `resolveVanityDependency` itself (#2367) — its `doc.gitUrl` feeds
// both `resolveUpRef` and the actual fetch.
fn upVanityDep(ctx: UpCtx, d: DepSpecNamed, entries: []LockEntry): ([]LockEntry, UpResult)! {
  let doc = resolveVanityUrl(d.spec.vanityName, vanityTimeoutMs)?
  let resolvedRef = resolveUpRef(ctx.gitBin, doc.gitUrl, d.spec.ref, ctx.latest, ctx.timeoutMs)?
  let entry = resolveVanityDependency(
    ctx.cacheRoot,
    ctx.gitBin,
    d.name,
    d.spec.vanityName,
    doc,
    resolvedRef.fetchRef,
    entries,
    ctx.timeoutMs,
  )?
  let updated = upsertLockEntry(
    entries,
    d.name,
    entry.url,
    entry.commit,
    resolvedRef.resolvedVersion,
    entry.requires,
    entry.vanity,
    entry.localPath,
    entry.dir,
  )
  if (resolvedRef.rewritten) {
    rewriteManifest(ctx.projectDir, d.name, specWithRef(d.rawSpec, resolvedRef.writtenRef))?
  }
  return updated,
    UpResult{ name: d.name, ref: resolvedRef.writtenRef, url: entry.url, commit: entry.commit }
}

// `d.spec.scheme == "ssh"` needs its OWN fallback URL: `defaultDepUrl`
// always derives `https://`, which is wrong for a dependency that was never
// fetched over https in the first place (#2244). This only matters when
// bit.lock has no entry yet at all (`existingUrlFor`'s own fallback path) —
// a dependency already locked reuses its recorded `url` unchanged, exactly
// as before. `bit up` has no `--url` escape hatch: it refreshes what
// bit.lock already records, so the fetch reaches the same url it will write
// back.
fn upDirectDep(ctx: UpCtx, d: DepSpecNamed, entries: []LockEntry): ([]LockEntry, UpResult)! {
  let fallbackUrl = defaultDepUrl(d.spec.host, d.spec.owner, d.spec.repo)
  if (d.spec.scheme == "ssh") {
    fallbackUrl = sshDepUrl(d.spec.sshUser, d.spec.host, d.spec.owner, d.spec.repo)
  }
  let url = existingUrlFor(entries, d.name, fallbackUrl)
  let resolvedRef = resolveUpRef(ctx.gitBin, url, d.spec.ref, ctx.latest, ctx.timeoutMs)?
  let entry = resolveDependency(
    ctx.cacheRoot, ctx.gitBin, d.name, d.spec.host, d.spec.owner, d.spec.repo,
    resolvedRef.fetchRef, url, url, entries, ctx.timeoutMs,
  )?
  let updated = upsertLockEntry(
    entries,
    d.name,
    entry.url,
    entry.commit,
    resolvedRef.resolvedVersion,
    entry.requires,
    "",
    "",
    "",
  )
  if (resolvedRef.rewritten) {
    rewriteManifest(ctx.projectDir, d.name, specWithRef(d.rawSpec, resolvedRef.writtenRef))?
  }
  return updated,
    UpResult{ name: d.name, ref: resolvedRef.writtenRef, url: entry.url, commit: entry.commit }
}

// `bit up`'s/`bit update`'s core: every dependency `bit.json` names (or, when
// `only` is non-empty, just that one) refreshed and rewritten into bit.lock.
// Plain `bit up` (`ctx.latest: false`) never touches `bit.json` — its `ref`
// per entry is exactly what was already there; only bit.lock's resolved
// commit, version and transitive requirements move, to the highest tag
// inside that SAME constraint (#3584/#2368). `bit up --latest` additionally
// rewrites a version-shaped entry's `bit.json` constraint to
// `^<newest published>`, crossing whatever ceiling the old constraint had —
// the only way to leave a range (SPEC §17.7) — via
// `resolveUpRef`/`upVanityDep`/`upDirectDep` above. bit.lock is read once
// and written once regardless of how many dependencies are refreshed: each
// iteration folds its result into the same in-memory `entries` via
// `upsertLockEntry` (the same accumulate-in-memory-then-write-once shape
// `addDependency` uses for its own single entry) rather than each dependency
// doing its own read-resolve-write round trip. After every direct
// dependency is refreshed, `resolveTransitiveDeps` (#2251) walks and fetches
// whatever `requires` edges are now reachable but still missing a top-level
// entry, so `bit up` backfills a lock written before that walk existed, not
// just newly-added dependencies.
export fn upDependencies(ctx: UpCtx, only: string): []UpResult! {
  let deps = projectDeps(ctx.projectDir)?
  if (len(only) > 0) {
    deps = onlyNamed(deps, only)?
  }

  let lockPath = pmJoin(ctx.projectDir, "bit.lock")
  let entries = readLock(lockPath)?

  let out = []UpResult(0)
  let i = 0
  while (i < len(deps)) {
    let d = deps[i]
    if (d.spec.scheme == "local") {
      let (updated, result) = upLocalDep(ctx.projectDir, d, entries)?
      entries = updated
      out = append(out, result)
    } else if (d.spec.vanity) {
      let (updated, result) = upVanityDep(ctx, d, entries)?
      entries = updated
      out = append(out, result)
    } else {
      let (updated, result) = upDirectDep(ctx, d, entries)?
      entries = updated
      out = append(out, result)
    }
    i = i + 1
  }

  // Backfill every transitive dependency reachable from what's now locked
  // (#2251) — not just the ones the loop above touched: a `bit.lock` written
  // before this walk existed (or one whose refreshed entries grew new
  // `requires`) is caught the same way, since the seed is every CURRENT
  // entry's own requirements, not only the ones `bit up` refreshed this run.
  entries = resolveTransitiveDeps(
    ctx.cacheRoot,
    ctx.gitBin,
    entries,
    flattenRequires(entries),
    ctx.timeoutMs,
  )?

  writeLock(lockPath, entries)?
  return out
}
