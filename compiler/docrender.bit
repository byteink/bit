// compiler/docrender.bit — `bit doc`'s two output forms (JSON and plain
// text: docJsonString/docVariantJson/docVariantsJson/docJson/
// docKindIsNamedType/docRenderVariant/docEnumBraces/docPlain) and the `bit
// doc <name>` CLI argument resolution (docResolveOperand/docCmd/
// resolveDocByName/resolveDocStdName/resolveDocLockEntry) — split out of
// compiler/doc.bit under #4183 (spec/LINT.md:186's 800-line E0200 limit;
// doc.bit was at 799). Same module, sibling file: doc.bit's own collect
// phase (DocSymbol/DocVariant/collectDoc/sortDoc) stays there and every
// symbol here is called from doc.bit, or calls back into it, unqualified —
// no import needed either direction (compiler/ is one flat namespace).
// Escapes a rendered field for a JSON string. A type/name/params field never
// holds a control character, but it can hold `\` (and `"` in principle) —
// escape both, matching the seed's `writeJsonString`. `doc` (#2725) is the one
// field that CAN hold a control character: `docCommentsOf` joins a multi-line
// comment block with a literal '\n', which JSON cannot carry unescaped inside
// a string — a single `//` line itself never contains one (`collectComments`
// stops at the newline), so '\n' is the only control byte this function's
// callers ever actually produce.
fn docJsonString(s: string): string {
  let out = "\""
  let b = []byte(s)
  let i = 0
  while (i < len(b)) {
    let c = b[i]
    if (c == u8(34) || c == u8(92)) { // '"' or '\'
      out = out + "\\" + string(b[i:i + 1])
    } else if (c == u8(10)) { // '\n' — the doc-comment line join (#2725)
      out = out + "\\n"
    } else {
      out = out + string(b[i:i + 1])
    }
    i = i + 1
  }
  return out + "\""
}

// One variant as a JSON object: `{"name": ..., "payload": [type, ...]}`
// (#2279). `payload` is `[]` for a bare variant like `JsonNull`.
fn docVariantJson(v: DocVariant): string {
  let out = "{\"name\": " + docJsonString(v.name) + ", \"payload\": ["
  let i = 0
  while (i < len(v.payload)) {
    if (i != 0) {
      out = out + ", "
    }
    out = out + docJsonString(v.payload[i])
    i = i + 1
  }
  return out + "]}"
}

// An enum symbol's variants as a JSON array (#2279); `[]` for every other
// kind, so every entry carries the same set of keys.
fn docVariantsJson(variants: []DocVariant): string {
  let out = "["
  let i = 0
  while (i < len(variants)) {
    if (i != 0) {
      out = out + ", "
    }
    out = out + docVariantJson(variants[i])
    i = i + 1
  }
  return out + "]"
}

// The `--json` form: a `[ {...} ]` array, one object per line, close to the
// seed's `writeJson` plus a "variants" key (#2279 — the seed predates it) and
// a "doc" key, always present and always last (#2725) — "" for a method,
// field, or any symbol with no comment run directly above its declaration.
fn docJson(syms: []DocSymbol): string {
  let out = "[\n"
  let i = 0
  while (i < len(syms)) {
    let s = syms[i]
    out = out +
      "  {\"name\": " +
      docJsonString(s.name) +
      ", \"kind\": " +
      docJsonString(s.kind) +
      ", \"params\": " +
      docJsonString(s.params) +
      ", \"type\": " +
      docJsonString(s.typeText) +
      ", \"variants\": " +
      docVariantsJson(s.variants) +
      ", \"doc\": " +
      docJsonString(s.doc) +
      "}"
    if (i + 1 < len(syms)) {
      out = out + ","
    }
    out = out + "\n"
    i = i + 1
  }
  return out + "]\n"
}

// Whether `kind` is a named type's — the four the checker keys off the decl
// symbol's own tag for (`docTypeKind`), never a method/function/const.
fn docKindIsNamedType(kind: string): bool {
  return kind == "class" || kind == "enum" || kind == "interface" || kind == "type"
}

// A variant rendered the way its declaration reads: bare name, or
// "name(type, ...)" when it carries a payload (#2279).
fn docRenderVariant(v: DocVariant): string {
  if (len(v.payload) == 0) {
    return v.name
  }
  let out = v.name + "("
  let i = 0
  while (i < len(v.payload)) {
    if (i != 0) {
      out = out + ", "
    }
    out = out + v.payload[i]
    i = i + 1
  }
  return out + ")"
}

// An enum's variant list, braced and comma-separated: "{ A, B(T) }", or
// "{}" for a variant-less enum. `docPlain` folds this into the enum's own
// line, following how the declaration reads (#2279).
fn docEnumBraces(variants: []DocVariant): string {
  if (len(variants) == 0) {
    return "{}"
  }
  let out = "{ "
  let i = 0
  while (i < len(variants)) {
    if (i != 0) {
      out = out + ", "
    }
    out = out + docRenderVariant(variants[i])
    i = i + 1
  }
  return out + " }"
}

// The plain form, per symbol (#2724, #2279): a named type prints "<kind>
// <type>\n" — `typeText` already holds `name + params`, so printing `name`
// too would repeat it verbatim. An enum is the one named type that instead
// prints its own variant list, braced, because the variant list IS the
// type's meaning (#2279). Every other kind prints "<kind> <name><params>
// <type>\n". When `doc` is non-empty (#2725), each of its lines is printed
// verbatim (leading "//" and all) directly above the symbol line, before the
// symbol's own line — never changing that line's own text or position.
fn docPlain(syms: []DocSymbol): string {
  let out = ""
  let i = 0
  while (i < len(syms)) {
    let s = syms[i]
    if (len(s.doc) > 0) {
      out = out + s.doc + "\n"
    }
    if (s.kind == "enum") {
      out = out + "enum " + s.typeText + " " + docEnumBraces(s.variants) + "\n"
    } else if (docKindIsNamedType(s.kind)) {
      out = out + s.kind + " " + s.typeText + "\n"
    } else {
      out = out + s.kind + " " + s.name + s.params + " " + s.typeText + "\n"
    }
    i = i + 1
  }
  return out
}

// `bit doc [--json] [--fields] <module-dir|name>`: load, resolve and check
// the module rooted at `arg` (always a DIRECTORY — a lone-file root has no
// doc form yet, SPEC §17.1), then print its exported surface. Returns false
// (and leaves diagnostics on stderr) when the module does not compile,
// matching the seed's `null` return.
//
// #2271: `arg` may be a NAME rather than a directory — `resolveDocByName`
// (below) tries this project's bit.lock, then the stdlib root, before this
// falls back to treating `arg` as the literal filesystem path it always
// used to require.
//
// The front-end order mirrors `checkCmd`: resolve first (so module-graph errors
// surface even beside a parse error, as the seed's loader reports them), then the
// parse+resolve gate, then the type checker.
//
// Split out of `docCmd` (below) so the added name-resolution branch does not
// push it over E0204's complexity-10 ceiling — `docCmd` was already at 10
// before #2271 and pooling both decisions in one function landed it at 11.
// `false` means already reported and `docCmd` should stop; `true` means
// `path` (either `arg` unchanged, or the name's resolved directory) is
// ready for the existing pipeline below.
fn docResolveOperand(arg: string): (string, bool) {
  let (namedDir, namedDetail, isName) = resolveDocByName(arg)
  if (!isName) {
    return arg, true
  }
  if (namedDir == "") {
    eprint("bit doc: ${arg}: ${namedDetail}\n")
    return "", false
  }
  return namedDir, true
}

fn docCmd(arg: string, asJson: bool, withFields: bool): bool {
  let (path, resolvedOk) = docResolveOperand(arg)
  if (!resolvedOk) {
    return false
  }
  // The operand must exist and hold Bit source, checked ahead of the loader
  // (#2411): a directory with no `.bit` files registered as a zero-file
  // module and printed nothing, indistinguishable from a real module whose
  // exports are all private. `moduleRootProblem` (compiler/build.bit) is the
  // same guard `checkCmd`/`buildIr` use, so this and the other commands agree
  // about the same path instead of drifting the way #2394's four call sites did.
  let problem = moduleRootProblem(path)
  if (problem != "") {
    eprint("bit doc: ${path}: ${problem}\n")
    return false
  }
  let rootDir = path
  if (!fsIsDir(path)) {
    rootDir = pathDir(path)
  }
  // #2254: same manifest-vs-lock guard checkCmd (main.bit) and buildIr
  // (build.bit) run, so `doc` cannot start disagreeing about the same
  // bit.json — see `manifestLockProblem` (projectpkg.bit) for exactly what
  // it checks.
  let (lockEntries, lockErr) = loadLockEntries(rootDir)
  let manifestProblem = manifestLockProblem(rootDir, lockEntries, lockErr)
  if (manifestProblem != "") {
    eprint("bit doc: ${manifestProblem}\n")
    return false
  }
  let p = loadProject(path, "", stdRootPath())
  if (p.root < 0 || len(p.mods) == 0) {
    eprint("bit doc: not a module: ${path}\n")
    return false
  }
  let mods = resolveProject(p)
  if (reportCheckErrors(p.diags)) {
    return false
  }
  checkResolved(p, mods)
  // Final gate: renders a warnings-only sink too (#2491), unlike the
  // parse+resolve gate above.
  if (reportCheckDiagnostics(p.diags)) {
    return false
  }
  let syms = collectDoc(mods[p.root], withFields)
  if (asJson) {
    print(docJson(syms))
  } else {
    print(docPlain(syms))
  }
  return true
}

// #2271: resolves `bit doc`'s operand as a NAME before `docCmd` (above)
// tries it as a path — this project's bit.lock first, then the stdlib
// root, matching the ticket's own "smallest first" ordering. Three
// outcomes: `(dir, "", true)` once `arg` names a dependency or a "std/x"
// module that resolves to a real directory; `("", detail, true)` when
// `arg` unambiguously named one of those two but could not be resolved —
// the caller reports `detail` and stops, rather than falling through to a
// "not a module: <name>" that hides the actual reason (a malformed
// bit.lock, a fetch failure, a stdlib name with no such module); and
// `("", "", false)` when `arg` matched neither, so the caller treats it as
// a path exactly as it always has.
//
// A relative ("./x", "../x") or absolute ("/x") path never reaches either
// lookup: that syntax is unambiguous, and treating "./textutil" as a
// package name lookup — even one that would legitimately miss — would be
// answering a question the user did not ask.
fn resolveDocByName(arg: string): (string, string, bool) {
  if (len(arg) == 0 || isRelativeImportPath(arg) || startsWith(arg, "/")) {
    return "", "", false
  }
  let (lockEntries, lockErr) = loadLockEntries(".")
  if (lockErr != "") {
    // `lockErr` (readLock, pmlock.bit) already reads "bit.lock: malformed
    // JSON: <path>" — no second "bit.lock: " prefix here.
    return "", lockErr, true
  }
  let (_, found) = lockEntries[arg]
  if (found) {
    return resolveDocLockEntry(lockEntries, arg)
  }
  if (startsWith(arg, "std/")) {
    return resolveDocStdName(arg)
  }
  return "", "", false
}

// `arg` (a "std/x" name) resolved against the stdlib root `stdRootPath()`
// (mainpaths.bit) reports — "" when no stdlib is reachable at all, in
// which case the caller falls through to the ordinary path check and gets
// its usual "no such file or directory", not a new message for a case that
// already had one.
fn resolveDocStdName(arg: string): (string, string, bool) {
  let root = stdRootPath()
  if (root == "") {
    return "", "", false
  }
  let dir = pathJoinResolve(root, arg[4:len(arg)])
  if (!fsIsDir(dir)) {
    return "", "not a module: ${arg}", true
  }
  return dir, "", true
}

// `arg` is a name already found in `lockEntries` — resolved to its cache
// (or local-path) directory through the exact same `resolvePackageImport`
// (projectpkg.bit) a real build's `import "textutil"` resolves through, so
// `bit doc textutil` can never disagree with what the project would
// actually compile against. `lw.sm`/`lw.diags` are built fresh and unused
// here: `resolvePackageImport` never reads them, but `Loader` (project.bit)
// has no zero value, so every field needs a real one regardless.
fn resolveDocLockEntry(lockEntries: map<string, LockEntry>, arg: string): (string, string, bool) {
  let (cacheRoot, cacheRootErr) = loadCacheRoot()
  let sm = newSourceManager()
  let lw = Loader{
    mods: []SrcModule(0), rootDir: ".", resolved: map<string, int>{},
    loading: map<string, bool>{}, stdRoot: stdRootPath(), prelude: -1,
    sm: sm, diags: newDiagnostics(sm), overlays: map<string, string>{},
    lockEntries: lockEntries, lockErr: "", cacheRoot: cacheRoot, cacheRootErr: cacheRootErr,
    pkgDirCache: map<string, string>{}, pkgDetailCache: map<string, string>{},
    parseCache: map<string, SrcModule>{},
  }
  let (dir, detail) = resolvePackageImport(lw, arg)
  if (dir != "") {
    return dir, "", true
  }
  return "", detail, true
}
