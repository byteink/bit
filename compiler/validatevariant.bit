// Self-host: validation of `Enum.Variant(args)` construction — payload ARITY
// (E0050) and payload TYPES (E0041, #4487). Split out as its own sibling file
// because validateexpr.bit was 781 lines and the type rule does not fit under
// the 800-line limit (spec/LINT.md E0200); the two rules are one cohesive unit
// and the arity check is what licenses the type check to index in lockstep.
//
// The match-arm side of §13.8 — a pattern's BINDER count — stays in
// validateexpr.bit with the rest of the match validation (`vMatchArity`).

// ---- E0050 variant-construction arity (§13.7) ------------------------------

// Each `Enum.Variant(args)` payload argument against its DECLARED type (#4487).
// Until this existed, arity was the ONLY judgement a variant construction got,
// so any expression whose COUNT matched was lowered as if it already had the
// declared payload type: `E.F(a)` for `a: f32` into an `f64` payload built rc=0
// and printed the f32 bit pattern read as an f64, and `E.I(b)` for `b: bool`
// into an `i64` payload built rc=0 and printed 1. A silent wrong answer.
//
// The rule is `vExpectExpr` and nothing else. Every other argument position in
// this validator funnels there — a plain call argument (vCallArgTypes), a
// method or func-value argument (vCallArgsExact), a class-literal field
// (classinit.bit), a named argument, a `let` initializer, a `return` — so a
// payload gets the identical assignability rule and the identical E0041
// wording, at the argument's own span, rather than a second variant-shaped
// diagnostic for the same rule. It is also what keeps the legal constructions
// legal: `vExpectExpr` pushes the expectation into a slice literal (`E.Sl([1,
// 2])` for a `[]i32` payload) and reaches `vAssignableNode`, which range-checks
// an untyped integer constant against the target rather than comparing its
// DEFAULT type (`E.Num(1)` for an `f64` payload, `E.Many(2, 3)` for an `f32`).
// `vAssignable` alone answers no to both of those.
//
// Called only after the arity check has RETURNED on a mismatch, so `args` and
// `types` are the same length by construction — reporting N type errors under a
// wrong count is noise on top of the one diagnostic that explains it.
fn vVariantPayloadTypes(c: Checker, args: []int, types: []int) {
  let i = 0
  while (i < len(types)) {
    let want = types[i]
    // THE SAFETY RULE, as everywhere else here: an inference gap (`invalid`,
    // bare or nested) or an open type parameter is undecidable, not an error.
    // A generic enum reaches this through `userTypeLookup`'s BARE name, so
    // `Box<T>.Hold(v)` answers a TypeParam payload and must not be judged.
    if (want != 0 && !vMentionsInvalid(c, want, 0) && !vHasTypeParam(c, want, 0)) {
      let a = args[i]
      if (getNode(c.tree, a).tag == Tag.Arg) {
        a = kidsOf(c.tree, a)[0]
      }
      vExpectExpr(c, a, want)
    }
    i = i + 1
  }
}

// Checks `Enum.Variant(args)` builds the variant with the right number of
// payload values, then that each value has the declared payload TYPE. Only a
// member callee whose base names an enum type and whose variant exists is
// judged (unknown variants are E0070's concern elsewhere); the arity span is
// the whole call, matching the seed, and a payload mismatch reports at the
// ARGUMENT. Method calls skip here — their base is a value, not a type, so
// userTypeLookup misses.
fn vVariantArity(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(c.tree, callee) // [base, name]
  let baseName = typeNodeName(c, mk[0])
  if (baseName == "") {
    return
  }
  let ut = userTypeLookup(c, baseName)
  if (ut == 0 || c.ctx.types[ut].kind != TypeKind.Enum) {
    return
  }
  let vn = getNode(c.tree, mk[1])
  let vname = c.source[vn.span.start:vn.span.end]
  if (vIndexOfName(vEnumVariantNames(c, ut), vname) < 0) {
    return
  }
  let types = variantPayloadTypes(c, ut, vname)
  let args = kidsOf(c.tree, kids[2])
  let want = len(types)
  let got = len(args)
  if (want != got) {
    reportNoHint(
      c.diags, ecArgCount, vSpan(c, node),
      "variant '${vname}' takes ${want} argument(s), found ${got}",
    )
    return
  }
  vVariantPayloadTypes(c, args, types)
}
