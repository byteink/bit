// In-Bit self-checks for pesyms.bit's admitted Windows import surface (#3328,
// epic #3322). Sibling .bit files are the same module, so `selfcheck()` calls
// these directly.
//
// `compare` (std/strings) is used below without a local import: an import is
// per-MODULE in Bit, not per-file, and compiler/lintbatch.bit already imports
// it — a second `import { compare } from "std/strings"` here would be
// E0042 already declared in this scope. No new module-scope import is added
// by this file.

// A count tripwire, the same shape as machosymscheck.bit's
// checkLibsystemTableCount: an edit to windowsImports() that changes its
// length reddens this test instead of passing silently, so growing or
// shrinking the admitted surface is always a deliberate, reviewed change.
//
// The pinned number itself is windowsImportsCount, declared in
// compiler/pesyms.bit immediately above windowsImports() — not here. #4302:
// it used to be a literal folded into this comment, in a file an author
// adding a PeImport entry had no reason to open; two additions in a row
// (#4016, #4014) went stale for exactly that reason, and the second
// reddened a release gate with a bare "assertion failed" that sent the
// first investigation at the wrong subsystem entirely.
fn checkWindowsImportsTableCount() {
  let got = len(windowsImports())
  assert(
    got == windowsImportsCount,
      "windowsImports() (compiler/pesyms.bit) now has ${got} admitted " +
      "import(s), but windowsImportsCount (compiler/pesyms.bit, declared " +
      "immediately above windowsImports()) still says " +
      "${windowsImportsCount}. Adding or removing a PeImport entry is " +
      "expected to move this count -- update windowsImportsCount to " +
      "${got} in compiler/pesyms.bit, in the same commit.",
  )
}

// The table is sorted by `symbol` and duplicate-free, checked programmatically
// over the table itself — the same property machosyms.bit:115 documents but,
// unlike machosymscheck.bit (written while #1664 was open), actually asserted
// here: #1664 fixed string `<`/`>` to compare content (95966d1a), but this
// uses std/strings' byte-wise `compare` rather than the operator, matching how
// the rest of the compiler already sorts strings (compiler/lintbatch.bit:96).
// Strict `< 0`, not `<= 0`, is what also rules out a duplicate: two equal
// neighbors would compare 0, not negative, and fail this assert.
fn checkWindowsImportsSortedAndUnique() {
  let table = windowsImports()
  let i = 1
  while (i < len(table)) {
    assert(compare(table[i - 1].symbol, table[i].symbol) < 0)
    i = i + 1
  }
}

// Every admitted symbol is defined, scored over the WHOLE table, not a
// sample — the same discipline checkLibsystemDefines uses. Near-misses of
// real entries (a prefix/suffix match) must not count, and neither must the
// empty string or a plausible-looking but unadmitted Windows API name.
fn checkWindowsImportDefines() {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    assert(windowsImportDefines(table[i].symbol))
    i = i + 1
  }
  assert(!windowsImportDefines(""))
  assert(!windowsImportDefines("definitelyNotAnAdmittedWindowsImport1234"))
  // Near-misses of real entries: a prefix/suffix match must not count.
  assert(!windowsImportDefines("ExitProces"))
  assert(!windowsImportDefines("ExitProcessEx"))
  assert(!windowsImportDefines("exitprocess"))
  assert(!windowsImportDefines("WriteFil"))
  // A real Windows entropy API this table does NOT admit: the legacy
  // RtlGenRandom, exported as SystemFunction036 from advapi32.dll. #3338
  // chose BCryptGenRandom (bcrypt.dll) instead — see pesyms.bit's header.
  assert(!windowsImportDefines("SystemFunction036"))
  // The modern entropy API IS admitted, from its own DLL.
  assert(windowsImportDefines("BCryptGenRandom"))
}

// windowsImportDll yields the owning DLL for every admitted symbol, and
// ("", false) for a rejected one — asserted over the WHOLE table plus an
// explicit admitted/rejected pair for EACH of the table's five owning DLLs
// (#3338 grew this from one DLL to two; #3336 grew it to three after
// WaitOnAddress/WakeByAddressAll/WakeByAddressSingle turned out NOT to be
// kernel32.dll exports — see pesyms.bit's header for the verified reason;
// #3339 grew it to four with ws2_32.dll for the IOCP netpoller; #3589 grew
// it to five with iphlpapi.dll for nameserver discovery).
fn checkWindowsImportDll() {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    let (dll, ok) = windowsImportDll(table[i].symbol)
    assert(ok)
    assert(dll == table[i].dll)
    assert(
        dll == "kernel32.dll" ||
        dll == "bcrypt.dll" ||
        dll == "kernelbase.dll" ||
        dll == "ws2_32.dll" ||
        dll == "iphlpapi.dll",
    )
    i = i + 1
  }
  let (admittedDll, admittedOk) = windowsImportDll("ExitProcess")
  assert(admittedOk)
  assert(admittedDll == "kernel32.dll")
  let (bcryptDll, bcryptOk) = windowsImportDll("BCryptGenRandom")
  assert(bcryptOk)
  assert(bcryptDll == "bcrypt.dll")
  let (kernelbaseDll, kernelbaseOk) = windowsImportDll("WaitOnAddress")
  assert(kernelbaseOk)
  assert(kernelbaseDll == "kernelbase.dll")
  let (ws2Dll, ws2Ok) = windowsImportDll("WSAStartup")
  assert(ws2Ok)
  assert(ws2Dll == "ws2_32.dll")
  let (iphlpapiDll, iphlpapiOk) = windowsImportDll("GetAdaptersAddresses")
  assert(iphlpapiOk)
  assert(iphlpapiDll == "iphlpapi.dll")
  let (rejectedDll, rejectedOk) = windowsImportDll("RegOpenKeyExW")
  assert(!rejectedOk)
  assert(rejectedDll == "")
}

// peArchiveDefines (#3349), the Windows twin of machosymscheck.bit's
// checkMachoArchiveDefines: a real member that DEFINES the symbol, one that
// only REFERENCES it (`hasSection: false`), and one that defines it LOCALLY
// — the three shapes that separate "defines" from "mentions". No decoration
// step to verify (unlike Mach-O's leading underscore): x64 COFF names its
// externs verbatim, so the source-level name IS the archive-held name.
fn checkPeArchiveDefines() {
  let code = [u8(0xC3)] // ret
  let definer = PeObject{
    sections: [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    symbols: [
      PeSymbol{
        name: "bit_rt_probe", hasSection: true,
        section: PeSectionKind.Text, offset: 0, size: len(code),
        binding: PeBinding.Global, kind: PeSymKind.Func,
      },
    ],
    relocations: []PeRelocation(0),
  }
  // `hasSection: false` is what makes the symbol undefined — a reference, not
  // a definition.
  let caller = PeObject{
    sections: [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    symbols: [
      PeSymbol{
        name: "caller", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Global, kind: PeSymKind.Func,
      },
      PeSymbol{
        name: "bit_rt_absent", hasSection: false, section: PeSectionKind.Text,
        offset: 0, size: 0, binding: PeBinding.Global, kind: PeSymKind.Notype,
      },
    ],
    relocations: []PeRelocation(0),
  }
  let localOnly = PeObject{
    sections: [PeSection{ kind: PeSectionKind.Text, data: code, size: 0, alignment: 16 }],
    symbols: [
      PeSymbol{
        name: "bit_rt_local", hasSection: true, section: PeSectionKind.Text,
        offset: 0, size: len(code), binding: PeBinding.Local, kind: PeSymKind.Func,
      },
    ],
    relocations: []PeRelocation(0),
  }

  let t = PeTarget.X86_64
  let ar = writeArchive(
    [
      ArMember{
        name: "definer.o",
        data: writePeObject(t, definer) catch _ {
          []u8(0)
        },
      },
      ArMember{
        name: "caller.o",
        data: writePeObject(t, caller) catch _ {
          []u8(0)
        },
      },
      ArMember{
        name: "localonly.o",
        data: writePeObject(t, localOnly) catch _ {
          []u8(0)
        },
      },
    ],
    arFormatGnu(),
  )

  assert(peArchiveDefines(ar, "bit_rt_probe"))
  // Only referenced: not admissible. The whole point of the test.
  assert(!peArchiveDefines(ar, "bit_rt_absent"))
  // Locally defined: invisible to the link, so not admissible.
  assert(!peArchiveDefines(ar, "bit_rt_local"))
  assert(!peArchiveDefines(ar, "bit_rt_no_such_symbol_exists_anywhere"))
  // Undecidable inputs answer false, never accept.
  assert(!peArchiveDefines([]u8(0), "bit_rt_probe"))
  assert(!peArchiveDefines([]byte("not an ar archive at all"), "bit_rt_probe"))
}
