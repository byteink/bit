// In-Bit self-checks for pesyms.bit's admitted Windows import surface (#3328,
// epic #3322). Sibling .bit files are the same module, so `selfcheck()` calls
// these directly.
//
// `compare` (std/strings) is used below without a local import: an import is
// per-MODULE in Bit, not per-file, and compiler/lintbatch.bit already imports
// it — a second `import { compare } from "std/strings"` here would be
// E0042 already declared in this scope. No new module-scope import is added
// by this file.

// A count tripwire, the same shape as machosymscheck.bit's
// checkLibsystemTableCount: an edit to windowsImports() that changes its
// length reddens this test instead of passing silently, so growing or
// shrinking the admitted surface is always a deliberate, reviewed change.
fn checkWindowsImportsTableCount() {
  assert(len(windowsImports()) == 58)
}

// The table is sorted by `symbol` and duplicate-free, checked programmatically
// over the table itself — the same property machosyms.bit:115 documents but,
// unlike machosymscheck.bit (written while #1664 was open), actually asserted
// here: #1664 fixed string `<`/`>` to compare content (95966d1a), but this
// uses std/strings' byte-wise `compare` rather than the operator, matching how
// the rest of the compiler already sorts strings (compiler/lintbatch.bit:96).
// Strict `< 0`, not `<= 0`, is what also rules out a duplicate: two equal
// neighbors would compare 0, not negative, and fail this assert.
fn checkWindowsImportsSortedAndUnique() {
  let table = windowsImports()
  let i = 1
  while (i < len(table)) {
    assert(compare(table[i - 1].symbol, table[i].symbol) < 0)
    i = i + 1
  }
}

// Every admitted symbol is defined, scored over the WHOLE table, not a
// sample — the same discipline checkLibsystemDefines uses. Near-misses of
// real entries (a prefix/suffix match) must not count, and neither must the
// empty string or a plausible-looking but unadmitted Windows API name.
fn checkWindowsImportDefines() {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    assert(windowsImportDefines(table[i].symbol))
    i = i + 1
  }
  assert(!windowsImportDefines(""))
  assert(!windowsImportDefines("definitelyNotAnAdmittedWindowsImport1234"))
  // Near-misses of real entries: a prefix/suffix match must not count.
  assert(!windowsImportDefines("ExitProces"))
  assert(!windowsImportDefines("ExitProcessEx"))
  assert(!windowsImportDefines("exitprocess"))
  assert(!windowsImportDefines("WriteFil"))
  // A real Windows API this table does NOT admit (advapi32.dll, not
  // kernel32.dll — see pesyms.bit's header on why entropy is out of scope).
  assert(!windowsImportDefines("SystemFunction036"))
}

// windowsImportDll yields the owning DLL for every admitted symbol, and
// (\"\", false) for a rejected one — asserted over the WHOLE table plus one
// explicit admitted/rejected pair for kernel32.dll, the table's one owning
// DLL for this round (acceptance's "per owning DLL" over a single-DLL table).
fn checkWindowsImportDll() {
  let table = windowsImports()
  let i = 0
  while (i < len(table)) {
    let (dll, ok) = windowsImportDll(table[i].symbol)
    assert(ok)
    assert(dll == table[i].dll)
    assert(dll == "kernel32.dll")
    i = i + 1
  }
  let (admittedDll, admittedOk) = windowsImportDll("ExitProcess")
  assert(admittedOk)
  assert(admittedDll == "kernel32.dll")
  let (rejectedDll, rejectedOk) = windowsImportDll("RegOpenKeyExW")
  assert(!rejectedOk)
  assert(rejectedDll == "")
}
