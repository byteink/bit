// #2284: E0210 `unused-import` must be scoped to the MODULE, not the file lint
// happens to be looking at. Sibling `.bit` files in a directory are one module
// sharing one flat import namespace (compiler/project.bit's `SrcModule`
// contract — the same scope the binder already uses, and the reason #2121's
// E0042 "already imported" fires across sibling files at all). An import used
// only by a sibling file is genuinely used; reporting it unused is actively
// harmful, since deleting it — the finding's own suggested fix — breaks the
// build.
//
// `unused-local` (E0211) needs none of this: a function-local binding cannot
// be read from another file, so its scope was already correct.
//
// Kept out of lint.bit and lintunused.bit on purpose (both are already at or
// over their size budget) as a POST-FILTER over the findings `runLintRules`
// already computed, rather than a change to `lintAnalyzeUnused`/
// `lintUnusedImport` themselves: those two also back `compiler/lspserver.bit`'s
// per-keystroke lint pass, which lints one open buffer and has no reason to
// pay for a directory-wide reparse on every edit. The CLI is the only caller
// that walks a directory in the first place, so this is where the module view
// belongs.

// #4228: the module view now applies REGARDLESS of how `bit lint` was
// invoked — the previous cut (apply it only to files swept in by a
// directory walk, never to a file named explicitly on argv) was a proxy for
// "is this really a multi-file module", based on argv shape rather than on
// the directory's actual contents, and it was wrong: `bit lint
// runtime/root/linux/boot.bit` (an explicit file, in a real directory
// module deliberately split across sibling files, e.g. #4094's darwin
// pair) reported every import used only by its sibling `bootstats.bit` as
// unused. `loadModuleAt`'s `only` parameter answers a different question —
// what to COMPILE — and stays exactly as it was; it has no bearing on
// whether an import is dead CODE, which is a project-wide question.
//
// The real signal for "is this directory one coherent module" is whether it
// resolves as one without duplicate top-level declarations — see
// `lintModuleUsedImportNames` below, which is where that is now checked.
class LintFile {
  path: string,
}

// Sorted by path (insertion sort — the file list is small): two paths naming
// the same file must still lint in one deterministic order regardless of argv
// order, matching the golden ordering the runner already promises.
fn lintSortFiles(xs: []LintFile): []LintFile {
  let i = 1
  while (i < len(xs)) {
    let j = i
    while (j > 0 && compare(xs[j - 1].path, xs[j].path) > 0) {
      let tmp = xs[j - 1]
      xs[j - 1] = xs[j]
      xs[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
  return xs
}

// Computed once per module directory and cached: a directory linted via N
// sibling files in one run must pay for the extra parse+resolve once, not N
// times. Keyed by directory path exactly as `collectLintFiles` derived it
// (via `pathDir`), which is consistent within one run because the same path
// string always maps to the same key.
class LintModuleCache {
  dirs: map<string, map<string, bool>>,
}

fn newLintModuleCache(): LintModuleCache {
  return LintModuleCache{ dirs: map<string, map<string, bool>>{} }
}

// The names of every `ImportItem`/`ImportNamespace` symbol referenced
// ANYWHERE in the module rooted at `dir` — computed from every `.bit` file
// `listBitFiles` finds ON DISK, not only the ones this `bit lint` invocation
// happens to have been pointed at, since the module boundary is the
// directory, independent of argv (mirrors `loadModuleAt`, project.bit).
//
// Reuses the exact single-file machinery `lintAnalyzeUnused` (lintunused.bit)
// already uses — `buildStubImports`, `collectWriteOnlyNodes`,
// `computeUsedSymbols` — just over the module's CONCATENATED source instead
// of one file's, the same concatenation `SrcModule` itself uses to give every
// sibling file one flat scope.
//
// #4228: an import re-declared by two sibling files (illegal per #2121's
// E0042 once the directory really is one module) is now the signal this
// function uses to tell a real multi-file module apart from a directory that
// merely holds several UNRELATED single-file programs — `_tests_/cases/` is
// exactly the latter: ~595 independent fixtures, several of which import the
// same stdlib name for unrelated reasons (`_tests_/cases/lint_unused_import.bit`
// leaves `foo` genuinely dead while its unrelated neighbour
// `lint_unused_import_nested_use.bit` uses a same-named `foo`). Concatenating
// such a directory produces duplicate-declaration errors (two `fn main`s, two
// `import { foo } ...`) that a real module never would, since `bit check`
// already rejects those; `resolveDiags.errorCount > 0` is read as "this
// directory is not one module" and `usedNames` is left empty, so every E0210
// finding in an incoherent directory stands exactly as computed per-file —
// the same outcome the old argv-based `swept` cut gave `_tests_/cases/`, now
// reached by asking what the directory actually contains instead of how it
// was named on the command line.
fn lintModuleUsedImportNames(cache: LintModuleCache, dir: string): map<string, bool> {
  let (hit, found) = cache.dirs[dir]
  if (found) {
    return hit
  }
  let names = listBitFiles(dir)
  let source = ""
  for name of names {
    let text = readFile(dir + "/" + name) catch _ {
      continue // unreadable sibling: skipped, like the project loader does
    }
    source = source + text + "\n"
  }
  let tree = parseSource(source)
  let stubs = buildStubImports(tree, source)
  let scratchSm = newSourceManager()
  let scratchFile = addFile(scratchSm, "", source)
  let m = SrcModule{
    dir: "", fileNames: []string(0), fileStarts: [0], source: source, tree: tree,
    imports: stubs.paths, files: [scratchFile],
  }
  let resolveDiags = newDiagnostics(scratchSm)
  // #3244: `isRootModule: true` — this directory is the one under lint.
  // #4295: `prelude: -1` deliberately, matching `lintAnalyzeUnused`'s own
  // per-file design (this rule needs no type information, only which name a
  // reference resolves to) -- see `lintHasDuplicateDeclaration` below for why
  // that makes `resolveDiags.errorCount` unsafe to gate on directly.
  let mod = resolveModule(resolveDiags, m, stubs.mods, -1, false, true)
  let usedNames = map<string, bool>{}
  if (!lintHasDuplicateDeclaration(resolveDiags)) {
    let used = computeUsedSymbols(mod, collectWriteOnlyNodes(tree))
    let i = 1
    while (i < len(mod.symbols)) {
      let s = mod.symbols[i]
      if ((s.kind == SymbolKind.ImportItem || s.kind == SymbolKind.ImportNamespace) && used[i]) {
        usedNames[s.name] = true
      }
      i = i + 1
    }
  }
  cache.dirs[dir] = usedNames
  return usedNames
}

// #4295/#4293: whether the concatenated module produced a real E0042
// "already declared in this scope" -- the ACTUAL signal #4228's own header
// above describes for "this directory is not one coherent module", and the
// only one: `rReportDuplicate` (resolve.bit) is the sole call site for
// `ecDuplicateDeclaration`, used for every kind of top-level name collision
// (two `fn main`s, two `import { foo }`s, ...) alike, since module-level
// names share one flat scope.
//
// `resolveDiags.errorCount == 0` (the previous gate) was wrong: this
// function passes `prelude: -1` above, so ANY reference anywhere in the
// concatenated module to a prelude name (`newError`, `println`, `Result`,
// `Option`, ...) reports as `E0040 undefined name` here even though it
// resolves fine in the real build -- that is expected noise, not
// incoherence. On a real multi-file module of any size, that noise was
// enough to make `errorCount` nonzero on virtually every run (measured on
// `compiler/`: 296 such errors, zero duplicate declarations), which emptied
// `usedNames` unconditionally and silently disabled the whole sibling-usage
// filter -- reproducing, at module scale, exactly the false positive #2284
// and #4228 both exist to prevent. Confirmed as the root cause of #4293 and
// #4295's compiler/stdlib lint-ceiling overage: 85 of 86 E0210 findings
// behind those tickets were genuinely-used sibling imports miscounted as
// dead for this exact reason.
fn lintHasDuplicateDeclaration(d: Diagnostics): bool {
  let i = 0
  while (i < len(d.list)) {
    if (d.list[i].code == ecDuplicateDeclaration) {
      return true
    }
    i = i + 1
  }
  return false
}

// Drops every E0210 finding whose import name IS used elsewhere in its
// module — for EVERY file, regardless of whether `bit lint` reached it by a
// directory walk or by naming it explicitly on argv (#4228). Whether the
// directory is a real module at all is decided inside
// `lintModuleUsedImportNames` itself (an incoherent directory yields an
// empty `usedNames`, so this drops nothing for it); this function no longer
// needs to know how the file was reached.
//
// A post-filter over the findings already computed, not a change to how they
// are computed: `span.start:span.end` for an E0210 finding is always the
// imported name's own span (`lintUnusedImport`, lintunused.bit), so the name
// is read straight back out of the source rather than re-parsed from the
// message text.
fn lintDropModuleUsedImports(findings: Diagnostics, cache: LintModuleCache) {
  let out = []Diagnostic(0)
  let i = 0
  while (i < len(findings.list)) {
    let g = findings.list[i]
    if (g.code == ecLintUnusedImport) {
      let dir = pathDir(filePath(findings.sm, g.span.file))
      let usedNames = lintModuleUsedImportNames(cache, dir)
      let name = fileSource(findings.sm, g.span.file)[g.span.start:g.span.end]
      let (isUsed, _) = usedNames[name]
      if (isUsed) {
        i = i + 1
        continue // used by a sibling file in the same module (#2284)
      }
    }
    out = append(out, g)
    i = i + 1
  }
  findings.list = out
}
