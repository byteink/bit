// Derived-pointer reach and copy roots for live-interval construction — moved
// verbatim out of `codegenlive.bit` (#4322), which was 797 lines against the
// hard 800-line E0200 ceiling.
//
// Two fixpoints and the edge index they share: `derivedReach`, which holds a
// base open to the last position anything derived from it is live, and
// `computeCopyRoots`, which collapses block-param copy chains to one root.
// Interval seeding and extension stay in `codegenlive.bit`; read its banner
// first.
//
// One module with `codegen.bit` and its siblings, so nothing is imported here
// — a duplicate import is E0042.
// Per value, the last position any raw pointer transitively derived from it is
// still live. `extendKeepAlive` holds a base open to this rather than to its
// derived value's own end, so an edge recorded on one link of a chain covers
// the whole chain.
//
// Bounded by the instruction count and stopped by the first round that changes
// nothing; a function with no keepalive edges never calls it at all. Straight-
// line chains resolve in one round because `instrOperands`' contract is that an
// operand's def index is below its use's, so the descending walk sees a user
// before the value it derives from. A loop-carried pointer needs a second
// round, which is why this is a fixpoint and not a single pass.
fn derivedReach(ctx: TypeContext, f: IrFunc, intervals: []LiveInterval): []int {
  let reach = []int(0)
  let i = 0
  while (i < len(intervals)) {
    reach = append(reach, intervals[i].end)
    i = i + 1
  }
  let round = 0
  while (round <= len(f.instrs)) {
    if (!raiseReachRound(ctx, f, reach)) {
      return reach
    }
    round = round + 1
  }
  return reach
}

// One round of the closure. Two rules, one question — which values must stay
// rooted for a raw pointer to remain valid:
//   - an instruction whose RESULT is a `*T` is derived from every value it
//     reads, so its reach flows back to each operand;
//   - a block parameter of type `*T` is derived from the argument each
//     predecessor binds to it, so its reach flows back along the edge
//     (`instrOperands` cannot see that: a terminator's args are operands of the
//     terminator, and the terminator is not a pointer).
fn raiseReachRound(ctx: TypeContext, f: IrFunc, reach: []int): bool {
  let changed = false
  let i = len(f.instrs)
  while (i > 0) {
    i = i - 1
    if (isRawPtrType(ctx, f.instrs[i].ty)) {
      if (raiseReachList(reach, instrOperands(f, i), reach[i])) {
        changed = true
      }
    }
  }
  if (raiseReachEdges(ctx, f, reach)) {
    changed = true
  }
  return changed
}

fn raiseReachList(reach: []int, ids: []int, to: int): bool {
  let changed = false
  let k = 0
  while (k < len(ids)) {
    let o = ids[k]
    if (o >= 0 && o < len(reach) && reach[o] < to) {
      reach[o] = to
      changed = true
    }
    k = k + 1
  }
  return changed
}

fn raiseReachEdges(ctx: TypeContext, f: IrFunc, reach: []int): bool {
  let changed = false
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so
    // malformed IR cannot index out of bounds behind our backs.
    if (b.instsLen > 0) {
      let t = f.instrs[b.instsStart + b.instsLen - 1]
      if (t.op == Op.Jump && raiseReachArgs(ctx, f, reach, t.ival, t.args)) {
        changed = true
      }
      if (t.op == Op.Br) {
        if (raiseReachArgs(ctx, f, reach, t.ival, t.thenArgs)) {
          changed = true
        }
        if (raiseReachArgs(ctx, f, reach, t.ival2, t.elseArgs)) {
          changed = true
        }
      }
    }
    bi = bi + 1
  }
  return changed
}

fn raiseReachArgs(ctx: TypeContext, f: IrFunc, reach: []int, target: int, args: []int): bool {
  if (target < 0 || target >= len(f.blocks)) {
    return false
  }
  let blk = f.blocks[target]
  let changed = false
  let k = 0
  while (k < len(args) && k < blk.paramCount) {
    let p = blk.instsStart + k
    if (isRawPtrType(ctx, f.instrs[p].ty)) {
      if (raiseReachList(reach, [args[k]], reach[p])) {
        changed = true
      }
    }
    k = k + 1
  }
  return changed
}

// ===========================================================================
// SSA copy roots (#3738)
//
// A block param whose predecessors all pass the same value IS that value: the
// edge's parallel move writes `P := A` on every path into the block, so P and A
// can share one location and every one of those moves becomes a self-move the
// sequencer drops. `allocateCoalesced` (regalloc.bit) consumes what this
// computes.
//
// This is what the emitted code costs without it. `schedWorkPending`
// (runtime/sched/worker.bit) threads six loop-invariant values — the worker, the
// scheduler, the worker count, this worker's id — through the params of every
// block in its steal loop. Each block gave each of them a fresh vreg and the
// allocator gave each fresh vreg a fresh register, so one iteration paid a
// six-register round trip (x25->x20, x27->x23, x26->x22 on the way in and back
// again on the way out) for values nothing ever writes. Measured on 189ef1e6:
// 34 of the function's 156 instructions were `mov`, and the pressure that
// shuffle created spilled the loop counter to the frame as well.
//
// A CHAIN AND A LOOP BOTH NEED A FIXPOINT, which is why this is not a single
// pass over the edges. bb12's param is fed by bb8's copy of bb7's param and by
// bb11's copy of the same value; neither is literally bb7's vreg, so they agree
// only once both have been resolved to it. And bb7's own param is fed by the
// entry value and, around the back edge, by a copy of itself.
//
// THE SELF-REFERENCE RULE IS RESTRICTED TO BACK EDGES ON PURPOSE. Ignoring an
// argument that resolves to the param itself is what collapses the loop-carried
// pass-through, and it is sound because the first entry to the block cannot come
// from an edge carrying the param's own value — that edge is only reachable once
// the block has already run. Bit lowers only structured `while`/`for`, so every
// loop is reducible and "the edge that closes the loop" is exactly
// `isBackEdge`; requiring it rather than trusting the value test keeps the
// argument true without depending on reducibility holding forever.
// ===========================================================================

// One CFG edge, with the arguments its terminator binds to the target's params.
// `src` is the predecessor block index (`from` is a reserved word, SPEC §5.2).
class IrEdge {
  src: int,
  target: int,
  args: []int,
}

fn collectEdges(f: IrFunc): []IrEdge {
  let out = []IrEdge(0)
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so
    // malformed IR cannot index out of bounds behind our backs.
    if (b.instsLen > 0) {
      let t = f.instrs[b.instsStart + b.instsLen - 1]
      if (t.op == Op.Jump) {
        out = append(out, IrEdge{ src: bi, target: t.ival, args: t.args })
      }
      if (t.op == Op.Br) {
        out = append(out, IrEdge{ src: bi, target: t.ival, args: t.thenArgs })
        out = append(out, IrEdge{ src: bi, target: t.ival2, args: t.elseArgs })
      }
    }
    bi = bi + 1
  }
  return out
}

// Follows `v`'s chain to the vreg that owns the location. Bounded by the array
// length — entries are written already-resolved, so this is one hop in practice
// and the guard only exists so a malformed table cannot spin.
fn copyRootOf(roots: []int, v: int): int {
  let r = v
  let guard = 0
  while (roots[r] != r && guard < len(roots)) {
    r = roots[r]
    guard = guard + 1
  }
  return r
}

// Edge indices grouped by target block, so a refinement round costs one pass
// over each block's OWN predecessors rather than over every edge in the
// function. Without it the walk is quadratic in the block count on every round
// and shows up as compiler wall clock, not as generated code.
// IrEdge is a class (reference type, SPEC §13.3), so grouping the edges
// themselves by target costs no more than grouping their indices did -- each
// slot is a pointer to the same edge object, not a copy of it -- and it is
// what lets paramRootCandidate drop both `edges` and `inEdges` for a single
// already-scoped `[]IrEdge` (see #3764).
fn indexEdges(f: IrFunc, edges: []IrEdge): [][]IrEdge {
  let byTarget = [][]IrEdge(0)
  let i = 0
  while (i < len(f.blocks)) {
    byTarget = append(byTarget, []IrEdge(0))
    i = i + 1
  }
  i = 0
  while (i < len(edges)) {
    let t = edges[i].target
    if (t >= 0 && t < len(byTarget)) {
      byTarget[t] = append(byTarget[t], edges[i])
    }
    i = i + 1
  }
  return byTarget
}

// The single root every predecessor passes into param `p` (slot `k` of block
// `bi`), or -1 when the block has no predecessor, when two predecessors
// disagree, or when a terminator's argument list is too short for the slot.
// `inEdges` is already scoped to `bi`'s predecessors (indexEdges groups by
// target), so it carries the edges themselves rather than indices plus a
// separate `edges` array to dereference them through.
fn paramRootCandidate(f: IrFunc, inEdges: []IrEdge, roots: []int, bi: int, k: int): int {
  let p = f.blocks[bi].instsStart + k
  let cand = -1
  let e = 0
  while (e < len(inEdges)) {
    let ed = inEdges[e]
    if (k >= len(ed.args)) {
      return -1
    }
    let r = copyRootOf(roots, ed.args[k])
    if (r != p || !isBackEdge(ed.src, bi)) {
      if (cand < 0) {
        cand = r
      }
      if (cand != r) {
        return -1
      }
    }
    e = e + 1
  }
  return cand
}

// One refinement round over every still-unresolved param. Returns whether
// anything moved, so the caller can stop at the fixpoint.
fn refineCopyRoots(f: IrFunc, byTarget: [][]IrEdge, roots: []int): bool {
  let changed = false
  // Block 0's params are the function's incoming ARGUMENTS: the prologue binds
  // them from the ABI's argument registers, not from any edge move, so nothing
  // a predecessor passes describes them. A back edge that targeted block 0
  // would otherwise offer a candidate and the prologue would then write over
  // the value it was aliased to.
  let bi = 1
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let k = 0
    while (k < b.paramCount) {
      let p = b.instsStart + k
      if (roots[p] == p) {
        let cand = paramRootCandidate(f, byTarget[bi], roots, bi, k)
        if (cand >= 0 && cand != p) {
          roots[p] = cand
          changed = true
        }
      }
      k = k + 1
    }
    bi = bi + 1
  }
  return changed
}

// Per instruction slot, the vreg whose location it must share — itself when it
// has none. Bounded: a round that changes nothing stops the walk, and no walk
// runs more rounds than there are blocks (each round resolves at least one
// param or is the last).
fn computeCopyRoots(f: IrFunc): []int {
  let roots = []int(0)
  let i = 0
  while (i < len(f.instrs)) {
    roots = append(roots, i)
    i = i + 1
  }
  let edges = collectEdges(f)
  let byTarget = indexEdges(f, edges)
  let round = 0
  while (round <= len(f.blocks)) {
    if (!refineCopyRoots(f, byTarget, roots)) {
      return normalizeCopyRoots(roots)
    }
    round = round + 1
  }
  return normalizeCopyRoots(roots)
}

// Collapses every chain to its endpoint, so a consumer needs no walk of its
// own: a param resolved to a root that a later round resolved further leaves a
// two-hop entry behind. A cycle cannot form (a round only writes an entry that
// still points at itself, and never to a vreg that resolves back to it), and
// `copyRootOf`'s guard bounds the walk regardless.
fn normalizeCopyRoots(roots: []int): []int {
  let i = 0
  while (i < len(roots)) {
    roots[i] = copyRootOf(roots, i)
    i = i + 1
  }
  return roots
}

