// Self-host Stage 3 (#1340): backend-agnostic codegen core. Kept deliberately
// tiny — only logic with zero
// dependency on a physical register file or instruction encoding belongs here;
// everything else (register lists, calling-convention argument mapping, the
// instruction encoder, frame layout) is inherently per-ISA and stays in its own
// backend file. Divergence between backends in code that COULD live here is a
// design smell; extract more here only once a second concrete user demonstrates
// the logic is truly identical, not merely similar.

// One physical register file's class (the seed's regalloc.Class).
enum RegClass {
  Int,
  Float,
}

// A scalar's storage width and class. Mirrors lower.bit's object-layout scheme:
// every scalar prim is stored at its natural width; every other shape is one
// boxed 8-byte handle.
class Width {
  bytes: int,
  regClass: RegClass,
  signed: bool,
}

fn mkWidth(bytes: int, regClass: RegClass, signed: bool): Width {
  return Width{ bytes: bytes, regClass: regClass, signed: signed }
}

// Depends only on the TypeContext, never on a physical register — identical for
// every backend. Prim indices: 0=i8 1=i16 2=i32 3=i64 4=u8 5=u16 6=u32 7=u64
// 8=f32 9=f64 10=bool 11=string.
fn widthOf(ctx: TypeContext, ty: int): Width {
  if (ctx.types[ty].kind != TypeKind.Prim) {
    return mkWidth(8, RegClass.Int, false) // uniform boxed handle
  }
  let p = ctx.types[ty].prim
  if (p == 0) { return mkWidth(1, RegClass.Int, true) }
  if (p == 4) { return mkWidth(1, RegClass.Int, false) }
  if (p == 1) { return mkWidth(2, RegClass.Int, true) }
  if (p == 5) { return mkWidth(2, RegClass.Int, false) }
  if (p == 2) { return mkWidth(4, RegClass.Int, true) }
  if (p == 6) { return mkWidth(4, RegClass.Int, false) }
  if (p == 3) { return mkWidth(8, RegClass.Int, true) }
  if (p == 7) { return mkWidth(8, RegClass.Int, false) }
  if (p == 8) { return mkWidth(4, RegClass.Float, false) }
  if (p == 9) { return mkWidth(8, RegClass.Float, false) }
  if (p == 10) { return mkWidth(1, RegClass.Int, false) }
  return mkWidth(8, RegClass.Int, false) // string
}

fn regClassOf(ctx: TypeContext, ty: int): RegClass {
  return widthOf(ctx, ty).regClass
}

// Whether a value of type `ty` is a GC reference (lower.bit's fieldLayout
// `isPtr`, re-derived here for codegen's own use).
fn isRefType(ctx: TypeContext, ty: int): bool {
  let k = ctx.types[ty].kind
  if (k == TypeKind.Prim) {
    return ctx.types[ty].prim == 11 // string
  }
  // A raw pointer `*T` (§11.4) is a word the GC must never follow.
  if (k == TypeKind.Void || k == TypeKind.UntypedInt || k == TypeKind.UntypedFloat ||
    k == TypeKind.UntypedRune || k == TypeKind.UntypedBool || k == TypeKind.UntypedString ||
    k == TypeKind.UntypedNil || k == TypeKind.Invalid || k == TypeKind.TypeParam ||
    k == TypeKind.Fallible || k == TypeKind.Ptr) {
    return false
  }
  if (k == TypeKind.Enum) {
    // A bare tag word, or a boxed {tag, payloadPtr} if it has payloads.
    return ctx.types[ty].enumBoxed
  }
  return true // slice/array/map/tuple/chan/class/interface/func
}

// What an object writer must patch into the field a Reloc names. x86-64 only
// ever emits Branch (its `movabs` needs no relocation to name an address);
// ARM64 has no wide-immediate address-of, so it names a static symbol with an
// ADRP/ADD pair — Page21 patches the ADRP's page number, PageOff12 the ADD's
// in-page offset.
enum RelocKind {
  // A PC-relative call/branch immediate: AArch64's BL (26-bit), x86-64's
  // `E8 rel32` (4 bytes). Both name a target symbol the linker resolves.
  Branch,
  // AArch64 address materialization: adrp's 21-bit page number, then the
  // add/ldr's 12-bit page offset.
  Page21,
  PageOff12,
  // A full 64-bit absolute address, written into an 8-byte field. x86-64 needs
  // this where AArch64 uses the Page21/PageOff12 pair — a `movabs` loads a
  // symbol's address in one instruction rather than composing it from a page
  // and an offset.
  Abs64,
  // ELF local-exec thread-local addressing (§11.11). AArch64 splits a 24-bit
  // thread-pointer offset across an ADD pair; x86-64 writes a signed 32-bit
  // displacement. All three are meaningless on Mach-O, whose thread-locals
  // resolve through a TLV descriptor instead, so the Mach-O relocation mapping
  // rejects them.
  TprelHi12,
  TprelLo12,
  Tpoff32,
}

// The §11.11 storage class of the module-level variable named `sym`: 0 =
// process-wide, 1 = per-thread. Codegen carries only the symbol name, so the
// class is recovered from the module's global table. Bounded by the module's
// global count, which is small by construction (one entry per module-level
// `let`), and 0 for a symbol that names no global — no caller passes one.
fn globalStorageOf(module: IrModule, sym: string): int {
  let i = 0
  while (i < len(module.globals)) {
    if (module.globals[i].name == sym) {
      return module.globals[i].storage
    }
    i = i + 1
  }
  return 0
}

// A relocation: `offset` names the byte, within a function's code, of the field
// an object writer must patch to point at `symbol` (a Bit function's own name,
// or a runtime symbol). The width and meaning of that field is
// architecture-specific (x86-64: a 4-byte `E8 rel32`; ARM64: a `BL`'s 26-bit
// immediate) — the object writer is already relocation-type-aware per target, so
// only the offset/symbol/kind triple is common.
class Reloc {
  offset: int,
  symbol: string,
  kind: RelocKind,
}

// ===========================================================================
// GC stack-map table (runtime/ABI.md §4)
//
// The precise collector walks each Bit frame at a safepoint and needs, per
// return address, which stack slots and callee-saved registers hold a live GC
// reference — plus, to unwind past a frame, where that frame stashed the
// caller's callee-saved registers. Each backend computes this per function;
// `writeStackMaps` serializes the whole module into one blob the runtime reads
// at collection time via the `bit_stack_maps` symbol.
//
// All offsets are FRAME-POINTER-relative (rbp on x86-64, x29 on AArch64),
// normalized by each backend so the runtime walker is arch-neutral. Both arches
// chain frames identically: *(fp) is the caller's fp and *(fp+8) is the return
// address.
// ===========================================================================

// Format version stamped into every entry's header (#3189). The reader
// (runtime/gc/stackmap.bit's own copy of this same constant) refuses, by
// name, when an entry's stamped version does not match this one — instead
// of desyncing on a layout change and dereferencing garbage on the first
// collection (#1927's bus error). No import: a shared constant crosses the
// compiler/runtime seam only for a FUNCTION (SPEC §17.6/§11.9), never a
// value, so this literal and the runtime's copy must be bumped together
// whenever the entry layout below changes.
const smFormatVersion = 1

// One callee-saved register a function preserves in its prologue, and the
// frame-relative slot where it stashed the CALLER's value. Unwinding past this
// frame, the walker restores the register from *(fp + fpOff).
class SavedReg {
  reg: int,
  fpOff: int,
}

// The live-reference set at one safepoint (a call/back-edge return address).
class SafepointView {
  // Return address = the function's code address + this offset.
  retOffset: int,
  // Frame-pointer-relative offsets of stack slots holding a live reference.
  slots: []int,
  // Physical register numbers holding a live reference at this point.
  regs: []int,
}

// One function's contribution to the module stack-map table.
class FuncStackMap {
  codeSize: int,
  saved: []SavedReg,
  safepoints: []SafepointView,
}

// A growable byte buffer (the seed passes a *std.ArrayList(u8)); structs are
// reference types, so callees append in place.
class ByteBuf {
  bytes: []u8,
}

fn newByteBuf(): ByteBuf {
  return ByteBuf{ bytes: []u8(0) }
}

// Little-endian appends. The runtime reads the table with unaligned reads, so
// everything is tightly packed.
fn appendU16(out: ByteBuf, v: int) {
  out.bytes = append(out.bytes, u8(v & 255))
  out.bytes = append(out.bytes, u8((v >> 8) & 255))
}

fn appendU32(out: ByteBuf, v: int) {
  appendU16(out, v & 65535)
  appendU16(out, (v >> 16) & 65535)
}

fn appendU64(out: ByteBuf, v: int) {
  appendU32(out, v & 4294967295)
  appendU32(out, (v >> 32) & 4294967295)
}

// Overwrites the 8 bytes at `off` in `b` with `v`, little-endian. In place,
// unlike appendU64: a Mach-O relocation carries no addend field, so the addend
// must be written INTO the field bytes of an already-emitted image (#1447).
// The caller has already bounds-checked; asserted here anyway because a silent
// out-of-range write into read-only data is exactly the failure this project
// keeps paying for.
fn patchU64Le(b: []u8, off: int, v: int) {
  assert(off >= 0 && off + 8 <= len(b))
  let i = 0
  while (i < 8) {
    b[off + i] = u8((v >> (i * 8)) & 255)
    i = i + 1
  }
}

// Serializes the module stack-map table (runtime/ABI.md §4) by appending its
// blob to `out`. Returns, for each function in order, the byte offset within
// `out` of that function's 8-byte code-address field — the object writer
// relocates each to the function's own symbol so the runtime reads a real code
// address. Offsets are section-relative because `out` already holds everything
// emitted before the table.
//
// Layout (little-endian), per function and with NO leading count: `u64
// codeAddr`, `u16 formatVersion` (#3189, smFormatVersion), `u32 codeSize`,
// `u16 numSaved` x `{u16 reg, i32 fpOff}`, `u16 numSafepoints` x `{u32
// retOffset, u16 numSlots x i32, u16 numRegs x u16}`, then zero PADDING out
// to a multiple of 8 bytes (#1927). formatVersion sits AFTER codeAddr rather
// than before it so `codeAddr`'s own offset within the entry stays 0 — the
// object writers rely on that (`relocOffsets` below IS the reloc offset,
// emitmacho.bit/emitelf.bit patch the reloc straight into the entry-start
// offset), so this field needed no change there. Every field before the
// padding stays tightly packed and unaligned-read; only the padding is new
// (#1927), and it exists so every entry — hence every `__bitsm_N` atom the
// object writer carves at these offsets — starts 8-aligned. That is what lets
// the section declare 8-byte alignment truthfully: since every atom's length
// is itself a multiple of 8, the linker never needs to insert padding of its
// own to honor that alignment, regardless of which atoms dead-stripping
// drops, so there is never a linker-inserted gap for the walk to misread as
// an entry.
//
// ABI.md §4: the merged table spans every archive member that carries entries,
// so no single object can know the count and none may write one. Entries are
// self-delimiting instead, bounded by the linker-defined
// bit_stack_maps..bit_stack_maps_end extent. The reader recovers this same
// padding by rounding its cursor up to the next multiple of 8 after each
// entry — it must, or it desyncs on the first entry whose raw length isn't
// already a multiple of 8.
fn writeStackMaps(out: ByteBuf, funcs: []FuncStackMap): []int {
  let relocOffsets = []int(0)
  let fi = 0
  while (fi < len(funcs)) {
    let fsm = funcs[fi]
    let entryStart = len(out.bytes)
    relocOffsets = append(relocOffsets, entryStart)
    appendU64(out, 0) // codeAddr — filled by the reloc
    appendU16(out, smFormatVersion) // format version (#3189) — checked by
                                     // the reader before any count-driven
                                     // read; must equal runtime/gc/
                                     // stackmap.bit's smFormatVersion
    appendU32(out, fsm.codeSize)
    appendU16(out, len(fsm.saved))
    let si = 0
    while (si < len(fsm.saved)) {
      appendU16(out, fsm.saved[si].reg)
      appendU32(out, fsm.saved[si].fpOff)
      si = si + 1
    }
    appendU16(out, len(fsm.safepoints))
    let pi = 0
    while (pi < len(fsm.safepoints)) {
      let sp = fsm.safepoints[pi]
      appendU32(out, sp.retOffset)
      appendU16(out, len(sp.slots))
      let i = 0
      while (i < len(sp.slots)) {
        appendU32(out, sp.slots[i])
        i = i + 1
      }
      appendU16(out, len(sp.regs))
      i = 0
      while (i < len(sp.regs)) {
        appendU16(out, sp.regs[i])
        i = i + 1
      }
      pi = pi + 1
    }
    // Pad this entry to a multiple of 8 bytes — see the function comment.
    padTo(out, 8)
    fi = fi + 1
  }
  return relocOffsets
}

// The runtime symbol implementing an rt_call. The IR names the primitive the way
// the seed's RtFn tag does, and every runtime export is that tag prefixed with
// `bit_rt_` — except the two error-slot accessors, whose symbols read
// verb-first. A primitive that broke the convention without an entry here would
// fail loudly at link time (undefined symbol), never miscompile.
fn rtSymbol(rt: string): string {
  if (rt == "err_set") {
    return "bit_rt_set_err"
  }
  if (rt == "err_get") {
    return "bit_rt_get_err"
  }
  return "bit_rt_${rt}"
}

fn safepointSymbol(): string {
  return "bit_rt_safepoint"
}

// NO BACKEND EMITS `bit_rt_safepoint_needed` ANY MORE, and the helper that
// returned its name is gone with the last caller (#2925 arm64, #3169 x64).
// #2921/#2926 called it at every back edge to decide whether the naked shim's
// five-frame chain was needed; both backends now inline that leaf's own
// condition instead (emitInlinedPollGuard / xEmitInlinedPollGuard) against the
// offsets below. runtime/stw/stwpoll.bit still EXPORTS the symbol — it is an
// ABI name, and dropping an export is a separate decision from dropping its
// use — so an unresolved-extern check naming it is still meaningful.

// The two runtime leaves each backend calls ONCE per polling function's entry
// to fill its poll-address cache, rather than once per loop iteration. Both are
// `@nosplit` true leaves (runtime/root/root.bit) that never allocate or park,
// so neither is a safepoint.
fn worldAddrSymbol(): string {
  return "bit_rt_world_addr"
}

fn gcAddrSymbol(): string {
  return "bit_rt_gc_addr"
}

// ===========================================================================
// Live-interval construction (feeds regalloc.bit's `allocate`)
//
// Backend-agnostic by nature: liveness is a property of the IR's CFG and the
// TypeContext, never of a physical register file or an encoding. The seed keeps
// a private copy per backend (own comment blames a ticket boundary,
// not a technical one) and the two drifted apart — never grew the
// `extendParamsToPreds` guard needed. That divergence is exactly the
// design smell this file's header warns about, so with x64 as the second
// concrete user the logic lives here once, guard included.
// ===========================================================================

// Under the RPO block order every block is emitted after the blocks that can
// branch forward to it, so a target at or before the branching block can only be
// closing a loop. A back-edge gets a safepoint poll, so an allocation-free loop
// still yields to the collector (runtime/ABI.md §5).
fn isBackEdge(curBlock: int, target: int): bool {
  return target <= curBlock
}

// §10.3.1: a @naked or @nosplit function emits no back-edge safepoint. Recording
// (buildIntervals) and emission (x64.bit/arm64.bit) gate on this same predicate
// so the safepoint-position array stays in lockstep with the emitted calls.
fn needsNoSafepoints(f: IrFunc): bool {
  return f.isNaked || f.isNosplit
}

// #2925 (arm64) / #3169 (x64): true iff `f` contains a loop back-edge that
// emits a real poll — the exact condition each backend's
// emitBackEdgeSafepointIfNeeded gates on (isBackEdge and not
// needsNoSafepoints). Mirrors buildIntervals' scan below, which records the
// identical edges into built.safepoints; kept as an independent scan (rather
// than inspecting built.safepoints, which also holds plain-call safepoints —
// fib has one of those and zero back-edges) because both compile drivers need
// the answer BEFORE they lay out the frame, to size the poll-address cache.
fn hasBackEdgeSafepoint(f: IrFunc): bool {
  if (needsNoSafepoints(f)) {
    return false
  }
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival)) {
        return true
      }
      if (ins.op == Op.Br && (isBackEdge(bi, ins.ival) || isBackEdge(bi, ins.ival2))) {
        return true
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  return false
}

// ---------------------------------------------------------------------------
// The inlined poll guard's word offsets — SHARED BY BOTH BACKENDS
// ---------------------------------------------------------------------------
//
// MUST MIRROR `stwPollNeeded` (runtime/stw/stwpoll.bit) EXACTLY: same fields,
// same order, same short-circuit semantics, so each backend's inlined ladder is
// a safe (never narrower) over-approximation of the real guard — see that
// function's own header for why narrower is a silent correctness bug and wider
// is merely a wasted poll.
//
// "WIDER IS MERELY A WASTED POLL" IS TRUE PER POLL AND FALSE PER RUN, and
// #3359 is what that distinction cost. #3292 added the object trigger to
// `stwPollNeeded` and to `gcShouldCollect` but not to these two ladders, which
// left them wider by exactly the state that trigger exists to create: byte
// crossed, objects not caught up, no collection due. A wasted poll is ~190
// instructions, and `matrix` took one on every one of its 805M back edges for
// the whole run — 168.5 G instructions, 4x the benchmark's CPU. The cost of
// being wider is bounded by the number of back edges executed while the state
// holds, and nothing bounds how long it holds. Keep the ladders EXACT.
//
// These eight offsets mirror the runtime's own exported consts by NUMBER, not by
// importing them — a backend and the runtime are separate compilations
// (§17.6/§11.9: a pinned name crosses that boundary only for a FUNCTION, never
// for module state/data) — so a drift between the two is real and would
// silently read the wrong word. tests/bit/pollguardoffsets.bit pins the numbers
// against the runtime's real consts and fails loudly on drift.
//
// They live here rather than in either backend because BOTH now inline the
// guard (#2925 arm64, #3169 x64), and a number two backends mirror from one
// runtime must have exactly one copy.
fn pgWorldStopWordWord(): int { return 1536 }  // runtime/gc/gcworld.bit worldStopWord = maxMutators * muWords = 256*6
fn pgGcCfgStressWord(): int { return 10 }      // runtime/gc/gc.bit gcCfgStress
fn pgGcCfgEnabledWord(): int { return 9 }      // runtime/gc/gc.bit gcCfgEnabled
fn pgGcHeapAddrWord(): int { return 0 }        // runtime/gc/gc.bit gcHeapAddr
fn pgHeapLiveWordWord(): int { return 0 }      // runtime/alloc/alloc.bit heapLiveWord
fn pgGcNextBytesWord(): int { return 14 }      // runtime/gc/gc.bit gcNextBytes
// The object half of the trigger (#3292, added to the inlined ladders by
// #3359). WITHOUT THESE TWO THE LADDER IS WIDER THAN THE RUNTIME PREDICATE,
// which is safe and was measured ruinous: the byte trigger alone stays crossed
// for as long as the object trigger has not caught up, and #3292's object
// floor makes that window effectively permanent for a workload with few live
// objects. Every back edge in it then took `bl bit_rt_safepoint` — the naked
// shim plus four frames, ~190 instructions — and the runtime declined to
// collect every single time. `bench/cases/matrix` paid that on 805M back
// edges: 86.0 G instructions -> 254.5 G, user CPU 2.2s -> 9.0s.
fn pgGcNumObjectsIdxWord(): int { return 4 }   // runtime/gc/gc.bit gcNumObjectsIdx
fn pgGcNextObjectsWord(): int { return 37 }    // runtime/gc/gc.bit gcNextObjects

fn extendOne(intervals: []LiveInterval, usePos: int, operand: int) {
  if (intervals[operand].end < usePos) {
    intervals[operand].end = usePos
  }
}

fn extendList(intervals: []LiveInterval, usePos: int, operands: []int) {
  let i = 0
  while (i < len(operands)) {
    extendOne(intervals, usePos, operands[i])
    i = i + 1
  }
}

// Extends each operand's live interval to reach this instruction. Every op that
// READS a value must be listed — an omission ends a value's interval early and
// the allocator hands its register to someone else while it is still live.
fn extendUses(intervals: []LiveInterval, usePos: int, ins: IrInstr) {
  let op = ins.op
  if (op == Op.BlockParam || op == Op.ConstInt || op == Op.ConstFloat ||
    op == Op.ConstBool || op == Op.ConstString || op == Op.ConstNil ||
    op == Op.Unreachable || op == Op.GcAlloc || op == Op.TypeInfo ||
    op == Op.FuncAddr || op == Op.GlobalAddr || op == Op.StackMapsAddr) {
    return // no value operands
  }
  // #2934: Jump/Br's block-param ARGUMENTS are extended separately, by
  // extendForwardArgs, gated on whether the receiving param is genuinely live
  // rather than unconditionally — see computeParamTrueLive's header. Br's own
  // CONDITION is still an unconditional real read.
  if (op == Op.Jump) {
    return
  }
  if (op == Op.Ret || op == Op.Call || op == Op.RtCall || op == Op.Asm) {
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.Br) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.CallValue || op == Op.CallIface) {
    extendOne(intervals, usePos, ins.lhs) // callee / receiver
    extendList(intervals, usePos, ins.args)
    return
  }
  // §11.8: `lhs` is the syscall number, `args` its 0..6 arguments. Must be
  // listed explicitly — the fall-through at the bottom would read a `rhs` this
  // op does not have (extending vreg 0) and miss every argument.
  if (op == Op.Syscall) {
    extendOne(intervals, usePos, ins.lhs)
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.FieldGet || op == Op.SliceLen || op == Op.MakeClosure ||
    op == Op.Neg || op == Op.BNot || op == Op.Convert || op == Op.FNeg ||
    op == Op.FSqrt || op == Op.Bitcast ||
    op == Op.FFloor || op == Op.FCeil || op == Op.FTrunc || op == Op.FRound) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.FieldSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    return
  }
  if (op == Op.IndexSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    extendOne(intervals, usePos, ins.ival) // the value operand
    return
  }
  // Atomics (§11.5): `lhs`=ptr always; store/rmw also read `rhs`; cmpxchg also
  // reads `rhs` (expected) and `ival` (desired). `atomic_load` has no `rhs`, so
  // it must not fall through to the two-operand default (that would extend
  // vreg 0).
  if (op == Op.AtomicLoad) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.AtomicCmpxchg) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    extendOne(intervals, usePos, ins.ival)
    return
  }
  if (op == Op.AtomicStore || opIsAtomicRmw(op)) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    return
  }
  // Everything else is a two-operand value op (bin/index_get).
  extendOne(intervals, usePos, ins.lhs)
  extendOne(intervals, usePos, ins.rhs)
}

// All of a block's params are live simultaneously at block entry — the
// predecessor edge's parallel move writes every one before the jump. A param that
// is never read afterward would otherwise keep its initial empty [i, i] interval
// and could be coalesced onto a live sibling param's register, so the edge move
// clobbers one param with another (a returned value coming back as some other
// incoming argument). Extend every param's interval to its block's last param
// position so all params of a block mutually interfere and land in distinct
// registers.
fn forceParamInterference(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let blk = f.blocks[bi]
    if (blk.paramCount > 0) {
      let lastParam = blk.instsStart + blk.paramCount - 1
      let p = blk.instsStart
      while (p < blk.instsStart + blk.paramCount) {
        if (intervals[p].end < lastParam) {
          intervals[p].end = lastParam
        }
        p = p + 1
      }
    }
    bi = bi + 1
  }
}

fn extendBlockParams(intervals: []LiveInterval, f: IrFunc, target: int, edgePos: int) {
  let blk = f.blocks[target]
  let p = blk.instsStart
  let end = blk.instsStart + blk.paramCount
  while (p < end) {
    if (intervals[p].start > edgePos) {
      intervals[p].start = edgePos
    }
    p = p + 1
  }
}

// A block param's storage is written by each predecessor's edge move, which runs
// at the predecessor's TERMINATOR. Under RPO a forward branch targets a block
// emitted later, so that write happens well before the param's own instruction
// index. Extend every param's start back to its earliest predecessor terminator
// so the param is live across the gap and interferes with anything live there;
// otherwise a value that dies in the gap is handed the param's register or spill
// slot and the edge move clobbers it — the caller silently reads the wrong value
// (an early `return` out of a loop reading a spilled loop-carried local). A
// back-edge predecessor sits at a HIGHER position than the param, so it never
// lowers the start.
//
// Only x64 has ever been observed to need this: a safepoint-bearing function is
// restricted to 4 allocatable callee-saved GPRs and spills, while arm64's ~10
// never forced the collision. arm64 dodged the bug by register count, not by
// correctness — so the guard runs for both rather than waiting for arm64 to grow
// a spill and fail silently.
fn extendParamsToPreds(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let pblk = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so malformed
    // IR cannot index out of bounds behind our backs.
    if (pblk.instsLen > 0) {
      let termPos = pblk.instsStart + pblk.instsLen - 1
      let ins = f.instrs[termPos]
      if (ins.op == Op.Jump) {
        extendBlockParams(intervals, f, ins.ival, termPos)
      }
      if (ins.op == Op.Br) {
        extendBlockParams(intervals, f, ins.ival, termPos)
        extendBlockParams(intervals, f, ins.ival2, termPos)
      }
    }
    bi = bi + 1
  }
}

// #2934: the CFG-obliviousness fix. A chain of "if (cond) { return X }" checks
// threads every local through EVERY subsequent block's params via the Jump/Br
// argument list, regardless of whether anything downstream ever reads it
// again — opt.bit's DCE keeps every block param structurally live because
// trimming one means rewriting every predecessor's arg list too (its own
// `computeLive` unconditionally marks Op.BlockParam live for exactly that
// reason). Left alone, a value already dead after its first branch keeps a
// register reserved — and gets re-copied at every later block's edge move —
// all the way to the function's last block, which is what inflated
// bit_rt_safepoint_needed to 14 distinct GPRs for a true 2-value peak.
//
// This computes, for every instruction slot, whether it is "genuinely" live:
// read directly by something other than a block-forwarding argument, or
// forwarded to a param that is (recursively) genuinely live. Two stages:
//
// Stage 1 finds every direct (non-forwarding) use exactly the way extendUses
// already does — reusing it unmodified on a throwaway interval array, since
// extendUses' own Op.Jump/Op.Br handling no longer touches forwarded args.
//
// Stage 2 walks blocks in DESCENDING order propagating liveness backward
// across FORWARD edges only: a forward branch always targets a LATER block
// (isBackEdge), so by the time this walk reaches a block's own terminator,
// every block it can jump forward to has already been fully processed —
// including THAT block's own Stage 2 contribution — so its params' liveness
// is completely final. A BACK edge's target has not been visited yet in a
// single descending pass, so those arguments stay conservatively live,
// unchanged from today: under-approximating deadness there would shrink a
// genuinely live loop-carried value's interval and hand its register away
// early, which is a miscompile, not a missed optimization.
fn computeParamTrueLive(f: IrFunc): []bool {
  let n = len(f.instrs)
  let temp = []LiveInterval(0)
  let i = 0
  while (i < n) {
    temp = append(temp, LiveInterval{ vreg: i, regClass: RegClass.Int, start: i, end: i, isRef: false })
    i = i + 1
  }
  i = 0
  while (i < n) {
    extendUses(temp, i, f.instrs[i])
    i = i + 1
  }
  let live = []bool(0)
  i = 0
  while (i < n) {
    live = append(live, temp[i].end > temp[i].start)
    i = i + 1
  }

  let bi = len(f.blocks)
  while (bi > 0) {
    bi = bi - 1
    let b = f.blocks[bi]
    if (b.instsLen > 0) {
      let termPos = b.instsStart + b.instsLen - 1
      let ins = f.instrs[termPos]
      if (ins.op == Op.Jump) {
        markForwardLiveArgs(f, live, bi, ins.ival, ins.args)
      }
      if (ins.op == Op.Br) {
        markForwardLiveArgs(f, live, bi, ins.ival, ins.thenArgs)
        markForwardLiveArgs(f, live, bi, ins.ival2, ins.elseArgs)
      }
    }
  }
  return live
}

// Shared by computeParamTrueLive's own backward propagation and
// extendForwardArgs' interval extension: argument `k` of a jump from
// `curBlock` to `target` is worth treating as a genuine use iff the edge is a
// back edge (always conservative, same as extendUses used to be
// unconditionally) or the receiving param (`target`'s k-th) is itself live.
fn argFeedsLiveTarget(f: IrFunc, live: []bool, curBlock: int, target: int, k: int): bool {
  return isBackEdge(curBlock, target) || live[f.blocks[target].instsStart + k]
}

fn markForwardLiveArgs(f: IrFunc, live: []bool, curBlock: int, target: int, args: []int) {
  let k = 0
  while (k < len(args)) {
    if (argFeedsLiveTarget(f, live, curBlock, target, k)) {
      live[args[k]] = true
    }
    k = k + 1
  }
}

// buildIntervals' replacement for extendUses' old unconditional Jump/Br
// argument handling: only extends a forwarded value's interval when
// argFeedsLiveTarget says the edge is worth it (#2934).
fn extendForwardArgs(intervals: []LiveInterval, f: IrFunc, live: []bool, usePos: int, curBlock: int, target: int, args: []int) {
  let k = 0
  while (k < len(args)) {
    if (argFeedsLiveTarget(f, live, curBlock, target, k)) {
      extendOne(intervals, usePos, args[k])
    }
    k = k + 1
  }
}

fn isSafepointOp(op: Op): bool {
  return op == Op.Call || op == Op.RtCall || op == Op.GcAlloc ||
    op == Op.MakeClosure || op == Op.CallValue || op == Op.CallIface
}

// buildIntervals produces two things at once; a slice appended to inside a callee
// does not grow the caller's, so both come back in one class.
class IntervalBuild {
  intervals: []LiveInterval,
  safepoints: []int,
}

// One LiveInterval per instruction slot (dense 0..len(instrs), matching
// regalloc.bit's dense-vreg contract). Non-value instructions (terminators,
// field_set/index_set) get a trivial, never-referenced [i,i] interval; harmless
// filler, never looked up. Also collects safepoint positions in the exact order
// they will be re-encountered during emission (calls first-seen, then back-edge
// terminators) so a backend can match each stack map back to its call by cursor
// position — arm64 consumes this; x64 records its safepoints during emission and
// reads only `intervals`.
fn buildIntervals(ctx: TypeContext, f: IrFunc): IntervalBuild {
  let safepoints = []int(0)
  let intervals = []LiveInterval(0)
  let i = 0
  while (i < len(f.instrs)) {
    let w = widthOf(ctx, f.instrs[i].ty)
    intervals = append(intervals, LiveInterval{ vreg: i, regClass: w.regClass, start: i, end: i,
      isRef: w.regClass == RegClass.Int && isRefType(ctx, f.instrs[i].ty) })
    i = i + 1
  }

  let paramLive = computeParamTrueLive(f)

  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      if (isSafepointOp(ins.op)) {
        safepoints = append(safepoints, idx)
      }
      extendUses(intervals, idx, ins)
      if (ins.op == Op.Jump) {
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival, ins.args)
      }
      if (ins.op == Op.Br) {
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival, ins.thenArgs)
        extendForwardArgs(intervals, f, paramLive, idx, bi, ins.ival2, ins.elseArgs)
      }
      // Back-edge safepoints are suppressed for @naked/@nosplit — gate recording
      // on the same predicate as emission so positions stay in lockstep (§10.3.1).
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival) && !needsNoSafepoints(f)) {
        safepoints = append(safepoints, idx)
      }
      if (ins.op == Op.Br && !needsNoSafepoints(f)) {
        if (isBackEdge(bi, ins.ival)) {
          safepoints = append(safepoints, idx)
        }
        if (isBackEdge(bi, ins.ival2)) {
          safepoints = append(safepoints, idx)
        }
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  extendParamsToPreds(intervals, f)
  forceParamInterference(intervals, f)
  return IntervalBuild{ intervals: intervals, safepoints: safepoints }
}
