// Self-host Stage 3 (#1340): backend-agnostic codegen core. Kept deliberately
// tiny — only logic with zero
// dependency on a physical register file or instruction encoding belongs here;
// everything else (register lists, calling-convention argument mapping, the
// instruction encoder, frame layout) is inherently per-ISA and stays in its own
// backend file. Divergence between backends in code that COULD live here is a
// design smell; extract more here only once a second concrete user demonstrates
// the logic is truly identical, not merely similar.

// One physical register file's class (the seed's regalloc.Class).
enum RegClass {
  Int,
  Float,
}

// A scalar's storage width and class. Mirrors lower.bit's object-layout scheme:
// every scalar prim is stored at its natural width; every other shape is one
// boxed 8-byte handle.
class Width {
  bytes: int,
  regClass: RegClass,
  signed: bool,
}

fn mkWidth(bytes: int, regClass: RegClass, signed: bool): Width {
  return Width{ bytes: bytes, regClass: regClass, signed: signed }
}

// Depends only on the TypeContext, never on a physical register — identical for
// every backend. Prim indices: 0=i8 1=i16 2=i32 3=i64 4=u8 5=u16 6=u32 7=u64
// 8=f32 9=f64 10=bool 11=string.
fn widthOf(ctx: TypeContext, ty: int): Width {
  if (ctx.types[ty].kind != TypeKind.Prim) {
    return mkWidth(8, RegClass.Int, false) // uniform boxed handle
  }
  let p = ctx.types[ty].prim
  if (p == 0) {
    return mkWidth(1, RegClass.Int, true)
  }
  if (p == 4) {
    return mkWidth(1, RegClass.Int, false)
  }
  if (p == 1) {
    return mkWidth(2, RegClass.Int, true)
  }
  if (p == 5) {
    return mkWidth(2, RegClass.Int, false)
  }
  if (p == 2) {
    return mkWidth(4, RegClass.Int, true)
  }
  if (p == 6) {
    return mkWidth(4, RegClass.Int, false)
  }
  if (p == 3) {
    return mkWidth(8, RegClass.Int, true)
  }
  if (p == 7) {
    return mkWidth(8, RegClass.Int, false)
  }
  if (p == 8) {
    return mkWidth(4, RegClass.Float, false)
  }
  if (p == 9) {
    return mkWidth(8, RegClass.Float, false)
  }
  if (p == 10) {
    return mkWidth(1, RegClass.Int, false)
  }
  return mkWidth(8, RegClass.Int, false) // string
}

fn regClassOf(ctx: TypeContext, ty: int): RegClass {
  return widthOf(ctx, ty).regClass
}

// Whether `field_get %v[k]` on a base of type `ty` is reading a SLICE OR STRING
// HEADER, which both backends must load NULL-SAFELY (#1564): a zeroed class's
// slice or string field holds the null word rather than an empty header, and
// neither `xs == nil` nor `s == nil` is spellable (E0053), so the fault is the
// only observable difference between null and empty. `emitHeaderWordOrZero`
// (arm64selectmem.bit) and its x86-64 twin read such a header as 0.
//
// STRING JOINED SLICE HERE with #4048's inline `s[lo:hi]`, which reads the
// header's `ptr` word at +0 the way the inline `xs[i]` already reads `buf` at
// +0 and `off` at +16. The runtime entry point it replaces funnelled that read
// through `strBytes` (runtime/root/root.bit), whose whole reason for existing
// is this same null case — so the guard is not new behaviour, it is the same
// guard moved to the site that now performs the load. No OTHER `field_get` in
// the tree has a string-typed base today (every emission site in `lower*.bit`
// bases on a class, a tuple, an enum payload, a slice header or an already
// computed `i64` address), so this widens a predicate that nothing else reaches.
//
// One predicate, read by both dispatchers, for the reason the slice bounds test
// is one function: a null guard present on one backend and absent on the other
// is a fault on whichever loses it, and nothing downstream would notice.
fn isHeaderBase(ctx: TypeContext, ty: int): bool {
  let k = ctx.types[ty].kind
  return k == TypeKind.Slice || (k == TypeKind.Prim && ctx.types[ty].prim == 11)
}

// Whether a value of type `ty` is a GC reference (lower.bit's fieldLayout
// `isPtr`, re-derived here for codegen's own use).
fn isRefType(ctx: TypeContext, ty: int): bool {
  let k = ctx.types[ty].kind
  if (k == TypeKind.Prim) {
    return ctx.types[ty].prim == 11 // string
  }
  // A raw pointer `*T` (§11.4) is a word the GC must never follow.
  if (k == TypeKind.Void ||
    k == TypeKind.UntypedInt ||
    k == TypeKind.UntypedFloat ||
    k == TypeKind.UntypedRune ||
    k == TypeKind.UntypedBool ||
    k == TypeKind.UntypedString ||
    k == TypeKind.UntypedNil ||
    k == TypeKind.Invalid ||
    k == TypeKind.TypeParam ||
    k == TypeKind.Fallible ||
    k == TypeKind.Ptr) {
    return false
  }
  if (k == TypeKind.Enum) {
    // A bare tag word, or a boxed {tag, payloadPtr} if it has payloads.
    return ctx.types[ty].enumBoxed
  }
  return true // slice/array/map/tuple/chan/class/interface/func
}

// What an object writer must patch into the field a Reloc names. x86-64 only
// ever emits Branch (its `movabs` needs no relocation to name an address);
// ARM64 has no wide-immediate address-of, so it names a static symbol with an
// ADRP/ADD pair — Page21 patches the ADRP's page number, PageOff12 the ADD's
// in-page offset.
enum RelocKind {
  // A PC-relative call/branch immediate: AArch64's BL (26-bit), x86-64's
  // `E8 rel32` (4 bytes). Both name a target symbol the linker resolves.
  Branch,
  // AArch64 address materialization: adrp's 21-bit page number, then the
  // add/ldr's 12-bit page offset.
  Page21,
  PageOff12,
  // A full 64-bit absolute address, written into an 8-byte field. x86-64 needs
  // this where AArch64 uses the Page21/PageOff12 pair — a `movabs` loads a
  // symbol's address in one instruction rather than composing it from a page
  // and an offset.
  Abs64,
  // ELF local-exec thread-local addressing (§11.11). AArch64 splits a 24-bit
  // thread-pointer offset across an ADD pair; x86-64 writes a signed 32-bit
  // displacement. All three are meaningless on Mach-O, whose thread-locals
  // resolve through a TLV descriptor instead, so the Mach-O relocation mapping
  // rejects them.
  TprelHi12,
  TprelLo12,
  Tpoff32,
}

// The §11.11 storage class of the module-level variable named `sym`: 0 =
// process-wide, 1 = per-thread. Codegen carries only the symbol name, so the
// class is recovered from the module's global table. Bounded by the module's
// global count, which is small by construction (one entry per module-level
// `let`), and 0 for a symbol that names no global — no caller passes one.
fn globalStorageOf(module: IrModule, sym: string): int {
  let i = 0
  while (i < len(module.globals)) {
    if (module.globals[i].name == sym) {
      return module.globals[i].storage
    }
    i = i + 1
  }
  return 0
}

// A relocation: `offset` names the byte, within a function's code, of the field
// an object writer must patch to point at `symbol` (a Bit function's own name,
// or a runtime symbol). The width and meaning of that field is
// architecture-specific (x86-64: a 4-byte `E8 rel32`; ARM64: a `BL`'s 26-bit
// immediate) — the object writer is already relocation-type-aware per target, so
// only the offset/symbol/kind triple is common.
class Reloc {
  offset: int,
  symbol: string,
  kind: RelocKind,
}

// ===========================================================================
// GC stack-map table (runtime/ABI.md §4)
//
// The precise collector walks each Bit frame at a safepoint and needs, per
// return address, which stack slots and callee-saved registers hold a live GC
// reference — plus, to unwind past a frame, where that frame stashed the
// caller's callee-saved registers. Each backend computes this per function;
// `writeStackMaps` serializes the whole module into one blob the runtime reads
// at collection time via the `bit_stack_maps` symbol.
//
// All offsets are FRAME-POINTER-relative (rbp on x86-64, x29 on AArch64),
// normalized by each backend so the runtime walker is arch-neutral. Both arches
// chain frames identically: *(fp) is the caller's fp and *(fp+8) is the return
// address.
// ===========================================================================

// Format version stamped into every entry's header (#3189). The reader
// (runtime/gc/stackmap.bit's own copy of this same constant) refuses, by
// name, when an entry's stamped version does not match this one — instead
// of desyncing on a layout change and dereferencing garbage on the first
// collection (#1927's bus error). No import: a shared constant crosses the
// compiler/runtime seam only for a FUNCTION (SPEC §17.6/§11.9), never a
// value, so this literal and the runtime's copy must be bumped together
// whenever the entry layout below changes.
const smFormatVersion = 1

// One callee-saved register a function preserves in its prologue, and the
// frame-relative slot where it stashed the CALLER's value. Unwinding past this
// frame, the walker restores the register from *(fp + fpOff).
class SavedReg {
  reg: int,
  fpOff: int,
}

// The live-reference set at one safepoint (a call/back-edge return address).
class SafepointView {
  // Return address = the function's code address + this offset.
  retOffset: int,
  // Frame-pointer-relative offsets of stack slots holding a live reference.
  slots: []int,
  // Physical register numbers holding a live reference at this point.
  regs: []int,
}

// One function's contribution to the module stack-map table.
class FuncStackMap {
  codeSize: int,
  saved: []SavedReg,
  safepoints: []SafepointView,
}

// A growable byte buffer (the seed passes a *std.ArrayList(u8)); structs are
// reference types, so callees append in place.
class ByteBuf {
  bytes: []u8,
}

fn newByteBuf(): ByteBuf {
  return ByteBuf{ bytes: []u8(0) }
}

// Little-endian appends. The runtime reads the table with unaligned reads, so
// everything is tightly packed.
fn appendU16(out: ByteBuf, v: int) {
  out.bytes = append(out.bytes, u8(v & 255))
  out.bytes = append(out.bytes, u8((v >> 8) & 255))
}

fn appendU32(out: ByteBuf, v: int) {
  appendU16(out, v & 65535)
  appendU16(out, (v >> 16) & 65535)
}

fn appendU64(out: ByteBuf, v: int) {
  appendU32(out, v & 4294967295)
  appendU32(out, (v >> 32) & 4294967295)
}

// Overwrites the 8 bytes at `off` in `b` with `v`, little-endian. In place,
// unlike appendU64: a Mach-O relocation carries no addend field, so the addend
// must be written INTO the field bytes of an already-emitted image (#1447).
// The caller has already bounds-checked; asserted here anyway because a silent
// out-of-range write into read-only data is exactly the failure this project
// keeps paying for.
fn patchU64Le(b: []u8, off: int, v: int) {
  assert(off >= 0 && off + 8 <= len(b))
  let i = 0
  while (i < 8) {
    b[off + i] = u8((v >> (i * 8)) & 255)
    i = i + 1
  }
}

// Serializes the module stack-map table (runtime/ABI.md §4) by appending its
// blob to `out`. Returns, for each function in order, the byte offset within
// `out` of that function's 8-byte code-address field — the object writer
// relocates each to the function's own symbol so the runtime reads a real code
// address. Offsets are section-relative because `out` already holds everything
// emitted before the table.
//
// Layout (little-endian), per function and with NO leading count: `u64
// codeAddr`, `u16 formatVersion` (#3189, smFormatVersion), `u32 codeSize`,
// `u16 numSaved` x `{u16 reg, i32 fpOff}`, `u16 numSafepoints` x `{u32
// retOffset, u16 numSlots x i32, u16 numRegs x u16}`, then zero PADDING out
// to a multiple of 8 bytes (#1927). formatVersion sits AFTER codeAddr rather
// than before it so `codeAddr`'s own offset within the entry stays 0 — the
// object writers rely on that (`relocOffsets` below IS the reloc offset,
// emitmacho.bit/emitelf.bit patch the reloc straight into the entry-start
// offset), so this field needed no change there. Every field before the
// padding stays tightly packed and unaligned-read; only the padding is new
// (#1927), and it exists so every entry — hence every `__bitsm_N` atom the
// object writer carves at these offsets — starts 8-aligned. That is what lets
// the section declare 8-byte alignment truthfully: since every atom's length
// is itself a multiple of 8, the linker never needs to insert padding of its
// own to honor that alignment, regardless of which atoms dead-stripping
// drops, so there is never a linker-inserted gap for the walk to misread as
// an entry.
//
// ABI.md §4: the merged table spans every archive member that carries entries,
// so no single object can know the count and none may write one. Entries are
// self-delimiting instead, bounded by the linker-defined
// bit_stack_maps..bit_stack_maps_end extent. The reader recovers this same
// padding by rounding its cursor up to the next multiple of 8 after each
// entry — it must, or it desyncs on the first entry whose raw length isn't
// already a multiple of 8.
fn writeStackMaps(out: ByteBuf, funcs: []FuncStackMap): []int {
  let relocOffsets = []int(0)
  let fi = 0
  while (fi < len(funcs)) {
    let fsm = funcs[fi]
    let entryStart = len(out.bytes)
    relocOffsets = append(relocOffsets, entryStart)
    appendU64(out, 0)               // codeAddr — filled by the reloc
    appendU16(out, smFormatVersion) // format version (#3189) — checked by
    // the reader before any count-driven
    // read; must equal runtime/gc/
    // stackmap.bit's smFormatVersion
    appendU32(out, fsm.codeSize)
    appendU16(out, len(fsm.saved))
    let si = 0
    while (si < len(fsm.saved)) {
      appendU16(out, fsm.saved[si].reg)
      appendU32(out, fsm.saved[si].fpOff)
      si = si + 1
    }
    appendU16(out, len(fsm.safepoints))
    let pi = 0
    while (pi < len(fsm.safepoints)) {
      let sp = fsm.safepoints[pi]
      appendU32(out, sp.retOffset)
      appendU16(out, len(sp.slots))
      let i = 0
      while (i < len(sp.slots)) {
        appendU32(out, sp.slots[i])
        i = i + 1
      }
      appendU16(out, len(sp.regs))
      i = 0
      while (i < len(sp.regs)) {
        appendU16(out, sp.regs[i])
        i = i + 1
      }
      pi = pi + 1
    }
    // Pad this entry to a multiple of 8 bytes — see the function comment.
    padTo(out, 8)
    fi = fi + 1
  }
  return relocOffsets
}

// ===========================================================================
// Debug-info line table (runtime/ABI.md §4.2, #3281/#3283)
//
// A second, independent side table laid out like the stack-map table above
// (same per-member/linker-merged shape), mapping a return address back to a
// source file:line for a runtime panic-time stack walk (#3285). Each
// function's rows are built as its code is emitted, by comparing every
// instruction's #3282 span against the last recorded row — see
// appendDebugLineIfChanged below, called from arm64compile.bit's and
// x64dispatch.bit's own per-instruction emission loops.
// ===========================================================================

// Format version stamped into every entry's header (mirrors smFormatVersion
// above; ABI.md §4.2 chose the identical position and reasoning — a
// producer/reader build-stage skew is the identical exposure #1927/#3189
// already paid for once).
//
// Bumped 1 -> 2 by #3662: the header grew an 8-byte name_hdr_ptr field (a
// function's own display name, interned once per object exactly like a row's
// file_hdr_ptr), so a reader built against version 1's 16-byte header must not
// misread version 2's 24-byte one — see writeDebugLines below.
const dbgFormatVersion = 2

// One row of a function's debug-info line table: `pcOffset` is this row's
// start offset within the function's own code, spanning to the next row's
// pcOffset (or to the entry's codeSize for the last row). `file` is a
// SourceManager FileId (resolved to a string-pool header by the object
// writer, which is the only place that also holds the SourceManager); `line`
// is already 1-based, resolved once when the row was created rather than
// carried as a byte offset for a reader to re-resolve.
class DebugLineRow {
  pcOffset: int,
  file: int,
  line: int,
}

// One function's contribution to the module debug-info table. `rows` is
// empty for a function with no source-mapped instruction at all (fully
// synthetic) — writeDebugLines below skips such a function entirely rather
// than emit a dishonest all-zero entry; the walker's linear scan then simply
// never finds that function's range and prints a raw address, exactly the
// "no record" contract ABI.md §4.2 already specifies for an unmapped pc.
class FuncDebugLines {
  codeSize: int,
  rows: []DebugLineRow,
}

// Resolves `span` to the (file, 1-based line) a debug-info row records, or
// `hasRow: false` for `unknownSpan()` (compiler/ir.bit) — a synthesized
// instruction with no honest single source point contributes no row of its
// own; the caller inherits whichever row most recently applied, which is an
// honest "closest known" answer rather than a confidently wrong one.
class DebugPos {
  hasRow: bool,
  file: int,
  line: int,
}

fn debugPosOf(sm: SourceManager, span: Span): DebugPos {
  if (span.file < 0) {
    return DebugPos{ hasRow: false, file: -1, line: 0 }
  }
  return DebugPos{
    hasRow: true, file: span.file,
    line: locate(sm, span.file, span.start).line + 1,
  } // 0-based -> 1-based
}

// Appends a new row to `rows` when `pos` names a different (file, line) than
// the last one — ABI.md §4.2's row-per-source-position compaction, which is
// also what keeps rows sorted: the caller invokes this in final code-emission
// order (see the note on ABI.md §4.2 about x86-64 RPO block reordering), so
// rows come out already ascending by construction. A `!pos.hasRow` position
// never starts a new row (see DebugPos above).
fn appendDebugLineIfChanged(rows: []DebugLineRow, pos: DebugPos, codeOffset: int): []DebugLineRow {
  if (!pos.hasRow) {
    return rows
  }
  if (len(rows) > 0 &&
    rows[len(rows) - 1].file == pos.file &&
    rows[len(rows) - 1].line == pos.line) {
    return rows
  }
  rows = append(rows, DebugLineRow{ pcOffset: codeOffset, file: pos.file, line: pos.line })
  return rows
}

// Returned by writeDebugLines: for each entry actually written (a function
// with zero rows contributes none — see FuncDebugLines), the byte offset
// within `out` of that entry's 8-byte code_addr field, and which index into
// the caller's `funcs` (hence its own `emittedNames`) it came from. The two
// lists stay aligned to each other by construction, but a caller must look up
// the owning function through `funcIndices`, not by position, since a
// zero-row function leaves a gap `relocOffsets` never has an entry for.
class DbgWriteResult {
  relocOffsets: []int,
  funcIndices: []int,
}

// Serializes the module debug-info table (ABI.md §4.2) by appending its blob
// to `out`, mirroring writeStackMaps' shape and NO-leading-count rationale.
//
// Layout per function, little-endian: `u64 codeAddr` (reloc, filled by the
// object writer), `u16 formatVersion` (dbgFormatVersion, checked by the
// reader before code_size/num_rows are trusted — same position choice as
// smFormatVersion, right after codeAddr, for the same reason), `u32
// codeSize`, `u16 numRows`, `u64 nameHdrPtr` (reloc, filled by the object
// writer against the interned string-pool header for this FUNCTION's own
// display name — #3662, one per entry, unlike a row's fileHdrPtr below which
// is one per row), then numRows x { `u32 pcOffset`, `u64 fileHdrPtr` (reloc,
// filled by the object writer against the interned string-pool header for
// that row's file), `u32 line` }. The 24-byte header and each 16-byte row are
// already multiples of 8 (ABI.md §4.2), so unlike writeStackMaps this format
// needs no padding step at all.
fn writeDebugLines(out: ByteBuf, funcs: []FuncDebugLines): DbgWriteResult {
  let relocOffsets = []int(0)
  let funcIndices = []int(0)
  let fi = 0
  while (fi < len(funcs)) {
    let fd = funcs[fi]
    if (len(fd.rows) > 0) {
      let entryStart = len(out.bytes)
      relocOffsets = append(relocOffsets, entryStart)
      funcIndices = append(funcIndices, fi)
      appendU64(out, 0) // codeAddr — filled by the reloc
      appendU16(out, dbgFormatVersion)
      appendU32(out, fd.codeSize)
      appendU16(out, len(fd.rows))
      appendU64(out, 0) // nameHdrPtr — filled by the caller's reloc
      let ri = 0
      while (ri < len(fd.rows)) {
        appendU32(out, fd.rows[ri].pcOffset)
        appendU64(out, 0) // fileHdrPtr — filled by the caller's reloc
        appendU32(out, fd.rows[ri].line)
        ri = ri + 1
      }
    }
    fi = fi + 1
  }
  return DbgWriteResult{ relocOffsets: relocOffsets, funcIndices: funcIndices }
}

// The runtime symbol implementing an rt_call. The IR names the primitive the way
// the seed's RtFn tag does, and every runtime export is that tag prefixed with
// `bit_rt_` — except the two error-slot accessors, whose symbols read
// verb-first. A primitive that broke the convention without an entry here would
// fail loudly at link time (undefined symbol), never miscompile.
fn rtSymbol(rt: string): string {
  if (rt == "err_set") {
    return "bit_rt_set_err"
  }
  if (rt == "err_get") {
    return "bit_rt_get_err"
  }
  return "bit_rt_${rt}"
}

fn safepointSymbol(): string {
  return "bit_rt_safepoint"
}

// NO BACKEND EMITS `bit_rt_safepoint_needed` ANY MORE, and the helper that
// returned its name is gone with the last caller (#2925 arm64, #3169 x64).
// #2921/#2926 called it at every back edge to decide whether the naked shim's
// five-frame chain was needed; both backends inlined that leaf's own condition
// instead, and #4203 replaced the inlined condition with the single word below.
// runtime/stw/stwpoll.bit still EXPORTS the symbol — it is an ABI name, and
// dropping an export is a separate decision from dropping its use — so an
// unresolved-extern check naming it is still meaningful.

// #4203: THE NINE MIRRORED WORD OFFSETS ARE GONE, AND THAT IS THE POINT.
//
// This file used to carry nine word offsets — worldStopWord, gcCfgStress,
// gcCfgEnabled, gcHeapAddr, heapLiveWord, gcNextBytes, gcNumObjectsIdx,
// gcNextObjects, wkId — mirrored BY NUMBER from the runtime, because both
// backends open-coded `stwPollNeeded`'s whole predicate at every back edge and
// a backend and the runtime are separate compilations (§17.6/§11.9: a pinned
// name crosses that boundary only for a FUNCTION, never for module state).
//
// That mirror was the most drift-prone thing in this file and the drift was not
// hypothetical: #3292 added the object trigger to the runtime predicate and not
// to the two ladders, leaving them wider by exactly the state that trigger
// exists to create, and `bench/cases/matrix` then took a ~190-instruction
// wasted poll on every one of its 805M back edges — 86.0 G instructions to
// 254.5 G, user CPU 2.2s to 9.0s — until #3359 re-synchronised them.
//
// A backend now emits no field offset at all: it fetches the ONE address below
// and reads the word at offset 0. The predicate lives in exactly one place, in
// Bit, in the runtime, so there is nothing left to mirror and nothing left to
// drift.

// #4203: the address of runtime/sched/pollreq.bit's `pollAttention` word — "has
// anything asked for a safepoint". Both backends fetch it once per polling
// function's ENTRY into that function's frame, then read the word itself on
// every back edge (emitPollGuard / xEmitPollGuard).
//
// A true leaf returning a per-process constant, which is what makes caching it
// at function entry sound — the same terms `bit_rt_world_addr`,
// `bit_rt_gc_addr` and `bit_rt_port_sched_preempt_any_addr` were fetched on
// until this ticket replaced all three with this one.
//
// The word's SENSE, and the whole of what a backend needs to know: 0 means
// nobody is asking and the back edge falls through; anything else means call
// `bit_rt_safepoint` and let the runtime decide why. runtime/sched/pollreq.bit
// holds the invariant and the publish/consume ordering proof.
fn pollAttentionAddrSymbol(): string {
  return "bit_rt_port_sched_poll_attention_addr"
}

// ---------------------------------------------------------------------------
// The per-OS-thread identity token — INLINED BY BOTH BACKENDS (#3434)
// ---------------------------------------------------------------------------
//
// `bit_rt_port_gc_thread_token` reads the thread pointer: one `mrs` probe on
// AArch64, one segment-relative `mov` on x86-64. It is the first thing
// `mutatorSlot` does (runtime/gc/gcworldsync.bit), which since #4060 sits on
// every taken safepoint poll and on the OS-thread entry doors — no longer on
// the allocation door, which registered once per OBJECT until that ticket
// moved the claim to `bit_rt_gc_thread_enter`.
//
// #3420 moved its body out of runtime/gc/gcthread.bit into the paired
// runtime/gc/{linux,darwin,windows}/gcthread.bit, because Windows must read
// `gs:[0x30]` where Linux reads `fs:0` and §11.6 asm has no OS axis. That was
// necessary and is not the bug. The cost is: `scripts/g2archive.sh` compiles
// each module directory as its OWN `bit build --emit-obj --freestanding`, so
// the body is not merely at a different index in runtime/gc's IrModule, it is
// in a DIFFERENT COMPILATION UNIT that runtime/gc does not even import.
// `funcIndexByName` returns -1 and `inlineEligible` refuses on `calleeIdx < 0`
// — nothing the inliner can be taught reaches it, and this is NOT the
// filename-order defect #3163 fixed. Measured: 0 call relocations to this
// symbol in runtime/gc's object before #3420, 5 after, on all four targets.
//
// So the backends emit the body themselves, exactly as they already emit
// `stwPollNeeded`'s condition rather than calling it (#2925 arm64, #3169 x64).
// The name lives here, with the other runtime symbols both backends know,
// because a name two backends mirror from one runtime must have exactly one
// copy — the same rule the inlined poll guard's offsets follow above. The
// PAYLOADS stay in each backend (emitInlinedThreadToken /
// xEmitInlinedThreadToken): they are instruction encodings, which this file's
// header excludes by construction. _tests_/bit/threadtokenbytes.bit pins both
// against the runtime source they mirror, so they cannot drift the way the
// poll-guard ladders did in #3359.
fn gcThreadTokenSymbol(): string {
  return "bit_rt_port_gc_thread_token"
}

// Under the RPO block order every block is emitted after the blocks that can
// branch forward to it, so a target at or before the branching block can only be
// closing a loop. A back-edge gets a safepoint poll, so an allocation-free loop
// still yields to the collector (runtime/ABI.md §5).
fn isBackEdge(curBlock: int, target: int): bool {
  return target <= curBlock
}

// §10.3.1: a @naked or @nosplit function emits no back-edge safepoint. Recording
// (buildIntervals) and emission (x64.bit/arm64.bit) gate on this same predicate
// so the safepoint-position array stays in lockstep with the emitted calls.
fn needsNoSafepoints(f: IrFunc): bool {
  return f.isNaked || f.isNosplit
}

// #2925 (arm64) / #3169 (x64): true iff `f` contains a loop back-edge that
// emits a real poll — the exact condition each backend's
// emitBackEdgeSafepointIfNeeded gates on (isBackEdge and not
// needsNoSafepoints). Mirrors buildIntervals' scan below, which records the
// identical edges into built.safepoints; kept as an independent scan (rather
// than inspecting built.safepoints, which also holds plain-call safepoints —
// fib has one of those and zero back-edges) because both compile drivers need
// the answer BEFORE they lay out the frame, to size the poll-address cache.
fn hasBackEdgeSafepoint(f: IrFunc): bool {
  if (needsNoSafepoints(f)) {
    return false
  }
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival)) {
        return true
      }
      if (ins.op == Op.Br && (isBackEdge(bi, ins.ival) || isBackEdge(bi, ins.ival2))) {
        return true
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  return false
}
