// compiler/relationautoreturn.bit — #6373 (epic #6298): the rows a function
// returns when its `return`s name different sources.
//
// `fn pick(db: Db, raw: bool): Post!` that returns a raw-SQL row in one branch
// and a query row in another has no ONE source for a caller to add
// `.with("author")` to: the old answer ("not found", relationAutoMergeReturn,
// relationauto.bit) left every read of its result untraceable, so following the
// hint at either `return` still failed the build. The function's return is now
// a holder (relationautoholder.bit) `holder:X:<module>:<decl>` with ONE WRITER
// PER `return`: a read of the result is proven iff every `return` loads what
// the read needs, and the failing proof names the `return` that does not
// (`RelationAutoBlame.site`). The fix the hint names — loading the relation at
// that `return`'s query — is the whole fix.
//
// The summary (`relationAutoMixedReturn`, from the fixed point in
// relationautocalls.bit) only says the return IS the holder; the writers are
// collected by pass one of relationautoerr.bit (`relationAutoHolderNoteReturn`),
// like every other store into a holder.

const relationAutoReturnPrefix = "holder:X:"

fn relationAutoReturnHolderKey(moduleId: int, fd: int): string {
  return "${relationAutoReturnPrefix}${moduleId}:${fd}"
}

// The return summary of function `fd` whose `return`s disagree. `cand` is a
// found flow of the function's own result (class and slice-ness are the
// function's declared result type, so any `return`'s flow names them).
fn relationAutoMixedReturn(c: Checker, cand: RelationAutoFlow, fd: int): RelationAutoReturnSummary {
  return RelationAutoReturnSummary{
    found = true, queryCall = 0, viaParamName = relationAutoReturnHolderKey(c.moduleId, fd),
    cls = cand.cls, isSlice = cand.isSlice, ownerModule = c.moduleId, path = "",
  }
}

// `return v` inside a function whose return is the holder above: `v` is a
// writer of it. Any other `return` (bare, grouped) is an untraceable value and
// poisons it. A `return` inside a function whose returns agree records nothing.
fn relationAutoHolderNoteReturn(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  if (ctx.fd == 0) {
    return
  }
  let (idx, ok) = ctx.st.summaries.declToIndex["${c.moduleId}:${ctx.fd}"]
  let key = relationAutoReturnHolderKey(c.moduleId, ctx.fd)
  if (!ok || ctx.st.summaries.list[idx].ret.viaParamName != key) {
    return
  }
  let tgt = relationAutoStoreAtRoot(c, key, node)
  let kids = kidsOf(c.tree, node)
  if (len(kids) != 1) {
    relationAutoHolderNoteBad(ctx, tgt)
    return
  }
  relationAutoHolderNoteValue(c, tgt, kids[0], ctx)
}
