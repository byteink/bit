// compiler/lowerstackmapsaddr.bit — split out of lowerprim.bit (#5598) to
// bring lowerprim.bit under the repo's 800-line limit (E0200), and to give
// the split some margin below the ceiling rather than landing on it. Sibling
// of lowerprim.bit: same module, so this needs no imports and no call-site
// changes.
//
// One function: the stack-maps/debug-lines table-extent builtins'
// address-relocation lowering. No comment outside this module cites it by
// name, so moving it cannot break a `test-fmt-citations` citation in a file
// this split does not otherwise touch.

// `stackMapsBegin()`/`stackMapsEnd()` (§11.12): one bound of the compiler-emitted
// stack-map table (ABI.md §4), as a `*byte`. The symbol is UNDEFINED in this
// object by design — no member may claim a name the linker owns — so the whole
// instruction is one relocation and nothing else.
//
// `debugLinesBegin()`/`debugLinesEnd()` (#3285) reuse this same lowering for
// the debug-info line table's extent symbols (ABI.md §4.2) — a second,
// independent linker-merged table with the identical "one relocation, no
// operands" shape, so Op.StackMapsAddr is reused rather than duplicated: both
// backends' emitters already key entirely off `ins.name`, never off the op
// itself, so nothing downstream needs to know which table a given call names.
fn lowerStackMapsAddr(fc: FnCtx, node: int, name: string): int {
  let sm = mkInstr(Op.StackMapsAddr, nodeType(fc, node))
  sm.name = "bit_stack_maps"
  if (name == "stackMapsEnd") {
    sm.name = "bit_stack_maps_end"
  }
  if (name == "debugLinesBegin") {
    sm.name = "bit_debug_lines"
  }
  if (name == "debugLinesEnd") {
    sm.name = "bit_debug_lines_end"
  }
  return builderEmit(fc.b, sm)
}
