// In-Bit self-checks for x86-64 conversion, constant materialization,
// shifts, memory access, the prologue/epilogue, and the value/gc-alloc
// selectors — split out of compiler/x64selcheck.bit (#3141), which was 797
// lines against the 800-line limit. compiler/x64selcheck.bit keeps the
// canonicalization, operand fetch/store, arithmetic and compare checks; both
// are the same module as selfcheck.bit (#1503), so `selfcheck()` still calls
// these directly.
//
// Named to sort after compiler/x64selcheck.bit — module files concatenate in
// bytewise filename order (compiler/project.bit:7).

fn checkX64ConvertSel() {
  let i8s = mkWidth(1, RegClass.Int, true)
  let i64s = mkWidth(8, RegClass.Int, true)
  // Named wF8/wF4 rather than f64/f32: those are predeclared type names, and
  // shadowing one is a warning this build treats as an error.
  let wF8 = mkWidth(8, RegClass.Float, false)
  let wF4 = mkWidth(4, RegClass.Float, false)

  // int->int recovers the source's true value, then re-canonicalizes to the
  // destination. Doing only one of the two breaks either widening or narrowing.
  let cx = xTestCtx()
  xEmitConvert(cx, 0, 0, i8s, i64s)
  assert(len(cx.buf.code) > 0)

  // int->float and float->int route through the float scratch and back.
  let cx2 = xTestCtx()
  xEmitConvert(cx2, 0, 0, i64s, wF8)
  assert(cx2.buf.code[3] == u8(0xF2) || cx2.buf.code[0] == u8(0xF2)) // cvtsi2sd
  let cx3 = xTestCtx()
  xEmitConvert(cx3, 0, 0, wF8, i64s)
  assert(cx3.buf.code[0] == u8(0xF2)) // cvttsd2si

  // float->float of the SAME width is a move, not a conversion: cvtsd2sd does
  // not exist.
  let cx4 = xTestCtx()
  xEmitConvert(cx4, 0, 0, wF8, wF8)
  let cx5 = xTestCtx()
  xEmitConvert(cx5, 0, 0, wF8, wF4)
  assert(xHex(cx4.buf) != xHex(cx5.buf))
  // cvtsd2ss: F2 prefix, then a REX byte (fscratch1 is xmm14, an extended
  // register), then the 0F 5A opcode — so the opcode is at index 2, not 1.
  assert(cx5.buf.code[0] == u8(0xF2))
  assert(cx5.buf.code[2] == u8(0x0F) && cx5.buf.code[3] == u8(0x5A))
}

fn checkX64MovXG() {
  // movq %rax, %xmm0 -> 66 48 0f 6e c0 ; movd %eax, %xmm0 -> 66 0f 6e c0.
  // REX.W is the ONLY difference between moving 64 bits and 32 — and for a
  // float constant that is the difference between an f64's bits and an f32's.
  let b = newX64Buf()
  xMovXG(b, XmmReg.Xmm0, XReg64.Rax, 8)
  assert(xHex(b) == "66480f6ec0")
  let b2 = newX64Buf()
  xMovXG(b2, XmmReg.Xmm0, XReg64.Rax, 4)
  assert(xHex(b2) == "660f6ec0")
  // movq %r11, %xmm14 -> 66 4d 0f 6e f3 (both extended)
  let b3 = newX64Buf()
  xMovXG(b3, XmmReg.Xmm14, XReg64.R11, 8)
  assert(xHex(b3) == "664d0f6ef3")
}

fn checkX64ConstSel() {
  // A small int uses the 7-byte imm32 form...
  let cx = xTestCtx()
  xEmitConstInt(cx, 0, 5)
  assert(len(cx.buf.code) == 7 + 3) // movabs-short + mov to rax
  // ...and a big one the 10-byte movabs; picking the short form for a value out
  // of imm32 range would sign-extend it into a different number.
  let cx2 = xTestCtx()
  xEmitConstInt(cx2, 0, 0x123456789)
  assert(len(cx2.buf.code) == 10 + 3)

  // A float constant is materialized by its BITS: the exact IEEE pattern into a
  // GPR, then moved across. No conversion is involved — cvtsi2sd here would
  // turn the bit pattern into the float of that integer VALUE, a wildly
  // different number.
  let cx3 = xTestCtx()
  xEmitConstFloat(cx3, 0, 0x3FF0000000000000, 8) // 1.0
  assert(xEmitContains(cx3.buf, 0x6E))  // movq xmm <- gpr
  assert(!xEmitContains(cx3.buf, 0x2A)) // NOT cvtsi2sd
}

fn checkX64ShiftSel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // A constant amount uses the immediate form — no rcx traffic at all.
  let cx = xTestCtx()
  xEmitShiftInt(cx, XShift.Shl, 0, 0, 0, 5, w64)
  //   49 89 c3       mov %rax, %r11
  //   49 c1 e3 05    shl $5, %r11
  //   4c 89 d8       mov %r11, %rax
  assert(xHex(cx.buf) == "4989c349c1e3054c89d8")

  // A variable amount must route through cl — the only variable shift count on
  // x86-64, and why such a function excludes rcx from allocation.
  //   49 89 c3    mov %rax, %r11
  //   48 89 c1    mov %rax, %rcx   <- the count into cl
  //   49 d3 e3    shl %cl, %r11    <- D3, the shift-by-cl opcode
  //   4c 89 d8    mov %r11, %rax
  // Pinned as a sequence, not by byte presence: 0xC1 is the shift-by-imm opcode
  // AND the ModRM byte of `mov %rax,%rcx`, so "does 0xC1 appear" answers the
  // wrong question entirely.
  let cx2 = xTestCtx()
  xEmitShiftInt(cx2, XShift.Shl, 0, 0, 0, -1, w64)
  assert(xHex(cx2.buf) == "4989c34889c149d3e34c89d8")

  // Only a LEFT shift can push bits past the type width. The right shifts carry
  // a canonical operand to a canonical result and add no narrowing — which is
  // the payoff of maintaining the invariant at all.
  let narrow = mkWidth(2, RegClass.Int, false)
  let cxShl = xTestCtx()
  xEmitShiftInt(cxShl, XShift.Shl, 0, 0, 0, 3, narrow)
  let cxShr = xTestCtx()
  xEmitShiftInt(cxShr, XShift.Shr, 0, 0, 0, 3, narrow)
  assert(len(cxShl.buf.code) > len(cxShr.buf.code))
  let cxSar = xTestCtx()
  xEmitShiftInt(cxSar, XShift.Sar, 0, 0, 0, 3, narrow)
  assert(len(cxSar.buf.code) == len(cxShr.buf.code))
}

fn checkX64FieldSel() {
  let w64 = mkWidth(8, RegClass.Int, true)
  // A plain field load: base into the secondary scratch, value into the primary.
  let cx = xTestCtx()
  xEmitFieldGet(cx, 0, 0, 16, w64, false, false)
  //   49 89 c2                mov %rax, %r10   (base fetch is elided: rax IS the
  //                                             reg, so getInt returns it)
  //   4d 8b 98 10 00 00 00    mov 16(%r10), %r11 -- actually base is rax here
  // The base register is rax (vreg 0 lives there), so no fetch move at all:
  //   4c 8b 98 10 00 00 00    mov 16(%rax), %r11
  //   4c 89 d8                mov %r11, %rax
  assert(xHex(cx.buf) == "4c8b98100000004c89d8")

  // An ARRAY field is inline storage: its value is the interior ADDRESS, formed
  // with lea. Loading a word there would read the array's first element as if
  // it were the array itself.
  let cx2 = xTestCtx()
  xEmitFieldGet(cx2, 0, 0, 16, w64, true, false)
  assert(xEmitContains(cx2.buf, 0x8D))  // lea
  assert(!xEmitContains(cx2.buf, 0x8B)) // no load
  assert(xHex(cx.buf) != xHex(cx2.buf))

  // A narrow field load extends to its declared width and signedness — the
  // width-canonical invariant holds at every definition site, loads included.
  let cxS = xTestCtx()
  xEmitFieldGet(cxS, 0, 0, 0, mkWidth(1, RegClass.Int, true), false, false)
  let cxU = xTestCtx()
  xEmitFieldGet(cxU, 0, 0, 0, mkWidth(1, RegClass.Int, false), false, false)
  assert(xHex(cxS.buf) != xHex(cxU.buf)) // movsbq vs movzbq

  // len(slice) is the word at offset 8 of the header — shared by slices and
  // strings (runtime/ABI.md §2) — guarded so a NULL header reads as 0 rather
  // than faulting (#1564; a zeroed class's slice/string field is null).
  //   49 c7 c3 00000000   mov  r11, 0        ; the null answer
  //   48 85 c0            test rax, rax
  //   74 07               jz   +7            ; skip the load, keeping the 0
  //   4c 8b 98 08000000   mov  r11, [rax+8]
  //   4c 89 d8            mov  rax, r11
  let cx3 = xTestCtx()
  xEmitSliceLen(cx3, 0, 0)
  assert(xHex(cx3.buf) ==
    "49c7c300000000" + "4885c0" + "7407" + "4c8b9808000000" + "4c89d8")

  // cap(slice) rides field_get at offset 24 on the header itself, so it takes
  // the SAME null guard — only the displacement differs (#1564).
  let cx3c = xTestCtx()
  xEmitFieldGet(cx3c, 0, 0, 24, w64, false, true)
  assert(xHex(cx3c.buf) ==
    "49c7c300000000" + "4885c0" + "7407" + "4c8b9818000000" + "4c89d8")

  // A non-slice base keeps the bare, unguarded load: a class field read must
  // pay nothing for the guard.
  let cx3s = xTestCtx()
  xEmitFieldGet(cx3s, 0, 0, 24, w64, false, false)
  assert(xHex(cx3s.buf) == "4c8b9818000000" + "4c89d8")

  // Indexed access scales by the ELEMENT width: base + index*width.
  let cx4 = xTestCtx()
  xEmitIndexGet(cx4, 0, 0, 0, mkWidth(8, RegClass.Int, true))
  let cx5 = xTestCtx()
  xEmitIndexGet(cx5, 0, 0, 0, mkWidth(4, RegClass.Int, true))
  assert(xHex(cx4.buf) != xHex(cx5.buf)) // scale 8 vs 4 in the SIB byte
}

fn checkX64Prologue() {
  // A leaf with no saves and no frame: just the rbp chain.
  let cx = newXCtx(XCallConv.SysV)
  xEmitPrologue(cx)
  //   55        push %rbp
  //   48 89 e5  mov %rsp, %rbp
  assert(xHex(cx.buf) == "554889e5")

  // With saves and a frame, the order is: chain, push saves, carve, THEN stash
  // the XMMs — they live inside the frame the sub just carved, so storing them
  // before it would write below rsp, into the red zone a signal handler may
  // clobber.
  let cx2 = newXCtx(XCallConv.Win64)
  cx2.frame = XFrame{ savedGpr: [XReg64.Rbx, XReg64.R13], savedXmm: [XmmReg.Xmm6],
    numSpillSlots: 1, frameSize: 32 }
  xEmitPrologue(cx2)
  //   55                       push %rbp
  //   48 89 e5                 mov %rsp, %rbp
  //   53                       push %rbx
  //   41 55                    push %r13
  //   48 81 ec 20 00 00 00     sub $32, %rsp
  //   f2 0f 11 b5 e0 ff ff ff  movsd %xmm6, -32(%rbp)   <- AFTER the sub
  assert(xHex(cx2.buf) == "554889e55341554881ec20000000f20f11b5e0ffffff")
}

fn checkX64Epilogue() {
  let cx = newXCtx(XCallConv.SysV)
  cx.frame = XFrame{ savedGpr: [XReg64.Rbx, XReg64.R13], savedXmm: []XmmReg(0),
    numSpillSlots: 0, frameSize: 16 }
  xEmitEpilogue(cx)
  //   48 81 c4 10..   add $16, %rsp
  //   41 5d           pop %r13     <- REVERSE of the push order
  //   5b              pop %rbx
  //   5d              pop %rbp
  // The stack is LIFO: popping in push order restores each saved value into the
  // WRONG register, which is silent and catastrophic.
  assert(xHex(cx.buf) == "4881c410000000" + "415d" + "5b" + "5d")

  // Prologue and epilogue mirror exactly: the prologue pushes rbx THEN r13, so
  // the epilogue pops r13 THEN rbx.
  let cxP = newXCtx(XCallConv.SysV)
  cxP.frame = cx.frame
  xEmitPrologue(cxP)
  // 55 | 48 89 e5 | 53 (push rbx) | 41 55 (push r13) | 48 81 ec 10 00 00 00
  assert(xHex(cxP.buf) == "554889e55341554881ec10000000")
}

fn checkX64ValueSelectors() {
  // fneg flips the sign BIT: materialize the sign mask in a GPR, move it into
  // fscratch2, XOR. It is NOT `0.0 - x`, which is what this emitted until
  // #1442 and which is wrong twice — `0.0 - 0.0` is `+0.0`, so negating zero
  // lost the sign, and subtraction returns a NaN operand with its sign bit
  // CLEARED. See `xEmitFneg`. vreg 0 lives in floatRegs[0] = xmm0, so the
  // operand IS xmm0 here and is copied into fscratch1; only a SPILLED operand
  // reloads (pinned separately below).
  let cx = xTestCtx()
  xEmitFneg(cx, 0, 0, 4)
  assert(xHexHas(cx.buf, "66450f6efb")) // movd  %r11d,  %xmm15  (mask 0x80000000)
  assert(xHexHas(cx.buf, "450f57f7"))   // xorps %xmm15, %xmm14

  let cx8 = xTestCtx()
  xEmitFneg(cx8, 0, 0, 8)
  // REX.W and the 0x66 prefix select the double forms of the same two ops.
  assert(xHexHas(cx8.buf, "664d0f6efb"))  // movq  %r11,   %xmm15 (mask 1<<63)
  assert(xHexHas(cx8.buf, "66450f57f7"))  // xorpd %xmm15, %xmm14

  // A spilled operand reloads into fscratch1 — the accumulator it is XORed
  // into — with fscratch2 holding the mask. That is the reverse of the old
  // `0.0 - x` shape, which needed the accumulator kept clear.
  let cxs2 = xTestCtx()
  xEmitFneg(cxs2, 0, 1, 4) // vreg 1 is spilled
  // movsd -16(%rbp), %xmm14 — always-disp32 (b5 f0ffffff), never the shorter
  // disp8 form: -16 and not -8 because xTestCtx saves one GPR below rbp. The
  // reload is the 8-byte form even at width 4, as it was before this change:
  // the extra bytes are masked off by the 4-byte store on the way out.
  assert(xHexHas(cxs2.buf, "f2440f10b5f0ffffff"))
  assert(xHexHas(cxs2.buf, "450f57f7")) // xorps %xmm15, %xmm14

  // nil is the null pointer via `xor r32, r32` — the 32-bit write zero-extends,
  // clearing all 64 bits.
  let cxn = xTestCtx()
  xEmitConstNil(cxn, 0)
  assert(xHexHas(cxn.buf, "4531db")) // xor %r11d, %r11d

  // A string literal is a static .rodata header address, named by pool index.
  let cxs = xTestCtx()
  xEmitConstString(cxs, 0, 7)
  assert(len(cxs.relocs) == 1)
  assert(cxs.relocs[0].symbol == "__bitstr_7")
  assert(cxs.relocs[0].kind == RelocKind.Abs64) // movabs names an address outright

  // type_info is NOT a call and NOT a GC point: no safepoint may be recorded, or
  // every later safepoint's stack map lands on the wrong return address.
  let cxt = xTestCtx()
  cxt.safepointCodeOffsets = [0, 0]
  xEmitTypeInfo(cxt, 0, 21, 16, [8])
  assert(cxt.nextSafepointIdx == 0)
  assert(cxt.relocs[0].symbol == "__bittype_21_16_8")
}

fn checkX64GcAlloc() {
  // gc_alloc IS a call and a GC point. The safepoint must be recorded at the
  // RETURN address — a collection triggered by this very allocation walks the
  // caller's frame by that address (runtime/ABI.md §5).
  let cx = xCallTestCtx()
  cx.safepointCodeOffsets = [0]
  xEmitGcAlloc(cx, 0, 21, 24, [0, 8])
  assert(cx.nextSafepointIdx == 1)
  // The RETURN address: past the movabs (10) and the whole e8+rel32 (5). Do not
  // derive this from len(code) — the trailing put of rax into rax is elided, so
  // the safepoint lands at the end of the buffer here by coincidence, not rule.
  assert(cx.safepointCodeOffsets[0] == 15)
  // Strictly past the reloc's field, which sits INSIDE the call instruction.
  // Recording before the call would give 10, failing both of these.
  assert(cx.safepointCodeOffsets[0] > cx.relocs[1].offset)
  // The TypeInfo symbol encodes the SHAPE, so two sites with identical layout
  // share one blob.
  assert(cx.relocs[0].symbol == "__bittype_21_24_0_8")
  assert(cx.relocs[1].symbol == "bit_rt_gc_alloc")
  assert(cx.relocs[1].kind == RelocKind.Branch)

  // Win64 hands the callee 32 bytes of shadow space above the return address;
  // SysV has none. Omitting it lets the callee scribble on our frame.
  let cw = xCallTestCtx()
  cw.cc = XCallConv.Win64
  cw.safepointCodeOffsets = [0]
  xEmitGcAlloc(cw, 0, 21, 24, [0, 8])
  // Always the imm32 form (48 81 /5 imm32), never the assembler's shorter imm8 —
  // the encoder is uniform on purpose, like its always-disp32 addressing.
  assert(xHexHas(cw.buf, "4881ec20000000")) // sub $32, %rsp
  assert(xHexHas(cw.buf, "4881c420000000")) // add $32, %rsp
  let cs = xCallTestCtx()
  cs.safepointCodeOffsets = [0]
  xEmitGcAlloc(cs, 0, 21, 24, [0, 8])
  assert(!xHexHas(cs.buf, "4881ec20000000")) // SysV reserves no shadow space

  // make_closure fills the cell AFTER the call: rax is the cell, and the env is
  // loaded post-call because a caller-saved register would not survive it.
  let cc = xCallTestCtx()
  cc.safepointCodeOffsets = [0]
  xEmitMakeClosure(cc, 0, "myfn", 0, 21)
  assert(cc.relocs[0].symbol == "__bittype_21_16_8") // 16-byte cell, one GC field at +8
  assert(cc.relocs[1].symbol == "bit_rt_gc_alloc")
  assert(cc.relocs[2].symbol == "myfn")
  assert(xHexHas(cc.buf, "4c899800000000")) // mov %r11, (%rax)   code at +0
  assert(xHexHas(cc.buf, "48899808000000")) // mov %rbx, 8(%rax)  env  at +8

  // func_addr is the same address materialization minus the cell: no call, so no
  // safepoint slot is consumed.
  let cf = xCallTestCtx()
  cf.safepointCodeOffsets = [0]
  xEmitFuncAddr(cf, 0, "target")
  assert(cf.nextSafepointIdx == 0)
  assert(len(cf.relocs) == 1 && cf.relocs[0].symbol == "target")
}
