// compiler/pmfetchintegritycheck.bit -- split out of pmfetchresolvecheck.bit.
// The integrity-mismatch check: a cached checkout whose recorded commit no
// longer matches its directory must be refused, not silently re-resolved.
//
// Same module as pmfetchresolvecheck.bit, so no import is needed. The name
// still matches the `compiler/pm*check*.bit` glob that
// _tests_/bit/pmrangegate/scratchpairing.bit scans, so this file stays inside
// the scratch-dir pairing guard rather than slipping out of its corpus.

// A tampered cache entry (content present, but its checked-out HEAD does not
// match the sha the directory claims to be) must fail loudly, never silently
// re-resolve — SPEC'd in the ticket this file guards.
// Setup checkPmfetchIntegrityMismatch's tamper-then-verify steps build on.
// Takes `root` rather than calling `pmCheckScratchDir()` itself: the scratch
// directory is the caller's to create and to give back, and the pairing guard
// in _tests_/bit/pmrangegate/scratchpairing.bit reads one function body at a
// time, so acquiring it here would put the `removeTree` out of its sight.
fn checkPmfetchIntegrityMismatchSetup(root: string): (PmFixture, string, string) {
  let fx = pmBuildFixture(root)
  let url = "file://" + fx.dir
  let cacheRoot = root + "/cache"

  let first = fetchSha(
    defaultGitBin, cacheRoot, GitRemoteRepo{
      host = "local",
      owner = "pmfetchcheck",
      repo = "tamper",
    },
    GitFetchTarget{ url = url, sha = fx.sha, pkgDir = "" }, pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchcheck: fetchSha failed: " + e.message())
  }
  assert(!first.cacheHit)
  return (fx, url, cacheRoot)
}

// Move the fixture's history forward, so the CACHED checkout (still at the old
// commit) now disagrees with what a fresh git rev-parse would report if it were
// silently re-resolved instead of verified. Returns the moved HEAD sha. Touches
// no scratch directory: the caller owns that, and owns giving it back.
fn checkPmfetchIntegrityMismatchTamper(fx: PmFixture): string {
  // Move the fixture's history forward, so the CACHED checkout (still at the
  // old commit) now disagrees with what a fresh git rev-parse would report if
  // this were silently re-resolved instead of verified.
  writeFile(fx.dir + "/hello.txt", "changed\n") catch e {
    panic("pmfetchcheck: cannot rewrite fixture file: " + e.message())
  }
  let add = runGit(defaultGitBin, ["-C", fx.dir, "add", "hello.txt"], pmCheckTimeoutMs) catch e {
    panic("pmfetchcheck: git add (tamper) failed: " + e.message())
  }
  pmGitMustSucceed("add", add)
  let commit = runGit(
    defaultGitBin,
    ["-C", fx.dir, "commit", "--quiet", "-m", "moved"],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchcheck: git commit (tamper) failed: " + e.message())
  }
  pmGitMustSucceed("commit", commit)
  let movedSha = revParseHead(defaultGitBin, fx.dir, pmCheckTimeoutMs) catch e {
    panic("pmfetchcheck: cannot read moved fixture HEAD: " + e.message())
  }
  assert(movedSha != fx.sha)
  return movedSha
}

fn checkPmfetchIntegrityMismatch() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmfetchcheck: cannot create scratch dir: " + e.message())
  }
  let (fx, url, cacheRoot) = checkPmfetchIntegrityMismatchSetup(root)

  let movedSha = checkPmfetchIntegrityMismatchTamper(fx)

  // Overwrite the CACHED directory's own working file directly (simulating
  // corruption/tampering of the cache itself, not a re-fetch) — its checked
  // out HEAD is unchanged, so this must still verify fine and remain a hit.
  let stillHit = fetchSha(
    defaultGitBin, cacheRoot, GitRemoteRepo{
      host = "local",
      owner = "pmfetchcheck",
      repo = "tamper",
    },
    GitFetchTarget{ url = url, sha = fx.sha, pkgDir = "" }, pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchcheck: fetchSha (unchanged cache) failed: " + e.message())
  }
  assert(stillHit.cacheHit)
  assert(stillHit.sha == fx.sha)

  // Now genuinely corrupt the cached checkout's recorded commit: fetch the
  // moved commit into it and check it out directly (the cached checkout is
  // detached at a single sha, not a branch, so there is no local "main" to
  // switch to — its HEAD no longer equals the directory's own sha component
  // once this lands, which fetchSha must catch and refuse, not paper over).
  let fetchMoved = runGit(
    defaultGitBin,
    ["-C", stillHit.dir, "fetch", "--quiet", url, movedSha],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchcheck: git fetch (corrupt) failed: " + e.message())
  }
  pmGitMustSucceed("fetch", fetchMoved)
  let reset = runGit(
    defaultGitBin,
    ["-C", stillHit.dir, "checkout", "--quiet", movedSha],
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmfetchcheck: git checkout (corrupt) failed: " + e.message())
  }
  pmGitMustSucceed("reset", reset)

  let shouldFail = fetchSha(
    defaultGitBin, cacheRoot, GitRemoteRepo{
      host = "local",
      owner = "pmfetchcheck",
      repo = "tamper",
    },
    GitFetchTarget{ url = url, sha = fx.sha, pkgDir = "" }, pmCheckTimeoutMs,
  ) catch _ {
    pmDeadFetchResult()
  }
  assert(len(shouldFail.dir) == 0)

  removeTree(root, pmCheckTimeoutMs)
}
