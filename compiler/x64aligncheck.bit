// #5878: jump placement (compiler/x64align.bit). Same module; nothing here is
// imported.

// A setter fused with a following jcc is found from the BYTES before the
// jump, not from the emitter's own fuseStart, so a setter the padding failed
// to treat as fused still fails the check: the register forms this backend
// writes, `REX.W {01,21,29,39,85} /r` (3 bytes) and `REX.W 81 /{0,4,5,7} id`
// (7 bytes).
fn xFusedSetterLen(code: []u8, j: int): int {
  if (xImmSetterEnds(code, j)) {
    return 7
  }
  if (xRegSetterEnds(code, j)) {
    return 3
  }
  return 0
}

fn xIsRexW(v: u8): bool {
  return (v & 0xF8) == 0x48
}

fn xIntIn(v: int, set: []int): bool {
  for x of set {
    if (x == v) {
      return true
    }
  }
  return false
}

// `REX.W 81 /{0,4,5,7} id`, register operand, ending at `j`.
fn xImmSetterEnds(code: []u8, j: int): bool {
  if (j < 7 || !xIsRexW(code[j - 7]) || code[j - 6] != 0x81 || code[j - 5] < 0xC0) {
    return false
  }
  return xIntIn(int((code[j - 5] >> 3) & 7), [0, 4, 5, 7])
}

// `REX.W {01,21,29,39,85} /r`, both operands registers, ending at `j`.
fn xRegSetterEnds(code: []u8, j: int): bool {
  if (j < 3 || !xIsRexW(code[j - 3]) || code[j - 1] < 0xC0) {
    return false
  }
  return xIntIn(int(code[j - 2]), [0x01, 0x21, 0x29, 0x39, 0x85])
}

// The length of the jump whose first byte is at `j`, or 0 for a byte that
// starts no jump this backend writes.
fn xJumpLenAt(code: []u8, j: int): int {
  if (code[j] == 0xE9) {
    return 5
  }
  if (code[j] == 0x0F && (code[j + 1] & 0xF0) == 0x80) {
    return 6
  }
  if ((code[j] & 0xF0) == 0x70) {
    return 2
  }
  return 0
}

class XJumpCensus {
  jumps: int,
  fused: int,
}

// Asserts that no recorded jump, and no jcc together with the setter fused
// with it, crosses or ends on a 32-byte boundary.
fn xCheckJumpPlacement(b: X64Buf, c: XJumpCensus) {
  for j of b.jumps {
    let n = xJumpLenAt(b.code, j)
    assert(n > 0)
    assert(!xSpansBoundary(j, j + n))
    c.jumps = c.jumps + 1
    let s = 0
    if (n != 5) {
      s = xFusedSetterLen(b.code, j)
    }
    if (s > 0) {
      assert(!xSpansBoundary(j - s, j + n))
      c.fused = c.fused + 1
    }
  }
}

// Two bench objects, bench/cases/collatz and bench/cases/matrix, compiled
// through the real per-function path (the same one emitElfObject takes),
// with matrix shrunk to what shapes its loops.
fn xAlignBenchSrc(): string {
  return "fn collatz(start: i64): i64 {\n  let n = start\n  let steps = 0\n  while (n != 1) {\n    if (n % 2 == 0) {\n      n = n / 2\n    } else {\n      n = 3 * n + 1\n    }\n    steps = steps + 1\n  }\n  return steps\n}\n\n" +
    "fn mat(n: int, t: int): f64 {\n  let a: []f64 = []f64(n * n)\n  let b: []f64 = []f64(n * n)\n  let c: []f64 = []f64(n * n)\n  let i = 0\n  while (i < n) {\n    let j = 0\n    while (j < n) {\n      a[i * n + j] = f64((i + j + t) % 13)\n      b[i * n + j] = f64((i * 2 + j * 3 + t) % 17)\n      j = j + 1\n    }\n    i = i + 1\n  }\n  i = 0\n  while (i < n) {\n    let k = 0\n    while (k < n) {\n      let aik = a[i * n + k]\n      let j = 0\n      while (j < n) {\n        c[i * n + j] = c[i * n + j] + aik * b[k * n + j]\n        j = j + 1\n      }\n      k = k + 1\n    }\n    i = i + 1\n  }\n  let sum = 0.0\n  i = 0\n  while (i < len(c)) {\n    sum = sum + c[i]\n    i = i + 1\n  }\n  return sum\n}\n\n" +
    "fn main() {\n  let best = 0\n  let i = 1\n  while (i < 1000) {\n    let s = collatz(i)\n    if (s > best) {\n      best = s\n    }\n    i = i + 1\n  }\n  assert(best > 0 && mat(8, 1) > 0.0)\n}\n"
}

fn checkX64BenchJumpPlacement() {
  let m = lowerSourceModule(xAlignBenchSrc())
  optimizeModule(m, false)
  let c = XJumpCensus{ jumps = 0, fused = 0 }
  for f of m.funcs {
    if (!emitsFunction(f, false)) {
      continue
    }
    let regs = xBuildFrameRegs(m, f, XCallConv.SysV)
    let setup = xBuildFrameSetup(f, false, regs)
    let cx = xNewFuncCtx(f, false, regs, setup)
    assert(xEmitFuncBody(cx, f))
    xCheckJumpPlacement(cx.buf, c)
  }
  // Not vacuous: the loops, bounds checks and polls above write dozens.
  assert(c.jumps >= 40 && c.fused >= 20)
}

// A fused cmp that would straddle moves forward whole, with the NOPs before
// it; an unfused jump gets its NOPs directly in front of it.
fn checkX64JumpPad() {
  let b = newX64Buf()
  b.align = true
  xAppendNop1s(b, 25)
  xArithRR(b, XArith.Cmp, XReg64.Rax, XReg64.Rcx) // 25..28, jcc would end at 34
  assert(xPadJump(b, 6, true) == 25)
  assert(len(b.code) == 35 && len(b.jumps) == 1 && b.jumps[0] == 35)
  assert(xHex(xBufOf(b.code[25:32])) == "0f1f8000000000")
  assert(xHex(xBufOf(b.code[32:35])) == "4839c8")
  let u = newX64Buf()
  u.align = true
  xAppendNop1s(u, 28)
  assert(xPadJump(u, 5, false) == 28 && len(u.code) == 32)
  let off = newX64Buf()
  xArithRR(off, XArith.Cmp, XReg64.Rax, XReg64.Rcx)
  assert(xPadJump(off, 6, true) == 3 && len(off.code) == 3)
}

// A loop header moves to the next 32-byte boundary only when that costs at
// most xLoopAlignMaxPad bytes; any other block start stays put.
fn checkX64LoopHeaderAlign() {
  for n of [20, 10, 32] {
    for head of [true, false] {
      let b = newX64Buf()
      b.align = true
      xAppendNop1s(b, n)
      xAlignBlockStart(b, head)
      let want = n
      if (head && n == 20) {
        want = 32
      }
      assert(len(b.code) == want && b.fuseEnd == -1)
    }
  }
}

fn xAppendNop1s(b: X64Buf, n: int) {
  let k = 0
  while (k < n) {
    xEmitByte(b, 0x90)
    k = k + 1
  }
}
