// #5878: jump placement (compiler/x64align.bit). Same module; nothing here is
// imported.

// A setter fused with a following jcc is found from the BYTES before the
// jump, not from the emitter's own fuseStart, so a setter the padding failed
// to treat as fused still fails the check: the register forms this backend
// writes, `REX.W {01,21,29,39,85} /r` (3 bytes), `REX.W 81 /{0,4,5,7} id`
// (7 bytes) and `REX.W 83 /{0,4,5,7} ib` (4 bytes, #5933).
fn xFusedSetterLen(code: []u8, j: int): int {
  if (xImmSetterEnds(code, j, 0x81, 4)) {
    return 7
  }
  if (xImmSetterEnds(code, j, 0x83, 1)) {
    return 4
  }
  if (xRegSetterEnds(code, j)) {
    return 3
  }
  return 0
}

fn xIsRexW(v: u8): bool {
  return (v & 0xF8) == 0x48
}

fn xIntIn(v: int, set: []int): bool {
  for x of set {
    if (x == v) {
      return true
    }
  }
  return false
}

// `REX.W <opc> /{0,4,5,7}` with an `immLen`-byte immediate, register
// operand, ending at `j`.
fn xImmSetterEnds(code: []u8, j: int, opc: u8, immLen: int): bool {
  let at = j - 3 - immLen
  if (at < 0 || !xIsRexW(code[at]) || code[at + 1] != opc || code[at + 2] < 0xC0) {
    return false
  }
  return xIntIn(int((code[at + 2] >> 3) & 7), [0, 4, 5, 7])
}

// `REX.W {01,21,29,39,85} /r`, both operands registers, ending at `j`.
fn xRegSetterEnds(code: []u8, j: int): bool {
  if (j < 3 || !xIsRexW(code[j - 3]) || code[j - 1] < 0xC0) {
    return false
  }
  return xIntIn(int(code[j - 2]), [0x01, 0x21, 0x29, 0x39, 0x85])
}

// The length of the jump whose first byte is at `j`, or 0 for a byte that
// starts no jump this backend writes.
fn xJumpLenAt(code: []u8, j: int): int {
  if (code[j] == 0xE9) {
    return 5
  }
  if (code[j] == 0x0F && (code[j + 1] & 0xF0) == 0x80) {
    return 6
  }
  if ((code[j] & 0xF0) == 0x70) {
    return 2
  }
  return 0
}

class XJumpCensus {
  jumps: int,
  fused: int,
  prefixed: int,
}

// Asserts that no recorded jump, and no jcc together with the setter fused
// with it, crosses or ends on a 32-byte boundary, and that no padding prefix
// sits on either (#5935).
fn xCheckJumpPlacement(b: X64Buf, c: XJumpCensus) {
  let starts = []int(0)
  for j of b.jumps {
    let n = xJumpLenAt(b.code, j)
    assert(n > 0)
    assert(!xSpansBoundary(j, j + n))
    c.jumps = c.jumps + 1
    starts = append(starts, j)
    let s = 0
    if (n != 5) {
      s = xFusedSetterLen(b.code, j)
    }
    if (s > 0) {
      assert(!xSpansBoundary(j - s, j + n))
      c.fused = c.fused + 1
      starts = append(starts, j - s)
    }
  }
  xCheckPrefixes(b, starts, c)
}

// Every instruction xPadJump lengthened carries 1..xPadPrefixMax() prefixes
// in all, CS ones first, and is neither a jump nor a fused setter.
fn xCheckPrefixes(b: X64Buf, banned: []int, c: XJumpCensus) {
  for p of b.prefixed {
    let k = 0
    while (b.code[p + k] == xPadPrefix()) {
      k = k + 1
    }
    assert(k > 0 && k + xPrefixCount(b.code, p + k) <= xPadPrefixMax())
    assert(!xIntIn(p + k, banned))
    c.prefixed = c.prefixed + 1
  }
}

// Two bench objects, bench/cases/collatz and bench/cases/matrix, compiled
// through the real per-function path (the same one emitElfObject takes),
// with matrix shrunk to what shapes its loops.
fn xAlignBenchSrc(): string {
  return "fn collatz(start: i64): i64 {\n  let n = start\n  let steps = 0\n  while (n != 1) {\n    if (n % 2 == 0) {\n      n = n / 2\n    } else {\n      n = 3 * n + 1\n    }\n    steps = steps + 1\n  }\n  return steps\n}\n\n" +
    "fn mat(n: int, t: int): f64 {\n  let a: []f64 = []f64(n * n)\n  let b: []f64 = []f64(n * n)\n  let c: []f64 = []f64(n * n)\n  let i = 0\n  while (i < n) {\n    let j = 0\n    while (j < n) {\n      a[i * n + j] = f64((i + j + t) % 13)\n      b[i * n + j] = f64((i * 2 + j * 3 + t) % 17)\n      j = j + 1\n    }\n    i = i + 1\n  }\n  i = 0\n  while (i < n) {\n    let k = 0\n    while (k < n) {\n      let aik = a[i * n + k]\n      let j = 0\n      while (j < n) {\n        c[i * n + j] = c[i * n + j] + aik * b[k * n + j]\n        j = j + 1\n      }\n      k = k + 1\n    }\n    i = i + 1\n  }\n  let sum = 0.0\n  i = 0\n  while (i < len(c)) {\n    sum = sum + c[i]\n    i = i + 1\n  }\n  return sum\n}\n\n" +
    "fn main() {\n  let best = 0\n  let i = 1\n  while (i < 1000) {\n    let s = collatz(i)\n    if (s > best) {\n      best = s\n    }\n    i = i + 1\n  }\n  assert(best > 0 && mat(8, 1) > 0.0)\n}\n"
}

fn checkX64BenchJumpPlacement() {
  let m = lowerSourceModule(xAlignBenchSrc())
  optimizeModule(m, false)
  let c = XJumpCensus{ jumps = 0, fused = 0, prefixed = 0 }
  for f of m.funcs {
    if (!emitsFunction(f, false)) {
      continue
    }
    let regs = xBuildFrameRegs(m, f, XCallConv.SysV, false)
    let setup = xBuildFrameSetup(f, false, regs)
    let cx = xNewFuncCtx(f, false, regs, setup)
    assert(xEmitFuncBody(cx, f))
    xCheckJumpPlacement(cx.buf, c)
  }
  // Not vacuous: the loops, bounds checks and polls above write dozens, and
  // their pads are partly prefixes.
  assert(c.jumps >= 40 && c.fused >= 20 && c.prefixed >= 3)
}

// A fused cmp that would straddle moves forward whole, with the NOPs before
// it; an unfused jump gets its NOPs directly in front of it.
fn checkX64JumpPad() {
  let b = newX64Buf()
  b.align = true
  xAppendNop1s(b, 25)
  xArithRR(b, XArith.Cmp, XReg64.Rax, XReg64.Rcx) // 25..28, jcc would end at 34
  assert(xPadJump(b, 6, true) == 25)
  assert(len(b.code) == 35 && len(b.jumps) == 1 && b.jumps[0] == 35)
  assert(xHex(xBufOf(b.code[25:32])) == "0f1f8000000000")
  assert(xHex(xBufOf(b.code[32:35])) == "4839c8")
  let u = newX64Buf()
  u.align = true
  xAppendNop1s(u, 28)
  assert(xPadJump(u, 5, false) == 28 && len(u.code) == 32)
  let off = newX64Buf()
  xArithRR(off, XArith.Cmp, XReg64.Rax, XReg64.Rcx)
  assert(xPadJump(off, 6, true) == 3 && len(off.code) == 3)
}

// #5935: the pad goes into CS prefixes on the instructions before the fused
// setter, one each, nearest first, and no NOP is written; the farthest, and
// the setter itself, stay as they were.
fn checkX64JumpPadPrefix() {
  let b = newX64Buf()
  b.align = true
  xAppendNop1s(b, 17)
  xMovRR(b, XReg64.Rax, XReg64.Rcx)               // 17
  xMovRR(b, XReg64.Rdx, XReg64.Rbx)               // 20
  xMovRR(b, XReg64.Rsi, XReg64.Rdi)               // 23
  xMovRR(b, XReg64.R8, XReg64.R9)                 // 26
  xArithRR(b, XArith.Cmp, XReg64.Rax, XReg64.Rcx) // 29..32, jcc would end at 38
  assert(xPadJump(b, 6, true) == 29)
  assert(len(b.code) == 35 && b.jumps[0] == 35 && b.padN == 0)
  assert(xHex(xBufOf(b.code[17:35])) == "4889c8" + "2e4889da" + "2e4889fe" + "2e4d89c8" + "4839c8")
  assert(len(b.prefixed) == 3 && b.prefixed[0] == 20 && b.prefixed[2] == 28)
  // Rooms count REX, 66 and the 0F escape, and stop at 15 bytes.
  assert(xPrefixRoom([u8(0x48), u8(0x89), u8(0xC8)], 0) == 4)
  assert(xPrefixRoom([u8(0x8B), u8(0x45), u8(0x00)], 0) == 5)
  assert(xPrefixRoom([u8(0x66), u8(0x41), u8(0x89), u8(0x00)], 0) == 3)
  assert(xPrefixRoom([u8(0x48), u8(0x0F), u8(0xB6), u8(0xC0)], 0) == 3)
  let wide = newX64Buf()
  xMovStoreImm(wide, xMemBI(XReg64.Rax, XReg64.Rcx, 8, 4096), 1) // 12: disp32
  assert(len(wide.code) == 12 && xPrefixRoom(wide.code, 0) == 3)
}

// #6463: setcc, movzx and the SSE forms take prefixes too. An SSE form's
// mandatory F2/F3 counts toward the five, and the CS byte goes in front of it.
fn checkX64JumpPadNotedForms() {
  let b = newX64Buf()
  b.align = true
  xAppendNop1s(b, 15)
  xFArithRR(b, XFArith.FAdd, XmmReg.Xmm0, XmmReg.Xmm1, 8) // 15: f20f58c1
  xSetcc(b, ccB(), XReg64.Rax)                            // 19: 400f92c0
  xMovzxb(b, XReg64.Rax, XReg64.Rax)                      // 23: 480fb6c0
  xTestRR(b, XReg64.Rax, XReg64.Rax)                      // 27..30, jne would end at 36
  assert(xPadJump(b, 6, true) == 27 && len(b.code) == 35 && b.jumps[0] == 35)
  assert(xHex(xBufOf(b.code[15:35])) == "2ef20f58c1" + "2e2e400f92c0" + "2e2e480fb6c0" + "4885c0")
  assert(len(b.prefixed) == 3 && b.prefixed[0] == 15 && b.prefixed[2] == 26)
  assert(xPrefixRoom([u8(0xF2), u8(0x48), u8(0x0F), u8(0x2C), u8(0xC1)], 0) == 2)
  assert(xPrefixRoom([u8(0x66), u8(0x48), u8(0x0F), u8(0x6E), u8(0xC0)], 0) == 2)
}

// A label stops the search, and what prefixes cannot take is NOPs at the
// setter: the one movable mov takes its 4, the 3 left are one NOP.
fn checkX64JumpPadFallback() {
  let b = newX64Buf()
  b.align = true
  xAppendNop1s(b, 19)
  xMovRR(b, XReg64.Rax, XReg64.Rcx) // 19, before the label: never moves
  xFuseBarrier(b)
  xMovRR(b, XReg64.Rdx, XReg64.Rbx)               // 22
  xArithRR(b, XArith.Cmp, XReg64.Rax, XReg64.Rcx) // 25..28
  assert(xPadJump(b, 6, true) == 25 && len(b.code) == 35)
  assert(xHex(xBufOf(b.code[19:35])) == "4889c8" + "2e2e2e2e4889da" + "0f1f00" + "4839c8")
  let none = newX64Buf()
  none.align = true
  xAppendNop1s(none, 25)
  xArithRR(none, XArith.Cmp, XReg64.Rax, XReg64.Rcx)
  assert(xPadJump(none, 6, true) == 25 && len(none.prefixed) == 0)
  assert(xHex(xBufOf(none.code[25:35])) == "0f1f8000000000" + "4839c8")
}

// What the context recorded past a prefix moves with its bytes; a row or a
// return address naming the start of a lengthened instruction still names
// it, with its prefixes in front.
fn checkX64JumpPadMovesCtx() {
  let cx = newXCtx(XCallConv.SysV)
  cx.buf.align = true
  cx.safepointCodeOffsets = []int(1)
  xAppendNop1s(cx.buf, 18)
  for pc of [18, 21, 26, 29] {
    cx.dbgRows = append(cx.dbgRows, DebugLineRow{ pcOffset = pc, file = 0, line = pc })
  }
  xMovRR(cx.buf, XReg64.Rax, XReg64.Rcx) // 18
  xCallReloc(cx, "f")                    // 21, field at 22, returns to 26
  xRecordSafepoint(cx)
  xMovRR(cx.buf, XReg64.Rdx, XReg64.Rbx)               // 26
  xArithRR(cx.buf, XArith.Cmp, XReg64.Rax, XReg64.Rcx) // 29..32
  xPadJumpCx(cx, 6, true)
  assert(xHex(xBufOf(cx.buf.code[18:35])) == "2e4889c8" + "e800000000" + "2e2e4889da" + "4839c8")
  assert(cx.relocs[0].offset == 23 && cx.safepointCodeOffsets[0] == 27)
  assert(cx.dbgRows[0].pcOffset == 18 && cx.dbgRows[1].pcOffset == 22)
  assert(cx.dbgRows[2].pcOffset == 27 && cx.dbgRows[3].pcOffset == 32)
}

// A loop header moves to the next 32-byte boundary whatever the pad, up to
// the 31 bytes n=1 needs; one already on it, and any other block start, stays
// put.
fn checkX64LoopHeaderAlign() {
  for n of [20, 10, 1, 32] {
    for head of [true, false] {
      let b = newX64Buf()
      b.align = true
      xAppendNop1s(b, n)
      xAlignBlockStart(b, head)
      let want = n
      if (head && n != 32) {
        want = 32
      }
      assert(len(b.code) == want && b.fuseEnd == -1)
    }
  }
}

fn xAppendNop1s(b: X64Buf, n: int) {
  let k = 0
  while (k < n) {
    xEmitByte(b, 0x90)
    k = k + 1
  }
}
