// compiler/pmclichecktail.bit — the `bit remove` (#1736) self-checks and the
// non-fetching `resolveTransitiveDeps` (#2251) graph-assembly self-checks,
// split off compiler/pmclicheck.bit under the 800-line limit (#2967 —
// pmclicheck.bit crossed it again after #2244 landed dependency-spec forms).
// Same module, sibling file: this reuses pmclicheck.bit's
// `import { contains } from "std/strings"` unqualified — an import is per-
// MODULE, not per-file, so re-importing it here would be `E0042 already
// declared in this scope`. Run via `checkPmCli()` (pmclicheck.bit), not on
// its own.

// A project directory with a `bit.json` carrying a user comment and TWO
// pre-existing dependencies (`kept` and `doomed`) plus a matching `bit.lock`
// — `bit remove doomed`'s fixture: it must delete `doomed` and leave `kept`
// (and every comment) byte-for-byte untouched.
fn pmCliBuildRemovalProject(root: string): PmCliProject {
  let dir = root + "/removal-project"
  mkdirAll(dir) catch e {
    panic("pmclicheck: cannot create removal project dir: " + e.message())
  }
  let bitJson = "{\n"
  bitJson = bitJson + "  // top-level project comment -- must survive untouched\n"
  bitJson = bitJson + "  \"name\": \"demo\",\n"
  bitJson = bitJson + "  \"dependencies\": {\n"
  bitJson = bitJson + "    // kept dependency comment -- must survive untouched\n"
  bitJson = bitJson + "    \"kept\": \"github.com/byteink/kept@v1.0.0\",\n"
  bitJson = bitJson + "    // doomed dependency comment -- removed along with its entry\n"
  bitJson = bitJson + "    \"doomed\": \"github.com/byteink/doomed@v2.0.0\"\n"
  bitJson = bitJson + "  }\n"
  bitJson = bitJson + "}\n"
  let path = dir + "/bit.json"
  writeFile(path, bitJson) catch e {
    panic("pmclicheck: cannot write removal project bit.json: " + e.message())
  }
  let seed = []LockEntry(0)
  seed = append(
    seed,
    LockEntry{
      name: "kept",
      url: "https://github.com/byteink/kept.git",
      commit: "1111111111111111111111111111111111111111",
      requires: []LockRequire(0),
    },
  )
  seed = append(
    seed,
    LockEntry{
      name: "doomed",
      url: "https://github.com/byteink/doomed.git",
      commit: "2222222222222222222222222222222222222222",
      requires: []LockRequire(0),
    },
  )
  writeLock(dir + "/bit.lock", seed) catch e {
    panic("pmclicheck: cannot seed removal project bit.lock: " + e.message())
  }
  return PmCliProject{ dir: dir, bitJsonPath: path }
}

fn pmCliExpectedBitJsonAfterRemoval(): string {
  let s = "{\n"
  s = s + "  // top-level project comment -- must survive untouched\n"
  s = s + "  \"name\": \"demo\",\n"
  s = s + "  \"dependencies\": {\n"
  s = s + "    // kept dependency comment -- must survive untouched\n"
  s = s + "    \"kept\": \"github.com/byteink/kept@v1.0.0\"\n"
  s = s + "  }\n"
  s = s + "}\n"
  return s
}

// `bit remove doomed` deletes only `doomed`'s entry from both bit.json (every
// other comment/entry byte-identical) and bit.lock.
fn checkPmCliRemoveHappyPath() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let proj = pmCliBuildRemovalProject(root)

  removeDependency(proj.dir, "doomed") catch e {
    panic("pmclicheck: removeDependency failed: " + e.message())
  }

  let newBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read bit.json after removal: " + e.message())
  }
  assert(newBitJson == pmCliExpectedBitJsonAfterRemoval())

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot read bit.lock after removal: " + e.message())
  }
  assert(len(entries) == 1)
  assert(entries[0].name == "kept")

  removeTree(root, pmCheckTimeoutMs)
}

// The message `removeDependency` failed with, or "" if it succeeded — mirrors
// `arErr` (archivecheck.bit)'s dead-value-in-catch pattern, needed because
// `removeDependency`'s success type is `()`, so its catch block must divert
// (here, `return`) rather than trail off with no value.
fn pmCliTryRemoveMessage(dir: string, name: string): string {
  removeDependency(dir, name) catch e {
    return e.message()
  }
  return ""
}

// `bit remove` on a name absent from bit.json is a clean, named error — never
// a silent no-op — and neither file is touched.
fn checkPmCliRemoveMissing() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e {
    panic("pmclicheck: cannot create scratch dir: " + e.message())
  }
  let proj = pmCliBuildRemovalProject(root)
  let originalBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot read bit.json before removal attempt: " + e.message())
  }

  let message = pmCliTryRemoveMessage(proj.dir, "nonexistent")
  assert(len(message) > 0)
  assert(contains(message, "nonexistent"))

  let unchangedBitJson = readFile(proj.bitJsonPath) catch e {
    panic("pmclicheck: cannot re-read bit.json: " + e.message())
  }
  assert(unchangedBitJson == originalBitJson)

  let entries = readLock(proj.dir + "/bit.lock") catch e {
    panic("pmclicheck: cannot re-read bit.lock: " + e.message())
  }
  assert(len(entries) == 2)

  removeTree(root, pmCheckTimeoutMs)
}

// ---- transitive dependency resolution (#2251) --------------------------
//
// `resolveTransitiveDeps` itself always derives an `https://` (or resolved
// vanity) URL from each requirement spec it discovers — unlike
// `addDependency`, which takes `url`/`fetchUrl` as plain parameters
// specifically so it is testable against a `file://` fixture, a transitive
// dependency has no override channel at all (matching a real `bit add`: only
// the ROOT spec can ever be pointed at `--url`). So there is no in-process,
// network-free way to drive the fetch itself here; what is covered below is
// every non-fetching piece — the extraction/graph-assembly logic that feeds
// `resolvePubGrub` — plus the empty-seed and already-locked no-op paths, which
// never reach a subprocess at all. The fetch-integrated behaviour this
// ticket's acceptance actually asks for (`bit add` on a dependency whose own
// `bit.json` names a further dependency resolves and locks it) is proven by
// #2251's own manual, mutation-tested repro against the real dispatched CLI
// (see the ticket) — #2315 tracks adding a permanent `_tests_/imports/`
// regression test for it, the same way `pmadd_e2e` covers `bit add` itself.

fn checkPmCliPendingVersionTag() {
  let (v1, ok1) = pendingVersionTag("github.com/byteink/textutil@v1.2.3")
  assert(ok1)
  assert(v1.major == 1 && v1.minor == 2 && v1.patch == 3)

  let (v2, ok2) = pendingVersionTag("bitlang.org/pkg/http@v2.0.1")
  assert(ok2)
  assert(v2.major == 2 && v2.minor == 0 && v2.patch == 1)

  // A branch or a bare commit sha is not MVS-ordered (SPEC §17.7 point 2).
  let (_, ok3) = pendingVersionTag("github.com/byteink/textutil@main")
  assert(!ok3)
  let (_, ok4) = pendingVersionTag("github.com/byteink/textutil@a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2")
  assert(!ok4)

  // No '@' at all is malformed, not a crash.
  let (_, ok5) = pendingVersionTag("no-at-sign-here")
  assert(!ok5)

  // The bug `pendingVersionTag` exists to avoid repeating (#2250, FIXED):
  // calling `parseVersionTag` directly on a FULL spec string never matches,
  // even though the ref itself is version-shaped, because a full spec's
  // leading byte is never 'v'. `pmExistingRequirementsFor` (above) used to
  // have exactly this bug (and the now-removed `pmToRequirements` duplicated
  // it); both now go through `pendingVersionTag`/`versionRequirementsOf`
  // instead — `checkPmCliVersionConflict` (above) is the regression test
  // that exercises the fix end to end through `checkVersionConflict`.
  let (_, brokenOk) = parseVersionTag("github.com/byteink/textutil@v1.2.3")
  assert(!brokenOk)

  // #4481: the BARE spelling counts too, and it is the one that matters.
  // SPEC §17.7 writes a version into `bit.json` without a leading `v`, and
  // `bit add` itself writes it that way (`formatConstraint`, pmversion.bit),
  // so `@0.1.0` is the COMMON shape of a published manifest's requirement —
  // yet this returned `(_, false)` for it until #4481, classifying it as a
  // branch name: never arbitrated by PubGrub, and handed to git verbatim as
  // a ref nobody tags.
  let (v6, ok6) = pendingVersionTag("github.com/byteink/textutil@1.2.3")
  assert(ok6)
  assert(v6.major == 1 && v6.minor == 2 && v6.patch == 3)

  let (v7, ok7) = pendingVersionTag("bitlang.org/pkg/web@0.1.0")
  assert(ok7)
  assert(v7.major == 0 && v7.minor == 1 && v7.patch == 0)

  // Both spellings name the SAME version — the property `resolveVersionRefSha`
  // relies on when it tries `v0.1.0` and then `0.1.0` for one requirement.
  let (v8, ok8) = pendingVersionTag("bitlang.org/pkg/web@v0.1.0")
  assert(ok8)
  assert(versionEq(v7, v8))

  // Still NOT a version: a `^`/`~` range names a set rather than a version
  // (#4488 owns resolving one transitively), and a partial version is not a
  // version at all.
  let (_, ok9) = pendingVersionTag("github.com/byteink/textutil@^1.2.3")
  assert(!ok9)
  let (_, ok10) = pendingVersionTag("github.com/byteink/textutil@~1.2.3")
  assert(!ok10)
  let (_, ok11) = pendingVersionTag("github.com/byteink/textutil@1.2")
  assert(!ok11)
  // A branch whose name happens to start with a digit is not a version.
  let (_, ok12) = pendingVersionTag("github.com/byteink/textutil@1.2.3-rc1")
  assert(!ok12)
}

// #4488: `pendingConstraint` is `pendingVersionTag`'s wider sibling — the
// same `@`-split, read through `parseAddVersionRef` (the parser `bit add`
// uses on a ref the user typed) instead of `parseManifestVersionRef`. The
// difference is exactly the range forms, and it is the whole fix: a `^`/`~`
// requirement now reaches PubGrub as the constraint it was written with
// instead of being classified as a branch name and handed to git verbatim.
fn checkPmCliPendingConstraint() {
  let (caret, ok1) = pendingConstraint("github.com/byteink/textutil@^1.2.3")
  assert(ok1)
  assert(caret.op == ConstraintOp.Caret)
  assert(caret.version.major == 1 && caret.version.minor == 2 && caret.version.patch == 3)

  let (tilde, ok2) = pendingConstraint("bitlang.org/pkg/web@~0.1.0")
  assert(ok2)
  assert(tilde.op == ConstraintOp.Tilde)
  assert(tilde.version.major == 0 && tilde.version.minor == 1 && tilde.version.patch == 0)

  // Both exact spellings still read as Exact, unchanged from
  // `pendingVersionTag` above.
  let (exact, ok3) = pendingConstraint("github.com/byteink/textutil@1.2.3")
  assert(ok3)
  assert(exact.op == ConstraintOp.Exact)
  let (prefixed, ok4) = pendingConstraint("github.com/byteink/textutil@v1.2.3")
  assert(ok4)
  assert(prefixed.op == ConstraintOp.Exact)
  assert(versionEq(exact.version, prefixed.version))

  // SPEC §17.7's other two ref forms state no version set and keep the
  // verbatim passthrough — the carve-out #4488 must not have widened.
  let (_, ok5) = pendingConstraint("github.com/byteink/textutil@main")
  assert(!ok5)
  let (_, ok6) = pendingConstraint("github.com/byteink/textutil@a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2")
  assert(!ok6)
  let (_, ok7) = pendingConstraint("no-at-sign-here")
  assert(!ok7)
  // Still not a version set: a partial version, and a branch whose name
  // happens to start with a digit.
  let (_, ok8) = pendingConstraint("github.com/byteink/textutil@1.2")
  assert(!ok8)
  let (_, ok9) = pendingConstraint("github.com/byteink/textutil@1.2.3-rc1")
  assert(!ok9)
}

fn checkPmCliLockHasEntry() {
  let entries = [
    LockEntry{
      name: "a",
      url: "https://example.com/a.git",
      commit: "1111111111111111111111111111111111111111",
      requires: []LockRequire(0),
    },
  ]
  assert(lockHasEntry(entries, "a"))
  assert(!lockHasEntry(entries, "b"))
  assert(!lockHasEntry([]LockEntry(0), "a"))
}

fn checkPmCliEnqueueRequires() {
  let queue = [PendingReq{ name: "seed", spec: "github.com/x/seed@v1.0.0", fromRoot: true }]
  let rs = [
    LockRequire{ name: "b", ref: "github.com/x/b@v1.0.0" },
    LockRequire{ name: "c", ref: "github.com/x/c@main" },
  ]
  let out = enqueueRequires(queue, rs)
  assert(len(out) == 3)
  assert(out[0].name == "seed" && out[0].fromRoot)
  assert(out[1].name == "b" && !out[1].fromRoot && out[1].spec == "github.com/x/b@v1.0.0")
  assert(out[2].name == "c" && !out[2].fromRoot && out[2].spec == "github.com/x/c@main")
}

fn checkPmCliVersionRequirementsOf() {
  let rs = [
    LockRequire{ name: "b", ref: "github.com/x/b@v1.0.0" },
    LockRequire{ name: "c", ref: "github.com/x/c@main" }, // states no version set, dropped
    LockRequire{ name: "d", ref: "bitlang.org/pkg/d@v2.5.1" },
    // #4488: a range states a set, so it is kept — as the op it was written
    // with, never flattened to an Exact pin on its own lower bound.
    LockRequire{ name: "e", ref: "github.com/x/e@^3.1.0" },
  ]
  let out = versionRequirementsOf(rs)
  assert(len(out) == 3)
  assert(out[0].name == "b")
  assert(out[0].constraint.op == ConstraintOp.Exact)
  assert(
      out[0].constraint.version.major == 1 &&
      out[0].constraint.version.minor == 0 &&
      out[0].constraint.version.patch == 0,
  )
  assert(out[1].name == "d")
  assert(out[1].constraint.op == ConstraintOp.Exact)
  assert(
      out[1].constraint.version.major == 2 &&
      out[1].constraint.version.minor == 5 &&
      out[1].constraint.version.patch == 1,
  )
  assert(out[2].name == "e")
  assert(out[2].constraint.op == ConstraintOp.Caret)
  assert(
      out[2].constraint.version.major == 3 &&
      out[2].constraint.version.minor == 1 &&
      out[2].constraint.version.patch == 0,
  )
}

fn checkPmCliFlattenRequires() {
  let entries = [
    LockEntry{
      name: "a", url: "https://example.com/a.git", commit: "1111111111111111111111111111111111111111",
      requires: [LockRequire{ name: "x", ref: "github.com/x/x@v1.0.0" }],
    },
    LockEntry{
      name: "b",
      url: "https://example.com/b.git",
      commit: "2222222222222222222222222222222222222222",
      requires: []LockRequire(0),
    },
    LockEntry{
      name: "c", url: "https://example.com/c.git", commit: "3333333333333333333333333333333333333333",
      requires: [LockRequire{ name: "y", ref: "github.com/y/y@main" }],
    },
  ]
  let flat = flattenRequires(entries)
  assert(len(flat) == 2)
  assert(flat[0].name == "x")
  assert(flat[1].name == "y")
}

// An empty `seed` never enters the walk at all — no fetch, no error,
// `entries` returned unchanged.
fn checkPmCliResolveTransitiveDepsEmptySeed() {
  let entries = [
    LockEntry{
      name: "a",
      url: "https://example.com/a.git",
      commit: "1111111111111111111111111111111111111111",
      requires: []LockRequire(0),
    },
  ]
  let out = resolveTransitiveDeps(
    "unused-cache-root",
    defaultGitBin,
    entries,
    []LockRequire(0),
    pmCheckTimeoutMs,
  ) catch e {
    panic("pmclicheck: resolveTransitiveDeps with an empty seed failed: " + e.message())
  }
  assert(len(out) == 1)
  assert(out[0].name == "a")
  assert(out[0].commit == "1111111111111111111111111111111111111111")
}
