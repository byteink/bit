// In-Bit self-checks for the vanity-import half of
// compiler/pmfetchresolve.bit (#2068) — moved verbatim out of
// compiler/pmfetchresolvecheck.bit (#4322), which was 794 lines against the
// hard 800-line E0200 ceiling.
//
// The `bit-import:` document parse, the request-URL override and the
// transport rules. The fetch/cache/integrity and `listVersions` checks, and
// the git fixture builder every check here uses, stay in
// pmfetchresolvecheck.bit; read its header first.
//
// Same module as pmfetch.bit and pmfetchresolve.bit, so `checkPmfetch()`
// (pmfetchcheck.bit) still reaches these and nothing is imported here — a
// duplicate import is E0042.
// #2068 acceptance: a fixture `bit-import:` document resolves a
// `bitlang.org/pkg/<name>` spec to its git URL, and a document whose
// declared name differs from the requested name fails with a named error.
// Drives `checkAndParseVanityDoc` (the cap-then-parse sequence
// `resolveVanityUrl` runs on a fetched body) directly against fixture
// strings — no network involved, per this ticket's own constraint.
fn checkPmfetchVanityDocResolves() {
  let name = "bitlang.org/pkg/http"
  let doc = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git\n") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a valid bit-import document: " + e.message())
  }
  assert(doc.gitUrl == "https://github.com/byteink/http.git")
  assert(len(doc.dir) == 0)

  // Trailing fields after <gitURL> that do NOT match the recognized "dir
  // <path>" shape are the format's extension point and are ignored.
  let docExtra = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git sha256:deadbeef\n") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a document with trailing fields: " + e.message())
  }
  assert(docExtra.gitUrl == "https://github.com/byteink/http.git")
  assert(len(docExtra.dir) == 0)

  // No trailing newline (a server that doesn't add one) is still exactly one
  // line.
  let docNoNewline = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a document with no trailing newline: " + e.message())
  }
  assert(docNoNewline.gitUrl == "https://github.com/byteink/http.git")
  assert(len(docNoNewline.dir) == 0)

  // #3270: a recognized "dir <path>" field is parsed into VanityDoc.dir, and
  // content after IT is still the (still-ignored) extension point.
  let docDir = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir pkg/http\n") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a document with a dir field: " + e.message())
  }
  assert(docDir.gitUrl == "https://github.com/byteink/http.git")
  assert(docDir.dir == "pkg/http")
  let docDirExtra = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir pkg/http sha256:deadbeef\n") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a dir field followed by further extension content: " + e.message())
  }
  assert(docDirExtra.dir == "pkg/http")

  // A bare "dir" token with nothing after it does not match the recognized
  // two-token shape, so it is silently ignored — the same forward-
  // compatibility rule any other unrecognized trailing content gets.
  let docBareDir = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir\n") catch e {
    panic("pmfetchcheck: checkAndParseVanityDoc rejected a bare trailing 'dir' token: " + e.message())
  }
  assert(len(docBareDir.dir) == 0)

  // A RECOGNIZED dir field with an invalid path is a hard failure: a ".."
  // segment, a leading "/", and an illegal character are each rejected.
  let dirDotDotFailed = false
  let dirDotDot = checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir ../etc\n") catch _ {
    dirDotDotFailed = true
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(dirDotDotFailed)
  assert(len(dirDotDot.gitUrl) == 0)

  let dirAbsFailed = false
  checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir /etc\n") catch _ {
    dirAbsFailed = true
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(dirAbsFailed)

  let dirCharFailed = false
  checkAndParseVanityDoc(name, "bit-import: ${name} git https://github.com/byteink/http.git dir pkg/h@tp\n") catch _ {
    dirCharFailed = true
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(dirCharFailed)

  // The declared name must be byte-for-byte identical to the requested name
  // — SPEC §17.7's whole trust boundary — or resolution fails with a named
  // error identifying both the requested and the claimed name.
  let failed = false
  let errMsg = ""
  let mismatched = checkAndParseVanityDoc(name, "bit-import: bitlang.org/pkg/json git https://github.com/byteink/json.git\n") catch e {
    failed = true
    errMsg = e.message()
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(failed)
  assert(len(mismatched.gitUrl) == 0)
  assert(contains(errMsg, name))
  assert(contains(errMsg, "bitlang.org/pkg/json"))

  // Missing the literal "git" token, or no <gitURL> at all, is a resolution
  // failure.
  let noGitToken = checkAndParseVanityDoc(name, "bit-import: ${name} https://github.com/byteink/http.git\n") catch _ { VanityDoc{ gitUrl: "", dir: "" } }
  assert(len(noGitToken.gitUrl) == 0)
  let noUrl = checkAndParseVanityDoc(name, "bit-import: ${name} git\n") catch _ { VanityDoc{ gitUrl: "", dir: "" } }
  assert(len(noUrl.gitUrl) == 0)
  let notBitImport = checkAndParseVanityDoc(name, "hello world\n") catch _ { VanityDoc{ gitUrl: "", dir: "" } }
  assert(len(notBitImport.gitUrl) == 0)
}

// #2300: `vanityRequestUrl` (the request-URL builder `resolveVanityUrl`
// factors its `BIT_VANITY_ORIGIN` handling through) is exercised directly
// with an explicit override string — no real environment mutation, no
// network — the same way `checkAndParseVanityDoc` above is driven with
// fixture bodies instead of a real fetch.
fn checkPmfetchVanityRequestUrlOverride() {
  let name = "bitlang.org/pkg/http"

  // Unset (empty override): byte-identical to the pre-#2300 behavior.
  assert(vanityRequestUrl(name, "") == "https://" + name)

  // Set: the override's base joined to the name's own path (from its first
  // "/" onward), never the override alone and never the unmodified name.
  assert(vanityRequestUrl(name, "http://127.0.0.1:8099") == "http://127.0.0.1:8099/pkg/http")

  // A different origin (host, port, scheme) is honored verbatim as the base.
  assert(vanityRequestUrl(name, "https://fixture.internal:9443") == "https://fixture.internal:9443/pkg/http")

  // A name with no path segment at all (a bare host) maps to the override
  // verbatim — there is nothing after the host to append.
  assert(vanityRequestUrl("bitlang.org", "http://127.0.0.1:8099") == "http://127.0.0.1:8099")

  // A deeper vanity path carries every segment after the host through.
  assert(vanityRequestUrl("bitlang.org/pkg/http/client", "http://127.0.0.1:8099") == "http://127.0.0.1:8099/pkg/http/client")
}

// #2068 acceptance: both an oversized document and a non-https `<gitURL>`
// scheme are refused, the oversized case BEFORE parsing.
fn checkPmfetchVanityTransportRules() {
  let name = "bitlang.org/pkg/http"

  // A non-https gitURL — plaintext http:// or a file:// URL — is refused.
  let httpDoc = checkAndParseVanityDoc(name, "bit-import: ${name} git http://github.com/byteink/http.git\n") catch _ { VanityDoc{ gitUrl: "", dir: "" } }
  assert(len(httpDoc.gitUrl) == 0)
  let fileDoc = checkAndParseVanityDoc(name, "bit-import: ${name} git file:///etc/passwd\n") catch _ { VanityDoc{ gitUrl: "", dir: "" } }
  assert(len(fileDoc.gitUrl) == 0)

  // An oversized document is refused BEFORE parsing: this body does not even
  // start with the literal "bit-import:" token, so if the cap were checked
  // AFTER (or not checked at all), the failure would instead — or also —
  // name a parse error ("malformed bit-import document...", parseVanityDoc's
  // own text). Asserting the byte-cap message appears and the parse-error
  // text does not proves the cap fired first, not that this body merely also
  // happens to be unparseable.
  let oversized = pmRepeatByte('x', vanityMaxDocBytes + 1)
  let failed = false
  let errMsg = ""
  let doc = checkAndParseVanityDoc(name, oversized) catch e {
    failed = true
    errMsg = e.message()
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(failed)
  assert(len(doc.gitUrl) == 0)
  assert(contains(errMsg, "${vanityMaxDocBytes}"))
  assert(contains(errMsg, "cap"))
  assert(!contains(errMsg, "malformed bit-import document"))

  // The identical malformed shape, one byte UNDER the cap, reaches the
  // parser instead and fails with ITS error — confirming the two checks are
  // genuinely distinct steps, not one check that happens to cover both.
  let underCap = pmRepeatByte('x', vanityMaxDocBytes - 1)
  let failed2 = false
  let errMsg2 = ""
  let doc2 = checkAndParseVanityDoc(name, underCap) catch e {
    failed2 = true
    errMsg2 = e.message()
    VanityDoc{ gitUrl: "", dir: "" }
  }
  assert(failed2)
  assert(len(doc2.gitUrl) == 0)
  assert(contains(errMsg2, "malformed bit-import document"))
}

