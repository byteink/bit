// #2869: split out of resolve.bit to stay under the repo's 800-line E0200
// limit (spec/LINT.md's max-file-lines). `rResolveIdentRef` in resolve.bit
// calls `rFindSiblingDeclaring` on its undefined-name failure path; the rest
// of this file is that lookup's own helpers, with no other caller.

// One directory's sibling-declaration scan (#2917): every unloaded sibling's
// top-level name mapped to the file that declares it, plus whether the
// directory is a coherent mergeable set at all. See `rScanSiblingDir`.
struct SiblingScan {
  declaredBy: map<string, string>,
  clean: bool,
}

// The `.bit` filename of a sibling of `node`'s own file, in the SAME
// directory, that declares `name` as a top-level symbol — or "" when none
// does, INCLUDING when it does but the directory is not actually a coherent
// single module.
//
// A same-OS-directory sibling is not sufficient on its own: `tests/cases/`
// is 400+ independent single-file golden programs that happen to share one
// directory, many declaring their own `fn main`, and a naive "does any
// sibling declare this name" scan turned `check_undefined_name.bit`'s `x`
// (undefined on purpose) into a false "declared in check_module_state_
// nonconst.bit" — a DIFFERENT program that coincidentally also has an `x`.
// Caught by `./make test-golden` going red on exactly that case.
//
// The fix asks the question `bit build .` would actually have to answer:
// would merging every unloaded sibling's top-level names into this module
// introduce ANY duplicate (§17.1 makes that E0042)? If merging the
// directory would already collide on some OTHER name (`run_module_state_
// align.bit` and dozens of other cases all declare `main`), then "build the
// directory" is false advice regardless of whether `name` itself happens to
// be collision-free, so the whole scan is voided rather than only the
// colliding name.
//
// #2917: this is called once per undefined name, and every sibling reference
// in a file linted alone is undefined by construction — worst case N names ×
// every sibling re-read and re-parsed from scratch. The scan's result
// depends only on `dir` and `r` (the loaded-file set, the module's own
// declared names), both fixed for the Resolver's lifetime, so it is memoized
// per directory in `r.siblingScans` and computed at most once.
//
// #2919: that "once" was still once PER FILE, because `bit lint`'s per-file
// callers each build a fresh, throwaway Resolver — 379 rescans of
// `compiler/`+`runtime/`+`stdlib/` across one gate run. `rResolveIdentRef`
// (resolve.bit) does not even call this function when
// `r.siblingScanEnabled` is `false`, which every one of those callers now
// sets: their diagnostics sink is never read, so the hint this computes was
// always discarded there.
fn rFindSiblingDeclaring(r: Resolver, node: int, name: string): string {
  let dir = pathDir(filePath(r.diags.sm, rSpan(r, node).file))
  let scan = rSiblingScanFor(r, dir)
  if (!scan.clean) {
    return ""
  }
  let (owner, found) = scan.declaredBy[name]
  if (found) {
    return owner
  }
  return ""
}

// The cached `SiblingScan` for `dir`, computing and storing it on first use.
fn rSiblingScanFor(r: Resolver, dir: string): SiblingScan {
  let (cached, ok) = r.siblingScans[dir]
  if (ok) {
    return cached
  }
  let scan = rScanSiblingDir(r, dir)
  r.siblingScans[dir] = scan
  return scan
}

// The full directory scan `rFindSiblingDeclaring` used to redo on every call:
// unchanged logic, just factored out so it runs once per directory.
fn rScanSiblingDir(r: Resolver, dir: string): SiblingScan {
  let loaded = map<string, bool>{}
  for f of r.files {
    loaded[pathBase(filePath(r.diags.sm, f))] = true
  }
  let declaredBy = map<string, string>{}
  let clean = true
  for candidate of listBitFiles(dir) {
    let (_, alreadyLoaded) = loaded[candidate]
    if (alreadyLoaded) {
      continue // already part of this module's own tree — a real miss, not this bug
    }
    let text = readFile(dir + "/" + candidate) catch e {
      continue
    }
    for declName of topLevelNames(parseSource(text), text) {
      if (rScopeGet(r, r.moduleScope, declName) >= 0) {
        clean = false // collides with a name this module already declares
        continue
      }
      let (firstFile, seen) = declaredBy[declName]
      if (seen && firstFile != candidate) {
        clean = false // two siblings both declare it — not a mergeable set
      } else {
        declaredBy[declName] = candidate
      }
    }
  }
  return SiblingScan{ declaredBy: declaredBy, clean: clean }
}

// Every top-level name `tree` declares that would join the flat module
// namespace (§9) if this file were merged into the module — mirrors which
// `rCollectTopDecl` arms call `rInsertModuleSymbol`/`rDeclarePattern`, but
// only collects names, so it needs no Resolver and creates no symbols.
fn topLevelNames(tree: Tree, source: string): []string {
  let out = []string(0)
  for d of kidsOf(tree, tree.root) {
    if (d != 0) {
      out = appendTopDeclNames(tree, source, d, out)
    }
  }
  return out
}

fn appendTopDeclNames(tree: Tree, source: string, idx: int, out: []string): []string {
  let tag = getNode(tree, idx).tag
  if (tag == Tag.Export) {
    return appendTopDeclNames(tree, source, kidsOf(tree, idx)[0], out)
  }
  if (tag == Tag.LetDecl || tag == Tag.ConstDecl) {
    for b of kidsOf(tree, idx) {
      out = appendPatternNames(tree, source, kidsOf(tree, b)[0], out)
    }
    return out
  }
  if (tag == Tag.TypeAlias || tag == Tag.StructDecl || tag == Tag.InterfaceDecl || tag == Tag.EnumDecl) {
    // bit:lint allow E0214 -- no caller reads the pre-call out after the call: :115 reassigns it, :124 tail-forwards it, neither keeps a second live reference
    return append(out, nodeText(tree, source, kidsOf(tree, idx)[0]))
  }
  if (tag == Tag.FuncDecl) {
    let k = kidsOf(tree, idx) // [recv, name, generics, params, result, body]
    if (k[0] == 0) { // a method never joins the flat namespace
      // bit:lint allow E0214 -- same out, same single-owner accumulator threaded from topLevelNames; no caller keeps a pre-call copy
      return append(out, nodeText(tree, source, k[1]))
    }
    return out
  }
  if (tag == Tag.ExternFnDecl) {
    // bit:lint allow E0214 -- same out, same single-owner accumulator threaded from topLevelNames; no caller keeps a pre-call copy
    return append(out, nodeText(tree, source, kidsOf(tree, idx)[0]))
  }
  return out
}

fn appendPatternNames(tree: Tree, source: string, patIdx: int, out: []string): []string {
  if (getNode(tree, patIdx).tag == Tag.TuplePat) {
    for s of kidsOf(tree, patIdx) {
      out = appendPatternNames(tree, source, s, out)
    }
    return out
  }
  // bit:lint allow E0214 -- out is seeded fresh by topLevelNames and every caller reassigns it from the return value; no caller keeps a pre-call copy
  return append(out, nodeText(tree, source, patIdx))
}

fn nodeText(tree: Tree, source: string, node: int): string {
  let sp = getNode(tree, node).span
  return source[sp.start:sp.end]
}
