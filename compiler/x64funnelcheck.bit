// #8506: exact selection boundaries and destructive-operand alias controls.
fn xFunnelCheckCtx(amount: int): XCtx {
  let cx = xTestCtx()
  let ty = primType(cx.ctx, 7)
  let leftCount = mkInstr(Op.ConstInt, ty)
  leftCount.ival = 64 - amount
  let left = mkInstr(Op.Shl, ty)
  left.lhs = 0
  left.rhs = 2
  let rightCount = mkInstr(Op.ConstInt, ty)
  rightCount.ival = amount
  let right = mkInstr(Op.LShr, ty)
  right.lhs = 1
  right.rhs = 4
  let root = mkInstr(Op.BOr, ty)
  root.lhs = 3
  root.rhs = 5
  cx.f = irFuncOf(
    "funnel", []int(0), ty,
    [IrBlock{ instsStart = 0, paramCount = 2, instsLen = 7 }],
    [
      mkInstr(Op.BlockParam, ty),
      mkInstr(Op.BlockParam, ty),
      leftCount,
      left,
      rightCount,
      right,
      root,
    ],
  )
  cx.skipConst = [false, false, true, false, true, false, false]
  return cx
}

fn checkX64Funnels() {
  for n of [1, 12, 31, 32, 52, 63] {
    let cx = xFunnelCheckCtx(n)
    let folds = xComputeFunnels(cx)
    assert(folds[3] == 6 && folds[5] == 6 && folds[6] == 6, "funnel selection")
    cx.f.instrs[6].lhs = 5
    cx.f.instrs[6].rhs = 3
    assert(xComputeFunnels(cx)[3] == 6, "funnel reversed OR")
  }
  for n of [0, 64] {
    assert(xComputeFunnels(xFunnelCheckCtx(n))[3] == -1, "funnel endpoint rejection")
  }
  checkX64FunnelRejects()
  checkX64FunnelAliases()
}

fn checkX64FunnelRejects() {
  let emitted = xFunnelCheckCtx(52)
  emitted.skipConst[4] = false
  assert(xComputeFunnels(emitted)[3] == -1, "funnel emitted-gap rejection")
  let clear = xFunnelCheckCtx(52)
  clear.alloc.regClears = [0, 0, 0, 0, 1, 0, 0]
  assert(xComputeFunnels(clear)[3] == -1, "funnel register-clear rejection")
  let variable = xFunnelCheckCtx(52)
  variable.f.instrs[4].op = Op.BlockParam
  assert(xComputeFunnels(variable)[3] == -1, "funnel variable rejection")
  let arithmetic = xFunnelCheckCtx(52)
  arithmetic.f.instrs[5].op = Op.AShr
  assert(xComputeFunnels(arithmetic)[3] == -1, "funnel arithmetic rejection")
  let narrow = xFunnelCheckCtx(52)
  narrow.f.instrs[6].ty = primType(narrow.ctx, 6)
  assert(xComputeFunnels(narrow)[3] == -1, "funnel narrow rejection")
  let extra = xFunnelCheckCtx(52)
  let add = mkInstr(Op.Add, primType(extra.ctx, 7))
  add.lhs = 3
  add.rhs = 0
  extra.f.instrs = append(extra.f.instrs, add)
  assert(xComputeFunnels(extra)[3] == -1, "funnel multi-use rejection")
  let cross = xFunnelCheckCtx(52)
  cross.f.blocks = [
    IrBlock{ instsStart = 0, paramCount = 2, instsLen = 5 },
    IrBlock{ instsStart = 5, paramCount = 0, instsLen = 2 },
  ]
  assert(xComputeFunnels(cross)[3] == -1, "funnel cross-block rejection")
}

fn checkX64FunnelAliases() {
  let same = xTestCtx()
  xEmitFunnelValue(same, 0, 0, 0, 52)
  assert(xHex(same.buf) == "480facc034", "funnel same-source encoding")
  let high = xTestCtx()
  high.alloc.locations[1] = RegLoc{ isSpill = false, index = 1 }
  xEmitFunnelValue(high, 0, 1, 0, 52)
  let want = newX64Buf()
  xMovRR(want, xScratch1(), XReg64.Rbx)
  xShrdImm(want, xScratch1(), XReg64.Rax, 52)
  xMovRR(want, XReg64.Rax, xScratch1())
  assert(xHex(high.buf) == xHex(want), "funnel high-source alias")
  let spill = xTestCtx()
  xEmitFunnelValue(spill, 1, 1, 0, 1)
  assert(len(spill.buf.code) > 5, "funnel spilled input/output")
  let extended = newX64Buf()
  xShrdImm(extended, XReg64.R12, XReg64.R13, 63)
  assert(xHex(extended) == "4d0facec3f", "funnel extended encoding")
}
