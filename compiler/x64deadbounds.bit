// #8400: the same private dead-block proof governs allocation and emission.
// Shared panic blocks retain their live predecessor and their safepoints.

fn xRedundantBoundsBranch(f: IrFunc): []bool {
  let redundant = computeRedundantBoundsBranch(f)
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let i = b.instsStart + b.instsLen - 1
    // Dropping an ELSE poll would desynchronize the retained stack maps.
    if (b.instsLen > 0 && redundant[i] && emitsBackEdgePoll(f, bi, f.instrs[i].ival2)) {
      redundant[i] = false
    }
    bi = bi + 1
  }
  return redundant
}

fn xWithDeadBounds(f: IrFunc, regs: XFrameRegs): XFrameRegs {
  regs.redundantBr = xRedundantBoundsBranch(f)
  regs.deadBlock = computeDeadBoundsBlocks(f, regs.redundantBr)
  return regs
}

fn xLiveBoundsSafepoints(f: IrFunc, points: []int, deadBlock: []bool): []int {
  return filterDeadSafepoints(points, computeDeadPositions(f, deadBlock))
}

fn xSkipDeadBounds(cx: XCtx) {
  let bi = 0
  while (bi < len(cx.deadBlock)) {
    if (cx.deadBlock[bi]) {
      cx.bypassed[bi] = true
    }
    bi = bi + 1
  }
}
