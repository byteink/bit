// In-Bit self-checks for bit.lock read/write (#1732). Split out as its own
// sibling of pmlock.bit (#1503 convention); `selfcheck()` calls checkPmLock()
// directly. `remove` comes from pmfetch.bit's "std/fs" import — selfhost is a
// single module, so siblings share one namespace and a second import of the
// same name collides (E0042).

// Fails loudly (rather than silently swallowing) if `writeLock`/`readLock`
// returns an error — a lock-file round trip in this test has no legitimate
// failure path, unlike the missing-file case readLock itself handles.
fn pmlockCheckWrite(path: string, entries: []LockEntry) {
  writeLock(path, entries) catch e {
    println("pmlock check: writeLock failed: ${e.message()}")
    assert(false)
  }
}

fn pmlockCheckRead(path: string): []LockEntry {
  return readLock(path) catch e {
    println("pmlock check: readLock failed: ${e.message()}")
    assert(false)
    []LockEntry(0)
  }
}

// Round-trips a bit.lock fixture through both the pure JsonDoc encode/decode
// (lockDocOf/lockEntriesOfObj) and the real readLock/writeLock file path,
// asserting the canonical bytes spec §17.7 pins: object keys sorted by
// dependency name, `url`/`commit`/`requires` in that order, `requires` a
// name->ref object verbatim from the dependency's own bit.json.
fn checkPmLock() {
  // Deliberately unsorted input: writeLock must sort ("http2util" < "quicwire").
  let fixture = [
    LockEntry{ name: "quicwire", url: "https://github.com/byteink/quicwire.git",
      commit: "9f8e7d6c5b4a3928170695e4d3c2b1a0f9e8d7c",
      requires: [LockRequire{ name: "streambuf",
        ref: "github.com/byteink/streambuf@v0.9.0" }] },
    LockEntry{ name: "http2util", url: "https://github.com/byteink/http2util.git",
      commit: "1111111111111111111111111111111111111111",
      requires: []LockRequire(0) },
  ]
  let want = "{\"http2util\":{\"url\":\"https://github.com/byteink/http2util.git\"," +
    "\"commit\":\"1111111111111111111111111111111111111111\",\"requires\":{}}," +
    "\"quicwire\":{\"url\":\"https://github.com/byteink/quicwire.git\"," +
    "\"commit\":\"9f8e7d6c5b4a3928170695e4d3c2b1a0f9e8d7c\"," +
    "\"requires\":{\"streambuf\":\"github.com/byteink/streambuf@v0.9.0\"}}}"

  // ---- pure encode/decode, no filesystem -----------------------------------
  let json1 = jsonStringify(lockDocOf(lockSortEntries(fixture)))
  assert(json1 == want)

  let d = jsonParse(json1)
  assert(d.ok)
  let decoded = lockEntriesOfObj(d, d.root)
  assert(len(decoded) == 2)
  assert(decoded[0].name == "http2util")
  assert(decoded[0].url == "https://github.com/byteink/http2util.git")
  assert(decoded[0].commit == "1111111111111111111111111111111111111111")
  assert(len(decoded[0].requires) == 0)
  assert(decoded[1].name == "quicwire")
  assert(decoded[1].commit == "9f8e7d6c5b4a3928170695e4d3c2b1a0f9e8d7c")
  assert(len(decoded[1].requires) == 1)
  assert(decoded[1].requires[0].name == "streambuf")
  assert(decoded[1].requires[0].ref == "github.com/byteink/streambuf@v0.9.0")
  // Re-encoding the decoded tree reproduces the identical bytes.
  assert(jsonStringify(lockDocOf(decoded)) == want)

  // ---- readLock/writeLock over a real file ---------------------------------
  //
  // UNIQUE PER PROCESS (#1828). These were fixed paths, so two concurrent
  // `bit selfcheck` runs wrote, read and removed the same two files and raced —
  // latent while only `./make test-selfcheck` ran selfcheck, and immediately
  // real the moment a second runner existed (adding one made `./make test`
  // fail while `test-version` passed standalone). Two agents on one checkout is
  // this repo's normal workflow, so a shared path here is a bug waiting.
  //
  // `scratchNonce()` is this repo's existing answer to exactly this problem —
  // `build.bit` already names its `bit run`/`bit test` scratch dirs with it — so
  // use it rather than inventing a second scheme. It is 8 bytes of
  // `cryptoRandomBytes`, which beats a timestamp: two processes CAN read the same
  // nanosecond, they cannot draw the same 64-bit nonce. No new runtime surface
  // either way (there is no pid primitive; `stdlib/os` exports argc, arg, args,
  // env, envOr, selfExe, exit and nothing more).
  //
  // No stale-fixture removal any more: a unique name has nothing stale to clear,
  // which is all those "no stale fixture to remove" lines ever did.
  let nonce = scratchNonce()
  let path = "/tmp/bit-pmlock-check-${nonce}.lock"

  pmlockCheckWrite(path, fixture)
  assert((readFile(path) catch "") == want)

  let readBack = pmlockCheckRead(path)
  assert(len(readBack) == 2)
  assert(readBack[0].name == "http2util")
  assert(readBack[1].name == "quicwire")
  assert(len(readBack[1].requires) == 1)
  assert(readBack[1].requires[0].ref == "github.com/byteink/streambuf@v0.9.0")

  // Re-writing what was just read back is byte-identical: a stable sort order
  // is what makes bit.lock diff cleanly across repeated resolutions.
  pmlockCheckWrite(path, readBack)
  assert((readFile(path) catch "") == want)

  remove(path) catch println("pmlock check: cleanup failed for ${path}")

  // ---- a missing bit.lock is an empty list, not an error -------------------
  //
  // Unique too, and for a second reason beyond the race: this path must NOT exist.
  // A fixed name meant a leftover file from any earlier crashed run turned this
  // assertion into a silent pass of the wrong thing, which is why it needed a
  // `remove` first. A per-process name is absent by construction.
  let missing = "/tmp/bit-pmlock-check-missing-${nonce}.lock"
  assert(len(pmlockCheckRead(missing)) == 0)
}

// `entries[name].version`, or panics naming `name` — a missing name here is
// this test's own bug, not a data case worth an `Option`.
fn pmLockEntryVersion(entries: []LockEntry, name: string): string {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return entries[i].version
    }
    i = i + 1
  }
  panic("pmlock check: no entry named '${name}'")
  return "<unreachable>"
}

// #2856: the resolved `version` field — present when non-empty, omitted
// entirely when "" (mirroring `checkPmLock`'s own vanity-omission proof,
// above), round-trips through both the pure encode/decode layer and a real
// file, AND an entry with no `version` KEY AT ALL — the shape every lock
// file on disk today already has — reads back as "" with every other field
// intact, never an error and never a forced re-resolve.
fn checkPmLockVersionField() {
  // ---- pure encode/decode: present vs. omitted-when-empty -----------------
  let fixture = [
    LockEntry{ name: "hasversion", url: "https://github.com/byteink/hasversion.git",
      commit: "3333333333333333333333333333333333333333",
      version: "1.7.0", requires: []LockRequire(0) },
    LockEntry{ name: "noversion", url: "https://github.com/byteink/noversion.git",
      commit: "4444444444444444444444444444444444444444",
      requires: []LockRequire(0) },
  ]
  let want = "{\"hasversion\":{\"url\":\"https://github.com/byteink/hasversion.git\"," +
    "\"commit\":\"3333333333333333333333333333333333333333\"," +
    "\"version\":\"1.7.0\",\"requires\":{}}," +
    "\"noversion\":{\"url\":\"https://github.com/byteink/noversion.git\"," +
    "\"commit\":\"4444444444444444444444444444444444444444\",\"requires\":{}}}"
  let json1 = jsonStringify(lockDocOf(lockSortEntries(fixture)))
  assert(json1 == want)

  let d = jsonParse(json1)
  assert(d.ok)
  let decoded = lockEntriesOfObj(d, d.root)
  assert(pmLockEntryVersion(decoded, "hasversion") == "1.7.0")
  assert(pmLockEntryVersion(decoded, "noversion") == "")

  // ---- real-file round trip via writeLock/readLock -------------------------
  let nonce = scratchNonce()
  let path = "/tmp/bit-pmlock-version-check-${nonce}.lock"
  pmlockCheckWrite(path, fixture)
  let readBack = pmlockCheckRead(path)
  assert(len(readBack) == 2)
  assert(pmLockEntryVersion(readBack, "hasversion") == "1.7.0")
  assert(pmLockEntryVersion(readBack, "noversion") == "")
  remove(path) catch println("pmlock check: cleanup failed for ${path}")

  // ---- backward compatibility: a lock entry with NO "version" key at all
  // (exactly what every lock file on disk predates this ticket looks like)
  // reads back as "", with `url`/`commit`/`requires` unaffected.
  let oldLockJson = "{\"legacy\":{\"url\":\"https://github.com/byteink/legacy.git\"," +
    "\"commit\":\"5555555555555555555555555555555555555555\"," +
    "\"requires\":{\"streambuf\":\"github.com/byteink/streambuf@v0.9.0\"}}}"
  let oldPath = "/tmp/bit-pmlock-oldformat-check-${nonce}.lock"
  writeFile(oldPath, oldLockJson) catch e {
    panic("pmlock check: cannot write old-format fixture: " + e.message())
  }
  let oldEntries = pmlockCheckRead(oldPath)
  assert(len(oldEntries) == 1)
  assert(oldEntries[0].name == "legacy")
  assert(oldEntries[0].url == "https://github.com/byteink/legacy.git")
  assert(oldEntries[0].commit == "5555555555555555555555555555555555555555")
  assert(oldEntries[0].version == "")
  assert(len(oldEntries[0].requires) == 1)
  assert(oldEntries[0].requires[0].name == "streambuf")
  assert(oldEntries[0].requires[0].ref == "github.com/byteink/streambuf@v0.9.0")

  // Re-writing an entry read from an old-format file keeps the key omitted
  // — nothing was resolved, so nothing is fabricated. The next real
  // resolution (`upsertLockEntry`, pmcli.bit) is what fills it in, not this
  // read/write round trip.
  pmlockCheckWrite(oldPath, oldEntries)
  assert((readFile(oldPath) catch "") == oldLockJson)

  remove(oldPath) catch println("pmlock check: cleanup failed for ${oldPath}")
}
