// Self-host `bit fmt` (#1345): the node dispatch for leaves, declarations, and
// statements. Split out of fmt.bit to
// keep each file within the size limit; a sibling .bit file is the same module.
// Tags not handled here fall through to fmtDispatchExpr (fmtexpr.bit), which
// covers expressions and types. Together the two cover every Tag.

// The per-node printer. Mirrors `dispatch` switch as an if-chain
// over the tag, exactly as ast.bit's tagName does.
fn fmtDispatch(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.None) {
    return
  }
  // Leaves render as their source text; str_part likewise (its quotes are the
  // enclosing str_interp's responsibility).
  if (isLeafTag(n.tag) || n.tag == Tag.StrPart) {
    fmtRaw(p, p.source[n.span.start:n.span.end])
    return
  }

  if (n.tag == Tag.Program) {
    fmtPrintSeq(p, kidsOf(p.tree, idx), true)
    fmtGap(p, len(p.source), true)
    return
  }

  if (n.tag == Tag.ImportDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "import ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " from ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ImportNs) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ImportStar) {
    fmtRaw(p, "* as ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ImportGroup) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.ImportItem) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, " as ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.LetDecl) {
    // §11.11 storage class rides in `n.main` (1 = `@threadlocal`), not as a
    // child — mirror dumpNode's condition (ast.bit) or the attribute is
    // silently dropped, turning per-thread storage into shared storage.
    if (n.main == 1) {
      fmtRaw(p, "@threadlocal ")
    }
    fmtRaw(p, "let ")
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.ConstDecl) {
    fmtRaw(p, "const ")
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.Binding) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    if (k[2] != 0) {
      fmtRaw(p, " = ")
      fmtPrintNode(p, k[2])
    }
    return
  }
  if (n.tag == Tag.TuplePat) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.FieldPat) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }

  if (n.tag == Tag.TypeAlias) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "type ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[2])
    return
  }

  if (n.tag == Tag.FuncDecl) {
    let k = kidsOf(p.tree, idx)
    if (len(k) > 6 && k[6] != 0) {
      fmtPrintNode(p, k[6])
    }
    fmtRaw(p, "fn ")
    // k[2] is the merged (receiver + own) generics kid — see
    // fmtSplitGenerics (fmt.bit, #3767). The receiver-derived prefix reprints
    // on the receiver's own type below (`pendingReceiverGenerics`); only the
    // method's own trailing suffix belongs after the name.
    let generics = fmtSplitGenerics(p, k[2], k[1])
    if (k[0] != 0) {
      fmtRaw(p, "(")
      p.pendingReceiverGenerics = generics.prefix
      fmtPrintNode(p, k[0])
      fmtRaw(p, ") ")
    }
    fmtPrintNode(p, k[1])
    fmtPrintGenericsList(p, generics.own, k[2])
    // The return type is rendered once, ahead of the params list, so its exact
    // width folds into the params' own wrap decision (`: ReturnType {` sit on
    // the params' line).
    let hasRet = k[4] != 0
    let retText = ""
    if (hasRet) {
      retText = fmtRenderFlat(p, k[4])
    }
    if (hasRet) {
      p.nextListTail = len(retText) + 2 + 2
    } else {
      p.nextListTail = 2
    }
    fmtPrintNode(p, k[3])
    if (hasRet) {
      fmtRaw(p, ": ")
      fmtRaw(p, retText)
    }
    fmtRaw(p, " ")
    fmtPrintBodyBlock(p, k[5], true)
    return
  }
  if (n.tag == Tag.TestDecl) {
    // `test "name" { ... }` (SPEC §19, epic #4126, #4127): the name renders
    // as any other string-literal leaf; the body is an ordinary block, same
    // as a FuncDecl's just above.
    let k = kidsOf(p.tree, idx) // [name, body]
    fmtRaw(p, "test ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " ")
    fmtPrintBodyBlock(p, k[1], true)
    return
  }
  if (n.tag == Tag.ExternFnDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "extern fn ")
    fmtPrintNode(p, k[0])
    let hasRet = k[2] != 0
    let retText = ""
    if (hasRet) {
      retText = fmtRenderFlat(p, k[2])
    }
    if (hasRet) {
      p.nextListTail = len(retText) + 2
    } else {
      p.nextListTail = 0
    }
    fmtPrintNode(p, k[1])
    if (hasRet) {
      fmtRaw(p, ": ")
      fmtRaw(p, retText)
    }
    return
  }
  if (n.tag == Tag.Receiver) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    // Reattach the receiver-derived generics an explicit clause's type lost
    // when parseFuncDecl folded them into the func_decl's merged generics kid
    // instead of the receiver's own type node (#3767) — e.g. `Stack<T>`'s
    // `<T>` in `fn (s: Stack<T>) push(...)`. Set by the Tag.FuncDecl case
    // just above this call; a plain receiver with no generics never sets it.
    if (len(p.pendingReceiverGenerics) > 0) {
      let items = p.pendingReceiverGenerics
      let lastEnd = getNode(p.tree, items[len(items) - 1]).span.end
      fmtPrintCommaList(p, items, "<", ">", lastEnd)
      p.pendingReceiverGenerics = []int(0)
    }
    return
  }
  if (n.tag == Tag.Params) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.Param) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ParamRest) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "...")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }

  // Class/interface declarations (StructDecl, FieldList, Field,
  // InterfaceDecl, MethodSigList): fmtclass.bit, a sibling split out for the
  // same 800-line-ceiling reason fmttrait.bit was (#4066).
  if (fmtDispatchClass(p, idx, n)) {
    return
  }
  // Traits (SPEC §10.7, #3369): rendering lives in fmttrait.bit, a sibling
  // split out because both this file and fmt.bit already sit near the
  // repo's 800-line ceiling.
  if (n.tag == Tag.TraitDecl) {
    fmtPrintTraitDecl(p, idx)
    return
  }
  if (n.tag == Tag.TraitMethod) {
    fmtPrintTraitMethod(p, idx)
    return
  }
  if (n.tag == Tag.UseStmt) {
    fmtPrintUseStmt(p, idx)
    return
  }
  if (n.tag == Tag.MethodSig) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtPrintNode(p, k[1])
    if (k[2] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[2])
    }
    return
  }
  if (n.tag == Tag.EnumDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "enum ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.VariantList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.EnumVariant) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, "(")
      fmtPrintFlatList(p, kidsOf(p.tree, k[1]), ", ")
      fmtRaw(p, ")")
    }
    return
  }
  if (n.tag == Tag.GenericParams) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "<", ">", n.span.end)
    return
  }
  if (n.tag == Tag.GenericParam) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    return
  }
  if (n.tag == Tag.Constraint) {
    fmtPrintFlatList(p, kidsOf(p.tree, idx), " & ")
    return
  }
  if (n.tag == Tag.Export) {
    fmtRaw(p, "export ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.AttrList) {
    let k = kidsOf(p.tree, idx)
    let i = 0
    while (i < len(k)) {
      fmtPrintNode(p, k[i])
      fmtRaw(p, " ")
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.Attr) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "@")
    fmtPrintNode(p, k[0])
    // The argument child is elided when absent, so a bare attribute prints
    // exactly as it did before arguments existed.
    if (len(k) > 1) {
      fmtRaw(p, "(")
      fmtPrintNode(p, k[1])
      fmtRaw(p, ")")
    }
    return
  }
  if (n.tag == Tag.Fallible) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, "!")
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.Block) {
    fmtPrintBlock(p, idx)
    return
  }
  if (n.tag == Tag.StmtList) {
    fmtPrintSeq(p, kidsOf(p.tree, idx), true)
    return
  }

  if (n.tag == Tag.Assign) {
    let k = kidsOf(p.tree, idx)
    fmtPrintFlatList(p, kidsOf(p.tree, k[0]), ", ")
    fmtRaw(p, " ")
    fmtRaw(p, opSymbol(n.main))
    fmtRaw(p, " ")
    fmtPrintFlatList(p, kidsOf(p.tree, k[1]), ", ")
    return
  }
  if (n.tag == Tag.LhsList || n.tag == Tag.ExprList) {
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.IncStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "++")
    return
  }
  if (n.tag == Tag.DecStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "--")
    return
  }
  if (n.tag == Tag.ExprStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.SendStmt) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " <- ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "return")
    if (len(k) > 0) {
      fmtRaw(p, " ")
      fmtPrintFlatList(p, k, ", ")
    }
    return
  }
  if (n.tag == Tag.FailStmt) {
    fmtRaw(p, "fail ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.BreakStmt) {
    fmtRaw(p, "break")
    return
  }
  if (n.tag == Tag.ContinueStmt) {
    fmtRaw(p, "continue")
    return
  }
  if (n.tag == Tag.SpawnStmt) {
    fmtRaw(p, "spawn ")
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    fmtRaw(p, "defer ")
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.AsmStmt) {
    fmtAsmStmt(p, idx, n)
    return
  }
  if (n.tag == Tag.AsmCode || n.tag == Tag.AsmClobber) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.AsmResult) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "result arm64 ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " x64 ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " : ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.AsmInput) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "input arm64 ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " x64 ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[2])
    return
  }

  if (n.tag == Tag.IfStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "if (")
    // `) {` (#2889): a `Binary` condition's own width check must see the
    // fixed text that follows it on the same line, or a condition that
    // fits without it can still land one line over fmtMaxWidth. #2898: a
    // `!(...)`-wrapped chain (any depth) needs the wrap paren's own width
    // folded in too -- see fmtCondBinaryExtra.
    let ifBinExtra = fmtCondBinaryExtra(p, k[0])
    if (ifBinExtra >= 0) {
      p.nextListTail = 3 + ifBinExtra
    }
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[1])
    if (k[2] != 0) {
      fmtRaw(p, " else ")
      if (getNode(p.tree, k[2]).tag == Tag.IfStmt) {
        fmtPrintNode(p, k[2])
      } else {
        fmtPrintBlock(p, k[2])
      }
    }
    return
  }
  if (n.tag == Tag.WhileStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "while (")
    // Same `) {` tail as `IfStmt`, see #2889 and #2898.
    let whileBinExtra = fmtCondBinaryExtra(p, k[0])
    if (whileBinExtra >= 0) {
      p.nextListTail = 3 + whileBinExtra
    }
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[1])
    return
  }
  if (n.tag == Tag.ForC) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for (")
    if (k[0] != 0) {
      fmtPrintNode(p, k[0])
    }
    fmtRaw(p, "; ")
    if (k[1] != 0) {
      // `"; "` tail (2 chars), not `) {` -- ForC's condition clause is
      // followed by the second semicolon, not the block opener. Same
      // Tag.Unary-wrapper threading as IfStmt/WhileStmt (#2889/#2898/#2904).
      let forBinExtra = fmtCondBinaryExtra(p, k[1])
      if (forBinExtra >= 0) {
        p.nextListTail = 2 + forBinExtra
      }
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, "; ")
    if (k[2] != 0) {
      fmtPrintNode(p, k[2])
    }
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[3])
    return
  }
  if (n.tag == Tag.ForOf) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " of ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ForIn) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " in ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ForInf) {
    fmtRaw(p, "for ")
    fmtPrintBlock(p, kidsOf(p.tree, idx)[0])
    return
  }

  if (n.tag == Tag.SwitchStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "switch ")
    if (k[0] != 0) {
      fmtRaw(p, "(")
      // Same `) {` tail as IfStmt/WhileStmt, see #2889 and #2898.
      let switchBinExtra = fmtCondBinaryExtra(p, k[0])
      if (switchBinExtra >= 0) {
        p.nextListTail = 3 + switchBinExtra
      }
      fmtPrintNode(p, k[0])
      fmtRaw(p, ") ")
    }
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.CaseList) {
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.SwitchCase) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "case ")
    fmtPrintFlatList(p, kidsOf(p.tree, k[0]), ", ")
    fmtRaw(p, ":")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[1]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.SwitchDefault) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "default:")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[0]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.MatchStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "match (")
    // Same `) {` tail as IfStmt/WhileStmt, see #2889 and #2898.
    let matchBinExtra = fmtCondBinaryExtra(p, k[0])
    if (matchBinExtra >= 0) {
      p.nextListTail = 3 + matchBinExtra
    }
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ArmList) {
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.MatchArm) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintBodyBlock(p, k[1], false)
    return
  }
  if (n.tag == Tag.VariantPat) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintCommaList(p, kidsOf(p.tree, k[1]), "(", ")", n.span.end)
    }
    return
  }

  if (n.tag == Tag.SelectStmt) {
    fmtRaw(p, "select ")
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.CommCase) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "case ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ":")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[1]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.CommDefault) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "default:")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[0]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.RecvBind) {
    let k = kidsOf(p.tree, idx)
    if (k[0] != 0) {
      fmtPrintNode(p, k[0])
      fmtRaw(p, " = <- ")
      fmtPrintNode(p, k[1])
    } else {
      fmtRaw(p, "<- ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  fmtDispatchExpr(p, idx, n)
}

