// Self-host `bit fmt` (#1345): the node dispatch for leaves, declarations, and
// statements. Split out of fmt.bit to
// keep each file within the size limit; a sibling .bit file is the same module.
// Tags not handled here fall through to fmtDispatchExpr (fmtexpr.bit), which
// covers expressions and types. Together the two cover every Tag.

// The per-node printer. Mirrors `dispatch` switch as an if-chain
// over the tag, exactly as ast.bit's tagName does.
fn fmtDispatch(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.None) {
    return
  }
  // Leaves render as their source text; str_part likewise (its quotes are the
  // enclosing str_interp's responsibility).
  if (isLeafTag(n.tag) || n.tag == Tag.StrPart) {
    fmtRaw(p, p.source[n.span.start:n.span.end])
    return
  }

  if (n.tag == Tag.Program) {
    fmtPrintSeq(p, kidsOf(p.tree, idx), true)
    fmtGap(p, len(p.source), true)
    return
  }

  if (n.tag == Tag.ImportDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "import ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " from ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ImportNs) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ImportStar) {
    fmtRaw(p, "* as ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.ImportGroup) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.ImportItem) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, " as ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.LetDecl) {
    fmtRaw(p, "let ")
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.ConstDecl) {
    fmtRaw(p, "const ")
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.Binding) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    if (k[2] != 0) {
      fmtRaw(p, " = ")
      fmtPrintNode(p, k[2])
    }
    return
  }
  if (n.tag == Tag.TuplePat) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }

  if (n.tag == Tag.TypeAlias) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "type ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[2])
    return
  }

  if (n.tag == Tag.FuncDecl) {
    let k = kidsOf(p.tree, idx)
    if (len(k) > 6 && k[6] != 0) {
      fmtPrintNode(p, k[6])
    }
    fmtRaw(p, "fn ")
    if (k[0] != 0) {
      fmtRaw(p, "(")
      fmtPrintNode(p, k[0])
      fmtRaw(p, ") ")
    }
    fmtPrintNode(p, k[1])
    if (k[2] != 0) {
      fmtPrintNode(p, k[2])
    }
    // The return type is rendered once, ahead of the params list, so its exact
    // width folds into the params' own wrap decision (`: ReturnType {` sit on
    // the params' line).
    let hasRet = k[4] != 0
    let retText = ""
    if (hasRet) {
      retText = fmtRenderFlat(p, k[4])
    }
    if (hasRet) {
      p.nextListTail = len(retText) + 2 + 2
    } else {
      p.nextListTail = 2
    }
    fmtPrintNode(p, k[3])
    if (hasRet) {
      fmtRaw(p, ": ")
      fmtRaw(p, retText)
    }
    fmtRaw(p, " ")
    fmtPrintBodyBlock(p, k[5], true)
    return
  }
  if (n.tag == Tag.ExternFnDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "extern fn ")
    fmtPrintNode(p, k[0])
    let hasRet = k[2] != 0
    let retText = ""
    if (hasRet) {
      retText = fmtRenderFlat(p, k[2])
    }
    if (hasRet) {
      p.nextListTail = len(retText) + 2
    } else {
      p.nextListTail = 0
    }
    fmtPrintNode(p, k[1])
    if (hasRet) {
      fmtRaw(p, ": ")
      fmtRaw(p, retText)
    }
    return
  }
  if (n.tag == Tag.Receiver) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.Params) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "(", ")", n.span.end)
    return
  }
  if (n.tag == Tag.Param) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ParamRest) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "...")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }

  if (n.tag == Tag.StructDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "struct ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.FieldList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.Field) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, ": ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.InterfaceDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "interface ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.MethodSigList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.MethodSig) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtPrintNode(p, k[1])
    if (k[2] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[2])
    }
    return
  }
  if (n.tag == Tag.EnumDecl) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "enum ")
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, " ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.VariantList) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.EnumVariant) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, "(")
      fmtPrintFlatList(p, kidsOf(p.tree, k[1]), ", ")
      fmtRaw(p, ")")
    }
    return
  }
  if (n.tag == Tag.GenericParams) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "<", ">", n.span.end)
    return
  }
  if (n.tag == Tag.GenericParam) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtRaw(p, ": ")
      fmtPrintNode(p, k[1])
    }
    return
  }
  if (n.tag == Tag.Constraint) {
    fmtPrintFlatList(p, kidsOf(p.tree, idx), " & ")
    return
  }
  if (n.tag == Tag.Export) {
    fmtRaw(p, "export ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.AttrList) {
    let k = kidsOf(p.tree, idx)
    let i = 0
    while (i < len(k)) {
      fmtPrintNode(p, k[i])
      fmtRaw(p, " ")
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.Attr) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "@")
    fmtPrintNode(p, k[0])
    // The argument child is elided when absent, so a bare attribute prints
    // exactly as it did before arguments existed.
    if (len(k) > 1) {
      fmtRaw(p, "(")
      fmtPrintNode(p, k[1])
      fmtRaw(p, ")")
    }
    return
  }
  if (n.tag == Tag.Fallible) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, "!")
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    return
  }

  if (n.tag == Tag.Block) {
    fmtPrintBlock(p, idx)
    return
  }
  if (n.tag == Tag.StmtList) {
    fmtPrintSeq(p, kidsOf(p.tree, idx), true)
    return
  }

  if (n.tag == Tag.Assign) {
    let k = kidsOf(p.tree, idx)
    fmtPrintFlatList(p, kidsOf(p.tree, k[0]), ", ")
    fmtRaw(p, " ")
    fmtRaw(p, opSymbol(n.main))
    fmtRaw(p, " ")
    fmtPrintFlatList(p, kidsOf(p.tree, k[1]), ", ")
    return
  }
  if (n.tag == Tag.LhsList || n.tag == Tag.ExprList) {
    fmtPrintFlatList(p, kidsOf(p.tree, idx), ", ")
    return
  }
  if (n.tag == Tag.IncStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "++")
    return
  }
  if (n.tag == Tag.DecStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "--")
    return
  }
  if (n.tag == Tag.ExprStmt) {
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.SendStmt) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " <- ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "return")
    if (len(k) > 0) {
      fmtRaw(p, " ")
      fmtPrintFlatList(p, k, ", ")
    }
    return
  }
  if (n.tag == Tag.FailStmt) {
    fmtRaw(p, "fail ")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.BreakStmt) {
    fmtRaw(p, "break")
    return
  }
  if (n.tag == Tag.ContinueStmt) {
    fmtRaw(p, "continue")
    return
  }
  if (n.tag == Tag.SpawnStmt) {
    fmtRaw(p, "spawn ")
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    fmtRaw(p, "defer ")
    fmtPrintAtomic(p, kidsOf(p.tree, idx)[0])
    return
  }
  if (n.tag == Tag.AsmStmt) {
    fmtAsmStmt(p, idx, n)
    return
  }
  if (n.tag == Tag.AsmCode || n.tag == Tag.AsmClobber) {
    fmtPrintCommaList(p, kidsOf(p.tree, idx), "{", "}", n.span.end)
    return
  }
  if (n.tag == Tag.AsmResult) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "result arm64 ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " x64 ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " : ")
    fmtPrintNode(p, k[2])
    return
  }
  if (n.tag == Tag.AsmInput) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "input arm64 ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " x64 ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " = ")
    fmtPrintNode(p, k[2])
    return
  }

  if (n.tag == Tag.IfStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "if (")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[1])
    if (k[2] != 0) {
      fmtRaw(p, " else ")
      if (getNode(p.tree, k[2]).tag == Tag.IfStmt) {
        fmtPrintNode(p, k[2])
      } else {
        fmtPrintBlock(p, k[2])
      }
    }
    return
  }
  if (n.tag == Tag.WhileStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "while (")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[1])
    return
  }
  if (n.tag == Tag.ForC) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for (")
    if (k[0] != 0) {
      fmtPrintNode(p, k[0])
    }
    fmtRaw(p, "; ")
    if (k[1] != 0) {
      fmtPrintNode(p, k[1])
    }
    fmtRaw(p, "; ")
    if (k[2] != 0) {
      fmtPrintNode(p, k[2])
    }
    fmtRaw(p, ") ")
    fmtPrintBlock(p, k[3])
    return
  }
  if (n.tag == Tag.ForOf) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " of ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ForIn) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "for ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " in ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
    fmtPrintBlock(p, k[2])
    return
  }
  if (n.tag == Tag.ForInf) {
    fmtRaw(p, "for ")
    fmtPrintBlock(p, kidsOf(p.tree, idx)[0])
    return
  }

  if (n.tag == Tag.SwitchStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "switch ")
    if (k[0] != 0) {
      fmtRaw(p, "(")
      fmtPrintNode(p, k[0])
      fmtRaw(p, ") ")
    }
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.CaseList) {
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.SwitchCase) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "case ")
    fmtPrintFlatList(p, kidsOf(p.tree, k[0]), ", ")
    fmtRaw(p, ":")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[1]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.SwitchDefault) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "default:")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[0]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.MatchStmt) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "match (")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ") ")
    fmtPrintNode(p, k[1])
    return
  }
  if (n.tag == Tag.ArmList) {
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.MatchArm) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    fmtRaw(p, " => ")
    fmtPrintBodyBlock(p, k[1], false)
    return
  }
  if (n.tag == Tag.VariantPat) {
    let k = kidsOf(p.tree, idx)
    fmtPrintNode(p, k[0])
    if (k[1] != 0) {
      fmtPrintCommaList(p, kidsOf(p.tree, k[1]), "(", ")", n.span.end)
    }
    return
  }

  if (n.tag == Tag.SelectStmt) {
    fmtRaw(p, "select ")
    fmtRaw(p, "{")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, idx), false)
    fmtGap(p, n.span.end, true)
    p.indent = p.indent - 1
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.CommCase) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "case ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, ":")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[1]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.CommDefault) {
    let k = kidsOf(p.tree, idx)
    fmtRaw(p, "default:")
    p.indent = p.indent + 1
    fmtPrintNoLeadBlank(p, kidsOf(p.tree, k[0]), true)
    p.indent = p.indent - 1
    return
  }
  if (n.tag == Tag.RecvBind) {
    let k = kidsOf(p.tree, idx)
    if (k[0] != 0) {
      fmtPrintNode(p, k[0])
      fmtRaw(p, " = <- ")
      fmtPrintNode(p, k[1])
    } else {
      fmtRaw(p, "<- ")
      fmtPrintNode(p, k[1])
    }
    return
  }

  fmtDispatchExpr(p, idx, n)
}

// `asm { ... }` — split out to keep fmtDispatch readable. Kid layout mirrors the
// seed: k[0] x64 code, k[1] arm64 code, k[2] result, k[3] clobber x64, k[4]
// clobber arm64, k[5..] inputs. `main == 1` marks a volatile block.
fn fmtAsmStmt(p: Printer, idx: int, n: Node) {
  fmtRaw(p, "asm ")
  if (n.main == 1) {
    fmtRaw(p, "volatile ")
  }
  let k = kidsOf(p.tree, idx)
  fmtRaw(p, "{ ")
  if (k[0] != 0) {
    fmtRaw(p, "x64 ")
    fmtPrintNode(p, k[0])
    fmtRaw(p, " ")
  }
  if (k[1] != 0) {
    fmtRaw(p, "arm64 ")
    fmtPrintNode(p, k[1])
    fmtRaw(p, " ")
  }
  if (k[2] != 0) {
    fmtPrintNode(p, k[2])
    fmtRaw(p, " ")
  }
  if (k[3] != 0) {
    fmtRaw(p, "clobber x64 ")
    fmtPrintNode(p, k[3])
    fmtRaw(p, " ")
  }
  if (k[4] != 0) {
    fmtRaw(p, "clobber arm64 ")
    fmtPrintNode(p, k[4])
    fmtRaw(p, " ")
  }
  let i = 5
  while (i < len(k)) {
    fmtPrintNode(p, k[i])
    fmtRaw(p, " ")
    i = i + 1
  }
  fmtRaw(p, "}")
}
