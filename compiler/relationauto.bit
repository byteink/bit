// compiler/relationauto.bit — R1 (#6302, epic #6298, part of the "relations
// load themselves" feature — SPEC §10.5's `@hasMany`/`@hasOne`/`@belongsTo`/
// `@manyToMany` relation fields, pkg/orm/repo.bit's `.with(...)`).
//
// SAME FUNCTION ONLY, when a row never crosses a call. This pass finds every
// read of a relation field (`@hasMany`/`@hasOne`/`@belongsTo`) on a row that
// came from a `Repo<T>`/`TxRepo<T>` query (`.all()`/`.find()`/`.first()`),
// tracked through `let`, a trailing `?`, a `for-of` loop variable, indexing,
// `.unwrap()` and a `match` arm's single payload binder (#6336, `Some(x)`/
// `Ok(x)`). `compiler/relationautocalls.bit` (R2, #6305; widened to
// the WHOLE PROJECT and to named arguments by R2b, #6322) extends the SAME
// walk defined here across a function's own parameters and return value,
// resolved to a whole-PROJECT fixed point over the call graph — see that
// file's own header for the mechanism. Rows reaching a closure, a field, a
// map, a channel, or a generic function are still
// not tracked (kept ready as dotted-path-friendly data for #6318's nested
// reads, not implemented here): neither R1, R2 nor R2b ever reports a new
// error, so an unprovable read keeps today's runtime panic
// (`classrelationattr.bit`'s `relationUnloadedSentinel`) exactly as it does
// now. R3 turns an unprovable read the whole-program version cannot resolve
// into a build error.
//
// OUTPUT: a side table on `Checker` (`relationAutoWith`, compiler/check.bit),
// mapping a query CALL node to the relation names it needs — read by
// `compiler/relationautosplice.bit` in the build path only.
//
// A KNOWN, ACCEPTED GAP (not a soundness problem): a relation already loaded
// through an intermediate variable's OWN `.with(...)` — `let q =
// posts.with("author")` in one statement, `q.all()` read in another — is not
// seen by `relationautosplice.bit`'s syntactic existing-with walk, so this
// pass may record a name the splice then adds again. The cost is one
// harmless extra `__loadRelation` call, never a wrong answer — see
// `relationAutoExistingWithNames`'s own header.
//
// NESTED READS (#6318). `post.author.posts` is two Member reads, one
// nested inside the other's own receiver — `relationAutoResolveMember`
// resolves the INNER one (`post.author`) to a flow whose class is the
// relation's own TARGET (`Author`, not `Post`), carrying forward a `path`
// string (`RelationAutoFlow.path`/`RelationAutoBinding.path`) that the
// OUTER read's own field name is appended onto (`relationAutoJoinPath`) —
// so the read `relationAutoCheckMemberRead` records is the single dotted
// string `"author.posts"`, never two flat names. Every consumer downstream
// of a recorded name — `RelationAutoState.paramReads`,
// `RelationAutoParamSummary.reads`, `relationAutoCheckCallArgs`'s own
// propagation, `relationautosplice.bit`'s own splice — already treats a
// recorded name as an opaque string (this file's own R2/R2b headers state
// this was deliberate), so nesting needed no change anywhere but HOW the
// string is built here.

// The Repo<T>/TxRepo<T> generic instance's own type argument `T`, or (0,
// false) for anything else — `checkormrepokey.bit`'s `ormRepoTypeArg`
// shape, extended to both repository classes since a query inside a
// `db.tx((tx) => {...})` closure runs through `TxRepo<T>`, not `Repo<T>`.
fn relationAutoRepoTypeArg(c: Checker, recvType: int): (int, bool) {
  let idx = typeInstOfResult(c.ctx, recvType)
  if (idx < 0) {
    return (0, false)
  }
  let inst = c.ctx.typeInsts[idx]
  if ((inst.name != "Repo" && inst.name != "TxRepo") || len(inst.args) != 1) {
    return (0, false)
  }
  return (inst.args[0], true)
}

// One query's row class: the Checker that owns its declaration, the
// declaration node itself, and the RESOLVED type id it came from (`ty`,
// #6318) — 0/`found=false` unless `recvType` is `Repo<T>`/`TxRepo<T>` for a
// concrete `@table` class `T`. `ty` is kept so `relationAutoFieldTargetClass`
// can look a FIELD's own type up in `oc.ctx.structFields` (keyed
// `"${ty}.${fieldName}"`, `checkbinddecl.bit`'s `resolveStructFields` —
// the same key every other resolved-type field read already uses,
// `checkarrow.bit`/`checklookup.bit`) without re-deriving `ty` from `decl`.
class RelationAutoClass {
  found: bool,
  oc: Checker,
  decl: int,
  ty: int,
}

fn relationAutoClassOf(c: Checker, recvType: int): RelationAutoClass {
  let (argTy, ok) = relationAutoRepoTypeArg(c, recvType)
  if (!ok) {
    return RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 }
  }
  return relationAutoClassFromStructType(c, argTy)
}

// The `@table` class a TYPE ID names, directly — no `Repo<T>` unwrap — for
// anything else 0/`found=false`. Shared by `relationAutoClassOf` (a query's
// row type, unwrapped from `Repo<T>`/`TxRepo<T>` first) and
// `compiler/relationautocalls.bit`'s own parameter classification (a plain
// declared parameter type, already unwrapped by its own slice check), so a
// `@table` class is recognised by exactly one piece of code either way.
fn relationAutoClassFromStructType(c: Checker, ty: int): RelationAutoClass {
  let none = RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 }
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.Struct) {
    return none
  }
  let oc = typeOwner(c, ty)
  let decl = structDeclOf(c, ty)
  if (decl == 0 || !classHasTable(oc.tree, oc.source, decl)) {
    return none
  }
  return RelationAutoClass{ found = true, oc = oc, decl = decl, ty = ty }
}

// `Repo<T>`/`TxRepo<T>`'s three terminal methods that hand back real rows
// (`pkg/orm/repo.bit`): `all(): []T!`, `find(id): T!`, `first(): Option<T>!`.
// `first()`'s `Option<T>` is modelled here as the row `T` directly (never a
// slice) — the only way source code can legally read a field off it is
// through `.unwrap()` or a match, both of which this file's own
// `relationAutoResolve` collapses back to the identical class/query pair, so
// treating it as already-unwrapped changes no answer and needs no separate
// Option-tracking state.
fn relationAutoSourceMethodNames(): []string {
  return ["all", "find", "first"]
}

class RelationAutoSource {
  found: bool,
  cls: RelationAutoClass,
}

// Whether `callNode` is a source query: `.all()`/`.find()`/`.first()` whose
// receiver's own resolved type is `Repo<T>`/`TxRepo<T>` for a `@table`
// class. The receiver's type comes from `checkExprType` (compiler/
// checkexpr.bit), never `c.nodeTypes[recv]` directly: a bare identifier
// reference (a parameter or local used as a method-call receiver) is never
// written into `nodeTypes` by the ordinary per-node check sweep
// (`checkmodule.bit`'s own tag dispatch only fills it for a DECL's name
// node, not every USE) — `checkExprType`'s `Tag.Ident` arm resolves through
// the RESOLVER's own node-keyed decl link (`declRefType`) instead of the
// flat, unscoped `c.env`, so it is safe to call here, after every module has
// already been checked, without picking up a stale same-named binding some
// other function left in `c.env` last (checkexpr.bit's own #2947 comment).
fn relationAutoSourceCall(c: Checker, callNode: int): RelationAutoSource {
  let none = RelationAutoSource{
    found = false,
    cls = RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 },
  }
  if (getNode(c.tree, callNode).tag != Tag.Call) {
    return none
  }
  let callee = kidsOf(c.tree, callNode)[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return none
  }
  let mk = kidsOf(c.tree, callee)
  if (!ormNameIn(identText(c.tree, c.source, mk[1]), relationAutoSourceMethodNames())) {
    return none
  }
  let recv = mk[0]
  if (recv == 0) {
    return none
  }
  let cls = relationAutoClassOf(c, checkExprType(c, recv))
  if (!cls.found) {
    return none
  }
  return RelationAutoSource{ found = true, cls = cls }
}

// One tracked local: the class/query pair it carries, and whether it holds
// a whole slice of rows (`isSlice`, e.g. a `let`-bound `.all()` result) or
// one row — a `for-of` binder and an indexed/`?`/`.unwrap()`-resolved value
// are never slices. `afterOffset`: a read only counts past the binding's
// own source position, so a `let`'s initializer expression is never
// mistaken for a later read of itself.
//
// `queryCall`/`paramName` are mutually exclusive origins (R2, #6305): a
// REAL query call node (`queryCall > 0`, `paramName == ""`) as R1 always
// had, or the CURRENT function's own parameter of that name (`queryCall ==
// 0`, `paramName != ""`) — synthesized by
// `compiler/relationautocalls.bit`'s `relationAutoSeedParamBindings` before
// a function's body is walked, with `afterOffset = -1` since a parameter is
// in scope for the whole body. Every read this walk finds through a
// parameter-origin binding is recorded against the PARAMETER's own name
// (`relationAutoRecordRead`), not a call node — resolved back to whichever
// real query reaches it only at that parameter's own call sites.
class RelationAutoBinding {
  varName: string,
  cls: RelationAutoClass,
  queryCall: int,
  paramName: string,
  isSlice: bool,
  afterOffset: int,
  // Mirrors `RelationAutoFlow.ownerModule` (R2b, #6322): the module that
  // owns `queryCall`'s own node index, carried through a `let`/`for-of`
  // binding exactly as every other flow field is.
  ownerModule: int,
  // Mirrors `RelationAutoFlow.path` (#6318): "" for a binding that holds a
  // query's own row directly, or the dotted relation path already walked
  // to reach it (`let author = post.author` binds `path = "author"`) — so a
  // FURTHER read off this binding (`author.posts`) still joins onto the
  // right prefix.
  path: string,
}

// `summaries` (R2): the current module's per-function call-graph summaries
// (`compiler/relationautocalls.bit`'s `RelationAutoFuncSummaries`), read by
// `relationAutoResolveCall`'s named-call branch and
// `relationAutoCheckCallArgs` — one shared table per module, since a
// module's functions can call each other, never mutated by this file
// (`relationautocalls.bit`'s own round loop owns the write side).
// `paramReads`/`returnSeen`/`returnCandidate` accumulate THIS ONE walk's own
// function's parameter-read and return-source findings, merged into
// `summaries` by the caller once the walk finishes. `assigned` (#6352): the
// `x.f = ...` stores on the path to the current statement — scoped to their
// block like `bindings` — so a later read of `x.f` is the assigned value, not
// a load anyone owes.
class RelationAutoState {
  bindings: []RelationAutoBinding,
  assigned: []RelationAutoErrLoaded,
  summaries: RelationAutoFuncSummaries,
  paramReads: map<string, []string>,
  returnSeen: bool,
  returnCandidate: RelationAutoFlow,
  // #6373: two `return`s of this function disagreed. The function then
  // returns a holder with one writer per `return`
  // (`relationAutoMixedReturn`, relationautoreturn.bit) instead of "nothing
  // known"; `returnCandidate` keeps a found flow for its class and slice-ness.
  returnMixed: bool,
}

// `ownerModule` (R2b, #6322): the MODULE ID that owns `queryCall`'s own node
// index — never `cls.oc`'s module, which is wherever the ROW's `@table`
// class happens to be declared, a different module whenever the query is
// written against an imported class. A node index only means anything in
// its own tree (the `declOwner` rule every cross-module reader in this
// checker already follows — see `typeOwner`, lowerlayout.bit), so
// `relationAutoRecordRead` must resolve `queryCall` against `mods[ownerModule]`,
// never against whichever Checker happens to be walking when the FIELD READ
// is found — which, once a row crosses a call into another module
// (`relationAutoResolveNamedCall`, relationautocalls.bit), is a different
// module than the one that ran the query. Meaningless (never read) on a
// flow still only known relative to a parameter (`paramName != ""`,
// `queryCall == 0`).
class RelationAutoFlow {
  found: bool,
  cls: RelationAutoClass,
  queryCall: int,
  paramName: string,
  isSlice: bool,
  ownerModule: int,
  // The dotted relation path already walked to reach THIS flow's own class
  // from `queryCall`/`paramName`'s own row (#6318): "" for the row itself,
  // "author" for `post.author`, "author.posts" for `post.author.posts` —
  // `relationAutoResolveMember`'s own header has the full mechanism.
  path: string,
}

fn relationAutoNoFlow(c: Checker): RelationAutoFlow {
  return RelationAutoFlow{
    found = false, cls = RelationAutoClass{ found = false, oc = c, decl = 0, ty = 0 }, queryCall = 0,
    paramName = "", isSlice = false, ownerModule = c.moduleId, path = "",
  }
}

// The most recent binding named `name` whose own `let`/binder position is
// strictly before `atOffset` — shadowing resolves to the nearest enclosing
// one, scanned back to front the same way `lintCheckRelationMemberRead`
// scans `bindings` forward but keeps only the first match; back-to-front
// here because `st.bindings` is a stack a block/loop pushes onto and pops
// from (`relationAutoWalkBlock`/`relationAutoWalkForOf`, below).
fn relationAutoLookupBinding(
  c: Checker,
  st: RelationAutoState,
  name: string,
  atOffset: int,
): RelationAutoFlow {
  let i = len(st.bindings) - 1
  while (i >= 0) {
    let b = st.bindings[i]
    if (b.varName == name && atOffset > b.afterOffset) {
      return RelationAutoFlow{
        found = true,
        cls = b.cls,
        queryCall = b.queryCall,
        paramName = b.paramName,
        isSlice = b.isSlice,
        ownerModule = b.ownerModule,
        path = b.path,
      }
    }
    i = i - 1
  }
  return relationAutoNoFlow(c)
}

// What `node` resolves to: a source call directly, a `.unwrap()` on an
// already-resolved row, a tracked local, or one element indexed out of a
// tracked slice — `relationAutoNoFlow` for anything else (a map/field/
// channel read, a call through a wrapper function, a value from another
// function's parameter or return): exactly the "cannot prove" set this
// ticket's own scope leaves for the runtime panic to keep catching.
fn relationAutoResolve(c: Checker, node: int, st: RelationAutoState): RelationAutoFlow {
  if (node == 0) {
    return relationAutoNoFlow(c)
  }
  let n = relationAutoStripTry(c, node)
  let tag = getNode(c.tree, n).tag
  if (tag == Tag.Call) {
    return relationAutoResolveCall(c, n, st)
  }
  if (tag == Tag.Ident) {
    let name = identText(c.tree, c.source, n)
    let bound = relationAutoLookupBinding(c, st, name, getNode(c.tree, n).span.start)
    if (bound.found) {
      return bound
    }
    return relationAutoHolderIdent(c, n) // captured/untracked local: relationautoholder.bit
  }
  if (tag == Tag.Index) {
    let inner = relationAutoResolve(c, kidsOf(c.tree, n)[0], st)
    if (inner.found && inner.isSlice) {
      return RelationAutoFlow{
        found = true,
        cls = inner.cls,
        queryCall = inner.queryCall,
        paramName = inner.paramName,
        isSlice = false,
        ownerModule = inner.ownerModule,
        path = inner.path,
      }
    }
    return relationAutoHolderIndex(c, n) // a map value: relationautoholder.bit
  }
  if (tag == Tag.Member) {
    return relationAutoResolveMember(c, n, st)
  }
  return relationAutoNoFlow(c)
}

// `n`'s own `Call` shape: a real query source, a `.unwrap()` on an
// already-resolved row (both R1), `Option.Some(row)` (#6407), or — R2, #6305 — a call to a NAMED,
// non-generic, same-module free function whose own return value the call
// graph has already resolved (`relationAutoResolveNamedCall`,
// `compiler/relationautocalls.bit`).
fn relationAutoResolveCall(c: Checker, n: int, st: RelationAutoState): RelationAutoFlow {
  let src = relationAutoSourceCall(c, n)
  if (src.found) {
    let mname = identText(c.tree, c.source, kidsOf(c.tree, kidsOf(c.tree, n)[0])[1])
    return RelationAutoFlow{
      found = true, cls = src.cls, queryCall = n, paramName = "", isSlice = mname == "all",
      ownerModule = c.moduleId, path = "",
    }
  }
  let raw = relationAutoRawCall(c, n) // raw-SQL rows: relationautoraw.bit
  if (raw.found) {
    return raw
  }
  let wrapped = relationAutoResolveWrapped(c, n, st) // `.unwrap()`, `Option.Some(x)`: relationautomatch.bit
  if (wrapped.found) {
    return wrapped
  }
  let callee = kidsOf(c.tree, n)[0]
  if (getNode(c.tree, callee).tag == Tag.Ident) {
    return relationAutoResolveNamedCall(c, n, callee, st)
  }
  return relationAutoNoFlow(c)
}

// `cls`'s own declared field `fieldName`'s TYPE, resolved the SAME way
// every other member-typed read in the checker already trusts
// (`c.ctx.structFields`, keyed `"${typeId}.${fieldName}"` —
// `checkbinddecl.bit`'s `resolveStructFields` fills it once per class,
// `checkinst.bit`'s own entry covers a generic instantiation) — never
// re-derived by walking `cls.decl`'s own AST. `relationAutoParamTrackable`
// (compiler/relationautocalls.bit) is reused unchanged: a relation field's
// own declared shape is either a bare `@table` class (`@hasOne`/
// `@belongsTo`) or `[]T` for one (`@hasMany`), the identical two shapes a
// trackable PARAMETER already has. `found = false` when `fieldName` is not
// a resolved field of `cls` at all, or its type is not itself a trackable
// `@table` class/slice — both left to the runtime panic exactly as every
// other unprovable shape this pass already leaves it.
fn relationAutoFieldTargetClass(
  cls: RelationAutoClass,
  fieldName: string,
): (RelationAutoClass, bool, bool) {
  let (fty, ok) = cls.oc.ctx.structFields["${cls.ty}.${fieldName}"]
  if (!ok) {
    return (RelationAutoClass{ found = false, oc = cls.oc, decl = 0, ty = 0 }, false, false)
  }
  let (target, isSlice) = relationAutoParamTrackable(cls.oc, fty)
  return (target, isSlice, target.found)
}

// `n`'s own `Member` shape (`[recv, nameIdent]`), resolved as a NESTED
// relation read (#6318): `recv` resolves to a tracked ROW whose class names
// `nameIdent` as a relation field — the flow THIS expression's own value
// carries onward is the relation's TARGET class, with `nameIdent`'s own
// name appended to `recv`'s own resolved `path` (`relationAutoJoinPath`),
// so a FURTHER `.field` read off this expression (`post.author.posts`'s
// outer `.posts`) is recorded as one dotted path against the same root
// query/parameter `recv` itself resolved to, never a second, meaningless
// flat name (`relationAutoRecordRead`'s own header names this exact case).
// Never a slice: reading a field off `posts` (plural, `@hasMany`) needs a
// `for-of`/index first, the same rule every other resolve arm here already
// applies. Bounded by `relationAutoMaxPathDepth` (relationautopath.bit):
// each nesting level's own recursive call is on `recv`, syntactically
// smaller than `n`, so this terminates on the AST alone, and the assert
// below is the same belt-and-suspenders `relationAutoAnalyzeWholeProject`
// (compiler/relationautocalls.bit) already pairs with its own bounded loop.
fn relationAutoResolveMember(c: Checker, n: int, st: RelationAutoState): RelationAutoFlow {
  let k = kidsOf(c.tree, n)
  let recv = k[0]
  let nameIdx = k[1]
  if (recv == 0 || nameIdx == 0) {
    return relationAutoNoFlow(c)
  }
  let inner = relationAutoResolve(c, recv, st)
  if (!inner.found) {
    return relationAutoHolderMember(c, n) // a struct field's rows: relationautoholder.bit
  }
  if (inner.isSlice) {
    return relationAutoNoFlow(c)
  }
  let fieldName = identText(c.tree, c.source, nameIdx)
  if (!lintFieldIsRelation(inner.cls.oc.tree, inner.cls.oc.source, inner.cls.decl, fieldName)) {
    return relationAutoNoFlow(c)
  }
  let (target, isSlice, found) = relationAutoFieldTargetClass(inner.cls, fieldName)
  if (!found) {
    return relationAutoNoFlow(c)
  }
  let path = relationAutoJoinPath(inner.path, fieldName)
  assert(
    relationAutoPathDepth(path) <= relationAutoMaxPathDepth,
    "relationauto: nested relation path '${path}' exceeds its own bound of ${relationAutoMaxPathDepth} levels",
  )
  return RelationAutoFlow{
    found = true, cls = target, queryCall = inner.queryCall, paramName = inner.paramName,
    isSlice = isSlice, ownerModule = inner.ownerModule, path = path,
  }
}

// Records that `flow`'s own row(s) need `fieldName` loaded — either against
// the REAL query call node that produced them (`flow.queryCall > 0`, R1's
// original sink, read by `relationautosplice.bit`), or, when `flow` is
// still only known relative to the CURRENT function's own parameter
// (`flow.paramName != ""`, R2), against that parameter's own accumulating
// summary in `st.paramReads` — resolved to a real query only once
// `relationAutoCheckCallArgs` (compiler/relationautocalls.bit) sees a call
// site that passes a concretely-sourced row into that parameter.
//
// `flow.queryCall`'s own node index means nothing in `c`'s tree once a row
// has crossed a call into another module (R2b, #6322) — `c` here is
// whichever Checker is CURRENTLY being walked, which is the reading
// function's own module, not necessarily the querying one's. The write
// therefore always targets `c.mods[flow.ownerModule]` — the same module `c`
// itself when the query and the read never left one module (`c.mods[c
// .moduleId] == c`), and the querying module otherwise — so
// `relationautosplice.bit`'s per-module walk, keyed on `Checker
// .relationAutoWith`, always finds the name recorded on the SAME tree
// `flow.queryCall` indexes into. `relationAutoMergeName` (#6318), not a
// bare `lintContainsString` dedup, both times: a flat "author" and a nested
// "author.posts" against the SAME query must collapse to the one entry
// that already implies the other (that function's own header).
fn relationAutoRecordRead(
  c: Checker,
  st: RelationAutoState,
  flow: RelationAutoFlow,
  fieldName: string,
) {
  if (flow.queryCall > 0) {
    let owner = c.mods[flow.ownerModule]
    let (names, ok) = owner.relationAutoWith[flow.queryCall]
    if (!ok) {
      names = []string(0)
    }
    owner.relationAutoWith[flow.queryCall] = relationAutoMergeName(names, fieldName)
    return
  }
  if (flow.paramName == "") {
    return
  }
  let (names, ok) = st.paramReads[flow.paramName]
  if (!ok) {
    names = []string(0)
  }
  st.paramReads[flow.paramName] = relationAutoMergeName(names, fieldName)
}

// `node`'s own `Member` shape (`[recv, nameIdent]`): records a read when
// `recv` resolves to a tracked ROW (never a slice — `posts.author` reads a
// field off one element, not the slice itself) and the name it reads is a
// relation field of that row's class. `recv`'s own resolved `path` is
// joined with this read's own field name (#6318) — "" + "author" is
// "author" (R1's original, unnested shape), "author" + "posts" is
// "author.posts" when `recv` is itself `post.author`
// (`relationAutoResolveMember`).
fn relationAutoCheckMemberRead(c: Checker, node: int, st: RelationAutoState) {
  let k = kidsOf(c.tree, node)
  let recv = k[0]
  let nameIdx = k[1]
  if (recv == 0 || nameIdx == 0) {
    return
  }
  let flow = relationAutoResolve(c, recv, st)
  if (!flow.found || flow.isSlice) {
    return
  }
  let fieldName = identText(c.tree, c.source, nameIdx)
  if (!lintFieldIsRelation(flow.cls.oc.tree, flow.cls.oc.source, flow.cls.decl, fieldName)) {
    return
  }
  if (relationAutoErrLoadedByAssignment(c, recv, fieldName, node, st.assigned)) {
    return
  }
  relationAutoRecordRead(c, st, flow, relationAutoJoinPath(flow.path, fieldName))
}

// One `let`'s own bindings — `bindingKids = [pattern, type_or_none,
// init_or_none]` (compiler/parsertype.bit's `parseOneBinding`). The
// initializer is walked for its OWN reads first, then the binding itself
// is pushed, so a `let`'s own right-hand side is never treated as reading
// its own not-yet-bound name. A tuple pattern over a tuple literal binds
// element by element (`relationAutoLetPairs`, relationautomatch.bit).
fn relationAutoWalkLet(c: Checker, node: int, st: RelationAutoState) {
  for b of kidsOf(c.tree, node) {
    let bk = kidsOf(c.tree, b)
    if (bk[2] != 0) {
      relationAutoWalk(c, bk[2], st)
    }
    for pair of relationAutoLetPairs(c, bk[0], bk[2]) {
      relationAutoBindLet(c, pair, getNode(c.tree, node).span.end, st)
    }
  }
}

// `pair.pat` (an Ident) bound to what `pair.init` resolves to, from `afterOffset` on.
fn relationAutoBindLet(
  c: Checker,
  pair: RelationAutoLetPair,
  afterOffset: int,
  st: RelationAutoState,
) {
  let flow = relationAutoResolve(c, pair.init, st)
  if (!flow.found) {
    return
  }
  st.bindings = append(
    st.bindings,
    RelationAutoBinding{
      varName = identText(c.tree, c.source, pair.pat), cls = flow.cls, queryCall = flow.queryCall,
      paramName = flow.paramName, isSlice = flow.isSlice,
      afterOffset = afterOffset, ownerModule = flow.ownerModule, path = flow.path,
    },
  )
}

// `kids = [binder, iter, body]` (parserstmt.bit's `ForOf`). The loop
// variable is pushed only for a bare `Ident` binder over a tracked SLICE,
// and popped once the body has been walked — a `for-of` var's scope is the
// loop body alone, never a sibling statement after the loop.
fn relationAutoWalkForOf(c: Checker, node: int, st: RelationAutoState) {
  let k = kidsOf(c.tree, node)
  relationAutoWalk(c, k[1], st)
  let flow = relationAutoResolve(c, k[1], st)
  let pushed = k[0] != 0 && getNode(c.tree, k[0]).tag == Tag.Ident && flow.found && flow.isSlice
  if (pushed) {
    st.bindings = append(
      st.bindings,
      RelationAutoBinding{
        varName = identText(c.tree, c.source, k[0]), cls = flow.cls, queryCall = flow.queryCall,
        paramName = flow.paramName, isSlice = false, afterOffset = getNode(c.tree, k[0]).span.start,
        ownerModule = flow.ownerModule, path = flow.path,
      },
    )
  }
  relationAutoWalk(c, k[2], st)
  if (pushed) {
    st.bindings = st.bindings[0:len(st.bindings) - 1]
  }
}

// A `Block`'s own lexical scope: every binding a statement inside it pushes
// (a `let`, or a nested `for-of`'s own loop var for ITS body only) is
// popped again once the block ends, so it is never visible to a sibling
// statement after this block closes.
fn relationAutoWalkBlock(c: Checker, node: int, st: RelationAutoState) {
  let save = len(st.bindings)
  let saveAssigned = len(st.assigned)
  for k of kidsOf(c.tree, node) {
    relationAutoWalk(c, k, st)
  }
  st.bindings = st.bindings[0:save]
  st.assigned = st.assigned[0:saveAssigned]
}

// Merges one `return`'s resolved flow into this function's own single
// return-source candidate (R2): the first `return` seen sets it, any LATER
// `return` that disagrees (a different query/parameter, a different
// slice-ness, or simply unresolved where the first was) marks the function
// `returnMixed` (#6373): its callers' reads are then proven by every `return`
// (`relationAutoMixedReturn`, relationautoreturn.bit) instead of by one
// source. `relationAutoFinalizeReturn` (compiler/relationautocalls.bit) reads
// the result once the whole body has been walked.
fn relationAutoFlowsAgree(a: RelationAutoFlow, b: RelationAutoFlow): bool {
  if (a.found != b.found) {
    return false
  }
  if (!a.found) {
    return true
  }
  // `ownerModule` (R2b, #6322): two flows whose `queryCall` node indices
  // happen to be the same INTEGER but come from DIFFERENT modules' trees are
  // NOT the same query — without this, two disagreeing cross-module returns
  // could read as agreeing by coincidence of node numbering. `path` (#6318):
  // `return post.author` and `return post` disagree even when they share
  // every other field — one returns the row, the other its relation.
  return a.queryCall == b.queryCall &&
    a.paramName == b.paramName &&
    a.isSlice == b.isSlice &&
    a.ownerModule == b.ownerModule &&
    a.path == b.path
}

fn relationAutoMergeReturn(st: RelationAutoState, flow: RelationAutoFlow) {
  if (!st.returnSeen) {
    st.returnSeen = true
    st.returnCandidate = flow
    return
  }
  if (relationAutoFlowsAgree(st.returnCandidate, flow)) {
    return
  }
  st.returnMixed = true
  if (!st.returnCandidate.found) {
    st.returnCandidate = flow
  }
}

// `ReturnStmt`'s own kids (parserstmt.bit's `parseReturn`) are its returned
// expressions, grouped-return included; only the single-value shape this
// pass's flow tracking can reason about at all (`len(kids) == 1`) ever
// contributes a real candidate — a bare `return` or a grouped return merges
// as "not found", same as any other unresolved shape.
fn relationAutoWalkReturn(c: Checker, node: int, st: RelationAutoState) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) != 1) {
    relationAutoMergeReturn(st, relationAutoNoFlow(c))
    return
  }
  relationAutoMergeReturn(st, relationAutoResolve(c, kids[0], st))
}

// The five constructs that own their own binding scope (a `let`, a
// `for-of`/`match` binder, a `Block`'s own push/pop, or an assignment's own
// `assigned` record) — split out of
// `relationAutoWalk` (below) to keep its own complexity under the ceiling
// (spec/LINT.md). Returns whether `tag` was one of them: the caller must
// stop rather than fall through to its own recursive kids walk when it was,
// since each of these has already walked its own children itself.
fn relationAutoWalkScoped(c: Checker, node: int, tag: Tag, st: RelationAutoState): bool {
  if (tag == Tag.Block) {
    relationAutoWalkBlock(c, node, st)
    return true
  }
  if (tag == Tag.LetDecl) {
    relationAutoWalkLet(c, node, st)
    return true
  }
  if (tag == Tag.ForOf) {
    relationAutoWalkForOf(c, node, st)
    return true
  }
  if (tag == Tag.MatchStmt) {
    relationAutoWalkMatch(c, node, st)
    return true
  }
  if (tag == Tag.Assign) {
    relationAutoWalkAssign(c, node, st)
    return true
  }
  return false
}

// The generic recursive walk: a nested `FuncDecl`/`ArrowFn` is its own
// scope (`lintIsNestedFuncBoundary`, compiler/relationfieldread.bit) — never
// descended into from here, since `relationautocalls.bit`'s round loop
// already visits it as its own separate entry with its own fresh
// `RelationAutoState`. `Tag.Call`'s own check (R2) never short-circuits the
// child walk below it: an argument expression can itself contain a member
// read (`show(post.author)`) that still needs recording on its own account.
fn relationAutoWalk(c: Checker, node: int, st: RelationAutoState) {
  if (node == 0) {
    return
  }
  let tag = getNode(c.tree, node).tag
  if (lintIsNestedFuncBoundary(tag)) {
    return
  }
  if (relationAutoWalkScoped(c, node, tag, st)) {
    return
  }
  if (tag == Tag.Member) {
    relationAutoCheckMemberRead(c, node, st)
  }
  if (tag == Tag.Call) {
    relationAutoCheckCallArgs(c, node, st)
  }
  if (tag == Tag.ReturnStmt) {
    relationAutoWalkReturn(c, node, st)
  }
  for k of kidsOf(c.tree, node) {
    relationAutoWalk(c, k, st)
  }
}

// Entry point, called from `checkResolved` (compiler/checkproject.bit) once
// every module's `nodeTypes` is populated — a query's receiver type and a
// relation field's own attribute are both needed before any read can be
// judged, and both are only available after the ordinary per-module check
// loop has finished. Delegates to `compiler/relationautocalls.bit`'s
// whole-PROJECT fixed point (R2b, #6322, widening R2's #6305 per-module
// one), which subsumes R1's original single-pass-per-function walk (a
// function with no trackable parameters and no calls into the call graph
// behaves identically to it). Then, R3 (#6308): `relationAutoCheckErrors`
// (compiler/relationautoerr.bit) walks the SAME converged summaries a
// second time and reports every read neither pass could prove loaded —
// see that file's own header for why this needs its own walk.
fn relationAutoAnalyzeProject(mods: []Checker) {
  let sums = relationAutoAnalyzeWholeProject(mods)
  relationAutoCheckErrors(mods, sums)
}
