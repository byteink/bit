// compiler/classjsonschema.bit — the JSON Schema fragment `jsonSchema<T>()`
// is specialised to (#6165, SPEC "jsonSchema<T> - a JSON Schema for a
// `@json` class"). The schema-emitting sibling of classjsonbuild.bit's
// `toJson` builder: same field list, same key rules, no `this` and no
// per-field runtime access at all — every field's fragment is
// COMPILE-TIME-KNOWN, so there is no accumulator, no loop and no local.
//
// `synthJsonSchema` returns the class's own SCHEMA FRAGMENT expression — a
// `Json.JsonObject` literal built the same way `classjsonbuild.bit` builds
// `toJson`'s return value, just with every "value" a LITERAL rather than a
// read off `this`. compiler/classjsonschemacall.bit (#6166) wraps it in the
// `__json_schema_<Name>` function and rewrites the call to it.
//
// A NESTED `@json` class field's fragment is always `{"$ref":
// "#/$defs/<Name>"}` — never inlined — reading the type node's own spelling
// as the name, exactly as `classjsondecode.bit`'s `jsonDecNestedName` does.
// The transitive `$defs` object those refs need to resolve against is
// #6169's job, not this file's.

// Every word this file's own literal keywords need, QUOTED — every one of
// them reaches `jbSynthString`, which always looks up the quoted form
// (`jbEnumStringExpr`'s own convention) — on top of `jsonSynthWords`'s own
// list, guaranteed already registered for any class eligible to reach here,
// since `T` must carry `@json` (#6168's E0173) and `@json` unconditionally
// synthesizes `toJson` first, which registers
// `Json`/`JsonEntry`/`JsonObject`/`JsonArray`/`JsonString`/`key`/`value` and
// every enum field's quoted variant names (`jsonEnumFieldWords`) already.
// FIXED regardless of which field shapes are actually present, the same
// "FIXED half is appended whole" rule `jsonDecHelperNames` follows.
fn jsonSchemaSynthWords(): []string {
  let bare = [
    "type", "properties", "required", "items", "additionalProperties",
    "$ref", "$defs", "enum", "anyOf", "null", "object", "array", "string", "integer",
    "number", "boolean", "x-bit-attrs", "name", "args",
  ]
  let out = []string(0)
  for w of bare {
    out = append(out, "\"" + w + "\"")
  }
  return out
}

// The quoted `"#/$defs/<Name>"` word a nested `@json` class field's `$ref`
// needs — direct (`f.kind == jkNested`) or through a container/`Option`
// (`f.elemKind == jkNested`). The one per-field word `jsonSchemaSynthWords`'s
// fixed list cannot cover, since the class name varies per field — the
// schema-side counterpart of `jsonEnumFieldWords`.
fn jsonSchemaFieldWords(jx: JsonCtx, f: JsonField): []string {
  let typeNode = f.typeNode
  if (f.kind != jkNested) {
    if (f.elemKind != jkNested) {
      return []string(0)
    }
    typeNode = f.elem
  }
  return ["\"#/$defs/" + jsonNodeText(jx, typeNode) + "\""]
}

// `"<name>"` — one recorded attribute's own quoted name (#6181), matching
// `classtabledescwords.bit`'s `tableAttrNameWord` in shape without importing
// it (both files are already the same compiler module).
fn jsonSchemaAttrNameWord(name: string): string {
  return "\"" + name + "\""
}

// `"<escaped spelling>"` — one recorded attribute argument's own quoted,
// escaped word: `tableArgSpelling` (`classtabledescwords.bit`) reads a
// string literal's DECODED content or any other literal's raw source text,
// and `jsonEscapeChars` (`compiler/json.bit`) escapes it the same way
// `tableArgWord` does for `@table`'s own `AttrDesc.args` — an argument's own
// text may contain a quote or a backslash (`@pattern("a\"b")`).
fn jsonSchemaAttrArgWord(tree: Tree, source: string, argNode: int): string {
  return "\"" + jsonEscapeChars(tableArgSpelling(tree, source, argNode)) + "\""
}

// Every word one field's OWN recorded attributes need (#6181):
// `validatorFieldAttrs` is `classjson.bit`'s own filter — every attribute but
// `@key`, the one compiler-known mark naming no function — reused rather
// than forked, exactly as `jsonSchemaFieldWords` reuses `jsonDecNestedName`'s
// shape for its own per-field word.
fn jsonSchemaFieldAttrWords(jx: JsonCtx, f: JsonField): []string {
  let out = []string(0)
  for a of validatorFieldAttrs(jx.tree, jx.source, f.fieldNode) {
    let k = kidsOf(jx.tree, a)
    out = append(out, jsonSchemaAttrNameWord(identText(jx.tree, jx.source, k[0])))
    let i = 1
    while (i < len(k)) {
      out = append(out, jsonSchemaAttrArgWord(jx.tree, jx.source, k[i]))
      i = i + 1
    }
  }
  return out
}

// Every word `jsonSchemaAllSynthWords` needs on top of its own fixed list:
// one `$ref` target per nested `@json` class field and one word per recorded
// attribute (#6181), across every class this module is about to synthesize
// a schema function for.
fn jsonSchemaFieldsWords(jx: JsonCtx, classes: []JsonClass): []string {
  let out = []string(0)
  for c of classes {
    for f of c.fields {
      for w of jsonSchemaFieldWords(jx, f) {
        out = append(out, w)
      }
      for w of jsonSchemaFieldAttrWords(jx, f) {
        out = append(out, w)
      }
    }
  }
  return out
}

// The JSON Schema 2020-12 `type` keyword's value for each scalar shape
// `@json` accepts (SPEC "jsonSchema<T>"'s own table). Falls through to
// `"string"` for `jkEnum` and `jkString` alike — an enum field's own
// `"enum"` keyword narrows it further, added by whichever caller asks.
fn jsSchemaTypeWord(kind: int): string {
  if (kind == jkInt) {
    return "integer"
  }
  if (kind == jkFloat) {
    return "number"
  }
  if (kind == jkBool) {
    return "boolean"
  }
  return "string"
}

fn jsObj(jb: JsonBuild, entries: []int): int {
  return jbJsonCtor(jb, "JsonObject", jbNode(jb, Tag.SliceLit, entries))
}

fn jsArr(jb: JsonBuild, items: []int): int {
  return jbJsonCtor(jb, "JsonArray", jbNode(jb, Tag.SliceLit, items))
}

fn jsEntry(jb: JsonBuild, key: string, value: int): int {
  return jbEntry(jb, jbSynthString(jb, key), value)
}

fn jsStringVal(jb: JsonBuild, word: string): int {
  return jbJsonCtor(jb, "JsonString", jbSynthString(jb, word))
}

// `jsStringVal`'s counterpart for a word that is ALREADY quoted and escaped
// (#6181's `jsonSchemaAttrNameWord`/`jsonSchemaAttrArgWord`): `jbSynthString`
// always wraps its argument in a fresh pair of quotes itself, which would
// double-quote a word registered pre-quoted — `tbStrLit`'s own pattern
// (`classtabledesc.bit`), reused here rather than forked.
fn jsStringValRaw(jb: JsonBuild, word: string): int {
  return jbJsonCtor(jb, "JsonString", addLeaf(jb.tree, Tag.StringLit, synthSpan(jb.st, word)))
}

fn jsStringArr(jb: JsonBuild, words: []string): int {
  let items = []int(0)
  for w of words {
    items = append(items, jsStringVal(jb, w))
  }
  return jsArr(jb, items)
}

fn jsTypeEntry(jb: JsonBuild, word: string): int {
  return jsEntry(jb, "type", jsStringVal(jb, word))
}

// `["Draft", "Published", ...]` — every declared variant of the enum at
// `typeNode`, quoted, for the `"enum"` keyword.
fn jsEnumList(jb: JsonBuild, typeNode: int): int {
  let typeSpan = getNode(jb.tree, typeNode).span
  let typeName = jb.source[typeSpan.start:typeSpan.end]
  let (names, ok) = enumVariantNames(jb.tree, jb.source, typeName)
  if (!ok || len(names) == 0) {
    panic("classjsonschema: '${typeName}' is not a payload-free enum this module declares")
  }
  return jsStringArr(jb, names)
}

// The module a schema fragment is currently being rendered FOR (`jx`/`mod`,
// always the DOCUMENT ROOT's own — a same-module closure member's fields
// share that module's tree too, so this is never the member's own module),
// and the collision-safe `$defs` key every name reachable from it resolves
// to (#6182) — `schemaDefsKeyMap`'s own result, keyed `"<mod>:<name>"` for a
// cross-module target, unconsulted for a same-module one (`schemaRefKey`
// returns the class's own bare name for those, unqualified, unconditionally
// — see `schemaDefsKeyMap`'s own doc for why only a cross-module entry is
// ever qualified). One value so threading it through every fragment builder
// below costs each one param, not three, against LINT.md's max-params=5.
class SchemaRefCtx {
  jx: JsonCtx,
  mod: int,
  keys: map<string, string>,
}

// The `$defs` key a nested reference spelled `spelled` in `rc`'s own module
// resolves to: the target's own bare name for a same-module class (matching
// `jsonSchemaClosureNames`'s own, always-unqualified keying), `rc.keys`'
// collision-safe key for a cross-module one, or `spelled` itself as a last
// resort a real `@json` field can never actually need — every nested field
// already resolved to a real, `@json`-carrying class when ITS OWN module
// validated it (`vJsonNestedMark`), so `jsonClassSiteOf` failing here would
// mean this walk reached a field its own module already refused.
fn schemaRefKey(rc: SchemaRefCtx, spelled: string): string {
  let site = jsonClassSiteOf(rc.jx, rc.mod, spelled)
  if (!site.found) {
    return spelled
  }
  if (site.mod == rc.mod) {
    return site.name
  }
  let (key, ok) = rc.keys["${site.mod}:${site.name}"]
  if (ok) {
    return key
  }
  return site.name
}

// `{"$ref": "#/$defs/<key>"}` — `<key>` resolved through `rc`, never the raw
// spelling directly: a cross-module reference's spelling is only ever a
// LOCAL alias (`import { Inner as B } from "./b"` spells the field `B`, not
// `Inner`), and two different modules' classes reaching this closure under
// the same bare name need two different keys (#6182).
fn jsRefFragment(jb: JsonBuild, typeNode: int, rc: SchemaRefCtx): int {
  let typeSpan = getNode(jb.tree, typeNode).span
  let spelled = jb.source[typeSpan.start:typeSpan.end]
  let key = schemaRefKey(rc, spelled)
  return jsObj(jb, [jsEntry(jb, "$ref", jsStringVal(jb, "#/$defs/" + key))])
}

// One field's schema fragment for `kind` at `typeNode` — its own type node
// for a bare field, its element/value type node one level inside `[]T`/
// `map<string, T>`. `jkOption` never reaches here: folding "null" in is
// `jsOptionFragment`'s own job, since it changes the `type` keyword itself
// rather than nesting.
fn jsFragment(jb: JsonBuild, kind: int, typeNode: int, rc: SchemaRefCtx): int {
  if (kind == jkJson) {
    return jsAnyFragment(jb)
  }
  if (kind == jkNested) {
    return jsRefFragment(jb, typeNode, rc)
  }
  if (kind == jkEnum) {
    return jsObj(jb, [jsTypeEntry(jb, "string"), jsEntry(jb, "enum", jsEnumList(jb, typeNode))])
  }
  return jsObj(jb, [jsTypeEntry(jb, jsSchemaTypeWord(kind))])
}

// `{}` — the schema every JSON value satisfies, for a `Json` field (#7766):
// the field holds any value, `null` included, so there is no `type` to name.
fn jsAnyFragment(jb: JsonBuild): int {
  return jsObj(jb, []int(0))
}

fn jsSliceFragment(jb: JsonBuild, elemKind: int, elem: int, rc: SchemaRefCtx): int {
  return jsObj(
    jb, [jsTypeEntry(jb, "array"), jsEntry(jb, "items", jsFragment(jb, elemKind, elem, rc))],
  )
}

fn jsMapFragment(jb: JsonBuild, elemKind: int, elem: int, rc: SchemaRefCtx): int {
  return jsObj(
    jb, [
      jsTypeEntry(jb, "object"),
      jsEntry(jb, "additionalProperties", jsFragment(jb, elemKind, elem, rc)),
    ],
  )
}

// `Option<T>`: `T`'s own fragment with `"null"` folded into its `type`
// (SPEC "jsonSchema<T>"'s own rule) — `@json` itself always emits an absent
// `Option<T>` as an explicit `null`, so the schema has to admit it. `T` is
// never itself a container here (`classjsonfield.bit`'s `simpleJsonKind`:
// `Option<T>` nests one level, and only scalar, nested or enum reach it), so
// this never needs to widen an already-array-valued `type`. A nested class
// cannot join a `type` array with a `$ref` the way a scalar joins one with
// another type WORD, so it takes 2020-12's `anyOf` instead.
fn jsOptionFragment(jb: JsonBuild, elemKind: int, elem: int, rc: SchemaRefCtx): int {
  if (elemKind == jkJson) {
    return jsAnyFragment(jb)
  }
  if (elemKind == jkNested) {
    let nullFragment = jsObj(jb, [jsTypeEntry(jb, "null")])
    return jsObj(
      jb, [jsEntry(jb, "anyOf", jsArr(jb, [jsRefFragment(jb, elem, rc), nullFragment]))],
    )
  }
  let entries = [jsEntry(jb, "type", jsStringArr(jb, [jsSchemaTypeWord(elemKind), "null"]))]
  if (elemKind == jkEnum) {
    entries = append(entries, jsEntry(jb, "enum", jsEnumList(jb, elem)))
  }
  return jsObj(jb, entries)
}

// One field's schema fragment, dispatched by its OWN kind — container shapes
// nest their element's fragment one level, `jkOption` folds "null" into the
// `type` keyword instead of nesting.
fn jsFieldFragment(jb: JsonBuild, f: JsonField, rc: SchemaRefCtx): int {
  if (f.kind == jkSlice) {
    return jsSliceFragment(jb, f.elemKind, f.elem, rc)
  }
  if (f.kind == jkMap) {
    return jsMapFragment(jb, f.elemKind, f.elem, rc)
  }
  if (f.kind == jkOption) {
    return jsOptionFragment(jb, f.elemKind, f.elem, rc)
  }
  return jsFragment(jb, f.kind, f.typeNode, rc)
}

// `{"name": "<attrName>", "args": ["<arg spelling>", ...]}` — one recorded
// attribute (#6181), the same shape `@table`'s own `AttrDesc` already
// carries (`classtabledesc.bit`'s `RecordedAttr`, `tableArgSpelling` reused
// for its arguments' rendering rather than forked). `jsStringValRaw`, not
// `jsStringVal`: `jsonSchemaAttrNameWord`/`jsonSchemaAttrArgWord` already
// quote (and, for an argument, escape) their own word.
fn jsAttrDescEntry(jb: JsonBuild, tree: Tree, source: string, attr: int): int {
  let k = kidsOf(tree, attr)
  let nameVal = jsStringValRaw(jb, jsonSchemaAttrNameWord(identText(tree, source, k[0])))
  let argVals = []int(0)
  let i = 1
  while (i < len(k)) {
    argVals = append(argVals, jsStringValRaw(jb, jsonSchemaAttrArgWord(tree, source, k[i])))
    i = i + 1
  }
  return jsObj(jb, [jsEntry(jb, "name", nameVal), jsEntry(jb, "args", jsArr(jb, argVals))])
}

// `"x-bit-attrs": [<jsAttrDescEntry>, ...]` (#6181, SPEC "jsonSchema<T>"): a
// field's own recorded attributes — `validatorFieldAttrs` is
// `classjson.bit`'s own filter, every attribute but `@key`, the one
// compiler-known mark naming no function. JSON Schema and OpenAPI both
// reserve the `x-` prefix for a vendor extension a validator that does not
// recognise it ignores rather than rejects.
fn jsXBitAttrsEntry(jb: JsonBuild, tree: Tree, source: string, attrs: []int): int {
  let vals = []int(0)
  for a of attrs {
    vals = append(vals, jsAttrDescEntry(jb, tree, source, a))
  }
  return jsEntry(jb, "x-bit-attrs", jsArr(jb, vals))
}

// The entries an already-built `Json.JsonObject(...)` call node (`jsObj`'s
// own shape: `Call(Member(Json, JsonObject), Args[Arg[SliceLit(entries)]])`)
// holds — read-only, over a node THIS SAME PASS just built, so unlike
// `jbKeyExpr`'s own clone-vs-read distinction this never crosses a module
// boundary. `jsPropertyEntry` uses it to add `x-bit-attrs` to an
// already-wrapped fragment without hand-duplicating `jsFieldFragment`'s own
// dispatch a second time.
fn jsObjEntries(jb: JsonBuild, wrapped: int): []int {
  let argsNode = kidsOf(jb.tree, wrapped)[2]
  let argNode = kidsOf(jb.tree, argsNode)[0]
  let sliceLit = kidsOf(jb.tree, argNode)[0]
  return kidsOf(jb.tree, sliceLit)
}

// `{"<key>": <fragment>}` — one field's own property entry, keyed exactly as
// `toJson()` keys it (`@key`-renamed or the field's own name). A field
// carrying at least one recorded attribute gets `x-bit-attrs` folded into
// its OWN fragment (#6181); a field with none gets no such key at all —
// `jsXBitAttrsEntry` is never even called, so there is no empty-array case
// to special-case away.
fn jsPropertyEntry(jb: JsonBuild, f: JsonField, rc: SchemaRefCtx): int {
  jb.span = getNode(jb.tree, f.nameNode).span
  let frag = jsFieldFragment(jb, f, rc)
  let attrs = validatorFieldAttrs(jb.tree, jb.source, f.fieldNode)
  if (len(attrs) != 0) {
    let entries = jsObjEntries(jb, frag)
    entries = append(entries, jsXBitAttrsEntry(jb, jb.tree, jb.source, attrs))
    frag = jsObj(jb, entries)
  }
  return jbEntry(jb, jbKeyExpr(jb, f), frag)
}

// The class's own three entries — `"type": "object"`, `"properties": {...}`,
// `"required": [...]` — unwrapped, so #6169's `$defs` wrapper can append a
// fourth entry to the SAME object rather than nesting a second one inside
// it. `required` names every field's key with no exception — `@json` never
// omits a key (SPEC "jsonSchema<T>"'s own rule).
fn jsSchemaEntries(jb: JsonBuild, tree: Tree, jc: JsonClass, rc: SchemaRefCtx): []int {
  let props = []int(0)
  let required = []int(0)
  for f of jc.fields {
    props = append(props, jsPropertyEntry(jb, f, rc))
    jb.span = getNode(tree, f.nameNode).span
    required = append(required, jbJsonCtor(jb, "JsonString", jbKeyExpr(jb, f)))
  }
  jb.span = getNode(tree, jc.className).span
  return [
    jsTypeEntry(jb, "object"), jsEntry(jb, "properties", jsObj(jb, props)),
    jsEntry(jb, "required", jsArr(jb, required)),
  ]
}

// The class's own schema fragment: `{"type": "object", "properties": {...},
// "required": [...]}`, no `$defs` — this is what a `$defs` ENTRY for the
// class is (#6169's own document wraps the ROOT's entries with one more),
// and what a nested `@json` class's `$ref` always points at.
fn synthJsonSchema(
  tree: Tree,
  source: string,
  st: SynthText,
  jc: JsonClass,
  rc: SchemaRefCtx,
): int {
  let jb = JsonBuild{
    tree = tree,
    st = st,
    span = getNode(tree, jc.className).span,
    source = source,
  }
  return jsObj(jb, jsSchemaEntries(jb, tree, jc, rc))
}
