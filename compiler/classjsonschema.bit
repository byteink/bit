// compiler/classjsonschema.bit — the JSON Schema fragment `jsonSchema<T>()`
// is specialised to (#6165, SPEC "jsonSchema<T> - a JSON Schema for a
// `@json` class"). The schema-emitting sibling of classjsonbuild.bit's
// `toJson` builder: same field list, same key rules, no `this` and no
// per-field runtime access at all — every field's fragment is
// COMPILE-TIME-KNOWN, so there is no accumulator, no loop and no local.
//
// `synthJsonSchema` returns the class's own SCHEMA FRAGMENT expression — a
// `Json.JsonObject` literal built the same way `classjsonbuild.bit` builds
// `toJson`'s return value, just with every "value" a LITERAL rather than a
// read off `this`. compiler/classjsonschemacall.bit (#6166) wraps it in the
// `__json_schema_<Name>` function and rewrites the call to it.
//
// A NESTED `@json` class field's fragment is always `{"$ref":
// "#/$defs/<Name>"}` — never inlined — reading the type node's own spelling
// as the name, exactly as `classjsondecode.bit`'s `jsonDecNestedName` does.
// The transitive `$defs` object those refs need to resolve against is
// #6169's job, not this file's.

// Every word this file's own literal keywords need, QUOTED — every one of
// them reaches `jbSynthString`, which always looks up the quoted form
// (`jbEnumStringExpr`'s own convention) — on top of `jsonSynthWords`'s own
// list, guaranteed already registered for any class eligible to reach here,
// since `T` must carry `@json` (#6168's E0172) and `@json` unconditionally
// synthesizes `toJson` first, which registers
// `Json`/`JsonEntry`/`JsonObject`/`JsonArray`/`JsonString`/`key`/`value` and
// every enum field's quoted variant names (`jsonEnumFieldWords`) already.
// FIXED regardless of which field shapes are actually present, the same
// "FIXED half is appended whole" rule `jsonDecHelperNames` follows.
fn jsonSchemaSynthWords(): []string {
  let bare = [
    "type", "properties", "required", "items", "additionalProperties",
    "$ref", "enum", "anyOf", "null", "object", "array", "string", "integer",
    "number", "boolean",
  ]
  let out = []string(0)
  for w of bare {
    out = append(out, "\"" + w + "\"")
  }
  return out
}

// The quoted `"#/$defs/<Name>"` word a nested `@json` class field's `$ref`
// needs — direct (`f.kind == jkNested`) or through a container/`Option`
// (`f.elemKind == jkNested`). The one per-field word `jsonSchemaSynthWords`'s
// fixed list cannot cover, since the class name varies per field — the
// schema-side counterpart of `jsonEnumFieldWords`.
fn jsonSchemaFieldWords(jx: JsonCtx, f: JsonField): []string {
  let typeNode = f.typeNode
  if (f.kind != jkNested) {
    if (f.elemKind != jkNested) {
      return []string(0)
    }
    typeNode = f.elem
  }
  return ["\"#/$defs/" + jsonNodeText(jx, typeNode) + "\""]
}

// Every word `jsonSchemaAllSynthWords` needs on top of its own fixed list:
// one `$ref` target per nested `@json` class field, across every class this
// module is about to synthesize a schema function for.
fn jsonSchemaFieldsWords(jx: JsonCtx, classes: []JsonClass): []string {
  let out = []string(0)
  for c of classes {
    for f of c.fields {
      for w of jsonSchemaFieldWords(jx, f) {
        out = append(out, w)
      }
    }
  }
  return out
}

// The JSON Schema 2020-12 `type` keyword's value for each scalar shape
// `@json` accepts (SPEC "jsonSchema<T>"'s own table). Falls through to
// `"string"` for `jkEnum` and `jkString` alike — an enum field's own
// `"enum"` keyword narrows it further, added by whichever caller asks.
fn jsSchemaTypeWord(kind: int): string {
  if (kind == jkInt) {
    return "integer"
  }
  if (kind == jkFloat) {
    return "number"
  }
  if (kind == jkBool) {
    return "boolean"
  }
  return "string"
}

fn jsObj(jb: JsonBuild, entries: []int): int {
  return jbJsonCtor(jb, "JsonObject", jbNode(jb, Tag.SliceLit, entries))
}

fn jsArr(jb: JsonBuild, items: []int): int {
  return jbJsonCtor(jb, "JsonArray", jbNode(jb, Tag.SliceLit, items))
}

fn jsEntry(jb: JsonBuild, key: string, value: int): int {
  return jbEntry(jb, jbSynthString(jb, key), value)
}

fn jsStringVal(jb: JsonBuild, word: string): int {
  return jbJsonCtor(jb, "JsonString", jbSynthString(jb, word))
}

fn jsStringArr(jb: JsonBuild, words: []string): int {
  let items = []int(0)
  for w of words {
    items = append(items, jsStringVal(jb, w))
  }
  return jsArr(jb, items)
}

fn jsTypeEntry(jb: JsonBuild, word: string): int {
  return jsEntry(jb, "type", jsStringVal(jb, word))
}

// `["Draft", "Published", ...]` — every declared variant of the enum at
// `typeNode`, quoted, for the `"enum"` keyword.
fn jsEnumList(jb: JsonBuild, typeNode: int): int {
  let typeSpan = getNode(jb.tree, typeNode).span
  let typeName = jb.source[typeSpan.start:typeSpan.end]
  let (names, ok) = enumVariantNames(jb.tree, jb.source, typeName)
  if (!ok || len(names) == 0) {
    panic("classjsonschema: '${typeName}' is not a payload-free enum this module declares")
  }
  return jsStringArr(jb, names)
}

// `{"$ref": "#/$defs/<Name>"}` — the target read off the type node's own
// spelling: no cross-module resolution, just the name as written, which is
// what a `$ref` string names too.
fn jsRefFragment(jb: JsonBuild, typeNode: int): int {
  let typeSpan = getNode(jb.tree, typeNode).span
  let typeName = jb.source[typeSpan.start:typeSpan.end]
  return jsObj(jb, [jsEntry(jb, "$ref", jsStringVal(jb, "#/$defs/" + typeName))])
}

// One field's schema fragment for `kind` at `typeNode` — its own type node
// for a bare field, its element/value type node one level inside `[]T`/
// `map<string, T>`. `jkOption` never reaches here: folding "null" in is
// `jsOptionFragment`'s own job, since it changes the `type` keyword itself
// rather than nesting.
fn jsFragment(jb: JsonBuild, kind: int, typeNode: int): int {
  if (kind == jkNested) {
    return jsRefFragment(jb, typeNode)
  }
  if (kind == jkEnum) {
    return jsObj(jb, [jsTypeEntry(jb, "string"), jsEntry(jb, "enum", jsEnumList(jb, typeNode))])
  }
  return jsObj(jb, [jsTypeEntry(jb, jsSchemaTypeWord(kind))])
}

fn jsSliceFragment(jb: JsonBuild, elemKind: int, elem: int): int {
  return jsObj(jb, [jsTypeEntry(jb, "array"), jsEntry(jb, "items", jsFragment(jb, elemKind, elem))])
}

fn jsMapFragment(jb: JsonBuild, elemKind: int, elem: int): int {
  return jsObj(
    jb, [
      jsTypeEntry(jb, "object"),
      jsEntry(jb, "additionalProperties", jsFragment(jb, elemKind, elem)),
    ],
  )
}

// `Option<T>`: `T`'s own fragment with `"null"` folded into its `type`
// (SPEC "jsonSchema<T>"'s own rule) — `@json` itself always emits an absent
// `Option<T>` as an explicit `null`, so the schema has to admit it. `T` is
// never itself a container here (`classjsonfield.bit`'s `simpleJsonKind`:
// `Option<T>` nests one level, and only scalar, nested or enum reach it), so
// this never needs to widen an already-array-valued `type`. A nested class
// cannot join a `type` array with a `$ref` the way a scalar joins one with
// another type WORD, so it takes 2020-12's `anyOf` instead.
fn jsOptionFragment(jb: JsonBuild, elemKind: int, elem: int): int {
  if (elemKind == jkNested) {
    let nullFragment = jsObj(jb, [jsTypeEntry(jb, "null")])
    return jsObj(jb, [jsEntry(jb, "anyOf", jsArr(jb, [jsRefFragment(jb, elem), nullFragment]))])
  }
  let entries = [jsEntry(jb, "type", jsStringArr(jb, [jsSchemaTypeWord(elemKind), "null"]))]
  if (elemKind == jkEnum) {
    entries = append(entries, jsEntry(jb, "enum", jsEnumList(jb, elem)))
  }
  return jsObj(jb, entries)
}

// One field's schema fragment, dispatched by its OWN kind — container shapes
// nest their element's fragment one level, `jkOption` folds "null" into the
// `type` keyword instead of nesting.
fn jsFieldFragment(jb: JsonBuild, f: JsonField): int {
  if (f.kind == jkSlice) {
    return jsSliceFragment(jb, f.elemKind, f.elem)
  }
  if (f.kind == jkMap) {
    return jsMapFragment(jb, f.elemKind, f.elem)
  }
  if (f.kind == jkOption) {
    return jsOptionFragment(jb, f.elemKind, f.elem)
  }
  return jsFragment(jb, f.kind, f.typeNode)
}

// `{"<key>": <fragment>}` — one field's own property entry, keyed exactly as
// `toJson()` keys it (`@key`-renamed or the field's own name).
fn jsPropertyEntry(jb: JsonBuild, f: JsonField): int {
  jb.span = getNode(jb.tree, f.nameNode).span
  return jbEntry(jb, jbKeyExpr(jb, f), jsFieldFragment(jb, f))
}

// The class's own schema fragment: `{"type": "object", "properties": {...},
// "required": [...]}`. `required` names every field's key with no
// exception — `@json` never omits a key (SPEC "jsonSchema<T>"'s own rule).
fn synthJsonSchema(tree: Tree, source: string, st: SynthText, jc: JsonClass): int {
  let classSpan = getNode(tree, jc.className).span
  let jb = JsonBuild{ tree = tree, st = st, span = classSpan, source = source }
  let props = []int(0)
  let required = []int(0)
  for f of jc.fields {
    props = append(props, jsPropertyEntry(jb, f))
    jb.span = getNode(tree, f.nameNode).span
    required = append(required, jbJsonCtor(jb, "JsonString", jbKeyExpr(jb, f)))
  }
  jb.span = classSpan
  return jsObj(
    jb,
    [
      jsTypeEntry(jb, "object"), jsEntry(jb, "properties", jsObj(jb, props)),
      jsEntry(jb, "required", jsArr(jb, required)),
    ],
  )
}
