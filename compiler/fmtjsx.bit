// compiler/fmtjsx.bit — JSX element and fragment printing (SPEC §12.12,
// #3945). Reached unconditionally from fmtDispatchExprExtra's tail
// (fmtexpr.bit), the same chain-of-responsibility shape fmtDispatch itself
// uses to hand off to fmtDispatchExpr: a new Jsx* tag here costs only this
// file's own complexity, never a debt-listed baseline (tools/build/
// complexity-debt.txt) elsewhere. A sibling .bit file is the same module.
//
// THE WHITESPACE INVARIANT. SPEC §12.12 makes whitespace between JSX
// children part of the program's meaning, and the PARSER (parserjsx.bit)
// already enforces the rule once, at parse time: every jsx_text leaf holds
// exactly the bytes that survive it, and a "gap" leaf between two non-text
// children exists at all only when the source had a same-line,
// no-newline run there (jsxGapText/jsxTrimText). This printer never
// re-derives whitespace — it prints every jsx_text leaf's span byte for
// byte — and it only ever INSERTS a newline (never a plain space) of its
// own, and only immediately beside a boundary no jsx_text leaf already
// occupies (fmtJsxBreakBefore below). That is always safe: on the next
// parse, jsxTrimText drops any whitespace run that contains a newline in
// full, from whichever end it reaches, so an inserted newline collapses
// back to nothing wherever the source had nothing (or a run parsing had
// already discarded) and never reaches into a real no-newline run, because
// this printer never puts one next to a jsx_text leaf at all.

// THE COMMENT-DUPLICATION FIX (#5351). `collectComments` (fmt.bit) finds
// every comment by its OWN whole-file re-lex, entirely independent of
// `parseSourceD`'s tree — it has no idea a byte range like `/*x*/` inside
// `<p>a /*x*/ b</p>` is jsx_text (SPEC §12.12: any source byte but `<`/`{`,
// #5333), because plain Bit lexing does not know what jsx_text is. Left
// alone, that comment prints TWICE: once as part of the jsx_text leaf's own
// raw-byte echo (fmtDispatchJsx below), and once more when the printer's
// general per-statement comment flush reaches its recorded position — and
// since the flush inserts the copy as a NEW real trailing comment, the next
// `bit fmt` pass re-lexes ITS OWN OUTPUT, finds that copy as a genuine
// comment outside any jsx_text run (correctly kept) plus the original
// inside the run (still duplicated by this same bug), and adds ANOTHER
// copy — `bit fmt` never reaches a fixed point. Filtering `comments` down
// to the ones OUTSIDE every jsx_text leaf's span, once, right after both
// the tree and the raw comment list exist, is the fix: the leaf's own echo
// already accounts for those bytes, so the flush has nothing left to add
// for them. Same shape as `jsxFilterStaleLexDiags` (parserjsx.bit) dropping
// a stale LEXER DIAGNOSTIC in a discarded byte range — this drops stale
// COMMENT TRIVIA in the same kind of range, just as a post-parse pass
// rather than mid-`jsxResync`, since `collectComments` runs entirely after
// `parseSourceD` returns (formatSource, fmt.bit) and has no resync to hook.
fn jsxFilterCommentsInTextRuns(tree: Tree, comments: []Comment): []Comment {
  let kept = []Comment(0)
  let i = 0
  while (i < len(comments)) {
    if (!jsxSpanOverlapsAnyTextRun(tree, comments[i].start, comments[i].end)) {
      kept = append(kept, comments[i])
    }
    i = i + 1
  }
  return kept
}

// Whether `[start, end)` overlaps some `Tag.JsxText` leaf's own span at
// all — OVERLAP, not full containment: a `<` inside a comment's bytes
// (`/*<*/`) ends the raw text SCAN mid-comment (`jsxRawTextEnd`,
// parserjsx.bit), so a comment straddling that `<` is split across TWO
// adjacent jsx_text leaves and never sits wholly inside either one's span.
// Any overlap at all means the naive whole-file re-lex's idea of "this byte
// range is one comment token" is simply wrong here — those bytes are raw
// jsx_text, so the WHOLE comment is dropped, not just the overlapping part.
// A flat forward scan over every node, the same shape `jsxModuleHasNodes`
// (desugarjsx.bit) already uses to find every jsx node with no recursive
// walker of its own.
fn jsxSpanOverlapsAnyTextRun(tree: Tree, start: int, end: int): bool {
  let i = 1
  while (i < len(tree.nodes)) {
    let n = getNode(tree, i)
    if (n.tag == Tag.JsxText && n.span.start < end && n.span.end > start) {
      return true
    }
    i = i + 1
  }
  return false
}

fn fmtDispatchJsx(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.JsxText) {
    fmtRaw(p, p.source[n.span.start:n.span.end])
    return
  }
  if (n.tag == Tag.JsxExpr) {
    fmtRaw(p, "{")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtJsxFlushInlineComments(p, n.span.end)
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.JsxAttr) {
    fmtPrintJsxAttr(p, idx)
    return
  }
  if (n.tag == Tag.JsxSpreadAttr) {
    fmtRaw(p, "{...")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.JsxFrag) {
    fmtPrintJsxFrag(p, idx)
    return
  }
  if (n.tag == Tag.JsxElem) {
    fmtPrintJsxElem(p, idx)
  }
}

// A JSX expression child's comment (`{/* c */}`, #5186) has no node of its
// own for `fmtPrintNode`'s normal srcPos-driven flush to hang on - an EMPTY
// child's kid is `none` (parserjsx.bit's `parseJsxChildBraced`), so nothing
// ever advances `p.ci` past it and the comment sits pending until the NEXT
// real node's own flush picks it up, relocating it after the whole element.
// This flushes every comment starting before the child's own closing `}`
// (`end`, the JsxExpr node's own span end) IN PLACE, mirroring fmtGap's
// (fmt.bit) same-line branch - one leading space, comment text, no newline -
// but never fmtGap's own trailing "leave the cursor on a fresh line": a JSX
// expression child stays on the line it was written on either way.
fn fmtJsxFlushInlineComments(p: Printer, end: int) {
  while (p.ci < len(p.comments) && p.comments[p.ci].start < end) {
    let c = p.comments[p.ci]
    fmtRaw(p, " ")
    fmtRaw(p, p.source[c.start:c.end])
    p.srcPos = c.end
    p.ci = p.ci + 1
  }
}

// `IDENT [ "=" ( STRING_LIT | jsx_expr ) ]` — a bare attribute prints as just
// its name, exactly as written (SPEC §12.12: the `= true` is a desugaring
// concern, not fmt's).
fn fmtPrintJsxAttr(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx)
  fmtPrintNode(p, k[0])
  if (k[1] == 0) {
    return
  }
  fmtRaw(p, "=")
  fmtPrintNode(p, k[1])
}

fn fmtPrintJsxElem(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [name, attrs, children-or-0]
  let attrItems = kidsOf(p.tree, k[1])
  if (k[2] == 0) {
    let _ = fmtPrintJsxOpen(p, k[0], attrItems, "/>")
    return
  }
  let nameLen = getNode(p.tree, k[0]).span.end - getNode(p.tree, k[0]).span.start
  let attrsStacked = fmtPrintJsxOpen(p, k[0], attrItems, ">")
  fmtPrintJsxChildren(p, kidsOf(p.tree, k[2]), 3 + nameLen, attrsStacked) // "</" + name + ">"
  fmtRaw(p, "</")
  fmtPrintNode(p, k[0])
  fmtRaw(p, ">")
}

fn fmtPrintJsxFrag(p: Printer, idx: int) {
  let kidsNode = kidsOf(p.tree, idx)[0]
  fmtRaw(p, "<>")
  fmtPrintJsxChildren(p, kidsOf(p.tree, kidsNode), 3, false) // "</>"
  fmtRaw(p, "</>")
}

// The open tag through its closer: `<Name` + attributes + `closer`, where
// `closer` is `/>` (self-closing) or `>` (has a children list, even an empty
// one). Zero attributes always stays flat; one or more tries to stay flat
// (width-aware, #5414: any attribute count may stay flat if it fits) and
// falls back to the stacked form on overflow, an embedded newline, or a
// comment anywhere in the attribute list. Returns whether the stacked form
// was used, so the caller (fmtPrintJsxElem) never lets a lone child glue
// itself onto a `>` that just closed a multi-line attribute list.
fn fmtPrintJsxOpen(p: Printer, nameNode: int, attrItems: []int, closer: string): bool {
  fmtRaw(p, "<")
  fmtPrintNode(p, nameNode)
  if (len(attrItems) == 0) {
    fmtPrintJsxCloseFlat(p, closer)
    return false
  }
  if (fmtPrintJsxAttrsFlatIfFits(p, attrItems, closer)) {
    fmtPrintJsxCloseFlat(p, closer)
    return false
  }
  fmtPrintJsxAttrsStacked(p, attrItems, closer)
  return true
}

fn fmtPrintJsxCloseFlat(p: Printer, closer: string) {
  if (closer == "/>") {
    fmtRaw(p, " ")
  }
  fmtRaw(p, closer)
}

// Trial-renders every attribute flat (` ` + attribute, for each), N
// generalized from the #4689 single-attribute trial: on success writes the
// captured text and returns true, on failure rejects the trial (rewinding
// the one-way srcPos/outLine watermarks) and returns false so the caller
// falls back to the stacked form and renders the attributes there instead.
// The comment check covers the WHOLE list at once (spanEnd of the last
// attribute), the same shape fmtPrintFlatList (fmtwrap.bit) uses for its own
// multi-item trial — a comment anywhere in the list has nowhere to go on a
// joined line, not just one trailing the last attribute tried.
fn fmtPrintJsxAttrsFlatIfFits(p: Printer, attrItems: []int, closer: string): bool {
  let spanEnd = getNode(p.tree, attrItems[len(attrItems) - 1]).span.end
  if (fmtHasCommentBefore(p, spanEnd)) {
    return false
  }
  let t = fmtTrialBegin(p)
  let savedOut = p.out
  p.out = []byte(0)
  p.bol = false
  let i = 0
  while (i < len(attrItems)) {
    fmtRaw(p, " ")
    fmtPrintNode(p, attrItems[i])
    i = i + 1
  }
  let text = string(p.out)
  p.out = savedOut
  fmtTrialRestoreCursor(p, t)
  let closerPad = 0
  if (closer == "/>") {
    closerPad = 1
  }
  if (fmtHasNl(text) || t.col + len(text) + closerPad + len(closer) > fmtMaxWidth) {
    fmtTrialReject(p, t)
    return false
  }
  fmtRaw(p, text)
  return true
}

// One attribute per line, the closer alone on its own line at the outer
// indent — the fallback shape once the flat trial (#5414) rejects, whether
// because the flat form overflows fmtMaxWidth, holds an embedded newline, or
// the list carries a comment.
fn fmtPrintJsxAttrsStacked(p: Printer, attrItems: []int, closer: string) {
  p.indent = p.indent + 1
  let i = 0
  while (i < len(attrItems)) {
    fmtNewline(p)
    fmtPrintNode(p, attrItems[i])
    i = i + 1
  }
  p.indent = p.indent - 1
  fmtNewline(p)
  fmtRaw(p, closer)
}

fn fmtJsxIsText(p: Printer, idx: int): bool {
  return getNode(p.tree, idx).tag == Tag.JsxText
}

// Whether `items[i]` gets a newline inserted before it. Safe exactly when
// nothing already glues to its left: a jsx_text leaf itself never does (a
// significant gap or a real run's own leading edge must never move — see
// this file's header comment), and neither does the item right after one
// (the leaf already owns that boundary byte for byte).
fn fmtJsxBreakBefore(p: Printer, items: []int, i: int): bool {
  if (fmtJsxIsText(p, items[i])) {
    return false
  }
  return i == 0 || !fmtJsxIsText(p, items[i - 1])
}

// `{ jsx_child }`: a lone short child stays on the same line as the tags: a
// two- (or more) item list, a comment, an overflow, or an opening tag whose
// own attributes already broke (`openStacked` — a lone child has nowhere
// flat left to sit next to a `>` that just closed a multi-line attribute
// list) takes the stacked form instead — one item per line, each line break
// only ever inserted beside a non-text boundary (fmtJsxBreakBefore).
fn fmtPrintJsxChildren(p: Printer, items: []int, closeTagLen: int, openStacked: bool) {
  if (len(items) == 0) {
    return
  }
  if (!openStacked && len(items) == 1 && fmtPrintJsxChildFlatIfFits(p, items[0], closeTagLen)) {
    return
  }
  p.indent = p.indent + 1
  let broke = false
  let i = 0
  while (i < len(items)) {
    if (fmtJsxBreakBefore(p, items, i)) {
      fmtNewline(p)
      broke = true
    }
    fmtPrintNode(p, items[i])
    i = i + 1
  }
  p.indent = p.indent - 1
  // Symmetric with fmtJsxBreakBefore's leading case, and gated on `broke`:
  // the closer only earns its own line when the body actually used one. An
  // item glued to the text before it (fmtJsxBreakBefore's own suppression)
  // stays glued all the way to the closer too when nothing else in the list
  // broke - `broke` false means every item rendered on one shared line, so a
  // trailing newline here would dangle the closer alone at the outer indent
  // with nothing before it to justify the break (#5165). Still safe exactly
  // when the last item is not text, so a trailing significant gap never gets
  // a newline merged into its own single-space run.
  if (broke && !fmtJsxIsText(p, items[len(items) - 1])) {
    fmtNewline(p)
  }
}

// Trial-renders the lone child flat; `closeTagLen` is the caller's
// `</Name>`/`</>` budget, since that text has not been printed yet at trial
// time. On success writes the captured text and returns true; on failure
// rejects the trial and returns false so the caller re-renders it, for real,
// as the sole item of the stacked form.
fn fmtPrintJsxChildFlatIfFits(p: Printer, item: int, closeTagLen: int): bool {
  if (fmtHasCommentBefore(p, getNode(p.tree, item).span.end)) {
    return false
  }
  let t = fmtTrialBegin(p)
  let savedOut = p.out
  p.out = []byte(0)
  p.bol = false
  fmtPrintNode(p, item)
  let text = string(p.out)
  p.out = savedOut
  fmtTrialRestoreCursor(p, t)
  if (fmtHasNl(text) || t.col + len(text) + closeTagLen > fmtMaxWidth) {
    fmtTrialReject(p, t)
    return false
  }
  fmtRaw(p, text)
  return true
}
