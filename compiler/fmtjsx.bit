// compiler/fmtjsx.bit — JSX element and fragment printing (SPEC §12.12,
// #3945). Reached unconditionally from fmtDispatchExprExtra's tail
// (fmtexpr.bit), the same chain-of-responsibility shape fmtDispatch itself
// uses to hand off to fmtDispatchExpr: a new Jsx* tag here costs only this
// file's own complexity, never a debt-listed baseline (tools/build/
// complexity-debt.txt) elsewhere. A sibling .bit file is the same module.
//
// THE WHITESPACE INVARIANT. SPEC §12.12 makes whitespace between JSX
// children part of the program's meaning, and the PARSER (parserjsx.bit)
// already enforces the rule once, at parse time: every jsx_text leaf holds
// exactly the bytes that survive it, and a "gap" leaf between two non-text
// children exists at all only when the source had a same-line,
// no-newline run there (jsxGapText/jsxTrimText). This printer never
// re-derives whitespace — it prints every jsx_text leaf's span byte for
// byte — and it only ever INSERTS a newline (never a plain space) of its
// own, and only immediately beside a boundary no jsx_text leaf already
// occupies (fmtJsxBreakBefore below). That is always safe: on the next
// parse, jsxTrimText drops any whitespace run that contains a newline in
// full, from whichever end it reaches, so an inserted newline collapses
// back to nothing wherever the source had nothing (or a run parsing had
// already discarded) and never reaches into a real no-newline run, because
// this printer never puts one next to a jsx_text leaf at all.

fn fmtDispatchJsx(p: Printer, idx: int, n: Node) {
  if (n.tag == Tag.JsxText) {
    fmtRaw(p, p.source[n.span.start:n.span.end])
    return
  }
  if (n.tag == Tag.JsxExpr) {
    fmtRaw(p, "{")
    fmtPrintNode(p, kidsOf(p.tree, idx)[0])
    fmtRaw(p, "}")
    return
  }
  if (n.tag == Tag.JsxAttr) {
    fmtPrintJsxAttr(p, idx)
    return
  }
  if (n.tag == Tag.JsxFrag) {
    fmtPrintJsxFrag(p, idx)
    return
  }
  if (n.tag == Tag.JsxElem) {
    fmtPrintJsxElem(p, idx)
  }
}

// `IDENT [ "=" ( STRING_LIT | jsx_expr ) ]` — a bare attribute prints as just
// its name, exactly as written (SPEC §12.12: the `= true` is a desugaring
// concern, not fmt's).
fn fmtPrintJsxAttr(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx)
  fmtPrintNode(p, k[0])
  if (k[1] == 0) {
    return
  }
  fmtRaw(p, "=")
  fmtPrintNode(p, k[1])
}

fn fmtPrintJsxElem(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [name, attrs, children-or-0]
  let attrItems = kidsOf(p.tree, k[1])
  if (k[2] == 0) {
    let _ = fmtPrintJsxOpen(p, k[0], attrItems, "/>")
    return
  }
  let nameLen = getNode(p.tree, k[0]).span.end - getNode(p.tree, k[0]).span.start
  let attrsStacked = fmtPrintJsxOpen(p, k[0], attrItems, ">")
  fmtPrintJsxChildren(p, kidsOf(p.tree, k[2]), 3 + nameLen, attrsStacked) // "</" + name + ">"
  fmtRaw(p, "</")
  fmtPrintNode(p, k[0])
  fmtRaw(p, ">")
}

fn fmtPrintJsxFrag(p: Printer, idx: int) {
  let kidsNode = kidsOf(p.tree, idx)[0]
  fmtRaw(p, "<>")
  fmtPrintJsxChildren(p, kidsOf(p.tree, kidsNode), 3, false) // "</>"
  fmtRaw(p, "</>")
}

// The open tag through its closer: `<Name` + attributes + `closer`, where
// `closer` is `/>` (self-closing) or `>` (has a children list, even an empty
// one). Zero attributes always stays flat; one tries to stay flat and falls
// back to the stacked form on overflow or an embedded newline; two or more
// always take the stacked form (the ticket's own rule — a multi-attribute
// element always breaks). Returns whether the stacked form was used, so the
// caller (fmtPrintJsxElem) never lets a lone child glue itself onto a `>`
// that just closed a multi-line attribute list.
fn fmtPrintJsxOpen(p: Printer, nameNode: int, attrItems: []int, closer: string): bool {
  fmtRaw(p, "<")
  fmtPrintNode(p, nameNode)
  if (len(attrItems) == 0) {
    fmtPrintJsxCloseFlat(p, closer)
    return false
  }
  if (len(attrItems) == 1 && fmtPrintJsxAttrFlatIfFits(p, attrItems[0], closer)) {
    fmtPrintJsxCloseFlat(p, closer)
    return false
  }
  fmtPrintJsxAttrsStacked(p, attrItems, closer)
  return true
}

fn fmtPrintJsxCloseFlat(p: Printer, closer: string) {
  if (closer == "/>") {
    fmtRaw(p, " ")
  }
  fmtRaw(p, closer)
}

// Trial-renders the sole attribute flat (` ` + the attribute); on success
// writes it and returns true, on failure rejects the trial (rewinding the
// one-way srcPos/outLine watermarks, #4689) and returns false so the caller
// falls back to the stacked form and renders this attribute there instead.
// Never attempted across a comment, exactly like fmtPrintCommaList's own
// flat trial (fmtwrap.bit) — a comment has nowhere to go on a joined line.
fn fmtPrintJsxAttrFlatIfFits(p: Printer, attr: int, closer: string): bool {
  if (fmtHasCommentBefore(p, getNode(p.tree, attr).span.end)) {
    return false
  }
  let t = fmtTrialBegin(p)
  let savedOut = p.out
  p.out = []byte(0)
  p.bol = false
  fmtRaw(p, " ")
  fmtPrintNode(p, attr)
  let text = string(p.out)
  p.out = savedOut
  fmtTrialRestoreCursor(p, t)
  let closerPad = 0
  if (closer == "/>") {
    closerPad = 1
  }
  if (fmtHasNl(text) || t.col + len(text) + closerPad + len(closer) > fmtMaxWidth) {
    fmtTrialReject(p, t)
    return false
  }
  fmtRaw(p, text)
  return true
}

// One attribute per line, the closer alone on its own line at the outer
// indent — the ticket's explicit shape for "multiple attributes, or a child
// that does not fit".
fn fmtPrintJsxAttrsStacked(p: Printer, attrItems: []int, closer: string) {
  p.indent = p.indent + 1
  let i = 0
  while (i < len(attrItems)) {
    fmtNewline(p)
    fmtPrintNode(p, attrItems[i])
    i = i + 1
  }
  p.indent = p.indent - 1
  fmtNewline(p)
  fmtRaw(p, closer)
}

fn fmtJsxIsText(p: Printer, idx: int): bool {
  return getNode(p.tree, idx).tag == Tag.JsxText
}

// Whether `items[i]` gets a newline inserted before it. Safe exactly when
// nothing already glues to its left: a jsx_text leaf itself never does (a
// significant gap or a real run's own leading edge must never move — see
// this file's header comment), and neither does the item right after one
// (the leaf already owns that boundary byte for byte).
fn fmtJsxBreakBefore(p: Printer, items: []int, i: int): bool {
  if (fmtJsxIsText(p, items[i])) {
    return false
  }
  return i == 0 || !fmtJsxIsText(p, items[i - 1])
}

// `{ jsx_child }`: a lone short child stays on the same line as the tags: a
// two- (or more) item list, a comment, an overflow, or an opening tag whose
// own attributes already broke (`openStacked` — a lone child has nowhere
// flat left to sit next to a `>` that just closed a multi-line attribute
// list) takes the stacked form instead — one item per line, each line break
// only ever inserted beside a non-text boundary (fmtJsxBreakBefore).
fn fmtPrintJsxChildren(p: Printer, items: []int, closeTagLen: int, openStacked: bool) {
  if (len(items) == 0) {
    return
  }
  if (!openStacked && len(items) == 1 && fmtPrintJsxChildFlatIfFits(p, items[0], closeTagLen)) {
    return
  }
  p.indent = p.indent + 1
  let i = 0
  while (i < len(items)) {
    if (fmtJsxBreakBefore(p, items, i)) {
      fmtNewline(p)
    }
    fmtPrintNode(p, items[i])
    i = i + 1
  }
  p.indent = p.indent - 1
  // Symmetric with fmtJsxBreakBefore's leading case: safe exactly when the
  // last item is not text, so a trailing significant gap never gets a
  // newline merged into its own single-space run.
  if (!fmtJsxIsText(p, items[len(items) - 1])) {
    fmtNewline(p)
  }
}

// Trial-renders the lone child flat; `closeTagLen` is the caller's
// `</Name>`/`</>` budget, since that text has not been printed yet at trial
// time. On success writes the captured text and returns true; on failure
// rejects the trial and returns false so the caller re-renders it, for real,
// as the sole item of the stacked form.
fn fmtPrintJsxChildFlatIfFits(p: Printer, item: int, closeTagLen: int): bool {
  if (fmtHasCommentBefore(p, getNode(p.tree, item).span.end)) {
    return false
  }
  let t = fmtTrialBegin(p)
  let savedOut = p.out
  p.out = []byte(0)
  p.bol = false
  fmtPrintNode(p, item)
  let text = string(p.out)
  p.out = savedOut
  fmtTrialRestoreCursor(p, t)
  if (fmtHasNl(text) || t.col + len(text) + closeTagLen > fmtMaxWidth) {
    fmtTrialReject(p, t)
    return false
  }
  fmtRaw(p, text)
  return true
}
