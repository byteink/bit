// compiler/classfieldattr.bit — field attributes (SPEC §10.5, #3879).
//
//     class NewUser {
//       @min(3)
//       @max(200)
//       name: string
//
//       @email
//       email: string
//     }
//
// An attribute on a field is SUGAR FOR A CALL to an ordinary fallible
// function, resolved by normal name lookup: `@email` on field `email` becomes
// `email(this.email)?`, `@max(200)` on `name` becomes `max(this.name, 200)?`.
// There is no registry, no plugin hook and no compiler-known list — any module
// that exports `fn iban(s: string): ()!` makes `@iban` work, and `@emial` is
// the ordinary E0040 undefined name.
//
// This file does two things:
//
//  1. SYNTHESIS (`injectFieldValidators`), a tree mutation run from
//     resolveProject before any Checker exists, exactly where checktrait.bit's
//     `use` injection runs and for the same reason: a method spliced in before
//     resolve is resolved, checked, lowered, mangled and reported on by `bit
//     doc` as one the class wrote itself, so none of those passes needs to
//     know this feature exists. It is deliberately named `validateFields`, not
//     `validate` — a hand-written `validate()` is how cross-field rules are
//     expressed and the two must COMPOSE, not collide.
//
//  2. VALIDATION (`vClassFieldAttrs`), a Checker-time arena walk that says
//     what is wrong with the named function in the attribute's own terms.
//     Without it the desugaring's fallout is all a reader gets: "cannot use
//     '?' on a non-fallible expression" pointing at source nobody wrote.
//
// THE SYNTHETIC NAMES now live in synthtext.bit, which appends every word EVERY
// synthesis needs to the module source in one pass and hands back their spans.
// This file's own two words are `fieldAttrSynthWords()` below. #3976 was the
// second synthesized name and the moment this stopped being an inline append.
//
// `@key` (#3976) is the one field attribute this file does NOT desugar: it is a
// COMPILER-KNOWN mark naming no function, so `validatorFieldAttrs` filters it
// out of both the synthesis and the validation below. Left in, it would desugar
// to a call to a function called `key` that nobody declared.
//
// A CLASS THAT DECLARES `validateFields` ITSELF is an error naming both
// (E0132), and synthesis is skipped for that class — one declaration, one
// definition.

// E0132 (§10.5): the class already declares the member synthesis would add.
const ecValidateFieldsDeclared = 132

// E0133/E0134/E0135 (§10.5): the three ways the function an attribute names can
// be the wrong SHAPE. An unknown name is not among them — that is the ordinary
// E0040 the synthesized call already reports, at the attribute's own span,
// which is the whole point of resolving through normal name lookup.
const ecFieldAttrNotFallible = 133
const ecFieldAttrResultNotUnit = 134
const ecFieldAttrParamMismatch = 135

// The member `validateFields` is synthesized under, and the two words that
// have to exist in the module source for it to be spellable.
const synthValidateFieldsName = "validateFields"
const synthReceiverName = "this"

// ---- shared accessors ------------------------------------------------------

// A field node's attribute list (`Tag.AttrList`), or 0. The 4th kid is always
// present on a field the parser built (parsertype.bit's `parseField`); the
// length test covers a `Tag.Field` reached before that kid existed, which is
// what keeps this total for every one of `structFieldNodes`' readers.
fn fieldAttrList(t: Tree, field: int): int {
  let k = kidsOf(t, field)
  if (len(k) <= 3) {
    return 0
  }
  return k[3]
}

// One field's attributes in declaration order, empty when it carries none.
fn fieldAttrs(t: Tree, field: int): []int {
  let list = fieldAttrList(t, field)
  if (list == 0) {
    return []int(0)
  }
  return kidsOf(t, list)
}

// The `Tag.Field` a class member is, seeing through an `export` wrapper, or 0
// for any other member kind.
fn memberField(t: Tree, member: int): int {
  let m = member
  if (m != 0 && getNode(t, m).tag == Tag.Export) {
    m = kidsOf(t, m)[0]
  }
  if (m != 0 && getNode(t, m).tag == Tag.Field) {
    return m
  }
  return 0
}

// ---- synthesis -------------------------------------------------------------

// One class that needs a synthesized `validateFields`, plus the two spans its
// synthetic Ident nodes read their text from. `isTable` is #5051's own flag:
// a class carrying `@table` calls only the attributes that resolve to a
// function (classtabledesc.bit's `attrNameResolvesToFunc`) — the rest are
// recorded in its `tableDescriptor()` instead, never reaching this file's
// synthesized call at all.
class AttrClass {
  classNode: int,
  className: int,
  classGenerics: int,
  isTable: bool,
}

// The synthesized method's two locals and its catch binding. The `__attr_`
// prefix is not a reservation and does not need to be: these names live in the
// synthesized method's own block, which contains nothing the user wrote.
const attrLocalErrs = "__attr_errs"
const attrLocalMsg = "__attr_msg"
const attrLocalErr = "__attr_e"

// The per-module carrier the method fails with, its two members and its two
// methods (classfieldattrbuild.bit). It is a MODULE-level class, one however
// many attributed classes the module holds, and it is not exported: a caller
// reaches it as an `error`, and by the structural assertion `fieldFailures()`
// answers.
const attrErrClassName = "__AttrFailures"
const attrErrMsgField = "msg"
const attrErrErrsField = "errs"
const attrMessageFn = "message"
const attrFailuresFn = "fieldFailures"

// The two literals the accumulation spells, quoted as they must appear in the
// source. `attrSepWord` joins one failure to the next; `attrEmptyWord` is the
// "nothing has failed yet" test.
const attrSepWord = "\"; \""
const attrEmptyWord = "\"\""

// The words this feature's synthesis needs in the module source, for
// synthtext.bit's single per-module append. Every name the body spells is
// here, including the builtins (`append`) and the type names (`string`,
// `error`) — an identifier's text is a slice of the source, so a word the
// builder uses and this list omits reads the wrong bytes, which is the failure
// `synthSpan`'s panic exists to catch.
fn fieldAttrSynthWords(
  p: Project,
  mid: int,
  tree: Tree,
  source: string,
  classes: []AttrClass,
): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let rc = AttrResolveCtx{ p: p, mid: mid }
  let out = [
    synthValidateFieldsName, synthReceiverName, attrLocalErrs, attrLocalMsg,
    attrLocalErr, attrErrClassName, attrErrMsgField, attrErrErrsField,
    attrMessageFn, attrFailuresFn, attrSepWord, attrEmptyWord,
    "append", "string", "error",
  ]
  for c of classes {
    for f of attributedFields(rc, c.isTable, tree, source, kidsOf(tree, c.classNode)[2]) {
      out = append(out, fieldNameWord(tree, source, f))
    }
  }
  return out
}

// The `field: ` prefix one field's failures are recorded under, quoted as a
// string literal must be spelled in the source. The field's own name is in the
// source already, but as an identifier, and a literal's text is read WITH its
// quotes (`decodeStringContent`) — so the quoted form is a word of its own,
// exactly as `@json`'s key is (classjson.bit's `jsonKeyOf`). A field name is
// an identifier, so quoting it cannot need an escape.
fn fieldNameWord(tree: Tree, source: string, field: int): string {
  return "\"" + identText(tree, source, kidsOf(tree, field)[0]) + ": \""
}

// Every class in the module with at least one CALLED attributed field, in
// declaration order. Mirrors checktrait.bit's `collectClassUseSites` — same
// walk over the program's top-level declarations, same `export` unwrapping.
fn collectAttrClasses(p: Project, mid: int, tree: Tree, source: string): []AttrClass {
  let rc = AttrResolveCtx{ p: p, mid: mid }
  let out = []AttrClass(0)
  let decls = kidsOf(tree, tree.root)
  let i = 0
  while (i < len(decls)) {
    let d = decls[i]
    if (d != 0 && getNode(tree, d).tag == Tag.Export) {
      d = kidsOf(tree, d)[0]
    }
    if (d != 0 && getNode(tree, d).tag == Tag.StructDecl) {
      let k = kidsOf(tree, d)
      let isTable = classHasTable(tree, source, d)
      if (len(attributedFields(rc, isTable, tree, source, k[2])) != 0) {
        out = append(
          out,
          AttrClass{ classNode: d, className: k[0], classGenerics: k[1], isTable: isTable },
        )
      }
    }
    i = i + 1
  }
  return out
}

// One field's CALLED attributes: every non-`@key` attribute #3879 desugars
// into a `validateFields` call — unchanged on an ordinary class, and on a
// `@table` class narrowed to the ones that resolve to a function (#5051's
// discriminator, `attrNameResolvesToFunc`). The rest of a `@table` field's
// attributes are `classtabledesc.bit`'s to record, never this file's to call.
fn calledFieldAttrs(
  rc: AttrResolveCtx, isTable: bool, tree: Tree, source: string, field: int,
): []int {
  let all = validatorFieldAttrs(tree, source, field)
  if (!isTable) {
    return all
  }
  let out = []int(0)
  for a of all {
    if (attrNameResolvesToFunc(rc.p, rc.mid, identText(tree, source, kidsOf(tree, a)[0]))) {
      out = append(out, a)
    }
  }
  return out
}

// A class body's CALLED attributed fields, in declaration order — the order
// §10.5 requires the synthesized calls to run in.
fn attributedFields(
  rc: AttrResolveCtx, isTable: bool, tree: Tree, source: string, fieldList: int,
): []int {
  let members = kidsOf(tree, fieldList)
  let out = []int(0)
  let i = 0
  while (i < len(members)) {
    let f = memberField(tree, members[i])
    if (f != 0 && len(calledFieldAttrs(rc, isTable, tree, source, f)) != 0) {
      out = append(out, f)
    }
    i = i + 1
  }
  return out
}

// The class's own `validateFields` member, or 0. Reads the LAST match for the
// same reason classinit.bit's `classInitDeclNode` does: a duplicate leaves
// the last declaration as the one every later pass registered.
fn declaredValidateFields(tree: Tree, source: string, fieldList: int): int {
  let members = kidsOf(tree, fieldList)
  let found = 0
  let i = 0
  while (i < len(members)) {
    let m = members[i]
    if (getNode(tree, m).tag == Tag.Export) {
      m = kidsOf(tree, m)[0]
    }
    if (getNode(tree, m).tag == Tag.FuncDecl) {
      let nameNode = kidsOf(tree, m)[1]
      if (identText(tree, source, nameNode) == synthValidateFieldsName) {
        found = nameNode
      }
    }
    i = i + 1
  }
  return found
}

// The whole `export fn (this: C) validateFields(): ()! { ... }` declaration for
// one class, as a top-level `Tag.Export`-wrapped func_decl with a receiver —
// the identical shape an in-body method (parsertype.bit's parseMethodMember)
// and an injected trait method (checktrait.bit's cloneTraitMethod) both
// produce, which is why every pass that discovers a method by walking the arena
// for func_decl-with-receiver picks this up with no change at all.
//
// Always `export`ed: a class carrying validation attributes exists to be
// validated by whoever constructs it, and a construction site is routinely in
// another module. `collectMethodExports` (checkbind.bit) reads exactly this
// wrapper.
fn synthValidateFields(
  rc: AttrResolveCtx,
  tree: Tree,
  source: string,
  st: SynthText,
  ac: AttrClass,
): int {
  let classSpan = getNode(tree, ac.className).span
  let b = AttrBuild{ tree: tree, st: st, span: classSpan }
  let stmts = [abLetSlice(b, attrLocalErrs, "error"), abLetEmptyString(b, attrLocalMsg)]
  for f of attributedFields(rc, ac.isTable, tree, source, kidsOf(tree, ac.classNode)[2]) {
    let fname = kidsOf(tree, f)[0]
    let word = fieldNameWord(tree, source, f)
    for a of calledFieldAttrs(rc, ac.isTable, tree, source, f) {
      stmts = append(
        stmts,
        abAttrStmt(b, source, SynthCall{ attr: a, fieldName: fname, fieldWord: word }),
      )
    }
  }
  b.span = classSpan
  stmts = append(stmts, abRaiseStmt(b))
  let generics = 0
  if (ac.classGenerics != 0) {
    generics = dupGenericParamsTree(tree, ac.classGenerics)
  }
  let recv = addNode(
    tree, Tag.Receiver, classSpan, 0,
    [0, traitClassTypeRef(tree, ac.className, ac.classGenerics)],
  )
  let result = addNode(
    tree, Tag.Fallible, classSpan, 0,
    [addNode(tree, Tag.VoidType, classSpan, 0, []int(0)), 0],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, classSpan, 0,
    [
      recv, synthIdent(tree, st, synthValidateFieldsName), generics,
      addNode(tree, Tag.Params, classSpan, 0, []int(0)), result,
      addNode(tree, Tag.Block, classSpan, 0, stmts),
    ],
  )
  return addNode(tree, Tag.Export, classSpan, 0, [decl])
}

// Synthesis for one already-parsed module, mutating its tree and its source in
// place before resolve ever sees either. Runs from `injectFieldValidators`
// below, itself called from resolveProject right after trait injection — after,
// so a trait field spliced into this class's field list is already there (it
// can carry no attributes of its own; §10.7's `trait_field` production has
// none, so this is about seeing the FINAL member list, not about finding more
// work).
fn injectFieldValidatorDecls(
  rc: AttrResolveCtx,
  m: SrcModule,
  diags: Diagnostics,
  st: SynthText,
  classes: []AttrClass,
): []int {
  let newDecls = []int(0)
  let i = 0
  while (i < len(classes)) {
    let ac = classes[i]
    let own = declaredValidateFields(m.tree, m.source, kidsOf(m.tree, ac.classNode)[2])
    if (own != 0) {
      let cname = identText(m.tree, m.source, ac.className)
      report(
        diags, ecValidateFieldsDeclared, getNode(m.tree, own).span,
        "class '${cname}' declares 'validateFields', which its attributed fields already synthesize",
        "rename this method, or drop the field attributes on '${cname}' and call them yourself",
      )
    } else {
      newDecls = append(newDecls, synthValidateFields(rc, m.tree, m.source, st, ac))
    }
    i = i + 1
  }
  if (len(newDecls) == 0) {
    return newDecls
  }
  // The carrier goes in ONCE, and only when a method that fails with it was
  // actually synthesized: a module whose every attributed class declared
  // `validateFields` itself (E0132 above) synthesizes no method, so a carrier
  // added there would be a class nothing constructs.
  let b = AttrBuild{ tree: m.tree, st: st, span: getNode(m.tree, classes[0].className).span }
  for d of attrCarrierDecls(b) {
    newDecls = append(newDecls, d)
  }
  return newDecls
}

// ---- validation ------------------------------------------------------------

// §10.5: the function an attribute names must be `fn name(v: T, ...): ()!` —
// fallible, yielding unit, first parameter assignable FROM the field's type.
// Each way of being wrong gets its own diagnostic naming the attribute and the
// field, because the desugaring's own fallout does not: without this, a
// non-fallible `@slug` reads as "cannot use '?' on a non-fallible expression"
// pointing at a line nobody wrote.
//
// An UNKNOWN name is deliberately not handled here. `@emial` is the ordinary
// E0040 the synthesized call already reports at the attribute's own span, and
// resolving through normal name lookup is the whole design — a second, bespoke
// "unknown attribute" diagnostic would contradict it and say less.
//
// Its own arena walk rather than an arm in checkmodule.bit's main loop, for the
// reason `vClassFieldDefaults` records: that loop is one function at McCabe 64
// and this question needs none of its per-node state.
fn vClassFieldAttrs(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.Field) {
      vOneFieldAttrs(c, i)
    }
    i = i + 1
  }
}

// One field's attributes, in declaration order.
fn vOneFieldAttrs(c: Checker, field: int) {
  let attrs = validatorFieldAttrs(c.tree, c.source, field)
  if (len(attrs) == 0) {
    return
  }
  let k = kidsOf(c.tree, field)
  let fieldTy = typeFromNode(c, k[1])
  let fieldName = vIdentText(c, k[0])
  let i = 0
  while (i < len(attrs)) {
    vOneFieldAttr(c, attrs[i], FieldAttrSite{ name: fieldName, ty: fieldTy })
    i = i + 1
  }
}

// The field an attribute sits on, bundled so `vOneFieldAttr` keeps LINT.md's
// max-params=5 and so the field's type is interned once per field rather than
// once per attribute.
class FieldAttrSite {
  name: string,
  ty: int,
}

// One attribute's named function, checked in the order a reader needs the
// answers: does it fail at all, does it yield nothing, does it accept the
// field. Each verdict RETURNS rather than falling through — a function that is
// not fallible has no unit-result question to answer, and reporting both would
// be two diagnostics for one mistake.
fn vOneFieldAttr(c: Checker, attr: int, site: FieldAttrSite) {
  let nameNode = kidsOf(c.tree, attr)[0]
  let attrName = vIdentText(c, nameNode)
  let ft = funcSigLookup(c, attrName)
  // Unknown, or a name that is not a function: the synthesized call reports it
  // (E0040), at this same span, and saying it twice helps nobody.
  if (ft == 0 || c.ctx.types[ft].kind != TypeKind.Func) {
    return
  }
  let result = c.ctx.types[ft].result
  if (result == 0 || c.ctx.types[result].kind != TypeKind.Fallible) {
    report(
      c.diags, ecFieldAttrNotFallible, vSpan(c, nameNode),
      "attribute '@${attrName}' on field '${site.name}' names a function that cannot fail",
      "an attribute reports by failing: declare '${attrName}' as 'fn ${attrName}(...): ()!'",
    )
    return
  }
  let ok = c.ctx.types[result].result
  if (ok != c.ctx.voidId) {
    let got = typeName(c.ctx, ok)
    report(
      c.diags, ecFieldAttrResultNotUnit, vSpan(c, nameNode),
      "attribute '@${attrName}' on field '${site.name}' names a function returning '${got}'",
      "an attribute's value is discarded, so it must yield unit: declare the result as '()!'",
    )
    return
  }
  vFieldAttrFirstParam(c, nameNode, attrName, site, ft)
}

// The receiver parameter: the field's own value is passed as the first
// argument, so the field's type must be assignable to it. A function with no
// parameters at all is the same mistake and gets the same diagnostic — there is
// nowhere for the value to go.
fn vFieldAttrFirstParam(
  c: Checker,
  nameNode: int,
  attrName: string,
  site: FieldAttrSite,
  ft: int,
) {
  let params = c.ctx.types[ft].members
  if (len(params) != 0 && (site.ty == 0 || vAssignable(c, site.ty, params[0]))) {
    return
  }
  let got = "no parameters"
  if (len(params) != 0) {
    got = "'${typeName(c.ctx, params[0])}'"
  }
  report(
    c.diags, ecFieldAttrParamMismatch, vSpan(c, nameNode),
    "attribute '@${attrName}' cannot take field '${site.name}' of type '${typeName(c.ctx, site.ty)}': '${attrName}' has ${got}",
    "an attribute is called as '${attrName}(this.${site.name}, ...)', so its first parameter takes the field's value",
  )
}
