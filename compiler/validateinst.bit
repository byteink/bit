// Self-host: validation that can only be done PER MONOMORPHIZATION (#1882).
//
// A generic body is checked exactly once, against its own rigid type params, so
// any judgement that needs a concrete type cannot be made there. `vInterp`
// (validateexpr.bit) therefore SKIPS an interpolation operand whose type still
// mentions a `T` — correctly, because judging `T` itself would reject valid
// generic code. Nothing then revisited it, so `E0073` never fired inside a
// generic and a bad program compiled clean. That is the whole bug.
//
// This file is the missing second look: once every instantiation is recorded,
// each one substitutes its concrete arguments into the operands the sweep set
// aside and judges those.
//
// THE SAFETY RULE STILL BINDS (validate.bit). An operand is judged here only
// when it was skipped for mentioning a type param AND its substitution is fully
// concrete. Anything still open, still `invalid`, or unchanged by substitution
// is left alone — a spurious diagnostic on code the previous release accepts is
// worse than the silence this file removes.
//
// Sorts after `validateexpr.bit` (whose `vHasTypeParam`/`vStringConvertible` it
// reuses) and after `types.bit` and `lowerglobal.bit` (`substType`,
// `genericEnvOf`), so the inliner has already lowered every callee (#1511).
// It also reuses `validatemember.bit`'s `vIsUnknownMember`, `vIsTypeNameRef`,
// `vIsNamespaceRef` and `vDeclRooted`, which sort AFTER this file — the module
// is one scope, so name resolution does not depend on the order; only
// diagnostic emission order and inlining depth do.

// The AST is a tree, but a malformed one must not be able to spin this forever;
// nothing in the corpus nests expressions anywhere near this deep.
fn vInstMaxDepth(): int { return 256 }

// Every recorded instantiation, judged by the checker of the module that
// DECLARES it. `ctx.instantiations` is project-wide and its index is the
// monomorphized suffix, so the same entry is visible from every module; only the
// definer's tree can resolve the template's decl and the type names its body
// mentions, which is the same rule `lowerInstance` follows.
fn validateInstantiations(mods: []Checker) {
  for c of mods {
    let g = 0
    while (g < len(c.ctx.instantiations)) {
      let inst = c.ctx.instantiations[g]
      if (inst.module == c.moduleId) {
        vInstOne(c, inst)
      }
      g = g + 1
    }
  }
}

fn vInstOne(c: Checker, inst: Instantiation) {
  let decl = funcDeclLookup(c, inst.name)
  if (decl == 0) {
    return
  }
  let env = genericEnvOf(c, decl, inst.args)
  // No bindings means nothing to substitute, so nothing here can decide
  // anything the sweep could not.
  if (len(env.params) == 0) {
    return
  }
  if (vInstBoundsViolated(c, decl, inst.args)) {
    return
  }
  vInstWalk(c, decl, env, inst.site, 0)
}

// Did this instantiation's arguments already fail the type params' declared
// BOUNDS? Then every rule in this file must stay silent for it.
//
// A bound is a promise the template is entitled to rely on: inside
// `fn max<T: Ord>(a: T, b: T)`, `a.less(b)` is correct code, and when the
// caller passes a type with no `less` the fault is at the CALL, which E0051
// (`vGenericBound`, validategeneric.bit) already reports naming the type, the
// bound and the missing method. Re-judging the substituted body then produces a
// second diagnostic for the same root cause, at a span inside a template the
// reader did not write — `_tests_/cases/check_generic_bound_violation.bit` is
// exactly that pair, and it is what caught this (#4627).
//
// `vArgViolatesBound` (validategeneric.bit) IS E0051's own judgement, called
// with `c` as both checker and owner: `validateInstantiations` only ever hands
// `vInstOne` an instantiation whose module is `c`'s, so `decl` and its type-
// param nodes are indices into `c.tree`.
//
// This can never turn a rejected program into an accepted one: it only fires
// where a bound was violated, and the lowerer's own refusal remains the
// backstop for any instantiation whose bound violation goes unreported.
fn vInstBoundsViolated(c: Checker, decl: int, args: []int): bool {
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  if (len(args) != len(tps)) {
    return false
  }
  let i = 0
  while (i < len(tps)) {
    if (vArgViolatesBound(c, c, tps[i], args[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

// `site` is threaded through unchanged so a diagnostic raised deep in the body
// (`vInstInterp`'s E0073) can still attach the instantiation's own call site
// (#3827) rather than only the position inside the generic body.
fn vInstWalk(c: Checker, node: int, env: TypeEnv, site: Span, depth: int) {
  if (node == 0 || depth >= vInstMaxDepth()) {
    return
  }
  if (getNode(c.tree, node).tag == Tag.StrInterp) {
    vInstInterp(c, node, env, site)
  }
  if (getNode(c.tree, node).tag == Tag.MapType) {
    vInstMapKey(c, node, env)
  }
  if (getNode(c.tree, node).tag == Tag.Index) {
    vInstIndex(c, node, env)
  }
  if (getNode(c.tree, node).tag == Tag.Member) {
    vInstMember(c, node, env)
  }
  if (getNode(c.tree, node).tag == Tag.Call) {
    vInstCall(c, node, env, site)
  }
  for k of kidsOf(c.tree, node) {
    vInstWalk(c, k, env, site, depth + 1)
  }
}

// The E0052 map-key rule, re-judged under this instantiation's arguments
// (#2148). `vTypeNode` decides comparability against the key as WRITTEN, and
// inside a generic that is the bare type param — which `vComparable` answers
// TRUE for, correctly, since judging a rigid `T` would reject valid generic
// code. Nothing then ran the rule again, so `map<T, bool>` — the natural
// spelling of a generic set — accepted `T = []int`, the very key
// `check_map_key_not_comparable.bit` rejects when spelled directly, and the map
// silently degraded to keying on slice handles.
//
// Same shape as `vInstInterp` above and the same guards: judge ONLY what the
// sweep set aside (a key that mentions a type param — an already-concrete one
// was decided by `vTypeNode`, and deciding it again would double-report), and
// only when the substitution is fully concrete.
//
// The span is the key type node inside the generic, not the call that supplied
// the offending argument. `ctx.instantiations` does now carry a representative
// call site (`Instantiation.site`, #3827), but this diagnostic does not attach
// it — only E0073's `vInstInterp` does today. Extending it here is mechanical
// but out of that ticket's scope. The hint names the concrete type.
fn vInstMapKey(c: Checker, node: int, env: TypeEnv) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) < 2) {
    return
  }
  let key = typeFromNode(c, kids[0])
  if (!vTypeResolved(c, key) || !vHasTypeParam(c, key, 0)) {
    return
  }
  let sub = substType(c, key, env, 0)
  // Unchanged, still open, or still rigid: undecidable, so silent.
  if (sub == 0 || sub == key || !vTypeResolved(c, sub) || vHasTypeParam(c, sub, 0)) {
    return
  }
  if (!vComparable(c, sub, 0)) {
    report(
      c.diags, ecNotComparable, vSpan(c, kids[0]),
      "map key type must be comparable",
      "this generic is instantiated with '${typeName(c.ctx, sub)}', which is not comparable (§14.6)",
    )
  }
}

// The operands `vInterp` set aside, re-judged under this instantiation's args.
//
// `site` is the instantiation's recorded call site (#3827). E0073's primary
// span still points at the interpolation inside the generic body — unchanged,
// per the ticket's constraint — but a NOTE now also names the user's own call,
// the way Rust and C++ report monomorphization errors, since the primary span
// alone names a file (e.g. stdlib/testing/testing.bit) the user does not own
// and cannot edit.
fn vInstInterp(c: Checker, node: int, env: TypeEnv, site: Span) {
  for p of kidsOf(c.tree, node) {
    if (p == 0 || getNode(c.tree, p).tag == Tag.StrPart) {
      continue
    }
    // Cached answer first, recompute second — the same order `vInterp` uses, and
    // for the same reason: the sweep's type is authoritative where it exists, but
    // a BARE IDENT operand is never cached, and `${x}` on a parameter is exactly
    // that. Reading only the cache made this pass a no-op on the very case it was
    // written for.
    let ty = c.nodeTypes[p]
    if (ty == 0) {
      ty = checkExprType(c, p)
    }
    if (ty == 0) {
      continue
    }
    ty = defaultType(c, ty)
    if (ty == 0 || vMentionsInvalid(c, ty, 0)) {
      continue
    }
    // Judge ONLY what the sweep skipped. An operand with no type param was
    // already decided by `vInterp`, and re-deciding it here would double-report.
    if (!vHasTypeParam(c, ty, 0)) {
      continue
    }
    let sub = substType(c, ty, env, 0)
    // Unchanged, still open, or still invalid: undecidable, so silent.
    if (sub == 0 || sub == ty || vMentionsInvalid(c, sub, 0) || vHasTypeParam(c, sub, 0)) {
      continue
    }
    if (!vStringConvertible(c, sub)) {
      report(
        c.diags, ecNotStringable, vSpan(c, p),
        "cannot interpolate a value of type '${typeName(c.ctx, sub)}'",
        "this generic is instantiated with a type that has no 'show(): string' method",
      )
      note(c.diags, site, "this generic function is instantiated from here")
    }
  }
}

// The E0054 not-indexable rule (`vIndex`, validateexpr.bit), re-judged under
// this instantiation's args. The guards are `vInstConcreteType`'s, below.
fn vInstIndex(c: Checker, node: int, env: TypeEnv) {
  let recv = kidsOf(c.tree, node)[0]
  let sub = vInstConcreteType(c, recv, env)
  if (sub == 0) {
    return
  }
  if (!vIsIndexable(c, sub)) {
    reportNoHint(
      c.diags,
      ecNotIndexable,
      vSpan(c, recv),
      "'${typeName(c.ctx, sub)}' cannot be indexed",
    )
  }
}

// The E0051 bound rule (`vGenericBound`, validategeneric.bit), re-judged for
// the generic calls this instantiation's body MAKES — the transitive half of
// the rule, and #4646.
//
// A generic body is checked once against its own rigid type params, so
// `vBoundJudgeable` cannot judge `inner(x)` inside `fn outer<T>(v: T)`: the
// argument is `T`, and rejecting a rigid `T` would reject every generic that
// forwards to a bounded one. Nothing then judged it again per instantiation,
// so `outer(7)` recorded `inner<i64>` and `outer()` — whose empty variadic slot
// binds `T = ()` (#4597/#4633) — recorded `inner<()>`, neither of which
// satisfies `inner`'s `T: Named`. `bit check` exited 0 and the LOWERER refused,
// as E0092 inside `inner`'s own body, noting a call inside `outer`'s body: the
// #1430 check/build divergence, reported at the wrong layer and at two spans
// the user did not write.
//
// #4633 asked this question of the CALLED generic's own bound. Here the bound
// is one level down, and the `()` is not the cause — `outer(7)` reproduces it
// with `i64` — so the empty slot falls out of the general rule rather than
// needing one of its own.
//
// THE SPAN IS THE INSTANTIATION'S OWN CALL SITE (`site`, #3827), not the call
// inside the template: `outer()` is the line the user wrote and the only one
// they can change (`outer<Tag>()` is what the diagnostic asks for). The note
// names the inner call, the way E0073's `vInstInterp` names the outer one.
//
// Both callee shapes are judged, as `vGenericBound` judges both for the
// direct case: a free `inner(x)` and a generic method `b.mk(x)` (#4656). Each
// arm resolves the callee the way the pass that RECORDS the entry resolves it
// -- `genericTypeArgs` for the free shape, `methodRefAt` + `methodTypeArgsRaw`
// under this instantiation's `env` for the method shape -- so what is judged
// here is the entry Pass A2 will emit rather than a second resolution that
// could disagree with it.
//
// AND IT FOLLOWS THE CHAIN (#4657). A judged call whose own bound holds is
// walked INTO, under the arguments this instantiation binds it with, so
// `outer -> mid -> inner` is judged at `outer(7)` even though nothing records
// `mid<i64>` at check time.
//
// The ledger cannot answer this question here, and that is measured, not
// assumed: `validateInstantiations` runs at the end of `checkResolved`
// (checkproject.bit) while Pass A1's `closeInstantiations` (lowerglobal.bit)
// runs from `lowerProject` after it, so the ledger holds only the check pass's
// own recordings — one level. Moving the closure in front of this pass does
// produce the E0051, but at the WRONG SPAN and at a real cost: a closure entry
// carries the span of the call that recorded it (`recordSubtreeCall`,
// lowerdriver.bit), which for `mid<i64>` is `mid(v)` INSIDE `outer`'s body, so
// both spans of the diagnostic land in a template the user did not write; and
// `bit check compiler` went 3.9s -> 9.3s, since every check would then run the
// whole monomorphization closure. Walking from the instantiation keeps the
// primary span on the user's own call, which is the only line they can change.
//
// What is followed is what Pass A1 follows: `subtreeCallNodes` over the callee
// body (lowerdriver.bit, the same walk `recordSubtreeInstantiations` uses) with
// the same `genericTypeArgs` / `methodTypeArgsRaw` resolution, so this cannot
// judge a call the emitted body does not name.
//
// Only the CALL rule descends. The other rules in this file still see one
// level, so a bad interpolation two generics deep (E0073) is still the
// lowerer's to refuse — a real remaining gap, stated rather than implied.
fn vInstCall(c: Checker, node: int, env: TypeEnv, site: Span) {
  vInstCallAt(c, node, InstStep{ env: env, site: site, notes: []InstLink(0) })
}

// How many generic bodies deep the chain is followed. `outer -> mid -> inner`
// is two, and no chain in the corpus or in the compiler comes near eight.
//
// A cap is required, not merely prudent: polymorphic recursion (`f<T>` calling
// `f<Box<T>>`) has no finite monomorphization, which is why Pass A1 carries
// `closureBudget` for the same walk. Running out stops the descent and leaves
// the lowerer's refusal as the backstop, exactly as before this existed.
fn vInstMaxChain(): int { return 8 }

// One link of that chain: a generic call standing in the body of the template
// above it. The span is resolved HERE rather than kept as a node, because the
// chain can cross modules and `vSpan` reads the owning module's own file table.
// `mod`/`decl` identify the callee for the cycle guard.
class InstLink {
  span: Span,
  name: string,
  mod: int,
  decl: int,
}

// What one step of the walk carries: the bindings in force for the body being
// scanned, the user's own call site every diagnostic is attributed to, and the
// chain that leads from that site to here. A class rather than three more
// parameters (E0202, spec/LINT.md §5.2).
class InstStep {
  env: TypeEnv,
  site: Span,
  notes: []InstLink,
}

// One call node: judged against the callee's declared bound, then followed into
// the callee's body.
fn vInstCallAt(c: Checker, node: int, step: InstStep) {
  let tag = getNode(c.tree, kidsOf(c.tree, node)[0]).tag // [callee, gargs, args]
  if (tag == Tag.Ident) {
    vInstCallFree(c, node, step)
    return
  }
  if (tag == Tag.Member) {
    vInstCallMethod(c, node, step)
  }
}

// The free-function arm. `genericTypeArgs` is the pair `recordCallInstantiation`
// (checkproject.bit) records the entry with, so what is judged IS the entry Pass
// A2 will emit rather than a second resolution that could disagree with it.
fn vInstCallFree(c: Checker, node: int, step: InstStep) {
  let callee = kidsOf(c.tree, node)[0]
  let name = nodeText(c.tree, c.source, callee)
  if (shadowedByValue(c, callee, name) || !isGenericFuncAt(c, callee, name)) {
    return
  }
  let fr = funcRefAt(c, callee, name)
  let at = InstCallRef{ fr: fr, name: name, node: node, start: 0 }
  vInstJudgeCall(c, at, genericTypeArgs(c, name, node), step)
}

// The generic-METHOD arm (#4656) — `vGenericBoundMethod`'s resolution
// (validategeneric.bit), read under this instantiation's `env`.
//
// The free arm above returns at `tag != Tag.Ident`, so `b.mk(v)` with
// `mk<T: Named>` was judged by nothing and stayed the lowerer's E0092 inside
// `Box.mk`'s body — exactly the gap #4634 closed for the DIRECT case, one level
// down and per instantiation.
//
// The RECEIVER's type goes through `substType` before the method is resolved:
// inside `fn outer<T>()`, `let b = Container<T>{}` types `b` as
// `Container<T>`, and only the substituted `Container<i64>` names a receiver
// with a method table. That is `recordMethodInstantiation`'s own step
// (checkproject.bit, its `genEnv` argument), so the receiver this resolves
// against is the one the ledger resolved against.
//
// A `Tag.Member` callee is not necessarily a method call: `ns.f(...)` names an
// imported free function, `Enum.Variant(...)` constructs, and an interface
// method has no FuncDecl. `vInstMemberSkip` rejects the first two by receiver
// shape and `fr.decl == 0` covers the rest.
//
// Only the method's OWN type params are judged. The declaration's list is
// MERGED, the receiver class's parameters in front of its own (parserdecl), and
// the receiver's half is bound from the receiver TYPE rather than from anything
// this call wrote — a violation there belongs to whatever built the receiver.
fn vInstCallMethod(c: Checker, node: int, step: InstStep) {
  let mk = kidsOf(c.tree, kidsOf(c.tree, node)[0]) // callee = [recv, name]
  if (vInstMemberSkip(c, mk[0])) {
    return
  }
  let rawRecv = checkExprType(c, mk[0])
  if (rawRecv == 0) {
    return
  }
  let subRecv = substType(c, rawRecv, step.env, 0)
  if (subRecv == 0) {
    return // no decidable receiver: nothing to resolve the method against
  }
  let recvTy = methodRecvType(c, subRecv)
  let name = nodeText(c.tree, c.source, mk[1])
  let fr = methodRefAt(c, recvTy, name)
  if (fr.decl == 0 || methodOwnGenericCount(fr.owner, fr.decl) == 0) {
    return // not a method call, or no type params of its own to judge
  }
  let start = len(vDeclTypeParams(fr)) - methodOwnGenericCount(fr.owner, fr.decl)
  let at = InstCallRef{ fr: fr, name: name, node: node, start: start }
  vInstJudgeCall(c, at, methodTypeArgsRaw(c, fr, recvTy, node), step)
}

// One judged call: the resolved callee, what to name it in the message, and the
// node its note points at. Bundled rather than passed positionally because the
// two arms above differ in three of the four and `vInstJudgeCall` would
// otherwise sit past `max-params` (E0202, spec/LINT.md §5.2). The instantiation
// site lives on `InstStep`, since it is the same for every call on a chain.
//
// `start` is the first type parameter THIS call is responsible for: 0 for a
// free function, and for a method the tail of the merged list, exactly as
// `vBoundLoop`'s own `start` (validategeneric.bit).
class InstCallRef {
  fr: FuncRef,
  name: string,
  node: int,
  start: int,
}

// `args[start:]` against `tps[start:]`, reported at the INSTANTIATION's call
// site — `vBoundLoop`'s loop with `vInstBadCallArg` in place of
// `vArgViolatesBound`, since here each argument must first be substituted under
// this instantiation's bindings.
//
// `genericTypeArgs` and `methodTypeArgsRaw` both build exactly one entry per
// declared type parameter, so a length mismatch means the pairing is not
// trustworthy and nothing is judged rather than something guessed —
// `vBoundLoop`'s rule, for the same reason.
fn vInstJudgeCall(c: Checker, at: InstCallRef, raw: []int, step: InstStep) {
  let tps = vDeclTypeParams(at.fr)
  if (len(raw) != len(tps)) {
    return
  }
  let bad = false
  let i = at.start
  while (i < len(tps)) {
    let sub = vInstBadCallArg(c, at.fr.owner, tps[i], raw[i], step.env)
    if (sub != 0) {
      let bound = vBoundIfaceOf(at.fr.owner, tps[i])
      vInstReportCallBound(c, at.name, sub, bound, step.site)
      vInstNoteChain(c, at, step)
      bad = true
    }
    i = i + 1
  }
  // A broken bound stops the descent, for `vInstBoundsViolated`'s reason: the
  // body below is entitled to rely on the promise this call just broke, so
  // every judgement made inside it would be a second diagnostic for one cause.
  if (!bad) {
    vInstDescend(c, at, raw, step)
  }
}

// The chain of notes under the primary span: one per call from the user's own
// instantiation down to the call that broke the bound.
//
// At depth 0 `notes` is empty and this emits exactly the one note #4646 emitted,
// in the same words — which is what keeps the depth-1 fixtures byte-identical.
fn vInstNoteChain(c: Checker, at: InstCallRef, step: InstStep) {
  let encl = ""
  let i = 0
  while (i < len(step.notes)) {
    vInstCallNote(c, step.notes[i].span, step.notes[i].name, encl)
    encl = step.notes[i].name
    i = i + 1
  }
  vInstCallNote(c, vSpan(c, at.node), at.name, encl)
}

// One note of that chain. The first link stands in the body of the very
// instantiation the primary span names; every link below it stands in the body
// of the callee the link above named, and saying which one is the only way the
// reader can follow a chain of template bodies they did not write.
fn vInstCallNote(c: Checker, span: Span, name: string, encl: string) {
  if (encl == "") {
    note(c.diags, span, "'${name}' is called here, in the body emitted for this instantiation")
    return
  }
  note(c.diags, span, "'${name}' is called here, in the body emitted for '${encl}'")
}

// Follow a judged call into the callee's own body, under the arguments this
// instantiation binds it with (#4657).
//
// The walk is Pass A1's: `subtreeCallNodes` over the body (lowerdriver.bit),
// the same nodes `recordSubtreeInstantiations` records from, with the callee
// checker in hand so every node, name and span is read from the tree that owns
// it. What differs from Pass A1 is deliberate: the bindings are applied through
// `substType`/`genericEnvOf` rather than by rebinding the flat `userTypes`,
// because a validation pass must not mutate the checker state the pass after it
// reads, and every other rule in this file is env-based for the same reason.
//
// Two hard stops, both of them load-bearing rather than defensive: the chain
// length (`vInstMaxChain`), and a callee already ON the chain, which is what a
// recursive or mutually recursive generic is. Either one stops the descent and
// nothing else — the call itself was already judged above.
fn vInstDescend(c: Checker, at: InstCallRef, raw: []int, step: InstStep) {
  if (len(step.notes) >= vInstMaxChain() || vInstOnChain(step.notes, at.fr)) {
    return
  }
  let body = kidsOf(at.fr.owner.tree, at.fr.decl)[5]
  let args = vInstSubstArgs(c, raw, step.env)
  if (body == 0 || len(args) == 0) {
    return
  }
  let next = InstStep{
    env: genericEnvOf(at.fr.owner, at.fr.decl, args),
    site: step.site,
    notes: append(
      step.notes,
      InstLink{
        span: vSpan(c, at.node), name: at.name,
        mod: at.fr.owner.moduleId, decl: at.fr.decl,
      },
    ),
  }
  for n of subtreeCallNodes(at.fr.owner.tree, body) {
    vInstCallAt(at.fr.owner, n, next)
  }
}

// Is this callee already on the chain? A generic that calls itself — directly or
// round a cycle — would otherwise be re-entered until the length cap, doing the
// same work at every level and reporting the same violation once per level.
// Stopping is not a lost diagnostic: the first visit judged the call.
fn vInstOnChain(notes: []InstLink, fr: FuncRef): bool {
  let i = 0
  while (i < len(notes)) {
    if (notes[i].mod == fr.owner.moduleId && notes[i].decl == fr.decl) {
      return true
    }
    i = i + 1
  }
  return false
}

// EVERY type argument of one call, substituted under the bindings in force — or
// an EMPTY list, meaning DO NOT DESCEND.
//
// All-or-nothing, unlike `vInstSubstArg` above: that one decides whether a
// single argument can be JUDGED, while this one builds the env the callee's
// whole body is read under, and a partial env would type that body against a
// mixture of one instantiation's arguments and another's rigid parameters. An
// already-concrete argument is kept in the list (it is not re-judged —
// `vInstBadCallArg` still skips it), because the callee's body needs its
// binding all the same.
//
// A call NONE of whose arguments mentioned a type param is refused, and that is
// the no-double-report rule one level up, not an optimisation: such a call binds
// the same arguments in every monomorphization of the body it stands in, so the
// check pass already recorded it as a ledger entry of its own and
// `validateInstantiations` judges it — and walks its body — separately.
// `slotMid()` standing in a generic body, whose empty variadic slot binds `()`
// whatever the enclosing generic was instantiated with, is exactly that shape:
// descending into it reported the identical E0051 twice, at two different spans.
fn vInstSubstArgs(c: Checker, raw: []int, env: TypeEnv): []int {
  let out = []int(0)
  let bound = false
  let i = 0
  while (i < len(raw)) {
    let sub = substType(c, raw[i], env, 0)
    if (raw[i] == 0 || sub == 0 || vMentionsInvalid(c, sub, 0) || vHasTypeParam(c, sub, 0)) {
      return []int(0)
    }
    if (vHasTypeParam(c, raw[i], 0)) {
      bound = true
    }
    out = append(out, sub)
    i = i + 1
  }
  if (!bound) {
    return []int(0)
  }
  return out
}

// The substituted argument when it VIOLATES the type parameter's bound, else 0.
//
// `oc` declares the callee, so `tp` and its constraint nodes index `oc.tree`
// (`vBoundIfaceOf`'s rule). The argument-side guards are `vInstConcreteType`'s,
// applied to a TYPE rather than to an expression: judge only what the sweep set
// aside (an argument mentioning a type param — an already-concrete one was
// decided by E0051 on the body and re-deciding it would double-report) and only
// a substitution that is fully concrete.
//
// The bound side is `vBoundIsJudgeable` + `vSatisfies` rather than
// `vArgViolatesBound`, for #4633's reason: `vBoundJudgeable`'s `arg != voidId`
// clause exists to stop an inference GAP becoming a false E0051, and the `()`
// an empty variadic slot produces is not a gap standing in for something else —
// it is the argument the ledger records and Pass A2 emits against. A gap cannot
// reach here in its place: an un-inferred argument is `0` or a bare `voidId`,
// and neither mentions a type param, so both are skipped above.
fn vInstBadCallArg(c: Checker, oc: Checker, tp: int, rawArg: int, env: TypeEnv): int {
  let sub = vInstSubstArg(c, rawArg, env)
  if (sub == 0) {
    return 0
  }
  let bound = vBoundIfaceOf(oc, tp)
  if (!vBoundIsJudgeable(c, bound) || vSatisfies(c, sub, bound)) {
    return 0
  }
  return sub
}

// A type argument the sweep set aside, substituted under this instantiation's
// bindings — or 0 when nothing decidable comes out of it. `vInstConcreteType`'s
// guard sequence, entered from a TYPE instead of from an expression node.
fn vInstSubstArg(c: Checker, rawArg: int, env: TypeEnv): int {
  if (rawArg == 0 || !vHasTypeParam(c, rawArg, 0)) {
    return 0
  }
  let sub = substType(c, rawArg, env, 0)
  if (sub == 0 || sub == rawArg || vMentionsInvalid(c, sub, 0) || vHasTypeParam(c, sub, 0)) {
    return 0
  }
  return sub
}

// E0051's text, addressed to the instantiation rather than to a written type
// argument: the user wrote no `<...>` at `site`, so the message names the
// generic whose bound broke instead of an argument index they cannot see.
// `vSatisfyReason` is E0041's own renderer, the same one `vReportBound` uses,
// so the two spellings of E0051 cannot drift.
fn vInstReportCallBound(c: Checker, name: string, sub: int, bound: int, site: Span) {
  let hint = vSatisfyReason(c, sub, bound)
  if (hint == "") {
    hint = "check the interface's method set against this type"
  }
  report(
    c.diags, ecMissingMethod, site,
    "this instantiation calls '${name}' with '${typeName(c.ctx, sub)}', which does not satisfy the bound '${typeName(
      c.ctx,
      bound,
    )}'",
    hint,
  )
}

// The type of an EXPRESSION the sweep set aside, substituted under this
// instantiation's arguments — or 0 when nothing decidable comes out of it.
// This is the guard sequence `vInstMapKey` established, in the one spelling
// both expression rules need, rather than once per rule: read the type cache
// first and recompute for a bare Ident the sweep never caches (`xs[0]` and
// `v.n` on a parameter are both exactly that), judge ONLY what mentioned a
// type param, and judge only a substitution that is fully concrete.
fn vInstConcreteType(c: Checker, expr: int, env: TypeEnv): int {
  let rt = c.nodeTypes[expr]
  if (rt == 0) {
    rt = checkExprType(c, expr)
  }
  // Already concrete means the sweep decided it; deciding it again would
  // double-report.
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || !vHasTypeParam(c, rt, 0)) {
    return 0
  }
  let sub = substType(c, rt, env, 0)
  // Unchanged, still open, or still invalid: undecidable, so silent.
  if (sub == 0 || sub == rt || vMentionsInvalid(c, sub, 0) || vHasTypeParam(c, sub, 0)) {
    return 0
  }
  return sub
}

// Is `recv` a receiver `vInstMember` must not judge as a field/method lookup at
// all? The same three exclusions `vMember` applies before it looks at a type,
// and for the same reasons: a bare TYPE name (`Hold.Only` inside a generic
// body, whose `checkExprType` answers the generic enum's own type and whose
// "member" is a variant resolved elsewhere), a module namespace, and a
// receiver whose type came from the flat-env fallback rather than a decl.
// E0046 for a namespace member is deliberately NOT re-run here — a namespace
// alias never mentions a type param, so the sweep has already judged it and a
// second report would duplicate.
fn vInstMemberSkip(c: Checker, recv: int): bool {
  return vIsTypeNameRef(c, recv) || vIsNamespaceRef(c, recv) || !vDeclRooted(c, recv, 0)
}

// The E0057 unknown-member rule (`vMember`, validatemember.bit), re-judged
// under this instantiation's args — the member-access twin of `vInstIndex`
// above (#4627, as `vInstIndex` was #2391 for indexing).
//
// `vMember` returns at `vRecvTypeUnjudgeable` for a receiver whose type still
// mentions a type param, and must: judging a rigid `T` by ABSENCE would reject
// every generic body in the repo, since a template body is checked once against
// its own type params and no member table is keyed against them. Nothing then
// revisited it, so `fn get<T>(v: T): int { return v.n }` type-checked at rc=0
// and was refused only by the lowerer, per instantiation, as E0092 — a
// check/build divergence (#1430) reporting at the wrong layer.
//
// This runs the SAME judgement (`vIsUnknownMember`) on the substituted
// receiver, so the code, the message and the span are a class receiver's. It
// widens nothing: `vMemberJudgeableKind` still gates the kind, so a
// substitution landing on a slice, map, chan, fallible or func receiver — whose
// members are BUILTIN and unmodelled — stays silent here and stays the
// lowerer's E0092, which remains the backstop for everything the checker cannot
// decide.
fn vInstMember(c: Checker, node: int, env: TypeEnv) {
  let kids = kidsOf(c.tree, node) // [recv, name]
  if (vInstMemberSkip(c, kids[0])) {
    return
  }
  let sub = vInstConcreteType(c, kids[0], env)
  if (sub == 0) {
    return
  }
  let mname = nodeText(c.tree, c.source, kids[1])
  if (!vIsUnknownMember(c, sub, mname)) {
    // SPEC 10.5's field visibility, re-judged on the substituted receiver
    // (#4631) — `vForeignFieldAccess` (validatemember.bit), the same call
    // `vMember` makes at the same point, so an instantiated receiver rejects
    // exactly what a directly-typed one does. `fillInstMembers` carries the
    // `export` flag onto the instantiation, so `Box<i64>.v` answers `Box.v`.
    vForeignFieldAccess(c, sub, mname, kids[1])
    return
  }
  // The primary message is `vMember`'s, byte for byte, so the direct and the
  // instantiated case read identically. The HINT is where they differ and must:
  // the primary span points inside the generic's own body, where "this type" is
  // the template's `T` and names nothing the reader can act on — so the hint
  // carries the substituted type, the way `vInstMapKey` and `vInstInterp`
  // already do for E0052 and E0073. The edit-distance suggestion is appended
  // rather than replacing it, since a near-miss name is still worth having.
  let hint = "this generic is instantiated with '${typeName(c.ctx, sub)}', which has no field or method '${mname}'"
  let nearest = vClosestMethodName(c, methodRecvType(c, sub), mname)
  if (nearest != "") {
    hint = hint + "; did you mean '${nearest}'?"
  }
  report(
    c.diags,
    ecUnknownMember,
    vSpan(c, kids[1]),
    "no field or method '${mname}' on this type",
    hint,
  )
}
