// compiler/cli.bit — the argv front end every subcommand passes through, and
// the one place the CLI's accepted surface is written down (#2107).
//
// THE DEFECT THIS REMOVES. `bit check --version <broken-module>` exited 0
// having checked nothing: `--version` was consumed as the module path, the
// loader found no source under it, no diagnostic was produced, and the exit
// code reported success. `--bogus` and `-x` did the same, and `bit run --help`
// answered `bit: --help: NoMain`. A verification command that silently verifies
// nothing is worse than one that crashes — it turns a CI step green over code
// nobody looked at.
//
// ONE TABLE IS THE WHOLE SURFACE. `cliSpecs()` carries, per subcommand, the
// flag spellings its parser understands AND the usage block a user is shown.
// Both are spelled out rather than derived from one another: deriving the
// accepted set by scanning the help prose would mean reflowing a description
// silently changes which flags the compiler accepts. They sit one line apart
// instead, so drift is visible in review.
//
// WHAT THIS LAYER DOES NOT DO. It never consumes an operand and never decides
// what a subcommand means: it refuses an unrecognised flag and returns.
// Positional arity stays with each subcommand. `init`, `add`, `up`, `update`
// and `remove` are absent from the table on purpose — `pmcli.bit`/
// `pmcliinit.bit` parse and document their own flags (#2267, #2262) and
// re-doing it here would be two answers to one question.
//
// `selfcheck` and the six `--dump-*` surfaces are absent for the same reason
// they are absent from `bitUsage()`: they are the gate's and the differential
// harnesses' entry points, not a user's, and the harnesses pass them exactly
// one argument.

// One subcommand's argv contract.
class CliSpec {
  name: string,
  // Every flag spelling the subcommand's parser accepts, space-delimited and
  // space-terminated at BOTH ends so `" ${tok} "` is a whole-token test rather
  // than a prefix match — without the sentinels, `-o` would match `-out`.
  //
  // A spelling written with a trailing `=` takes a VALUE: the token after it is
  // that value and is never itself examined as a flag. Without that, `bit build
  // x.bit -o -weird` would reject the output path it was just told to write.
  flags: string,
  // How many operands the subcommand reads, or -1 for as many as it is given.
  // Anything past it is REPORTED, never dropped: `bit run x.bit alpha beta`
  // used to build `x.bit`, discard `alpha` and `beta` without a word, and exit
  // 0 — so a mistyped flag and a program's own argv vanished the same way, and
  // `bit build` refusing the identical input made the two disagree (#2023).
  maxOperands: int,
  usage: string,
}

// The core compile/test/format verbs: build, run, check, test, fmt. Split out
// of `cliSpecs()` alongside `cliToolSpecs()` purely to stay under the
// per-function line ceiling — combined the same way `steps()` combines
// `coreSteps()`/`gateSteps()`/`packageSteps()` in tools/build/defs.bit.
fn cliBuildSpecs(): []CliSpec {
  return [
    CliSpec{ name: "build", flags: " -o= -c --emit-obj --freestanding --debug --no-optimize -t= --target= ", maxOperands: 1,
      usage: "usage: bit build <file.bit|dir> [-o <out>] [-c] [--freestanding] [--debug] [--no-optimize] [--target <triple>]\n" +
        "  -o <out>             write the output here (default: a file target's\n" +
        "                        stem, in the current directory; a directory\n" +
        "                        target's bit.json \"name\", or its own name,\n" +
        "                        written inside that directory)\n" +
        "  -c, --emit-obj       emit a relocatable object instead of an executable\n" +
        "  --freestanding       compile with no prelude; requires -c\n" +
        "  --debug              trap signed add/sub overflow instead of wrapping (x86-64 only)\n" +
        "  --no-optimize        skip the optimizer pass (raw lowering, unoptimized codegen)\n" +
        "  -t, --target <triple>  x86_64-linux | aarch64-linux | aarch64-macos | x86_64-windows (default: host)\n" },
    // maxOperands -1 (#2399): everything past the module path is forwarded to
    // the program as its own argv, not read as bit run's operands — the
    // ceiling on HOW MANY is runMaxForwardedArgs (compiler/build.bit), a
    // separate, purpose-specific rejection, not this table's arity check.
    CliSpec{ name: "run", flags: " ", maxOperands: -1,
      usage: "usage: bit run <file.bit|dir> [args...]\n" +
        "  Builds the module for the host, runs it with any trailing arguments\n" +
        "  forwarded as its own argv, and exits with its status. Takes no flags\n" +
        "  of its own; write -- before an argument that would otherwise be read\n" +
        "  as one of its own flags (e.g. `bit run prog.bit -- --verbose`). `bit\n" +
        "  run prog.bit --help` still means this usage text — pass -- first to\n" +
        "  give the program its own --help.\n" },
    CliSpec{ name: "check", flags: " ", maxOperands: 1,
      usage: "usage: bit check <file.bit|dir>\n" +
        "  Parses, type-checks and validates the module. Exit 1 iff an error was\n" +
        "  reported; warnings are printed but do not change the exit code. No\n" +
        "  output at all for a module with no findings. Takes no flags.\n" },
    // `--run=` takes a value: the pattern is the token right after it, never
    // examined as a flag of its own (`cliFlagTakesValue`). Whether the value
    // is actually PRESENT — `--run` as the last argument — is `main.bit`'s
    // `testRunPattern`'s job, not this table's; this layer only knows the
    // flag's shape, not its arity (#2833).
    // `--timeout=` (#2274): a positive whole number of SECONDS bounding each
    // test's own process, never the whole run. Value parsing/validation is
    // `main.bit`'s `testTimeoutMs`, same split as `--run` above.
    CliSpec{ name: "test", flags: " --run= --timeout= ", maxOperands: 1,
      usage: "usage: bit test <file.bit|dir> [--run <pattern>] [--timeout <seconds>]\n" +
        "  Builds and runs the module's top-level `fn test_<name>()`\n" +
        "  functions, one process each.\n" +
        "  --run <pattern>      run only tests whose name contains <pattern> (substring match)\n" +
        "  --timeout <seconds>  kill and fail a single test that outlives this many\n" +
        "                       seconds (default: 30); the rest of the run continues\n" },
    CliSpec{ name: "fmt", flags: " --check ", maxOperands: -1,
      usage: "usage: bit fmt [--check] <path>...\n" +
        "  --check              write nothing; name every file that is not canonical\n" },
  ]
}

// The tooling/meta verbs: doc, lint, lsp, ar, version. See `cliBuildSpecs()`.
fn cliToolSpecs(): []CliSpec {
  return [
    CliSpec{ name: "doc", flags: " --json --fields ", maxOperands: 1,
      usage: "usage: bit doc [--json] [--fields] <module-dir|name>\n" +
        "  --json               emit the exported surface as JSON instead of text\n" +
        "  --fields             also report each exported class's own fields\n" },
    CliSpec{ name: "lint", flags: " --json --stats ", maxOperands: -1,
      usage: "usage: bit lint [--json] [--stats] [<path>...]\n" +
        "  --json               emit findings as JSON instead of rendered diagnostics\n" +
        "  --stats              report the active lint-directive overrides, not findings\n" +
        "  With no path, lints `.`.\n" },
    // `--stdio` is accepted and ignored. It is not a Bit flag — it is what LSP
    // clients pass by convention (gopls, rust-analyzer and clangd all take it
    // the same way), and `bit lsp` has never spoken any other transport. Before
    // the front end existed every argument here was silently dropped, so
    // `bit lsp --stdio` worked by accident; refusing it now would break a
    // working editor setup for no gain.
    CliSpec{ name: "lsp", flags: " --stdio ", maxOperands: 0,
      usage: "usage: bit lsp [--stdio]\n" +
        "  Speaks the language server protocol on stdin/stdout until the client\n" +
        "  closes the stream.\n" +
        "  --stdio              accepted and ignored; stdio is the only transport\n" },
    CliSpec{ name: "ar", flags: " -t= --target= ", maxOperands: -1,
      usage: "usage: bit ar <out.a> <obj.o>... [--target <triple>]\n" +
        "  -t, --target <triple>  write the archive in this target's format (default: host)\n" +
        "  Output-first, unlike GNU ar: the FIRST operand is the archive written.\n" +
        "  Toolchain-internal (it is how libbitrt.a itself is built): `bit build`\n" +
        "  has no flag and bit.json has no field that links the result back into\n" +
        "  another build (#2272). To ship or consume Bit code, use `bit add`\n" +
        "  (SPEC §17.7) — source distribution, not a prebuilt archive.\n" },
    CliSpec{ name: "version", flags: " ", maxOperands: 0,
      usage: "usage: bit version\n" +
        "  Prints `bit <version>` on stdout. Also spelled --version, -V and -v.\n" },
  ]
}

// The accepted surface. Every entry here is what `main`'s dispatch and the
// subcommand's own parser actually implement — verified against them, not
// aspirational.
fn cliSpecs(): []CliSpec {
  let out = []CliSpec(0)
  for s of cliBuildSpecs() {
    out = append(out, s)
  }
  for s of cliToolSpecs() {
    out = append(out, s)
  }
  return out
}

// The spec for `name`, and whether there is one. A subcommand with no entry is
// not this layer's business and is left to `main`'s dispatch untouched.
fn cliSpecFor(name: string): (CliSpec, bool) {
  for s of cliSpecs() {
    if (s.name == name) {
      return s, true
    }
  }
  return CliSpec{ name: "", flags: " ", usage: "" }, false
}

// Whether `spec`'s parser accepts the flag `tok`, in either of the two ways the
// table can spell it.
fn cliKnowsFlag(spec: CliSpec, tok: string): bool {
  return contains(spec.flags, " ${tok} ") || contains(spec.flags, " ${tok}= ")
}

// Whether `tok` consumes the argument after it.
fn cliFlagTakesValue(spec: CliSpec, tok: string): bool {
  return contains(spec.flags, " ${tok}= ")
}

// Whether `s` is meant as a flag rather than as an operand. A lone `-` is the
// conventional name for standard input and is left to the subcommand; `--`
// also matches this (len 2, leading `-`) but `cliScanArgs` special-cases it
// as the end-of-flags separator (#2399) before this function is ever asked
// about it, so this predicate alone is never the last word on a literal `--`.
fn cliLooksLikeFlag(s: string): bool {
  return len(s) > 1 && s[0] == '-'
}

// One walk of `a[start:]`, reporting both things this layer decides: the first
// flag `spec` does not accept ("" when every one is known), and the INDEX of
// the first operand past `spec.maxOperands` (-1 when there is no surplus). A
// value-taking flag's value is consumed here, so it is neither examined as a
// flag nor counted as an operand.
//
// An index rather than the token itself, so that `bit run x.bit ""` is still
// reported: an empty argument is a surplus argument, and returning "" for both
// "no surplus" and "a surplus that happens to be empty" would drop the very
// case this is here to catch.
//
// THE FIRST literal `--` ends flag interpretation for the rest of `a` (#2399):
// it is itself consumed (neither checked as a flag nor counted as an
// operand), and every token after it — including a second literal `--` or
// anything flag-shaped — is counted as an operand unconditionally. This is
// what lets `bit run x.bit -- -x` forward `-x` to the program instead of
// rejecting it as an unknown flag of `bit run`'s own; `compiler/build.bit`'s
// `runForwardedArgs` implements the identical rule to build the argv it
// actually forwards, and the two must agree.
fn cliScanArgs(a: []string, start: int, spec: CliSpec): (string, int) {
  let operands = 0
  let surplusAt = 0 - 1
  let sawSeparator = false
  let i = start
  while (i < len(a)) {
    let tok = a[i]
    if (!sawSeparator && tok == "--") {
      sawSeparator = true
    } else if (!sawSeparator && cliLooksLikeFlag(tok)) {
      if (!cliKnowsFlag(spec, tok)) {
        return tok, 0 - 1
      }
      if (cliFlagTakesValue(spec, tok)) {
        i = i + 1
      }
    } else {
      operands = operands + 1
      if (spec.maxOperands >= 0 && operands > spec.maxOperands && surplusAt < 0) {
        surplusAt = i
      }
    }
    i = i + 1
  }
  return "", surplusAt
}

// A flag standing where an OPERAND was expected, reported. `add`, `up` and
// `remove` are absent from the table above because `pmcli.bit` parses their
// flags, but each reads its first argument as a package spec or name — so an
// unrecognised flag there became a dependency rather than a usage error, and
// `bit add --bogus` derived the vanity URL `https://--bogus` and issued a
// NETWORK REQUEST for it (#2107).
//
// Returns true having already reported, so the caller's next line is its own
// usage exit code; it is not this function's business to pick one.
fn cliRejectFlagOperand(sc: string, tok: string, usage: string): bool {
  if (!cliLooksLikeFlag(tok)) {
    return false
  }
  eprint("bit ${sc}: unknown flag '${tok}'\n")
  eprint(usage)
  return true
}

// The subcommand list `bit --help`, `bit -h` and `bit help` print (#2233).
//
// One line each, because the flags live on the subcommands and repeating them
// here would be a second copy to go stale. `selfcheck` and the `--dump-*`
// surfaces are omitted for the same reason they are omitted from `bitUsage()`:
// they belong to the gate and to the differential harnesses, not to a user.
fn bitHelpText(): string {
  return "usage: bit <subcommand> [arguments]\n\n" +
    "  build     compile a module to a native executable or a relocatable object\n" +
    "  run       compile a module for the host, run it, exit with its status\n" +
    "  check     parse, type-check and validate a module\n" +
    "  test      build and run a module's `test_<name>` functions\n" +
    "  fmt       rewrite Bit sources in the one canonical style\n" +
    "  doc       print a module's exported surface\n" +
    "  lint      report style and correctness findings\n" +
    "  lsp       speak the language server protocol on stdin/stdout\n" +
    "  ar        bundle relocatable objects into an archive\n" +
    "  init      write a minimal bit.json in the current directory\n" +
    "  add       add a dependency to bit.json and bit.lock\n" +
    "  up        refresh dependencies against their current refs (alias: update)\n" +
    "  remove    remove a dependency from bit.json and bit.lock\n" +
    "  list      print each direct dependency's name, spec and resolved commit\n" +
    "  why       print the path(s) from bit.json to a dependency\n" +
    "  version   print the compiler version\n\n" +
    "Run `bit <subcommand> --help` for that subcommand's flags.\n"
}

// Runs ahead of `main`'s dispatch. Answers `--help`, refuses an unrecognised
// flag, and EXITS on either; returns normally when argv holds nothing this
// layer owns, which is the common case.
//
// Help goes to STDOUT and exits 0 — it is what was asked for, not an error.
// A rejection goes to stderr and exits 2, not 1: this repo already spends 2 on
// every usage error (no arguments, unknown subcommand, missing operand) and 1
// on work that ran and failed. A script that cannot tell "you typed it wrong"
// from "your code does not compile" is the complaint #2019 fixed for signals.
fn cliFrontEnd(a: []string) {
  if (len(a) < 2) {
    return
  }
  if (a[1] == "help" || pmIsHelpFlag(a[1])) {
    print(bitHelpText())
    exit(0)
    return
  }
  let (spec, known) = cliSpecFor(a[1])
  if (!known) {
    return
  }
  // Help wins over rejection, so `bit build --nope --help` explains itself
  // rather than scolding — and `--help` is answered from the same table the
  // rejection reads, so the two can never describe different flag sets.
  //
  // Stops at the first literal `--` (#2399): once end-of-flags has been
  // signalled, a LATER `--help` is a program argument, not a request for
  // `bit run`'s own help — `bit run prog.bit -- --help` must reach the
  // program, matching `cliScanArgs`'s identical separator rule below.
  let i = 2
  while (i < len(a)) {
    if (a[i] == "--") {
      break
    }
    if (pmIsHelpFlag(a[i])) {
      print(spec.usage)
      exit(0)
      return
    }
    i = i + 1
  }
  let (bad, surplusAt) = cliScanArgs(a, 2, spec)
  if (len(bad) > 0) {
    eprint("bit ${a[1]}: unknown flag '${bad}'\n")
    eprint(spec.usage)
    exit(2)
    return
  }
  // #2023: an argument past the operands a subcommand reads is REPORTED, never
  // dropped. `bit run x.bit alpha beta` used to build, discard both, and exit
  // 0, so a mistyped flag and a program's own argv disappeared the same way.
  if (surplusAt >= 0) {
    eprint("bit ${a[1]}: unexpected argument '${a[surplusAt]}'\n")
    eprint(spec.usage)
    exit(2)
  }
}
