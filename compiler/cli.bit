// compiler/cli.bit — the argv front end every subcommand passes through, and
// the one place the CLI's accepted surface is written down (#2107).
//
// THE DEFECT THIS REMOVES. `bit check --version <broken-module>` exited 0
// having checked nothing: `--version` was consumed as the module path, the
// loader found no source under it, no diagnostic was produced, and the exit
// code reported success. `--bogus` and `-x` did the same, and `bit run --help`
// answered `bit: --help: NoMain`. A verification command that silently verifies
// nothing is worse than one that crashes — it turns a CI step green over code
// nobody looked at.
//
// ONE TABLE IS THE WHOLE SURFACE. `cliSpecs()` carries, per subcommand, the
// flag spellings its parser understands AND the usage block a user is shown.
// Both are spelled out rather than derived from one another: deriving the
// accepted set by scanning the help prose would mean reflowing a description
// silently changes which flags the compiler accepts. They sit one line apart
// instead, so drift is visible in review.
//
// WHAT THIS LAYER DOES NOT DO. It never consumes an operand and never decides
// what a subcommand means: it refuses an unrecognised flag and returns.
// Positional arity stays with each subcommand. `add`, `up`, `update` and
// `remove` are absent from the table on purpose — `pmcli.bit` parses and
// documents its own flags (#2267) and re-doing it here would be two answers to
// one question.
//
// `selfcheck` and the six `--dump-*` surfaces are absent for the same reason
// they are absent from `bitUsage()`: they are the gate's and the differential
// harnesses' entry points, not a user's, and the harnesses pass them exactly
// one argument.

// One subcommand's argv contract.
struct CliSpec {
  name: string,
  // Every flag spelling the subcommand's parser accepts, space-delimited and
  // space-terminated at BOTH ends so `" ${tok} "` is a whole-token test rather
  // than a prefix match — without the sentinels, `-o` would match `-out`.
  //
  // A spelling written with a trailing `=` takes a VALUE: the token after it is
  // that value and is never itself examined as a flag. Without that, `bit build
  // x.bit -o -weird` would reject the output path it was just told to write.
  flags: string,
  usage: string,
}

// The accepted surface. Every entry here is what `main`'s dispatch and the
// subcommand's own parser actually implement — verified against them, not
// aspirational.
function cliSpecs(): []CliSpec {
  return [
    CliSpec{ name: "build", flags: " -o= -c --emit-obj --freestanding -t= --target= ",
      usage: "usage: bit build <file.bit|dir> [-o <out>] [-c] [--freestanding] [--target <triple>]\n" +
        "  -o <out>             write the output here (default: the source's stem)\n" +
        "  -c, --emit-obj       emit a relocatable object instead of an executable\n" +
        "  --freestanding       compile with no prelude; requires -c\n" +
        "  -t, --target <triple>  x86_64-linux | aarch64-linux | aarch64-macos (default: host)\n" },
    CliSpec{ name: "run", flags: " ",
      usage: "usage: bit run <file.bit|dir>\n" +
        "  Builds the module for the host, runs it, and exits with its status.\n" +
        "  Takes no flags and forwards no arguments to the program.\n" },
    CliSpec{ name: "check", flags: " ",
      usage: "usage: bit check <file.bit|dir>\n" +
        "  Parses, type-checks and validates the module. Exit 1 iff anything was\n" +
        "  reported; silent exit 0 for a clean module. Takes no flags.\n" },
    CliSpec{ name: "test", flags: " ",
      usage: "usage: bit test <file.bit|dir>\n" +
        "  Builds and runs the module's top-level `function test_<name>()`\n" +
        "  functions, one process each. Takes no flags.\n" },
    CliSpec{ name: "fmt", flags: " --check ",
      usage: "usage: bit fmt [--check] <path>...\n" +
        "  --check              write nothing; name every file that is not canonical\n" },
    CliSpec{ name: "doc", flags: " --json ",
      usage: "usage: bit doc [--json] <module-dir>\n" +
        "  --json               emit the exported surface as JSON instead of text\n" },
    CliSpec{ name: "lint", flags: " --json --stats ",
      usage: "usage: bit lint [--json] [--stats] [<path>...]\n" +
        "  --json               emit findings as JSON instead of rendered diagnostics\n" +
        "  --stats              report the active lint-directive overrides, not findings\n" +
        "  With no path, lints `.`.\n" },
    CliSpec{ name: "lsp", flags: " ",
      usage: "usage: bit lsp\n" +
        "  Speaks the language server protocol on stdin/stdout until the client\n" +
        "  closes the stream. Takes no flags and no operands.\n" },
    CliSpec{ name: "ar", flags: " -t= --target= ",
      usage: "usage: bit ar <out.a> <obj.o>... [--target <triple>]\n" +
        "  -t, --target <triple>  write the archive in this target's format (default: host)\n" +
        "  Output-first, unlike GNU ar: the FIRST operand is the archive written.\n" },
    CliSpec{ name: "version", flags: " ",
      usage: "usage: bit version\n" +
        "  Prints `bit <version>` on stdout. Also spelled --version and -V.\n" },
  ]
}

// The spec for `name`, and whether there is one. A subcommand with no entry is
// not this layer's business and is left to `main`'s dispatch untouched.
function cliSpecFor(name: string): (CliSpec, bool) {
  for s of cliSpecs() {
    if (s.name == name) {
      return s, true
    }
  }
  return CliSpec{ name: "", flags: " ", usage: "" }, false
}

// Whether `spec`'s parser accepts the flag `tok`, in either of the two ways the
// table can spell it.
function cliKnowsFlag(spec: CliSpec, tok: string): bool {
  return contains(spec.flags, " ${tok} ") || contains(spec.flags, " ${tok}= ")
}

// Whether `tok` consumes the argument after it.
function cliFlagTakesValue(spec: CliSpec, tok: string): bool {
  return contains(spec.flags, " ${tok}= ")
}

// Whether `s` is meant as a flag rather than as an operand. A lone `-` is the
// conventional name for standard input and is left to the subcommand; `--`
// would be the end-of-flags separator, which nothing here implements yet, so it
// is reported as unknown rather than silently ignored.
function cliLooksLikeFlag(s: string): bool {
  return len(s) > 1 && s[0] == '-'
}

// The first flag in `a[start:]` that `spec` does not accept, or "" when every
// one of them is known. Operands are skipped, and a value-taking flag's value
// is skipped with it.
function cliFirstUnknownFlag(a: []string, start: int, spec: CliSpec): string {
  let i = start
  while (i < len(a)) {
    let tok = a[i]
    if (cliLooksLikeFlag(tok)) {
      if (!cliKnowsFlag(spec, tok)) {
        return tok
      }
      if (cliFlagTakesValue(spec, tok)) {
        i = i + 1
      }
    }
    i = i + 1
  }
  return ""
}

// A flag standing where an OPERAND was expected, reported. `add`, `up` and
// `remove` are absent from the table above because `pmcli.bit` parses their
// flags, but each reads its first argument as a package spec or name — so an
// unrecognised flag there became a dependency rather than a usage error, and
// `bit add --bogus` derived the vanity URL `https://--bogus` and issued a
// NETWORK REQUEST for it (#2107).
//
// Returns true having already reported, so the caller's next line is its own
// usage exit code; it is not this function's business to pick one.
function cliRejectFlagOperand(sc: string, tok: string, usage: string): bool {
  if (!cliLooksLikeFlag(tok)) {
    return false
  }
  eprint("bit ${sc}: unknown flag '${tok}'\n")
  eprint(usage)
  return true
}

// Runs ahead of `main`'s dispatch. Refuses an unrecognised flag and EXITS;
// returns normally when argv holds nothing this layer owns, which is the
// common case.
//
// Exit 2, not 1: this repo already spends 2 on every usage error (no arguments,
// unknown subcommand, missing operand, `bit lint`'s own unknown flag) and 1 on
// work that ran and failed. A script that cannot tell "you typed it wrong" from
// "your code does not compile" is the same complaint #2019 fixed for signals.
function cliFrontEnd(a: []string) {
  if (len(a) < 2) {
    return
  }
  let (spec, known) = cliSpecFor(a[1])
  if (!known) {
    return
  }
  let bad = cliFirstUnknownFlag(a, 2, spec)
  if (len(bad) == 0) {
    return
  }
  eprint("bit ${a[1]}: unknown flag '${bad}'\n")
  eprint(spec.usage)
  exit(2)
}
