// compiler/checkproject.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// Type-checks every module of a loaded project into ONE shared TypeContext, in
// module-id order — which the loader guarantees is dependency order, so each
// module's imports are already checked (their type maps populated) by the time
// it binds them. Returns the checkers, indexed by module id, for lowering.
// A checker over one file, with diagnostics that render against its real path —
// the single-file entry `check` and a single-file `build` share. The `--dump-*`
// entries deliberately do not use it: they take a bare source string and print
// their inference output whether or not the program is valid.
fn checkFile(path: string, src: string): Checker {
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  let tree = parseSourceD(src, f, d)
  let c = newChecker(tree, src, newTypeContext())
  c.diags = d
  c.files = [f]
  c.fileStarts = [0]
  // A tree the parser rejected has holes the checker would read as real nodes,
  // so its errors are noise on top of the parse errors that caused them. The
  // seed stops here for the same reason.
  if (hasErrors(d)) {
    return c
  }
  checkModule(c)
  return c
}

// Prints any check errors and reports whether the caller must stop. Lowering an
// invalid program is exactly the silent miscompile the validator exists to
// prevent, so `build` must not proceed past a true here.
//
// Deliberately silent on a warnings-only list: `check`/`build`/`doc` call this
// at an EARLIER gate too (before the type-check phase that may add more errors
// to the same shared sink), and rendering warnings here as well as at
// `reportCheckDiagnostics` below would print them twice. The earlier gate's
// warnings ride along in `d.list` untouched until the pipeline's one true final
// call renders the whole accumulated list in one shot.
fn reportCheckErrors(d: Diagnostics): bool {
  if (!hasErrors(d)) {
    return false
  }
  eprint(renderDiags(d))
  return true
}

// The pipeline's FINAL gate only — `checkCmd`/`buildIr`/`docCmd` each call
// `reportCheckErrors` once after the parse/resolve phase and this once after
// the type-check phase that follows it, on the SAME `Diagnostics`. A warning
// (E0048 shadowing a predeclared identifier is the only one today) never bumps
// `errorCount`, so a warnings-only list must still render here — otherwise it
// is silently dropped forever, which was the whole bug (#2491). Still returns
// `hasErrors(d)`, unchanged, so a warning alone never fails the build.
fn reportCheckDiagnostics(d: Diagnostics): bool {
  if (len(d.list) == 0) {
    return false
  }
  eprint(renderDiags(d))
  return hasErrors(d)
}

// #4279: the structural signal that a directory's `.bit` files were never
// meant to share ONE flat namespace (project.bit's `SrcModule` contract).
// SPEC §17.4 permits an executable module EXACTLY one `main`, so two or more
// FILES each declaring their own can only mean the directory holds
// independent programs, never a real module that merely has a bug — a real
// module's own accidental duplicate `main` written twice in the SAME file is
// still ordinary `duplicate_declaration`/E0042, untouched here, because this
// counts DISTINCT FILES, not raw declarations.
//
// `checkCmd` (main.bit) uses this to name the real problem with ONE
// diagnostic instead of letting every sibling name collision report its own
// E0042: #4279 measured 1429 of them pointing `bit check` at `_tests_/bit/`,
// a directory of independent gate harnesses each with its own `main`.
//
// Relies on `m.tree`'s declarations appearing in non-decreasing file-index
// order: `loadModuleAt` (project.bit) concatenates a module's files in their
// sorted order and parses the result as ONE tree, so a later declaration's
// span can never start before an earlier declaration's file. That lets one
// forward scan count distinct files with no set/map needed.
fn rootMainFileCount(p: Project): int {
  let m = p.mods[p.root]
  let count = 0
  let lastFileIdx = -1
  for d of kidsOf(m.tree, m.tree.root) {
    let decl = lintUnwrapExport(m.tree, d)
    if (decl == 0 || getNode(m.tree, decl).tag != Tag.FuncDecl) {
      continue
    }
    let k = kidsOf(m.tree, decl) // [recv, name, generics, params, result, body]
    if (k[0] != 0 || nodeText(m.tree, m.source, k[1]) != "main") {
      continue // a method (has a receiver), or a func not named "main"
    }
    let fileIdx = fileOf(m.fileStarts, getNode(m.tree, decl).span.start).fileIdx
    if (fileIdx != lastFileIdx) {
      count = count + 1
      lastFileIdx = fileIdx
    }
  }
  return count
}

// The `bit check <path>` refusal for a directory `rootMainFileCount` flags,
// or "" when the module is fine — kept apart from the count so `checkCmd`
// reads a single "" check rather than re-deriving the threshold itself.
fn nonModuleDirProblem(p: Project): string {
  let n = rootMainFileCount(p)
  if (n < 2) {
    return ""
  }
  let total = len(p.mods[p.root].fileNames)
  return "${n} of ${total} .bit file(s) each declare their own 'main' -- " +
    "this directory holds independent programs, not one module (SPEC " +
    "§17.1: a directory's .bit files share one namespace); check a single " +
    "file, or point at a directory that really is one module"
}

// Phase 1 of the front end: build a Checker per module and run the RESOLVER over
// each, in module-id order.
//
// Split out from `checkProject` so `check`/`build` can report module-graph
// diagnostics (E0040/E0042/E0044/E0045/…) BEFORE the parse-error gate, which is
// where the seed reports them: its `loadProject` resolves as it loads, so a
// resolve error on a tree the parser also rejected still reaches the user. bit2
// resolved inside the check phase, behind that gate, so a malformed `import`
// reported its parse errors and then silently dropped the E0045 the seed emits.
fn resolveProject(p: Project): []Checker {
  // Traits (SPEC §10.7, #3369): `use` injection mutates each module's tree
  // BEFORE resolve ever sees it, so an injected method is resolved and
  // checked exactly like one the class wrote itself. Every front end
  // reaches the checker through here (see the comment on `entryModule`
  // below), so this is the one place it has to run.
  injectTraits(p)
  let ctx = newTypeContext()
  // The LOADER's sink and file map, not a fresh pair: it already registered
  // every file (it read them) and already reported any lex/parse error against
  // them. One sink for the whole build — an error in an imported module is still
  // this build's error — and check errors land beside the parse errors that
  // preceded them, in source order.
  let mods = []Checker(0)
  let i = 0
  while (i < len(p.mods)) {
    let c = newChecker(p.mods[i].tree, p.mods[i].source, ctx)
    c.moduleId = i
    // SPEC §17.4's entry point belongs to the root module alone, and the loader
    // is the only thing that knows which id that is. Every front end reaches the
    // checker through here — `check`, `build`, `bit doc` and the LSP all call
    // resolveProject — so this is the one place it has to be set.
    c.entryModule = i == p.root
    c.importPaths = p.mods[i].imports
    c.diags = p.diags
    c.files = p.mods[i].files
    c.fileStarts = p.mods[i].fileStarts
    mods = append(mods, c)
    i = i + 1
  }
  // Hand out the shared table only now: `append` may move the backing array, so
  // a checker given the slice mid-build would hold a stale, short view of it.
  i = 0
  while (i < len(mods)) {
    mods[i].mods = mods
    i = i + 1
  }
  // Resolve before checking, in module-id order. The loader loads imports first,
  // so id order IS dependency order — every module's imports are already in
  // `resolved` by the time it resolves, which is what lets an import be checked
  // against its target's exports. The prelude self-guards: when module i IS the
  // prelude, `resolved` has only ids 0..i-1, so `rInjectPrelude` finds
  // prelude >= len(allModules) and skips.
  let resolved = []Module(0)
  i = 0
  while (i < len(mods)) {
    let rm = resolveModule(p.diags, p.mods[i], resolved, p.prelude, true, i == p.root)
    resolved = append(resolved, rm)
    // Hand this module's symbol table to its checker so checkExprType can type an
    // identifier from the decl it resolves to rather than the flat env.
    mods[i].symbols = rm.symbols
    mods[i].nodeSymbols = rm.nodeSymbols
    i = i + 1
  }
  return mods
}

// Phase 2: type-check every already-resolved module.
fn checkResolved(p: Project, mods: []Checker) {
  let i = 0
  while (i < len(mods)) {
    collectExports(mods[i])
    // Before bindImports: SPEC §17.5, a name the module declares shadows the
    // prelude name, but bindImports needs to know the module's own type decls
    // to honor that — collectTypeDecls only writes c.typeDecls and mints no
    // types, so running it early (it also runs again at the top of
    // checkModule, harmlessly) is safe.
    collectTypeDecls(mods[i])
    bindImports(mods[i], p.prelude)
    checkModule(mods[i])
    i = i + 1
  }
  // AFTER every module, because an instantiation is recorded when a CALL is
  // checked and the call can live in any module. A generic body is checked once
  // against its own rigid type params, so an interpolation operand naming `T` is
  // deliberately skipped there (validateexpr.bit's vInterp); this is the pass
  // that judges those operands per monomorphization (#1882).
  validateInstantiations(mods)
}

fn checkProject(p: Project): []Checker {
  let mods = resolveProject(p)
  checkResolved(p, mods)
  return mods
}

// Binds every name a module imports, before its own declarations are collected —
// an import is in scope for the whole module, including decls written above it.
// The prelude's exports bind first so an explicit import of the same name wins.
fn bindImports(c: Checker, preludeId: int) {
  if (preludeId >= 0 && preludeId < len(c.mods) && preludeId != c.moduleId) {
    let p = c.mods[preludeId]
    for (n, _) of p.exports {
      // SPEC §17.5: a name the module declares shadows the prelude name —
      // mirrors the skip rInjectPrelude (resolve.bit) already makes on the
      // resolver side. Without it, importName's copyQualified overwrites
      // c.userTypes[n] with the prelude's TypeId, and declTypeOf's memo
      // (userTypeLookup) then returns that id for the local decl, so the
      // local type never gets registered at all.
      if (c.typeDecls[n] != 0) {
        continue
      }
      importName(c, p, preludeId, n, n)
    }
  }
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0 || getNode(c.tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let dk = kidsOf(c.tree, d)
    let pathNode = getNode(c.tree, dk[1])
    let path = stringLitText(c.source, pathNode.span)
    let (mid, found) = c.importPaths[path]
    if (!found || mid < 0 || mid >= len(c.mods)) {
      continue // unresolved import: already reported by the loader
    }
    let e = c.mods[mid]
    let body = getNode(c.tree, dk[0])
    if (body.tag == Tag.ImportNs || body.tag == Tag.ImportStar) {
      bindNamespaceImport(c, e, mid, dk[0])
      continue
    }
    if (body.tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(c.tree, dk[0]) {
      let ik = kidsOf(c.tree, item)
      let nn = getNode(c.tree, ik[0])
      let name = c.source[nn.span.start:nn.span.end]
      let alias = name
      if (ik[1] != 0) {
        let an = getNode(c.tree, ik[1])
        alias = c.source[an.span.start:an.span.end]
      }
      importName(c, e, mid, name, alias)
    }
  }
}

// `import ns from "..."` / `import * as ns from "..."` (#1154): binds every one
// of the module's exports under the dotted key "ns.name", which is exactly what
// `import { name } from "..."` would have bound under the bare name. Every
// downstream lookup — funcResultLookup, declOwner, callQualified, the const
// tables — is name-keyed, so nothing else has to learn what a namespace is.
fn bindNamespaceImport(c: Checker, e: Checker, mid: int, body: int) {
  let nn = getNode(c.tree, kidsOf(c.tree, body)[0])
  let alias = c.source[nn.span.start:nn.span.end]
  c.namespaces[alias] = mid
  for (n, _) of e.exports {
    importName(c, e, mid, n, alias + "." + n)
  }
}

// The dotted lookup key for `ns.member`, or "" when the member's receiver is not
// a bound namespace (an ordinary field or method access). Only an Ident receiver
// can name a namespace, so a shadowing local never reaches here as a Member.
fn nsQualifiedName(c: Checker, node: int): string {
  let k = kidsOf(c.tree, node)
  if (getNode(c.tree, k[0]).tag != Tag.Ident) {
    return ""
  }
  let bn = getNode(c.tree, k[0]).span
  let base = c.source[bn.start:bn.end]
  let (_, ok) = c.namespaces[base]
  if (!ok) {
    return ""
  }
  let mn = getNode(c.tree, k[1]).span
  return base + "." + c.source[mn.start:mn.end]
}

// Whether `name` is one of the FuncDecl's declared generic type parameters.
fn isTypeParamName(c: Checker, decl: int, name: string): bool {
  let g = kidsOf(c.tree, decl)[2]
  if (g == 0) {
    return false
  }
  let ps = kidsOf(c.tree, g)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    if (c.source[nm.span.start:nm.span.end] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// The concrete result type of a call to a generic function: bind every type
// param from the arguments, then resolve the declared result node with those
// bindings in force. Returns -1 when the rule does not apply (non-generic, or no
// declared result) so the caller falls back.
//
// A bare `T` result and a composite `[]T` are the SAME operation — only the node
// shape differs — so both go through typeFromNodeIn. Handling only the bare case
// (as this did) left `[]T` resolving with `T` unsubstituted: `len()` still worked
// (it ignores the element type) but indexing or iterating the result could not
// compute an element width, and lowering silently stubbed the whole caller out.
// The type arguments an EXPLICIT instantiation writes (`ident<i32>(7)`), in
// declaration order, or an empty list when the call writes none — kid 1 of a
// Call node is its `<...>` list.
//
// An explicit argument OUTRANKS structural inference from the argument types.
// Inferring `ident<i32>(7)` from the argument alone defaults the untyped
// literal `7` to i64 and so contradicts what the source plainly says; the seed
// reads the written list first, and this is what makes the two agree. An entry
// that fails to resolve comes back 0, and every caller falls back to structural
// inference for it rather than committing to a wrong answer.
fn explicitCallTypeArgs(c: Checker, callNode: int): []int {
  let out = []int(0)
  if (callNode == 0 || getNode(c.tree, callNode).tag != Tag.Call) {
    return out
  }
  let ck = kidsOf(c.tree, callNode)
  if (len(ck) < 2 || ck[1] == 0) {
    return out
  }
  let tas = kidsOf(c.tree, ck[1])
  let i = 0
  while (i < len(tas)) {
    out = append(out, typeFromNode(c, tas[i]))
    i = i + 1
  }
  return out
}

fn genericResultAt(c: Checker, name: string, callNode: int): int {
  let fr = funcRefAt(c, calleeNodeOf(c, callNode), name)
  let decl = fr.decl
  if (decl == 0) {
    return -1
  }
  // An imported callee's decl indexes ITS module's node arena; reading it
  // against this module's tree is an out-of-range panic at best and a silently
  // unrelated node at worst.
  let oc = fr.owner
  if (isExternDecl(oc.tree, decl)) {
    return -1 // SPEC 11.7: never generic
  }
  let dk = kidsOf(oc.tree, decl)
  if (dk[2] == 0 || dk[4] == 0) {
    return -1 // not generic, or no declared result: the plain path handles it
  }
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let explicit = explicitCallTypeArgs(c, callNode)
  let sub = noSubst()
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    // A type param no parameter mentions (`function zero<T>(): T`) stays
    // unbound and resolves as it always did — no worse than before.
    let bound = 0
    if (ti < len(explicit)) {
      bound = explicit[ti]
    }
    if (bound == 0) {
      bound = bindTypeParamAtCall(oc, c, callNode, params, tpname)
    }
    if (bound != 0) {
      sub.names = append(sub.names, tpname)
      sub.types = append(sub.types, bound)
    }
    ti = ti + 1
  }
  if (len(sub.names) == 0) {
    return -1 // nothing bound: the plain path renders it just as well
  }
  let r = typeFromNodeIn(oc, dk[4], sub)
  if (r == 0) {
    return -1
  }
  return r
}

// Whether a resolved free function is generic (has a non-empty `<...>` list).
// Every read goes through `fr.owner.tree`: the decl may belong to an imported
// module, whose node indices only mean anything in ITS tree.
fn funcRefIsGeneric(fr: FuncRef): bool {
  if (fr.decl == 0) {
    return false
  }
  if (isExternDecl(fr.owner.tree, fr.decl)) {
    return false // SPEC 11.7: never generic
  }
  let gp = kidsOf(fr.owner.tree, fr.decl)[2]
  return gp != 0 && len(kidsOf(fr.owner.tree, gp)) > 0
}
