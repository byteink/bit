// compiler/classinit.bit — `init` constructors (SPEC §10.4, #3371): `class
// Account { init(opening: i64)! { ... } }`, called as `Account(500)?`. New
// sibling file rather than growing checkbind.bit/fmt.bit/fmtdispatch.bit/
// lowercall.bit, all of which sit at or near the 800-line ceiling; every
// other file below carries only the smallest hook needed to reach these.
//
// DESIGN: `init` is parsed into the IDENTICAL func_decl/receiver shape an
// ordinary in-body method gets (parsertype.bit's parseMethodMember, #3367) —
// same name/generics/params/result/body kid layout, receiver type the
// enclosing class, receiver name kid 0 (implicit `this`). That is what lets
// every pass that discovers a method by walking the arena for
// func_decl-with-receiver (collectFuncDecl/buildSignatures in checkbindfunc.bit,
// the fallible-body validation in validateattr.bit's vFuncDecl, method
// emission in lowering) pick `init` up with ZERO changes — the only new code
// is at the few call sites that must recognize `init` BY NAME: the
// `T(...)` construction call itself (checkexpr.bit/validatecall.bit/
// lowercall.bit) and its printed form (fmt.bit).
//
// `init` is a CONTEXTUAL keyword, the same shape #3369 gave `use`: it lexes
// as an ordinary Ident and stays usable as one everywhere outside a class
// body's member-start position — `git grep -nw init -- '*.bit'` (188 hits)
// found it in heavy use as a local variable name across checkbind.bit,
// checkgeneric.bit, lintappend.bit, parserstmt.bit and lowerctrl.bit, so
// reserving it outright would force renaming all of those for a purely
// additive feature.

// ---- parsing (parsertype.bit's parseClassMember calls into here) ----------

// Unambiguous the same way `atUseStmt` is: a class member's own name is
// always followed by `:` (a field) or `(`/`<` (a method) — an ordinary
// method named "init" is therefore impossible to write once this fires, which
// is exactly the "reserved inside a class body" SPEC asks for. Requiring the
// immediate `(` (rather than accepting any 'init' identifier) means a
// composite-literal field key spelled `init` two tokens later never reaches
// this check at all.
fn atInitDecl(p: Parser): bool {
  return peekKind(p) == Kind.Ident && curText(p) == "init" && peekKindAt(p, 1) == Kind.LParen
}

// `init_member = "init" "(" params ")" ["!" [type]] block`. No colon/result
// type: init always yields the class itself (never written), so the only
// declarable shape past the params is fallible-or-not — `init(...)!` /
// `init(...)!E`, built directly as Tag.Fallible[VoidType, err] rather than
// through parseResultType, which requires a leading type before the '!' that
// init has no syntax for.
fn parseInitMember(p: Parser, className: int, classGenerics: int): int {
  let name = expectIdent(p) // 'init' — contextual, an ordinary Ident token
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Bang)) {
    let ok = mkNode(p, Tag.VoidType, 0, []int(0))
    let err = 0
    let k = peekKind(p)
    if (k == Kind.Ident || k == Kind.LBracket || k == Kind.KwMap || k == Kind.KwChan) {
      err = parseType(p)
    }
    result = mkNode(p, Tag.Fallible, 0, [ok, err])
  }
  let nameSpan = getNode(p.tree, name).span
  let recv = mkSpanNode(
    p, Tag.Receiver, 0, [0, classTypeRef(p, className, classGenerics)],
    nameSpan.start, nameSpan.end,
  )
  let body = parseBlock(p)
  let generics = dupGenericParams(p, classGenerics, nameSpan)
  return mkNode(p, Tag.FuncDecl, 0, [recv, name, generics, params, result, body])
}

// ---- shared lookup (checker + lowering + fmt) ------------------------------

// `decl`'s own 'init' func_decl member, or 0. Mirrors lowerlayout.bit's
// structFieldNodes' Export-unwrapping walk, but keeps the FuncDecl (fields
// skip it there) and filters to the one named "init".
//
// Keeps the LAST match, not the first: collectFuncDecl/buildSignatures
// (checkbindfunc.bit) register a method by overwriting methodResults/methodSigs
// per node visited, so a duplicate 'init' (E0121, reported separately by
// vClassInitDuplicate) leaves the LAST declaration as what a construction
// call is actually validated and linked against — agreeing with this lookup
// here keeps a cascaded arity diagnostic honest about which signature would
// really be called, rather than naming the shadowed first one.
fn classInitDeclNode(oc: Checker, decl: int): int {
  let raw = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let found = 0
  let i = 0
  while (i < len(raw)) {
    let f = raw[i]
    if (getNode(oc.tree, f).tag == Tag.Export) {
      f = kidsOf(oc.tree, f)[0]
    }
    if (getNode(oc.tree, f).tag == Tag.FuncDecl) {
      let nm = getNode(oc.tree, kidsOf(oc.tree, f)[1])
      if (oc.source[nm.span.start:nm.span.end] == "init") {
        found = f
      }
    }
    i = i + 1
  }
  return found
}

// `classTy`'s declared 'init' func_decl node (in its OWNING module's tree —
// see typeOwner), or 0 when the class declares none. The one presence check
// every caller below gates on before doing anything init-specific.
fn classInitNode(c: Checker, classTy: int): int {
  let decl = structDeclOf(c, classTy)
  if (decl == 0) {
    return 0
  }
  return classInitDeclNode(typeOwner(c, classTy), decl)
}

// Is `classTy`'s 'init' fallible (`init(...)!`)? Caller must already know
// `initNode` is nonzero. Reads back through the shared methodResults table
// collectFuncDecl already populated — init is just a method named "init" to
// that pass — rather than re-deriving from the node, so this agrees with
// whatever buildSignatures recorded.
fn classInitFallible(c: Checker, classTy: int): bool {
  let rty = methodResultLookup(c, "${classTy}.init")
  return rty != 0 && c.ctx.types[rty].kind == TypeKind.Fallible
}

// The error type of a fallible `classTy.init`; caller must already know it is
// fallible (classInitFallible).
fn classInitErrType(c: Checker, classTy: int): int {
  return c.ctx.types[methodResultLookup(c, "${classTy}.init")].errTy
}

// `Account(500)`'s own result type: the class itself, or — when its 'init' is
// fallible — that Fallible-wrapped type, exactly as any other fallible call's
// callee-side result is computed (checkexpr.bit's checkCall already does the
// analogous method.result-lookup for `recv.method(...)`). `initNode` is
// `classInitNode(c, classTy)`, passed in so callers that already looked it up
// (to decide whether to route here at all) never repeat the walk.
fn classConstructResultType(c: Checker, classTy: int, initNode: int): int {
  if (initNode == 0) {
    return classTy
  }
  if (classInitFallible(c, classTy)) {
    return mkFallible(c.ctx, classTy, classInitErrType(c, classTy))
  }
  return classTy
}

// True when type id `t` is a type parameter (`T` in `fn f<T: Api>`).
fn isTypeParamId(c: Checker, t: int): bool {
  return c.ctx.types[t].kind == TypeKind.TypeParam
}

// True when `name`, written as a callee, is a type parameter of the declaration
// being checked: `T(...)` has no meaning (SPEC §10.4.1, E0184).
fn isTypeParamCallee(c: Checker, name: string): bool {
  let ut = userTypeLookup(c, name)
  return ut != 0 && isTypeParamId(c, ut)
}

// The class `name(...)` constructs, written at call `node`: the INSTANTIATION
// when the call spells type arguments (`Pair<i64, string>(7, "s")`) or, with
// none written, when `init`'s arguments infer them (`Pair(7, "s")`, SPEC §10.4);
// the bare declaration's type otherwise. A method is emitted per instantiation
// (`lowerMethodInstances`, lowerinstemit.bit), so a call resolved to the
// template names an `init$t<template>` symbol nothing defines. One resolution
// for the checker (`checkCallIdentConv`), the validator (`vClassConstructIfInit`)
// and the lowerer (`lowerCallIdentOps8`), so the three cannot construct
// different types. An arity mismatch instantiates nothing
// (`instantiateNamed`, checkinst.bit) and is E0058 (`vConstructTypeArgs`); a
// type parameter no argument binds leaves the template and is E0068
// (`vConstructInferGap`).
fn constructClassType(c: Checker, node: int, name: string): int {
  let ut = userTypeLookup(c, name)
  // A type parameter is a name `userTypeLookup` resolves, but nothing a call
  // constructs (#6402): its bound is an interface, which declares no `init`.
  // Answering its id made `T(2)` a conversion to `T`, which every pass accepted
  // and lowering emitted as a numeric `convert` into a class pointer.
  if (ut == 0 || isTypeParamId(c, ut)) {
    return 0
  }
  if (c.ctx.types[ut].kind != TypeKind.Struct) {
    return ut
  }
  let targs = explicitCallTypeArgs(c, node)
  if (len(targs) == 0) {
    targs = inferInitTypeArgs(c, node, ut)
  }
  let inst = instantiateNamed(c, name, targs)
  if (inst == 0) {
    return ut
  }
  return inst
}

// The first `n` declared type-parameter names of method `decl` (the class's own,
// duplicated onto every method by the parser: `parseInitMember`,
// `parseStaticMethodMember`), in declaration order; empty when `decl` declares
// none. `n` is the class's parameter count: a method's own `<U>` follows them.
fn declTypeParamNames(oc: Checker, decl: int, n: int): []string {
  let out = []string(0)
  let gp = kidsOf(oc.tree, decl)[2]
  if (gp == 0) {
    return out
  }
  let tps = kidsOf(oc.tree, gp)
  let i = 0
  while (i < len(tps) && i < n) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[i])[0])
    out = append(out, oc.source[tpn.span.start:tpn.span.end])
    i = i + 1
  }
  return out
}

// The type arguments call `node` of generic class `ut` infers from its
// arguments, one per class type parameter in declaration order, 0 where no
// argument binds it: the binder a generic free function uses
// (`bindTypeParamAtCall`, checkgeneric.bit), against `init`'s parameter list, so
// `Pair(7, "s")` and `Pair(second = "s", first = 7)` bind A = i64, B = string
// exactly as `pair(7, "s")` would (SPEC §15.3). Empty for a class that is not
// generic, has no `init`, or is already an instantiation (`type IP = Pair<i64,
// i64>`).
fn inferInitTypeArgs(c: Checker, node: int, ut: int): []int {
  let out = []int(0)
  let initDecl = classInitNode(c, ut)
  if (initDecl == 0 || typeInstOfResult(c.ctx, ut) >= 0) {
    return out
  }
  let oc = typeOwner(c, ut)
  let names = declTypeParamNames(oc, initDecl, structTypeParamCount(c, ut))
  let params = kidsOf(oc.tree, kidsOf(oc.tree, initDecl)[3])
  let i = 0
  while (i < len(names)) {
    let bound = expectedCtorArg(c, node, i)
    if (bound == 0) {
      bound = bindTypeParamAtCall(oc, c, node, params, names[i])
    }
    out = append(out, bound)
    i = i + 1
  }
  return out
}

// E0058 for type arguments written on a construction call whose count is not
// the class's own: `Pair<i64>(7, "s")`, or any `<...>` on a class that is not
// generic. The same code and wording as a type-position `Pair<i64>`
// (`vGenericInstArity`, validatetyperef.bit).
fn vConstructTypeArgs(c: Checker, node: int, name: string) {
  let ut = userTypeLookup(c, name)
  let targs = kidsOf(c.tree, node)[1]
  if (ut == 0 || targs == 0 || c.ctx.types[ut].kind != TypeKind.Struct) {
    return
  }
  vTypeArgCountMismatch(c, node, name, structTypeParamCount(c, ut))
}

// E0068 for a construction call with a type parameter no argument binds:
// `class Box<T> { init(n: i64) }` called as `Box(3)`. The call then names the TEMPLATE's `init`
// (`init$t<template>`), a symbol `lowerMethodInstances` never emits, so the
// checker must refuse it rather than accept a program the backend cannot link.
// The message names the parameter and shows the written form. An argument the
// checker could not type is silence, not a diagnostic (`vGenericGap`'s safety
// rule, validategeneric.bit).
fn vConstructInferGap(c: Checker, node: int, name: string) {
  let ut = userTypeLookup(c, name)
  if (kidsOf(c.tree, node)[1] != 0 || ut == 0 || c.ctx.types[ut].kind != TypeKind.Struct) {
    return
  }
  let bound = inferInitTypeArgs(c, node, ut)
  let gap = -1
  let i = 0
  while (i < len(bound) && gap < 0) {
    if (bound[i] == 0) {
      gap = i
    }
    i = i + 1
  }
  if (gap < 0 || !vCallArgTypesKnown(c, node)) {
    return
  }
  let names = declTypeParamNames(
    typeOwner(c, ut),
    classInitNode(c, ut),
    structTypeParamCount(c, ut),
  )
  reportNoHint(
    c.diags, ecCannotInfer, vSpan(c, node),
    "cannot infer type parameter '${names[gap]}' of '${name}'; write ${name}<${commaList(names)}>(...)",
  )
}

// `names` written as a `<...>` body: `A, B`.
fn commaList(names: []string): string {
  let out = ""
  let i = 0
  while (i < len(names)) {
    if (i > 0) {
      out = out + ", "
    }
    out = out + names[i]
    i = i + 1
  }
  return out
}

// ---- bare generic class literals (#6428) -----------------------------------
//
// `Pair{ store = StrStore{ pre = "x" } }` writes no type arguments. Wherever a
// declared target exists (an annotation, a parameter, a result, a field, an
// element) it types the literal (`vPinGenericLit`); everywhere else the field
// values bind the parameters, as a construction's arguments bind `init`'s
// (`inferInitTypeArgs`), and the siblings' bounds bind what the fields leave
// (`bindBoundSiblings`, checkboundinfer.bit). A parameter still unbound is E0068
// at the literal (`vSweepGenericLits`): left as the template, the literal's
// members kept an open `K` that only failed at IR verification. `checkCompositeLitType`
// is the one place a composite literal is typed, so lowering sees the same type.

// The generic class template a literal at `lit` constructs through a bare name,
// else 0: not a composite literal, a written instantiation, a non-class, a
// non-generic class, or a type parameter.
fn bareGenericLitClass(c: Checker, lit: int): int {
  if (lit == 0 || getNode(c.tree, lit).tag != Tag.CompositeLit) {
    return 0
  }
  let tn = kidsOf(c.tree, lit)[0]
  if (getNode(c.tree, tn).tag != Tag.Ident) {
    return 0
  }
  let ut = userTypeLookup(c, nodeText(c.tree, c.source, tn))
  if (ut == 0 || isTypeParamId(c, ut) || c.ctx.types[ut].kind != TypeKind.Struct) {
    return 0
  }
  if (typeInstOfResult(c.ctx, ut) >= 0 || structTypeParamCount(c, ut) == 0) {
    return 0
  }
  return ut
}

// The type arguments literal `lit` of generic class `ut` binds, one per class
// type parameter in declaration order, 0 where nothing bound: each parameter
// from the first field value whose declared type mentions it, then from the
// siblings' bounds.
fn inferLitTypeArgs(c: Checker, lit: int, ut: int): []int {
  let oc = typeOwner(c, ut)
  let decl = structDeclOf(c, ut)
  let gens = kidsOf(oc.tree, decl)[1]
  let fields = structFieldNodes(oc, decl)
  let inits = kidsOf(c.tree, kidsOf(c.tree, lit)[1])
  let out = []int(0)
  for tp of kidsOf(oc.tree, gens) {
    let tpname = nodeText(oc.tree, oc.source, kidsOf(oc.tree, tp)[0])
    let bound = 0
    for fi of inits {
      let ik = kidsOf(c.tree, fi)
      let idx = fieldIndexByName(oc, fields, nodeText(c.tree, c.source, ik[0]))
      if (bound == 0 && idx >= 0) {
        let vt = defaultType(c, checkExprType(c, ik[1]))
        bound = bindTypeParamFromNode(oc, kidsOf(oc.tree, fields[idx])[1], vt, tpname)
      }
    }
    out = append(out, bound)
  }
  bindBoundSiblings(c, oc, gens, out)
  return out
}

// The type of composite literal `node`, whose written type is `ty`: for a bare
// generic class the instantiation its context pinned (`litPins`, check.bit),
// else the one its field values and sibling bounds infer. Left as the template
// while any argument is unbound (`instantiateNamed`), which `vSweepGenericLits`
// then reports unless a target typed it.
fn checkCompositeLitType(c: Checker, node: int): int {
  let ty = typeFromNode(c, kidsOf(c.tree, node)[0])
  let ut = bareGenericLitClass(c, node)
  if (ut == 0) {
    return ty
  }
  let (pin, pinned) = c.litPins[node]
  if (pinned) {
    return pin
  }
  let name = nodeText(c.tree, c.source, kidsOf(c.tree, node)[0])
  return instantiateNamed(c, name, inferLitTypeArgs(c, node, ut))
}

// Whether `want` is an instantiation of generic class `ut`.
fn isInstOfClass(c: Checker, want: int, ut: int): bool {
  let w = c.ctx.types[want]
  let t = c.ctx.types[ut]
  return w.kind == TypeKind.Struct &&
    typeInstOfResult(c.ctx, want) >= 0 &&
    w.name == t.name &&
    w.declModule == t.declModule
}

// A bare generic class literal judged against a declared target `want` takes
// the target as its type when `want` is an instantiation of the same class
// (`let a: Pair<f32, S> = Pair{ ... }`, an argument, a result, a field, an
// element): the target's arguments are the ones the field values must fit, and
// the ones lowering lays the object out under.
fn vPinGenericLit(c: Checker, node: int, want: int) {
  let ut = bareGenericLitClass(c, node)
  if (ut != 0 && isInstOfClass(c, want, ut)) {
    c.litPins[node] = want
  }
}

// What the end of the module owes a bare generic class literal, once every
// `vPinGenericLit` has had its turn: E0068 when no target and no field value
// decided a type parameter (`Lonely{ v = "x" }` for `class Lonely<K> { v: string
// }`; left as the template its members kept an open `K` that only failed at IR
// verification), and its slots judged against the type it ended up with, so
// `take(W{ v = 300 })` against `W<i8>` is the E0041 `W<i8>{ v = 300 }` is. One walk
// over the module's nodes like `vSweepContainerLits` (validateexpr.bit), in two
// passes: parent first (descending ids: the parser makes a node after its kids)
// pins every bare literal that is a slot of another bare literal, silently; then
// source order reports, so the diagnostics read top to bottom.
fn vSweepGenericLits(c: Checker) {
  let i = len(c.tree.nodes) - 1
  while (i >= 1) {
    if (getNode(c.tree, i).tag == Tag.CompositeLit && bareGenericLitClass(c, i) != 0) {
      vPinGenericLitSlots(c, i)
    }
    i = i - 1
  }
  i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.CompositeLit && bareGenericLitClass(c, i) != 0) {
      let (_, pinned) = c.litPins[i]
      if (!pinned) {
        vGenericLitGap(c, i)
      }
      vGenericLitSlots(c, i)
    }
    i = i + 1
  }
}

// Pins each bare generic literal that is a field value of bare generic literal
// `lit` to that field's type under `lit`'s own.
fn vPinGenericLitSlots(c: Checker, lit: int) {
  let target = checkExprType(c, lit)
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Struct) {
    return
  }
  for item of kidsOf(c.tree, kidsOf(c.tree, lit)[1]) {
    if (getNode(c.tree, item).tag == Tag.FieldInit) {
      let fk = kidsOf(c.tree, item)
      let fname = nodeText(c.tree, c.source, fk[0])
      vPinGenericLit(c, fk[1], structFieldLookup(c, "${target}." + fname))
    }
  }
}

// Every field slot of bare generic literal `lit` against its type.
fn vGenericLitSlots(c: Checker, lit: int) {
  let target = checkExprType(c, lit)
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Struct) {
    return
  }
  for item of kidsOf(c.tree, kidsOf(c.tree, lit)[1]) {
    if (getNode(c.tree, item).tag == Tag.FieldInit) {
      vLitFieldInit(c, target, item)
    }
  }
}

// E0068 for `lit`, when a type parameter is still unbound. A field value the
// checker could not type is silence, not a diagnostic (`vGenericGap`'s safety
// rule, validategeneric.bit).
fn vGenericLitGap(c: Checker, lit: int) {
  let ut = bareGenericLitClass(c, lit)
  if (ut == 0) {
    return
  }
  for fi of kidsOf(c.tree, kidsOf(c.tree, lit)[1]) {
    let ft = checkExprType(c, kidsOf(c.tree, fi)[1])
    if (ft == 0 || c.ctx.types[ft].kind == TypeKind.Invalid) {
      return
    }
  }
  let gap = firstUnbound(inferLitTypeArgs(c, lit, ut))
  if (gap < 0) {
    return
  }
  let oc = typeOwner(c, ut)
  let names = []string(0)
  for tp of kidsOf(oc.tree, kidsOf(oc.tree, structDeclOf(c, ut))[1]) {
    names = append(names, nodeText(oc.tree, oc.source, kidsOf(oc.tree, tp)[0]))
  }
  let name = nodeText(c.tree, c.source, kidsOf(c.tree, lit)[0])
  reportNoHint(
    c.diags, ecCannotInfer, vSpan(c, lit),
    "cannot infer type parameter '${names[gap]}' of '${name}'; write ${name}<${commaList(names)}>{...}",
  )
}

// ---- E0121/E0110 (checker) -------------------------------------------------

// E0121 (#3371): a class declaring a SECOND 'init'. An ordinary duplicate
// method has no guard at all today — collectFuncDecl (checkbindfunc.bit) simply
// overwrites methodResults/methodSigs with the later declaration and `bit
// check` exits 0 — but init's whole point is an unambiguous construction
// contract, so two candidates cannot be allowed to silently pick "the last
// one". Was E0109 (first free code above E0108, checktrait.bit's
// ecSelfOutsideSignature) until #4188: checktraitfield.bit's
// ecTraitFieldConflict took E0109 on a parallel, unmerged branch the same
// day (#3371 vs #3370), and neither branch could see the other's choice.
// ecTraitFieldConflict keeps E0109 (2 emission sites and 2 checkercase
// fixtures against this constant's 1 of each — "more widely emitted" per
// #4188's tie-break). Moved to E0121, the first free code above E0120
// (checktrait.bit's ecTraitMethodConflict, moved in the same fix) at the
// time of the fix.
const ecDuplicateInit = 121

// E0110 (#3371, SPEC §12.2): a composite literal for an 'init'-declaring
// class, written outside the module that declares it. Without this an
// exported `init` guarantees nothing — every field stays reachable by the
// literal form from anywhere the class's fields are visible.
const ecClassInitSealed = 110

// Called once per StructDecl from checkModule's signature sweep (the same
// arena pass that already visits every StructDecl in source order for
// vTypeNodes, so this reports in that same normative order — SPEC §14.8).
fn vClassInitDuplicate(c: Checker, decl: int) {
  let raw = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  let seen = false
  let i = 0
  while (i < len(raw)) {
    let f = raw[i]
    if (getNode(c.tree, f).tag == Tag.Export) {
      f = kidsOf(c.tree, f)[0]
    }
    if (getNode(c.tree, f).tag == Tag.FuncDecl) {
      let nm = getNode(c.tree, kidsOf(c.tree, f)[1])
      if (c.source[nm.span.start:nm.span.end] == "init") {
        if (seen) {
          report(
            c.diags, ecDuplicateInit, vSpan(c, f),
            "'${declName(c, decl)}' already declares an 'init'",
            "a class may declare at most one 'init' (SPEC §10.4); Bit has no constructor overloading",
          )
        }
        seen = true
      }
    }
    i = i + 1
  }
}

// Called from vComposite (validatestmt.bit) once per composite literal, right
// beside vCompositeNoOmitted — the same "whole literal, before any slot"
// timing. Permissive on everything the seal cannot decide (unresolved type,
// no reachable decl), matching every other validator in this checker.
fn vCompositeInitSeal(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, init]
  let target = typeFromNode(c, kids[0])
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Struct) {
    return
  }
  if (classInitNode(c, target) == 0) {
    return
  }
  if (c.ctx.types[target].declModule == c.moduleId) {
    return
  }
  let tn = typeName(c.ctx, target)
  report(
    c.diags, ecClassInitSealed, vSpan(c, node),
    "'${tn}' declares 'init' and cannot be built with a composite literal outside its defining module",
    "construct it with '${tn}(...)' instead",
  )
}

// ---- construction call: checker + validator + lowering --------------------

// Validates `Account(500)`'s argument list against 'init's own declared
// params — arity through `vCallArity` (namedargs.bit), then every argument's
// type through `vCallArgTypes` (validatecallargs.bit), the free-function
// path's own two steps. #4676 deleted the local arity helper #4663 added here — a hand copy
// of the spread/arity rule — so a constructor call is counted by the same
// code a free call is, and the three E0050 strings and the E0063 spread scan
// exist once in the tree instead of twice.
//
// `init`'s param list is parsed through the identical parseParams every other
// signature uses (#4442), so the call is described to `vCallArgTypes` as the
// `CallDecl` a free call builds — through `mkCallDecl` (namedargs.bit)
// itself since #4688, so the variadic/fixed split is derived in ONE place for
// a constructor, a free call and a method alike. `generic: false`, since
// `init` cannot be generic (SPEC §10.4), and therefore an empty type env.
//
// #4663: the loop here ran `while (i < fixed)`, so a variadic `init`'s rest
// slot was never judged at all — `Foo("a")` and `Foo(...s)` into
// `init(...args: i64)` both checked and ran rc=0, and an `args[0]` used as a
// number read the string's own pointer. `vCallArgTypes` clamps the parameter
// index at the rest parameter's and judges a `...` spread against `[]P` for
// that parameter's element type P (#4548/#4655), which is the whole of what
// was missing here.
//
// #5315: `cd.minWant` (SPEC §10.3, #5244) was computed by `mkCallDecl` above
// but read through `fixedCallArity`, which discards it and always demands
// `cd.want` — the same E0050-on-a-trailing-default bug #5315 found on the
// method path, here on `init`'s own. `callArityOf(cd)` reads the field
// `mkCallDecl` already derived; `lowerArgsForMethod` (lowercall.bit) is the
// same lowering `lowerClassConstruct` calls for `init` and already fills the
// omitted default once the checker admits the call.
fn vClassConstructCall(c: Checker, node: int, classTy: int, initDecl: int) {
  let owner = typeOwner(c, classTy)
  let params = kidsOf(owner.tree, kidsOf(owner.tree, initDecl)[3])
  // A generic class's `init` carries the class's own type params on its
  // generics kid (`dupGenericParams`, parseInitMember above), so its parameter
  // types name `A`/`B` until the call's instantiation binds them — the same
  // "generic" shape a method of a generic class has (`mkMethodCallDecl`,
  // namedargs.bit). `classTy` is that instantiation (`constructClassType`), and
  // `recv` is what `namedCallEnv` (namedargs.bit) reads the bindings back from.
  let generic = declParamListNode(owner, initDecl) < 0
  let cd = mkCallDecl(owner, initDecl, "init", generic, params)
  cd.recv = classTy
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  // Named arguments (SPEC §12.11, #4688). `vCallNamedArgs` (namedargs.bit) is
  // the WHOLE of this call's validation when it fires — ordering, name
  // resolution, arity and argument types — so the two steps below never see a
  // `Tag.NamedArg`, exactly as `vCallKnownDecl` (validatecall.bit) arranges
  // for a free call.
  let namedStart = namedArgStart(c.tree, args)
  if (namedStart < len(args)) {
    vCallNamedArgs(c, node, cd, args, namedStart)
    return
  }
  if (!vCallArity(c, node, args, callArityOf(cd))) {
    return
  }
  vCallArgTypes(c, cd, args, len(args), constructEnv(c, cd))
}

// The substitution a generic class's `init` judges its arguments under: the
// class's own parameters bound to the instantiation `cd.recv` the call wrote
// (`Pair<i64, string>(7, "s")`). Empty for a class that is not generic, and for
// the bare template (a `Pair(...)` whose type parameters no argument binds,
// E0068 by `vConstructInferGap`), whose parameter types then decide nothing
// rather than being judged against the open `A`.
fn constructEnv(c: Checker, cd: CallDecl): TypeEnv {
  if (!cd.generic) {
    return emptyTypeEnv()
  }
  return genericEnvOf(cd.owner, cd.decl, nominalArgsOf(c, cd.recv))
}

// Lowers `Account(500)`: allocate a zero-valued Account (lowerlit.bit's
// zeroValue — the same allocation a field-less `Account{}` composite literal
// would build), then call 'init' on it exactly as an ordinary method call
// dispatches (lowercall.bit's class-receiver arm), discarding init's own
// (void) result. The constructed object, not init's result, is the value of
// this expression — matching how `unwrapFallible` already reports this
// call's OK type as the class itself, never `()`.
//
// A fallible init returns its error like any declared function: as the call's
// last word under BIT_ERR_REG (`initErrRaw`; init's ok type is void, so the
// call itself IS the word, bound by `appendErrWord` for the `?`/`catch`
// wrapping this expression), else through the slot, which lowerTryExpr reads
// right after evaluating the operand. Nothing here branches on success.
fn lowerClassConstruct(fc: FnCtx, node: int, classTy: int): int {
  let span = getNode(fc.c.tree, node).span
  let a = lowerArgsForMethod(fc, node, classTy, "init")
  if (fc.failed) {
    return 0
  }
  let obj = zeroValue(fc, classTy, span)
  let all = [obj]
  let j = 0
  while (j < len(a)) {
    all = append(all, a[j])
    j = j + 1
  }
  let raw = initErrRaw(fc, classTy)
  let ins = mkInstr(Op.Call, errWordCallTy(fc, raw, fc.c.ctx.voidId))
  ins.name = methodSymbol(fc.lowerer, "init", classTy)
  ins.args = all
  let call = builderEmit(fc.b, ins)
  appendErrWord(fc, raw, call, 0)
  return obj
}

// The `()!E` type `classTy`'s init returns as its error word, else 0 (no
// word convention, or an infallible init): `errWordRaw` decides from the
// declaration, the error type is the one the checker recorded for it.
fn initErrRaw(fc: FnCtx, classTy: int): int {
  let owner = typeOwner(fc.c, classTy)
  if (!classInitFallible(fc.c, classTy) ||
    !errWordDecl(owner, classInitNode(fc.c, classTy), fc.lowerer)) {
    return 0
  }
  return mkFallible(fc.c.ctx, fc.c.ctx.voidId, classInitErrType(fc.c, classTy))
}

// ---- fmt --------------------------------------------------------------

// Is `funcDeclNode` (a class member's func_decl, receiver already known
// nonzero by fmtPrintMember's caller) specifically the constructor? The only
// way a class-body func_decl's name is ever "init" is through
// parseInitMember above — an ordinary method literally named "init" cannot
// be written once atInitDecl claims that position — so a name-text compare
// is exact, not a heuristic.
fn isClassInitDecl(t: Tree, src: string, funcDeclNode: int): bool {
  let nm = getNode(t, kidsOf(t, funcDeclNode)[1])
  return src[nm.span.start:nm.span.end] == "init"
}

// Prints init's desugared func_decl (parseInitMember above) in its own
// source form: no `fn`, no receiver clause, no colon before the fallible
// marker — `init(params)! { ... }` / `init(params)!Err { ... }` /
// `init(params) { ... }`, never fmtPrintClassMethod's `': ()!'`, which is
// syntax init's own grammar does not accept back in.
fn fmtPrintClassInit(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [recv, name, generics, params, result, body]
  fmtPrintNode(p, k[1])
  let fallible = k[4] != 0
  let errNode = 0
  if (fallible) {
    errNode = kidsOf(p.tree, k[4])[1]
  }
  let tail = 2 // ' {'
  if (fallible) {
    tail = 3 // '! {'
    if (errNode != 0) {
      tail = tail + len(fmtRenderFlat(p, errNode))
    }
  }
  p.nextListTail = tail
  fmtPrintNode(p, k[3])
  if (fallible) {
    fmtRaw(p, "!")
    if (errNode != 0) {
      fmtPrintNode(p, errNode)
    }
  }
  fmtRaw(p, " ")
  fmtPrintBodyBlock(p, k[5], true)
}

// ---- readonly fields (checkbinddecl.bit/checklookup.bit own the checker half) -

// `readonly` (SPEC §10.5, #4066) is a CONTEXTUAL keyword, the same shape
// `use` (parsertype.bit's atUseStmt) and `init` above are: it lexes as an
// ordinary Ident and stays usable as one everywhere else —
// `runtime/root/windows/fsstat.bit` already binds a local named `readonly`,
// so reserving the word outright would break that file. Unambiguous the
// same way `atUseStmt` is: a class member's own name is always followed
// immediately by `:` (a field) or `(`/`<` (a method), never by a second
// bare identifier, so `readonly` followed by IDENT ':' can only be the
// modifier — a field genuinely named `readonly` (`readonly: int`) or a
// method named `readonly` (`readonly()`) never reaches this far because
// neither has a second identifier before the colon. Class-field only: a
// trait field (§10.7, parsertype.bit's parseTraitMember) has no `readonly`
// modifier. Lives here rather than beside atUseStmt in parsertype.bit
// itself (parseClassMember's own call site) purely for the 800-line
// ceiling — parsertype.bit had no room left once `readonly` support landed.
fn atReadonlyField(p: Parser): bool {
  return peekKind(p) == Kind.Ident &&
    curText(p) == "readonly" &&
    peekKindAt(p, 1) == Kind.Ident &&
    peekKindAt(p, 2) == Kind.Colon
}

// `[ "=" const_expr ]` — a class field's default value (SPEC §10.5, #3838),
// parsed as the third kid of the field node and 0 when absent. Returns 0
// WITHOUT consuming anything when `allowDefault` is false, so a `=` after a
// trait field stays the parse error §10.7's `trait_field` production says it
// is. The initializer is parsed as an ordinary expression and constrained to a
// constant by the checker (validateassign.bit's `vClassFieldDefaults`), not by
// the grammar — the same division `const` already uses, and the only one that
// can report "not a compile-time constant" with a span instead of "expected an
// identifier, found '('".
//
// Lives here rather than beside `parseField` itself purely for the 800-line
// ceiling, the same reason `atReadonlyField` above does.
fn parseFieldDefault(p: Parser, allowDefault: bool): int {
  if (!allowDefault || !acceptTok(p, Kind.Eq)) {
    return 0
  }
  return parseExpr(p)
}
