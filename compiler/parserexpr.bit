// Parser: the expression grammar — precedence climbing, unary/postfix, primary
// literals, composite literals, interpolation, index/slice. Split out of
// parser.bit (#1503); sibling .bit files are the same module, so this is a pure
// move.

// E0094 (ecTupleLiteralExpr, "tuples have no literal form", #2176) is
// RETIRED by #4105: `(a, b)` in expression position is a real tuple literal
// now (SPEC §12.10) instead of a parser rejection, so the report call this
// constant fed is deleted along with it. Diagnostic codes are never
// renumbered once assigned (see E0093/ecTestSignature's identical note,
// compiler/checkerdiag.bit) — 94 stays retired, never reused for a different
// rule.

// ---- expressions -----------------------------------------------------------

// `catch`'s binding power: tighter than a comparison, looser than arithmetic, so
// `f() catch d == x` is `(f() catch d) == x` while `f() catch a + b` still takes
// the whole sum as the fallback. Named because parseBinary reads it twice.
fn catchPrec(): int {
  return 5
}

fn precedenceOf(k: Kind): int {
  if (k == Kind.Star ||
    k == Kind.Slash ||
    k == Kind.Percent ||
    k == Kind.Shl ||
    k == Kind.Shr ||
    k == Kind.Amp) {
    return 7
  }
  if (k == Kind.Plus || k == Kind.Minus || k == Kind.Pipe || k == Kind.Caret) {
    return 6
  }
  if (k == Kind.KwCatch) {
    return catchPrec()
  }
  if (k == Kind.EqEq ||
    k == Kind.BangEq ||
    k == Kind.Lt ||
    k == Kind.LtEq ||
    k == Kind.Gt ||
    k == Kind.GtEq) {
    return 4
  }
  if (k == Kind.AmpAmp) {
    return 3
  }
  if (k == Kind.PipePipe) {
    return 2
  }
  return 0
}

fn canStartType(k: Kind): bool {
  return k == Kind.Ident ||
    k == Kind.LBracket ||
    k == Kind.KwMap ||
    k == Kind.KwChan ||
    k == Kind.LParen
}

// A `[`-led primary: a `[]T`/`[N]T` type used as a value (conversion/composite
// callee, e.g. `[]byte(x)`), or a slice literal `[a, b, c]`. Lookahead picks the
// shape (`bracketOpensType`) and speculation confirms it, matching the seed on
// both counts.
fn parseBracketPrimary(p: Parser): int {
  // The `[` bounds these types and is not a kid — same explicit-Span rule as
  // parseSliceOrArrayType below.
  let open = peekTok(p)
  if (bracketOpensType(p)) {
    // The lookahead above decides the SHAPE; the seed additionally requires the
    // whole `[]T{…}` / `[]T(…)` to parse CLEANLY, because its `fail` aborts
    // speculation, so one diagnostic anywhere inside re-parses the `[` as a bare
    // slice literal. Mirror that with the mark/dmark idiom (as `catch` binds do):
    // on truncated input the body never closes, and without this the two
    // compilers report entirely different parses (#1515).
    let mark = p.pos
    let dmark = len(p.diags.list)
    let node = parseSliceOrArrayTypePrimary(p, open)
    if (len(p.diags.list) == dmark) {
      return node
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
  }
  // Both brackets bound the literal and neither is a kid, so `mkNode` would span
  // `1, 2, 3` where the seed spans `[1, 2, 3]`.
  advance(p)
  let items = []int(0)
  while (!atListClose(p, Kind.RBracket)) {
    items = append(items, parseArgItem(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBracket)
  return addNode(
    p.tree, Tag.SliceLit,
    Span{ file: p.file, start: open.start, end: rbEnd }, 0, items,
  )
}

// Does the `[` at the cursor open a slice/array TYPE rather than a slice literal?
// The element type is what distinguishes `[]T` from the EMPTY literal `[]`: a
// slice type must name one, so a token after `]` that cannot start a type means
// this is `[]`. Without this guard `let xs: []string = []` consumed the NEXT
// statement as its element type (#1441).
fn bracketOpensType(p: Parser): bool {
  if (peekKindAt(p, 1) == Kind.RBracket && canStartType(peekKindAt(p, 2))) {
    return true
  }
  return peekKindAt(p, 1) == Kind.IntLit &&
    peekKindAt(p, 2) == Kind.RBracket &&
    canStartType(peekKindAt(p, 3))
}

// `[]T` / `[N]T` in value position, plus the `{…}` composite body or `(…)`
// conversion that may follow it (the seed's `trySliceOrArrayTypePrimary`). The
// body is parsed HERE, not left to the postfix loop, so that the caller's
// speculation covers it — which is the whole point of speculating.
fn parseSliceOrArrayTypePrimary(p: Parser, open: Token): int {
  advance(p)
  let size = 0
  let tag = Tag.SliceType
  if (peekKind(p) == Kind.IntLit) {
    size = leaf(p, Tag.IntLit)
    tag = Tag.ArrayType
  }
  advance(p)
  let elem = parseType(p)
  let tySpan = Span{ file: p.file, start: open.start, end: getNode(p.tree, elem).span.end }
  let kids = [elem]
  if (tag == Tag.ArrayType) {
    kids = [size, elem]
  }
  let ty = addNode(p.tree, tag, tySpan, 0, kids)
  if (peekKind(p) == Kind.LBrace) {
    return parseCompositeLit(p, ty)
  }
  if (peekKind(p) != Kind.LParen) {
    return ty
  }
  advance(p)
  let argNodes = []int(0)
  while (!atListClose(p, Kind.RParen)) {
    argNodes = append(argNodes, parseArgItem(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  let rpEnd = peekTok(p).end
  expect(p, Kind.RParen)
  let args = mkNode(p, Tag.Args, 0, argNodes)
  return addNode(
    p.tree, Tag.Call,
    Span{ file: p.file, start: open.start, end: rpEnd }, 0, [ty, 0, args],
  )
}

// `field_init = IDENT [ ( ":" | "=" ) expression ]` (SPEC §12.2, #3840). `=` is
// the target spelling — `:` means "has type", `=` means "gets value" — but the
// pinned stage0 that builds this very tree still knows only `:`, so both are
// accepted here and NOTHING is renamed: the 4350 existing `:` sites stay `:`.
// The formatter keeps emitting `:` regardless of which spelling the source
// used (see fmtexpr.bit's `Tag.FieldInit` case, which is unconditional on
// `main != 1` and never looks at which token was consumed) — flipping that is
// the sweep, not this step. A bare `IDENT` is shorthand for `IDENT: IDENT`
// (#3735): desugar it here, before type checking, by synthesizing a second
// Ident node over the SAME span as the name — every later stage (resolve,
// check, lower) already treats a FieldInit's second kid as an ordinary value
// expression, so it resolves and type-checks exactly as the explicit form
// would, with no downstream change. `main: 1` marks the node as shorthand for
// the formatter, which must print it back as `IDENT`, not `IDENT: IDENT` (the
// same `main`-as-flag shape `Tag.LetDecl` uses for `@threadlocal`, see
// fmtdispatch.bit).
//
// The shorthand branch only fires when `,` or `}` immediately follows — the
// two tokens that can legitimately close a field_init item. Anything else
// means this IDENT was never a real field_init in the first place (found by
// #3735's own diagnostic differential: malformed input like `for (a, b) in m
// { print(...) }` recovers through composite-literal parsing and reaches here
// with `print` as `name` and `(` next). That case must fall through to the
// original `expect(p, Kind.Colon)` + `parseExpr(p)` path unchanged, since
// `expect` is lenient (does not consume on mismatch, compiler/parser.bit:282)
// and the pinned oracle's diagnostic stream depends on `parseExpr` then
// running from the unconsumed token — silently swallowing that here regressed
// `_tests_/cases/check_forin_pair_binder.bit` against the oracle. The oracle
// knows only `:`, so the fallback error still probes `Kind.Colon` — keeping
// that diagnostic text unchanged is what keeps `selfhost-diffcheck` matching.
fn parseFieldInit(p: Parser): int {
  let name = expectIdent(p)
  if (!acceptTok(p, Kind.Colon) && !acceptTok(p, Kind.Eq)) {
    if (peekKind(p) == Kind.Comma || peekKind(p) == Kind.RBrace) {
      let valueRef = addLeaf(p.tree, Tag.Ident, getNode(p.tree, name).span)
      return mkNode(p, Tag.FieldInit, 1, [name, valueRef])
    }
    expect(p, Kind.Colon)
  }
  let e = parseExpr(p)
  return mkNode(p, Tag.FieldInit, 0, [name, e])
}

// `key : val` — one map composite-literal entry.
fn parseMapEntry(p: Parser): int {
  let key = parseExpr(p)
  expect(p, Kind.Colon)
  let val = parseExpr(p)
  return mkNode(p, Tag.MapEntry, 0, [key, val])
}

// A composite literal `Type{ ... }` — `[type, body]`. The body shape follows the
// type: a class name/generic-inst has keyed `field_inits`; a `map<K,V>` has
// `map_entries`; a slice/array type has positional `args`.
fn parseCompositeLit(p: Parser, typeNode: int): int {
  advance(p)
  let tt = getNode(p.tree, typeNode).tag
  let items = []int(0)
  let bodyTag = Tag.FieldInits
  if (tt == Tag.MapType) {
    bodyTag = Tag.MapEntries
    while (!atListClose(p, Kind.RBrace)) {
      items = append(items, parseMapEntry(p))
      if (!acceptTok(p, Kind.Comma)) {
        break
      }
    }
  } else if (tt == Tag.SliceType || tt == Tag.ArrayType) {
    bodyTag = Tag.Args
    while (!atListClose(p, Kind.RBrace)) {
      items = append(items, parseArgItem(p))
      if (!acceptTok(p, Kind.Comma)) {
        break
      }
    }
  } else {
    while (!atListClose(p, Kind.RBrace)) {
      items = append(items, parseFieldInit(p))
      if (!acceptTok(p, Kind.Comma)) {
        break
      }
    }
  }
  // The literal runs from its TYPE to the closing `}`, and neither delimiter is a
  // kid — `mkNode` would end the span at the last field, one `}` short of the
  // seed (E0075 underlining `S{ a: 1` for `S{ a: 1 }`). The seed gives the body
  // node the same whole-literal span, so mirror that too.
  let closeEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let lit = Span{ file: p.file, start: getNode(p.tree, typeNode).span.start, end: closeEnd }
  let body = addNode(p.tree, bodyTag, lit, 0, items)
  return addNode(p.tree, Tag.CompositeLit, lit, 0, [typeNode, body])
}

// `str_interp = str_part { interp_start expression interp_end str_part }`.
fn parseInterpString(p: Parser): int {
  let parts = []int(0)
  let guard = 0
  while (guard < 4096) {
    parts = append(parts, leaf(p, Tag.StrPart))
    if (!acceptTok(p, Kind.InterpStart)) {
      break
    }
    parts = append(parts, parseExpr(p))
    // Named, not `expect`: `describe(InterpEnd)` is "a string", but what the
    // user must actually close the interpolation with is `}`.
    expectMsg(p, Kind.InterpEnd, "'}'")
    guard = guard + 1
  }
  return mkNode(p, Tag.StrInterp, 0, parts)
}

// `recv[i]` index or `recv[lo:hi]` slice (either bound optional).
fn parseIndexOrSlice(p: Parser, recv: int): int {
  advance(p)
  let lo = 0
  if (peekKind(p) != Kind.Colon) {
    lo = parseExpr(p)
  }
  // Both forms run from the receiver through the closing `]`, which is not a kid
  // — `mkNode` would stop at the last index expression, one column short of the
  // seed (and for `xs[:]` the bounds are absent entirely).
  let recvStart = getNode(p.tree, recv).span.start
  if (acceptTok(p, Kind.Colon)) {
    let hi = 0
    if (peekKind(p) != Kind.RBracket) {
      hi = parseExpr(p)
    }
    let sliceEnd = peekTok(p).end
    expect(p, Kind.RBracket)
    return addNode(
      p.tree, Tag.SliceExpr,
      Span{ file: p.file, start: recvStart, end: sliceEnd }, 0, [recv, lo, hi],
    )
  }
  let idxEnd = peekTok(p).end
  expect(p, Kind.RBracket)
  return addNode(
    p.tree, Tag.Index,
    Span{ file: p.file, start: recvStart, end: idxEnd }, 0, [recv, lo],
  )
}

fn parsePrimary(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.StrPart) {
    return parseInterpString(p)
  }
  if (k == Kind.IntLit) {
    return leaf(p, Tag.IntLit)
  }
  if (k == Kind.FloatLit) {
    return leaf(p, Tag.FloatLit)
  }
  if (k == Kind.StringLit) {
    return leaf(p, Tag.StringLit)
  }
  if (k == Kind.RawStringLit) {
    return leaf(p, Tag.RawStringLit)
  }
  if (k == Kind.RuneLit) {
    return leaf(p, Tag.RuneLit)
  }
  if (k == Kind.BoolLit) {
    return leaf(p, Tag.BoolLit)
  }
  if (k == Kind.NilLit) {
    return leaf(p, Tag.NilLit)
  }
  if (k == Kind.Ident) {
    return leaf(p, Tag.Ident)
  }
  // `this` (SPEC §10.4, #3367): a real token with real source text, so it
  // reuses the whole identifier pipeline unchanged (scope resolution, member
  // access, type-from-decl) once the resolver binds it in a method's scope —
  // see resolvebody.bit's rActivateReceiver. `leaf` reads the CURRENT token
  // regardless of its Kind, so tagging it Ident here (rather than minting a
  // dedicated node) is exactly what makes that reuse free.
  if (k == Kind.KwThis) {
    return leaf(p, Tag.Ident)
  }
  if (k == Kind.KwMatch) {
    return parseMatch(p, true)
  }
  if (k == Kind.KwChan) {
    return parseChanType(p)
  }
  if (k == Kind.KwMap) {
    return parseMapType(p)
  }
  if (k == Kind.KwAsm) {
    return parseAsm(p)
  }
  if (k == Kind.LBracket) {
    return parseBracketPrimary(p)
  }
  if (k == Kind.LParen) {
    // Speculate a parenthesized arrow `(a, b) => body` / `(a: T) => body`; on
    // failure reset and parse a plain parenthesized expression (transparent).
    let mark = p.pos
    let dmark = len(p.diags.list)
    advance(p)
    let ok = true
    let params = []int(0)
    if (peekKind(p) != Kind.RParen) {
      let done = false
      while (!done) {
        if (peekKind(p) != Kind.Ident) {
          ok = false
          done = true
        } else {
          let name = leaf(p, Tag.Ident)
          let ty = 0
          if (acceptTok(p, Kind.Colon)) {
            ty = parseType(p)
          }
          params = append(params, mkNode(p, Tag.ArrowP, 0, [name, ty]))
          if (!acceptTok(p, Kind.Comma)) {
            done = true
          }
        }
      }
    }
    if (ok && peekKind(p) == Kind.RParen) {
      advance(p)
      if (acceptTok(p, Kind.FatArrow)) {
        let ap = mkNode(p, Tag.ArrowParams, 0, params)
        let body = 0
        if (peekKind(p) == Kind.LBrace) {
          body = parseBlock(p)
        } else {
          body = parseExpr(p)
        }
        return mkNode(p, Tag.ArrowFn, 0, [ap, body])
      }
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
    advance(p)
    // `(a, b, ...)` is a tuple literal (SPEC §12.10, #4105) once two or more
    // elements appear — the same arity rule `tuple_type`/`tuple_pat` already
    // enforce, so a trailing comma after a single element (`(a,)`) degrades
    // back to plain grouping rather than becoming a 1-tuple, matching
    // `parseParenType`'s identical `len(items) == 1` decision below.
    let openTok = p.toks[mark]
    let items = []int(0)
    items = append(items, parseExpr(p))
    while (acceptTok(p, Kind.Comma)) {
      if (atListClose(p, Kind.RParen)) {
        break
      }
      items = append(items, parseExpr(p))
    }
    let closeTok = peekTok(p)
    expect(p, Kind.RParen)
    if (len(items) == 1) {
      return items[0]
    }
    // Both parens bound the literal and neither is a kid, so `mkNode`'s
    // kids-only span would drop them (mirrors SliceLit's brackets,
    // parseBracketPrimary above).
    return mkSpanNode(p, Tag.TupleLit, 0, items, openTok.start, closeTok.end)
  }
  // No primary: report the missing expression, then consume one token (never
  // past EOF) so parsing always advances. The nil_lit poison is never referenced
  // by valid code.
  parseFail(p, "an expression")
  let bad = peekTok(p)
  if (peekKind(p) != Kind.Eof) {
    advance(p)
  }
  return addLeaf(p.tree, Tag.NilLit, Span{ file: p.file, start: bad.start, end: bad.end })
}

// Whether a FloatLit's text is a tuple index (`.0`, `.12`) rather than a real
// float — a leading `.` followed by digits only. `.5e3` and `.5.` are floats.
// Mirrors the seed's `isDotDigits`.
fn isDotDigits(text: string): bool {
  if (len(text) < 2 || text[0] != '.') {
    return false
  }
  let i = 1
  while (i < len(text)) {
    if (text[i] < '0' || text[i] > '9') {
      return false
    }
    i = i + 1
  }
  return true
}

// The three things after a consumed `.`: a type assertion `.(T)`, a
// whitespace-separated tuple index `.N`, or a member name. Split out of
// `parsePostfix` purely to keep THAT function's own McCabe complexity from
// growing (spec/LINT.md E0204, tools/build/complexity-debt.txt's baseline for
// `parsePostfix`) — every branch here costs this function's complexity,
// never `parsePostfix`'s, since its own call site is unconditional once `.`
// is seen.
fn parseDotPostfix(p: Parser, expr: int): int {
  if (acceptTok(p, Kind.LParen)) {
    // `.(T)` type assertion. Span to the closing `)` so a diagnostic on the
    // assertion (E0041) covers `recv.(T)` whole, like the seed — mkNode's
    // kid-only span would stop at the type node.
    let ty = parseType(p)
    let rp = peekTok(p)
    expect(p, Kind.RParen)
    return addNode(
      p.tree, Tag.TypeAssert,
      Span{ file: p.file, start: getNode(p.tree, expr).span.start, end: rp.end }, 0, [expr, ty],
    )
  }
  if (peekKind(p) == Kind.IntLit) {
    // `.N` tuple index, reached only when whitespace separates the `.` from
    // the digits (`t. 0`) — glued `t.0` lexes as one FloatLit, handled below.
    let idx = leaf(p, Tag.IntLit)
    return mkNode(p, Tag.TupleIndex, 0, [expr, idx])
  }
  // `member = "." ( IDENT | INT_LIT )` (SPEC §12.5, grammar restated in
  // Appendix A) — the IntLit tuple-index case is handled above; anything
  // else after `.` is
  // not a legal member name. `leaf(p, Tag.Ident)` used to take whatever
  // token was there unconditionally (a keyword, an operator, even EOF)
  // and mislabel it `Tag.Ident` with no diagnostic. `expectIdent` is the
  // same guard every other identifier-required site already routes
  // through: E0021 naming the bad token, and the `none` poison (index 0)
  // on failure rather than a garbage leaf — `mkNode`/`dumpNode` already
  // treat kid 0 as the poison case (`spanOfKids`, `dumpNode`'s `idx == 0`
  // arm), the same shape `parseFieldInit` above already relies on.
  let name = expectIdent(p)
  return mkNode(p, Tag.Member, 0, [expr, name])
}

// Postfix chain: `f(a, b)` calls and `.name` member access. `call` is
// `[callee, type_args_or_none, args]`; `args` holds `arg` nodes each `[expr]`;
// `member` is `[recv, name]`.
fn parsePostfix(p: Parser): int {
  // The whole postfix expression's start offset — a call spans from here to its
  // `)`, which `--dump-types` reads back (interior nodes otherwise carry a dummy
  // span; only call nodes are dumped, so only they need a real one).
  let exprStart = peekTok(p).start
  let expr = parsePrimary(p)
  let bareName = getNode(p.tree, expr).tag == Tag.Ident
  let guard = 0
  while (guard < 4096) {
    let k = peekKind(p)
    if (k == Kind.LParen) {
      advance(p)
      let argNodes = []int(0)
      while (!atListClose(p, Kind.RParen)) {
        argNodes = append(argNodes, parseArgItem(p))
        if (!acceptTok(p, Kind.Comma)) {
          break
        }
      }
      let rpEnd = peekTok(p).end
      expect(p, Kind.RParen)
      let args = mkNode(p, Tag.Args, 0, argNodes)
      expr = mkNode(p, Tag.Call, 0, [expr, 0, args])
      p.tree.nodes[expr].span = Span{ file: p.file, start: exprStart, end: rpEnd }
      bareName = false
    } else if (k == Kind.LBrace &&
      !p.noComposite &&
      (bareName ||
        getNode(p.tree, expr).tag == Tag.MapType ||
        getNode(p.tree, expr).tag == Tag.SliceType ||
        getNode(p.tree, expr).tag == Tag.ArrayType)) {
      // A composite literal `Type{...}` — after a bare type name, or after a
      // `map`/`chan`/`[]T` type primary; never when the `{` opens a loop body.
      expr = parseCompositeLit(p, expr)
      bareName = false
    } else if (k == Kind.LBracket) {
      expr = parseIndexOrSlice(p, expr)
      bareName = false
    } else if (k == Kind.Question) {
      // `?` is ALSO the conditional's opener (§12, #3941), and nothing here
      // knows the operand's fallibility — that is a checker fact (E0116), not
      // a parser one. Whichever `?` a `cond ? a : b` ends with (`cond` itself,
      // or one of the ordinary operators/operands nested inside it) is the
      // LAST token of `cond`, so it reaches exactly this branch before the
      // conditional layer ever sees it. `looksLikeTernaryQuestion` (parsercond.bit)
      // answers "would `? <then> :` actually parse from here" with a real,
      // rolled-back speculative parse (the same mark/reset idiom the generic
      // turbofish above uses) — a clean YES means this `?` is not propagation
      // at all, so leaving it unconsumed and ending the chain here is what
      // lets `parseConditional` open the ternary normally, however deep the
      // TRUE tail of `cond` sits.
      if (looksLikeTernaryQuestion(p)) {
        break
      }
      let q = peekTok(p)
      advance(p)
      // The seed spans `expr?` from the operand's start through the `?` (join),
      // not just the operand — `mkNode`'s kid-only span would drop the `?`.
      expr = addNode(
        p.tree, Tag.TryExpr,
        Span{ file: p.file, start: getNode(p.tree, expr).span.start, end: q.end }, 0, [expr],
      )
      bareName = false
    } else if (k == Kind.Dot) {
      advance(p)
      expr = parseDotPostfix(p, expr)
      bareName = false
    } else if (k == Kind.FloatLit && isDotDigits(curText(p))) {
      // `t.0` — the lexer emits ONE FloatLit token `.0`; no `Dot` token is ever
      // produced, so the `Kind.Dot` arm above cannot see a glued tuple index.
      // Split it here exactly as the seed does: the
      // index leaf starts one byte past the `.` so its text is the digits alone,
      // which is what parseIntText reads. mkNode's kid-derived span is already
      // the seed's `join(span(expr), full)` — the leaf ends at `full.end`.
      let full = peekTok(p)
      advance(p)
      let idx = addLeaf(
        p.tree, Tag.IntLit,
        Span{ file: p.file, start: full.start + 1, end: full.end },
      )
      expr = mkNode(p, Tag.TupleIndex, 0, [expr, idx])
      bareName = false
    } else if (k == Kind.Lt) {
      // Turbofish `expr<T, U>` — a generic call `(...)`, generic composite
      // `{...}`, or generic instantiation before `.` (`Option<i64>.None`).
      //
      // The WHOLE attempt is speculative, exactly as the seed's
      // `tryGenericPostfix` is: the type-arg list, the close, and then the
      // call's argument list or the composite literal's BODY all run with
      // `speculating > 0`, so a `fail` anywhere inside rewinds the lot to a
      // comparison. The port's equivalent of "a fail was raised" is "the
      // attempt appended a diagnostic", so success requires both a shape the
      // seed accepts and a clean diagnostic list.
      //
      // Committing at the `{` instead — which this used to do — made a
      // truncated `Shapes<i64>{` report EOF errors from inside the literal
      // where the seed rewinds and reads `Shapes < i64 > {`, reporting
      // "expected an expression, found '{'" at the brace (#1567).
      let mark = p.pos
      let dmark = len(p.diags.list)
      let smark = splitMark(p)
      advance(p)
      let tys = []int(0)
      let done = false
      while (!done) {
        tys = append(tys, parseType(p))
        if (!acceptTok(p, Kind.Comma)) {
          done = true
        }
      }
      // Built into `cand` rather than `expr`, so a rewind leaves `expr` as the
      // primary it was. The orphaned nodes are the seed's behaviour too — its
      // `reset` restores the token stream, never the tree.
      let cand = 0
      if (len(tys) >= 1 && atListClose(p, Kind.Gt)) {
        expectGenericClose(p)
        let targs = mkNode(p, Tag.TypeArgs, 0, tys)
        let nk = peekKind(p)
        if (nk == Kind.LParen) {
          advance(p)
          let argNodes = []int(0)
          while (!atListClose(p, Kind.RParen)) {
            argNodes = append(argNodes, parseArgItem(p))
            if (!acceptTok(p, Kind.Comma)) {
              break
            }
          }
          let rpEnd = peekTok(p).end
          expect(p, Kind.RParen)
          cand = mkNode(p, Tag.Call, 0, [expr, targs, mkNode(p, Tag.Args, 0, argNodes)])
          p.tree.nodes[cand].span = Span{ file: p.file, start: exprStart, end: rpEnd }
        } else if (bareName && !p.noComposite && nk == Kind.LBrace) {
          cand = parseCompositeLit(p, mkNode(p, Tag.GenericInst, 0, [expr, targs]))
        } else if (nk == Kind.Dot) {
          cand = mkNode(p, Tag.GenericInst, 0, [expr, targs])
        }
      }
      if (cand == 0 || len(p.diags.list) != dmark) {
        truncateDiags(p.diags, dmark)
        undoSplits(p, smark)
        p.pos = mark
        break
      }
      expr = cand
      bareName = false
    } else {
      break
    }
    guard = guard + 1
  }
  return expr
}

fn parseUnary(p: Parser): int {
  let k = peekKind(p)
  // `*` is the pointer dereference prefix (`*p`), `<-` is channel receive; both
  // ride the Unary node (main = the operator Kind).
  if (k == Kind.Bang ||
    k == Kind.Minus ||
    k == Kind.Plus ||
    k == Kind.Tilde ||
    k == Kind.ArrowLeft ||
    k == Kind.Star) {
    // A prefix chain (`!!!x`, `- - -x`) recurses into itself WITHOUT passing
    // through parseExpr, so it carries its own depth level or `maxParseDepth`
    // would not bound it (#2022). The pass-through below deliberately does not:
    // it is a tail delegation, not a recursion, and charging it would halve the
    // limit for every other shape.
    if (!enterExpr(p)) {
      return poisonExpr(p)
    }
    // The span must cover the OPERATOR, not just its operand. `mkNode` derives a
    // span from the kids alone, and the operator is a token rather than a child,
    // so it would be dropped — the recurring shape in this parser (the same one
    // that made an `@attr` node start after its `@`). The seed joins the operator
    // token's own span here, and a divergence shows up as a diagnostic underlining
    // `p` instead of `*p`: a DIFF, which no FALSEPOS check would catch.
    let opTok = peekTok(p)
    advance(p)
    let operand = parseUnary(p)
    leaveExpr(p)
    return addNode(
      p.tree, Tag.Unary,
      Span{ file: p.file, start: opTok.start, end: getNode(p.tree, operand).span.end },
      int(k), [operand],
    )
  }
  return parsePostfix(p)
}

// Left-associative precedence climbing (§12). `catch` rides the same table as a
// right-associative operator of precedence `catchPrec()`; see parseCatchTail.
fn parseBinary(p: Parser, minPrec: int): int {
  let lhs = parseUnary(p)
  let guard = 0
  while (guard < 4096) {
    let k = peekKind(p)
    let prec = precedenceOf(k)
    if (prec == 0 || prec < minPrec) {
      break
    }
    advance(p)
    if (k == Kind.KwCatch) {
      lhs = parseCatchTail(p, lhs)
    } else {
      let rhs = parseBinary(p, prec + 1)
      lhs = mkNode(p, Tag.Binary, int(k), [lhs, rhs])
    }
    guard = guard + 1
  }
  return lhs
}

// The `( IDENT block | expression )` after a consumed `catch`, with `expr` as the
// guarded operand. `catch e {…}` binds the error and runs a block (catch_bind);
// `catch <expr>` supplies a default value (catch_default).
//
// The fallback is parsed at `catchPrec()`, NOT as a full `parseExpr`. Taking a
// whole expression let the fallback swallow a trailing comparison, so
// `readFile(d) catch "<denied>" == "<denied>"` parsed as
// `readFile(d) catch ("<denied>" == "<denied>")` — a `bool` fallback against a
// `string!` operand that the checker did not reject, reaching codegen and
// SIGSEGVing at run time (#2344). Same minPrec rather than `+ 1` keeps `catch`
// RIGHT-associative, so `a catch b catch 0` stays `a catch (b catch 0)`: the
// left-associative reading would `catch` an already-handled, non-fallible value.
fn parseCatchTail(p: Parser, expr: int): int {
  // Speculate the bind form (the seed's tryCatchBind): parse `IDENT {…}` and
  // accept it only if the block parsed WITHOUT a diagnostic — a clean close. A
  // composite default (`catch Circle{r: 1}`) or a truncated block emits one, so
  // reset and take catch_default. This is why the block's `{` must directly
  // follow the ident.
  if (peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.LBrace) {
    let mark = p.pos
    let dmark = len(p.diags.list)
    let name = leaf(p, Tag.Ident)
    let block = parseBlock(p)
    if (len(p.diags.list) == dmark) {
      return mkNode(p, Tag.CatchBind, 0, [expr, name, block])
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
  }
  let def = parseBinary(p, catchPrec())
  return mkNode(p, Tag.CatchDefault, 0, [expr, def])
}

// The stand-in an over-deep expression leaves behind. Same node the "no primary"
// path uses, so nothing downstream needs a new shape; the file is already
// rejected by the time anything reads it.
fn poisonExpr(p: Parser): int {
  let t = peekTok(p)
  return addLeaf(p.tree, Tag.NilLit, Span{ file: p.file, start: t.start, end: t.end })
}

// Every recursive expression path funnels through here — `( e )` in parsePrimary,
// each call/slice-literal element via parseArgItem, index and slice bounds,
// composite-literal field and map-entry values, and interpolation holes — so one
// counter here bounds all of them (#2022). Without it the recursive descent's
// only bound was the OS stack, and `bit check` on 6000 nested parens died of
// SIGSEGV with no diagnostic at all.
fn parseExpr(p: Parser): int {
  if (!enterExpr(p)) {
    return poisonExpr(p)
  }
  let node = parseExprInner(p)
  leaveExpr(p)
  return node
}

fn parseExprInner(p: Parser): int {
  // Single-identifier arrow `x => body` — one token of lookahead past the ident.
  // The parenthesized form `(a, b) => body` is a follow-up (needs speculation).
  if (peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.FatArrow) {
    let name = leaf(p, Tag.Ident)
    advance(p)
    let param = mkNode(p, Tag.ArrowP, 0, [name, 0])
    let params = mkNode(p, Tag.ArrowParams, 0, [param])
    let body = 0
    if (peekKind(p) == Kind.LBrace) {
      body = parseBlock(p)
    } else {
      body = parseExpr(p)
    }
    return mkNode(p, Tag.ArrowFn, 0, [params, body])
  }
  return parseConditional(p)
}
