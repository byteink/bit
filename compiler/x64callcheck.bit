// In-Bit self-checks for the x86-64 backend's call-lowering: xEmitCallLike's
// void/bool/i64 return handling, the indirect call_value/call_iface paths
// (closure-cell layout, interface TypeInfo offset), the Win64 incoming-arg
// shadow-space fix (#3355/#3373/#3376/#3411), and the shared call helpers
// (safepoint return-address recording, per-convention arg0, closure-cell
// layout). Split out of compiler/x64compilecheck.bit (#5638), which sat at
// exactly the 800-line E0200 ceiling; the per-function compile driver
// stayed there, and the dispatch and control-flow checks moved to
// x64dispatchcheck.bit and x64controlflowcheck.bit — see that file's
// header.
//
// Split out of selfcheck.bit originally (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly and nothing here
// is imported.

fn checkX64CallLike() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let boolt = primType(ctx, 10)

  // A void callee takes no result: nothing may be moved out of rax.
  let cx = xFnCtx([i64t], [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 1 }])
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0]
  xEmitCallLike(cx, "bit_rt_safepoint", []int(0), false, 0, 0, true)
  assert(cx.nextSafepointIdx == 1)
  assert(xHex(cx.buf) == "e800000000") // just the call — no marshalling, no result
  assert(cx.safepointCodeOffsets[0] == 5)

  // A bool return MUST be zero-extended: the C ABI returns it in `al` and leaves
  // rax's upper bits unspecified. bit_rt_string_eq happened to zero eax,
  // bit_rt_fs_exists did not, and `!fsExists(missing)` silently read false.
  let cb = xFnCtx([boolt], [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 1 }])
  cb.ctx = ctx
  cb.safepointCodeOffsets = [0]
  xEmitCallLike(cb, "bit_rt_fs_exists", []int(0), true, 0, boolt, true)
  assert(xHexHas(cb.buf, "480fb6c0")) // movzbq %al, %rax

  // An i64 return must NOT be — narrowing a real 64-bit value to its low byte
  // would be a silent truncation.
  let ci = xFnCtx([i64t], [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 1 }])
  ci.ctx = ctx
  ci.safepointCodeOffsets = [0]
  xEmitCallLike(ci, "bit_rt_time_mono_ns", []int(0), true, 0, i64t, true)
  assert(!xHexHas(ci.buf, "480fb6c0"))
}

// Goldens from clang + llvm-objdump. The indirect-call paths: a closure cell is
// {code, env} and an interface receiver's TypeInfo is *(recv - 16).
fn checkX64IndirectCalls() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let voidt = ctx.voidId
  let blocks = [IrBlock{ instsStart = 0, paramCount = 0, instsLen = 2 }]

  // call_value: the cell's CODE is at +0 and its ENV at +8. Swapping them calls
  // the environment as if it were code.
  let cx = xFnCtx([i64t, i64t], blocks)
  cx.ctx = ctx
  cx.safepointCodeOffsets = [0]
  xEmitCallValue(cx, 0, voidt, 0, []int(0))
  assert(xHexHas(cx.buf, "4c8b5308")) // mov 8(%rbx), %r10   env  at +8
  assert(xHexHas(cx.buf, "488b03"))   // mov (%rbx),  %rax   code at +0
  // env goes in arg0, and the call is INDIRECT through rax — neither r10 nor rax
  // is an argument register, so marshalling cannot disturb them (#6198: r12 is
  // callee-saved, never a call target here).
  assert(xHexHas(cx.buf, "4c89d7")) // mov %r10, %rdi
  assert(xHexHas(cx.buf, "ffd0"))   // call *%rax
  assert(!xHexHas(cx.buf, "41ffd4"))
  assert(cx.nextSafepointIdx == 1)
  // #2018: one reloc now -- the nil-check's own call to bit_rt_panic_nil_call.
  // The real dispatch is still an indirect call through %rax and names no
  // symbol of its own.
  assert(len(cx.relocs) == 1 && cx.relocs[0].symbol == "bit_rt_panic_nil_call")

  // An argument must land in arg1, NOT arg0 — arg0 is reserved for the
  // environment, which is moved in after marshalling and would overwrite it.
  let ca = xFnCtx([i64t, i64t], blocks)
  ca.ctx = ctx
  ca.safepointCodeOffsets = [0]
  xEmitCallValue(ca, 0, voidt, 0, [1]) // vreg 1 is spilled
  assert(xHexHas(ca.buf, "488b75f0"))  // mov -16(%rbp), %rsi   -> arg1
  assert(!xHexHas(ca.buf, "488b7df0")) // NOT   ...    , %rdi

  // call_iface: the receiver's TypeInfo lives at *(recv - 16) — the object
  // header's info field sits BELOW the body pointer (ABI.md §2.1).
  let ci = xFnCtx([i64t, i64t], blocks)
  ci.ctx = ctx
  ci.safepointCodeOffsets = [0]
  xEmitCallIface(ci, 0, voidt, ifaceCallOf(0, 7, "f$ic0", []int(0)))
  // #5965: the inline cache probe, in this order. The cell's info is loaded
  // BEFORE its fn (x86-64 keeps two loads in order; the miss path stores fn
  // first), and the je skips the miss call with the cached fn in rax.
  let probe = "4c8b53f0" +   // mov -16(%rbx), %r10   the receiver's info
    "49bb0000000000000000" + // movabs $cell, %r11
    "498b03" +               // mov 0(%r11), %rax     cell.info
    "4c39d0" +               // cmp %r10, %rax
    "498b4308" +             // mov 8(%r11), %rax     cell.fn
    "0f84"                   // je over the miss path
  assert(xHexHas(ci.buf, probe))
  // The miss path: info and id $7, then a cell already bound (rax = its fn,
  // non-zero) jumps to the plain lookup; only an empty one passes &cell.
  assert(xHexHas(ci.buf, "4c89d7" + "48c7c607000000" + "4885c0" + "0f85")) // test %rax, %rax; jne
  assert(xHexHas(ci.buf, "4c89da"))                                        // mov %r11, %rdx  &cell
  // #2240: the nil-check's own call to bit_rt_panic_nil_iface precedes the
  // cell's address and the miss path's two calls.
  assert(ci.relocs[0].symbol == "bit_rt_panic_nil_iface")
  assert(ci.relocs[1].symbol == "f$ic0" && ci.relocs[1].kind == RelocKind.Abs64)
  assert(ci.relocs[2].symbol == "bit_rt_iface_lookup_ic")
  assert(ci.relocs[3].symbol == "bit_rt_iface_lookup")
  assert(!xHexHas(ci.buf, "4989c4")) // the lookup's result is already in rax
  assert(xHexHas(ci.buf, "ffd0"))    // call *%rax
  // Only the METHOD call is a safepoint — the lookup itself never collects.
  assert(ci.nextSafepointIdx == 1)

  // A SPILLED receiver must be RELOADED after the lookup: xGetInt hands it back
  // in scratch1 (r11), which the lookup call clobbers. With the receiver in a
  // callee-saved register the reload is a no-op, so only the spilled case can
  // tell a correct emitter from one that reuses the stale register.
  let cs = xFnCtx([i64t, i64t], blocks)
  cs.ctx = ctx
  cs.safepointCodeOffsets = [0]
  xEmitCallIface(cs, 0, voidt, ifaceCallOf(1, 7, "f$ic1", []int(0))) // vreg 1 is spilled
  assert(xHexCount(cs.buf, "4c8b5df0") == 2)                         // mov -16(%rbp), %r11  TWICE
  assert(xHexHas(cs.buf, "4d8b53f0"))                                // mov -16(%r11), %r10
}

// #3411: xBindIncomingArgs mirrored xMarshalArgs (compiler/x64call.bit) for the
// register banks but was never updated for Win64's 32-byte shadow space, which
// the CALLER reserves between the return address and its outgoing stack args
// (xEmitCallLike) — so the callee's incoming stack params must skip it too.
// This is the fourth Win64 home-space bug (#3355, #3373, #3376) and pins the
// offset directly so a fifth cannot land unnoticed.
fn checkX64BindIncomingArgsWin64() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  // Seven int params: SysV takes 6 in registers, Win64 only 4 — seven always
  // leaves at least one on the stack in both conventions.
  let types = [i64t, i64t, i64t, i64t, i64t, i64t, i64t]
  let entry = IrBlock{ instsStart = 0, paramCount = 7, instsLen = 7 }
  let instrs = []IrInstr(0)
  let i = 0
  while (i < 7) {
    instrs = append(instrs, mkInstr(Op.BlockParam, i64t))
    i = i + 1
  }
  // Destinations that collide with NO argument register in either convention
  // (rdi/rsi/rdx/rcx/r8/r9 SysV, rcx/rdx/r8/r9 Win64), so every incoming move
  // is independent of its own source and of every other move.
  let dsts = [XReg64.Rbx, XReg64.R10, XReg64.R11, XReg64.R12, XReg64.R13, XReg64.R14, XReg64.R15]

  // SysV: the 7th param (index 6) is the only one on the stack, and it must
  // stay at [rbp+16] — this fix must not move x86_64-linux/macos at all.
  let sv = newXCtx(XCallConv.SysV)
  sv.ctx = ctx
  sv.f = irFuncOf("f7", types, i64t, [entry], instrs)
  sv.intRegs = dsts
  let svLocs = []RegLoc(0)
  let p = 0
  while (p < 7) {
    svLocs = append(svLocs, RegLoc{ isSpill = false, index = p })
    p = p + 1
  }
  sv.alloc = RegAllocResult{ locations = svLocs, numSpillSlots = 0, stackMaps = []StackMapEntry(0) }
  xBindIncomingArgs(sv)
  let svWant = newXCtx(XCallConv.SysV)
  xMovLoad(svWant.buf, dsts[6], xMemB(XReg64.Rbp, 16), 8, false)
  assert(xHexHas(sv.buf, xHex(svWant.buf)))

  // Win64: only the first 4 params arrive in registers, so params 4, 5 and 6
  // are all on the stack, past the caller's 32-byte shadow space — at
  // [rbp+48], [rbp+56], [rbp+64]. Before this fix they read [rbp+16],
  // [rbp+24], [rbp+32]: the shadow space's own words, not the arguments.
  let win = newXCtx(XCallConv.Win64)
  win.ctx = ctx
  win.f = irFuncOf("f7", types, i64t, [entry], instrs)
  win.intRegs = dsts
  let winLocs = []RegLoc(0)
  let q = 0
  while (q < 7) {
    winLocs = append(winLocs, RegLoc{ isSpill = false, index = q })
    q = q + 1
  }
  win.alloc = RegAllocResult{
    locations = winLocs,
    numSpillSlots = 0,
    stackMaps = []StackMapEntry(0),
  }
  xBindIncomingArgs(win)
  let w48 = newXCtx(XCallConv.Win64)
  xMovLoad(w48.buf, dsts[4], xMemB(XReg64.Rbp, 48), 8, false)
  assert(xHexHas(win.buf, xHex(w48.buf)))
  let w56 = newXCtx(XCallConv.Win64)
  xMovLoad(w56.buf, dsts[5], xMemB(XReg64.Rbp, 56), 8, false)
  assert(xHexHas(win.buf, xHex(w56.buf)))
  let w64 = newXCtx(XCallConv.Win64)
  xMovLoad(w64.buf, dsts[6], xMemB(XReg64.Rbp, 64), 8, false)
  assert(xHexHas(win.buf, xHex(w64.buf)))

  // The regression itself, pinned directly: the pre-fix code read the first
  // Win64 stack arg at [rbp+16] — assert that instruction is now absent.
  let wrong = newXCtx(XCallConv.Win64)
  xMovLoad(wrong.buf, dsts[4], xMemB(XReg64.Rbp, 16), 8, false)
  assert(!xHexHas(win.buf, xHex(wrong.buf)))
}

// #5869: the call-site binding at W > 1 — xTakeCallResults (compiler/x64call.bit)
// and the Op.Call/Op.CallIface dispatch arms (x64dispatch.bit) that recognize
// a callWordRunLen > 1 run and route it through xEmitCallWords/
// xEmitCallIfaceWords instead of the single-result bind. Nothing produces a
// multi-word call on x86_64 until the flip ticket (#5872), so this check is
// the capability's only gate.
fn checkX64CallWords() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)

  // A 2-word direct call whose DESTINATIONS are rdx and rax — the caller's
  // aliasing case: word 0 (out of rax) must land in rdx while word 1 (out of
  // rdx) is still IN rdx. A left-to-right pair of movs would destroy word 1
  // before it is bound; the sequencer must rotate through the reserved
  // secondary scratch (r10).
  let cx = newXCtx(XCallConv.SysV)
  cx.ctx = ctx
  cx.intRegs = [XReg64.Rdx, XReg64.Rax] // vreg 0 -> rdx, vreg 1 -> rax
  cx.alloc = RegAllocResult{
    locations = [
      RegLoc{ isSpill = false, index = 0 }, RegLoc{ isSpill = false, index = 1 },
    ], numSpillSlots = 0, stackMaps = []StackMapEntry(0),
  }
  cx.f = irFuncOf(
    "f",
    []int(0),
    0,
    []IrBlock(0),
    [mkInstr(Op.BlockParam, i64t), mkInstr(Op.BlockParam, i64t)],
  )
  xTakeCallResults(cx, [0, 1], [i64t, i64t])
  let want = newXCtx(XCallConv.SysV)
  xMovRR(want.buf, XReg64.R10, XReg64.Rdx) // save what word 1 is about to overwrite
  xMovRR(want.buf, XReg64.Rdx, XReg64.Rax) // word 0 <- rax
  xMovRR(want.buf, XReg64.Rax, XReg64.R10) // word 1 <- rdx (saved)
  assert(xHex(cx.buf) == xHex(want.buf))

  // A DISCARDED word 0 still consumes its class's ordinal: word 1 must still
  // come from rdx, its OWN return register — deriving it from the surviving
  // words alone would bind the wrong value.
  let cd = newXCtx(XCallConv.SysV)
  cd.ctx = ctx
  cd.intRegs = [XReg64.R13] // vreg 0 -> r13 (word 1's destination)
  cd.alloc = RegAllocResult{
    locations = [RegLoc{ isSpill = false, index = 0 }],
    numSpillSlots = 0, stackMaps = []StackMapEntry(0),
  }
  cd.f = irFuncOf("f", []int(0), 0, []IrBlock(0), [mkInstr(Op.BlockParam, i64t)])
  xTakeCallResults(cd, [-1, 0], [i64t, i64t])
  let wantD = newX64Buf()
  xMovRR(wantD, XReg64.R13, XReg64.Rdx)
  assert(xHex(cd.buf) == xHex(wantD))

  checkX64CallWordsIface(ctx, i64t)
  checkX64CallValueWords(ctx, i64t, XCallConv.SysV)
  checkX64CallValueWords(ctx, i64t, XCallConv.Win64)
}

// The CallIface half of checkX64CallWords, split out to stay under the
// 80-line function ceiling (#5869): a run of 2 words binds through the SAME
// xTakeCallResults a direct call does — only the dispatch sequence in front
// of it differs.
fn checkX64CallWordsIface(ctx: TypeContext, i64t: int) {
  let ci = newXCtx(XCallConv.SysV)
  ci.ctx = ctx
  ci.intRegs = [XReg64.Rbx, XReg64.R14, XReg64.R13] // receiver, word 0, word 1
  ci.safepointCodeOffsets = [0]
  ci.alloc = RegAllocResult{
    locations = [
      RegLoc{ isSpill = false, index = 0 }, RegLoc{ isSpill = false, index = 1 },
      RegLoc{ isSpill = false, index = 2 },
    ], numSpillSlots = 0, stackMaps = []StackMapEntry(0),
  }
  let callIns = mkInstr(Op.CallIface, i64t)
  callIns.lhs = 0
  callIns.ival = 7
  callIns.args = []int(0)
  callIns.name = "f$ic0"
  let wordIns = mkInstr(Op.CallWord, i64t)
  wordIns.args = [1]
  wordIns.ival = 1
  ci.f = irFuncOf("f", []int(0), 0, []IrBlock(0), [mkInstr(Op.BlockParam, i64t), callIns, wordIns])
  xEmitCallIfaceWords(ci, 1, callIns, 2)
  assert(ci.relocs[0].symbol == "bit_rt_panic_nil_iface")
  assert(ci.relocs[2].symbol == "bit_rt_iface_lookup_ic")
  assert(ci.nextSafepointIdx == 1) // only the real dispatch call is a safepoint
  let wantW0 = newX64Buf()
  xMovRR(wantW0, XReg64.R14, XReg64.Rax)
  let wantW1 = newX64Buf()
  xMovRR(wantW1, XReg64.R13, XReg64.Rdx)
  assert(xHexHas(ci.buf, xHex(wantW0)))
  assert(xHexHas(ci.buf, xHex(wantW1)))
}

// #6684: the Op.CallValue half — a closure call's W > 1 run binds through the
// same xTakeCallResults, after xEmitCallValueSeq's own nil check and dispatch.
// Both conventions return word 0 in rax and word 1 in rdx (xRetIntRegs), so
// binding word 0 only leaves the rdx move missing.
fn checkX64CallValueWords(ctx: TypeContext, i64t: int, conv: XCallConv) {
  let cv = newXCtx(conv)
  cv.ctx = ctx
  cv.intRegs = [XReg64.Rbx, XReg64.R14, XReg64.R13] // closure cell, word 0, word 1
  cv.safepointCodeOffsets = [0]
  cv.alloc = RegAllocResult{
    locations = [
      RegLoc{ isSpill = false, index = 0 }, RegLoc{ isSpill = false, index = 1 },
      RegLoc{ isSpill = false, index = 2 },
    ], numSpillSlots = 0, stackMaps = []StackMapEntry(0),
  }
  let callIns = mkInstr(Op.CallValue, i64t)
  callIns.lhs = 0
  callIns.args = []int(0)
  let wordIns = mkInstr(Op.CallWord, i64t)
  wordIns.args = [1]
  wordIns.ival = 1
  cv.f = irFuncOf("f", []int(0), 0, []IrBlock(0), [mkInstr(Op.BlockParam, i64t), callIns, wordIns])
  xEmitCallValueWords(cv, 1, callIns, 2)
  assert(cv.relocs[0].symbol == "bit_rt_panic_nil_call")
  assert(cv.nextSafepointIdx == 1) // only the real closure call is a safepoint
  let wantW0 = newXCtx(conv)
  xMovRR(wantW0.buf, XReg64.R14, xRetIntRegs(conv)[0])
  let wantW1 = newXCtx(conv)
  xMovRR(wantW1.buf, XReg64.R13, xRetIntRegs(conv)[1])
  assert(xHexHas(cv.buf, xHex(wantW0.buf)))
  assert(xHexHas(cv.buf, xHex(wantW1.buf)))
}

fn checkX64CallHelpers() {
  // A safepoint is recorded at the RETURN ADDRESS — the offset AFTER the call —
  // because that is what the collector's stack walker looks a frame up by
  // (runtime/ABI.md §5). Recording the call's own offset leaves every lookup
  // missing.
  let cx = newXCtx(XCallConv.SysV)
  xCallReloc(cx, "bit_rt_gc_alloc")
  cx.safepointCodeOffsets = [0]
  xRecordSafepoint(cx)
  assert(cx.nextSafepointIdx == 1)
  assert(cx.safepointCodeOffsets[0] == 5)                   // past the whole e8+rel32
  assert(cx.safepointCodeOffsets[0] != cx.relocs[0].offset) // NOT the reloc's field offset

  // The first argument register is the one place the conventions differ for a
  // single-argument runtime call.
  assert(xArg0(XCallConv.SysV) == XReg64.Rdi)
  assert(xArg0(XCallConv.Win64) == XReg64.Rcx)

  // The closure cell: {code_ptr at +0, env_ptr at +8}, 16 bytes, with the env
  // as its ONLY GC field — the code pointer points into .text and must never be
  // traced.
  assert(xClosureCellSize() == 16)
  assert(len(xClosureCellPtrOffsets()) == 1)
  assert(xClosureCellPtrOffsets()[0] == 8)
}
