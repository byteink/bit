// compiler/classjsondecodetextcall.bit — how `jsonDecodeText<T>(src)` becomes a
// call to the text decoder synthesized for `T` (#4501).
//
//     jsonDecodeText<User>(body)   ->   __json_dectextroot_User(body)
//
// The twin of classjsondecodecall.bit, and deliberately thin: the call
// matching, the type-argument resolution, the need closure over nested classes
// and the import synthesis are ALL that file's, parameterised by the exported
// name (`JsonDecodeNames.exported`) and by which of the two need lists a site
// records into. Only the three things that genuinely differ live here — the
// names the two synthesized functions have, stdlib/json/dectext.bit's runtime
// half, and the rewrite's own shape.
//
// THE REWRITE IS SHAPED DIFFERENTLY FROM THE DOM ONE, and that is the reason
// the root wrapper exists at all. `jsonDecode<C>(j)` becomes
// `__json_dec_C(j, "", 0)`: three arguments, two of them synthesized literals.
// A text decode cannot be spelled that way, because after the value is read the
// cursor still has to be checked for trailing garbage — three statements, not
// one expression. So the class's module gets a one-statement-per-line wrapper
// and the call site keeps its single argument untouched.

// The stdlib name being specialised. Matched by import through the same
// `jsonDecodeNamesOf` the DOM entry point uses, so `import { jsonDecodeText as
// dt }` and `import * as js` are both found and a user's own function of that
// name is not.
const jsonDecodeTextFuncName = "jsonDecodeText"

// The decoder that reads one value of class `name` off the cursor. Called by
// the root wrapper, by a nested field of another decoder, and by an element of
// a `[]C` — the one function that knows the class's fields.
fn jsonDecTextName(name: string): string {
  return "__json_dectext_${name}"
}

// The entry point a rewritten call names: builds the reader, decodes, and
// refuses anything after the value.
fn jsonDecTextRootName(name: string): string {
  return "__json_dectextroot_${name}"
}

// The names of stdlib/json/dectext.bit's runtime half, plus the two path
// builders it shares with decode.bit. Listed once, here, because they are
// simultaneously the words the module source needs and the items the
// synthesized import has to bind — two lists that must not drift.
//
// `JsonReader` is in the list because it is a TYPE the generated signature
// names, not merely a function it calls; without it the decoder's own parameter
// list would not resolve.
fn jsonDecTextHelperNames(): []string {
  return [
    "JsonReader", "jsonTextReader", "jsonTextFinish", "jsonTextObject",
    "jsonTextArray", "jsonTextKey", "jsonTextItem", "jsonTextKeyIs",
    "jsonTextKeyText", "jsonTextUnknown", "jsonTextNull", "jsonTextNeed",
    "jsonTextIntKey", "jsonTextFloatKey", "jsonTextBoolKey", "jsonTextStringKey",
    "jsonTextIntIndex", "jsonTextFloatIndex", "jsonTextBoolIndex",
    "jsonTextStringIndex", "jsonDecPath", "jsonDecIndex",
  ]
}

// ---- which classes this module owes a text decoder -------------------------

// The classes THIS module must synthesize `__json_dectext_C` for: the ones
// demanded of it that it also declares. The text twin of `moduleDecodeClasses`,
// and separate from it because the two entry points are demanded independently
// — a project that only calls `jsonDecode` synthesizes no text decoder at all,
// and the other way round.
fn moduleDecodeTextClasses(
  d: JsonDecodeDemand, mid: int, classes: []JsonClass, jx: JsonCtx,
): []JsonClass {
  let out = []JsonClass(0)
  for jc of classes {
    let name = identText(jx.tree, jx.source, jc.className)
    for n of d.textNeeds.list {
      if (n.classMod == mid && n.className == name) {
        out = append(out, jc)
        break
      }
    }
  }
  return out
}

// The classes THIS module must synthesize `__json_dectextroot_C` for: the ones
// a `jsonDecodeText<C>` call somewhere in the project names, that it declares.
// Read off the SITES rather than off the needs, because only a site is a root —
// a class reached as a nested field owes the reader-driven decoder and nothing
// else, and a wrapper nobody calls would be dead code in every binary.
fn moduleDecodeTextRootClasses(
  d: JsonDecodeDemand, mid: int, classes: []JsonClass, jx: JsonCtx,
): []JsonClass {
  let out = []JsonClass(0)
  for jc of classes {
    let name = identText(jx.tree, jx.source, jc.className)
    for s of d.sites {
      if (s.text && s.classMod == mid && s.className == name) {
        out = append(out, jc)
        break
      }
    }
  }
  return out
}

// ---- the words and the imports the rewrite needs ---------------------------

// Every word module `mid` needs for the text feature ON TOP of the ones its own
// text decoders need: the root wrapper of every class it decodes from text, and
// the reader-driven decoder of every class those reach.
fn jsonDecodeTextCallWords(d: JsonDecodeDemand, mid: int): []string {
  let out = []string(0)
  for s of d.sites {
    if (s.text && s.callerMod == mid) {
      out = append(out, jsonDecTextRootName(s.className))
    }
  }
  for n of d.textNeeds.list {
    if (n.needMod == mid) {
      out = append(out, jsonDecTextName(n.className))
    }
  }
  return out
}

// The reader-driven decoders module `mid` calls that another module declares —
// a nested `@json` class living outside the class that embeds it.
fn jsonDecodeTextImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = []JsonDecodeImport(0)
  for n of d.textNeeds.list {
    if (n.needMod == mid && n.classMod != mid && n.path != "") {
      out = append(
        out, JsonDecodeImport{ path: n.path, word: jsonDecTextName(n.className) },
      )
    }
  }
  return out
}

// The root wrappers module `mid` calls that another module declares.
fn jsonDecodeTextRootImportItems(d: JsonDecodeDemand, mid: int): []JsonDecodeImport {
  let out = []JsonDecodeImport(0)
  for s of d.sites {
    if (s.text && s.callerMod == mid && s.classMod != mid && s.path != "") {
      out = append(
        out, JsonDecodeImport{ path: s.path, word: jsonDecTextRootName(s.className) },
      )
    }
  }
  return out
}

// The refusal a generic wrapper gets, stated as what it is rather than as a
// misspelled class name. #4563 made `jsonDecode<T>` composable by retargeting
// the INSTANTIATION LEDGER entry per `T`; a text decode has no such entry —
// the rewrite replaces the callee outright — so the shape is refused rather
// than accepted and left to bind to the template body, which compiles and
// fails at run time.
fn reportJsonDecodeTextTypeParam(jx: JsonCtx, targ: int) {
  let tname = jsonNodeText(jx, targ)
  report(
    jx.diags, ecJsonDecodeType, getNode(jx.tree, targ).span,
    "'jsonDecodeText' cannot decode into '${tname}': it is a type parameter, and the text entry point is specialised by rewriting the call rather than through the instantiation ledger",
    "call 'jsonDecodeText<${tname}>' where '${tname}' is written out as a class, or take the parsed value and use 'jsonDecode<${tname}>', which IS composable from a generic (#4563)",
  )
}

// ---- the rewrite -----------------------------------------------------------

// `jsonDecodeText<C>(src)` becomes `__json_dectextroot_C(src)`, in place.
//
// IN PLACE, by overwriting the call's callee and clearing its type arguments,
// for the reason `rewriteJsonDecodeCalls` overwrites rather than replaces: the
// call sits inside an expression whose parent this pass does not hold. The
// ARGUMENT list is untouched — the wrapper takes exactly the one argument the
// reader wrote — so unlike the DOM rewrite this one synthesizes no literals.
fn rewriteJsonDecodeTextCall(tree: Tree, st: SynthText, site: JsonDecodeSite) {
  let start = getNode(tree, site.callNode).kidsStart
  tree.extra[start] = synthIdent(tree, st, jsonDecTextRootName(site.className))
  tree.extra[start + 1] = 0
}
