// bit.lock plain-JSON read/write (#1732, spec §17.7). Reuses json.bit's
// JsonDoc value tree + jsonParse/jsonStringify (#1595, same module) instead of
// a new parser/encoder: bit.lock is fully machine-owned, regenerated on every
// `add`/`up`/`remove`, and has no user comments to preserve — unlike
// bit.json's JSONC, it does not need stdlib/json's edit.bit CST layer (#1479).
//
// Field names below mirror the JSON keys spec §17.7 pins (`url`, `commit`,
// `requires`) rather than paraphrasing them, so the wire shape is legible
// straight off the struct.

// One dependency's own transitive requirement, verbatim from that
// dependency's `bit.json` `dependencies` map: `name` is the key, `ref` is the
// `gitHost/owner/repo@ref` value (a tag, branch, or bare commit SHA). Stored
// as-is so MVS can re-run from the lockfile alone without re-fetching every
// transitive manifest.
struct LockRequire {
  name: string,
  ref: string,
}

// One resolved dependency. `name` is the key it is stored under in bit.lock;
// `commit` is the exact resolved commit SHA (spec §17.7: a tag or branch ref
// is always dereferenced before being recorded, so this is never mutable).
// `vanity` is the exact vanity path as written in bit.json (without `@ref`)
// for a dependency resolved through a `bit-import:` document (spec §17.7);
// "" for a direct git-host dependency, whose entry omits the `vanity` JSON
// key entirely (`lockAddEntry`, below) rather than writing it empty.
struct LockEntry {
  name: string,
  url: string,
  commit: string,
  requires: []LockRequire,
  vanity: string,
}

// Reads bit.lock at `path`. A missing file is not an error — the first
// `bit add` in a project creates it — so this returns an empty list. A
// PRESENT but malformed file does fail: bit.lock is machine-owned, so
// malformed content means corruption, not an expected state.
function readLock(path: string): []LockEntry! {
  if (!fsExists(path)) {
    return []LockEntry(0)
  }
  let src = readFile(path)?
  let d = jsonParse(src)
  if (!d.ok || jsonKindOf(d, d.root) != JsonKind.Obj) {
    fail newError("bit.lock: malformed JSON: ${path}")
  }
  return lockEntriesOfObj(d, d.root)
}

// Writes `entries` to `path` as canonical JSON, sorted by dependency name so
// two resolutions of the same dependency set produce a byte-identical diff.
function writeLock(path: string, entries: []LockEntry): ()! {
  let sorted = lockSortEntries(entries)
  writeFile(path, jsonStringify(lockDocOf(sorted)))?
}

// ---- decode: JsonDoc -> []LockEntry ----------------------------------------

function lockEntriesOfObj(d: JsonDoc, id: int): []LockEntry {
  let out = []LockEntry(0)
  let n = jsonLen(d, id)
  let i = 0
  while (i < n) {
    let name = jsonKeyAt(d, id, i)
    out = append(out, lockEntryOf(d, name, jsonGet(d, id, name)))
    i = i + 1
  }
  return out
}

function lockEntryOf(d: JsonDoc, name: string, id: int): LockEntry {
  return LockEntry{
    name: name,
    url: jsonStrOf(d, jsonGet(d, id, "url")),
    commit: jsonStrOf(d, jsonGet(d, id, "commit")),
    requires: lockRequiresOf(d, jsonGet(d, id, "requires")),
    // Absent (a direct git-host entry) reads back as "" — jsonGet returns -1
    // for a missing key and jsonStrOf reads a non-node id as "".
    vanity: jsonStrOf(d, jsonGet(d, id, "vanity")),
  }
}

function lockRequiresOf(d: JsonDoc, id: int): []LockRequire {
  let out = []LockRequire(0)
  if (!jsonHas(d, id) || jsonKindOf(d, id) != JsonKind.Obj) {
    return out
  }
  let n = jsonLen(d, id)
  let i = 0
  while (i < n) {
    let name = jsonKeyAt(d, id, i)
    out = append(out, LockRequire{ name: name, ref: jsonStrOf(d, jsonGet(d, id, name)) })
    i = i + 1
  }
  return out
}

// ---- encode: []LockEntry -> JsonDoc ----------------------------------------

// Builds a fresh JsonDoc via jsonAddNode/jsonLeaf — the same node-arena
// helpers jsonParse itself uses (jsonparse.bit, same module) — reused here so
// the parsed and hand-built trees share one representation.
function lockDocOf(entries: []LockEntry): JsonDoc {
  let p = JsonParser{ src: "", pos: 0, ok: true, nodes: []JsonValue(0) }
  let root = lockAddObj(p, entries)
  return JsonDoc{ nodes: p.nodes, root: root, ok: true }
}

function lockAddObj(p: JsonParser, entries: []LockEntry): int {
  let keys = []string(0)
  let items = []int(0)
  let i = 0
  while (i < len(entries)) {
    keys = append(keys, entries[i].name)
    items = append(items, lockAddEntry(p, entries[i]))
    i = i + 1
  }
  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

// `vanity` is written FIRST, matching spec §17.7's own example ordering, and
// only when non-empty — a direct git-host entry's `vanity` key is omitted
// entirely, never written as an empty string.
function lockAddEntry(p: JsonParser, e: LockEntry): int {
  let keys = []string(0)
  let items = []int(0)
  if (len(e.vanity) > 0) {
    keys = append(keys, "vanity")
    items = append(items, lockAddStr(p, e.vanity))
  }
  keys = append(keys, "url")
  items = append(items, lockAddStr(p, e.url))
  keys = append(keys, "commit")
  items = append(items, lockAddStr(p, e.commit))
  keys = append(keys, "requires")
  items = append(items, lockAddRequires(p, e.requires))

  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

function lockAddRequires(p: JsonParser, rs: []LockRequire): int {
  let keys = []string(0)
  let items = []int(0)
  let i = 0
  while (i < len(rs)) {
    keys = append(keys, rs[i].name)
    items = append(items, lockAddStr(p, rs[i].ref))
    i = i + 1
  }
  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

function lockAddStr(p: JsonParser, s: string): int {
  let v = jsonLeaf(JsonKind.Str)
  v.strVal = s
  return jsonAddNode(p, v)
}

// ---- stable ordering --------------------------------------------------------

// Insertion sort by name (mirrors lint.bit's lintSortStrings), on a fresh copy
// so writeLock never reorders the caller's own slice. Dependency counts are
// small; a stable diff across writes matters more than sort complexity here.
function lockSortEntries(xs: []LockEntry): []LockEntry {
  let out = []LockEntry(0)
  let i = 0
  while (i < len(xs)) {
    out = append(out, xs[i])
    i = i + 1
  }
  i = 1
  while (i < len(out)) {
    let j = i
    while (j > 0 && compare(out[j - 1].name, out[j].name) > 0) {
      let tmp = out[j - 1]
      out[j - 1] = out[j]
      out[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
  return out
}
