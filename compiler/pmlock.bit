// bit.lock plain-JSON read/write (#1732, spec §17.7). Reuses json.bit's
// JsonDoc value tree + jsonParse/jsonStringify (#1595, same module) instead of
// a new parser/encoder: bit.lock is fully machine-owned, regenerated on every
// `add`/`up`/`remove`, and has no user comments to preserve — unlike
// bit.json's JSONC, it does not need stdlib/json's edit.bit CST layer (#1479).
//
// Field names below mirror the JSON keys spec §17.7 pins (`url`, `commit`,
// `requires`) rather than paraphrasing them, so the wire shape is legible
// straight off the class.

// One dependency's own transitive requirement, verbatim from that
// dependency's `bit.json` `dependencies` map: `name` is the key, `ref` is the
// `gitHost/owner/repo@ref` value (a tag, branch, or bare commit SHA). Stored
// as-is so MVS can re-run from the lockfile alone without re-fetching every
// transitive manifest.
class LockRequire {
  name: string,
  ref: string,
}

// One resolved dependency. `name` is the key it is stored under in bit.lock;
// `commit` is the exact resolved commit SHA (spec §17.7: a tag or branch ref
// is always dereferenced before being recorded, so this is never mutable) —
// EXCEPT for a local-path entry, which has no commit at all (see
// `localPath` below). `vanity` is the exact vanity path as written in
// bit.json (without `@ref`) for a dependency resolved through a
// `bit-import:` document (spec §17.7); "" for a direct git-host dependency,
// whose entry omits the `vanity` JSON key entirely (`lockAddEntry`, below)
// rather than writing it empty.
//
// `localPath` (#2244) is non-empty for a local filesystem / "file://"
// dependency (`compiler/pmfetch.bit`'s `DepSpec.scheme == "local"`): the
// decoded path, exactly as recorded in bit.json, either absolute or
// relative to the PROJECT ROOT (never to whatever directory `bit add`
// happened to be run from — `pmcli.bit`'s `addLocalDependency` stores it
// unchanged, since a spec typed while standing in the project root, or via
// `--dir`, already IS relative to it). `url`/`commit`/`vanity` are all ""
// for this kind of entry: a local dependency has no git remote and, because
// its content is a live, mutable directory rather than a resolved git
// commit, nothing immutable to pin — every build re-reads the directory
// as it is at that moment, exactly like an import of the project's own
// source. This is a deliberate SPEC §17.7 extension, not an oversight: see
// `pmfetch.bit`'s `parseLocalSpec` for why no ref form applies here at all.
//
// `dir` (#3270) is non-empty only for a VANITY entry (`vanity` non-empty)
// whose `bit-import:` document named a `dir` field (SPEC §17.7's vanity
// document extension point): the subdirectory of the fetched repository
// that is the package's own root, e.g. `"pkg/toml"` for a first-party
// package living in a subfolder of a larger repository rather than at its
// root. "" (the default, and the only value a direct git-host or
// local/file entry ever has) means the package is the repository root,
// exactly as every entry meant before this field existed.
//
// `version` (#2856) is the resolved `MAJOR.MINOR.PATCH` — no `v` prefix,
// `compiler/pmversion.bit`'s `canonicalVersion` form — ONLY when the
// manifest's `ref` was a version constraint (bare, `^`, or `~`) and
// resolution actually matched a git tag to it; "" otherwise (a branch pin,
// a bare commit SHA, or a lock entry written before this field existed).
// This is deliberately NOT the constraint bit.json records — a `^1.2.0`
// constraint can resolve to `1.4.7`, and `version` records the latter, never
// the former. Read back as "" when the JSON key is entirely absent
// (`lockEntryOf`, below), so an old lock file keeps working unchanged; the
// sibling ticket (#2857) is what checks this against bit.json's constraint,
// not this file.
class LockEntry {
  name: string,
  url: string,
  commit: string,
  version: string,
  requires: []LockRequire,
  vanity: string,
  localPath: string,
  dir: string,
}

// Reads bit.lock at `path`. A missing file is not an error — the first
// `bit add` in a project creates it — so this returns an empty list. A
// PRESENT but malformed file does fail: bit.lock is machine-owned, so
// malformed content means corruption, not an expected state.
fn readLock(path: string): []LockEntry! {
  if (!fsExists(path)) {
    return []LockEntry(0)
  }
  let src = readFile(path)?
  let d = jsonParse(src)
  if (!d.ok || jsonKindOf(d, d.root) != JsonKind.Obj) {
    fail newError("bit.lock: malformed JSON: ${path}")
  }
  return lockEntriesOfObj(d, d.root)
}

// Writes `entries` to `path` as canonical JSON, sorted by dependency name so
// two resolutions of the same dependency set produce a byte-identical diff.
fn writeLock(path: string, entries: []LockEntry): ()! {
  let sorted = lockSortEntries(entries)
  writeFile(path, jsonStringify(lockDocOf(sorted)))?
}

// ---- decode: JsonDoc -> []LockEntry ----------------------------------------

fn lockEntriesOfObj(d: JsonDoc, id: int): []LockEntry {
  let out = []LockEntry(0)
  let n = jsonLen(d, id)
  let i = 0
  while (i < n) {
    let name = jsonKeyAt(d, id, i)
    out = append(out, lockEntryOf(d, name, jsonGet(d, id, name)))
    i = i + 1
  }
  return out
}

fn lockEntryOf(d: JsonDoc, name: string, id: int): LockEntry {
  return LockEntry{
    name: name,
    url: jsonStrOf(d, jsonGet(d, id, "url")),
    commit: jsonStrOf(d, jsonGet(d, id, "commit")),
    // Absent (a lock entry written before this field existed, or a
    // branch/bare-sha/local entry that never had a version to record) reads
    // back as "" for the same reason `vanity` does, below.
    version: jsonStrOf(d, jsonGet(d, id, "version")),
    requires: lockRequiresOf(d, jsonGet(d, id, "requires")),
    // Absent (a direct git-host entry) reads back as "" — jsonGet returns -1
    // for a missing key and jsonStrOf reads a non-node id as "".
    vanity: jsonStrOf(d, jsonGet(d, id, "vanity")),
    // Absent (any non-local entry) reads back as "" for the same reason.
    localPath: jsonStrOf(d, jsonGet(d, id, "path")),
    // Absent (any entry whose document named no `dir` field) reads back as
    // "" for the same reason.
    dir: jsonStrOf(d, jsonGet(d, id, "dir")),
  }
}

fn lockRequiresOf(d: JsonDoc, id: int): []LockRequire {
  let out = []LockRequire(0)
  if (!jsonHas(d, id) || jsonKindOf(d, id) != JsonKind.Obj) {
    return out
  }
  let n = jsonLen(d, id)
  let i = 0
  while (i < n) {
    let name = jsonKeyAt(d, id, i)
    out = append(out, LockRequire{ name: name, ref: jsonStrOf(d, jsonGet(d, id, name)) })
    i = i + 1
  }
  return out
}

// ---- encode: []LockEntry -> JsonDoc ----------------------------------------

// Builds a fresh JsonDoc via jsonAddNode/jsonLeaf — the same node-arena
// helpers jsonParse itself uses (jsonparse.bit, same module) — reused here so
// the parsed and hand-built trees share one representation.
fn lockDocOf(entries: []LockEntry): JsonDoc {
  let p = JsonParser{ src: "", pos: 0, ok: true, nodes: []JsonValue(0) }
  let root = lockAddObj(p, entries)
  return JsonDoc{ nodes: p.nodes, root: root, ok: true }
}

fn lockAddObj(p: JsonParser, entries: []LockEntry): int {
  let keys = []string(0)
  let items = []int(0)
  let i = 0
  while (i < len(entries)) {
    keys = append(keys, entries[i].name)
    items = append(items, lockAddEntry(p, entries[i]))
    i = i + 1
  }
  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

// `vanity` is written FIRST, matching spec §17.7's own example ordering, and
// only when non-empty — a direct git-host entry's `vanity` key is omitted
// entirely, never written as an empty string. `dir` (#3270) is written
// right after it, also only when non-empty: a vanity entry whose document
// named a `dir` field records it there; a direct git-host or local-path
// entry, or a vanity entry whose document named none, omits the key
// entirely rather than writing it empty, the same rule `vanity` itself
// already follows. A local-path entry (#2244, `e.localPath` non-empty)
// writes `path` INSTEAD of `url`/`commit`, omitting both entirely rather
// than writing them as empty strings — it has neither a git remote nor a
// pinned commit, so writing either as "" would read as a malformed direct
// entry rather than a genuinely different kind of one.
fn lockAddEntry(p: JsonParser, e: LockEntry): int {
  let keys = []string(0)
  let items = []int(0)
  if (len(e.vanity) > 0) {
    keys = append(keys, "vanity")
    items = append(items, lockAddStr(p, e.vanity))
  }
  if (len(e.dir) > 0) {
    keys = append(keys, "dir")
    items = append(items, lockAddStr(p, e.dir))
  }
  if (len(e.localPath) > 0) {
    keys = append(keys, "path")
    items = append(items, lockAddStr(p, e.localPath))
  } else {
    keys = append(keys, "url")
    items = append(items, lockAddStr(p, e.url))
    keys = append(keys, "commit")
    items = append(items, lockAddStr(p, e.commit))
  }
  // `version` (#2856) is written right after `commit`, before `requires`,
  // and only when non-empty — a branch pin, a bare-sha pin and a local-path
  // entry all leave `e.version` at its zero value and omit the key entirely,
  // the same "omit rather than write empty" rule `vanity`/`dir` already
  // follow.
  if (len(e.version) > 0) {
    keys = append(keys, "version")
    items = append(items, lockAddStr(p, e.version))
  }
  keys = append(keys, "requires")
  items = append(items, lockAddRequires(p, e.requires))

  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

fn lockAddRequires(p: JsonParser, rs: []LockRequire): int {
  let keys = []string(0)
  let items = []int(0)
  let i = 0
  while (i < len(rs)) {
    keys = append(keys, rs[i].name)
    items = append(items, lockAddStr(p, rs[i].ref))
    i = i + 1
  }
  let v = jsonLeaf(JsonKind.Obj)
  v.keys = keys
  v.items = items
  return jsonAddNode(p, v)
}

fn lockAddStr(p: JsonParser, s: string): int {
  let v = jsonLeaf(JsonKind.Str)
  v.strVal = s
  return jsonAddNode(p, v)
}

// ---- stable ordering --------------------------------------------------------

// Insertion sort by name (mirrors lint.bit's lintSortStrings), on a fresh copy
// so writeLock never reorders the caller's own slice. Dependency counts are
// small; a stable diff across writes matters more than sort complexity here.
fn lockSortEntries(xs: []LockEntry): []LockEntry {
  let out = []LockEntry(0)
  let i = 0
  while (i < len(xs)) {
    out = append(out, xs[i])
    i = i + 1
  }
  i = 1
  while (i < len(out)) {
    let j = i
    while (j > 0 && compare(out[j - 1].name, out[j].name) > 0) {
      let tmp = out[j - 1]
      out[j - 1] = out[j]
      out[j] = tmp
      j = j - 1
    }
    i = i + 1
  }
  return out
}
