// Split out of arm64compile.bit (#3283, pure move — that file sat at 794/800
// lines with no headroom left for the debug-info line-table hook this ticket
// needed to add there). Both functions below are self-contained arm64 leaf
// emitters called only from compileInst's Op.Asm/Op.Syscall arms; moving them
// changes no behavior and reorders no declaration (see #3163: inlining and
// name resolution are file-order-independent for compiler/** since db8293c2).

// Inline assembly (§11.6): move each `input` value into its fixed register
// (excluded from the allocatable file for the whole function, so overwriting it
// is safe), emit the arm64 sub-block's pre-encoded words verbatim, then read the
// `result` register (if any) into the instruction's result vreg. `dst` is -1 for
// a result-less block (a barrier / naked shim).
fn emitAsm(cx: A64Ctx, dst: int, block: int, inVals: []int) {
  let blk = cx.module.asmBlocks[block]
  let i = 0
  while (i < len(inVals)) {
    let src = getInt(cx, vregOf(cx, inVals[i]), scratch1())
    movRR(cx.code, blk.inArm64[i], src)
    i = i + 1
  }
  i = 0
  while (i < len(blk.arm64Words)) {
    emitWord(cx.code, blk.arm64Words[i])
    i = i + 1
  }
  if (dst >= 0) {
    putInt(cx, dst, blk.resultArm64)
  }
}

// Raw Linux syscall (§11.8): move each argument into x0..x5, the number into
// x8, trap into the kernel with `svc #0`, then read the return value out of x0.
// Every register involved is excluded from the allocatable file for the whole
// function (collectReservedArm64), so the moves cannot clobber a live value and
// can run in plain sequence. emitWord is the same primitive emitCallReloc uses
// for its own fixed opcodes.
fn emitSyscall(cx: A64Ctx, dst: int, nr: int, args: []int) {
  let regs = syscallArgRegs()
  let i = 0
  while (i < len(args)) {
    let src = getInt(cx, vregOf(cx, args[i]), scratch1())
    movRR(cx.code, regs[i], src)
    i = i + 1
  }
  let nrSrc = getInt(cx, vregOf(cx, nr), scratch1())
  movRR(cx.code, syscallNrReg(), nrSrc)
  emitWord(cx.code, 0xD4000001) // svc #0
  putInt(cx, dst, 0)
}
