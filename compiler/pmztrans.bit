// compiler/pmztrans.bit — the TRANSITIVE requirement walk (#2251): fetch
// every dependency reachable from what `bit.lock` already records, arbitrate
// the version-tagged ones through PubGrub (#2366), and give each surviving
// module its own top-level `bit.lock` entry. Split out of compiler/pmz.bit
// under #4481, which took that file to 827 lines against spec/LINT.md:186's
// 800-line E0200 limit; the walk was already a self-contained section there
// (its own `---- transitive dependency resolution` banner, moved below with
// it) and nothing outside it declares a name it owns.
//
// Sibling of pmz.bit in the same module, so `resolveVanityUrl`,
// `parseGitRemoteUrl`, `fetchSha`, `resolveDependencyRef`,
// `resolveVersionRefSha`, `TagRemote`, `vanityTagPrefix`, `readManifest`,
// `manifestRequires`, `vanityPackageDir`, `parseAddSpec`, `upsertLockEntry`,
// `lockEntryResolvedAs`, `canonicalVersion`, `parseVersion`, `versionText`
// and `resolvePubGrub` are all visible unqualified and NOT re-imported (a
// module's imports are shared across its files; a second import of a name
// the module already has is E0042).
//
// Named `pmztrans` so it sorts after `pmz.bit` — and therefore after every
// other `pm*` file — keeping the ordering pmz.bit's own header describes.
// Name resolution itself is order-independent, and inlining has been since
// #3163; the convention is kept because pmz.bit's header states it.

// ---- transitive dependency resolution (#2251) --------------------------
//
// SPEC §17.7 step 1: "the resolver walks the transitive requirement graph —
// every dependency's own bit.json dependencies, recursively." Step 2: "for
// each distinct module named anywhere in that graph, the resolver ...
// selects" the one version satisfying every stated constraint, highest
// first when several do (owner decision, #2366, 2026-08-09), and fails
// naming the conflict when none do. `pmresolvesolve.bit`'s `resolvePubGrub`
// (#2366, replacing #1731's MVS) already implements that step over a
// `ReqGraph` handed to it as data — its own header says assembling that
// data from `bit.lock`/git is a separate job. This is that job: walk every
// `requires` edge a locked dependency's own `bit.json` names, fetching each
// newly discovered name (through the identical direct-vs-vanity
// classification and fetch machinery a root `bit add` uses — a transitive
// dependency's own dependency can itself be a vanity name, #2068) and
// giving each surviving module its own top-level `bit.lock` entry.
//
// Three kinds of requirement, per SPEC §17.7 point 2:
//   - version-tagged (an exact `MAJOR.MINOR.PATCH`/`vMAJOR.MINOR.PATCH`
//     ref): every DISTINCT requirement reachable is resolved once to learn
//     ITS OWN requirements, feeding `resolvePubGrub`'s `ReqGraph` as an
//     Exact constraint; the resolved version per name is then the one
//     actually locked, reusing the fetch already done during discovery
//     rather than fetching a second time.
//   - RANGE-shaped (`^`/`~`, #4488): the spelling `bit add` itself writes
//     into `bit.json` (`AddRefResolution.writtenRef` is `formatConstraint`'s
//     output), so it is the ordinary shape of a published package's own
//     dependency. It names a SET, not a version, so it is resolved the same
//     way a direct `bit add` resolves one — `listVersions` on the
//     requirement's own `TagRemote`, then `highestInSet`
//     (`resolveHighestSatisfying`, pmcliaddref.bit) — and feeds the graph as
//     a real `Caret`/`Tilde` constraint rather than being dropped. Before
//     #4488 it was classified as a branch name and handed to git verbatim,
//     so `git ls-remote` was asked for a ref called `^0.1.0` and every such
//     package failed to resolve at all.
//   - non-version (a branch or bare commit SHA): SPEC's own carve-out — "a
//     module reachable only through such a ref resolves to exactly that
//     ref" — there is no ordering to arbitrate, so the first (and, since a
//     name is fetched at most once here, only) ref discovered for a name is
//     locked as-is.
//
// The CANDIDATE POOL a range is arbitrated against is what discovery
// actually fetched (`packageVersionsFromModules`): a range contributes its
// own highest match, plus whatever versions of that name other requirements
// pulled in. So PubGrub can still step DOWN from a range's highest match
// onto a lower version another requirement pinned, but it can never invent a
// candidate nobody's requirement reached. Enumerating a range's full
// candidate set up front, and fetching lazily per decision, is #2368's job.
// A version-tagged resolution wins over a non-version one for the same name
// if a walk somehow discovers both (an exact pinned version is a strictly
// stronger constraint than an unordered branch/sha) — this resolver's one
// tie-break rule, applied only at the very end so discovery never depends on
// which requirement happens to be walked first.
//
// Known limitation, deliberately out of scope here: a name that ALREADY has
// a top-level `bit.lock` entry (a direct dependency, or one this resolver
// already locked on a prior run) is never reconsidered even if a freshly
// discovered requirement would want a higher version — this walk only fills
// in names bit.lock does not yet have an entry for. Re-arbitrating an
// already-locked name against a newly discovered transitive requirement (the
// same way `checkVersionConflict` guards a root `bit add`) is #2250's own
// scope, which also covers `checkVersionConflict` itself never firing today.

// One requirement discovered while walking a dependency's own `requires` —
// `spec` is that dependency's stated value verbatim (`LockRequire.ref`,
// pmlock.bit: a full `gitHost/owner/repo@ref` or vanity `path@ref` string,
// not a bare ref). `fromRoot` marks a requirement that came directly from
// `resolveTransitiveDeps`'s own `seed` (a "true" root of this resolver's own
// graph) rather than from a deeper module's own requirements — only a root
// requirement is fed to `resolvePubGrub` directly; every deeper edge is
// re-derived by `resolvePubGrub`'s own internal walk over the `modules` this
// file assembles, the same layering `checkVersionConflict` already uses.
class PendingReq { name: string, spec: string, fromRoot: bool }

// The `Version` a FULL dependency spec string's trailing `@ref` names, or
// `(_, false)` if that ref names no version at all. Unlike `parseVersionTag`
// (pmz.bit), which expects an already-bare ref, this takes the full spec a
// `bit.json` `dependencies` value or a `bit.lock` `requires` entry actually
// stores (`host/owner/repo@ref` or `vanityPath@ref`) and extracts the ref
// itself first.
fn pendingVersionTag(spec: string): (Version, bool) {
  let (ref, ok) = pendingRef(spec)
  if (!ok) {
    return Version{ major: 0, minor: 0, patch: 0 }, false
  }
  return parseManifestVersionRef(ref)
}

// The trailing `@ref` of a full dependency spec, or `(_, false)` when the
// spec carries none at all. The one place the `@` split is done, so
// `pendingVersionTag` (above) and `pendingConstraint` (below) cannot drift
// apart on what counts as the ref.
fn pendingRef(spec: string): (string, bool) {
  let at = lastIndexByte(spec, '@')
  if (at < 0) {
    return "", false
  }
  return spec[at + 1:len(spec)], true
}

// The version SET a full dependency spec's trailing `@ref` states — wider
// than `pendingVersionTag` above by exactly the range forms: `@^0.1.0` and
// `@~0.1.0` come back as real `Caret`/`Tilde` constraints instead of being
// dropped (#4488), while both exact spellings still come back as `Exact`.
// `(_, false)` for SPEC §17.7's other two ref forms, a branch name and a
// bare commit sha, which name no version set at all.
//
// Parsed through `parseAddVersionRef` (pmcliaddref.bit) — the SAME parser
// `bit add`/`bit up`/`bit outdated` use on a ref the user typed — rather
// than a second grammar of this file's own: a manifest's requirement and a
// command line's ref are the same language, and #4488 exists because the
// walk had its own narrower reading of it.
fn pendingConstraint(spec: string): (Constraint, bool) {
  let (ref, ok) = pendingRef(spec)
  if (!ok) {
    return zeroConstraint(), false
  }
  return parseAddVersionRef(ref)
}

// A ref as a MANIFEST spells it, to the `Version` it names — SPEC §17.7's
// `MAJOR.MINOR.PATCH` (what `bit add` itself writes, via `formatConstraint`)
// and the `vMAJOR.MINOR.PATCH` spelling a hand-written manifest may use,
// both accepted, through `canonicalVersion` (pmversion.bit) rather than a
// second spelling rule of this file's own. `(_, false)` for SPEC §17.7's
// other two ref forms — a branch name, a bare commit sha — and for a `^`/`~`
// range, which names a set rather than a version.
//
// This is deliberately WIDER than `parseVersionTag` (pmz.bit), which requires
// the leading `v` and stays that way: that one is handed an already-RESOLVED
// git ref (`checkVersionConflict`'s `ref` is the tag `bit add` matched),
// where "v0.1.0" is a tag name and a bare "0.1.0" would be a different tag
// name; this one is handed a version REQUIREMENT, where SPEC §17.7 defines
// both spellings to mean the same version. Before #4481 the walk used the
// narrow one for both jobs, so the bare spelling SPEC prescribes — and which
// `bit add` writes — was classified as a branch name: never arbitrated by
// PubGrub, and handed to git verbatim, which is why a transitive `@0.1.0`
// could only ever resolve against a repository that tagged bare.
fn parseManifestVersionRef(ref: string): (Version, bool) {
  let (canon, ok) = canonicalVersion(ref)
  if (!ok) {
    return Version{ major: 0, minor: 0, patch: 0 }, false
  }
  return parseVersion(canon)
}

// Whether `entries` already carries a top-level entry named `name` — the
// gate that stops this resolver from re-fetching (or re-considering) a
// dependency some earlier `bit add`/`bit up` already locked.
fn lockHasEntry(entries: []LockEntry, name: string): bool {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// `queue` with one `PendingReq{fromRoot: false}` appended per entry of `rs`
// (a freshly-fetched dependency's own `requires`) — every edge discovered
// below the top level of this resolver's own walk.
fn enqueueRequires(queue: []PendingReq, rs: []LockRequire): []PendingReq {
  let out = queue
  let i = 0
  while (i < len(rs)) {
    // bit:lint allow E0214 -- enqueueRequires has 3 call sites (pmclichecktail.bit:203, a test-local literal never read after the call; pmz.bit:335,352, resolveTransitiveDeps's own local queue reassigned in place each time); queue never escapes its owning function, so no caller reads the pre-call slice after the call
    out = append(out, PendingReq{ name: rs[i].name, spec: rs[i].ref, fromRoot: false })
    i = i + 1
  }
  return out
}

// `rs` (raw `[]LockRequire`, full-spec-string refs) narrowed to the subset
// that states a version SET — an exact pin or a `^`/`~` range (#4488),
// carried through as the op it was written with — and dropping SPEC §17.7's
// branch and bare-sha forms, which state no set to arbitrate. As
// pmresolve.bit's `[]Requirement`: the data a
// freshly-fetched module's own requirements become for `ReqGraph.modules`,
// used by `resolveTransitiveDeps` (below) to seed each newly-discovered
// module's own edges during the real transitive walk. NOT reused by
// `checkVersionConflict` (pmz.bit) for the package being added/refreshed's own
// requirements — #3562 found that doing so fed sub-dependency names into
// that check's graph with zero candidate versions, so `resolvePubGrub`
// raised a spurious conflict for every non-leaf package; that narrower check
// has no business solving `name`'s own sub-graph at all, only this full walk
// does.
fn versionRequirementsOf(rs: []LockRequire): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(rs)) {
    let (c, ok) = pendingConstraint(rs[i].ref)
    if (ok) {
      out = append(out, Requirement{ name: rs[i].name, constraint: c })
    }
    i = i + 1
  }
  return out
}

// The remote a transitive VANITY requirement's versions are looked up on,
// and the tag namespace they live in (#4481).
//
// A `bit-import:` document carrying a `dir` field says the package is a
// SUBFOLDER of a repository it shares with other packages and with that
// repository's own releases, so its versions are tagged `<key>/vX.Y.Z` and
// a bare `vX.Y.Z` there is not a version of this package at all (#4472,
// `vanityTagPrefix` in pmcli.bit). `bit add`, `bit up` and `bit outdated`
// have applied that namespace since #4472; this walk did not, so a package
// required TRANSITIVELY at a version could not resolve at all.
//
// The prefix is derived from the VANITY NAME and never from the `bit.json`
// key, exactly as on the `bit add` path: renaming a dependency locally does
// not rename tags on someone else's repository.
fn transitiveVanityRemote(gitBin: string, d: DepSpec, doc: VanityDoc, timeoutMs: int): TagRemote {
  return TagRemote{
    gitBin: gitBin,
    url: doc.gitUrl,
    prefix: vanityTagPrefix(d.vanityName, doc.dir),
    timeoutMs: timeoutMs,
  }
}

// One transitive requirement's ref, resolved on `r`: the git tag that
// matched (`""` for a branch or a bare sha, which match no tag), the commit
// it names, and — for the two forms that state a version set — the VERSION
// that was selected out of it. `isVersion` is the flag for whether
// `version` means anything, and it is the same flag the walk uses to decide
// whether this requirement is arbitrated by PubGrub at all.
class TransitiveRef { tag: string, sha: string, version: Version, isVersion: bool }

// The commit `ref` names on `r`, the git tag that matched it, and the
// version that tag carries — the one place the transitive walk decides how a
// requirement's ref becomes a commit (#4481, #4488).
//
// An EXACT version requirement (either of SPEC §17.7's two spellings)
// resolves through `resolveVersionRefSha` (pmcliaddref.bit) — the SAME
// `v`-prefixed-then-bare rule, inside the same `r.prefix` tag namespace,
// that `bit add`/`bit up`/`bit outdated` already use — and reports the tag
// it matched, so `bit.lock` can record it (#4472's `LockEntry.tag`). Two
// things follow that were not true before: a repository that tags `v0.1.0`
// matches a requirement written `@0.1.0`, and a `dir`-resolved package's
// `<key>/` namespace is searched instead of the bare one that belongs to the
// host repository's own releases.
//
// A RANGE (`^`/`~`, #4488) names no single tag, so there is nothing to look
// up by name: it goes through `resolveHighestSatisfying` (pmcliaddref.bit),
// which enumerates `r`'s tags inside `r.prefix` and picks the highest in the
// set — `bit add`'s own selection rule, reused rather than reimplemented, so
// the `<key>/` namespace and SPEC §17.7's 0.x caret boundary apply here
// exactly as they do on the direct path. `constraintWant` supplies the same
// "what was looked for" wording a failing direct add already prints.
//
// Anything else — a branch name, a bare commit sha (SPEC §17.7's other two
// ref forms) — is handed to `resolveDependencyRef` verbatim, unchanged, and
// reports no tag and no version: there is no version to build a tag name out
// of, and the ref the manifest wrote IS the git ref.
fn resolveTransitiveRefSha(r: TagRemote, ref: string): TransitiveRef! {
  let (c, isVersion) = parseAddVersionRef(ref)
  if (!isVersion) {
    let sha = resolveDependencyRef(r.gitBin, r.url, ref, r.timeoutMs)?
    return TransitiveRef{
      tag: "",
      sha: sha,
      version: Version{ major: 0, minor: 0, patch: 0 },
      isVersion: false,
    }
  }
  if (c.op == ConstraintOp.Exact) {
    let (tag, sha) = resolveVersionRefSha(r, c.version)?
    return TransitiveRef{ tag: tag, sha: sha, version: c.version, isVersion: true }
  }
  let picked = resolveHighestSatisfying(r, versionSetFromConstraint(c), constraintWant(r.prefix, c))?
  return TransitiveRef{
    tag: picked.ref,
    sha: picked.sha,
    version: picked.version,
    isVersion: true,
  }
}

// Resolves one transitive requirement's full spec (a dependency's own
// `bit.json` value, e.g. `"local.invalid/dev/textutil@v0.1.0"`) to a fetched
// `TransitiveDep` — the `LockEntry` for it plus the version its ref selected
// (below) — routing it through the identical direct-vs-vanity
// classification (`parseSpec`/`parseAddSpec`) and fetch machinery
// (`fetchSha`/`resolveVanityUrl`) a root `bit add` uses — a transitive
// dependency's own dependency can itself be a vanity name (#2068), so this
// must never assume the direct shape. `parseAddSpec` (not the stricter
// `parseSpec`) is used so a hand-authored manifest that omits `@ref` on one
// of ITS OWN dependencies resolves the same way an omitted `@ref` does for a
// root `bit add`, rather than failing the whole resolution.
fn resolveTransitiveSpec(
  cacheRoot: string,
  gitBin: string,
  name: string,
  spec: string,
  timeoutMs: int,
): TransitiveDep! {
  let d = parseAddSpec(spec)?
  // SECURITY (#2244): a local filesystem / "file://" dependency is only ever
  // trusted directly from the ROOT project's own bit.json
  // (`pmcliaddref.bit`'s `addLocalDependency`, `pmcliup.bit`'s
  // `upDependencies`, which never call
  // this function for the dependency they add themselves). This function
  // processes ONLY entries discovered by walking SOME already-resolved
  // dependency's own `requires` — content that came from a git fetch (or, at
  // best, another local dependency's manifest), never something the
  // developer running `bit add`/`bit up` typed. Without this check, a
  // dependency fetched from an untrusted remote could name an arbitrary
  // local path in its OWN `bit.json` `dependencies` and have this resolver
  // read it as though the developer had asked for it directly — turning a
  // `bit add`/`bit up` of one innocuous-looking package into an
  // attacker-chosen local file read. Denied unconditionally, regardless of
  // the path's shape (no traversal-pattern check could substitute for this:
  // the untrusted party gets to choose ANY path, absolute or relative).
  if (d.scheme == "local") {
    fail newError("pmz: transitive dependency '${name}' requests a local filesystem path (${d.localPath}) — local/file:// dependencies are only allowed directly in a project's own bit.json, never as a requirement of another dependency")
  }
  if (d.vanity) {
    return resolveTransitiveVanitySpec(cacheRoot, gitBin, name, d, timeoutMs)?
  }
  let url = defaultDepUrl(d.host, d.owner, d.repo)
  if (d.scheme == "ssh") {
    url = sshDepUrl(d.sshUser, d.host, d.owner, d.repo)
  }
  // No namespace on a direct spec: the repository IS the package, so its
  // versions are the bare `vX.Y.Z`/`X.Y.Z` tags at the top of its own tag
  // namespace — the pre-#4472 rule, unchanged.
  let rr = resolveTransitiveRefSha(
    TagRemote{ gitBin: gitBin, url: url, prefix: "", timeoutMs: timeoutMs },
    d.ref,
  )?
  let fetched = fetchSha(
    gitBin, cacheRoot, GitRemoteRepo{ host: d.host, owner: d.owner, repo: d.repo },
    GitFetchTarget{ url: url, sha: rr.sha, pkgDir: "" }, timeoutMs,
  )?
  let depManifest = readManifest(fetched.dir)?
  return resolvedTransitiveDep(
    LockEntry{
      name: name,
      url: url,
      commit: rr.sha,
      tag: rr.tag,
      requires: manifestRequires(depManifest),
      vanity: "",
    },
    rr,
  )
}

// `resolveTransitiveSpec`'s vanity arm (#2068): the vanity name is resolved
// to a `bit-import:` document first, and the fetch is a SUBDIRECTORY of the
// repository that document names when it carries a `dir` field
// (`vanityPackageDir`), so the requirement's versions live in that package's
// own `<key>/` tag namespace rather than the repository's own
// (`transitiveVanityRemote`, #4472).
fn resolveTransitiveVanitySpec(
  cacheRoot: string, gitBin: string, name: string, d: DepSpec, timeoutMs: int,
): TransitiveDep! {
  let doc = resolveVanityUrl(d.vanityName, vanityTimeoutMs)?
  let remote = parseGitRemoteUrl(doc.gitUrl)?
  let rr = resolveTransitiveRefSha(transitiveVanityRemote(gitBin, d, doc, timeoutMs), d.ref)?
  let fetched = fetchSha(
    gitBin,
    cacheRoot,
    remote,
    GitFetchTarget{ url: doc.gitUrl, sha: rr.sha, pkgDir: doc.dir },
    timeoutMs,
  )?
  let pkgDir = vanityPackageDir(fetched.dir, doc.dir)?
  let depManifest = readManifest(pkgDir)?
  return resolvedTransitiveDep(
    LockEntry{
      name: name,
      url: doc.gitUrl,
      commit: rr.sha,
      tag: rr.tag,
      requires: manifestRequires(depManifest),
      vanity: d.vanityName,
      dir: doc.dir,
    },
    rr,
  )
}

// One transitive requirement resolved all the way to bytes on disk: the
// `bit.lock` entry for it, and the version its ref selected. The version
// travels beside the entry rather than inside it because `LockEntry.version`
// records the version PubGrub finally chose for the name
// (`lockEntryResolvedAs`), which is not necessarily the one this particular
// requirement asked for — a range's highest match can lose to a lower
// version another requirement pinned.
class TransitiveDep { entry: LockEntry, version: Version, isVersion: bool }

fn resolvedTransitiveDep(entry: LockEntry, rr: TransitiveRef): TransitiveDep {
  return TransitiveDep{ entry: entry, version: rr.version, isVersion: rr.isVersion }
}

// Runs `resolvePubGrub` (#2366) over `rootRequires`/`modules`, converting a
// structured `ResolveFailure` into this file's own `fail`/`?` convention —
// every OTHER function here already fails through that channel, and
// `resolvePubGrub` deliberately does not (pmresolve.bit's own header: a
// caller decides how to surface a conflict, this file surfaces it as a
// normal `bit add`/`bit up` error). `available` is derived straight from
// `modules`: every candidate this walk's callers ever try to decide is one
// this file has ALREADY fetched (a version-tagged ref always resolves to
// one concrete commit before it ever reaches the resolver), so there is no
// separate range search here yet — that is #2367/#2368's job.
fn pmResolveOrFail(rootRequires: []RootRequirement, modules: []ModuleReqs): map<string, Version>! {
  let graph = ReqGraph{
    rootRequires: rootRequires,
    modules: modules,
    available: packageVersionsFromModules(modules),
  }
  match (resolvePubGrub(graph)) {
    Ok(resolved) => { return resolved }
    Err(f) => { fail newError(f.message) }
  }
}

// Everything one `resolveTransitiveDeps` walk discovers, in one place so
// each step below takes it as a single parameter (spec/LINT.md's E0202,
// `max-params` 5) instead of threading seven collections through every
// signature. `locked` is the caller's already-locked entries, READ-ONLY for
// the whole walk: discovery only fetches and records candidates, so the
// answer never depends on queue order, and both classes of winner are
// written into the caller's list only in the two materialization passes at
// the end.
class TransWalk {
  cacheRoot: string,
  gitBin: string,
  timeoutMs: int,
  locked: []LockEntry,
  queue: []PendingReq,
  visitedSpec: map<string, bool>,
  rootRequires: []RootRequirement,
  modules: []ModuleReqs,
  fetchedByVersion: map<string, LockEntry>,
  visitedNonVersion: map<string, bool>,
  nonVersionFetched: map<string, LockEntry>,
  nonVersionNames: []string,
}

// A walk seeded with `seed`'s requirements as this resolver's own roots —
// the only `PendingReq`s carrying `fromRoot: true`, and therefore the only
// ones fed to `resolvePubGrub` as `RootRequirement`s.
fn newTransWalk(
  cacheRoot: string, gitBin: string, locked: []LockEntry, seed: []LockRequire, timeoutMs: int,
): TransWalk {
  let queue = []PendingReq(0)
  let i = 0
  while (i < len(seed)) {
    queue = append(queue, PendingReq{ name: seed[i].name, spec: seed[i].ref, fromRoot: true })
    i = i + 1
  }
  return TransWalk{
    cacheRoot: cacheRoot,
    gitBin: gitBin,
    timeoutMs: timeoutMs,
    locked: locked,
    queue: queue,
    visitedSpec: map<string, bool>{},
    rootRequires: []RootRequirement(0),
    modules: []ModuleReqs(0),
    fetchedByVersion: map<string, LockEntry>{},
    visitedNonVersion: map<string, bool>{},
    nonVersionFetched: map<string, LockEntry>{},
    nonVersionNames: []string(0),
  }
}

// Records one resolved version candidate — keyed on the version that was
// SELECTED, not on the requirement that selected it, so two requirements
// landing on the same version (an exact `@0.1.5` and a `^0.1.0` that
// resolves to it) contribute one `ModuleReqs` entry and one fetch's worth of
// edges, exactly as two identical exact pins already did.
fn recordVersionCandidate(w: TransWalk, req: PendingReq, dep: TransitiveDep) {
  let key = "${req.name}@${versionText(dep.version)}"
  let (_, seen) = w.fetchedByVersion[key]
  if (seen) {
    return
  }
  w.fetchedByVersion[key] = dep.entry
  w.modules = append(
    w.modules,
    ModuleReqs{
      name: req.name,
      version: dep.version,
      requires: versionRequirementsOf(dep.entry.requires),
    },
  )
  w.queue = enqueueRequires(w.queue, dep.entry.requires)
}

// One requirement off the queue: resolved, fetched, and recorded under
// whichever of the two classes its ref belongs to.
//
// The dedup key for a version-set requirement is the requirement STRING, not
// the version — a range has no version until it has been resolved against
// the remote, which is a fetch. Two different spellings of the same exact
// version (`@v1.2.3` and `@1.2.3`) therefore resolve twice where they used
// to resolve once; `recordVersionCandidate` above still collapses them into
// one candidate, and the walk still terminates for the same reason it always
// did — the number of distinct (name, ref) pairs reachable across every
// `bit.json` it reads is finite, so a cycle or self-dependency cannot loop
// it forever.
fn walkRequirement(w: TransWalk, req: PendingReq): ()! {
  if (lockHasEntry(w.locked, req.name)) {
    return
  }
  let (c, statesVersion) = pendingConstraint(req.spec)
  if (!statesVersion) {
    let (_, seenNV) = w.visitedNonVersion[req.name]
    if (seenNV) {
      return
    }
    w.visitedNonVersion[req.name] = true
    let dep = resolveTransitiveSpec(w.cacheRoot, w.gitBin, req.name, req.spec, w.timeoutMs)?
    w.nonVersionFetched[req.name] = dep.entry
    w.nonVersionNames = append(w.nonVersionNames, req.name)
    w.queue = enqueueRequires(w.queue, dep.entry.requires)
    return
  }
  if (req.fromRoot) {
    w.rootRequires = append(
      w.rootRequires,
      RootRequirement{ requirer: "root", name: req.name, constraint: c },
    )
  }
  let specKey = "${req.name}@${req.spec}"
  let (_, seenSpec) = w.visitedSpec[specKey]
  if (seenSpec) {
    return
  }
  w.visitedSpec[specKey] = true
  let dep = resolveTransitiveSpec(w.cacheRoot, w.gitBin, req.name, req.spec, w.timeoutMs)?
  recordVersionCandidate(w, req, dep)
}

// Bounded worklist: `w.queue` only ever grows from a freshly-fetched
// dependency's own `requires` list (`enqueueRequires`), and a requirement
// already resolved is never resolved again (`walkRequirement`'s two visited
// maps) — so the total number of fetches is bounded by the number of
// distinct requirement edges reachable across every `bit.json` this walk
// actually reads, the same bound `resolvePubGrub`'s own worklist comment
// gives for its walk.
fn runTransWalk(w: TransWalk): ()! {
  let qi = 0
  while (qi < len(w.queue)) {
    let req = w.queue[qi]
    qi = qi + 1
    walkRequirement(w, req)?
  }
}

// The version-tagged winners, written into `entries` — the tie-break rule
// this file's module comment names, applied first so a name discovered both
// ways keeps its arbitrated version.
fn materializeVersionWinners(
  entries: []LockEntry, w: TransWalk, resolved: map<string, Version>,
): []LockEntry! {
  let out = entries
  let vi = 0
  while (vi < len(w.modules)) {
    let name = w.modules[vi].name
    vi = vi + 1
    if (lockHasEntry(out, name)) {
      continue
    }
    let (winner, found) = resolved[name]
    if (!found) {
      continue
    }
    let (entry, hasEntry) = w.fetchedByVersion["${name}@${versionText(winner)}"]
    if (!hasEntry) {
      fail newError("pmcli: internal error resolving transitive dependency ${name}: PubGrub chose v${versionText(winner)}, which this resolver never fetched")
    }
    // `winner` IS the version #2366's PubGrub resolver just matched for
    // `name` — recorded verbatim (#2856), not re-derived from `entry`'s own
    // fetched ref string.
    //
    // `entry.tag` (#4481) is the tag `resolveTransitiveSpec` actually
    // matched, carried up from `resolveVersionRefSha` rather than guessed
    // from `winner`: the two spellings `v0.1.0` and `0.1.0` name the same
    // version and different git tags, and on a `dir` package the tag is
    // `<key>/v0.1.0` (#4472), so it cannot be rebuilt from the version here.
    // `entry` is the one fetched for that exact version, so its tag is
    // `winner`'s tag and not some other candidate's.
    out = upsertLockEntry(out, lockEntryResolvedAs(entry, versionText(winner), entry.tag))
  }
  return out
}

// The branch/bare-sha winners, written into `entries` after the version ones
// so a name discovered both ways keeps the arbitrated version (an exact
// pinned version is a strictly stronger constraint than an unordered ref).
fn materializeNonVersionRefs(entries: []LockEntry, w: TransWalk): []LockEntry {
  let out = entries
  let ni = 0
  while (ni < len(w.nonVersionNames)) {
    let name = w.nonVersionNames[ni]
    ni = ni + 1
    if (lockHasEntry(out, name)) {
      continue
    }
    let (entry, hasEntry) = w.nonVersionFetched[name]
    if (!hasEntry) {
      continue
    }
    // A branch or bare-sha requirement (`nonVersionFetched`'s own
    // definition, above) is never a version (#2856): "" records "unknown",
    // exactly as an entry written before this field existed would read back.
    out = upsertLockEntry(out, lockEntryResolvedAs(entry, "", ""))
  }
  return out
}

// Fetches every dependency reachable from `seed` (typically every
// already-locked entry's own `requires`, flattened — `flattenRequires`,
// below) that does not already have a top-level `bit.lock` entry, giving
// each its own entry — the loop pmz.bit's own module comment says
// `pmresolve.bit` is missing.
export fn resolveTransitiveDeps(
  cacheRoot: string, gitBin: string, entries: []LockEntry, seed: []LockRequire, timeoutMs: int,
): []LockEntry! {
  let w = newTransWalk(cacheRoot, gitBin, entries, seed, timeoutMs)
  runTransWalk(w)?
  let resolved = pmResolveOrFail(w.rootRequires, w.modules)?
  return materializeNonVersionRefs(materializeVersionWinners(entries, w, resolved)?, w)
}

// Every entry's own `requires`, flattened into one `[]LockRequire` — the
// seed `resolveTransitiveDeps` starts its walk from, covering not just a
// dependency just added but every requirement `bit.lock` already records (a
// lock file written before this walk existed, or an entry whose own
// requirements have grown since the last resolution).
fn flattenRequires(entries: []LockEntry): []LockRequire {
  let out = []LockRequire(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      out = append(out, entries[i].requires[j])
      j = j + 1
    }
    i = i + 1
  }
  return out
}
