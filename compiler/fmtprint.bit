// compiler/fmtprint.bit — the node-print entry point (fmtPrintNode) and the
// block/sequence/member printing helpers (fmtPrintBodyBlock, fmtPrintBlock,
// fmtPrintSeq, class-body member and method printing), split out of fmt.bit
// at 793 lines against the 800-line limit (#4322). Same module as fmt.bit
// and its other siblings (fmtdispatch.bit, fmtexpr.bit, fmtwrap.bit,
// fmtclass.bit, fmttrait.bit), so nothing here is imported.

// The node dispatch entry: depth-guarded, then hands off to fmtDispatch, then
// advances srcPos past the node's span.
fn fmtPrintNode(p: Printer, idx: int) {
  if (idx == 0) {
    return
  }
  if (p.depth >= fmtMaxDepth) {
    return
  }
  p.depth = p.depth + 1
  let n = getNode(p.tree, idx)
  fmtDispatch(p, idx, n)
  if (n.span.end > p.srcPos) {
    p.srcPos = n.span.end
  }
  p.depth = p.depth - 1
}

// A postfix chain's receiver or a spawn/defer operand: atomic unless parens
// made it a binary/unary/catch/arrow/conditional underneath, in which case
// they must be re-added. `Tag.IntLit` is also wrapped: an int literal printed
// immediately before the bare `.` that `Tag.Member`/`Tag.TupleIndex` emit next
// re-lexes as the start of a float literal (`5.zzz`), changing the token
// stream, not just style.
fn fmtPrintAtomic(p: Printer, idx: int) {
  let t = getNode(p.tree, idx).tag
  let wrap = t == Tag.Binary ||
    t == Tag.Unary ||
    t == Tag.CatchDefault ||
    t == Tag.CatchBind ||
    t == Tag.ArrowFn ||
    t == Tag.CondExpr ||
    t == Tag.IntLit
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// `catch`'s left operand: only catch/arrow need re-parenthesizing there.
fn fmtPrintCatchLhs(p: Printer, idx: int) {
  let t = getNode(p.tree, idx).tag
  let wrap = t == Tag.CatchDefault || t == Tag.CatchBind || t == Tag.ArrowFn
  if (wrap) {
    fmtRaw(p, "(")
    fmtPrintNode(p, idx)
    fmtRaw(p, ")")
  } else {
    fmtPrintNode(p, idx)
  }
}

// True for a statement/declaration whose canonical form always ends in a
// block's closing `}` — printed with no trailing `;` (safe: `}` is an ASI
// terminator). The tag list itself is `fmtEndsInBlockTag` (fmtasm.bit,
// #4308), a sibling split purely so a new block-ending tag costs that
// function's complexity, never this one's own recorded baseline
// (tools/build/complexity-debt.txt).
fn fmtEndsInBlock(p: Printer, idx: int): bool {
  let t = getNode(p.tree, idx).tag
  if (fmtEndsInBlockTag(t)) {
    return true
  }
  if (t == Tag.Export) {
    return fmtEndsInBlock(p, kidsOf(p.tree, idx)[0])
  }
  return false
}

// Whether `idx`'s canonical form ends in a token after which ASI inserts a
// semicolon — so an explicit `;` can be omitted. The last token kind is
// invariant under canonicalization, so reading it from the source span is sound.
fn fmtEndsInTerminator(p: Printer, idx: int): bool {
  let sp = getNode(p.tree, idx).span
  if (sp.end <= sp.start) {
    return false
  }
  let toks = lexAll(p.source[sp.start:sp.end])
  let last = Kind.Eof
  let i = 0
  while (i < len(toks)) {
    if (toks[i].kind != Kind.Eof) {
      last = toks[i].kind
    }
    i = i + 1
  }
  // The lexer synthesizes a `.semicolon` at end-of-input after a terminator, so
  // a trailing synthesized `;` is the definitive signal ASI would fire. Fall
  // back to the raw terminator check for safety.
  return last == Kind.Semicolon || isTerminator(last)
}

// A `{ stmt }` block that canonicalizes onto one line: exactly one child, that
// child a simple statement (not block/control-flow, no inner match), and no
// comment inside the braces.
fn fmtBlockInlineable(p: Printer, idx: int): bool {
  let items = kidsOf(p.tree, idx)
  if (len(items) != 1) {
    return false
  }
  if (fmtEndsInBlock(p, items[0])) {
    return false
  }
  if (fmtContainsMatch(p, items[0])) {
    return false
  }
  return !fmtHasCommentBefore(p, getNode(p.tree, idx).span.end)
}

// Whether `idx`'s subtree contains a `match`, which always renders multi-line.
fn fmtContainsMatch(p: Printer, idx: int): bool {
  if (idx == 0) {
    return false
  }
  if (getNode(p.tree, idx).tag == Tag.MatchStmt) {
    return true
  }
  let kids = kidsOf(p.tree, idx)
  let i = 0
  while (i < len(kids)) {
    if (fmtContainsMatch(p, kids[i])) {
      return true
    }
    i = i + 1
  }
  return false
}

// Prints a body that is either a `.block` (collapsed to `{ stmt }` when
// inlineable, else stacked) or a bare match-arm statement. `preserveSource`
// (function bodies) inlines only what the author wrote inline; match arms pass
// false, always collapsing a braced body.
fn fmtPrintBodyBlock(p: Printer, idx: int, preserveSource: bool) {
  let n = getNode(p.tree, idx)
  let sourceInline = !preserveSource || newlinesBetween(p.source, n.span.start, n.span.end) == 0
  if (n.tag == Tag.Block && fmtBlockInlineable(p, idx) && sourceInline) {
    let firstKid = kidsOf(p.tree, idx)[0]
    if (fmtInlineFits(p, firstKid)) {
      fmtRaw(p, "{ ")
      fmtPrintNode(p, firstKid)
      fmtRaw(p, " }")
      if (n.span.end > p.srcPos) {
        p.srcPos = n.span.end
      }
      return
    }
  }
  fmtPrintNode(p, idx)
}

// Whether the sole statement of an inline body renders on one line within the
// width, as `{ stmt }` at the current column. Trial-renders and fully restores
// every mutable field, so it is side-effect-free.
fn fmtInlineFits(p: Printer, stmt: int): bool {
  let col0 = p.col
  let sBol = p.bol
  let sIndent = p.indent
  let sSrc = p.srcPos
  let sCi = p.ci
  let sDepth = p.depth
  let savedOut = p.out
  p.out = []byte(0)
  p.col = col0 + 2
  p.bol = false
  fmtPrintNode(p, stmt)
  let text = string(p.out)
  p.out = savedOut
  p.col = col0
  p.bol = sBol
  p.indent = sIndent
  p.srcPos = sSrc
  p.ci = sCi
  p.depth = sDepth
  return !fmtHasNl(text) && col0 + 2 + len(text) + 2 <= fmtMaxWidth
}

// Like fmtPrintSeq but never keeps a blank before the first item. Used for
// switch/select clause lists and case/default bodies.
fn fmtPrintNoLeadBlank(p: Printer, items: []int, stmtStyle: bool) {
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, i != 0)
    fmtPrintNode(p, items[i])
    if (stmtStyle && !fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
}

// Statement/declaration sequence (top decls, block statements, case bodies): one
// per line, one blank line preserved from the source.
fn fmtPrintSeq(p: Printer, items: []int, stmtStyle: bool) {
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, true)
    fmtPrintNode(p, items[i])
    if (stmtStyle && !fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
}

// A brace block: `{`, the stacked statements (no blank kept right after `{`),
// then `}`.
fn fmtPrintBlock(p: Printer, idx: int) {
  let n = getNode(p.tree, idx)
  let items = kidsOf(p.tree, idx)
  fmtRaw(p, "{")
  // Every gap inside the braces counts blank lines from the `{` itself, not
  // from wherever the last printed node happened to end. `srcPos` only
  // ratchets at a node's span end (fmtPrintNode above) and an arrow head
  // (`() => {`) ends no node, so a comment-only body was measured from the
  // end of an earlier call argument one or more lines above and gained a
  // blank line on the second pass (#4956).
  if (n.span.start + 1 > p.srcPos) {
    p.srcPos = n.span.start + 1
  }
  if (len(items) == 0 && !fmtHasCommentBefore(p, n.span.end)) {
    fmtRaw(p, "}")
    return
  }
  p.indent = p.indent + 1
  fmtPrintNoLeadBlank(p, items, true)
  fmtGap(p, n.span.end, true)
  p.indent = p.indent - 1
  fmtRaw(p, "}")
}

// True when a class body's member list (fmtdispatch.bit's field_list case)
// holds at least one in-body method (SPEC §10.4, #3367) — a func_decl,
// possibly wrapped in export — or a `use` statement (SPEC §10.7, #3369),
// rather than only fields, or a field carrying an attribute (SPEC §10.5,
// #3879). Field-only classes with no attributes keep the existing comma-list
// rendering unchanged; any of the three switches to fmtPrintMemberBlock
// below, one member per line — `use A, B, x: f64` on a comma list would give
// no way to see where the traits end and the fields begin, and an attribute
// belongs on its own line above its field, which a comma list has no room for.
fn fmtFieldListNeedsBlock(t: Tree, idx: int): bool {
  let items = kidsOf(t, idx)
  let i = 0
  while (i < len(items)) {
    let it = items[i]
    if (getNode(t, it).tag == Tag.Export) {
      it = kidsOf(t, it)[0]
    }
    let itag = getNode(t, it).tag
    if (itag == Tag.FuncDecl || itag == Tag.UseStmt) {
      return true
    }
    // A field attribute (SPEC §10.5, #3879) prints on its own line above the
    // field, so the comma-list form cannot render it at all — one attributed
    // field puts the whole body in the one-member-per-line form.
    if (itag == Tag.Field && fieldAttrList(t, it) != 0) {
      return true
    }
    i = i + 1
  }
  return false
}

// The two halves of a method's merged generics kid (mergeGenericParams's
// "receiver params first" contract, parsertype.bit): `prefix` is
// class-derived, `own` is the method's own trailing generics. One ordering
// fact recovers the split without a third AST shape or a parser change: a
// receiver-derived param's node always starts BEFORE the method's own name.
// (Before #3762 retired the written receiver form, `fn (s: Stack<T>)
// push(...)` reached this the same way — its own `<T>` parsed entirely
// before the name it preceded.) An in-body method's implicit receiver
// (parsertype.bit's dupGenericParams) reuses the class's own declared param
// nodes verbatim, spanned back at the class header — while the method's own
// generics (`maybeGenericParams` called immediately after the name) always
// start after it (#3767).
class FmtGenericsSplit {
  prefix: []int,
  own: []int,
}

fn fmtSplitGenerics(p: Printer, genericsNode: int, nameNode: int): FmtGenericsSplit {
  if (genericsNode == 0) {
    return FmtGenericsSplit{ prefix: []int(0), own: []int(0) }
  }
  let items = kidsOf(p.tree, genericsNode)
  let nameStart = getNode(p.tree, nameNode).span.start
  let prefix = []int(0)
  let own = []int(0)
  let i = 0
  while (i < len(items)) {
    if (getNode(p.tree, items[i]).span.start < nameStart) {
      prefix = append(prefix, items[i])
    } else {
      own = append(own, items[i])
    }
    i = i + 1
  }
  return FmtGenericsSplit{ prefix: prefix, own: own }
}

// Prints `items` as a `<...>` generics clause, or nothing when empty —
// `genericsNode` supplies the true closing position for the wrap-width/
// comment checks (safe even when `items` is a strict subset of its kids,
// since the case that matters, `items` non-empty, only arises when `items`
// IS the merged node's own trailing kids per fmtSplitGenerics above, so its
// span really does end where the last printed item does).
fn fmtPrintGenericsList(p: Printer, items: []int, genericsNode: int) {
  if (len(items) == 0) {
    return
  }
  fmtPrintCommaList(p, items, "<", ">", getNode(p.tree, genericsNode).span.end)
}

// Prints an in-body method from its desugared func_decl/receiver shape
// (parsertype.bit's parseMethodMember): no `fn` keyword and no receiver
// clause — just the member's own name, generics, signature and body, exactly
// as SPEC §10.4's in-body form is written. `idx` is the func_decl itself
// (export, if any, is the caller's concern — fmtPrintMemberBlock below).
// The generics kid is the merged (receiver + own) list — see
// fmtSplitGenerics — so only its `own` half is ever re-emitted here; the
// receiver-derived half is implicit for this form and already printed
// nowhere (#3767: printing the merged list whole re-declared the class's own
// `T` on every method, e.g. `get<T>(): T`, which the checker then rejected
// with E0042).
fn fmtPrintClassMethod(p: Printer, idx: int) {
  let k = kidsOf(p.tree, idx) // [recv, name, generics, params, result, body]
  fmtPrintNode(p, k[1])
  fmtPrintGenericsList(p, fmtSplitGenerics(p, k[2], k[1]).own, k[2])
  let hasRet = k[4] != 0
  let retText = ""
  if (hasRet) {
    retText = fmtRenderFlat(p, k[4])
  }
  if (hasRet) {
    p.nextListTail = len(retText) + 2 + 2
  } else {
    p.nextListTail = 2
  }
  fmtPrintNode(p, k[3])
  if (hasRet) {
    fmtRaw(p, ": ")
    fmtRaw(p, retText)
  }
  fmtRaw(p, " ")
  fmtPrintBodyBlock(p, k[5], true)
}

// One class body member: a field prints exactly as it always has (the
// generic dispatch already handles `export` wrapping a field), but an
// in-body method must bypass fmtDispatch's ordinary func_decl case — that
// one prints a top-level function's plain `fn name` (and, before #3762
// retired it, the written `fn (recv) name` form) — and go through
// fmtPrintClassMethod instead, with `export` (if any) printed here first.
fn fmtPrintMember(p: Printer, raw: int) {
  let exported = getNode(p.tree, raw).tag == Tag.Export
  let inner = raw
  if (exported) {
    inner = kidsOf(p.tree, raw)[0]
  }
  if (getNode(p.tree, inner).tag != Tag.FuncDecl) {
    fmtPrintNode(p, raw)
    return
  }
  if (exported) {
    fmtRaw(p, "export ")
  }
  // 'init' (classinit.bit, #3371) prints its own compact fallible marker —
  // bare '!', never fmtPrintClassMethod's ': ()!' — since parseInitMember's
  // grammar has no colon to read one back from.
  if (isClassInitDecl(p.tree, p.source, inner)) {
    fmtPrintClassInit(p, inner)
    return
  }
  fmtPrintClassMethod(p, inner)
}

// A class body mixing fields and in-body methods (SPEC §10.4): one member per
// line, blank lines preserved, no trailing separator — a field's declared
// type and a method's closing `}` are both ASI terminators (§7), so `bit fmt`
// never needs to print one (fmtEndsInBlock/fmtEndsInTerminator, both already
// widened or already correct for a nested func_decl).
fn fmtPrintMemberBlock(p: Printer, items: []int, listSpan: Span) {
  fmtRaw(p, "{")
  if (len(items) == 0 && !fmtHasCommentBefore(p, listSpan.end)) {
    fmtRaw(p, "}")
    return
  }
  p.indent = p.indent + 1
  let i = 0
  while (i < len(items)) {
    fmtGap(p, getNode(p.tree, items[i]).span.start, true)
    fmtPrintMember(p, items[i])
    if (!fmtEndsInBlock(p, items[i]) && !fmtEndsInTerminator(p, items[i])) {
      fmtRaw(p, ";")
    }
    i = i + 1
  }
  fmtGap(p, listSpan.end, true)
  p.indent = p.indent - 1
  fmtRaw(p, "}")
}
