// compiler/x64compile.bit — the x86-64 backend's top-level per-function
// driver (xCompileFunction), split out of compiler/x64dispatch.bit under
// #4396: that file crossed 800 lines (804) once the AtomicCmpxchg width fix
// added the AtomicCasOperands-taking call site. Mirrors arm64compile.bit's
// own split of the top-level driver out of the per-instruction dispatch.
// Sibling .bit file, same module: nothing here is imported, and
// xEmitInst/xScanFuncFlags/xBuildIntRegs/xCollectReserved stay in
// x64dispatch.bit.
//
// Sorts before compiler/x64compilecheck.bit and after compiler/x64check.bit —
// module files concatenate in bytewise filename order (compiler/project.bit:7);
// resolution is order-independent (name binding happens before any body is
// typed), so this affects diagnostic order only, not correctness.

// Top-level driver
// ---------------------------------------------------------------------------

// #5992 ports #4429: the int file's `pollSaved` is `xIsPollSavedInt`, the
// compiler's copy of runtime/stw/stwpoll.bit's x86-64 payload, and the two
// move together or not at all. The float file's is its callee-saved mask
// unchanged, because the shim saves no XMM: under SysV that is no XMM at all,
// so a float still cannot cross a poll in a register; under Win64 xmm6..xmm15
// survive because `stwSafepoint` is an ordinary Win64 callee.
fn xTargetRegs(cc: XCallConv, intRegs: []XReg64, floatRegs: []XmmReg): TargetRegs {
  return TargetRegs{
    intRegs = RegFile{
      count = len(intRegs),
      calleeSaved = xCalleeSavedIntMask(cc, intRegs),
      pollSaved = xPollSavedIntMask(cc, intRegs),
    },
    floatRegs = RegFile{
      count = len(floatRegs),
      calleeSaved = xCalleeSavedFloatMask(cc, floatRegs),
      pollSaved = xCalleeSavedFloatMask(cc, floatRegs),
    },
  }
}

// The poll's surviving set in FILE-POSITION indexing, as xCalleeSavedIntMask.
fn xPollSavedIntMask(cc: XCallConv, regs: []XReg64): int {
  let mask = 0
  let i = 0
  while (i < len(regs)) {
    if (xIsPollSavedInt(cc, regs[i])) {
      mask = mask | (1 << i)
    }
    i = i + 1
  }
  return mask
}

// #5992: this function's call structure split by what survives each position,
// exactly as arm64compile.bit's `arm64AllocPoints`. The poll/call split reads
// only the IR op at each position, so both backends call the same two
// helpers (the `arm64` prefix is historical, as `xClobberPoints`' `x` is).
//
// #6382: an `asm` block naming a caller-saved allocatable register is a clobber
// point here too (asmPointPositions), which is what xCollectReserved no longer
// does for it. #7251: so is a caller-saved `input`/`result` pin, narrower
// (xAsmPins).
fn xAllocPoints(
  module: IrModule, f: IrFunc, safepoints: []int, intRegs: []XReg64,
): AllocPoints {
  let calls = arm64CallSafepoints(f, safepoints)
  let clobbers = xClobberPoints(f, plainCallPoints(f, calls, false))
  for p of asmPointPositions(module, f, false, xAsmPointMask()) {
    clobbers = append(clobbers, p)
  }
  return AllocPoints{
    safepoints = safepoints,
    calleeSafepoints = calls,
    polls = arm64PollSafepoints(f, safepoints),
    clobbers = clobbers,
    calls = plainCallPoints(f, calls, true),
    pins = xAsmPins(module, f, intRegs),
  }
}

// #7251: every `asm` block's caller-saved `input`/`result` registers, as an
// AsmPin over this function's int file. A callee-saved pin never matches:
// reserveAsmX64 keeps it out of `intRegs` for the whole function so that
// `reservedSavedGpr` saves it.
fn xAsmPins(module: IrModule, f: IrFunc, intRegs: []XReg64): []AsmPin {
  let out = []AsmPin(0)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    if (ins.op == Op.Asm) {
      let mask = xPinFileMask(module.asmBlocks[ins.ival], intRegs)
      if (mask != 0) {
        out = append(out, AsmPin{ pos = i, intMask = mask })
      }
    }
    i = i + 1
  }
  return out
}

fn xPinFileMask(blk: AsmBlock, intRegs: []XReg64): int {
  let mask = 0
  let k = 0
  while (k < len(intRegs)) {
    let r = xRegNum(intRegs[k])
    if ((blk.hasResult && blk.resultX64 == r) || posInList(blk.inX64, r)) {
      mask = mask | (1 << k)
    }
    k = k + 1
  }
  return mask
}

// #6382: the registers whose presence in an asm `clobber` list makes the block a
// clobber point — the allocatable registers NEITHER convention preserves (rax,
// rcx, rdx, r8, r9), the complement of xIsCalleeSavedAnyConv. r10/r11/r12 are
// scratch and never allocated, so naming them changes nothing.
fn xAsmPointMask(): int {
  let mask = 0
  for r of xMasterGprs() {
    if (!xIsCalleeSavedAnyConv(r)) {
      mask = mask | (1 << xRegNum(r))
    }
  }
  return mask
}

// #5992: every stack map names only registers its safepoint's snapshot holds.
// A call's map is read after the walk restored the file through prologue save
// slots, which hold only `xIsCalleeSavedInt` registers; a back-edge poll's map
// is read from the shim's raw snapshot, which holds `xIsPollSavedInt`.
fn xAssertStackMapsSnapshotSaved(
  result: RegAllocResult, cc: XCallConv, intRegs: []XReg64, polls: []int,
) {
  for sm of result.stackMaps {
    let atPoll = posInList(polls, sm.pos)
    for ri of sm.regs {
      let r = intRegs[ri]
      assert(
        xIsCalleeSavedInt(cc, r) || (atPoll && xIsPollSavedInt(cc, r)),
        "stack map names a register the safepoint shim does not save (runtime/ABI.md §4)",
      )
    }
  }
}

// The register files for one function, before interval building or
// allocation: the master int/float lists, narrowed by whatever an `asm`/
// `syscall` block reserves and, for a @naked function, to the volatile-only
// file (see xBuildFrameSetup's doc comment for why). Carries module/cc/ctx
// alongside them since every later phase needs the same three.
// `reservedSavedGpr` is the callee-saved subset of what was just narrowed OUT
// (#6197): an `asm` pin writes that register despite the allocator never
// touching it, so `xBuildAllocPhase` unions it into `savedGpr` even though
// `used`-based `xBuildSavedGpr` can never see it.
// One allocation per function compiled, built at a single site in
// xBuildFrameRegs -- the once-per-unit-lowered cost, never per instruction.
class XFrameRegs {
  module: IrModule,
  cc: XCallConv,
  ctx: TypeContext,
  flags: XFuncFlags,
  intRegs: []XReg64,
  floatRegs: []XmmReg,
  reservedSavedGpr: []XReg64,
}

// Register files (post-naked-filtering), the interval/allocation result and
// the finished frame layout -- everything xCompileFunction needs before it
// can start emitting code. nakedSpillOverflow substitutes for a fallible
// return: an empty FuncCode is a legitimate backend answer for a @naked
// function that outgrew its volatile-only file, and xCompileFunction still
// owns deciding what to do about it, not this phase.
// One allocation per function compiled, built at a single site in
// xBuildFrameSetup -- the once-per-unit-lowered cost, never per instruction.
class XFrameSetup {
  built: IntervalBuild,
  result: RegAllocResult,
  skipConst: []bool,
  needsCallAlign: bool,
  frame: XFrame,
  nakedSpillOverflow: bool,
}

// #7241: `regs` with every register a call destroys ahead of every one it
// preserves, each group in its own order. The allocator hands out the lowest
// free file position, so a value no clobber point reaches now takes a
// caller-saved register while one is free, rather than rbx (master position 3)
// and a push/pop pair in the prologue it would otherwise not need. A value that
// crosses one is held to the callee-saved positions either way (calleeSaved).
fn xVolatileFirst(cc: XCallConv, regs: []XReg64): []XReg64 {
  let out = []XReg64(0)
  for r of regs {
    if (!xIsCalleeSavedInt(cc, r)) {
      out = append(out, r)
    }
  }
  for r of regs {
    if (xIsCalleeSavedInt(cc, r)) {
      out = append(out, r)
    }
  }
  return out
}

// The register files this function will allocate out of: the master
// int/float lists, narrowed by whatever an `asm`/`syscall` block reserves
// and, for a @naked function, to the volatile-only file.
fn xBuildFrameRegs(module: IrModule, f: IrFunc, cc: XCallConv, debug: bool): XFrameRegs {
  let ctx = module.ctx
  let flags = xScanFuncFlags(f)
  let intRegs = xBuildIntRegs(flags)
  let floatRegs = xBuildFloatRegs()

  // Callee-saved registers an `asm` block pins (`input`/`result`/clobber,
  // §11.6; the caller-saved ones are points, xAllocPoints) and every register a
  // `syscall` pins (number/argument/clobber, §11.8) leave the allocatable file
  // for the whole function — the same exclusion the needsRaxRdx/needsRcx flags
  // apply for div/shift, generalized to an arbitrary set. Neither construct
  // leaves `intRegs` exactly as `xBuildIntRegs` returned.
  let reserved = xCollectReserved(module, f)
  if (xNeedsScratch3(f, debug)) {
    reserved[xRegNum(XReg64.R12)] = true
  }
  let allocRegs = []XReg64(0)
  let ri = 0
  while (ri < len(intRegs)) {
    if (!reserved[xRegNum(intRegs[ri])]) {
      allocRegs = append(allocRegs, intRegs[ri])
    }
    ri = ri + 1
  }
  intRegs = xVolatileFirst(cc, allocRegs)

  // §10.3.1 @naked: the prologue never runs, so a callee-saved register would be
  // clobbered without ever being saved. Restrict a naked function to the volatile
  // file. If that is not enough registers, regalloc spills instead — and the frame
  // check below refuses the function loudly rather than letting it silently
  // corrupt its caller.
  if (f.isNaked) {
    let nakedInt = []XReg64(0)
    let ni = 0
    while (ni < len(intRegs)) {
      if (!xIsCalleeSavedInt(cc, intRegs[ni])) {
        nakedInt = append(nakedInt, intRegs[ni])
      }
      ni = ni + 1
    }
    intRegs = nakedInt
    let nakedFloat = []XmmReg(0)
    let nf = 0
    while (nf < len(floatRegs)) {
      if (!xIsCalleeSavedFloat(cc, floatRegs[nf])) {
        nakedFloat = append(nakedFloat, floatRegs[nf])
      }
      nf = nf + 1
    }
    floatRegs = nakedFloat
  }

  return XFrameRegs{
    module = module, cc = cc, ctx = ctx, flags = flags,
    intRegs = intRegs, floatRegs = floatRegs,
    reservedSavedGpr = xReservedSavedGpr(cc, reserved, f.isNaked),
  }
}

// #6198: whether this function emits a selector that needs a third integer
// scratch (`xScratch3`, r12). r12 is callee-saved under both conventions, so
// such a function marks it `reserved` and `xReservedSavedGpr` saves it in the
// prologue exactly like an asm pin: a C caller's r12 survives. r12 stays out
// of `xMasterGprs` until the runtime archive, which the pinned stage0 builds,
// preserves it too; a Bit caller holding a value there would lose it to every
// stage0-built runtime function that still treats r12 as scratch. Debug
// builds hold it whenever they trap signed overflow (x64selectovf.bit), which
// this scan cannot see per instruction without the width and the fold plan.
fn xNeedsScratch3(f: IrFunc, debug: bool): bool {
  if (debug) {
    return true
  }
  for ins of f.instrs {
    let op = ins.op
    if (op == Op.FFloor || op == Op.FCeil || op == Op.FTrunc || op == Op.FRound) {
      return true
    }
  }
  return false
}

// The third integer scratch: r12, legal only in a function `xNeedsScratch3`
// reserved it for, so the prologue saved the caller's (a @naked function has
// no prologue and an empty saved list) and no allocated value lives there.
fn xScratch3(cx: XCtx): XReg64 {
  assert(!xRegListHas(cx.intRegs, XReg64.R12), "xScratch3: r12 is allocatable here")
  assert(cx.f.isNaked || xRegListHas(cx.frame.savedGpr, XReg64.R12), "xScratch3: r12 not saved")
  return XReg64.R12
}

// rdx as a scratch, legal only where `needsRaxRdx` took it out of the file
// (division, mulhi, CMPXCHG): no allocated value can live in it there.
fn xRdxScratch(cx: XCtx): XReg64 {
  assert(!xRegListHas(cx.intRegs, XReg64.Rdx), "xRdxScratch: rdx is allocatable here")
  return XReg64.Rdx
}

fn xRegListHas(regs: []XReg64, r: XReg64): bool {
  for x of regs {
    if (x == r) {
      return true
    }
  }
  return false
}

// #6197: the callee-saved registers `xBuildFrameRegs` just took OUT of
// `intRegs` above that are still WRITTEN — an `asm` block pinned one as
// `input`/`result` or listed it as `clobber` — even though the allocator never
// sees it. Every such register must be preserved exactly like an
// allocator-assigned one, so `xBuildAllocPhase` (below) unions this list into
// `savedGpr`. Disjoint by construction from what `xBuildSavedGpr` finds there,
// since a reserved register can never be in `intRegs` for it to walk.
// `syscall`'s reserved registers (rax/rcx/r11) never pass `xIsCalleeSavedInt`,
// so they add nothing here.
//
// Empty for a @naked function: its prologue/epilogue never run (§10.3.1), so
// saving here would misreport the frame's alignment without a single push
// ever emitted. An asm pin in a naked body is the author's own responsibility,
// same as every other register it touches.
fn xReservedSavedGpr(cc: XCallConv, reserved: []bool, isNaked: bool): []XReg64 {
  let out = []XReg64(0)
  if (isNaked) {
    return out
  }
  // Every GPR, not `xMasterGprs`: r12 is reserved (xScratch3, an asm pin)
  // without ever being allocatable (#6198). rsp/rbp are the frame, never reserved.
  let n = 0
  while (n < 16) {
    let r = xRegOf(n)
    if (reserved[n] && r != XReg64.Rsp && r != XReg64.Rbp && xIsCalleeSavedInt(cc, r)) {
      out = append(out, r)
    }
    n = n + 1
  }
  return out
}

// Interval building, register allocation and the two saved-register lists --
// the inputs the frame-layout phase below needs but does not itself compute.
// One allocation per function compiled, built at a single site in
// xBuildAllocPhase -- the once-per-unit-lowered cost, never per instruction.
class XAllocPhase {
  built: IntervalBuild,
  result: RegAllocResult,
  skipConst: []bool,
  savedGpr: []XReg64,
  savedXmm: []XmmReg,
}

// Sets `used[n]` for every physical XMM `n` a non-spilled float interval was
// given; true when the function holds ANY float interval (spilled or not).
fn xMarkFloatRegsUsed(
  used: []bool, intervals: []LiveInterval, locations: []RegLoc, floatRegs: []XmmReg,
): bool {
  let anyFloat = false
  let vi = 0
  while (vi < len(intervals)) {
    if (intervals[vi].regClass == RegClass.Float) {
      anyFloat = true
      if (!locations[vi].isSpill && locations[vi].index >= 0) {
        used[xmmNum(floatRegs[locations[vi].index])] = true
      }
    }
    vi = vi + 1
  }
  return anyFloat
}

// #6434: the nonvolatile XMMs this function's prologue must hand back whole.
// Win64 makes xmm6..xmm15 callee-saved, and a foreign caller (an OS callback, a
// C caller of an `@symbol` export) expects all 128 bits of each unchanged, so a
// function owes exactly the ones it can write: the allocatable ones it was given
// (`floatRegs[loc.index]` of any non-spilled float interval) and, when it holds
// any float value at all, the scratch pair xmm14/xmm15 (`xFScratch1`/`xFScratch2`:
// every float load, convert, move cycle and spilled-float operand goes through
// them, whether or not its value was spilled). A function with no float value
// saves nothing. SysV preserves no XMM, so it saves nothing either way.
// @naked runs no prologue, so it owes nothing here (its file is volatile-only).
// Ascending register order is the layout (xXmmSaveOffset).
fn xBuildSavedXmm(
  cc: XCallConv, isNaked: bool, intervals: []LiveInterval, locations: []RegLoc,
  floatRegs: []XmmReg,
): []XmmReg {
  let out = []XmmReg(0)
  if (cc == XCallConv.SysV || isNaked) {
    return out
  }
  let used = []bool(16)
  if (xMarkFloatRegsUsed(used, intervals, locations, floatRegs)) {
    used[xmmNum(xFScratch1())] = true
    used[xmmNum(xFScratch2())] = true
  }
  let n = 0
  while (n < 16) {
    if (used[n] && xIsCalleeSavedFloat(cc, xXmmOf(n))) {
      out = append(out, xXmmOf(n))
    }
    n = n + 1
  }
  return out
}

// #7274: each entry param prefers the register `xBindIncomingArgs` reads it
// from and each returned word the one `xEmitRet` writes it to, so both moves
// encode nothing; see regallochint.bit.
fn xMarkRegHints(regs: XFrameRegs, f: IrFunc, intervals: []LiveInterval) {
  let files = HintFiles{ ints = []int(0), floats = []int(0) }
  for r of regs.intRegs {
    files.ints = append(files.ints, xRegNum(r))
  }
  for x of regs.floatRegs {
    files.floats = append(files.floats, xmmNum(x))
  }
  let ords = paramClassOrdinals(f, intervals)
  let entry = f.blocks[0]
  let p = 0
  while (p < entry.paramCount) {
    let iv = intervals[entry.instsStart + p]
    hintTo(iv, files, xArgReg(regs.cc, iv.regClass, p, ords[p]))
    p = p + 1
  }
  for ins of f.instrs {
    if (ins.op == Op.Ret && len(ins.args) > 0) {
      let regsOut = xRetRegsFor(regs.cc, valueClasses(intervals, ins.args))
      hintRetWords(intervals, files, ins.args, regsOut)
    }
  }
  markTies(f, intervals)
}

fn xBuildAllocPhase(f: IrFunc, regs: XFrameRegs): XAllocPhase {
  let built = buildIntervals(regs.ctx, f)
  // #5867: the constants the allocator may evict for free, marked before it
  // copies the array, exactly as arm64 does (regallocremat.bit). #5950's
  // loop-weighted rank makes a cold constant a cheap victim, and without this
  // each one took a frame slot, a store at its definition and a reload at its use.
  markRematIntervals(f, built.intervals, RematIsa.X64)
  // #3738's `built.roots` on the same terms as arm64: the two backends share
  // buildIntervals and regalloc, so a coalescing rule that only one of them
  // consumed would be exactly the per-backend liveness drift codegenlive.bit's
  // header exists to prevent.
  let points = xAllocPoints(regs.module, f, built.safepoints, regs.intRegs)
  // #6839: a constant every use folds takes no register (markFoldedIntervals).
  // `xUsedIntRegs` reads `skipConst` below too: an unmaterialized constant
  // writes no register, so it saves none.
  let skipConst = xComputeSkipConstMaterialize(regs.ctx, f)
  unskipRootedConsts(skipConst, built.intervals, points.safepoints)
  markFoldedIntervals(regs.ctx, f, built.intervals, skipConst)
  xMarkRegHints(regs, f, built.intervals)
  let result = allocateCoalesced(
    xTargetRegs(regs.cc, regs.intRegs, regs.floatRegs),
    built.intervals,
    points,
    built.roots,
    built.edges,
  )
  xAssertStackMapsSnapshotSaved(result, regs.cc, regs.intRegs, points.polls)

  // #5867: a constant the allocator refused a slot materializes nothing at its
  // definition either; every use recomputes it (x64select.bit).
  addRematSkips(skipConst, result.locations)
  let savedGpr = xBuildSavedGpr(
    regs.cc, regs.intRegs,
    xUsedIntRegs(regs.ctx, f, skipConst, built.intervals, result.locations, len(regs.intRegs)),
  )
  // #6197: union in the callee-saved registers an `asm` block pinned OUT of
  // `regs.intRegs` (XFrameRegs.reservedSavedGpr, built above in
  // `xBuildFrameRegs`) — always disjoint from what the walk just found, since
  // none of those registers was ever in `regs.intRegs` for it to see.
  for r of regs.reservedSavedGpr {
    savedGpr = append(savedGpr, r)
  }
  let savedXmm = xBuildSavedXmm(
    regs.cc, f.isNaked, built.intervals, result.locations, regs.floatRegs,
  )

  return XAllocPhase{
    built = built, result = result, skipConst = skipConst,
    savedGpr = savedGpr, savedXmm = savedXmm,
  }
}

// Runs interval building and register allocation (xBuildAllocPhase), then
// lays out the frame. See XFrameSetup's doc comment for nakedSpillOverflow.
fn xBuildFrameSetup(f: IrFunc, debug: bool, regs: XFrameRegs): XFrameSetup {
  let alloc = xBuildAllocPhase(f, regs)
  let built = alloc.built
  let result = alloc.result
  let savedXmm = alloc.savedXmm
  let savedGpr = alloc.savedGpr

  // #3169/#4203: a function that polls a loop back edge gets ONE EXTRA spill
  // slot on top of the ones the allocator asked for, caching the address of the
  // runtime's attention word for the back-edge poll guard (xPollCacheOffset /
  // xEmitPollGuard). It was two, then three (#3746's preempt summary), then
  // four (#4200's countdown) while the guard re-derived the whole poll
  // predicate inline; #4203 replaced that with one word the runtime publishes.
  // Sized here because the frame is laid out before emission, and off the same
  // predicate xScanFuncFlags uses for hasSafepoints. #4464 dropped this line's
  // claim that such a function is "allocated out of the callee-saved-only file":
  // none exists now, and the slot needs none — xEmitPrologue runs for every
  // non-@naked function. No allocator index reaches here, so no stack map does.
  let pollCacheSlots = 0
  if (hasBackEdgeSafepoint(f)) {
    pollCacheSlots = 1
  }
  assert(pollCacheSlots == 0 || regs.flags.hasSafepoints)

  // The XMMs live inside the carved frame alongside the spill slots; the GPRs are
  // pushed, so they are NOT part of frameSize — only its alignment (an odd number
  // of pushes leaves rsp 8 off).
  let numSlots = result.numSpillSlots + pollCacheSlots
  let rawFrame = 8 * numSlots + xXmmSaveBytes() * len(savedXmm)
  // #3906: the rounding exists so rsp is 16-aligned AT A CALL, so a function
  // that emits none pays nothing for it. `flags` alone is NOT that predicate —
  // see xNeedsCallAlign (x64frame.bit), which takes it and finishes the job.
  // #7241: frameless (x64tailcall.bit) when nothing needs the frame. Such a
  // function makes no call, so it owes no alignment and takes no #5667 pad,
  // and `noCallAlign` turns any call it did emit into a compiler abort.
  let tails = xTailCallPlan(regs.module, f, regs.cc)
  let frameless = rawFrame == 0 &&
    len(savedGpr) == 0 &&
    xFramelessCandidate(regs, f, built.safepoints, tails, debug)
  let needsCallAlign = !frameless && xNeedsCallAlign(f, regs.flags, debug)
  // #5667: an 8-byte ALIGNMENT pad is cheaper as one more callee-saved push
  // than as a `subq`/`addq` pair, so xPadSavedGpr (x64frame.bit) may append a
  // free callee-saved register here. It must run before the XFrame literal
  // below and before the savedRegs loop at the end of this function, which is
  // what keeps the prologue, the epilogue, the Win64 unwind codes, the GC
  // recovery table and every rbp-relative slot offset reading one list.
  // `xPadCandidates` is what refuses a @naked function: it hands the pad an
  // EMPTY file, so the refusal costs no branch here and reads as one expression.
  savedGpr = xPadSavedGpr(
    regs.cc, xPadCandidates(regs.intRegs, f.isNaked), savedGpr, rawFrame, needsCallAlign,
  )
  let frame = XFrame{
    savedGpr = savedGpr, savedXmm = savedXmm, numSpillSlots = numSlots,
    pollCacheSlots = pollCacheSlots,
    frameSize = xAlignFrame(rawFrame, len(savedGpr), needsCallAlign),
    frameless = frameless, tailCalls = tailCallsKept(tails, frameless),
  }

  // §10.3.1 @naked safety net: a spill slot is the only *per-function* frame need
  // a naked function can develop. savedGpr is now what this function's allocation
  // actually assigned (#3860 — it used to be a constant of the target, all four
  // SysV callee-saved GPRs), but for a NAKED function the two agree at empty:
  // the volatile-only file above contains no callee-saved register for the
  // allocator to hand out, so nothing can reach either list. Naked functions
  // allocate out of that file, so a spill here means the body outgrew what a
  // prologue-less function can hold.
  return XFrameSetup{
    built = built, result = result, skipConst = alloc.skipConst,
    needsCallAlign = needsCallAlign, frame = frame,
    nakedSpillOverflow = f.isNaked && result.numSpillSlots != 0,
  }
}

// One shared empty-name FuncCode literal for both refusal points below: a
// multi-value-ret construct this backend refuses, and an emission pass that
// came back !ok. Either way the caller must not emit a binary.
fn xEmptyFuncCode(): FuncCode {
  return FuncCode{
    name = "", code = []u8(0), relocs = []Reloc(0),
    safepoints = []SafepointView(0), savedRegs = []SavedReg(0), frameSize = 0,
    lines = []DebugLineRow(0),
  }
}

// Allocates a fresh XCtx and fills it from the register/setup phases, ready
// for emission.
fn xNewFuncCtx(f: IrFunc, debug: bool, regs: XFrameRegs, setup: XFrameSetup): XCtx {
  let cx = newXCtx(regs.cc)
  cx.module = regs.module
  cx.ctx = regs.ctx
  cx.f = f
  cx.debug = debug
  cx.skipConst = setup.skipConst
  // #5655. Not hoisted next to `skipConst` above: `xUsedIntRegs` deliberately
  // does NOT read it. A skipped `add` leaves its allocated register written by
  // nothing, so dropping it from the used set would be legal, but over-reporting
  // a used register only costs a push that was already there before this fold
  // existed, while under-reporting one loses a callee-saved value.
  cx.skipAddr = xComputeSkipAddrFold(regs.ctx, f, debug)
  cx.alloc = setup.result
  cx.intRegs = regs.intRegs
  cx.floatRegs = regs.floatRegs
  cx.frame = setup.frame
  cx.noCallAlign = !setup.needsCallAlign // arms xCallReloc/xCallReg's backstop assert
  // #5878: jumps kept inside 32-byte chunks (x64align.bit).
  cx.buf.align = true
  cx.blockOffsets = []int(len(f.blocks))
  cx.safepointCodeOffsets = []int(len(setup.built.safepoints))
  return cx
}

// Emits the prologue, every block in f.blocks order — which back-edge
// detection assumes is the original builder/RPO order (see isBackEdge) — and
// finally patches the jump targets. Returns false when the function contains
// a construct this backend refuses (a multi-value ret): the caller must not
// emit a binary then.
fn xEmitFuncBody(cx: XCtx, f: IrFunc): bool {
  // §10.3.1 @naked: no prologue — the function runs on its caller's frame.
  // #7241: nor does a frameless one, which has nothing for a prologue to do.
  assert(!cx.frame.frameless || len(cx.frame.zeroOffs) == 0)
  if (!f.isNaked && !cx.frame.frameless) {
    xEmitPrologue(cx)
  }
  cx.zTrack = true
  xBindIncomingArgs(cx)
  cx.zTrack = false
  // #3169: after the incoming args are off the ABI registers and onto the homes
  // the allocator gave them — otherwise this call's caller-saved clobber would
  // destroy an argument still in rdi..r9. #4464: those homes need not be
  // callee-saved; xClobberPoints prepends an entry clobber point for this call.
  xEmitPollCachePrefetch(cx)

  cx.jumpInPlace = xJumpsInPlace(cx)
  cx.bypassed = bypassedForwarders(f, cx.alloc.clears, cx.jumpInPlace)
  let ok = true
  let heads = xLoopHeaders(f)
  let bi = 0
  while (bi < len(f.blocks)) {
    cx.curBlock = bi
    xAlignBlockStart(cx.buf, heads[bi]) // #5878
    if (bi > 0 || heads[bi]) {
      cx.argFwd = []PMove(0) // #7057: a branch may reach this offset
    }
    cx.blockOffsets[bi] = len(cx.buf.code)
    let b = f.blocks[bi]
    let i = b.instsStart + b.paramCount
    let end = xEmitEnd(cx, bi)
    while (i < end) {
      // #3283: record this instruction's source position before it emits
      // any code, so the row's pcOffset names where it actually starts.
      cx.dbgRows = appendDebugLineIfChanged(
        cx.dbgRows,
        debugPosOf(cx.module.sm, f.instrs[i].span), len(cx.buf.code),
      )
      if (!xEmitInstTracked(cx, bi, i)) {
        ok = false
      }
      i = i + 1
    }
    bi = bi + 1
  }
  xEmitClearStubs(cx)
  xPatchJumpFixups(cx)
  return ok
}

// #6410: framezero.bit's plan for this function — which words the prologue
// zeroes, and the slots the guard holds emission to having stored first.
// `noDef` is every definition this backend may emit nothing for: #5655's
// folded address adds and #4393's fused compares (an fcmp is never fused, so
// marking one too only zeroes a slot that did not need it).
fn xPlanFrameZeroes(cx: XCtx, setup: XFrameSetup) {
  let f = cx.f
  let fuse = xFuseCmp(cx)
  let noDef = []bool(len(f.instrs))
  let i = 0
  while (i < len(f.instrs)) {
    noDef[i] = cx.skipAddr[i] || fuse[i]
    i = i + 1
  }
  let q = ZeroQuery{
    ctx = cx.ctx, f = f, locs = setup.result.locations, roots = setup.built.roots,
    numSlots = setup.result.numSpillSlots, skipConst = cx.skipConst, noDef = noDef,
  }
  let scanAt = frameScanStart(f)
  let wrote = entryWrittenSlots(q, scanAt)
  if (!f.isNaked) {
    xPlaceSlots(cx.frame, wrote)
    cx.frame.zeroOffs = xFrameZeroOffs(cx.frame, wrote, scanAt)
  }
  cx.zScanAt = scanAt
  cx.zClaims = claimedSlotOffs(wrote, cx.frame.slotPos, xSlotOffset(cx.frame, 0), -8)
}

// #6410: `xEmitInst` with framezero.bit's window tracked around it, and the
// guard's other half: no safepoint is recorded inside the window.
fn xEmitInstTracked(cx: XCtx, bi: int, i: int): bool {
  closeZeroWindow(cx.zClaims, cx.zWrote, bi, i, cx.zScanAt)
  cx.zTrack = bi == 0 && i < cx.zScanAt
  cx.curInst = i
  let n = cx.nextSafepointIdx
  let ok = xEmitInst(cx, i)
  assert(!cx.zTrack || cx.nextSafepointIdx == n, "#6410: a safepoint inside the entry window")
  cx.zTrack = false
  return ok
}

// Builds the safepoint stack-map table and the register-recovery table from a
// finished, successful emission, and assembles the final FuncCode.
fn xBuildFuncCode(cx: XCtx, f: IrFunc): FuncCode {
  // Every safepoint the interval builder predicted must have been reached during
  // emission, or the stack maps below pair with the wrong return addresses.
  assert(cx.nextSafepointIdx == len(cx.safepointCodeOffsets))

  // Pair each allocator stack map with the code offset emission recorded for it —
  // the two lists are in the same order by construction.
  let safepoints = []SafepointView(0)
  let phys = []int(0)
  for r of cx.intRegs {
    phys = append(phys, xRegNum(r))
  }
  let si = 0
  while (si < len(cx.alloc.stackMaps)) {
    let sm = cx.alloc.stackMaps[si]
    si = si + 1
    if (xIsTailCall(cx.frame, sm.pos)) {
      continue // #7241: a `jmp` leaves no return address to look up
    }
    let regs = []int(0)
    for r of sm.regs {
      regs = append(regs, xRegNum(cx.intRegs[r]))
    }
    // Only the ALLOCATOR's own slot indices, which is what keeps #3169's
    // poll-cache slots out of the table: they sit above every index that can
    // appear here, so the collector never tries to trace the World or GC
    // module-state address as a managed object.
    let slots = []int(0)
    for s of sm.slots {
      assert(s < cx.frame.numSpillSlots - cx.frame.pollCacheSlots)
      slots = append(slots, xSpillOffset(cx.frame, s))
    }
    safepoints = append(
      safepoints,
      SafepointView{
        retOffset = cx.safepointCodeOffsets[si - 1],
        slots = slots, regs = regs,
        isPoll = sm.isPoll, liveRegs = physRegMask(sm.live, phys),
      },
    )
  }

  // Register-recovery slots: the prologue does `push rbp; mov rbp,rsp; push
  // savedGpr[i]...`, so the caller's savedGpr[i] lands at rbp - 8*(i+1) —
  // frame-pointer-relative, matching SafepointView's own offsets.
  let savedRegs = []SavedReg(0)
  let gi = 0
  while (gi < len(cx.frame.savedGpr)) {
    savedRegs = append(
      savedRegs,
      SavedReg{ reg = xRegNum(cx.frame.savedGpr[gi]), fpOff = -8 * (gi + 1) },
    )
    gi = gi + 1
  }

  return FuncCode{
    name = f.name, code = cx.buf.code, relocs = cx.relocs,
    safepoints = safepoints, savedRegs = savedRegs, frameSize = cx.frame.frameSize,
    lines = cx.dbgRows,
  }
}

// Compiles one function to x86-64 machine code for `cc`. Runs register
// allocation itself (intervals and safepoints come from the shared
// buildIntervals), lays out the frame, then emits the prologue, every block in
// f.blocks order, and finally patches the jump targets.
//
// Returns a FuncCode with an empty name when the function contains a construct
// this backend refuses (a multi-value ret): the caller must not emit a binary.
fn xCompileFunction(module: IrModule, irf: IrFunc, cc: XCallConv, debug: bool): FuncCode {
  // #7183: before anything reads positions, so every phase sees one numbering.
  let f = xPullMulPartners(module.ctx, irf, debug)
  let regs = xBuildFrameRegs(module, f, cc, debug)
  let setup = xBuildFrameSetup(f, debug, regs)
  if (setup.nakedSpillOverflow) {
    return xEmptyFuncCode()
  }
  let cx = xNewFuncCtx(f, debug, regs, setup)
  xPlanFrameZeroes(cx, setup)
  let ok = xEmitFuncBody(cx, f)
  if (!ok) {
    return xEmptyFuncCode()
  }
  return xBuildFuncCode(cx, f)
}
