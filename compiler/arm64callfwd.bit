// #7731: a call argument stored to its spill slot by the instruction just
// emitted is marshalled from the stored register (#7705's record, spillFwd),
// not reloaded. Sibling .bit file, same module: see arm64call.bit's
// marshalArgs, the one caller.

// A spilled call-argument source `src` as the register the last spill store
// wrote it from, when that register still holds it once the parallel move
// reads its sources. `staged` is stagesStackArg's answer for this call.
fn spillFwdSrc(cx: A64Ctx, src: PLoc, staged: bool): PLoc {
  if (src.isReg || src.isImm) {
    return src
  }
  let r = spillStRegAt(cx, src.v, src.regClass)
  if (r < 0 || argFwdClobbers(r, src.regClass, staged)) {
    return src
  }
  return plocReg(r, src.regClass)
}

// Whether marshalArgs may write register `r` of `regClass` after choosing
// its sources and before the parallel move reads them, or the move assumes
// no move reads it: an overflow argument stages through scratch1/fscratch1
// (emitOutgoingStackArg) when `staged`, a far frame displacement goes
// through scratch3 (loadImm), and cycles rotate through scratch2/fscratch2
// (resolveMoveCycles). Every destination is an argument register, so no
// move stages a memory-to-memory copy through scratch1.
fn argFwdClobbers(r: int, regClass: RegClass, staged: bool): bool {
  if (regClass == RegClass.Float) {
    return r == fscratch2() || (staged && r == fscratch1())
  }
  return r == scratch2() || r == scratch3() || (staged && r == scratch1())
}

// Whether marshalling `args` with the banks `baseIntOrd`/`baseFloatOrd` deep
// overflows either bank to the outgoing stack-argument area.
fn stagesStackArg(cx: A64Ctx, args: []int, baseIntOrd: int, baseFloatOrd: int): bool {
  let ints = baseIntOrd
  let floats = baseFloatOrd
  for v of args {
    if (regClassOf(cx.module.ctx, cx.f.instrs[v].ty) == RegClass.Int) {
      ints = ints + 1
    } else {
      floats = floats + 1
    }
  }
  return ints > maxArgRegs() || floats > maxArgRegs()
}
