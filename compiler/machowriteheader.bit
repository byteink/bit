fn machoWriteHeader(
  target: MachoTarget,
  out: ByteBuf,
  hdrs: []MachoSecHdr,
  vm: (int, int, int, int, int, int),
  sy: (int, int, int, int),
) {
  let (vmsize, segFileoff, filesize, sizeofcmds, segCmdSize, cmdsEnd) = vm
  let (symoff, stroff, strsize, nsyms) = sy
  let nsects = len(hdrs)
  // Patch the header and load commands now that every offset is known.
  let hdr = newByteBuf()
  appendU32(hdr, mhMagic64())
  appendU32(hdr, machoCpuType(target))
  appendU32(hdr, machoCpuSubtype(target))
  appendU32(hdr, mhObject())
  appendU32(hdr, 2) // ncmds: LC_SEGMENT_64 + LC_SYMTAB
  appendU32(hdr, sizeofcmds)
  appendU32(hdr, 0) // flags
  appendU32(hdr, 0) // reserved

  appendU32(hdr, lcSegment64())
  appendU32(hdr, segCmdSize)
  appendName16(hdr, "") // MH_OBJECT convention: the one segment is nameless
  appendU64(hdr, 0)     // vmaddr
  appendU64(hdr, vmsize)
  appendU64(hdr, segFileoff)
  appendU64(hdr, filesize)
  appendU32(hdr, vmProtAll()) // maxprot
  appendU32(hdr, vmProtAll()) // initprot
  appendU32(hdr, nsects)
  appendU32(hdr, 0) // flags

  let i = 0
  while (i < nsects) {
    let h = hdrs[i]
    appendName16(hdr, machoSectionName(h.kind))
    appendName16(hdr, machoSegmentName(h.kind))
    appendU64(hdr, h.addr)
    appendU64(hdr, h.size)
    appendU32(hdr, h.offset)
    appendU32(hdr, h.align)
    appendU32(hdr, h.reloff)
    appendU32(hdr, h.nreloc)
    appendU32(hdr, machoSectionFlags(h.kind))
    appendU32(hdr, 0) // reserved1
    appendU32(hdr, 0) // reserved2
    appendU32(hdr, 0) // reserved3
    i = i + 1
  }

  appendU32(hdr, lcSymtab())
  appendU32(hdr, sizeofSymtabCommand())
  appendU32(hdr, symoff)
  appendU32(hdr, nsyms)
  appendU32(hdr, stroff)
  appendU32(hdr, strsize)

  // The reserved prefix must be exactly what the commands filled — a mismatch
  // means a class size above is wrong and every recorded offset is a lie.
  assert(len(hdr.bytes) == cmdsEnd)
  i = 0
  while (i < cmdsEnd) {
    out.bytes[i] = hdr.bytes[i]
    i = i + 1
  }
}
