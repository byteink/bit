// compiler/enumvariants.bit — `__variantName()`, `static __variants()` and
// `static __variantAt(i)` on every payload-free enum (SPEC §14.7, #6987, #7092,
// epic #6984).
//
//     enum Action { Manage, Read, Publish }
//     Action.Publish.__variantName()   // "Publish"
//     Action.__variants()              // ["Manage", "Read", "Publish"]
//     Action.__variantAt(2)            // Action.Publish
//
// Bit has no reflection, so a package that stores an enum by NAME (pkg/authz
// writes "Publish", not a tag) could not turn a value into its name, or list
// the names, from the type alone, or build a value back from a name inside a
// generic bound (`T(i)` is E0184 there); every caller wrote a `match` by hand.
// These three members are synthesized for every enum whose variants ALL carry no
// payload, the same way `@table` synthesizes `__tableName`/`__columns`
// (classtablerow.bit): the double-underscore names are reserved, so user code
// never collides with them, and a package can bind them through an interface.
//
// An enum with any payload variant, a generic enum and an enum with no
// variant get none of them: a call is the ordinary "no such method" error.
// `__variantName` is a flat `if (this == E.V) { return "V" }` chain ending in
// the last variant unconditionally (a value of a payload-free enum is always
// one of its declared variants, SPEC §14.7): no allocation per call and no
// nesting however wide the enum is. Every variant NAME node is cloned by span
// from its own declaration, so only the quoted copy `"V"` needs a word in the
// module's synthesized text (synthtext.bit).
//
// `__variantAt(i)` is the same flat shape the other way round: `if (i == k) {
// return E.Vk }` per variant in declaration order, then `panic("E.__variantAt:
// index ${i} out of range (N variants)")` for an index outside 0..N-1, so an
// out-of-range index is a loud failure naming the enum and the index, never a
// wrong variant. The index literals `0..N-1` and the message parts are words in
// the module's synthesized text like every other spelled name.

// E0189 (§14.7): a payload-free enum already declares `__variantName`,
// `__variants` or `__variantAt`, the three names the compiler synthesizes for it.
const ecEnumVariantMemberDeclared = 189

const synthVariantNameName = "__variantName"
const synthVariantsName = "__variants"
const synthVariantAtName = "__variantAt"

// True iff `name` is one of the three members synthesized here.
fn isEnumVariantsMemberName(name: string): bool {
  return name == synthVariantNameName || name == synthVariantsName || name == synthVariantAtName
}

// True iff FuncDecl `m` is one of the three members synthesized here: a method
// of an enum named `__variantName`, `__variants` or `__variantAt` (E0189
// refuses a user's).
// They are injected on EVERY payload-free enum, called or not, so lowering
// defers them (`isDeferredSynthStaticDecl`, lowermethodtable.bit) and emits
// only the ones a call reaches, the same on-demand rule `@table`'s members
// follow: a program that never asks an enum for its names gets no new IR.
fn isEnumVariantsDecl(c: Checker, m: int): bool {
  let k = kidsOf(c.tree, m)
  if (k[0] == 0) {
    return false
  }
  let nm = getNode(c.tree, k[1])
  let name = c.source[nm.span.start:nm.span.end]
  if (!isEnumVariantsMemberName(name)) {
    return false
  }
  let ut = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, k[0])[1]))
  return ut != 0 && c.ctx.types[ut].kind == TypeKind.Enum
}

// One payload-free enum ready for synthesis: its name node, whether it is
// exported, and its variant name nodes in declaration order.
class EnumVariantsClass {
  className: int,
  exported: bool,
  names: []int,
}

// The user's own member named `__variantName`, `__variants` or `__variantAt`
// in the enum body `variantList`, or `(0, "")`.
fn declaredEnumVariantMember(tree: Tree, source: string, variantList: int): (int, string) {
  for name of [synthVariantNameName, synthVariantsName, synthVariantAtName] {
    let m = declaredMember(tree, source, variantList, name)
    if (m != 0) {
      return (m, name)
    }
  }
  return (0, "")
}

fn reportEnumVariantMemberDeclared(
  diags: Diagnostics, tree: Tree, ename: string, node: int, name: string,
) {
  report(
    diags, ecEnumVariantMemberDeclared, getNode(tree, node).span,
    "enum '${ename}' declares '${name}', which the compiler synthesizes for every payload-free enum ('__variantName', '__variants' and '__variantAt')",
    "rename this member — a hand-written '${name}' that silently won would make the synthesized one invisible to a generic bound on it",
  )
}

// The names a synthesized enum member needs spelled in the module source:
// the three member names, `this`, `string`, `int`, `i`, `panic`, the quoted
// copy of each variant's name, the index literals `0..N-1`, the enum's own
// name (`__variantAt`'s result type: an `Ident` at the class's real span would
// show up in `// types` dumps as a typed name in the user's source) and the
// two parts of the out-of-range message. Variant identifiers are cloned, never
// spelled.
fn enumVariantsSynthWords(tree: Tree, source: string, classes: []EnumVariantsClass): []string {
  if (len(classes) == 0) {
    return []string(0)
  }
  let out = [
    synthVariantNameName, synthVariantsName, synthVariantAtName, synthReceiverName, "string",
    "int", variantAtParam, "panic",
  ]
  for c of classes {
    for n of c.names {
      out = append(out, "\"" + identText(tree, source, n) + "\"")
    }
    out = append(out, identText(tree, source, c.className))
    out = append(out, variantAtMsgHead(identText(tree, source, c.className)))
    out = append(out, variantAtMsgTail(len(c.names)))
    let k = 0
    while (k < len(c.names)) {
      out = append(out, "${k}")
      k = k + 1
    }
  }
  return out
}

// The top-level `EnumDecl` behind `d0` (looking through `export`), or 0, and
// whether it was exported.
fn topEnumDecl(tree: Tree, d0: int): (int, bool) {
  let exported = d0 != 0 && getNode(tree, d0).tag == Tag.Export
  let d = d0
  if (exported) {
    d = kidsOf(tree, d0)[0]
  }
  if (d == 0 || getNode(tree, d).tag != Tag.EnumDecl) {
    return (0, false)
  }
  return (d, exported)
}

// The variant name nodes of an enum body, in declaration order; an in-body
// method shares the list and is skipped.
fn enumBodyVariantNames(tree: Tree, variantList: int): []int {
  let names = []int(0)
  for item of kidsOf(tree, variantList) {
    if (getNode(tree, item).tag == Tag.EnumVariant) {
      names = append(names, kidsOf(tree, item)[0])
    }
  }
  return names
}

// Every payload-free, non-generic enum with at least one variant, in
// declaration order. An enum that already declares one of the two names is
// reported (E0189) and skipped, so the user's member is the only one in the
// program and the error names it.
fn collectEnumVariantsClasses(tree: Tree, source: string, diags: Diagnostics): []EnumVariantsClass {
  let out = []EnumVariantsClass(0)
  for d0 of kidsOf(tree, tree.root) {
    let (d, exported) = topEnumDecl(tree, d0)
    if (d == 0 || !enumIsPayloadFree(tree, d) || kidsOf(tree, d)[1] != 0) {
      continue
    }
    let k = kidsOf(tree, d)
    let (own, ownName) = declaredEnumVariantMember(tree, source, k[2])
    if (own != 0) {
      reportEnumVariantMemberDeclared(diags, tree, identText(tree, source, k[0]), own, ownName)
      continue
    }
    let names = enumBodyVariantNames(tree, k[2])
    if (len(names) != 0) {
      out = append(out, EnumVariantsClass{ className = k[0], exported = exported, names = names })
    }
  }
  return out
}

fn evQuoted(tree: Tree, source: string, st: SynthText, nameNode: int): int {
  let word = "\"" + identText(tree, source, nameNode) + "\""
  return addLeaf(tree, Tag.StringLit, synthSpan(st, word))
}

// The name, receiver flavour and result type of one synthesized method.
class EvMethodSpec {
  name: string,
  recvExtra: int,
  result: int,
  params: []int,
}

// `[export] [static] <name>(): <result> { <stmts> }` on the enum, the shape
// `synthJobNameMethod` (classjobdesc.bit) builds; `main = 1` on the Receiver
// is the only difference a static one takes.
fn evMethod(
  tree: Tree, st: SynthText, c: EnumVariantsClass, spec: EvMethodSpec, stmts: []int,
): int {
  let sp = getNode(tree, c.className).span
  let recv = addNode(
    tree, Tag.Receiver, sp, spec.recvExtra, [0, traitClassTypeRef(tree, c.className, 0)],
  )
  let decl = addNode(
    tree, Tag.FuncDecl, sp, 0,
    [
      recv, synthIdent(tree, st, spec.name), 0, addNode(tree, Tag.Params, sp, 0, spec.params),
      spec.result, addNode(tree, Tag.Block, sp, 0, stmts),
    ],
  )
  if (!c.exported) {
    return decl
  }
  return addNode(tree, Tag.Export, sp, 0, [decl])
}

// `E.V`: the class's own name node cloned by span, then the variant's.
fn evVariantRef(tree: Tree, c: EnumVariantsClass, nameNode: int): int {
  let sp = getNode(tree, c.className).span
  return addNode(
    tree, Tag.Member, sp, 0,
    [
      addLeaf(tree, Tag.Ident, sp),
      addLeaf(tree, Tag.Ident, getNode(tree, nameNode).span),
    ],
  )
}

// `if (this == E.V) { return "V" }` for variant `nameNode`.
fn evVariantArm(
  tree: Tree,
  source: string,
  st: SynthText,
  c: EnumVariantsClass,
  nameNode: int,
): int {
  let sp = getNode(tree, c.className).span
  let member = evVariantRef(tree, c, nameNode)
  let cond = addNode(
    tree, Tag.Binary, sp, int(Kind.EqEq), [synthIdent(tree, st, synthReceiverName), member],
  )
  let ret = addNode(tree, Tag.ReturnStmt, sp, 0, [evQuoted(tree, source, st, nameNode)])
  return addNode(tree, Tag.IfStmt, sp, 0, [cond, addNode(tree, Tag.Block, sp, 0, [ret]), 0])
}

fn synthVariantName(tree: Tree, source: string, st: SynthText, c: EnumVariantsClass): int {
  let sp = getNode(tree, c.className).span
  let stmts = []int(0)
  let last = len(c.names) - 1
  let i = 0
  while (i < last) {
    stmts = append(stmts, evVariantArm(tree, source, st, c, c.names[i]))
    i = i + 1
  }
  stmts = append(
    stmts, addNode(tree, Tag.ReturnStmt, sp, 0, [evQuoted(tree, source, st, c.names[last])]),
  )
  let spec = EvMethodSpec{
    name = synthVariantNameName, recvExtra = 0, result = synthIdent(tree, st, "string"),
    params = []int(0),
  }
  return evMethod(tree, st, c, spec, stmts)
}

fn synthVariants(tree: Tree, source: string, st: SynthText, c: EnumVariantsClass): int {
  let sp = getNode(tree, c.className).span
  let items = []int(0)
  for n of c.names {
    items = append(items, evQuoted(tree, source, st, n))
  }
  let ret = addNode(tree, Tag.ReturnStmt, sp, 0, [addNode(tree, Tag.SliceLit, sp, 0, items)])
  let result = addNode(tree, Tag.SliceType, sp, 0, [synthIdent(tree, st, "string")])
  return evMethod(
    tree,
    st,
    c,
    EvMethodSpec{
      name = synthVariantsName, recvExtra = 1, result = result, params = []int(0),
    },
    [ret],
  )
}

// The parameter name of `__variantAt`.
const variantAtParam = "i"

// The two literal parts around the index in the out-of-range panic message.
fn variantAtMsgHead(enumName: string): string {
  return "${enumName}.__variantAt: index "
}

fn variantAtMsgTail(n: int): string {
  return " out of range (${n} variants)"
}

// `if (i == k) { return E.Vk }` for variant `nameNode` at index `k`.
fn evAtArm(
  tree: Tree, st: SynthText, c: EnumVariantsClass, nameNode: int, k: int,
): int {
  let sp = getNode(tree, c.className).span
  let cond = addNode(
    tree, Tag.Binary, sp, int(Kind.EqEq),
    [synthIdent(tree, st, variantAtParam), addLeaf(tree, Tag.IntLit, synthSpan(st, "${k}"))],
  )
  let ret = addNode(tree, Tag.ReturnStmt, sp, 0, [evVariantRef(tree, c, nameNode)])
  return addNode(tree, Tag.IfStmt, sp, 0, [cond, addNode(tree, Tag.Block, sp, 0, [ret]), 0])
}

// `panic("E.__variantAt: index ${i} out of range (N variants)")`.
fn evAtPanic(tree: Tree, source: string, st: SynthText, c: EnumVariantsClass): int {
  let sp = getNode(tree, c.className).span
  let head = variantAtMsgHead(identText(tree, source, c.className))
  let msg = addNode(
    tree, Tag.StrInterp, sp, 0,
    [
      addLeaf(tree, Tag.StrPart, synthSpan(st, head)),
      synthIdent(tree, st, variantAtParam),
      addLeaf(tree, Tag.StrPart, synthSpan(st, variantAtMsgTail(len(c.names)))),
    ],
  )
  let call = addNode(
    tree, Tag.Call, sp, 0,
    [synthIdent(tree, st, "panic"), 0, addNode(tree, Tag.Args, sp, 0, [msg])],
  )
  return addNode(tree, Tag.ExprStmt, sp, 0, [call])
}

fn synthVariantAt(tree: Tree, source: string, st: SynthText, c: EnumVariantsClass): int {
  let sp = getNode(tree, c.className).span
  let stmts = []int(0)
  let k = 0
  while (k < len(c.names)) {
    stmts = append(stmts, evAtArm(tree, st, c, c.names[k], k))
    k = k + 1
  }
  stmts = append(stmts, evAtPanic(tree, source, st, c))
  let param = addNode(
    tree, Tag.Param, sp, 0, [synthIdent(tree, st, variantAtParam), synthIdent(tree, st, "int")],
  )
  let spec = EvMethodSpec{
    name = synthVariantAtName, recvExtra = 1,
    result = synthIdent(tree, st, identText(tree, source, c.className)), params = [param],
  }
  return evMethod(tree, st, c, spec, stmts)
}

// Every collected enum's three synthesized members, for the caller to attach
// alongside every other feature's in the same pass.
fn injectEnumVariantsDecls(
  tree: Tree, source: string, st: SynthText, classes: []EnumVariantsClass,
): []int {
  let out = []int(0)
  for c of classes {
    out = append(out, synthVariantName(tree, source, st, c))
    out = append(out, synthVariants(tree, source, st, c))
    out = append(out, synthVariantAt(tree, source, st, c))
  }
  return out
}
