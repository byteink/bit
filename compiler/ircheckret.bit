// compiler/ircheckret.bit — #4405's selfcheck arms: a result returned in more
// than one ABI register.
//
// A sibling of `ircheck.bit` rather than more of it: that file was at 703 lines
// and these arms take it past the 800-line ceiling. Nothing was moved, so this
// is a pure addition — `ircheck.bit` is byte-identical above its last line.

// #4405: the FRONT END that produces a return wider than one word, pinned at
// both ends of the optimizer.
//
// The backend convention (`retRegsFor`, `bindCallResults`, `emitMultiWordRet`)
// has been in the tree since #4239 with nothing reaching it; what this pins is
// the lowering that reaches it — the callee's `ret` carrying W values, the call
// site's `Op.Call` + `Op.CallWord` run, and the box on either side that the
// optimizer is expected to remove.
//
// BOTH dumps are needed and neither is sufficient. The pre-opt form proves the
// words are produced and read in the right ORDER with the right TYPES, which a
// fully-optimized dump cannot show once the box is gone. The post-opt form
// proves the box really does go, which the pre-opt form cannot show at all —
// and a boxed result that never gets removed is this ticket's entire cost with
// none of its benefit.
//
// The shape is {i64, f64} on purpose: mixed classes come back in {x0, d0}, not
// {x0, x1}, so a word index that has drifted shows up as a TYPE in the dump
// rather than only as a wrong number at run time.
fn multiWordRetSource(): string {
  return "fn split(n: int): (int, f64) {\n" +
    "  let a = 0\n" +
    "  while (a < n) {\n" +
    "    a = a + 1\n" +
    "  }\n" +
    "  return a, 0.5\n" +
    "}\n" +
    "fn use(n: int): f64 {\n" +
    "  let (q, f) = split(n)\n" +
    "  return f64(q) + f\n" +
    "}\n"
}

fn checkMultiWordRet() {
  let pre = lowerSourceDump(multiWordRetSource())
  assert(
    indexOf(
      pre,
      "  %16 = field_get %13[0] i64\n  %17 = field_get %13[8] f64\n  ret %16, %17\n",
    ) >= 0,
    "the callee must `ret` its result WORD BY WORD, in order: ${pre}",
  )
  assert(
    indexOf(pre, "  %1 = call @split(%0) i64\n  %2 = call_word %1[1] f64\n") >= 0,
    "the call site must take word 1 out of its own instruction slot: ${pre}",
  )
  // The numbers moved twice for reasons that are not this check's subject and
  // are recorded so the next reader does not re-derive them. #4204 added five
  // strip-selection blocks ahead of the `ret`, #4457 shifted them by one, and
  // #4463 took them all back out: `split`'s bound is its own function
  // PARAMETER, so no trip count can be proved for it and the loop keeps its
  // per-lap poll (optstriptrip.bit). The property asserted is unchanged
  // throughout — the boxed {i64, f64} the callee used to build is gone and the
  // two words are returned directly.
  let post = lowerSourceDumpOpt(multiWordRetSource())
  assert(
    indexOf(post, "  %12 = const_float f64 0.5\n  ret %11, %12\n") >= 0,
    "the callee's box must be gone after optimization: ${post}",
  )
  assert(
      indexOf(
        post,
          "func use(%0: i64) f64 {\nbb0(%0: i64):\n" +
          "  %1 = call @split(%0) i64\n" +
          "  %2 = call_word %1[1] f64\n" +
          "  %3 = convert f64 %1\n" +
          "  %4 = fadd f64 %3, %2\n" +
          "  ret %4\n}\n",
      ) >=
      0,
    "the call site must leave NO allocation behind: ${post}",
  )
  assert(indexOf(post, "gc_alloc") < 0, "no allocation may survive anywhere: ${post}")
}

// #4405: `callWordEscapesInFunc` (verify.bit) directly, on hand-built IR. An
// `Op.CallWord` must sit exactly `ival` slots after the `Op.Call` it names,
// because the backend finds a call's words by scanning forward from it and a
// word that has drifted is simply never bound.
//
// Three arms, because each of the other two can pass for the wrong reason on
// its own: a DISPLACED word must fire, a correctly-placed run must stay silent
// (or the check is just "always complain"), and an ordinary one-word call must
// stay silent (or every function in the tree becomes a violation).
fn checkCallWordValidator() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  assert(
    len(callWordEscapesInFunc(callWordProbe(ctx, i64t, 1, 1))) == 0,
    "a word one slot after its call is correctly placed",
  )
  assert(
    len(callWordEscapesInFunc(callWordProbe(ctx, i64t, 2, 1))) == 1,
    "a word claiming index 2 while sitting one slot after its call must fire",
  )
  assert(
    len(callWordEscapesInFunc(callWordProbe(ctx, i64t, 1, 2))) == 1,
    "a word displaced from its call by an intervening instruction must fire",
  )
}

// `bb0(%0) { call, [pad...], call_word(%1, ival), ret }` — `gap` slots between
// the call and its word, and `ival` the word index the word claims.
fn callWordProbe(ctx: TypeContext, i64t: int, ival: int, gap: int): IrFunc {
  let call = mkInstr(Op.Call, i64t)
  call.name = "callee"
  call.args = [0]
  let instrs = [mkInstr(Op.BlockParam, i64t), call]
  let k = 1
  while (k < gap) {
    instrs = append(instrs, mkInstr(Op.ConstInt, i64t))
    k = k + 1
  }
  let word = mkInstr(Op.CallWord, i64t)
  word.args = [1]
  word.ival = ival
  instrs = append(instrs, word)
  instrs = append(instrs, mkInstr(Op.Ret, ctx.voidId))
  return IrFunc{
    name: "probe", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: len(instrs) }],
    instrs: instrs, isFallible: false,
  }
}

// #4407: `stringViewBaseEscapesInFunc` (verify.bit) directly, on hand-built IR
// matching `emitInlineStringSlice`'s own fingerprint — a `gc_alloc` exactly
// `strViewHeaderSize()` bytes, `ptr_offsets = [strViewBaseOffset()]` — whose
// `base` field is set from a hand-picked operand.
//
// Three arms, because any one alone can pass for the wrong reason. A
// ref-typed source (today's only reachable case, `s` itself) must stay
// silent, or the check would always complain. A plain `i64` source — what a
// broken exploded-string lowering would feed it if it read out an untraced
// `ptr`/`len` word instead of the traced `base` (#4411) — must fire, or the
// check guards nothing. A same-shaped `gc_alloc` typed something other than
// `string` (an ordinary class) must ALSO stay silent even with a non-ref
// value in the same field, proving the fingerprint is narrow rather than a
// general field-set/operand mismatch sweep.
fn checkStringViewBaseValidator() {
  let ctx = newTypeContext()
  let strTy = primType(ctx, 11)
  let i64t = primType(ctx, 3)
  assert(
    len(stringViewProbeEscapes(ctx, strTy, strTy)) == 0,
    "a string view's base set from a ref-typed value must stay silent",
  )
  assert(
    len(stringViewProbeEscapes(ctx, strTy, i64t)) == 1,
    "a string view's base set from a plain i64 must fire",
  )
  assert(
    len(stringViewProbeEscapes(ctx, i64t, i64t)) == 0,
    "a gc_alloc not typed string is not this check's business, even with a non-ref field value",
  )
}

// `bb0(%0: valTy) { %1 = gc_alloc allocTy [24,[16]]; field_set %1[16] = %0; ret }`.
fn stringViewProbeEscapes(ctx: TypeContext, allocTy: int, valTy: int): []string {
  let param = mkInstr(Op.BlockParam, valTy)
  let ga = mkInstr(Op.GcAlloc, allocTy)
  ga.ival = strViewHeaderSize()
  ga.offsets = [strViewBaseOffset()]
  let fs = mkInstr(Op.FieldSet, ctx.voidId)
  fs.lhs = 1
  fs.ival = strViewBaseOffset()
  fs.rhs = 0
  fs.ival2 = valTy
  let instrs = [param, ga, fs, mkInstr(Op.Ret, ctx.voidId)]
  return stringViewBaseEscapesInFunc(
    IrFunc{
      name: "probe", paramTypes: [valTy], result: ctx.voidId,
      blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: len(instrs) }],
      instrs: instrs, isFallible: false,
    },
    ctx,
  )
}
