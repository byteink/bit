// `bit lint` self-checks split out of compiler/lintcheck.bit (#2471, was 1016
// lines against the 800-line limit). compiler/lintcheck.bit keeps the
// directive-reader tests and the max-file-lines/max-fn-lines/max-params/
// max-nesting rule checks; this file keeps every remaining rule check
// (max-complexity onward), rendering, ordering, CLI-arg parsing, and the
// `checkLint()` entry point that calls into both files.
//
// Named to sort after compiler/lintcheck.bit, whose tests this file's
// `checkLint()` calls directly, and before compiler/lintmodule.bit — module
// files concatenate in bytewise filename order (compiler/project.bit:7).
//
// Run by `selfcheck()` under `./make test` and the x86_64 gate, same as
// compiler/lintcheck.bit; a failed `assert` panics with exit 2.

// `n` flat (unnested) `if` statements in one function body: complexity is
// `1 + n`, with no other branch point in the way.
fn lintTestNIfsSrc(n: int): string {
  let src = "fn f() {\n"
  let i = 0
  while (i < n) {
    src = src + "  if (a) {}\n"
    i = i + 1
  }
  return src + "}\n"
}

// The effective limit for `max-complexity` under `cfg`.
fn lintTestComplexityLimit(cfg: LintConfig): int {
  return cfg.limits[lintRuleIndex(lintRules(), "max-complexity")]
}

// E0204 at the boundary (default limit 10, spec/LINT.md §4 + §8): `limit`
// passes, `limit + 1` fails. Also covers every counted construct at once —
// each `if`/`while`/`for`(all four forms)/`match` arm/`catch`(both forms)/
// `&&`/`||` contributes exactly one, `else` and the `match` statement itself
// contribute nothing — and the runner wiring (dispatch, disable, override).
fn checkLintMaxComplexity() {
  let rules = lintRules()
  let idx = lintRuleIndex(rules, "max-complexity")
  assert(idx >= 0)
  assert(rules[idx].code == ecLintMaxComplexity)
  assert(rules[idx].limit == 10)

  // 9 flat ifs: complexity 1 + 9 = 10, the default limit exactly. Passes.
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", lintTestNIfsSrc(9))
  lintMaxComplexity(parseSource(lintTestNIfsSrc(9)), f0, rules[idx].limit, d0)
  assert(len(d0.list) == 0)

  // 10 flat ifs: complexity 1 + 10 = 11. Fails, and the message carries the
  // score so the author knows the distance.
  let d1 = lintTestSink()
  let src1 = lintTestNIfsSrc(10)
  let f1 = addFile(d1.sm, "bad.bit", src1)
  lintMaxComplexity(parseSource(src1), f1, rules[idx].limit, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxComplexity)
  assert(d1.list[0].severity == 1) // a warning, must not bump errorCount
  assert(d1.list[0].message == "function complexity is 11, limit is 10")
  assert(d1.list[0].hint ==
    "split it, or raise the limit with `// bit:lint max-complexity=11 -- <reason>` " +
      "in the file's leading comment block")

  // Reported at the function's own declaration span, not the file start —
  // unlike max-file-lines, there can be more than one per file.
  assert(d1.list[0].span.start > 0)

  // Every counted construct, once each, plus one `export`-wrapped function
  // (the export wrapper itself must not block dispatch) with a plain `else`
  // that must NOT add to the score, and a `match` statement whose own node
  // must not add to the score (only its two arms do).
  let everything = "export fn everything() {\n" +
    "  if (a) {\n" +
    "  } else {\n" +
    "  }\n" +
    "  while (b) {}\n" +
    "  for v of xs {}\n" +
    "  for v in xs {}\n" +
    "  for (let i = 0; i < 1; i = i + 1) {}\n" +
    "  for {\n" +
    "    break\n" +
    "  }\n" +
    "  match (0) {\n" +
    "    A => {}\n" +
    "    B => {}\n" +
    "  }\n" +
    "  let c1 = d catch 0\n" +
    "  let c2 = e catch err {\n" +
    "  }\n" +
    "  let f = g && h\n" +
    "  let k = m || n\n" +
    "}\n"
  // if(1) + while(1) + for_of(1) + for_in(1) + for_c(1) + for_inf(1) +
  // match_arm(2) + catch_bind(1) + catch_default(1) + &&(1) + ||(1) = 12,
  // plus the base of 1 = 13.
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "everything.bit", everything)
  lintMaxComplexity(parseSource(everything), f2, 13, d2)
  assert(len(d2.list) == 0)
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "everything.bit", everything)
  lintMaxComplexity(parseSource(everything), f3, 12, d3)
  assert(len(d3.list) == 1)
  assert(d3.list[0].message == "function complexity is 13, limit is 12")

  // A disable really suppresses it, through the runner rather than the rule.
  let d4 = lintTestSink()
  let f4 = addFile(d4.sm, "off.bit", src1)
  let cfg = newLintConfig()
  cfg.disabled[idx] = true
  let t4 = parseSourceD(src1, f4, lintTestSink())
  runLintRules(src1, f4, t4, cfg, d4)
  assert(len(d4.list) == 0)

  // And an override raising the limit suppresses it too, end to end from the
  // directive text.
  let src2 = "// bit:lint max-complexity=11 -- fixture\n" + lintTestNIfsSrc(10)
  let d5 = lintTestSink()
  let f5 = addFile(d5.sm, "raised.bit", src2)
  let c5 = readLintDirectives(src2, f5, d5)
  assert(!hasErrors(d5))
  assert(lintTestComplexityLimit(c5) == 11)
  let t5 = parseSourceD(src2, f5, lintTestSink())
  runLintRules(src2, f5, t5, c5, d5)
  assert(len(d5.list) == 0)
}

// The two shapes that motivate the rule (spec/LINT.md §4, task hypothesis):
// line count and branch count catch different failures, so neither rule
// subsumes the other.
fn checkLintComplexityShapes() {
  // A long, flat `match`: many arms, each a straight-line body with no
  // further branching. Every arm costs exactly one, so a handful of them
  // keeps the score at or under the default limit even though the function
  // is long — well past `max-fn-lines`' default of 80 (spec/LINT.md §4).
  let arms = 9
  let bodyLines = 10
  let flat = "fn flat() {\n  match (0) {\n"
  let i = 0
  while (i < arms) {
    flat = flat + "    A${i} => {\n"
    let j = 0
    while (j < bodyLines) {
      flat = flat + "      let p${i}_${j} = ${j}\n"
      j = j + 1
    }
    flat = flat + "    }\n"
    i = i + 1
  }
  flat = flat + "  }\n}\n"
  assert(lintCountLines(flat) > 80) // would fail a naive line-count rule
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "flat.bit", flat)
  lintMaxComplexity(parseSource(flat), f0, 10, d0)
  assert(len(d0.list) == 0) // 1 + 9 arms = 10: passes complexity

  // A short function with one heavily chained condition: nine `&&` on one
  // `if` is eleven lines shorter than `max-fn-lines`' default but eleven past
  // `max-complexity`'s.
  let chained = "fn chained() {\n" +
    "  if (a && b && c && d && e && f && g && h && i && j) {\n" +
    "  }\n" +
    "}\n"
  assert(lintCountLines(chained) <= 80) // passes a line-count rule easily
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "chained.bit", chained)
  lintMaxComplexity(parseSource(chained), f1, 10, d1)
  assert(len(d1.list) == 1) // 1 (base) + 1 (if) + 9 (&&) = 11: fails complexity
  assert(d1.list[0].message == "function complexity is 11, limit is 10")
}

// E0205 `defer-in-loop`: positive (while/for/nested), and the negatives the
// spec calls out by name — top-level, a defer inside a function merely CALLED
// from a loop (lexical scope only, no call-graph analysis), and a defer inside
// an arrow's own body even when the arrow is defined inside a loop.
fn checkLintDeferInLoop() {
  // A defer directly inside a `while` is reported, at the `defer` keyword —
  // not the whole `defer print(...)` statement DeferStmt's own span covers.
  let src0 = "fn f() {\n  while (true) {\n    defer print(\"x\")\n  }\n}\n"
  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "t.bit", src0)
  let t0 = parseSourceD(src0, f0, lintTestSink())
  lintDeferInLoop(t0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintDeferInLoop)
  assert(d0.list[0].severity == 1)
  assert(d0.list[0].message == "defer inside a loop runs at function exit, not loop exit")
  assert(d0.list[0].hint == "the enclosing loop starts at line 2")
  let sp0 = d0.list[0].span
  assert(src0[sp0.start:sp0.end] == "defer")

  // A defer inside a `for` loop is reported too.
  let src1 = "fn f() {\n  for (let i = 0; i < 3; i = i + 1) {\n    defer print(\"x\")\n  }\n}\n"
  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "t.bit", src1)
  let t1 = parseSourceD(src1, f1, lintTestSink())
  lintDeferInLoop(t1, f1, d1)
  assert(len(d1.list) == 1)

  // A defer at function top level is not reported.
  let src2 = "fn f() {\n  defer print(\"x\")\n}\n"
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "t.bit", src2)
  let t2 = parseSourceD(src2, f2, lintTestSink())
  lintDeferInLoop(t2, f2, d2)
  assert(len(d2.list) == 0)

  // A defer inside a function that merely happens to be CALLED from a loop is
  // not reported — this rule is lexical only, never call-graph.
  let src3 = "fn g() {\n  defer print(\"x\")\n}\nfn f() {\n  while (true) {\n    g()\n  }\n}\n"
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "t.bit", src3)
  let t3 = parseSourceD(src3, f3, lintTestSink())
  lintDeferInLoop(t3, f3, d3)
  assert(len(d3.list) == 0)

  // A defer inside a nested loop is reported, against the NEAREST loop.
  let src4 = "fn f() {\n  while (true) {\n    for (let i = 0; i < 3; i = i + 1) {\n      defer print(\"x\")\n    }\n  }\n}\n"
  let d4 = lintTestSink()
  let f4 = addFile(d4.sm, "t.bit", src4)
  let t4 = parseSourceD(src4, f4, lintTestSink())
  lintDeferInLoop(t4, f4, d4)
  assert(len(d4.list) == 1)
  assert(d4.list[0].hint == "the enclosing loop starts at line 3")

  // A defer inside an ARROW's body is not reported even when the arrow itself
  // sits inside a loop: the defer binds to the closure's own frame and runs
  // when the arrow returns, not when the enclosing function does.
  let src5 = "fn f() {\n  while (true) {\n    let g = (x: i64) => {\n      defer print(\"x\")\n      return x\n    }\n  }\n}\n"
  let d5 = lintTestSink()
  let f5 = addFile(d5.sm, "t.bit", src5)
  let t5 = parseSourceD(src5, f5, lintTestSink())
  lintDeferInLoop(t5, f5, d5)
  assert(len(d5.list) == 0)

  // ...but a defer inside a LOOP that is itself inside the arrow's body still
  // fires — against that inner loop, proving the arrow boundary RESETS the
  // loop context rather than suppressing the rule for the rest of the walk.
  let src6 = "fn f() {\n  while (true) {\n    let g = (x: i64) => {\n      while (x > 0) {\n        defer print(\"x\")\n        x = x - 1\n      }\n      return x\n    }\n  }\n}\n"
  let d6 = lintTestSink()
  let f6 = addFile(d6.sm, "t.bit", src6)
  let t6 = parseSourceD(src6, f6, lintTestSink())
  lintDeferInLoop(t6, f6, d6)
  assert(len(d6.list) == 1)
  assert(d6.list[0].hint == "the enclosing loop starts at line 4")

  // Registered disable-only: one of only two boolean rules in phase 1, so an
  // override naming a value must fail through the generic "takes no value"
  // directive error rather than silently applying.
  let de = lintTestSink()
  lintTestRead("// bit:lint defer-in-loop=1 -- nope\n", de)
  assert(hasErrors(de))
  assert(de.list[0].code == ecLintBadDirective)

  // The `disable` form works end to end, through the runner.
  let src7 = "// bit:lint disable defer-in-loop -- generated\n" +
    "fn f() {\n  while (true) {\n    defer print(\"x\")\n  }\n}\n"
  let d7 = lintTestSink()
  let f7 = addFile(d7.sm, "t.bit", src7)
  let c7 = readLintDirectives(src7, f7, d7)
  assert(!hasErrors(d7))
  let t7 = parseSourceD(src7, f7, lintTestSink())
  runLintRules(src7, f7, t7, c7, d7)
  assert(len(d7.list) == 0)
}

// E0213 `shadowed-local`: the gap case (an inner `let` hides an outer local),
// the parameter decision (a parameter shadowing an outer name is silent), the
// no-overlap-with-E0042 case (same-scope redeclaration reports only as
// duplicate_declaration), and the no-double-report-with-E0048 cases (a `let`
// hiding a predeclared name, and one hiding a prelude-shaped module import —
// see resolve.bit's `rFindShadowedLocal`).
fn checkLintShadowedLocal() {
  // The gap: an outer local `count`, an inner block's own `count` hides it.
  let d0 = lintTestSink()
  let src0 = "fn f() {\n  let count = 1\n  {\n    let count = 2\n  }\n}\n"
  let f0 = addFile(d0.sm, "gap.bit", src0)
  lintShadowedLocal(src0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintShadowedLocal)
  assert(d0.list[0].severity == 1)
  assert(!hasErrors(d0))
  assert(d0.list[0].message == "'count' shadows an outer binding of the same name")
  assert(d0.list[0].hint == "outer 'count' declared at gap.bit:2:7")

  // A parameter shadowing a module-level name of the same word: the
  // highest-volume real-world shape, deliberately not reported.
  let d1 = lintTestSink()
  let src1 = "let count = 0\nfn f(count: int): int {\n  return count\n}\n"
  let f1 = addFile(d1.sm, "param.bit", src1)
  lintShadowedLocal(src1, f1, d1)
  assert(len(d1.list) == 0)

  // Same-scope redeclaration is duplicate_declaration's job (E0042), not this
  // rule's — this pass reports nothing for it (the resolver's own E0042 goes
  // to a throwaway sink lintShadowedLocal never surfaces).
  let d2 = lintTestSink()
  let src2 = "fn f() {\n  let x = 1\n  let x = 2\n}\n"
  let f2 = addFile(d2.sm, "dup.bit", src2)
  lintShadowedLocal(src2, f2, d2)
  assert(len(d2.list) == 0)

  // A let hiding a predeclared name: E0048 shadows_predeclared already reports
  // this (via bit check); this rule stays silent so the two never double up.
  let d3 = lintTestSink()
  let src3 = "fn f() {\n  let int = 1\n}\n"
  let f3 = addFile(d3.sm, "predecl.bit", src3)
  lintShadowedLocal(src3, f3, d3)
  assert(len(d3.list) == 0)
}

fn checkLintRender() {
  let src = "a\nb\nc\n"
  let d = lintTestSink()
  let f = addFile(d.sm, "big.bit", src)
  lintMaxFileLines(src, f, 2, d)

  // Human output goes through the shared renderer — same gutter, caret and
  // hint machinery as `bit check`.
  assert(renderDiags(d) ==
    "warning[E0200]: file is 3 lines, limit is 2\n" +
    " --> big.bit:1:1\n" +
    "  |\n" +
    "1 | a\n" +
    "  | ^ split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>` " +
    "in the file's leading comment block\n")

  // JSON is the LSP shape `bit check --json` already emits: same keys, same
  // 0-based line/character range.
  assert(lintRenderJson(d) ==
    "[{\"code\":\"E0200\",\"severity\":\"warning\",\"file\":\"big.bit\"," +
    "\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}," +
    "\"message\":\"file is 3 lines, limit is 2\"," +
    "\"hint\":\"split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>` " +
    "in the file's leading comment block\"}]")

  // Quotes and control bytes are escaped, so a path or message containing one
  // cannot produce unparseable JSON.
  assert(lintJsonString("a\"b") == "\"a\\\"b\"")
  assert(lintJsonString("a\\b") == "\"a\\\\b\"")
  assert(lintJsonString("a\nb") == "\"a\\u000ab\"")
}

// Findings are ordered by file path, then line, then code — golden tests pin
// this order, so a stable one is a correctness property, not a nicety.
fn checkLintOrdering() {
  let d = lintTestSink()
  let fb = addFile(d.sm, "b.bit", "x\n")
  let fa = addFile(d.sm, "a.bit", "x\ny\n")
  warn(d, 201, Span{ file: fb, start: 0, end: 0 }, "second file", "")
  warn(d, 201, Span{ file: fa, start: 2, end: 2 }, "line 2", "")
  warn(d, 200, Span{ file: fa, start: 0, end: 0 }, "line 1", "")
  lintSortDiags(d)
  assert(d.list[0].message == "line 1")
  assert(d.list[1].message == "line 2")
  assert(d.list[2].message == "second file")
}

fn checkLintArgs() {
  // No paths defaults to ".".
  let a0 = parseLintArgs(["bit", "lint"])
  assert(a0.ok)
  assert(len(a0.paths) == 1)
  assert(a0.paths[0] == ".")
  assert(!a0.json)
  assert(!a0.stats)

  let a1 = parseLintArgs(["bit", "lint", "--json", "--stats", "compiler", "stdlib"])
  assert(a1.ok)
  assert(a1.json)
  assert(a1.stats)
  assert(len(a1.paths) == 2)
  assert(a1.paths[1] == "stdlib")

  // An unknown flag is a usage error, not a path.
  let a2 = parseLintArgs(["bit", "lint", "--quiet"])
  assert(!a2.ok)
  assert(a2.badFlag == "--quiet")
}

// Runs the whole pipeline (parse + resolve + rule dispatch) over `src` under
// the default config, the way `bit lint` itself would for one file.
fn lintTestUnused(src: string): Diagnostics {
  let d = lintTestSink()
  let file = addFile(d.sm, "t.bit", src)
  let cfg = newLintConfig()
  let tree = parseSourceD(src, file, lintTestSink())
  runLintRules(src, file, tree, cfg, d)
  return d
}

fn lintHasFinding(d: Diagnostics, code: int, message: string): bool {
  let i = 0
  while (i < len(d.list)) {
    if (d.list[i].code == code && d.list[i].message == message) {
      return true
    }
    i = i + 1
  }
  return false
}

// E0210: an import never referenced anywhere is reported; one referenced only
// inside a nested block is not — both read `nodeSymbols` the same way
// regardless of how deep the reference sits, unlike a flat name-keyed env.
fn checkLintUnusedImport() {
  let d0 = lintTestUnused("import { foo } from \"./mod\"\n\nfn main() {\n}\n")
  assert(lintHasFinding(d0, ecLintUnusedImport, "'foo' is imported but never used"))

  let d1 = lintTestUnused(
    "import { foo } from \"./mod\"\n\nfn main() {\n  if (true) {\n    foo()\n  }\n}\n")
  assert(!lintHasFinding(d1, ecLintUnusedImport, "'foo' is imported but never used"))

  // `import { foo as _ } from "..."` is Bit's spelling of an import kept only
  // for a side effect (SPEC §5.1/§17.2): the blank identifier never binds a
  // real symbol, so it is exempt with no special-casing in the rule itself.
  let d2 = lintTestUnused("import { foo as _ } from \"./mod\"\n\nfn main() {\n}\n")
  assert(!lintHasFinding(d2, ecLintUnusedImport, "'foo' is imported but never used"))
  assert(len(d2.list) == 0)
}

// E0211: a local declared and never read is reported; a local read only
// inside a closure is not; a local assigned but never subsequently read is
// reported too (a write is not a use).
fn checkLintUnusedLocal() {
  let d0 = lintTestUnused("fn f() {\n  let x = 1\n}\n")
  assert(lintHasFinding(d0, ecLintUnusedLocal, "'x' is declared but never used"))

  let d1 = lintTestUnused("fn f() {\n  let x = 1\n  x = 2\n}\n")
  assert(lintHasFinding(d1, ecLintUnusedLocal, "'x' is declared but never used"))

  let d2 = lintTestUnused(
    "fn f() {\n  let x = 1\n  let g = () => { return x }\n  g()\n}\n")
  assert(!lintHasFinding(d2, ecLintUnusedLocal, "'x' is declared but never used"))
  assert(!lintHasFinding(d2, ecLintUnusedLocal, "'g' is declared but never used"))

  // The blank identifier discards deliberately and never binds a symbol.
  let d3 = lintTestUnused("fn f() {\n  let _ = 1\n}\n")
  assert(!lintHasFinding(d3, ecLintUnusedLocal, "'_' is declared but never used"))
  assert(len(d3.list) == 0)
}

// E0215 (#2117): a bare call to an in-file, receiver-less function with a
// declared non-void result, used as a statement, is reported; binding it to
// '_' (the same escape E0211's own hint teaches) or reading it is not; a
// call to a void in-file function, a method call, and a call to an imported
// name (whose signature the stub module cannot carry, see lintunused.bit's
// header) are all out of this rule's reach by construction, not by a special
// case in it.
fn checkLintUnusedResult() {
  let d0 = lintTestUnused("fn double(n: int): int {\n  return n * 2\n}\nfn f() {\n  double(1)\n}\n")
  assert(lintHasFinding(d0, ecLintUnusedResult, "'double' returns a value that is discarded here"))

  // Bound to '_': a `LetDecl`, never an `ExprStmt`, so the rule never visits it.
  let d1 = lintTestUnused(
    "fn double(n: int): int {\n  return n * 2\n}\nfn f() {\n  let _ = double(1)\n}\n")
  assert(!lintHasFinding(d1, ecLintUnusedResult, "'double' returns a value that is discarded here"))
  assert(len(d1.list) == 0)

  // Read via a real binding.
  let d2 = lintTestUnused(
    "fn double(n: int): int {\n  return n * 2\n}\nfn f() {\n  let v = double(1)\n  v = v + 1\n}\n")
  assert(!lintHasFinding(d2, ecLintUnusedResult, "'double' returns a value that is discarded here"))

  // A void function: nothing is discarded.
  let d3 = lintTestUnused("fn sideEffect(n: int) {\n}\nfn f() {\n  sideEffect(1)\n}\n")
  assert(len(d3.list) == 0)

  // A method call: methods never join the flat namespace (resolve.bit's
  // `rCollectTopDecl`), so `mod.nodeSymbols` has nothing to resolve the
  // callee to and this rule cannot see it.
  let d4 = lintTestUnused(
    "class Box {\n  n: int,\n}\nfn (b: Box) touch(): Box {\n  return b\n}\nfn f(b: Box) {\n  b.touch()\n}\n")
  assert(len(d4.list) == 0)

  // An imported function: the stub module carries only the name, never a
  // signature (buildStubImports), so this resolves to `ImportItem`, not
  // `Func`, and is out of reach the same way.
  let d5 = lintTestUnused(
    "import { thing } from \"./mod\"\nfn f() {\n  thing()\n}\n")
  assert(len(d5.list) == 0)

  // A `catch` block's tail call is the CATCH EXPRESSION's value, not a
  // discarded statement (validatestmt.bit's own E0065 carve-out for the
  // identical shape) -- must not fire even though the tail is syntactically
  // an `ExprStmt` wrapping a `Call` to an in-file non-void function.
  let d6 = lintTestUnused(
    "fn double(n: int): int {\n  return n * 2\n}\n" +
      "fn risky(): int! {\n  fail newError(\"no\")\n}\n" +
      "fn f() {\n  let v = risky() catch e {\n    double(1)\n  }\n}\n")
  assert(!lintHasFinding(d6, ecLintUnusedResult, "'double' returns a value that is discarded here"))
}

// E0216 `empty-test-file` (#3779, SPEC §19). Exercises `lintEmptyTestFile`
// directly, over `parseSource` — no resolver, matching the rule's own
// AST-only dependency; then once through `runLintRules` to prove the wiring.
fn checkLintEmptyTestFile() {
  let rules = lintRules()
  let idx = lintRuleIndex(rules, "empty-test-file")
  assert(idx >= 0)
  assert(rules[idx].code == ecLintEmptyTestFile)
  assert(!rules[idx].hasLimit)

  // Not a `.test.bit` file at all: never checked, whatever it declares.
  let d0 = lintTestSink()
  let src0 = "fn helper(x: int): int {\n  return x\n}\n"
  let f0 = addFile(d0.sm, "plain.bit", src0)
  lintEmptyTestFile(parseSource(src0), src0, f0, d0)
  assert(len(d0.list) == 0)

  // A `.test.bit` file with only a helper (takes a parameter, so it is not
  // test-shaped): no discoverable test — the finding.
  let d1 = lintTestSink()
  let src1 = "fn helperOnly(x: int): int {\n  return x + 1\n}\n"
  let f1 = addFile(d1.sm, "a.test.bit", src1)
  lintEmptyTestFile(parseSource(src1), src1, f1, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintEmptyTestFile)
  assert(d1.list[0].severity == 1) // a warning, must not bump errorCount
  assert(!hasErrors(d1))
  assert(d1.list[0].message == "'.test.bit' file declares no discoverable test")

  // A `.test.bit` file with a real test: clean.
  let d2 = lintTestSink()
  let src2 = "fn test_ok() {\n  assert(1 + 1 == 2)\n}\n"
  let f2 = addFile(d2.sm, "b.test.bit", src2)
  lintEmptyTestFile(parseSource(src2), src2, f2, d2)
  assert(len(d2.list) == 0)

  // `main` is excluded from counting as a test, same as `testgen.bit`'s
  // `isTestFunc`: a `.test.bit` file declaring only a test-shaped `main` is
  // still empty of DISCOVERED tests.
  let d3 = lintTestSink()
  let src3 = "fn main() {\n}\n"
  let f3 = addFile(d3.sm, "c.test.bit", src3)
  lintEmptyTestFile(parseSource(src3), src3, f3, d3)
  assert(len(d3.list) == 1)
  assert(d3.list[0].code == ecLintEmptyTestFile)

  // A plain `.bit` helper sitting inside a `_tests_/`-shaped path is NEVER
  // flagged, even when every declaration is zero-arg and would otherwise
  // look test-shaped — only the FILENAME's own suffix is checked, never a
  // directory component (the owner-confirmed exemption).
  let d4 = lintTestSink()
  let src4 = "fn setupFixture() {\n}\n"
  let f4 = addFile(d4.sm, "proj/_tests_/fakeserver.bit", src4)
  lintEmptyTestFile(parseSource(src4), src4, f4, d4)
  assert(len(d4.list) == 0)

  // Reachable through the real dispatcher, not just called directly above.
  let d5 = lintTestSink()
  let f5 = addFile(d5.sm, "wired.test.bit", src1)
  runLintRules(src1, f5, parseSource(src1), newLintConfig(), d5)
  assert(lintHasFinding(d5, ecLintEmptyTestFile, "'.test.bit' file declares no discoverable test"))
}

// E0212 `unreachable-code`. Exercises `lintUnreachableCode` directly, over
// `parseSource` — no resolver, matching the rule's own AST-only dependency
// (spec/LINT.md §4.2).
fn checkLintUnreachableCode() {
  // Reported: a statement after a `return` in the same block.
  let d0 = lintTestSink()
  let src0 = "fn f(): int {\n  return 1\n  let dead = 2\n  return dead\n}\n"
  let f0 = addFile(d0.sm, "u0.bit", src0)
  lintUnreachableCode(parseSource(src0), src0, f0, d0)
  assert(len(d0.list) == 1)
  assert(d0.list[0].code == ecLintUnreachableCode)
  // A finding is a WARNING and must not bump errorCount (diagnostics.bit:93).
  assert(d0.list[0].severity == 1)
  assert(!hasErrors(d0))
  assert(d0.list[0].message == "unreachable code")

  // NOT reported: only one arm of this `if` diverges (there is no `else`), so
  // `diverges` (and therefore this rule) does not treat it as terminal — the
  // exact partial-divergence case the reuse constraint exists for.
  let d1 = lintTestSink()
  let src1 = "fn f(x: bool): int {\n  if (x) {\n    return 1\n  }\n  let after = 2\n  return after\n}\n"
  let f1 = addFile(d1.sm, "u1.bit", src1)
  lintUnreachableCode(parseSource(src1), src1, f1, d1)
  assert(len(d1.list) == 0)

  // Reported: BOTH arms of the `if`/`else` diverge, so the `if` as a whole
  // diverges and what follows it is dead.
  let d2 = lintTestSink()
  let src2 = "fn f(x: bool): int {\n  if (x) {\n    return 1\n  } else {\n    return 2\n  }\n  let dead = 3\n}\n"
  let f2 = addFile(d2.sm, "u2.bit", src2)
  lintUnreachableCode(parseSource(src2), src2, f2, d2)
  assert(len(d2.list) == 1)

  // ONE finding per dead run, not one per statement in it.
  let d3 = lintTestSink()
  let src3 = "fn f(): int {\n  return 1\n  let a = 1\n  let b = 2\n}\n"
  let f3 = addFile(d3.sm, "u3.bit", src3)
  lintUnreachableCode(parseSource(src3), src3, f3, d3)
  assert(len(d3.list) == 1)

  // The match-arm case: a `return` inside one arm's own block makes the
  // statement after it dead, exactly like a plain function body. The other
  // arm doesn't diverge, so the match as a whole doesn't either and the
  // `return 0` after it stays live.
  let d4 = lintTestSink()
  let src4 = "fn f(x: bool): int {\n  match (x) {\n    A => {\n      return 1\n      let dead = 2\n    }\n    B => {\n      let ok = 1\n    }\n  }\n  return 0\n}\n"
  let f4 = addFile(d4.sm, "u4.bit", src4)
  lintUnreachableCode(parseSource(src4), src4, f4, d4)
  assert(len(d4.list) == 1)

  // `break` ends the rest of its own block too, even outside a function that
  // needs to return — `countBrk` is true here, unlike missing-return's caller.
  let d5 = lintTestSink()
  let src5 = "fn f() {\n  for {\n    break\n    let dead = 1\n  }\n}\n"
  let f5 = addFile(d5.sm, "u5.bit", src5)
  lintUnreachableCode(parseSource(src5), src5, f5, d5)
  assert(len(d5.list) == 1)

  // A disable really suppresses it, through the runner rather than the rule.
  let d6 = lintTestSink()
  let f6 = addFile(d6.sm, "u6.bit", src0)
  let cfg6 = newLintConfig()
  cfg6.disabled[lintRuleIndex(lintRules(), "unreachable-code")] = true
  let t6 = parseSourceD(src0, f6, lintTestSink())
  runLintRules(src0, f6, t6, cfg6, d6)
  assert(len(d6.list) == 0)
}

fn checkLint() {
  checkLintDirectivesAccepted()
  checkLintDirectivePlacement()
  checkLintDirectiveErrors()
  checkLintAllow()
  checkLintLineCount()
  checkLintMaxFileLines()
  checkLintMaxFnLines()
  checkLintMaxParams()
  checkLintMaxNesting()
  checkLintMaxNestingElseIf()
  checkLintMaxComplexity()
  checkLintComplexityShapes()
  checkLintDeferInLoop()
  checkLintUnusedImport()
  checkLintUnusedLocal()
  checkLintUnusedResult()
  checkLintEmptyTestFile()
  checkLintUnreachableCode()
  checkLintShadowedLocal()
  checkLintRender()
  checkLintOrdering()
  checkLintArgs()
}
