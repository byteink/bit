// In-Bit self-check for `profrender.bit`'s `profSymbolFor` (#6240). Split
// out as its own sibling the same way `pmlockcheck.bit` sits beside
// `pmlock.bit`; `selfcheck()` (selfcheck.bit) calls `checkProfSymbolFor()`
// directly — selfhost is a single module, so `compiler/`'s siblings share
// one namespace and this needs no import of `ProfSym`/`profSymbolFor`.

// A synthetic 3-symbol text section, `[textLo, textHi) = [0x1000, 0x1300)`,
// each symbol's own code running to the next symbol's address (or `textHi`
// for the last one). Proves `profSymbolFor` bounds the lookup on both
// sides: a `pc` before `textLo`, inside a gap before the first symbol,
// inside each symbol's own span, and — the regression this ticket fixes —
// at or past `textHi`, all resolve to the row #6240 asks for instead of the
// old "charge it to the last symbol in the binary" behaviour.
fn checkProfSymbolFor() {
  let textLo = 0x1000
  let textHi = 0x1300
  // The first symbol starts 0x10 past `textLo` on purpose, leaving a real
  // gap `[textLo, 0x1010)` for the "before the first symbol" case below.
  let syms = [
    ProfSym{ addr = 0x1010, name = "first" },
    ProfSym{ addr = 0x1100, name = "second" },
    ProfSym{ addr = 0x1200, name = "third" },
  ]

  // Squarely inside each symbol's own span.
  assert(profSymbolFor(syms, 0x1010, textLo, textHi) == "first")
  assert(profSymbolFor(syms, 0x10ff, textLo, textHi) == "first")
  assert(profSymbolFor(syms, 0x1100, textLo, textHi) == "second")
  assert(profSymbolFor(syms, 0x1200, textLo, textHi) == "third")
  assert(profSymbolFor(syms, 0x12ff, textLo, textHi) == "third")

  // Inside __TEXT but before the first symbol: the raw-address placeholder,
  // unchanged by this ticket.
  assert(profSymbolFor(syms, 0x1005, textLo, textHi) == "??? (0x${0x1005})")

  // Before __TEXT entirely: outside the binary, never a real function.
  assert(profSymbolFor(syms, 0x0fff, textLo, textHi) == profOutsideBinary)

  // At or past __TEXT's end — past the last symbol's own code — is the
  // regression #6240 fixes: this used to be charged to "third", the last
  // symbol in the binary, because the old lookup had no upper bound.
  assert(profSymbolFor(syms, 0x1300, textLo, textHi) == profOutsideBinary)
  assert(profSymbolFor(syms, 0x1938e60000, textLo, textHi) == profOutsideBinary)
}
