// compiler/relationautoerr.bit — R3 (#6308, epic #6298): the FAIL-CLOSED
// half of "relations load themselves" (SPEC §10.5, owner ruling
// 2026-09-30). R1/R2/R2b (#6302/#6305/#6322) splice '.with(...)' onto every
// PROVABLE relation read; this pass is their complement — it walks the same
// whole-project call graph a second time, using the SAME converged
// `RelationAutoFuncSummaries` (relationautocalls.bit), and turns every read
// neither pass could prove loaded into a build error instead of #5271's own
// runtime panic (classrelationattr.bit's `relationUnloadedSentinel`). `bit
// check` and `bit build` therefore refuse the same programs — this runs
// from `checkResolved`, whether or not lowering ever happens.
//
// WHY A SECOND WALK, NOT A CHECK BOLTED ONTO relationAutoWalk: R1/R2/R2b's
// own walk is INTENTIONALLY blind to a read it cannot place
// (relationauto.bit's `relationAutoResolve` answers `found = false` for a
// map/field/channel-held row, a composite literal, `db.query<T>`'s own
// rows, or a value inside a closure — there is nothing to splice `.with()`
// onto). Classifying "is this even a relation read" therefore cannot reuse
// THAT walk's own flow answer — it uses the receiver's STATIC type instead
// (`checkExprType`, safe to call here for the identical reason
// `relationAutoSourceCall`'s own header already gives: every module is
// checked before `checkResolved`'s own whole-project passes run), which
// answers the question for a map value, a raw-query row or a freshly built
// composite literal exactly as it does for a real query row.
// `relationAutoResolve` is then asked SEPARATELY, purely to tell a provable
// read (already spliced, or about to be) from one this pass must refuse.
//
// Assignment facts are keyed by resolved lexical symbols and retained only
// when every reaching branch establishes them (#7920). Whole-row writes kill
// the old facts; the existing all-writer holders prove query/parameter origins.

// E0300: the checker's own diagnostic band's next free code above E0299.
const ecRelationAutoUnprovableRead = 300

// A relation explicitly set on one resolved lexical variable.
class RelationAutoErrLoaded {
  symbol: int,
  fieldName: string,
}

class RelationAutoErrState {
  loaded: []RelationAutoErrLoaded,
}

// What one whole-project pass over every function shares (#6344): the
// project-wide `calledSet`, the `RelationAutoHolders` (relationautoholder.bit)
// pass one FILLS and pass two READS, and `collect` — true on pass one, which reports
// nothing and only records every store into a holder. `defaults` (#6366): the
// default expressions pass two already judged, keyed `"${module}:${node}"` — a
// default is one expression however many calls omit it, so it is reported once.
class RelationAutoErrPass {
  calledSet: map<string, bool>,
  holders: RelationAutoHolders,
  collect: bool,
  defaults: map<string, bool>,
}

// Bundles every value the walk threads through unchanged, one param instead
// of four everywhere below (`spec/LINT.md`'s own max-params ceiling) — `st`
// is relationauto.bit's own flow-resolution state (bindings + the converged
// summaries), `errSt` this file's own loaded-fields accumulator, `fd` the
// CURRENT function's own decl node (0 for a closure/generic function, never
// seeded — this file's own header, gap 2), `pass` the project-wide state
// above.
class RelationAutoErrCtx {
  st: RelationAutoState,
  errSt: RelationAutoErrState,
  fd: int,
  pass: RelationAutoErrPass,
}

// Every non-generic named free function at least one `Tag.Call` anywhere in
// the project resolves to BY NAME, keyed `"${moduleId}:${decl}"` — gap 2,
// this file's own header.
fn relationAutoBuildCalledSet(mods: []Checker): map<string, bool> {
  let out = map<string, bool>{}
  for c of mods {
    for fd of relationAutoCallerFuncs(c.tree) {
      relationAutoCollectCalledNames(c, lintFuncInfo(c.tree, fd).body, out)
    }
  }
  return out
}

fn relationAutoCollectCalledNames(c: Checker, node: int, out: map<string, bool>) {
  if (node == 0) {
    return
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Call) {
    let callee = kidsOf(c.tree, node)[0]
    if (getNode(c.tree, callee).tag == Tag.Ident) {
      let name = identText(c.tree, c.source, callee)
      if (!shadowedByValue(c, callee, name)) {
        let decl = funcDeclLookup(c, name)
        if (decl != 0) {
          let owner = declOwner(c, name)
          out["${owner.moduleId}:${decl}"] = true
        }
      }
    }
  }
  for k of kidsOf(c.tree, node) {
    relationAutoCollectCalledNames(c, k, out)
  }
}

// `cls.decl`'s own name ident (kid 0, every top-level class decl's shape —
// `lintFieldByName`'s identical read, compiler/relationfieldread.bit).
fn relationAutoClassName(cls: RelationAutoClass): string {
  return identText(cls.oc.tree, cls.oc.source, kidsOf(cls.oc.tree, cls.decl)[0])
}

fn relationAutoReportUnprovable(
  c: Checker,
  node: int,
  fieldName: string,
  className: string,
  hint: string,
) {
  report(
    c.diags, ecRelationAutoUnprovableRead, vSpan(c, node),
    "relation field '${fieldName}' on '${className}' was read without the compiler proving its rows were loaded",
    hint,
  )
}

fn relationAutoUnknownOriginHint(fieldName: string): string {
  return "this read's own rows could not be traced back to a query -- load '${fieldName}' " +
    "where the rows are queried (add '.with(\"${fieldName}\")' there)"
}

// A parameter no function of the project calls has no rows to load anything
// on: there is no query to add `.with(...)` to. The fix is a call, from a
// function body (a `test` block is not a caller, so it does not count even in
// the package's own tests, and never once the package is imported), that hands
// it rows from a query; the query loads what the parameter reads.
fn relationAutoNoCallerHint(paramName: string, funcName: string, fieldName: string): string {
  return "'${paramName}' is a parameter of '${funcName}', and no function in this project calls " +
    "'${funcName}' (a `test` block is not a caller), so no query's rows ever reach it -- call " +
    "'${funcName}' from a function with rows from a query, which then loads '${fieldName}' " +
    "(or add '.with(\"${fieldName}\")' to that query)"
}

// Both walks and call-argument proof use the same current definite facts.
fn relationAutoErrLoadedByAssignment(
  c: Checker, recv: int, fieldName: string, loaded: []RelationAutoErrLoaded,
): bool {
  if (getNode(c.tree, recv).tag != Tag.Ident) {
    return false
  }
  let symbol = relationAutoSymbol(c, recv)
  for lf of loaded {
    if (symbol != 0 && lf.symbol == symbol && lf.fieldName == fieldName) {
      return true
    }
  }
  return false
}

// `flow` already failed to reach a real query or a holder
// (`relationAutoErrJudgeFlow`, below) — reports E0300 with the "unknown origin"
// hint. `fieldName`/`className` are re-derived from `node`/`staticCls` here
// rather than threaded as their own params, to keep this function's own param
// count at the ceiling.
fn relationAutoErrReportRead(c: Checker, node: int, staticCls: RelationAutoClass) {
  let fieldName = identText(c.tree, c.source, kidsOf(c.tree, node)[1])
  relationAutoReportUnprovable(
    c, node, fieldName, relationAutoClassName(staticCls), relationAutoUnknownOriginHint(fieldName),
  )
}

// Whether the stores that replaced the enclosing function's own parameter's
// rows (`holder:S`, #6366) prove a read of `need` through `flow`; vacuously so
// when `flow` names no parameter of the function being walked.
fn relationAutoParamStoresProve(
  c: Checker, ctx: RelationAutoErrCtx, flow: RelationAutoFlow, need: string,
): (bool, RelationAutoBlame) {
  let nameNode = relationAutoParamNameNode(c, ctx.fd, flow.paramName)
  if (nameNode == 0) {
    return (true, relationAutoNoBlame())
  }
  return relationAutoReplacingStoresProve(
    ctx.pass.holders, relationAutoParamStoreKey(c.moduleId, nameNode), need, 0,
  )
}

// A read through the enclosing function's own PARAMETER (`flow` names it). Its
// callers' arguments are proven at each call (relationautoerrcall.bit), so the
// read is proven when the function has a known caller — unless a store inside
// the function replaced the parameter's rows (#6366) with rows that do not load
// what is read, which is E0300 naming that store. A parameter nothing calls has
// no rows to be proven by.
fn relationAutoErrCheckParamRead(
  c: Checker,
  node: int,
  staticCls: RelationAutoClass,
  flow: RelationAutoFlow,
  ctx: RelationAutoErrCtx,
) {
  let fieldName = identText(c.tree, c.source, kidsOf(c.tree, node)[1])
  let className = relationAutoClassName(staticCls)
  let need = relationAutoJoinPath(flow.path, fieldName)
  let (stored, blame) = relationAutoParamStoresProve(c, ctx, flow, need)
  if (!stored) {
    relationAutoReportUnprovable(
      c, node, fieldName, className, relationAutoHolderHint(c, node, need, className, blame),
    )
    return
  }
  let (known, ok) = ctx.pass.calledSet["${c.moduleId}:${ctx.fd}"]
  if (ok && known) {
    return // this function has a known caller somewhere in the project
  }
  let funcName = identText(c.tree, c.source, kidsOf(c.tree, ctx.fd)[1])
  relationAutoReportUnprovable(
    c, node, fieldName, className, relationAutoNoCallerHint(flow.paramName, funcName, fieldName),
  )
}

// `node` is `Tag.Member = [recv, nameIdent]`. Classifies by the receiver's
// STATIC type (never by `flow`, this file's own header) and reports unless
// an earlier assignment or a provable `flow` already proves the read safe.
fn relationAutoErrCheckRead(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  if (ctx.pass.collect) {
    return
  }
  let k = kidsOf(c.tree, node)
  let recv = k[0]
  let nameIdx = k[1]
  if (recv == 0 || nameIdx == 0) {
    return
  }
  let staticCls = relationAutoClassFromStructType(c, checkExprType(c, recv))
  if (!staticCls.found) {
    return
  }
  let fieldName = identText(c.tree, c.source, nameIdx)
  if (!lintFieldIsRelation(staticCls.oc.tree, staticCls.oc.source, staticCls.decl, fieldName)) {
    return
  }
  if (relationAutoErrLoadedByAssignment(c, recv, fieldName, ctx.errSt.loaded)) {
    return
  }
  relationAutoErrJudgeFlow(c, node, staticCls, relationAutoResolve(c, recv, ctx.st), ctx)
}

// What the receiver's own resolved `flow` says about a relation read at
// `node`: a real query is proof (the splice loads it), a holder is proven by
// its stores, the enclosing function's own parameter by its callers and its own
// stores, anything else is reported.
fn relationAutoErrJudgeFlow(
  c: Checker,
  node: int,
  staticCls: RelationAutoClass,
  flow: RelationAutoFlow,
  ctx: RelationAutoErrCtx,
) {
  if (flow.found && (flow.queryCall > 0 || relationAutoIsHolderName(flow.paramName))) {
    relationAutoErrCheckHolderRead(c, node, staticCls, flow, ctx)
    return
  }
  if (flow.found && flow.paramName != "" && ctx.fd != 0) {
    relationAutoErrCheckParamRead(c, node, staticCls, flow, ctx)
    return
  }
  relationAutoErrReportRead(c, node, staticCls)
}

// A read on a holder, or on a query's own rows (relationautoholder.bit):
// proven iff every store into it loaded the read's full path (for a query, in
// addition to its own names, #6352); otherwise E0300, naming the query that
// stored the rows when one is known.
fn relationAutoErrCheckHolderRead(
  c: Checker,
  node: int,
  staticCls: RelationAutoClass,
  flow: RelationAutoFlow,
  ctx: RelationAutoErrCtx,
) {
  let fieldName = identText(c.tree, c.source, kidsOf(c.tree, node)[1])
  let need = relationAutoJoinPath(flow.path, fieldName)
  let (proved, blame) = relationAutoFlowProves(ctx.pass.holders, flow, need)
  if (proved) {
    return
  }
  let className = relationAutoClassName(staticCls)
  relationAutoReportUnprovable(
    c, node, fieldName, className, relationAutoHolderHint(c, node, need, className, blame),
  )
}

// Pass one's per-node collection: the literals and the `return` whose values
// are stores into a holder (a literal's fields and entries, relationautostore.bit;
// a mixed function's return, relationautoreturn.bit).
fn relationAutoErrCollectNode(c: Checker, node: int, tag: Tag, ctx: RelationAutoErrCtx) {
  if (tag == Tag.CompositeLit || tag == Tag.MapLit) {
    relationAutoHolderNoteLiteral(c, node, ctx)
    return
  }
  if (tag == Tag.ReturnStmt) {
    relationAutoHolderNoteReturn(c, node, ctx)
  }
}

fn relationAutoErrWalk(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  if (node == 0) {
    return
  }
  let tag = getNode(c.tree, node).tag
  if (lintIsNestedFuncBoundary(tag)) {
    return
  }
  if (relationAutoErrWalkScoped(c, node, tag, ctx)) {
    return
  }
  if (tag == Tag.Member) {
    relationAutoErrCheckRead(c, node, ctx)
  }
  if (tag == Tag.Call) {
    relationAutoErrCheckCall(c, node, ctx)
  }
  if (ctx.pass.collect) {
    relationAutoErrCollectNode(c, node, tag, ctx)
  }
  for k of kidsOf(c.tree, node) {
    relationAutoErrWalk(c, k, ctx)
  }
}

// One function's own fresh walk — mirrors `relationAutoWalkOneFunc`'s own
// seeding exactly (relationautocalls.bit), so a named function's own
// parameters resolve identically for provability here as they do for
// splicing there.
fn relationAutoErrCheckOneFunc(
  c: Checker,
  fd: int,
  sums: RelationAutoFuncSummaries,
  pass: RelationAutoErrPass,
) {
  let (idx, hasIdx) = sums.declToIndex["${c.moduleId}:${fd}"]
  let bindings = []RelationAutoBinding(0)
  let namedFd = 0
  if (hasIdx) {
    bindings = relationAutoSeedParamBindings(c, sums.list[idx].params)
    namedFd = fd
  }
  let st = RelationAutoState{
    bindings = bindings, assigned = []RelationAutoErrLoaded(0), summaries = sums,
    paramReads = map<string, []string>{}, returnSeen = false, returnCandidate = relationAutoNoFlow(c),
    returnMixed = false,
  }
  let ctx = RelationAutoErrCtx{
    st = st, errSt = RelationAutoErrState{ loaded = []RelationAutoErrLoaded(0) }, fd = namedFd, pass = pass,
  }
  for dflt of relationAutoParamDefaults(c.tree, fd) {
    relationAutoErrWalk(c, dflt, ctx)
  }
  relationAutoErrWalk(c, relationAutoBodyOf(c.tree, fd), ctx)
}

// One whole-project sweep over every function; pass one (`pass.collect`) also
// sweeps each module's top level, where a module-level `let`/literal can
// store a row into a holder outside any function.
fn relationAutoErrSweep(
  mods: []Checker,
  sums: RelationAutoFuncSummaries,
  pass: RelationAutoErrPass,
) {
  for c of mods {
    for fd of relationAutoCollectBodies(c.tree) {
      relationAutoErrCheckOneFunc(c, fd, sums, pass)
    }
    if (pass.collect) {
      relationAutoErrCollectTopLevel(c, sums, pass)
    }
  }
}

fn relationAutoErrCollectTopLevel(
  c: Checker,
  sums: RelationAutoFuncSummaries,
  pass: RelationAutoErrPass,
) {
  let st = RelationAutoState{
    bindings = []RelationAutoBinding(0), assigned = []RelationAutoErrLoaded(0), summaries = sums,
    paramReads = map<string, []string>{}, returnSeen = false, returnCandidate = relationAutoNoFlow(c),
    returnMixed = false,
  }
  let ctx = RelationAutoErrCtx{
    st = st, errSt = RelationAutoErrState{ loaded = []RelationAutoErrLoaded(0) }, fd = 0, pass = pass,
  }
  relationAutoErrWalk(c, c.tree.root, ctx)
}

// Entry point — called once from `relationAutoAnalyzeProject`
// (relationauto.bit), after the whole-project fixed point (R2b,
// relationautocalls.bit) has converged. Two sweeps (#6344): the first only
// collects every store into a holder (relationautoholder.bit), the second
// reports.
fn relationAutoCheckErrors(mods: []Checker, sums: RelationAutoFuncSummaries) {
  let calledSet = relationAutoBuildCalledSet(mods)
  let holders = relationAutoNewHolders(mods)
  relationAutoErrSweep(
    mods, sums,
    RelationAutoErrPass{
      calledSet = calledSet, holders = holders, collect = true, defaults = map<string, bool>{},
    },
  )
  relationAutoErrSweep(
    mods, sums,
    RelationAutoErrPass{
      calledSet = calledSet, holders = holders, collect = false, defaults = map<string, bool>{},
    },
  )
}
