// compiler/relationautoerr.bit — R3 (#6308, epic #6298): the FAIL-CLOSED
// half of "relations load themselves" (data-packages-dx.md, owner ruling
// 2026-09-30). R1/R2/R2b (#6302/#6305/#6322) splice '.with(...)' onto every
// PROVABLE relation read; this pass is their complement — it walks the same
// whole-project call graph a second time, using the SAME converged
// `RelationAutoFuncSummaries` (relationautocalls.bit), and turns every read
// neither pass could prove loaded into a build error instead of #5271's own
// runtime panic (classrelationattr.bit's `relationUnloadedSentinel`). `bit
// check` and `bit build` therefore refuse the same programs — this runs
// from `checkResolved`, whether or not lowering ever happens.
//
// WHY A SECOND WALK, NOT A CHECK BOLTED ONTO relationAutoWalk: R1/R2/R2b's
// own walk is INTENTIONALLY blind to a read it cannot place
// (relationauto.bit's `relationAutoResolve` answers `found = false` for a
// map/field/channel-held row, a composite literal, `db.query<T>`'s own
// rows, or a value inside a closure — there is nothing to splice `.with()`
// onto). Classifying "is this even a relation read" therefore cannot reuse
// THAT walk's own flow answer — it uses the receiver's STATIC type instead
// (`checkExprType`, safe to call here for the identical reason
// `relationAutoSourceCall`'s own header already gives: every module is
// checked before `checkResolved`'s own whole-project passes run), which
// answers the question for a map value, a raw-query row or a freshly built
// composite literal exactly as it does for a real query row.
// `relationAutoResolve` is then asked SEPARATELY, purely to tell a provable
// read (already spliced, or about to be) from one this pass must refuse.
//
// TWO GAPS `relationAutoResolve` ALONE CANNOT CLOSE, both handled here:
//   1. `x.f = ...` (or `X{ f = ... }` inside a composite literal a `let`
//      binds directly) earlier in the same function counts as loaded (plan
//      file, R3's own scope) — relationauto.bit's own walk never tracks a
//      WRITE, only reads, so this file keeps its own small, flat,
//      offset-ordered `RelationAutoErrLoaded` list, mirroring
//      `RelationAutoBinding.afterOffset`'s own "no CFG, source-order only"
//      simplification (lintrelation.bit's `RelationBinding` makes the same
//      call). An assignment inside one arm of an `if` still reads as
//      "loaded" for a read written textually after the whole `if`, even on
//      a branch that never assigned it — a KNOWN, ACCEPTED gap in the
//      UNSOUND direction (a false negative: an actually-unloaded field
//      still carries #5271's own sentinel at run time; this ticket's own
//      scope is the five bullets below, not branch-exact tracking). A
//      composite literal chained straight into a read with no `let` at all
//      (`Post{ author = Author{...} }.author.name`) is NOT tracked either —
//      rare in practice, and the failure direction is the safe one: it is
//      reported as unprovable rather than silently accepted.
//   2. a trackable PARAMETER's own binding is seeded UNCONDITIONALLY by
//      `relationAutoSeedParamBindings` (relationautocalls.bit), whether or
//      not the project ever calls that function at all — so
//      `relationAutoResolve` answers `found = true` for "a parameter with
//      no known caller" exactly as it does for one a real caller feeds a
//      query row, and the auto-loader is right to treat both alike (it only
//      ever needs a NAME to record a splice against, resolved later). This
//      pass tells them apart with its own one-shot, purely SYNTACTIC
//      `relationAutoBuildCalledSet`: does ANY `Tag.Call` anywhere in the
//      project resolve (by name, `funcDeclLookup`/`declOwner`, guarded by
//      `shadowedByValue` — the same pair/guard `relationAutoLookupSummary`
//      already trusts) to this exact function at all? This is a WIDER
//      question than "does some call's ARGUMENT resolve" (R2/R2b's own
//      per-parameter fixed point already answers that, correctly, for
//      every read this pass lets through) — a function called only with
//      untraceable arguments (through a closure value, say) still counts
//      as "known caller" here, but its own reads on that parameter are
//      STILL caught: the untraceable argument was never resolvable at the
//      call site either, so `relationAutoCheckCallArgs`
//      (relationautocalls.bit) never records it, and `relationAutoResolve`
//      still answers `found = false` at the read site for that reason.
//      Gap 2's own caller-existence check only ever WIDENS what this pass
//      accepts past what R2/R2b's own fixed point grounds — it can only
//      turn a report into a pass, never introduce one.
//
// SCOPE. Five bullets, matching the plan file's own list exactly:
//   - rows stored in a field/map/list/channel: never reach any binding this
//     pass or relationauto.bit's own walk tracks — `relationAutoResolve`
//     answers `found = false` at the read site; static typing still names
//     the class.
//   - rows captured by a closure: `lintCollectFuncs` already gives a
//     closure/`ArrowFn` its own SEPARATE walk entry (mirrors
//     `relationAutoWalkOneFunc`'s own reasoning) — a captured variable is
//     simply never seen again inside that FRESH walk's own empty
//     bindings/loaded state, so nothing extra is needed here beyond
//     enumerating every function the same way R1/R2 already do.
//   - rows from `db.query<T>`, and rows passed through a generic function's
//     own type parameter: both already fall out of `relationAutoResolve`'s
//     own existing "unhandled shape" answer (a `db.query<T>` call's callee
//     is a `Tag.Member`, never matched by `relationAutoSourceCall`'s own
//     `all`/`find`/`first` name check; a generic function's own parameters
//     are never seeded at all — `relationAutoWalkOneFunc`'s own `hasIdx`
//     guard, relationautocalls.bit) — no new detection needed here beyond
//     the STATIC-type reclassification above.
//   - a composite literal that never sets the relation: same as the first
//     bullet — `Tag.CompositeLit` is not one of `relationAutoResolve`'s own
//     handled tags either; gap 1's own field-init tracking is what tells
//     this apart from one that DOES set it.
//   - a parameter with no known caller: gap 2, above.
//
// HOOKED FROM `relationAutoAnalyzeProject` (relationauto.bit), AFTER the
// whole-project fixed point converges — `relationAutoAnalyzeWholeProject`
// (relationautocalls.bit) now RETURNS its own `sums` rather than discarding
// it, the one signature change this ticket makes outside this new file: a
// second, independent recomputation here would either duplicate the whole
// fixed point's own cost or risk drifting from the exact set
// `relationautosplice.bit` actually splices.

// E0300: the checker's own diagnostic band's next free code above E0299.
const ecRelationAutoUnprovableRead = 300

// One `varName.fieldName = ...` (or an equivalent composite-literal field
// init) seen earlier in the CURRENT function — gap 1, this file's own
// header. Flat and offset-ordered, never scoped/popped at a block boundary:
// a mutation's effect outlives the block it happened in, unlike a `let`'s
// own binding (`RelationAutoBinding`, relationauto.bit).
class RelationAutoErrLoaded {
  varName: string,
  fieldName: string,
  afterOffset: int,
}

class RelationAutoErrState {
  loaded: []RelationAutoErrLoaded,
}

// Bundles every value the walk threads through unchanged, one param instead
// of four everywhere below (`spec/LINT.md`'s own max-params ceiling) — `st`
// is relationauto.bit's own flow-resolution state (bindings + the converged
// summaries), `errSt` this file's own loaded-fields accumulator, `fd` the
// CURRENT function's own decl node (0 for a closure/generic function, never
// seeded — this file's own header, gap 2), `calledSet`
// `relationAutoBuildCalledSet`'s own one-shot project-wide answer.
class RelationAutoErrCtx {
  st: RelationAutoState,
  errSt: RelationAutoErrState,
  fd: int,
  calledSet: map<string, bool>,
}

// Every non-generic named free function at least one `Tag.Call` anywhere in
// the project resolves to BY NAME, keyed `"${moduleId}:${decl}"` — gap 2,
// this file's own header.
fn relationAutoBuildCalledSet(mods: []Checker): map<string, bool> {
  let out = map<string, bool>{}
  for c of mods {
    for fd of lintCollectFuncs(c.tree, c.tree.root, []int(0)) {
      relationAutoCollectCalledNames(c, lintFuncInfo(c.tree, fd).body, out)
    }
  }
  return out
}

fn relationAutoCollectCalledNames(c: Checker, node: int, out: map<string, bool>) {
  if (node == 0) {
    return
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Call) {
    let callee = kidsOf(c.tree, node)[0]
    if (getNode(c.tree, callee).tag == Tag.Ident) {
      let name = identText(c.tree, c.source, callee)
      if (!shadowedByValue(c, callee, name)) {
        let decl = funcDeclLookup(c, name)
        if (decl != 0) {
          let owner = declOwner(c, name)
          out["${owner.moduleId}:${decl}"] = true
        }
      }
    }
  }
  for k of kidsOf(c.tree, node) {
    relationAutoCollectCalledNames(c, k, out)
  }
}

// `cls.decl`'s own name ident (kid 0, every top-level class decl's shape —
// `lintFieldByName`'s identical read, compiler/lintrelation.bit).
fn relationAutoClassName(cls: RelationAutoClass): string {
  return identText(cls.oc.tree, cls.oc.source, kidsOf(cls.oc.tree, cls.decl)[0])
}

fn relationAutoReportUnprovable(
  c: Checker,
  node: int,
  fieldName: string,
  className: string,
  hint: string,
) {
  report(
    c.diags, ecRelationAutoUnprovableRead, vSpan(c, node),
    "relation field '${fieldName}' on '${className}' was read without the compiler proving its rows were loaded",
    hint,
  )
}

fn relationAutoUnknownOriginHint(fieldName: string): string {
  return "this read's own rows could not be traced back to a query -- load '${fieldName}' " +
    "where the rows are queried (add '.with(\"${fieldName}\")' there)"
}

fn relationAutoNoCallerHint(paramName: string, funcName: string, fieldName: string): string {
  return "'${paramName}' is a parameter of '${funcName}', and no call in this project resolves " +
    "to '${funcName}' -- load '${fieldName}' where the rows that will reach it are queried " +
    "(add '.with(\"${fieldName}\")' there)"
}

// True when `loaded` already records `recv.fieldName` from before `node`'s
// own read position — an earlier assignment or composite-literal field
// init (gap 1, this file's own header). `false` when `recv` is not even a
// bare name, since only a plain variable can be tracked this way.
fn relationAutoErrLoadedByAssignment(
  c: Checker, recv: int, fieldName: string, node: int, loaded: []RelationAutoErrLoaded,
): bool {
  if (getNode(c.tree, recv).tag != Tag.Ident) {
    return false
  }
  let varName = identText(c.tree, c.source, recv)
  let readAt = getNode(c.tree, node).span.start
  for lf of loaded {
    if (lf.varName == varName && lf.fieldName == fieldName && lf.afterOffset < readAt) {
      return true
    }
  }
  return false
}

// `flow` already failed to reach a real query (`relationAutoErrCheckRead`'s
// own caller) — reports E0300, picking the "parameter with no known
// caller" wording (gap 2) when that is exactly what `flow` names, and the
// generic "unknown origin" one otherwise. `fieldName`/`className` are
// re-derived from `node`/`staticCls` here rather than threaded as their own
// params, to keep this function's own param count at the ceiling.
fn relationAutoErrReportRead(
  c: Checker,
  node: int,
  staticCls: RelationAutoClass,
  flow: RelationAutoFlow,
  ctx: RelationAutoErrCtx,
) {
  let fieldName = identText(c.tree, c.source, kidsOf(c.tree, node)[1])
  let className = relationAutoClassName(staticCls)
  if (flow.found && flow.paramName != "" && ctx.fd != 0) {
    let (known, ok) = ctx.calledSet["${c.moduleId}:${ctx.fd}"]
    if (ok && known) {
      return // this function has a known caller somewhere in the project
    }
    let funcName = identText(c.tree, c.source, kidsOf(c.tree, ctx.fd)[1])
    relationAutoReportUnprovable(
      c, node, fieldName, className, relationAutoNoCallerHint(flow.paramName, funcName, fieldName),
    )
    return
  }
  relationAutoReportUnprovable(
    c,
    node,
    fieldName,
    className,
    relationAutoUnknownOriginHint(fieldName),
  )
}

// `node` is `Tag.Member = [recv, nameIdent]`. Classifies by the receiver's
// STATIC type (never by `flow`, this file's own header) and reports unless
// an earlier assignment or a provable `flow` already proves the read safe.
fn relationAutoErrCheckRead(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  let recv = k[0]
  let nameIdx = k[1]
  if (recv == 0 || nameIdx == 0) {
    return
  }
  let staticCls = relationAutoClassFromStructType(c, checkExprType(c, recv))
  if (!staticCls.found) {
    return
  }
  let fieldName = identText(c.tree, c.source, nameIdx)
  if (!lintFieldIsRelation(staticCls.oc.tree, staticCls.oc.source, staticCls.decl, fieldName)) {
    return
  }
  if (relationAutoErrLoadedByAssignment(c, recv, fieldName, node, ctx.errSt.loaded)) {
    return
  }
  let flow = relationAutoResolve(c, recv, ctx.st)
  if (flow.found && flow.queryCall > 0) {
    return // reaches a real query -- relationautosplice.bit already/will handle this
  }
  relationAutoErrReportRead(c, node, staticCls, flow, ctx)
}

// A simple-Ident `let` pattern bound straight to a composite literal that
// SETS one or more of its own class's relation fields — gap 1's own
// composite-literal half. `stripped` is already past any trailing `?`.
fn relationAutoErrCollectLiteralLoaded(
  c: Checker, varName: string, stripped: int, afterOffset: int, errSt: RelationAutoErrState,
) {
  if (getNode(c.tree, stripped).tag != Tag.CompositeLit) {
    return
  }
  let k = kidsOf(c.tree, stripped)
  if (len(k) < 2 || k[1] == 0 || getNode(c.tree, k[1]).tag != Tag.FieldInits) {
    return
  }
  let cls = relationAutoClassFromStructType(c, checkExprType(c, stripped))
  if (!cls.found) {
    return
  }
  for f of kidsOf(c.tree, k[1]) {
    let fk = kidsOf(c.tree, f)
    if (len(fk) < 1 || fk[0] == 0) {
      continue
    }
    let fieldName = identText(c.tree, c.source, fk[0])
    if (!lintFieldIsRelation(cls.oc.tree, cls.oc.source, cls.decl, fieldName)) {
      continue
    }
    errSt.loaded = append(
      errSt.loaded,
      RelationAutoErrLoaded{ varName = varName, fieldName = fieldName, afterOffset = afterOffset },
    )
  }
}

// Mirrors `relationAutoWalkLet` (relationauto.bit) exactly for the binding
// side, plus gap 1's own composite-literal field-init tracking.
fn relationAutoErrWalkLet(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  for b of kidsOf(c.tree, node) {
    let bk = kidsOf(c.tree, b)
    let pattern = bk[0]
    let init = bk[2]
    if (init != 0) {
      relationAutoErrWalk(c, init, ctx)
    }
    if (pattern == 0 || init == 0 || getNode(c.tree, pattern).tag != Tag.Ident) {
      continue
    }
    let varName = identText(c.tree, c.source, pattern)
    let letEnd = getNode(c.tree, node).span.end
    relationAutoErrCollectLiteralLoaded(
      c,
      varName,
      relationAutoStripTry(c, init),
      letEnd,
      ctx.errSt,
    )
    let flow = relationAutoResolve(c, init, ctx.st)
    if (!flow.found) {
      continue
    }
    ctx.st.bindings = append(
      ctx.st.bindings,
      RelationAutoBinding{
        varName = varName, cls = flow.cls, queryCall = flow.queryCall,
        paramName = flow.paramName, isSlice = flow.isSlice,
        afterOffset = letEnd, ownerModule = flow.ownerModule, path = flow.path,
      },
    )
  }
}

// Mirrors `relationAutoWalkForOf` (relationauto.bit) exactly.
fn relationAutoErrWalkForOf(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  relationAutoErrWalk(c, k[1], ctx)
  let flow = relationAutoResolve(c, k[1], ctx.st)
  let pushed = k[0] != 0 && getNode(c.tree, k[0]).tag == Tag.Ident && flow.found && flow.isSlice
  if (pushed) {
    ctx.st.bindings = append(
      ctx.st.bindings,
      RelationAutoBinding{
        varName = identText(c.tree, c.source, k[0]), cls = flow.cls, queryCall = flow.queryCall,
        paramName = flow.paramName, isSlice = false, afterOffset = getNode(c.tree, k[0]).span.start,
        ownerModule = flow.ownerModule, path = flow.path,
      },
    )
  }
  relationAutoErrWalk(c, k[2], ctx)
  if (pushed) {
    ctx.st.bindings = ctx.st.bindings[0:len(ctx.st.bindings) - 1]
  }
}

// An assignment TARGET is never itself checked as a read (it is being
// WRITTEN) — only its own receiver, if it has one (`arr[i].f = v` still
// reads `arr[i]`; `x.a.b = v` still reads `x.a`, the value `.b` is written
// through).
fn relationAutoErrWalkAssignTarget(c: Checker, t: int, ctx: RelationAutoErrCtx) {
  if (t == 0) {
    return
  }
  if (getNode(c.tree, t).tag == Tag.Member) {
    relationAutoErrWalk(c, kidsOf(c.tree, t)[0], ctx)
    return
  }
  relationAutoErrWalk(c, t, ctx)
}

// The plain-`=` half of `relationAutoErrWalkAssign`, split out to keep that
// function's own complexity under the ceiling: records `recv.fieldName` as
// loaded for every `Tag.Member` target in `targets`.
fn relationAutoErrMarkAssignTargetsLoaded(
  c: Checker,
  targets: []int,
  afterOffset: int,
  ctx: RelationAutoErrCtx,
) {
  for t of targets {
    if (t == 0 || getNode(c.tree, t).tag != Tag.Member) {
      continue
    }
    let mk = kidsOf(c.tree, t)
    let recv = mk[0]
    let nameIdx = mk[1]
    if (recv == 0 || nameIdx == 0 || getNode(c.tree, recv).tag != Tag.Ident) {
      continue
    }
    ctx.errSt.loaded = append(
      ctx.errSt.loaded,
      RelationAutoErrLoaded{
        varName = identText(c.tree, c.source, recv), fieldName = identText(
          c.tree,
          c.source,
          nameIdx,
        ),
        afterOffset = afterOffset,
      },
    )
  }
}

// `x.f = ...` — gap 1's own assignment half. Only a plain `=` marks `f`
// loaded on `x` (a compound `+=` reads before it writes, so it is checked
// like any other read via the target-recursion above, never marked loaded).
fn relationAutoErrWalkAssign(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  let k = kidsOf(c.tree, node)
  let targets = kidsOf(c.tree, k[0])
  for t of targets {
    relationAutoErrWalkAssignTarget(c, t, ctx)
  }
  for v of kidsOf(c.tree, k[1]) {
    relationAutoErrWalk(c, v, ctx)
  }
  if (getNode(c.tree, node).main != int(Kind.Eq)) {
    return
  }
  relationAutoErrMarkAssignTargetsLoaded(c, targets, getNode(c.tree, node).span.end, ctx)
}

// The generic recursive walk — mirrors `relationAutoWalk`'s own shape
// (relationauto.bit) exactly, substituting `relationAutoErrCheckRead` for
// `relationAutoCheckMemberRead` and adding `Tag.Assign` handling (gap 1).
// `lintIsNestedFuncBoundary` stops descent into a closure/nested `FuncDecl`
// for the identical reason `relationAutoWalk` stops there — it is visited
// as its own separate entry, `relationAutoCheckErrors`'s own loop below.
fn relationAutoErrWalk(c: Checker, node: int, ctx: RelationAutoErrCtx) {
  if (node == 0) {
    return
  }
  let tag = getNode(c.tree, node).tag
  if (lintIsNestedFuncBoundary(tag)) {
    return
  }
  if (tag == Tag.Block) {
    let save = len(ctx.st.bindings)
    for k of kidsOf(c.tree, node) {
      relationAutoErrWalk(c, k, ctx)
    }
    ctx.st.bindings = ctx.st.bindings[0:save]
    return
  }
  if (tag == Tag.LetDecl) {
    relationAutoErrWalkLet(c, node, ctx)
    return
  }
  if (tag == Tag.ForOf) {
    relationAutoErrWalkForOf(c, node, ctx)
    return
  }
  if (tag == Tag.Assign) {
    relationAutoErrWalkAssign(c, node, ctx)
    return
  }
  if (tag == Tag.Member) {
    relationAutoErrCheckRead(c, node, ctx)
  }
  for k of kidsOf(c.tree, node) {
    relationAutoErrWalk(c, k, ctx)
  }
}

// One function's own fresh walk — mirrors `relationAutoWalkOneFunc`'s own
// seeding exactly (relationautocalls.bit), so a named function's own
// parameters resolve identically for provability here as they do for
// splicing there.
fn relationAutoErrCheckOneFunc(
  c: Checker,
  fd: int,
  sums: RelationAutoFuncSummaries,
  calledSet: map<string, bool>,
) {
  let (idx, hasIdx) = sums.declToIndex["${c.moduleId}:${fd}"]
  let bindings = []RelationAutoBinding(0)
  let namedFd = 0
  if (hasIdx) {
    bindings = relationAutoSeedParamBindings(c, sums.list[idx].params)
    namedFd = fd
  }
  let st = RelationAutoState{
    bindings = bindings, summaries = sums, paramReads = map<string, []string>{}, returnSeen = false,
    returnCandidate = relationAutoNoFlow(c),
  }
  let ctx = RelationAutoErrCtx{
    st = st, errSt = RelationAutoErrState{ loaded = []RelationAutoErrLoaded(0) }, fd = namedFd, calledSet = calledSet,
  }
  relationAutoErrWalk(c, lintFuncInfo(c.tree, fd).body, ctx)
}

// Entry point — called once from `relationAutoAnalyzeProject`
// (relationauto.bit), after the whole-project fixed point (R2b,
// relationautocalls.bit) has converged.
fn relationAutoCheckErrors(mods: []Checker, sums: RelationAutoFuncSummaries) {
  let calledSet = relationAutoBuildCalledSet(mods)
  for c of mods {
    for fd of lintCollectFuncs(c.tree, c.tree.root, []int(0)) {
      relationAutoErrCheckOneFunc(c, fd, sums, calledSet)
    }
  }
}
