// Parser: `import` declarations. Split out of parsertype.bit (#6396) when the
// generic-bound grammar pushed it past the 800-line ceiling; sibling .bit files
// are the same module, so this is a pure move.

fn parseImportItem(p: Parser): int {
  let name = expectIdent(p)
  let alias = 0
  if (acceptTok(p, Kind.KwAs)) {
    alias = expectIdent(p)
  }
  return mkNode(p, Tag.ImportItem, 0, [name, alias])
}

fn parseImportBody(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Ident) {
    return mkNode(p, Tag.ImportNs, 0, [leaf(p, Tag.Ident)])
  }
  if (k == Kind.Star) {
    advance(p)
    expectMsg(p, Kind.KwAs, "'as'")
    return mkNode(p, Tag.ImportStar, 0, [expectIdent(p)])
  }
  // `{ a, b as c }`
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  while (!atListClose(p, Kind.RBrace)) {
    items = append(items, parseImportItem(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.ImportGroup, 0, items, lbStart, rbEnd)
}

fn parseImportDecl(p: Parser): int {
  advance(p)
  let body = parseImportBody(p)
  expectFromKeyword(p)
  let path = 0
  if (peekKind(p) == Kind.StringLit) {
    path = leaf(p, Tag.StringLit)
  } else {
    parseFail(p, "a string literal")
  }
  return mkNode(p, Tag.ImportDecl, 0, [body, path])
}
