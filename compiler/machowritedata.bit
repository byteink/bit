fn machoWriteSection(
  out: ByteBuf,
  sec: MachoSection,
  alignment: int,
  addr: int,
  nreloc: int,
): MachoSecHdr {
  let fileOff = 0
  if (!machoIsZerofill(sec.kind)) {
    padTo(out, alignment)
    fileOff = len(out.bytes)
    appendBytes(out, sec.data)
  }
  return MachoSecHdr{
    kind = sec.kind, addr = addr,
    size = machoSectionBytes(sec), offset = fileOff, align = log2Int(alignment),
    reloff = 0, nreloc = nreloc,
  }
}

fn machoWriteRelocs(
  target: MachoTarget,
  out: ByteBuf,
  present: []MachoSectionKind,
  relocBuckets: []MachoRelocList,
  indexes: ([]MachoSecHdr, map<string, int>),
) {
  let (hdrs, symIdxOf) = indexes
  // Relocations, one contiguous run per section, in canonical order.
  padTo(out, 4)
  let i = 0
  while (i < len(present)) {
    let idx = machoKindIndex(present[i])
    let rl = relocBuckets[idx].list
    if (len(rl) > 0) {
      hdrs[i].reloff = len(out.bytes)
      let j = 0
      while (j < len(rl)) {
        let r = rl[j]
        appendU32(out, r.offset)
        // r_extern is always true: every relocation here targets a symtab entry,
        // local or not.
        appendU32(
          out,
          machoRelocInfo(
            symIdxOf[r.symbol], machoRelocPcrel(r.kind),
            machoRelocLength(r.kind), true, machoRelocType(r.kind, target),
          ),
        )
        j = j + 1
      }
    }
    i = i + 1
  }

}

fn machoWriteSymbols(
  out: ByteBuf,
  obj: MachoObject,
  nameOffs: []int,
  ordinalOf: []int,
  addrOf: []int,
) {
  let i = 0
  while (i < len(obj.symbols)) {
    let sym = obj.symbols[i]
    let ntype = nUndf()
    let nsect = 0
    let nvalue = 0
    if (sym.hasSection) {
      let idx = machoKindIndex(sym.section)
      ntype = nSect()
      nsect = ordinalOf[idx]
      nvalue = addrOf[idx] + sym.offset
    }
    if (sym.binding == MachoBinding.Global) {
      ntype = ntype | nExt()
    }
    appendU32(out, nameOffs[i])
    out.bytes = append(out.bytes, u8(ntype))
    out.bytes = append(out.bytes, u8(nsect))
    appendU16(out, 0) // n_desc
    appendU64(out, nvalue)
    i = i + 1
  }

}
