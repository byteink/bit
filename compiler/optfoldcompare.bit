// foldCompare's float/signed/unsigned arms, split out of optfold.bit (#5682):
// that file was 815 of the 800-line E0200 ceiling once foldCompare itself
// was split for E0201. A pure move: same module (same-directory .bit files
// share scope, so no import needed), nothing here depends on anything but
// ConstVal/Op and optfold.bit's own noConst/boolConst/signExtend/maskTo.

// The float-compare arm of foldCompare, split out for E0201. A pure move: same
// six comparisons, same operands.
fn foldCompareFloat(op: Op, lhs: ConstVal, rhs: ConstVal): ConstVal {
  if (op == Op.FCmpEq) {
    return boolConst(lhs.fval == rhs.fval)
  }
  if (op == Op.FCmpNe) {
    return boolConst(lhs.fval != rhs.fval)
  }
  if (op == Op.FCmpLt) {
    return boolConst(lhs.fval < rhs.fval)
  }
  if (op == Op.FCmpLe) {
    return boolConst(lhs.fval <= rhs.fval)
  }
  if (op == Op.FCmpGt) {
    return boolConst(lhs.fval > rhs.fval)
  }
  if (op == Op.FCmpGe) {
    return boolConst(lhs.fval >= rhs.fval)
  }
  return noConst()
}

// The signed-int-compare arm of foldCompare, split out for E0201. A pure
// move: same sign-extension, same six comparisons, same operands.
fn foldCompareSigned(op: Op, bits: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let a = signExtend(lhs.ival, bits)
  let b = signExtend(rhs.ival, bits)
  if (op == Op.ICmpEq) {
    return boolConst(a == b)
  }
  if (op == Op.ICmpNe) {
    return boolConst(a != b)
  }
  if (op == Op.ICmpSlt) {
    return boolConst(a < b)
  }
  if (op == Op.ICmpSle) {
    return boolConst(a <= b)
  }
  if (op == Op.ICmpSgt) {
    return boolConst(a > b)
  }
  if (op == Op.ICmpSge) {
    return boolConst(a >= b)
  }
  return noConst()
}

// The unsigned-int-compare arm of foldCompare, split out for E0201. A pure
// move: same masking, same six comparisons, same operands.
fn foldCompareUnsigned(op: Op, bits: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let a = u64(maskTo(lhs.ival, bits))
  let b = u64(maskTo(rhs.ival, bits))
  if (op == Op.ICmpEq) {
    return boolConst(a == b)
  }
  if (op == Op.ICmpNe) {
    return boolConst(a != b)
  }
  if (op == Op.ICmpUlt) {
    return boolConst(a < b)
  }
  if (op == Op.ICmpUle) {
    return boolConst(a <= b)
  }
  if (op == Op.ICmpUgt) {
    return boolConst(a > b)
  }
  if (op == Op.ICmpUge) {
    return boolConst(a >= b)
  }
  return noConst()
}
