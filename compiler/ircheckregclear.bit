// compiler/ircheckregclear.bit — selfcheck arms for regallocclear.bit's
// callee-saved register clears (#7716, #7733, #7757). A sibling of
// ircheckregalloc.bit, same module, so `checkRegalloc` calls it directly.

// #7733. A diamond, one callee-saved register: B0 [0,2] branches to B1 [3,5]
// and B2 [6,8], both jump to B3 [9,12]. The reference v0 dies in B0 and the
// call at 2 zeroes its register.
fn diamondEdges(): []CfgEdge {
  return [
    CfgEdge{ src = 0, dst = 1, srcStart = 0, srcLast = 2, dstStart = 3 },
    CfgEdge{ src = 0, dst = 2, srcStart = 0, srcLast = 2, dstStart = 6 },
    CfgEdge{ src = 1, dst = 3, srcStart = 3, srcLast = 5, dstStart = 9 },
    CfgEdge{ src = 2, dst = 3, srcStart = 6, srcLast = 8, dstStart = 9 },
  ]
}

fn checkRegClearsDataflow() {
  let calls = allocPoints([2, 10], []int(0))
  let v0 = mkIv(0, RegClass.Int, 0, 1, true)
  let clean = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [v0], calls, []int(0), diamondEdges())
  assert(regClearsAt(clean, 2) == 1, "#7716: the call after v0 dies zeroes its register")
  assert(
    regClearsAt(clean, 10) == 0,
    "#7733: zero on every path into B3, so its call clears nothing",
  )

  // A second reference takes the register in B2 and dies there: the path
  // through B2 reaches B3 dirty, so B3's call zeroes it again.
  let v1 = mkIv(1, RegClass.Int, 6, 7, true)
  let dirty = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [v0, v1], calls, []int(0), diamondEdges())
  assert(!locWhole(dirty, 1).isSpill && locWhole(dirty, 1).index == 0)
  assert(regClearsAt(dirty, 2) == 1)
  assert(regClearsAt(dirty, 10) == 1, "#7733: one predecessor left a dead reference behind")

  // No edges: one straight run, where a clear stands until the next occupant.
  let line = allocateCoalesced(
    mkRegsCs(1, 1, 0, 0),
    [v0],
    allocPoints([2, 4], []int(0)),
    []int(0),
    noEdges(),
  )
  assert(regClearsAt(line, 2) == 1 && regClearsAt(line, 4) == 0)
  checkRegClearsHoist()
}

// #7757. B0 [0,3] branches to B1 [4,6] and B2 [7,9], and B1 jumps to B2: the
// shape `if (c) { call() }; call()`, with the calls at 5 and 8.
fn hoistEdges(): []CfgEdge {
  return [
    CfgEdge{ src = 0, dst = 1, srcStart = 0, srcLast = 3, dstStart = 4 },
    CfgEdge{ src = 0, dst = 2, srcStart = 0, srcLast = 3, dstStart = 7 },
    CfgEdge{ src = 1, dst = 2, srcStart = 4, srcLast = 6, dstStart = 7 },
  ]
}

fn checkRegClearsHoist() {
  let calls = allocPoints([5, 8], []int(0))
  let early = mkIv(0, RegClass.Int, 0, 1, true)
  let one = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [early], calls, []int(0), hoistEdges())
  assert(
    regClearsAt(one, 3) == 1,
    "#7757: both arms reach a call needing it, so the branch zeroes it",
  )
  assert(regClearsAt(one, 5) == 0 && regClearsAt(one, 8) == 0, "#7757: zero on every path in")

  // The reference dies at the instruction before the branch, which arm64 may
  // fuse into it as a CBZ reading that register: each call zeroes it instead.
  let late = mkIv(0, RegClass.Int, 0, 2, true)
  let kept = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [late], calls, []int(0), hoistEdges())
  assert(
    regClearsAt(kept, 3) == 0,
    "#7757: a branch clear never zeroes what the compare before it read",
  )
  assert(regClearsAt(kept, 5) == 1 && regClearsAt(kept, 8) == 1)
  checkRegClearsHoistPerBranch()
}

// #7763. `hoistEdges` extended: B2 [7,9] branches to B3 [10,12] and B4
// [13,16]; B3 jumps to B6 [20,22]; B4 branches to B5 [17,19] and B6; B5 jumps
// to B6. References die in B0, B3 and B4, so B6's call at 21 has a third
// predecessor, B3, that arrives dirty.
fn joinEdges(): []CfgEdge {
  return [
    CfgEdge{ src = 0, dst = 1, srcStart = 0, srcLast = 3, dstStart = 4 },
    CfgEdge{ src = 0, dst = 2, srcStart = 0, srcLast = 3, dstStart = 7 },
    CfgEdge{ src = 1, dst = 2, srcStart = 4, srcLast = 6, dstStart = 7 },
    CfgEdge{ src = 2, dst = 3, srcStart = 7, srcLast = 9, dstStart = 10 },
    CfgEdge{ src = 2, dst = 4, srcStart = 7, srcLast = 9, dstStart = 13 },
    CfgEdge{ src = 3, dst = 6, srcStart = 10, srcLast = 12, dstStart = 20 },
    CfgEdge{ src = 4, dst = 5, srcStart = 13, srcLast = 16, dstStart = 17 },
    CfgEdge{ src = 4, dst = 6, srcStart = 13, srcLast = 16, dstStart = 20 },
    CfgEdge{ src = 5, dst = 6, srcStart = 17, srcLast = 19, dstStart = 20 },
  ]
}

fn checkRegClearsHoistPerBranch() {
  let ivs = [
    mkIv(0, RegClass.Int, 0, 1, true),
    mkIv(1, RegClass.Int, 10, 11, true),
    mkIv(2, RegClass.Int, 13, 14, true),
  ]
  // The branch at 16 hoists a clear that silences nothing: B6's call still
  // zeroes it for B3. Kept with the branch at 3, the function has as many
  // clears as with neither, so a per-function verdict dropped both.
  let two = allocateCoalesced(
    mkRegsCs(1, 1, 0, 0),
    ivs,
    allocPoints([5, 8, 21], []int(0)),
    []int(0),
    joinEdges(),
  )
  assert(regClearsAt(two, 3) == 1, "#7763: the hoist that silences both calls after it stays")
  assert(regClearsAt(two, 5) == 0 && regClearsAt(two, 8) == 0)
  assert(regClearsAt(two, 16) == 0, "#7763: a hoist the dirty join undoes is dropped")
  assert(regClearsAt(two, 21) == 1)

  // A call in B5 too: the hoist at 16 silences that one alone, no fewer
  // clears in all, and one more on the path from B4 straight to B6.
  let three = allocateCoalesced(
    mkRegsCs(1, 1, 0, 0),
    ivs,
    allocPoints([5, 8, 18, 21], []int(0)),
    []int(0),
    joinEdges(),
  )
  assert(regClearsAt(three, 3) == 1)
  assert(regClearsAt(three, 16) == 0, "#7763: a hoist silencing one clear is dropped")
  assert(regClearsAt(three, 18) == 1 && regClearsAt(three, 21) == 1)
}
