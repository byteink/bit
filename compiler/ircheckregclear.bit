// compiler/ircheckregclear.bit — selfcheck arms for regallocclear.bit's
// callee-saved register clears (#7716, #7733). A sibling of
// ircheckregalloc.bit, same module, so `checkRegalloc` calls it directly.

// #7733. A diamond, one callee-saved register: B0 [0,2] branches to B1 [3,5]
// and B2 [6,8], both jump to B3 [9,12]. The reference v0 dies in B0 and the
// call at 2 zeroes its register.
fn diamondEdges(): []CfgEdge {
  return [
    CfgEdge{ src = 0, dst = 1, srcStart = 0, srcLast = 2, dstStart = 3 },
    CfgEdge{ src = 0, dst = 2, srcStart = 0, srcLast = 2, dstStart = 6 },
    CfgEdge{ src = 1, dst = 3, srcStart = 3, srcLast = 5, dstStart = 9 },
    CfgEdge{ src = 2, dst = 3, srcStart = 6, srcLast = 8, dstStart = 9 },
  ]
}

fn checkRegClearsDataflow() {
  let calls = allocPoints([2, 10], []int(0))
  let v0 = mkIv(0, RegClass.Int, 0, 1, true)
  let clean = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [v0], calls, []int(0), diamondEdges())
  assert(regClearsAt(clean, 2) == 1, "#7716: the call after v0 dies zeroes its register")
  assert(
    regClearsAt(clean, 10) == 0,
    "#7733: zero on every path into B3, so its call clears nothing",
  )

  // A second reference takes the register in B2 and dies there: the path
  // through B2 reaches B3 dirty, so B3's call zeroes it again.
  let v1 = mkIv(1, RegClass.Int, 6, 7, true)
  let dirty = allocateCoalesced(mkRegsCs(1, 1, 0, 0), [v0, v1], calls, []int(0), diamondEdges())
  assert(!locWhole(dirty, 1).isSpill && locWhole(dirty, 1).index == 0)
  assert(regClearsAt(dirty, 2) == 1)
  assert(regClearsAt(dirty, 10) == 1, "#7733: one predecessor left a dead reference behind")

  // No edges: one straight run, where a clear stands until the next occupant.
  let line = allocateCoalesced(
    mkRegsCs(1, 1, 0, 0),
    [v0],
    allocPoints([2, 4], []int(0)),
    []int(0),
    noEdges(),
  )
  assert(regClearsAt(line, 2) == 1 && regClearsAt(line, 4) == 0)
}
