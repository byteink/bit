// Parser: types, generic params, function params, and type declarations
// (class/enum/interface/alias/import). Split out of parser.bit (#1503);
// sibling .bit files are the same module, so this is a pure move.

// ---- types, params, statements, declarations -------------------------------

// Closes a generic list, splitting the `>` hiding at the front of `>>`/`>>=`/
// `>=` by rewriting the current token in place to the remainder (mirrors the
// seed's expectGenericClose; slice element writes make this possible).
fn expectGenericClose(p: Parser) {
  let k = peekKind(p)
  if (k == Kind.Shr || k == Kind.ShrEq || k == Kind.GtEq) {
    let t = peekTok(p)
    let rest = Kind.Gt
    if (k == Kind.ShrEq) { rest = Kind.GtEq }
    if (k == Kind.GtEq) { rest = Kind.Eq }
    // Journal the pre-split token so a speculative caller can un-split (see
    // `undoSplits`); the seed gets this free by rewinding its lexer.
    p.splits = append(p.splits, Split{ pos: p.pos, tok: t })
    p.toks[p.pos] = Token{ kind: rest, start: t.start + 1, end: t.end }
    return
  }
  expect(p, Kind.Gt)
}

// The end offset the `>` that `expectGenericClose` is about to consume will
// occupy. Call it BEFORE the close: a `>>`/`>>=`/`>=` is split in place, so the
// consumed `>` is only the token's first byte.
fn genericCloseEnd(p: Parser): int {
  let t = peekTok(p)
  let k = t.kind
  if (k == Kind.Shr || k == Kind.ShrEq || k == Kind.GtEq) { return t.start + 1 }
  return t.end
}

// The type constructors below are all `mkNode`-spans-only-kids cases: the
// leading `*`/`[`/`map`/`chan` (and the `>` closing a generic) is not a kid, so
// a diagnostic anchored on one of these types would point past its own opening
// token. The seed joins from the leading token.

// The raw untraced pointer `*T` (§11.4).
fn parsePtrType(p: Parser): int {
  let star = peekTok(p)
  expect(p, Kind.Star)
  let elem = parseType(p)
  return addNode(p.tree, Tag.PtrType,
    Span{ file: p.file, start: star.start, end: getNode(p.tree, elem).span.end }, 0, [elem])
}

fn parseSliceOrArrayType(p: Parser): int {
  let lb = peekTok(p)
  expect(p, Kind.LBracket)
  if (acceptTok(p, Kind.RBracket)) {
    let elem = parseType(p)
    return addNode(p.tree, Tag.SliceType,
      Span{ file: p.file, start: lb.start, end: getNode(p.tree, elem).span.end }, 0, [elem])
  }
  // THE SIZE IS A CONSTANT EXPRESSION, NOT A LITERAL TOKEN (#1903). SPEC §12's
  // prose always promised "fixed length N (a compile-time constant)" while the
  // grammar said `"[" INT_LIT "]" type`, and this parser was faithful to the
  // grammar — so `[rows]i64` and `[rows * cols]i64` did not parse and the prose
  // described a language nobody had.
  //
  // Parsing the expression here does NOT make the size dynamic: `checkArraySize`
  // folds it to an integer at type-construction time and rejects anything it
  // cannot fold, so a non-constant is a diagnostic rather than a runtime length.
  // The whole point of an array is that its layout is known at compile time.
  //
  // Only the TYPE position is widened. The expression-position spelling
  // (`[N]T{...}`, parserexpr.bit's parseSliceOrArrayTypePrimary) still requires
  // a literal, because there `[x]` is genuinely ambiguous with a one-element
  // slice literal and the shape lookahead is what resolves it.
  let size = parseExpr(p)
  expect(p, Kind.RBracket)
  let elem = parseType(p)
  return addNode(p.tree, Tag.ArrayType,
    Span{ file: p.file, start: lb.start, end: getNode(p.tree, elem).span.end }, 0, [size, elem])
}

fn parseMapType(p: Parser): int {
  let kw = peekTok(p)
  advance(p)
  expect(p, Kind.Lt)
  let key = parseType(p)
  expect(p, Kind.Comma)
  let val = parseType(p)
  let end = genericCloseEnd(p)
  expectGenericClose(p)
  return addNode(p.tree, Tag.MapType,
    Span{ file: p.file, start: kw.start, end: end }, 0, [key, val])
}

fn parseChanType(p: Parser): int {
  let kw = peekTok(p)
  advance(p)
  expect(p, Kind.Lt)
  let elem = parseType(p)
  let end = genericCloseEnd(p)
  expectGenericClose(p)
  return addNode(p.tree, Tag.ChanType,
    Span{ file: p.file, start: kw.start, end: end }, 0, [elem])
}

// A type (§11): a name (optionally a `T<A, B>` generic instantiation), a slice/
// array `[]T`/`[N]T`, `map<K,V>`, or `chan<T>`. Tuple/function types are
// follow-ups.
fn parseType(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Ident) {
    let name = leaf(p, Tag.Ident)
    // A namespace-qualified type name (`io.Writer`, §11, #2118): the module's
    // import bindings resolve `ns` the same way they resolve it in expression
    // position (`io.stdout()`), so this is the one extra token the type
    // grammar needed — no generic instantiation of a qualified name (`Foo<T>`
    // is the only follow-on production, deliberately out of scope here).
    if (peekKind(p) == Kind.Dot) {
      advance(p)
      let member = expectIdent(p)
      return mkNode(p, Tag.QualType, 0, [name, member])
    }
    if (peekKind(p) != Kind.Lt) {
      return name
    }
    advance(p)
    let items = []int(0)
    while (!atListClose(p, Kind.Gt)) {
      items = append(items, parseType(p))
      if (!acceptTok(p, Kind.Comma)) {
        break
      }
    }
    let targs = mkNode(p, Tag.TypeArgs, 0, items)
    // The closing `>` is a token, not a kid, so mkNode's kid-derived span would
    // stop one byte short and underline `Box<i64, i64` — the same capture the
    // chan/map/array type parsers above already do. Visible only once something
    // reports ON this node: E0058 generic arity underlines the whole reference.
    let end = genericCloseEnd(p)
    expectGenericClose(p)
    return addNode(p.tree, Tag.GenericInst,
      Span{ file: p.file, start: getNode(p.tree, name).span.start, end: end }, 0, [name, targs])
  }
  if (k == Kind.Star) { return parsePtrType(p) }
  if (k == Kind.LBracket) { return parseSliceOrArrayType(p) }
  if (k == Kind.KwMap) { return parseMapType(p) }
  if (k == Kind.KwChan) { return parseChanType(p) }
  if (k == Kind.LParen) { return parseParenType(p) }
  // Not a type. Report and yield `none` like the seed rather than manufacturing
  // an Ident leaf: that silently CONSUMED whatever token was there (swallowing a
  // `}` or the EOF sentinel) and cost the caller its own diagnostic.
  parseFail(p, "a type")
  return 0
}

// `(...)` in type position: `() => R` / `(P, Q) => R` function types
// (func_type `[type_list, result]`), `()` unit (void_type), a transparent
// parenthesized `(T)`, or a `(T, U)` tuple type.
fn parseParenType(p: Parser): int {
  expect(p, Kind.LParen)
  if (acceptTok(p, Kind.RParen)) {
    if (!acceptTok(p, Kind.FatArrow)) {
      return mkNode(p, Tag.VoidType, 0, []int(0))
    }
    let result = parseResultType(p)
    let list = mkNode(p, Tag.TypeList, 0, []int(0))
    return mkNode(p, Tag.FuncType, 0, [list, result])
  }
  let items = []int(0)
  items = append(items, parseType(p))
  while (acceptTok(p, Kind.Comma)) {
    if (peekKind(p) == Kind.RParen) {
      break
    }
    items = append(items, parseType(p))
  }
  expect(p, Kind.RParen)
  if (acceptTok(p, Kind.FatArrow)) {
    let result = parseResultType(p)
    let list = mkNode(p, Tag.TypeList, 0, items)
    return mkNode(p, Tag.FuncType, 0, [list, result])
  }
  if (len(items) == 1) {
    return items[0]
  }
  return mkNode(p, Tag.TupleType, 0, items)
}

// `T!` / `T!E` fallible result, else a plain type.
fn parseResultType(p: Parser): int {
  let ty = parseType(p)
  if (!acceptTok(p, Kind.Bang)) {
    return ty
  }
  let err = 0
  let k = peekKind(p)
  if (k == Kind.Ident || k == Kind.LBracket || k == Kind.KwMap || k == Kind.KwChan) {
    err = parseType(p)
  }
  return mkNode(p, Tag.Fallible, 0, [ty, err])
}

// `constraint = type_name { "&" type_name }`.
fn parseConstraint(p: Parser): int {
  let items = []int(0)
  items = append(items, expectIdent(p))
  while (acceptTok(p, Kind.Amp)) {
    items = append(items, expectIdent(p))
  }
  return mkNode(p, Tag.Constraint, 0, items)
}

fn parseGenericParam(p: Parser): int {
  let name = expectIdent(p)
  let constraint = 0
  if (acceptTok(p, Kind.Colon)) {
    constraint = parseConstraint(p)
  }
  return mkNode(p, Tag.GenericParam, 0, [name, constraint])
}

// Optional `<T, U: Bound>` after a type/function name; `0` (none) when absent.
fn maybeGenericParams(p: Parser): int {
  if (peekKind(p) != Kind.Lt) {
    return 0
  }
  advance(p)
  let items = []int(0)
  while (!atListClose(p, Kind.Gt)) {
    items = append(items, parseGenericParam(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.Gt)
  return mkNode(p, Tag.GenericParams, 0, items)
}

// Concatenates a receiver's type params with the method's own
// (`function (s: Stack<T>) mapped<U>()`), receiver params first so the checker
// can zip them against the class's declared params by position. Either side
// may be absent (0).
fn mergeGenericParams(p: Parser, a: int, b: int): int {
  if (a == 0) {
    return b
  }
  if (b == 0) {
    return a
  }
  let items = []int(0)
  let ak = kidsOf(p.tree, a)
  let i = 0
  while (i < len(ak)) {
    items = append(items, ak[i])
    i = i + 1
  }
  let bk = kidsOf(p.tree, b)
  let j = 0
  while (j < len(bk)) {
    items = append(items, bk[j])
    j = j + 1
  }
  return mkNode(p, Tag.GenericParams, 0, items)
}

fn parseParam(p: Parser): int {
  // `...name: T` is a variadic parameter (§10.3). The `...` is a token, not a
  // kid, so mkNode's kid-derived span would start at the name and drop it —
  // capture the start here, as the seed's `join(start, span(ty))` does.
  let start = peekTok(p).start
  let isRest = acceptTok(p, Kind.Ellipsis)
  let name = expectIdent(p)
  expect(p, Kind.Colon)
  let ty = parseType(p)
  let tag = Tag.Param
  if (isRest) {
    tag = Tag.ParamRest
  }
  return addNode(p.tree, tag,
    Span{ file: p.file, start: start, end: getNode(p.tree, ty).span.end }, 0, [name, ty])
}

fn parseParams(p: Parser): int {
  expect(p, Kind.LParen)
  let items = []int(0)
  while (!atListClose(p, Kind.RParen)) {
    items = append(items, parseParam(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RParen)
  return mkNode(p, Tag.Params, 0, items)
}

// `binding = [pattern, type_or_none, init_or_none]` (simple ident pattern; a
// tuple pattern is a follow-up).
fn parseOneBinding(p: Parser): int {
  let name = parsePat(p)
  let ty = 0
  if (acceptTok(p, Kind.Colon)) {
    ty = parseType(p)
  }
  let init = 0
  if (acceptTok(p, Kind.Eq)) {
    init = parseExpr(p)
  }
  return mkNode(p, Tag.Binding, 0, [name, ty, init])
}

// `const`/`let` — one or more comma-separated bindings.
// `storage` is the §11.11 storage class: 0 = process-wide, 1 = per-thread
// (`@threadlocal let`). It rides in the node's `main` rather than as an extra
// child because a decl's children ARE its bindings, and every consumer
// iterates them expecting nothing else.
fn parseValueDecl(p: Parser, declTag: Tag, storage: int): int {
  // Spans the `let`/`const` KEYWORD through the last binding. The keyword is not
  // a child, so `mkNode` would drop it — the same shape as `spawn`/`defer` and
  // the unary operator. It surfaces as E0074 underlining `x = 1` for `let x = 1`.
  let kw = peekTok(p)
  advance(p)
  let items = []int(0)
  items = append(items, parseOneBinding(p))
  while (acceptTok(p, Kind.Comma)) {
    items = append(items, parseOneBinding(p))
  }
  return addNode(p.tree, declTag,
    Span{ file: p.file, start: kw.start, end: getNode(p.tree, items[len(items) - 1]).span.end },
    storage, items)
}

// A class field `[export] name: type` (export wraps the field node). `name`
// and `exported` are already consumed by the caller, which must also decide
// (by peeking the next token) that this member is a field and not a method.
fn parseField(p: Parser, name: int, exported: bool): int {
  expect(p, Kind.Colon)
  let ty = parseType(p)
  let node = mkNode(p, Tag.Field, 0, [name, ty])
  if (!exported) {
    return node
  }
  return mkNode(p, Tag.Export, 0, [node])
}

// A type-name reference to the enclosing class, for an in-body method's
// implicit receiver (parseMethodMember below): the bare name for a
// non-generic class, or `Name<T, U>` (reusing the class's own declared
// type-parameter names) for a generic one — exactly what a written receiver
// clause would spell out by hand (SPEC §10.4). Only the TEXT these nodes read
// matters (`paramBindType`/`typeNodeName` slice it from `p.src`), not their
// position, so reusing the class name's and each generic param's own span is
// safe even though it duplicates a node that already has another parent.
fn classTypeRef(p: Parser, className: int, classGenerics: int): int {
  let dup = addLeaf(p.tree, Tag.Ident, getNode(p.tree, className).span)
  if (classGenerics == 0) {
    return dup
  }
  let gps = kidsOf(p.tree, classGenerics)
  let targItems = []int(0)
  let gi = 0
  while (gi < len(gps)) {
    targItems = append(targItems, kidsOf(p.tree, gps[gi])[0])
    gi = gi + 1
  }
  let targs = mkNode(p, Tag.TypeArgs, 0, targItems)
  return mkNode(p, Tag.GenericInst, 0, [dup, targs])
}

// A fresh copy of the class's own generic-param list, for an in-body
// method's merged generics (parseMethodMember below). A method's generics
// node must never BE the class's own node, even when the method adds none of
// its own: checkbind.bit's `registerGenerics` mints a fresh TypeParam id
// keyed by NODE IDENTITY, once per declaration that owns a generics list, and
// `collectFuncDecl` calls it for every method. The now-retired written
// receiver form (`fn (b: Box<T>) get()`, removed by #3762) got a distinct
// node for free — its `<T>` was a separate token stream, freshly parsed at
// the method's own site. The in-body form has no such tokens to re-parse, so
// reusing `classGenerics` wholesale made the method's
// registration silently RE-mint the class's own "T", orphaning the id the
// class's fields were already bound against and leaving the method's
// declared result type — captured against the id minted moments earlier —
// absent from every instantiation's substitution env (#3765). Duplicating
// just the wrapping `GenericParam`/`GenericParams` nodes, and reusing each
// name/constraint kid (read only for their TEXT, per `classTypeRef` above),
// gives the method its own node identity while spelling the same params.
fn dupGenericParams(p: Parser, genNode: int): int {
  if (genNode == 0) {
    return 0
  }
  let gps = kidsOf(p.tree, genNode)
  let items = []int(0)
  let gi = 0
  while (gi < len(gps)) {
    items = append(items, mkNode(p, Tag.GenericParam, 0, kidsOf(p.tree, gps[gi])))
    gi = gi + 1
  }
  return mkNode(p, Tag.GenericParams, 0, items)
}

// An in-body method (SPEC §10.4): `[export] name [generic_params] (params)
// [: result] { body }`, desugared to the same func_decl/receiver shape a
// written `fn (recv: T) name()` produces (parserdecl.bit's parseFuncDecl) —
// every pass that discovers a method (the checker's collect/main sweeps,
// method-table building, lowering's Pass A3) walks the whole node arena for
// `func_decl` with a receiver; tree position never enters it, so this reuses
// all of that machinery unchanged. The one thing genuinely different is the
// receiver's own NAME kid: there is no token to give it (`this` is never
// written at the declaration site), so it is `none` (0) — the few readers
// that need the receiver's bound name (checkmodule.bit's param pre-pass, the
// resolver's rActivateReceiver, lowering's paramNames) special-case a `none`
// name kid as the literal string "this" instead of reading a span.
//
// The receiver node's span is pinned to the method's own name (not the
// reused, earlier-positioned classTypeRef) so the whole func_decl's
// automatic span (mkNode unions its kids') starts at the method, not back at
// the class header — `bit fmt`'s per-member blank-line/comment placement
// reads exactly that span.
fn parseMethodMember(p: Parser, name: int, exported: bool, className: int, classGenerics: int): int {
  let ownGenerics = maybeGenericParams(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = parseBlock(p)
  let nameSpan = getNode(p.tree, name).span
  let recv = mkSpanNode(p, Tag.Receiver, 0, [0, classTypeRef(p, className, classGenerics)],
    nameSpan.start, nameSpan.end)
  let generics = mergeGenericParams(p, dupGenericParams(p, classGenerics), ownGenerics)
  let node = mkNode(p, Tag.FuncDecl, 0, [recv, name, generics, params, result, body])
  if (!exported) {
    return node
  }
  return mkNode(p, Tag.Export, 0, [node])
}

// A class body member: a field `[export] name: type`, or an in-body method
// (SPEC §10.4). Both start with `[export] IDENT`; the token after the name
// decides which — `:` is a field, anything else (`(`, or `<` for a generic
// method) is a method, and `parseParams`/`maybeGenericParams` report their
// own "expected '('" on truly malformed input. A THIRD shape, `use Trait[,
// Trait]` (SPEC §10.7, #3369), is checked first via `atUseStmt` below.
fn parseClassMember(p: Parser, className: int, classGenerics: int): int {
  if (atUseStmt(p)) {
    return parseUseStmt(p)
  }
  // `init` (SPEC §10.4, this ticket #3371) is checked before `export`: the
  // constructor is reached through the type's own name (`T(...)`), never
  // through a member reference, so there is nothing an `export` marker
  // could change about its visibility. See parseInitMember (classinit.bit)
  // for why this is unambiguous the same way `atUseStmt` is.
  if (atInitDecl(p)) {
    return parseInitMember(p, className, classGenerics)
  }
  let exported = acceptTok(p, Kind.KwExport)
  let name = expectIdent(p)
  if (peekKind(p) == Kind.Colon) {
    return parseField(p, name, exported)
  }
  return parseMethodMember(p, name, exported, className, classGenerics)
}

// `use` (SPEC §10.7, #3369) is a CONTEXTUAL keyword, the same shape as
// `extern` (parserdecl.bit's `parseExportableDecl`): it lexes as an ordinary
// identifier and stays usable as one everywhere else. Three real fixtures in
// this corpus declare `fn use(...)` (_tests_/cases/arrow_bare_param_index.bit,
// _tests_/cases/run_generic_field_composite.bit,
// _tests_/bit/checkercases/check_qualified_type_unexported.bit), so reserving
// the word outright would break them. It is unambiguous here: a class or
// trait member's own name is always followed by `:` (a field) or `(`/`<` (a
// method) — never by a second bare identifier — so `use` followed by an
// IDENT can only be the `use` statement.
fn atUseStmt(p: Parser): bool {
  return peekKind(p) == Kind.Ident && curText(p) == "use" && peekKindAt(p, 1) == Kind.Ident
}

// `use_stmt = "use" IDENT { "," IDENT }` — one or more trait names, injected
// into the enclosing class or trait at check time (checktrait.bit). Its own
// statement, never mixed into the field list, so a reader can always see
// where the traits end and the fields begin.
fn parseUseStmt(p: Parser): int {
  let start = peekTok(p).start
  advance(p) // 'use'
  let names = []int(0)
  names = append(names, expectIdent(p))
  let guard = 0
  while (acceptTok(p, Kind.Comma) && guard < 100000) {
    names = append(names, expectIdent(p))
    guard = guard + 1
  }
  let end = spanOfKids(p, [names[len(names) - 1]]).end
  return mkSpanNode(p, Tag.UseStmt, 0, names, start, end)
}

fn parseStructDecl(p: Parser): int {
  advance(p)
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (!atListClose(p, Kind.RBrace)) {
    // These lists take `,` OR `;` OR neither, so there is no separator to break
    // on: stop instead when the item consumed nothing, which is what a truncated
    // EOF looks like after the one item the seed also parses there.
    let before = p.pos
    items = append(items, parseClassMember(p, name, generics))
    if (!acceptTok(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
    if (p.pos == before) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let fields = mkSpanNode(p, Tag.FieldList, 0, items, lbStart, rbEnd)
  return mkNode(p, Tag.StructDecl, 0, [name, generics, fields])
}

// `[export] IDENT ':'` — a field, whether or not it is exported. Checked by
// looking past an optional `export` rather than folding `export` into
// `parseTraitMember`'s own lookahead unconditionally: a trait METHOD still
// takes no `export` prefix at all (unchanged from #3369), so this predicate
// is the only place that keyword is consulted inside a trait body.
fn atTraitField(p: Parser): bool {
  if (peekKind(p) == Kind.KwExport) {
    return peekKindAt(p, 1) == Kind.Ident && peekKindAt(p, 2) == Kind.Colon
  }
  return peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.Colon
}

// A trait member (SPEC §10.7, #3369; fields #3370): a `use` statement
// composing another trait, a field (injected into the using class's layout
// and GC pointer map, exactly like one it declared itself), or a method —
// required (no body, `hurt(n: i64)`) or provided (a body,
// `dead(): bool { ... }`).
fn parseTraitMember(p: Parser): int {
  if (atUseStmt(p)) {
    return parseUseStmt(p)
  }
  if (atTraitField(p)) {
    let exported = acceptTok(p, Kind.KwExport)
    let name = expectIdent(p)
    return parseField(p, name, exported)
  }
  return parseTraitMethod(p)
}

// `trait_method = [name, params, result_or_none, body_or_none]`. The body
// kid is `none` (0) for a required method — checktrait.bit reads that
// absence to decide what a using class must supply for itself.
fn parseTraitMethod(p: Parser): int {
  let name = expectIdent(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = 0
  if (peekKind(p) == Kind.LBrace) {
    body = parseBlock(p)
  }
  return mkNode(p, Tag.TraitMethod, 0, [name, params, result, body])
}

// `trait_decl = "trait" IDENT "{" { trait_member } "}"` (SPEC §10.7). No
// generics on the trait itself (out of scope). Fields are supported (#3370)
// and injected into the using class's own layout — see checktraitfield.bit.
fn parseTraitDecl(p: Parser): int {
  advance(p) // 'trait'
  let name = expectIdent(p)
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (!atListClose(p, Kind.RBrace)) {
    let before = p.pos
    items = append(items, parseTraitMember(p))
    if (!acceptTok(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
    if (p.pos == before) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let members = mkSpanNode(p, Tag.TraitMemberList, 0, items, lbStart, rbEnd)
  return mkNode(p, Tag.TraitDecl, 0, [name, members])
}

// `V` or `V(T, U)` — a variant with an optional parenthesized payload type list.
fn parseVariant(p: Parser): int {
  let name = expectIdent(p)
  let payload = 0
  if (acceptTok(p, Kind.LParen)) {
    let tys = []int(0)
    while (!atListClose(p, Kind.RParen)) {
      tys = append(tys, parseType(p))
      if (!acceptTok(p, Kind.Comma)) {
        break
      }
    }
    expect(p, Kind.RParen)
    payload = mkNode(p, Tag.TypeList, 0, tys)
  }
  return mkNode(p, Tag.EnumVariant, 0, [name, payload])
}

fn parseEnumDecl(p: Parser): int {
  advance(p)
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (!atListClose(p, Kind.RBrace)) {
    // These lists take `,` OR `;` OR neither, so there is no separator to break
    // on: stop instead when the item consumed nothing, which is what a truncated
    // EOF looks like after the one item the seed also parses there.
    let before = p.pos
    items = append(items, parseVariant(p))
    if (!acceptTok(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
    if (p.pos == before) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let variants = mkSpanNode(p, Tag.VariantList, 0, items, lbStart, rbEnd)
  return mkNode(p, Tag.EnumDecl, 0, [name, generics, variants])
}

// `method_sig = [name, params, result_or_none]`.
fn parseMethodSig(p: Parser): int {
  let name = expectIdent(p)
  let params = parseParams(p)
  let result = 0
  if (acceptTok(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  return mkNode(p, Tag.MethodSig, 0, [name, params, result])
}

fn parseInterfaceDecl(p: Parser): int {
  advance(p)
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (!atListClose(p, Kind.RBrace)) {
    // These lists take `,` OR `;` OR neither, so there is no separator to break
    // on: stop instead when the item consumed nothing, which is what a truncated
    // EOF looks like after the one item the seed also parses there.
    let before = p.pos
    items = append(items, parseMethodSig(p))
    if (!acceptTok(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
    if (p.pos == before) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  let sigs = mkSpanNode(p, Tag.MethodSigList, 0, items, lbStart, rbEnd)
  return mkNode(p, Tag.InterfaceDecl, 0, [name, generics, sigs])
}

fn parseTypeAlias(p: Parser): int {
  advance(p)
  let name = expectIdent(p)
  let generics = maybeGenericParams(p)
  expect(p, Kind.Eq)
  let ty = parseType(p)
  return mkNode(p, Tag.TypeAlias, 0, [name, generics, ty])
}

fn parseImportItem(p: Parser): int {
  let name = expectIdent(p)
  let alias = 0
  if (acceptTok(p, Kind.KwAs)) {
    alias = expectIdent(p)
  }
  return mkNode(p, Tag.ImportItem, 0, [name, alias])
}

fn parseImportBody(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Ident) {
    return mkNode(p, Tag.ImportNs, 0, [leaf(p, Tag.Ident)])
  }
  if (k == Kind.Star) {
    advance(p)
    expectMsg(p, Kind.KwAs, "'as'")
    return mkNode(p, Tag.ImportStar, 0, [expectIdent(p)])
  }
  // `{ a, b as c }`
  let lbStart = peekTok(p).start
  expect(p, Kind.LBrace)
  let items = []int(0)
  while (!atListClose(p, Kind.RBrace)) {
    items = append(items, parseImportItem(p))
    if (!acceptTok(p, Kind.Comma)) {
      break
    }
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  return mkSpanNode(p, Tag.ImportGroup, 0, items, lbStart, rbEnd)
}

fn parseImportDecl(p: Parser): int {
  advance(p)
  let body = parseImportBody(p)
  expectMsg(p, Kind.KwFrom, "'from'")
  let path = 0
  if (peekKind(p) == Kind.StringLit) {
    path = leaf(p, Tag.StringLit)
  } else {
    parseFail(p, "a string literal")
  }
  return mkNode(p, Tag.ImportDecl, 0, [body, path])
}
