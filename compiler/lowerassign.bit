// compiler/lowerassign.bit — split out of lower.bit (#1809). Sibling of
// lower.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// The lvalue shapes a read-modify-write target (`++`/`--`/compound-assign) can
// take (SPEC §13.1's `lhs = IDENT | index | member`). Mirrors the seed's
// resolveLvalue/readLvalue/writeLvalue triple so
// `x++`, `p.n++`, `xs[0] += 1` and `m[k]++` all route through one place
// instead of three independent hand-rolled arms.
enum LvKind {
  Local,
  Global,
  Field,
  Elem,
  MapElem,
}

class Lvalue {
  kind: LvKind,
  envIdx: int,   // Local: env slot index.
  recv: int,     // Global: cell address. Field: class receiver. Elem/MapElem: collection.
  ty: int,       // Global/Field/Elem: cell/field/element type. MapElem: value type.
  offset: int,   // Global/Field: byte offset (0 for Global).
  index: int,    // Elem: index SSA value. MapElem: key SSA value.
  isSlice: bool, // Elem only: true for a slice element, false for a fixed array.
  arrayLen: int, // Elem, !isSlice only: the fixed array's compile-time length (#4270).
}

// A stub Lvalue for a failed resolution; its fields are never read because
// every caller checks fc.failed immediately after resolveLvalue.
fn invalidLvalue(): Lvalue {
  return Lvalue{
    kind = LvKind.Local,
    envIdx = -1,
    recv = 0,
    ty = 0,
    offset = 0,
    index = 0,
    isSlice = false,
    arrayLen = 0,
  }
}

// The Tag.Ident arm of resolveLvalue: a local slot, or a module-level `let`
// written through the ordinary FieldSet at offset 0 (the same lvalue shape
// `*p = x` uses).
fn resolveLvalueIdent(fc: FnCtx, node: int, n: Node): Lvalue {
  let name = fc.c.source[n.span.start:n.span.end]
  let idx = envIndex(fc, name)
  if (idx != -1) {
    return Lvalue{
      kind = LvKind.Local,
      envIdx = idx,
      recv = 0,
      ty = 0,
      offset = 0,
      index = 0,
      isSlice = false,
      arrayLen = 0,
    }
  }
  let sym = moduleGlobalSym(fc, name)
  if (sym == "") {
    fcFail(fc, n.span, "an assignment target that is neither a local nor a module-level variable")
    return invalidLvalue()
  }
  let addr = emitGlobalAddrVal(fc, sym)
  return Lvalue{
    kind = LvKind.Global,
    envIdx = -1,
    recv = addr,
    ty = nodeType(fc, node),
    offset = 0,
    index = 0,
    isSlice = false,
    arrayLen = 0,
  }
}

// The Tag.Member arm of resolveLvalue: a class field write.
fn resolveLvalueMember(fc: FnCtx, node: int, n: Node): Lvalue {
  let mk = kidsOf(fc.c.tree, node)
  let recvTy = nodeType(fc, mk[0])
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fcFail(fc, n.span, "a field assignment whose receiver is not a class")
    return invalidLvalue()
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fcFail(fc, n.span, "a field assignment on a class with no declaration in scope")
    return invalidLvalue()
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, mk[1])
  let fidx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (fidx == -1) {
    fcFail(fc, n.span, "assignment to an unknown class field")
    return invalidLvalue()
  }
  let fty = typeFromNode(oc, kidsOf(oc.tree, fields[fidx])[1])
  // Inline-array fields are copy semantics, not a scalar lvalue — matches
  // lowerFieldStore's deferral.
  if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
    fcFail(fc, n.span, "assignment to an inline-array class field")
    return invalidLvalue()
  }
  // Substituted so a generic field's declared `T` is laid out at the
  // instantiation's real argument width; must stay in step with the
  // matching field_get/field_set in lowerFieldAccess/lowerFieldStore (#1565).
  let layout = structLayout(fc, oc, decl, structTySubst(fc, oc, decl, recvTy))
  // lowerMemberReceiver: #3862's packed-`xs[i]` case (loweraccess.bit).
  let recv = lowerMemberReceiver(fc, mk[0], recvTy)
  if (fc.failed) {
    return invalidLvalue()
  }
  return Lvalue{
    kind = LvKind.Field,
    envIdx = -1,
    recv = recv,
    ty = fieldAccessType(fc, oc, fields[fidx], node),
    offset = layout.offsets[fidx],
    index = 0,
    isSlice = false,
    arrayLen = 0,
  }
}

// The Tag.Index arm of resolveLvalue: a map, slice or fixed-array element.
fn resolveLvalueIndex(fc: FnCtx, node: int, n: Node): Lvalue {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  if (rd.kind == TypeKind.Map) {
    let recv = lowerExpr(fc, k[0])
    let key = lowerExpr(fc, k[1])
    if (fc.failed) {
      return invalidLvalue()
    }
    return Lvalue{
      kind = LvKind.MapElem,
      envIdx = -1,
      recv = recv,
      ty = rd.mapVal,
      offset = 0,
      index = key,
      isSlice = false,
      arrayLen = 0,
    }
  }
  let isSlice = rd.kind == TypeKind.Slice
  // The fixed-array case is a TESTED arm, not a fallthrough (#2390) — the
  // write-side twin of the guard #2385 put in lowerIndex. `isSlice: false`
  // routes readLvalue/writeLvalue to `index_get`/`index_set`, raw word
  // addressing (`base + i*width`) over an inline block, so a receiver that is
  // not an inline block gets STORED THROUGH as if it were: measured under
  // 0.1.8, `xs[0] += 1` on a bare `T` bound to an int segfaults, on a class
  // it silently increments field `a`, and on a string it writes over the
  // string object and turns "abc" into "bc". A string has no arm here on
  // purpose — it is immutable, so `s[0] += 1` must be refused, not lowered.
  // The checker is the layer that owes a diagnostic (#2391); until it has one
  // the lowerer must not invent an answer.
  if (!isSlice && rd.kind != TypeKind.Array) {
    fcFail(
      fc,
      n.span,
      "an indexed assignment to a value that is not a slice, array or map (e.g. a string, which is immutable)",
    )
    return invalidLvalue()
  }
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  if (fc.failed) {
    return invalidLvalue()
  }
  let elemTy = defaultType(fc.c, nodeType(fc, node))
  return Lvalue{
    kind = LvKind.Elem,
    envIdx = -1,
    recv = recv,
    ty = elemTy,
    offset = 0,
    index = idx,
    isSlice = isSlice,
    // 0 for a slice (readLvalue/writeLvalue never reads it on that arm) —
    // #4270's bounds check on the fixed-array arm needs the compile-time
    // length, which only `rd` (the receiver's own type) carries.
    arrayLen = rd.arrayLen,
  }
}

// Classifies a read-modify-write target into its lvalue shape, evaluating the
// base receiver and any index/key expression exactly once so the caller's
// read and write share the same SSA values — `m[f()]++` must call `f` once,
// not twice.
fn resolveLvalue(fc: FnCtx, node: int): Lvalue {
  let n = getNode(fc.c.tree, node)
  if (n.tag == Tag.Ident) {
    return resolveLvalueIdent(fc, node, n)
  }
  if (n.tag == Tag.Member) {
    return resolveLvalueMember(fc, node, n)
  }
  if (n.tag == Tag.Index) {
    return resolveLvalueIndex(fc, node, n)
  }
  fcFail(fc, n.span, "an assignment target that is not a name, field or index expression")
  return invalidLvalue()
}

// Emits the load for a resolved lvalue.
fn readLvalue(fc: FnCtx, lv: Lvalue, span: Span): int {
  if (lv.kind == LvKind.Local) {
    return localRead(fc, lv.envIdx)
  }
  if (lv.kind == LvKind.Global || lv.kind == LvKind.Field) {
    if (isDecimalPrim(fc.c.ctx, lv.ty)) {
      return decimalCellRead(fc, lv.recv, lv.offset)
    }
    let ins = mkInstr(Op.FieldGet, lv.ty)
    ins.lhs = lv.recv
    ins.ival = lv.offset
    return builderEmit(fc.b, ins)
  }
  if (lv.kind == LvKind.Elem) {
    if (isDecimalPrim(fc.c.ctx, lv.ty)) {
      return decimalIndexGet(fc, lvalueElemTarget(lv), span)
    }
    if (lv.isSlice) {
      return emitSliceGetCall(fc, lv.recv, lv.index, lv.ty)
    }
    // #4270: `xs[i]` in `xs[i] += v` / `xs[i]++` on a fixed array is the same
    // raw `index_get` lowerIndex emits for a plain read, so it needs the same
    // bounds check (loweraccess.bit).
    emitArrayBoundsCheckIfNeeded(fc, lv.index, lv.arrayLen)
    let ins = mkInstr(Op.IndexGet, lv.ty)
    ins.lhs = lv.recv
    ins.rhs = lv.index
    return builderEmit(fc.b, ins)
  }
  // MapElem
  return emitMapGet(fc, lv.ty, lv.recv, lv.index, MapGetMiss{ panics = true, span = span })
}

// `rt_call slice_get` with its `elem_size` (ABI.md §9): `xs[i] op= v`'s read
// and `lowerIndex`'s float-index fallback. The runtime returns a packed scalar
// ZERO-extended to a word (`loadPacked`, runtime/root/slices.bit), which is
// already width-canonical for an unsigned element. A SIGNED one (`[]i16`,
// #7562) crosses the call as `i64` and a `convert` narrows it back,
// sign-extended, the register every inline read of it produces.
fn emitSliceGetCall(fc: FnCtx, recv: int, idx: int, ty: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let stride = sliceElemSizeFor(fc, ty)
  let esI = mkInstr(Op.ConstInt, i64ty)
  esI.ival = stride
  let w = widthOf(fc.c.ctx, ty)
  let narrow = stride < 8 && w.bytes == stride && w.signed
  let ins = mkInstr(Op.RtCall, narrow ? i64ty : ty)
  ins.name = "slice_get"
  ins.args = [recv, idx, builderEmit(fc.b, esI)]
  let v = emitRtCall(fc, ins)
  if (!narrow) {
    return v
  }
  let cv = mkInstr(Op.Convert, ty)
  cv.lhs = v
  return builderEmit(fc.b, cv)
}

// Emits the store for a resolved lvalue.
fn writeLvalue(fc: FnCtx, lv: Lvalue, val: int) {
  if (lv.kind == LvKind.Local) {
    localWrite(fc, lv.envIdx, val)
    return
  }
  if (lv.kind == LvKind.Global || lv.kind == LvKind.Field) {
    if (isDecimalPrim(fc.c.ctx, lv.ty)) {
      decimalCellStore(fc, lv.recv, lv.offset, val)
      return
    }
    let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    ins.lhs = lv.recv
    ins.ival = lv.offset
    ins.rhs = val
    ins.ival2 = lv.ty
    builderEmit(fc.b, ins)
    return
  }
  if (lv.kind == LvKind.Elem) {
    if (isDecimalPrim(fc.c.ctx, lv.ty)) {
      // The index passed `decimalIndexGet`'s class check on the read half.
      decimalIndexSet(fc, lvalueElemTarget(lv), val, unknownSpan())
      return
    }
    if (lv.isSlice) {
      // The write-back half of `xs[i] op= v` / `xs[i]++`. `val` is already a
      // value here, so nothing between this and the store can allocate.
      if (canInlineSliceStore(fc, lv.ty, lv.index, val)) {
        emitInlineSliceSet(fc, lv.recv, lv.index, val, lv.ty)
        return
      }
      // elem_size (ABI.md §9, #3121/#3226): see `lowerlit.bit`'s
      // `lowerSliceAlloc` for the full rationale; `sliceElemSizeFor` lives in
      // `lowerlayout.bit`.
      let esI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
      esI.ival = sliceElemSizeFor(fc, lv.ty)
      let esV = builderEmit(fc.b, esI)
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "slice_set"
      ins.args = [lv.recv, lv.index, val, esV]
      emitRtCall(fc, ins)
      return
    }
    // #4270: the write-side twin of the read-side check just above.
    emitArrayBoundsCheckIfNeeded(fc, lv.index, lv.arrayLen)
    let ins = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    ins.lhs = lv.recv
    ins.rhs = lv.index
    ins.ival = val
    ins.ival2 = lv.ty
    builderEmit(fc.b, ins)
    return
  }
  // MapElem.
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ins.name = "map_set"
  ins.args = [lv.recv, lv.index, val]
  emitRtCall(fc, ins)
}

// One resolved target of a parallel assignment (`a[i], a[j] = a[j], a[i]`):
// the lvalue with its receiver and index operands already evaluated, the type
// its right-hand side is lowered against, and whether it is the blank `_`
// (which evaluates its right side and stores nothing).
class ParTarget {
  lv: Lvalue,
  ty: int,
  blank: bool,
}

// Phase 1 of a parallel assignment for one target (SPEC §13.1): evaluate the
// operands of its index and member expressions now, once, so the stores of phase
// 3 land on the elements the operands named BEFORE any store ran. A local's slot
// and a global's address carry no operand to evaluate; the slot is written in
// phase 3 from a value phase 2 already read.
fn resolveParTarget(fc: FnCtx, node: int): ParTarget {
  if (isBlankIdent(fc, node)) {
    return ParTarget{ lv = invalidLvalue(), ty = 0, blank = true }
  }
  let lv = resolveLvalue(fc, node)
  if (fc.failed) {
    return ParTarget{ lv = lv, ty = 0, blank = false }
  }
  let ty = lv.ty
  if (lv.kind == LvKind.Local) {
    ty = fc.env[lv.envIdx].ty
  }
  return ParTarget{ lv = lv, ty = ty, blank = false }
}

// Phase 2 of a parallel assignment for one right-hand side: its value, lowered
// against its own target's type. A blank target has no type to hint, so its
// right side is evaluated for its effects alone. A concrete value stored into an
// interface-typed local is relabelled, as a single `x = v` does.
fn lowerParValue(fc: FnCtx, t: ParTarget, rhs: int): int {
  if (t.blank) {
    return lowerExpr(fc, rhs)
  }
  let v = lowerExprH(fc, rhs, t.ty)
  if (fc.failed || t.lv.kind != LvKind.Local) {
    return v
  }
  return coerceToIface(fc, v, defaultType(fc.c, nodeType(fc, rhs)), t.ty)
}

// `a, b = x, y` with as many right-hand sides as targets (SPEC §13.1, Go's
// order): first every target's index and receiver operands, left to right, then
// every right-hand side, left to right, then the stores, left to right. Every
// right side is an SSA value before the first store, so `a[i], a[j] = a[j], a[i]`
// is two loads and two stores: no tuple is built and nothing is allocated, for
// any element type `writeLvalue` stores (packed narrow elements, two-word
// decimals, map values, class fields). `a[i], a[i] = 1, 2` stores 1 then 2.
fn lowerAssignParallel(fc: FnCtx, lhsItems: []int, rhsItems: []int) {
  let targets = []ParTarget(0)
  let i = 0
  while (i < len(lhsItems)) {
    targets = append(targets, resolveParTarget(fc, lhsItems[i]))
    if (fc.failed) {
      return
    }
    i = i + 1
  }
  let vals = []int(0)
  i = 0
  while (i < len(rhsItems)) {
    vals = append(vals, lowerParValue(fc, targets[i], rhsItems[i]))
    if (fc.failed) {
      return
    }
    i = i + 1
  }
  i = 0
  while (i < len(targets)) {
    if (!targets[i].blank) {
      writeLvalue(fc, targets[i].lv, vals[i])
    }
    i = i + 1
  }
}

// Lowers `x++` / `x--` (SPEC §13.1): resolve the target's lvalue, read it,
// add/sub the constant 1, write the result back. `base` is Plus/Minus.
// The IR constant for literal `1` in `ty`'s own kind: `const_float 1.0` for a
// float target, `const_int 1` otherwise. A `const_int` materialising a float
// type carries the wrong 64-bit payload (integer 1, not IEEE 1.0), so `f++`
// would add a denormal instead of one (#1713).
fn oneConst(fc: FnCtx, ty: int): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)) {
    let f = mkInstr(Op.ConstFloat, ty)
    f.fval = 1.0
    return builderEmit(fc.b, f)
  }
  let i = mkInstr(Op.ConstInt, ty)
  i.ival = 1
  return builderEmit(fc.b, i)
}

// #4270/#4194: whether the already-lowered index `idx` is PROVABLY inside
// `[0, arrayLen)` with no runtime test needed at all, so a fixed-array access
// can skip `emitBoundsCheck` (loweraccess.bit) entirely rather than pay a
// branch that can never be taken. Two shapes, both structural on the lowered
// IR (the same technique `isAShrBy` in loweraccess.bit uses, and for the same
// reason: `analyzeConsts` has not run yet, so only a value that is LITERALLY
// a `const_int` here is recognized):
//
//   const_int k                  in range iff 0 <= k < arrayLen
//   (anything) & const_int m     in range iff 0 <= m < arrayLen
//
// The second shape is `x & m`, an unsigned bitwise AND against a non-negative
// literal mask: that ALWAYS yields a result in `[0, m]` regardless of `x`,
// because ANDing with a literal that has 0 in the sign bit clears the sign bit
// and can only clear bits `m` itself has cleared — no fact about `x` is
// needed. This is precisely the shape SPEC §10.3.1's `@nosplit` carve-out
// rests on (`_tests_/cases/run_nosplit_const_array_read.bit`'s `TAB[i & 3]`,
// arrayLen 4, mask 3): `vNosplitWalk`'s `Tag.Index` arm (validateattr.bit)
// recognizes the same two shapes on the AST, one level earlier, so an index
// the checker admits into a `@nosplit` body is guaranteed to land here too and
// never grow a branch `@nosplit`'s allowlist did not agree to.
//
// A bare local (`a[i]` with `i` a variable) is NOT provably in range even when
// its value happens to be constant at every call site — that needs dataflow
// this function does not attempt, and it gets the real runtime check instead,
// exactly like every other non-constant index.
fn indexProvablyInBounds(fc: FnCtx, idx: int, arrayLen: int): bool {
  if (!builderHasValue(fc.b, idx)) {
    return false
  }
  let ins = fc.b.instrs[idx]
  if (ins.op == Op.ConstInt) {
    return ins.ival >= 0 && ins.ival < arrayLen
  }
  if (ins.op != Op.BAnd || !builderHasValue(fc.b, ins.rhs)) {
    return false
  }
  let rhs = fc.b.instrs[ins.rhs]
  return rhs.op == Op.ConstInt && rhs.ival >= 0 && rhs.ival < arrayLen
}

// Emits `emitBoundsCheck` (loweraccess.bit) against `arrayLen` (a fixed
// array's length, always a compile-time constant) unless
// `indexProvablyInBounds` shows it is unnecessary. Shared by every fixed-array
// `index_get`/`index_set` emission site (#4270: `lowerIndex` in
// loweraccess.bit, `lowerIndexStore` in lowerflow.bit, and this file's own
// `readLvalue`/`writeLvalue` Elem arm) so the proof and the check cannot drift
// between a read site and a write site the way the bug this ticket fixes
// drifted between arrays and slices in the first place.
fn emitArrayBoundsCheckIfNeeded(fc: FnCtx, idx: int, arrayLen: int) {
  if (indexProvablyInBounds(fc, idx, arrayLen)) {
    return
  }
  let lenI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  lenI.ival = arrayLen
  emitBoundsCheck(fc, idx, builderEmit(fc.b, lenI))
}
