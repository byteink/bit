// Pins the link-path sorts (#7276, #7277) to the insertion sorts they
// replaced, kept below verbatim as the oracles. meSortOffsets (machoreloc.bit),
// loSortByOffset (linkobj.bit), ppSortEntries (peexception.bit) and plSortInts
// (peimport.bit) are now std/sort merge sorts; each must give the exact order
// the insertion sort gave, ties included, because the linked bytes depend on
// it: loSortByOffset's order picks an alias group's primary.
// Every length from 0 to 70 crosses each merge level's run boundaries, and
// keys drawn from a range much smaller than the length make duplicates common.

// The pre-#7276 meSortOffsets, verbatim.
fn meSortOffsetsInsertion(xs: []int): []int {
  let i = 1
  while (i < len(xs)) {
    let v = xs[i]
    let j = i - 1
    while (j >= 0 && xs[j] > v) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = v
    i = i + 1
  }
  return xs
}

// The pre-#7276 loSortByOffset, verbatim.
fn loSortByOffsetInsertion(symbols: []LoRawSymbol, items: []int): []int {
  let i = 1
  while (i < len(items)) {
    let v = items[i]
    let j = i - 1
    while (j >= 0 && symbols[items[j]].offset > symbols[v].offset) {
      items[j + 1] = items[j]
      j = j - 1
    }
    items[j + 1] = v
    i = i + 1
  }
  return items
}

// The pre-#7277 ppSortEntries, verbatim.
fn ppSortEntriesInsertion(items: []PePdataEntry): []PePdataEntry {
  let i = 1
  while (i < len(items)) {
    let v = items[i]
    let j = i - 1
    while (j >= 0 && items[j].beginRva > v.beginRva) {
      items[j + 1] = items[j]
      j = j - 1
    }
    items[j + 1] = v
    i = i + 1
  }
  return items
}

// The pre-#7277 plSortInts, verbatim.
fn plSortIntsInsertion(items: []int): []int {
  let i = 1
  while (i < len(items)) {
    let v = items[i]
    let j = i - 1
    while (j >= 0 && items[j] > v) {
      items[j + 1] = items[j]
      j = j - 1
    }
    items[j + 1] = v
    i = i + 1
  }
  return items
}

// The next state of a fixed linear congruential generator: the fixture must
// be the same on every run.
fn lsNext(x: int): int {
  return (x * 1103515245 + 12345) % 2147483648
}

fn lsCopy<T>(xs: []T): []T {
  let out = []T(len(xs))
  let i = 0
  while (i < len(xs)) {
    out[i] = xs[i]
    i = i + 1
  }
  return out
}

fn lsSame(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Compares every field, so two entries sharing a beginRva but swapped are told
// apart by their unwindInfoRva.
fn lsSameEntries(a: []PePdataEntry, b: []PePdataEntry): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i].beginRva != b[i].beginRva || a[i].endRva != b[i].endRva) {
      return false
    }
    if (a[i].unwindInfoRva != b[i].unwindInfoRva) {
      return false
    }
    i = i + 1
  }
  return true
}

// `n` symbols with offsets in [0, n/3 + 1), declared in a shuffled order, and
// their indices in declaration order: the shape loSortByOffset sees per section.
fn lsSymbols(n: int, seed: int): ([]LoRawSymbol, []int) {
  let syms = []LoRawSymbol(0)
  let items = []int(0)
  let x = seed
  let i = 0
  while (i < n) {
    x = lsNext(x)
    syms = append(syms, loSym("s${i}", 0, x % (n / 3 + 1), 0, LoBinding.Global, 1))
    items = append(items, i)
    i = i + 1
  }
  return (syms, items)
}

// The PE link's two sorts over the same duplicate-heavy keys: one
// RUNTIME_FUNCTION entry per symbol, its unwindInfoRva recording resolution
// order so a reordered tie shows, and the base-relocation RVAs as plain ints.
fn lsCheckPeSorts(syms: []LoRawSymbol, n: int) {
  let entries = []PePdataEntry(0)
  let rvas = []int(0)
  let i = 0
  while (i < len(syms)) {
    let rva = 4096 + syms[i].offset * 16
    entries = append(
      entries,
      PePdataEntry{ beginRva = rva, endRva = rva + 4, unwindInfoRva = 8 * i },
    )
    rvas = append(rvas, rva)
    i = i + 1
  }
  let want = ppSortEntriesInsertion(lsCopy(entries))
  assert(
    lsSameEntries(ppSortEntries(lsCopy(entries)), want),
    "checkLinkSorts: ppSortEntries, n=${n}",
  )
  let wantRvas = plSortIntsInsertion(lsCopy(rvas))
  assert(lsSame(plSortInts(lsCopy(rvas)), wantRvas), "checkLinkSorts: plSortInts, n=${n}")
}

fn checkLinkSorts() {
  let n = 0
  while (n <= 70) {
    let (syms, items) = lsSymbols(n, n + 7)
    let want = loSortByOffsetInsertion(syms, lsCopy(items))
    assert(
      lsSame(loSortByOffset(syms, lsCopy(items)), want),
      "checkLinkSorts: loSortByOffset, n=${n}",
    )
    // The rebase offsets: the same duplicate-heavy keys, as plain ints.
    let offs = []int(0)
    for s of syms {
      offs = append(offs, s.offset * 8)
    }
    let wantOffs = meSortOffsetsInsertion(lsCopy(offs))
    assert(lsSame(meSortOffsets(lsCopy(offs)), wantOffs), "checkLinkSorts: meSortOffsets, n=${n}")
    lsCheckPeSorts(syms, n)
    n = n + 1
  }
  // Ties keep declaration order: symbols 0, 2 and 3 share offset 4.
  let tie = [
    loSym("a", 0, 4, 0, LoBinding.Global, 1), loSym("b", 0, 0, 0, LoBinding.Global, 1),
    loSym("c", 0, 4, 0, LoBinding.Local, 1), loSym("d", 0, 4, 0, LoBinding.Global, 1),
  ]
  assert(lsSame(loSortByOffset(tie, [3, 0, 1, 2]), [1, 3, 0, 2]), "checkLinkSorts: alias ties")
}
