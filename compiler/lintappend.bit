// E0214 `append-aliasing`, split out of compiler/lintapply.bit (#3688 — that
// file was 865 lines against the 800-line limit once this rule's exemption
// gained a second pass over the function body). Pure move: every declaration
// below is unchanged from lintapply.bit except where its own commit says so.
// No import needed — module files share one namespace and concatenate in
// bytewise filename order (compiler/project.bit:7); this file sorts between
// compiler/lintallow.bit and compiler/lintapply.bit. Filename order only ever
// controlled diagnostic emission order and inlining depth, both fixed to be
// order-independent (#3163) — name resolution itself does not care, so
// `lintAppendAliasing` is visible to compiler/lintapply.bit's `runLintRules`
// and to compiler/lintcheck.bit's self-checks regardless of where this file
// sorts.

// `append(s, x)` grows `s` in place and aliases its backing array
// (spec/LINT.md §4): if `s` is a slice-typed PARAMETER and the call's result
// is not assigned straight back to that same parameter AND then handed back
// to this function's own caller (#3688), the caller's array may be mutated
// out from under it. This is the rule most likely to need overriding — a
// parameter a function genuinely owns looks identical, from the AST, to one
// the caller still holds — so it fires on the shape alone and leaves the
// judgement call to `// bit:lint disable append-aliasing`.
//
// Deliberately narrow (spec/LINT.md constraints): PARAMETERS only, never a
// class field or a call result, and never an attempt to prove the caller
// actually reuses the slice afterward — that is the whole-program view this
// rule avoids. A same-named local `let` shadowing the parameter is a false
// positive this rule accepts rather than resolves (spec/LINT.md §4).
//
// #3688: `p = append(p, x)` alone is NOT the safe shape spec/LINT.md used to
// say it was — reassigning a PARAMETER is local to the function; the growth
// only reaches the caller when the function's OWN return value carries `p`
// out (`lintReturnedNames` — a bare `return p`, or one hop through a
// returned composite literal's field). A self-assignment whose function
// never returns `p` in either form is reported exactly like a bare, unassigned
// `append(p, x)` — see spec/LINT.md §4 for why the fully general form of this
// (excusing a `p` some OTHER reachable object holds onto, e.g. a work queue a
// void function fully drains before returning) is not attempted: telling that
// apart from a real bug needs the caller's own body, which this rule does not
// read.
//
// One alias hop IS tracked (#3205): `let out = dst` makes `out` a direct copy
// of a slice-typed parameter's value for the rest of the function, so
// `append(out, ...)` carries the identical risk as `append(dst, ...)` and is
// reported under `dst`'s name — otherwise this rule's own coverage silently
// stops at the first assignment. Still one level only: `let b = out` (a copy
// of a copy) is not chased, and neither is a slice expression or a call
// result on the right-hand side. That remains general alias analysis, which
// this rule declines to do.
fn lintAppendAliasing(tree: Tree, src: string, file: int, d: Diagnostics) {
  let i = 1
  while (i < len(tree.nodes)) {
    if (getNode(tree, i).tag == Tag.FuncDecl) {
      lintAppendAliasingFunc(tree, src, file, i, d)
    }
    i = i + 1
  }
}

// The two per-function facts `lintProtectedAppends` (and its own helpers)
// need together: which of the enclosing function's parameters are
// slice-typed (`names`), and which of those it actually hands back to ITS
// OWN caller (`returned`, #3688). Bundled so those functions stay at or
// under the 5-parameter limit (E0202) rather than growing a 6th scalar
// parameter apiece.
class LintAppendScope {
  names: []string,
  returned: []string,
}

// `func_decl = [recv, name, generics, params, result, body(, attrs)]`
// (compiler/parserdecl.bit): params is kid 3, the body block is kid 5.
fn lintAppendAliasingFunc(tree: Tree, src: string, file: int, funcNode: int, d: Diagnostics) {
  let k = kidsOf(tree, funcNode)
  let names = lintSliceParamNames(tree, src, k[3])
  if (len(names) == 0) {
    return
  }
  let returned = lintReturnedNames(tree, src, k[5], names, []string(0))
  let scope = LintAppendScope{ names: names, returned: returned }
  let protected = lintProtectedAppends(tree, src, k[5], scope, []int(0))
  let aliases = lintCollectAppendAliases(tree, src, k[5], names, []LintAppendAlias(0))
  lintFindAppendAliasing(tree, src, file, k[5], names, aliases, protected, d)
}

// The names of `params`' slice-typed parameters (`param = [name, type]`,
// compiler/parserdecl.bit). A method receiver is never in this list — it is
// not a kid of `params` at all — so it can never be flagged.
fn lintSliceParamNames(tree: Tree, src: string, params: int): []string {
  let out = []string(0)
  for pn of kidsOf(tree, params) {
    if (getNode(tree, pn).tag != Tag.Param) {
      continue // a `...rest` param is excluded; its ownership rules differ
    }
    let pk = kidsOf(tree, pn)
    if (getNode(tree, pk[1]).tag == Tag.SliceType) {
      let nm = getNode(tree, pk[0]).span
      out = append(out, src[nm.start:nm.end])
    }
  }
  return out
}

// True iff `node` is a `call` whose callee is the bare identifier `append`.
fn lintIsAppendCall(tree: Tree, src: string, node: int): bool {
  if (getNode(tree, node).tag != Tag.Call) {
    return false
  }
  let callee = getNode(tree, kidsOf(tree, node)[0])
  if (callee.tag != Tag.Ident) {
    return false
  }
  return src[callee.span.start:callee.span.end] == "append"
}

// The name `append`'s first argument resolves to, or "" if it is not a bare
// identifier (`append(f(), x)` can never alias a parameter this rule can
// name). `args` holds `arg`/`arg_spread` nodes each wrapping one expression
// (compiler/parser.bit's `parseArgItem`).
fn lintAppendFirstArgName(tree: Tree, src: string, node: int): string {
  let argKids = kidsOf(tree, kidsOf(tree, node)[2])
  if (len(argKids) == 0) {
    return ""
  }
  let expr = getNode(tree, kidsOf(tree, argKids[0])[0])
  if (expr.tag != Tag.Ident) {
    return ""
  }
  return src[expr.span.start:expr.span.end]
}

// A local's name paired with the slice-typed parameter it was bound from by
// a direct `let <local> = <param>` (#3205) — one alias hop, tracked so
// `append(<local>, ...)` can still be reported under the parameter's name.
class LintAppendAlias {
  local: string,
  param: string,
}

// Every `let <local> = <param>` in `node`'s subtree where `param` is a bare
// identifier naming one of `names` (this function's slice-typed parameters).
// Only a direct copy counts: a slicing expression, a call result, or a second
// hop (`let b = out` where `out` is itself an alias) is not `Tag.Ident`-to-
// `Tag.Ident` and is silently skipped, per the narrow scope above.
fn lintCollectAppendAliases(
  tree: Tree, src: string, node: int, names: []string,
  out: []LintAppendAlias,
): []LintAppendAlias {
  if (node == 0) {
    return out
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.LetDecl) {
    for b of kidsOf(tree, node) {
      let bk = kidsOf(tree, b)
      let pat = getNode(tree, bk[0])
      let init = bk[2]
      if (pat.tag == Tag.Ident && init != 0 && getNode(tree, init).tag == Tag.Ident) {
        let initNode = getNode(tree, init)
        let paramName = src[initNode.span.start:initNode.span.end]
        if (lintContainsString(names, paramName)) {
          out = append(
            out,
            LintAppendAlias{
              local: src[pat.span.start:pat.span.end],
              param: paramName,
            },
          )
        }
      }
    }
  }
  for kid of kidsOf(tree, node) {
    out = lintCollectAppendAliases(tree, src, kid, names, out)
  }
  return out
}

// The parameter `name` aliases via `aliases`, or "" if `name` is not a
// tracked alias.
fn lintAppendAliasParam(aliases: []LintAppendAlias, name: string): string {
  let i = 0
  while (i < len(aliases)) {
    if (aliases[i].local == name) {
      return aliases[i].param
    }
    i = i + 1
  }
  return ""
}

// The subset of `names` that this function actually hands back to ITS OWN
// caller — by a bare `return <name>` (#3688), or by one hop through a
// returned composite literal's field (`return Bundle{ x: name }`, the
// `emitElfBlobs`/`EmElfBlobs{ symbols: symbols, ... }` shape). Computed once
// per function so `lintProtectedAppends` can require it before exempting a
// self-assignment: reassigning a PARAMETER is local by construction, and only
// escapes when the function's own return value carries it out.
//
// Same one-hop discipline as `lintCollectAppendAliases`'s `let out = dst`
// tracking: `return Bundle{ x: wrap(name) }` — a nested call or a second
// composite literal between the field and the name — is not chased.
fn lintReturnedNames(tree: Tree, src: string, node: int, names: []string, out: []string): []string {
  if (node == 0) {
    return out
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.ReturnStmt) {
    for item of kidsOf(tree, node) {
      out = lintCollectReturnItemName(tree, src, item, names, out)
    }
  }
  for kid of kidsOf(tree, node) {
    out = lintReturnedNames(tree, src, kid, names, out)
  }
  return out
}

// The name in `names` that `expr` exposes directly: itself, when `expr` is a
// bare identifier naming one of them; or the first argument, when `expr` is
// `append(<name>, ...)` — growing it once more on the way out, `jsonEsc2`'s
// `return append(out, b)` shape (otherwise a function whose every append is
// self-assigned-then-grown-again would read as never returning its parameter
// at all). "" when `expr` is neither.
fn lintEscapedName(tree: Tree, src: string, expr: int, names: []string): string {
  let n = getNode(tree, expr)
  if (n.tag == Tag.Ident) {
    let nm = src[n.span.start:n.span.end]
    if (lintContainsString(names, nm)) {
      return nm
    }
    return ""
  }
  if (n.tag == Tag.Call && lintIsAppendCall(tree, src, expr)) {
    let nm = lintAppendFirstArgName(tree, src, expr)
    if (lintContainsString(names, nm)) {
      return nm
    }
  }
  return ""
}

// Adds `item`'s name to `out` when `lintEscapedName` resolves it directly, or
// — one hop further — when `item` is a composite literal with a top-level
// field whose own value resolves the same way (`return Bundle{ x: name }` or
// `return Bundle{ x: append(name, v) }`). Neither shape recurses past that
// one hop — see `lintReturnedNames` above.
fn lintCollectReturnItemName(
  tree: Tree, src: string, item: int, names: []string,
  out: []string,
): []string {
  let direct = lintEscapedName(tree, src, item, names)
  if (direct != "") {
    if (!lintContainsString(out, direct)) {
      out = append(out, direct)
    }
    return out
  }
  if (getNode(tree, item).tag != Tag.CompositeLit) {
    return out
  }
  let k = kidsOf(tree, item)
  if (len(k) < 2 || getNode(tree, k[1]).tag != Tag.FieldInits) {
    return out
  }
  for f of kidsOf(tree, k[1]) {
    let fk = kidsOf(tree, f)
    if (len(fk) < 2) {
      continue
    }
    let nm = lintEscapedName(tree, src, fk[1], names)
    if (nm != "" && !lintContainsString(out, nm)) {
      out = append(out, nm)
    }
  }
  return out
}

// Every `append` call node, anywhere under `node`, whose result is assigned
// straight back to the same name it was called on — `p = append(p, x)` —
// AND whose name is in `returned` (#3688): the function must actually hand
// `p` back to ITS OWN caller, or the growth never reaches anyone and this is
// not protection at all. Only the exact self-assignment shape counts:
// routing the result through a temporary before reassigning is
// indistinguishable, from the AST, from never reassigning it at all, so it
// is not specially recognised either (accepted per spec/LINT.md — override,
// don't chase the flow).
//
// `names` restricts this to `p` itself being one of the function's own
// parameters (spec/LINT.md: "assigned back to that same parameter"). This
// matters since #3205: `out = append(out, ...)` where `out` is a `let`-alias
// of a parameter must NOT land here — reassigning the LOCAL does not make the
// function the owner of the PARAMETER's backing array, so that call still
// needs to reach lintFindAppendAliasing and be reported.
fn lintProtectedAppends(
  tree: Tree, src: string, node: int, scope: LintAppendScope,
  out: []int,
): []int {
  if (node == 0) {
    return out
  }
  if (getNode(tree, node).tag == Tag.Assign) {
    out = lintProtectedAssignAppends(tree, src, node, scope, out)
  }
  for kid of kidsOf(tree, node) {
    out = lintProtectedAppends(tree, src, kid, scope, out)
  }
  return out
}

// Every self-assigned append (`p = append(p, x)`) among an `Assign` node's
// paired lhs/rhs items that qualifies as protected under
// `lintIsProtectedSelfAppend` below.
fn lintProtectedAssignAppends(
  tree: Tree, src: string, assignNode: int,
  scope: LintAppendScope, out: []int,
): []int {
  let k = kidsOf(tree, assignNode)
  let lhs = kidsOf(tree, k[0])
  let rhs = kidsOf(tree, k[1])
  let i = 0
  while (i < len(lhs) && i < len(rhs)) {
    if (lintIsProtectedSelfAppend(tree, src, lhs[i], rhs[i], scope)) {
      out = append(out, rhs[i])
    }
    i = i + 1
  }
  return out
}

// True iff `lhs = rhs` is `p = append(p, x)` for a `p` that is both a
// slice-typed parameter (`scope.names`) and one this function actually hands
// back to its own caller (`scope.returned`, #3688) — see
// `lintProtectedAppends` above.
fn lintIsProtectedSelfAppend(
  tree: Tree, src: string, lhs: int, rhs: int,
  scope: LintAppendScope,
): bool {
  let lhsNode = getNode(tree, lhs)
  if (lhsNode.tag != Tag.Ident || !lintIsAppendCall(tree, src, rhs)) {
    return false
  }
  let lhsName = src[lhsNode.span.start:lhsNode.span.end]
  return lintContainsString(scope.names, lhsName) &&
    lintContainsString(scope.returned, lhsName) &&
    lintAppendFirstArgName(tree, src, rhs) == lhsName
}

// Reports every unprotected `append` call in `node`'s subtree whose first
// argument is one of `names` (this function's slice-typed parameters) or a
// local aliasing one of them via `let <local> = <param>` (#3205, `aliases`)
// — reported under the PARAMETER's name either way, so the finding stays
// actionable regardless of which spelling the call site used.
fn lintFindAppendAliasing(
  tree: Tree, src: string, file: int, node: int,
  names: []string, aliases: []LintAppendAlias, protected: []int, d: Diagnostics,
) {
  if (node == 0) {
    return
  }
  let n = getNode(tree, node)
  if (n.tag == Tag.Call && lintIsAppendCall(tree, src, node) && !lintContainsInt(protected, node)) {
    let argName = lintAppendFirstArgName(tree, src, node)
    let reportName = argName
    if (argName != "" && !lintContainsString(names, argName)) {
      reportName = lintAppendAliasParam(aliases, argName)
    }
    if (argName != "" && reportName != "") {
      // #3093: this rule read `n.span` verbatim and every node's `.file` was
      // always 0 (compiler/parser.bit's `leaf`/`spanOfKids`/`mkSpanNode`
      // hardcoded it, ignoring the real file threaded through `Parser.file`)
      // — single-file callers never noticed, since file 0 WAS the whole
      // source there. #3095 fixed the parser to stamp `p.file`, so `n.span`
      // is correct by construction now; this rebuild is redundant but kept
      // as the established, harmless pattern compiler/lintapply.bit already
      // uses (`lintMaxParams`/`lintDeferInLoop` there do the same).
      warn(
        d, ecLintAppendAliasing, Span{ file: file, start: n.span.start, end: n.span.end },
        "append on parameter '${reportName}' may alias the caller's backing array",
          "if '${reportName}' is owned by this function, silence just this call with `// bit:lint allow " +
          "E0214 -- <reason>` on the line above, or the whole file with `// bit:lint disable " +
          "append-aliasing -- <reason>` in the leading comment block; otherwise make the growth reach " +
          "the caller by returning it: `return ${reportName}` (or a struct/bundle field carrying it) — " +
          "`${reportName} = append(${reportName}, ...)` alone does NOT propagate out of this function",
      )
    }
  }
  for kid of kidsOf(tree, node) {
    lintFindAppendAliasing(tree, src, file, kid, names, aliases, protected, d)
  }
}

fn lintContainsInt(xs: []int, v: int): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}

fn lintContainsString(xs: []string, v: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == v) {
      return true
    }
    i = i + 1
  }
  return false
}
