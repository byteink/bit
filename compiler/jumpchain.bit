// #7159: a branch into a block that only jumps on costs two taken branches
// where one would do. Post-opt IR keeps blocks whose whole body is
// `jump bbU()`, and both backends emit such a block as a lone `b`/`jmp`, so a
// `br` into it lands on a second branch. Naming the chain's end instead is an
// emission choice, never an IR change: every block is still emitted, and only
// the label a branch names moves.
//
// A block is skipped only when executing it would run nothing but that jump.
// Its edge to the next block must therefore carry no code of its own: no
// parameter moves (no params, no args), no #5847 slot clears, and no
// back-edge poll. That last condition is also what keeps every hop strictly
// forward in IR index order, and the first hop is held to the same rule from
// the branching block, so a chain never ends at or before the block that
// branches into it. Under both backends' layouts (arm64layout.bit moves only
// `unreachable`-terminated blocks, which never jump) a higher index is a later
// emission position, so a retargeted edge never crosses a back edge and no
// poll appears, disappears or moves.
const jumpChainMaxHops = 4

// The block a branch from `src` to `target` can name instead of `target`:
// the end of the forwarding chain starting at `target`, at most
// jumpChainMaxHops hops away, or `target` itself.
fn jumpChainEnd(f: IrFunc, clears: []SlotClear, src: int, target: int): int {
  if (isBackEdge(src, target)) {
    return target
  }
  let dest = target
  let hops = 0
  while (hops < jumpChainMaxHops) {
    let next = forwardedTo(f, clears, dest)
    if (next < 0) {
      return dest
    }
    dest = next
    hops = hops + 1
  }
  return dest
}

// Where block `blk` forwards to when its only instruction is an argument-free
// forward `jump` whose edge emits nothing but that jump; -1 otherwise.
fn forwardedTo(f: IrFunc, clears: []SlotClear, blk: int): int {
  let b = f.blocks[blk]
  if (b.paramCount != 0 || b.instsLen != 1) {
    return -1
  }
  let j = f.instrs[b.instsStart]
  if (j.op != Op.Jump || len(j.args) != 0) {
    return -1
  }
  if (isBackEdge(blk, j.ival) || edgeHasClears(clears, blk, j.ival)) {
    return -1
  }
  return j.ival
}
