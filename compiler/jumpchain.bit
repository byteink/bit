// #7159: a branch into a block that only jumps on costs two taken branches
// where one would do. Post-opt IR keeps blocks whose whole body is
// `jump bbU()`, and both backends emit such a block as a lone `b`/`jmp`, so a
// `br` into it lands on a second branch. Naming the chain's end instead is an
// emission choice, never an IR change: only the label a branch names moves,
// and a forwarder left with no branch naming it is not emitted (#7189,
// `bypassedForwarders` below).
//
// A block is skipped only when executing it would run nothing but that jump.
// A block's own params emit nothing: the edge INTO it binds them, so a
// spliced call's ok block `bbN(%v): jump bbM()` (#5977) forwards too. Its
// edge to the next block must carry no code of its own: no parameter move
// that is not already in place (#7186: the backend says which lone jumps'
// moves are all identity, `inPlace`), no #5847 slot clears, and no
// back-edge poll. That last condition is also what keeps every hop strictly
// forward in IR index order, and the first hop is held to the same rule from
// the branching block, so a chain never ends at or before the block that
// branches into it. Under both backends' layouts (arm64layout.bit moves only
// `unreachable`-terminated blocks, which never jump) a higher index is a later
// emission position, so a retargeted edge never crosses a back edge and no
// poll appears, disappears or moves.
const jumpChainMaxHops = 4

// The block a branch from `src` to `target` can name instead of `target`:
// the end of the forwarding chain starting at `target`, at most
// jumpChainMaxHops hops away, or `target` itself.
fn jumpChainEnd(f: IrFunc, clears: []SlotClear, inPlace: []bool, src: int, target: int): int {
  if (isBackEdge(src, target)) {
    return target
  }
  let dest = target
  let hops = 0
  while (hops < jumpChainMaxHops) {
    let next = forwardedTo(f, clears, inPlace, dest)
    if (next < 0) {
      return dest
    }
    dest = next
    hops = hops + 1
  }
  return dest
}

// The `jump` ending block `blk` when it is the block's only emitted
// instruction (its params emit nothing), else -1.
fn loneJump(f: IrFunc, blk: int): int {
  let b = f.blocks[blk]
  let j = b.instsStart + b.paramCount
  if (b.instsLen != b.paramCount + 1 || f.instrs[j].op != Op.Jump) {
    return -1
  }
  return j
}

// Where block `blk` forwards to when its only instruction is a forward `jump`
// whose edge emits nothing but that jump; -1 otherwise. A jump with args
// qualifies only when `inPlace[blk]` says its moves are all identity; a table
// too short to say (a hand-built fixture context) refuses.
fn forwardedTo(f: IrFunc, clears: []SlotClear, inPlace: []bool, blk: int): int {
  let at = loneJump(f, blk)
  if (at < 0) {
    return -1
  }
  let j = f.instrs[at]
  if (len(j.args) != 0 && (blk >= len(inPlace) || !inPlace[blk])) {
    return -1
  }
  if (isBackEdge(blk, j.ival) || edgeHasClears(clears, blk, j.ival)) {
    return -1
  }
  return j.ival
}

// #7189: the forwarders no branch names once every edge names its chain end:
// each emits nothing, so its layout predecessor falls into the block laid out
// after it. A block is named when it ends some edge's chain — a back edge's
// target, a forwarder the hop limit stops at, or any block that does not
// forward — and every branch either backend emits names one of those
// (`jumpChainEnd`, or a back-edge poll's own target), which both patchers
// assert. Block 0 always stays: the prologue falls into it.
fn bypassedForwarders(f: IrFunc, clears: []SlotClear, inPlace: []bool): []bool {
  let named = []bool(len(f.blocks))
  let src = 0
  while (src < len(f.blocks)) {
    nameEdgeEnds(f, clears, inPlace, src, named)
    src = src + 1
  }
  let out = []bool(len(f.blocks))
  let blk = 1
  while (blk < len(f.blocks)) {
    out[blk] = !named[blk] && forwardedTo(f, clears, inPlace, blk) >= 0
    blk = blk + 1
  }
  return out
}

// Marks in `named` the chain end of each edge out of block `src`.
fn nameEdgeEnds(f: IrFunc, clears: []SlotClear, inPlace: []bool, src: int, named: []bool) {
  let b = f.blocks[src]
  if (b.instsLen == 0) {
    return
  }
  let t = f.instrs[b.instsStart + b.instsLen - 1]
  if (t.op == Op.Jump || t.op == Op.Br) {
    named[jumpChainEnd(f, clears, inPlace, src, t.ival)] = true
  }
  if (t.op == Op.Br) {
    named[jumpChainEnd(f, clears, inPlace, src, t.ival2)] = true
  }
}
