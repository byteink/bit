// compiler/pmcli.bit — `bit add` (#1734), `bit up`/`bit update` (#1735) and
// `bit remove` (#1736), epic #1480. Wires together the pieces landed by the
// sibling package-manager tasks into end-to-end commands:
//   - compiler/pmfetch.bit (#1733): parses `gitHost/owner/repo@ref`, resolves
//     `ref` to a commit sha, fetches it into the content-addressed cache.
//   - compiler/pmresolve.bit (#1731): Minimal Version Selection, used here to
//     confirm the version being added doesn't undercut something an existing
//     locked dependency already transitively requires.
//   - compiler/pmlock.bit (#1732): reads/writes bit.lock.
//   - stdlib/json's CST edit layer (#1725/#1726, epic #1479): the ONLY way
//     bit.json is ever rewritten — cstParse -> cstSetStringPath -> cstPrint,
//     never a plain parse-modify-reserialize, so a user's comments and
//     formatting survive except the one entry actually changed.
// `bit up [name]` (alias `update`) re-resolves every dependency `bit.json`
// names (or, with an argument, just that one) against its CURRENT ref —
// picking up a moved branch/tag's new HEAD — and rewrites bit.lock with the
// refreshed commit and transitive requirements. `bit.json` itself is never
// touched: the ref an entry names only changes if the user edits it by hand.
// No code from a fetched dependency is ever executed: pmfetch.bit already
// refuses to run anything from a fetched checkout (no build/postinstall
// scripts), and nothing below adds a new execution path.
import { CstEntry, CstNode, Trivia, cstDeleteKey, cstGet, cstParse, cstPrint, cstSetStringPath, Json, jsoncParse, jsonGet as jsonGetC, jsonAsString } from "std/json"

const pmCliDefaultTimeoutMs: int = 30000

// One dependency this run added or updated — enough to print a confirmation
// and to hand to both the bit.json rewrite and the bit.lock upsert.
struct AddResult { name: string, specRef: string, url: string, commit: string }

// ---- CLI entry --------------------------------------------------------

// `bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]`.
// `--url`, when given, is the URL actually fetched from instead of the
// `https://<host>/<owner>/<repo>.git` the spec derives — a CLI-only escape
// hatch for a private registry mirror or a `file://` fixture in a test. It is
// never recorded: `bit.json`'s dependency grammar (spec §17.7) has no field
// for a URL at all, and `bit.lock`'s `url` field keeps recording the derived
// `https://` URL so the lockfile stays reproducible from `bit.json` alone,
// exactly as spec §17.7 documents it, even on a run that used the override.
// Returns the process exit code: 2 on a usage error, 1 on a fetch/resolve/
// write failure, 0 on success.
function addCmd(a: []string): int {
  if (len(a) < 3) {
    eprint("usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n")
    return 2
  }
  let specArg = a[2]
  // #2267: `--help`/`-h` in the spec position must print usage, not be parsed
  // as a dependency spec — before this, `bit add --help` failed with "bit
  // add: pmfetch: dependency spec must be gitHost/owner/repo@ref: --help@HEAD",
  // which reads as a spec-syntax error about a package named "--help".
  if (pmIsHelpFlag(specArg)) {
    print("usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n")
    return 0
  }
  // #2107: any OTHER flag here is a usage error, not a package name. This is
  // the one operand position in the CLI where the mistake reached the network.
  if (cliRejectFlagOperand("add", specArg,
    "usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n")) {
    return 2
  }
  let (projectDir, urlOverride, badArg, hasBadArg) = parseAddFlags(a, 3)
  if (hasBadArg) {
    eprint("bit add: unexpected argument '${badArg}'\n")
    return 2
  }

  let hadRef = lastIndexByte(specArg, '@') >= 0
  let d = parseAddSpec(specArg) catch e {
    eprint("bit add: ${e.message()}\n")
    return 2
  }

  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  // A vanity name (SPEC §17.7) resolves over HTTPS instead of deriving a URL
  // from a known git host, so it takes its own path — `--url`'s escape hatch
  // exists to override where a DIRECT spec's derived URL fetches from, and
  // has no equivalent meaning once the URL itself comes from a resolved
  // `bit-import:` document.
  if (d.vanity) {
    if (len(urlOverride) > 0) {
      eprint("bit add: --url is not supported for a vanity dependency\n")
      return 2
    }
    let name = pmLastSegment(d.vanityName)
    let result = addVanityDependency(
      projectDir, cacheRoot, defaultGitBin, name, d.vanityName, d.ref, hadRef, pmCliDefaultTimeoutMs,
    ) catch e {
      eprint("bit add: ${e.message()}\n")
      return 1
    }
    print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
    return 0
  }

  let url = defaultDepUrl(d.host, d.owner, d.repo)
  let fetchUrl = url
  if (len(urlOverride) > 0) {
    fetchUrl = urlOverride
  }

  let result = addDependency(
    projectDir, cacheRoot, defaultGitBin,
    d.host, d.owner, d.repo, d.ref, hadRef, url, fetchUrl,
    pmCliDefaultTimeoutMs,
  ) catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
  return 0
}

// The trailing `/`-separated segment of a vanity path, e.g. `"http"` for
// `"bitlang.org/pkg/http"` — the `bit.json`/`bit.lock` key a vanity `bit add`
// stores a dependency under, mirroring how a direct spec keys by `repo`
// (`addDependency`'s own `let name = repo`).
function pmLastSegment(path: string): string {
  let slash = lastIndexByte(path, '/')
  if (slash >= 0) {
    return path[slash + 1:len(path)]
  }
  return path
}

// `bit up [name] [--dir <path>]` / `bit update [name] [--dir <path>]` —
// `update` is an exact alias, both routed here by main.bit's dispatch. With
// no `name`, refreshes every dependency `bit.json` names; with one, restricts
// the refresh to that dependency alone. Returns the process exit code: 2 on a
// usage error, 1 on a fetch/resolve/write failure, 0 on success.
function upCmd(a: []string): int {
  // #2267: `bit up --help`/`bit update --help` must print usage, not be
  // parsed as a dependency name — before this, it failed with "bit up: no
  // such dependency '--help' in bit.json", the same "flag read as an operand"
  // shape `bit add --help` had.
  if (len(a) > 2 && pmIsHelpFlag(a[2])) {
    print("usage: bit up [<name>] [--dir <path>]\n")
    return 0
  }
  let name = ""
  let start = 2
  if (start < len(a) && a[start] != "--dir") {
    // #2107: `--dir` is the only flag legitimately standing here, and it is
    // already excluded above; anything else flag-shaped would have been looked
    // up as a dependency name.
    if (cliRejectFlagOperand("up", a[start], "usage: bit up [<name>] [--dir <path>]\n")) {
      return 2
    }
    name = a[start]
    start = start + 1
  }
  let (projectDir, badArg, hasBadArg) = parseDirFlag(a, start)
  if (hasBadArg) {
    eprint("bit up: unexpected argument '${badArg}'\n")
    return 2
  }

  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let results = upDependencies(projectDir, cacheRoot, defaultGitBin, name, pmCliDefaultTimeoutMs) catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let i = 0
  while (i < len(results)) {
    print("bit up: ${results[i].name} -> ${results[i].ref} (${results[i].commit})\n")
    i = i + 1
  }
  return 0
}

// Shared by `addCmd`, `upCmd` and `removeCmd` (#2267): whether `s` is a help
// flag in the position each command would otherwise parse as its own operand
// (a dependency spec/name). Only the exact long and short forms main.bit's
// other subcommands already respond to (e.g. `bit ar`'s own usage line) —
// never a prefix match, so a dependency genuinely named `--help` (unlikely,
// but not disallowed by SPEC §17.7's segment charset) is never silently
// unreachable.
function pmIsHelpFlag(s: string): bool {
  return s == "--help" || s == "-h"
}

// Shared by `addCmd`, `upCmd` and `removeCmd`: `a[start:]` is either empty or
// exactly `--dir <path>`, the one flag all three subcommands accept. Returns
// the resolved project directory (`"."` if `--dir` was never given), the
// offending trailing argument (if any), and whether one was found — a bool,
// not an empty-string sentinel on `badArg`, because an empty string is itself
// a legal (if useless) argv entry and would otherwise be silently swallowed
// instead of rejected. The caller prefixes `badArg` with its own subcommand
// name to keep `bit add: ...` vs `bit up: ...` vs `bit remove: ...` error
// text distinct without duplicating this loop.
function parseDirFlag(a: []string, start: int): (string, string, bool) {
  let projectDir = "."
  let ai = start
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else {
      return projectDir, a[ai], true
    }
  }
  return projectDir, "", false
}

// `addCmd`-only: like `parseDirFlag`, but also accepts `--url <override>`
// (interleaved with `--dir` in any order) — the CLI-only fetch-URL escape
// hatch documented on `addCmd`. `removeCmd` has no use for a fetch URL and
// keeps using the plain `parseDirFlag` above. Returns the project directory,
// the URL override (`""` if `--url` was never given), the offending trailing
// argument, and whether one was found — same not-a-sentinel reasoning as
// `parseDirFlag`.
function parseAddFlags(a: []string, start: int): (string, string, string, bool) {
  let projectDir = "."
  let urlOverride = ""
  let ai = start
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else if (a[ai] == "--url" && ai + 1 < len(a)) {
      urlOverride = a[ai + 1]
      ai = ai + 2
    } else {
      return projectDir, urlOverride, a[ai], true
    }
  }
  return projectDir, urlOverride, "", false
}

// `gitHost/owner/repo[@ref]` — like pmfetch.bit's own `parseSpec`, but `ref`
// is OPTIONAL here (ticket #1734, step 1: default to the remote's default
// branch HEAD). `resolveDependencyRef` already knows how to resolve the
// pseudo-ref `"HEAD"` (`git ls-remote <url> HEAD`), so this is a thin wrapper
// around `parseSpec`, not a fork of its validation.
function parseAddSpec(spec: string): DepSpec! {
  if (lastIndexByte(spec, '@') >= 0) {
    return parseSpec(spec)?
  }
  return parseSpec(spec + "@HEAD")?
}

// ---- the add flow, independent of argv/exit codes ---------------------

// Steps (ticket #1734):
//  1. resolve `ref` to a commit sha (pmfetch.resolveDependencyRef). When
//     `refIsExplicit` is false (no `@ref` in the user's spec), the resolved
//     sha itself becomes the ref recorded in bit.json — spec §17.7 names
//     exactly three legal ref forms (tag / branch / bare sha), and a bare
//     sha is the only one of those that is already exactly what was
//     resolved, so this never invents a fourth "HEAD" spelling.
//  2. fetch that sha into the content-addressed cache (pmfetch.fetchSha).
//  3. read the fetched dependency's own bit.json requirements (if any) and
//     confirm this add doesn't undercut a version some existing locked
//     dependency already transitively requires (pmresolve.resolveMVS) — non-
//     version refs (a branch or bare sha) are not ordered versions and are
//     not run through it, matching spec §17.7 point 2.
//  4. rewrite bit.json's `dependencies.<name>` entry through the CST edit
//     layer, preserving every other byte.
//  5. walk the fetched dependency's own `requires` — and every dependency
//     THEY require, recursively — fetching and locking each one that has no
//     top-level bit.lock entry yet (`resolveTransitiveDeps`, #2251); a name
//     required at more than one version picks the max via `resolveMVS`.
//  6. regenerate bit.lock (pmlock.writeLock) with the resolved commit, the
//     fetched dependency's own transitive requirements, and every
//     transitive dependency step 5 resolved.
//
// `url` and `fetchUrl` are plain parameters, not derived here — the same
// layering pmfetch.bit itself uses (its `DepSpec` never carries a url
// either) — so this is directly testable against a `file://` fixture
// (pmclicheck.bit) without needing a real `https://` remote. `addCmd` above
// always derives `url` as `https://<host>/<owner>/<repo>.git`, per SPEC
// §17.7's git-only registry model; `fetchUrl` is the same value unless its
// `--url` escape hatch overrode it. The two are kept apart deliberately:
// `fetchUrl` is where the fetch actually reaches (below), `url` is what ends
// up in `bit.lock` (`upsertLockEntry`, at the bottom of this function) — so
// an override never leaks into a written file, only into where this one run
// looked.
export function addDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  host: string, owner: string, repo: string, ref: string, refIsExplicit: bool,
  url: string, fetchUrl: string, timeoutMs: int,
): AddResult! {
  let name = repo
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let entry = resolveDependency(cacheRoot, gitBin, name, host, owner, repo, ref, url, fetchUrl, entries, timeoutMs)?

  let finalRef = ref
  if (!refIsExplicit) {
    finalRef = entry.commit
  }

  // bit.lock first, bit.json second: bit.lock is fully machine-owned and
  // regenerated on every add/up/remove (pmlock.bit's own contract), so a
  // failure right after this write is self-healing — the next run recomputes
  // it from whatever bit.json says. The reverse order would risk bit.json
  // claiming a dependency bit.lock never recorded, a silent mismatch with no
  // rollback.
  let updated = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, "")
  let resolved = resolveTransitiveDeps(cacheRoot, gitBin, updated, flattenRequires(updated), timeoutMs)?
  writeLock(lockPath, resolved)?

  let specRef = "${host}/${owner}/${repo}@${finalRef}"
  rewriteManifest(projectDir, name, specRef)?

  return AddResult{ name: name, specRef: specRef, url: url, commit: entry.commit }
}

// The fetch/resolve/MVS-check sequence `bit add` and `bit up` both need,
// kept in exactly one place (ticket #1735's hard constraint: never fork
// #1734's plumbing): re-resolve `ref` against `fetchUrl` to a commit, fetch it
// into the cache, read its own transitive requirements, and re-run MVS
// (`checkVersionConflict`) against `existing`'s already-locked transitive
// requirements. Returns the fresh `LockEntry` without writing bit.lock —
// the caller (an add of one new dependency, or an up refreshing one already
// in bit.lock) decides how and when that gets written.
//
// `url` and `fetchUrl` differ only when `bit add --url` overrode where this
// one run looks (#1767): the fetch reaches `fetchUrl`, while the returned
// `LockEntry` records `url`, so an override never leaks into bit.lock.
//
// Guards `name` against a DIFFERENT repo silently taking over its bit.lock
// entry (#2253): `name` is the bare last path segment of a direct spec
// (`addDependency`'s `let name = repo`), so two unrelated repos that happen to
// share a repo name — `local.invalid/dev/strings` and
// `local.invalid/other/strings` — collide on the identical key. Before this
// guard, the second `bit add` silently overwrote the first entry (and every
// `import … from "strings"` in the project silently started compiling against
// different code); `checkResolvedUrlMatches` (pmfetch.bit) already exists for
// exactly this shape of check on the vanity path
// (`resolveVanityDependency`, below) and is reused here unchanged, checked
// BEFORE any fetch so a colliding `bit add` never touches the network. A
// dependency refreshed at a new ref (same host/owner/repo, so the same
// derived `url`) is unaffected: `existingUrlFor` returns that identical `url`,
// so the check passes trivially.
function resolveDependency(
  cacheRoot: string, gitBin: string,
  name: string, host: string, owner: string, repo: string, ref: string, url: string,
  fetchUrl: string, existing: []LockEntry, timeoutMs: int,
): LockEntry! {
  checkResolvedUrlMatches(name, existingUrlFor(existing, name, ""), url)?
  let sha = resolveDependencyRef(gitBin, fetchUrl, ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, host, owner, repo, fetchUrl, sha, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  let depRequires = manifestRequires(depManifest)
  checkVersionConflict(existing, name, ref, depRequires)?
  return LockEntry{ name: name, url: url, commit: sha, requires: depRequires, vanity: "" }
}

// `bit add`'s vanity counterpart to `addDependency` (SPEC §17.7, #2068):
// resolves `vanityName` to a git URL through its `bit-import:` document
// (pmfetch.bit's `resolveVanityUrl`) instead of deriving one from a known
// git host, then runs the same fetch/MVS/bit.lock/bit.json sequence
// `addDependency` runs for a direct spec. `name` is the `bit.json`/
// `bit.lock` key — `addCmd`'s `pmLastSegment(d.vanityName)`, mirroring how a
// direct spec keys by `repo`.
export function addVanityDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  name: string, vanityName: string, ref: string, refIsExplicit: bool, timeoutMs: int,
): AddResult! {
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let entry = resolveVanityDependency(cacheRoot, gitBin, name, vanityName, ref, entries, timeoutMs)?

  let finalRef = ref
  if (!refIsExplicit) {
    finalRef = entry.commit
  }

  // Same bit.lock-first, bit.json-second ordering as `addDependency`, and
  // for the same reason: bit.lock is fully machine-owned and self-healing on
  // the next run, so a failure right after this write never leaves bit.json
  // claiming a dependency bit.lock does not record.
  let updated = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, entry.vanity)
  let resolved = resolveTransitiveDeps(cacheRoot, gitBin, updated, flattenRequires(updated), timeoutMs)?
  writeLock(lockPath, resolved)?

  let specRef = "${vanityName}@${finalRef}"
  rewriteManifest(projectDir, name, specRef)?

  return AddResult{ name: name, specRef: specRef, url: entry.url, commit: entry.commit }
}

// The vanity counterpart to `resolveDependency`: resolve `vanityName` to a
// git URL, refuse a fresh resolution that disagrees with whatever URL
// `bit.lock` already records for `name` (pmfetch.bit's
// `checkResolvedUrlMatches` — SPEC §17.7's "never a silent switch" rule),
// then decompose the resolved URL into a `host`/`owner`/`repo` triple
// (pmfetch.bit's `parseGitRemoteUrl`) and run the identical fetch/MVS
// sequence `resolveDependency` runs for a direct spec — the resolved URL is
// used exactly as a direct spec's derived URL would be, never special-cased.
function resolveVanityDependency(
  cacheRoot: string, gitBin: string,
  name: string, vanityName: string, ref: string,
  existing: []LockEntry, timeoutMs: int,
): LockEntry! {
  let gitUrl = resolveVanityUrl(vanityName, vanityTimeoutMs)?
  checkResolvedUrlMatches(name, existingUrlFor(existing, name, ""), gitUrl)?
  let remote = parseGitRemoteUrl(gitUrl)?
  let sha = resolveDependencyRef(gitBin, gitUrl, ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, remote.host, remote.owner, remote.repo, gitUrl, sha, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  let depRequires = manifestRequires(depManifest)
  checkVersionConflict(existing, name, ref, depRequires)?
  return LockEntry{ name: name, url: gitUrl, commit: sha, requires: depRequires, vanity: vanityName }
}

// ---- transitive dependency resolution (#2251) --------------------------
//
// SPEC §17.7 step 1: "the resolver walks the transitive requirement graph —
// every dependency's own bit.json dependencies, recursively." Step 2: "for
// each distinct module named anywhere in that graph, the resolver ...
// selects the maximum" of every stated minimum version. `pmresolve.bit`'s
// `resolveMVS` already implements steps 2/3 over a `ReqGraph` handed to it
// as data — its own header says assembling that data from `bit.lock`/git is
// a separate job. This is that job: walk every `requires` edge a locked
// dependency's own `bit.json` names, fetching each newly discovered name
// (through the identical direct-vs-vanity classification and fetch
// machinery a root `bit add` uses — a transitive dependency's own
// dependency can itself be a vanity name, #2068) and giving each surviving
// module its own top-level `bit.lock` entry.
//
// Two disjoint kinds of requirement, per SPEC §17.7 point 2:
//   - version-tagged (an exact `vMAJOR.MINOR.PATCH` ref): every DISTINCT
//     (name, version) pair reachable is fetched once to learn ITS OWN
//     requirements, feeding `resolveMVS`'s `ReqGraph`; the winning
//     (max-selected) version per name is then the one actually locked,
//     reusing the fetch already done during discovery rather than fetching
//     a second time.
//   - non-version (a branch or bare commit SHA): SPEC's own carve-out — "a
//     module reachable only through such a ref resolves to exactly that
//     ref" — there is no ordering to arbitrate, so the first (and, since a
//     name is fetched at most once here, only) ref discovered for a name is
//     locked as-is.
// A version-tagged resolution wins over a non-version one for the same name
// if a walk somehow discovers both (an exact pinned version is a strictly
// stronger constraint than an unordered branch/sha) — this resolver's one
// tie-break rule, applied only at the very end so discovery never depends on
// which requirement happens to be walked first.
//
// Known limitation, deliberately out of scope here: a name that ALREADY has
// a top-level `bit.lock` entry (a direct dependency, or one this resolver
// already locked on a prior run) is never reconsidered even if a freshly
// discovered requirement would want a higher version — this walk only fills
// in names bit.lock does not yet have an entry for. Re-arbitrating an
// already-locked name against a newly discovered transitive requirement (the
// same way `checkVersionConflict` guards a root `bit add`) is #2250's own
// scope, which also covers `checkVersionConflict` itself never firing today.

// One requirement discovered while walking a dependency's own `requires` —
// `spec` is that dependency's stated value verbatim (`LockRequire.ref`,
// pmlock.bit: a full `gitHost/owner/repo@ref` or vanity `path@ref` string,
// not a bare ref). `fromRoot` marks a requirement that came directly from
// `resolveTransitiveDeps`'s own `seed` (a "true" root of this resolver's own
// graph) rather than from a deeper module's own requirements — only a root
// requirement is fed to `resolveMVS` directly; every deeper edge is
// re-derived by `resolveMVS`'s own internal walk over the `modules` this
// file assembles, the same layering `checkVersionConflict` already uses.
struct PendingReq { name: string, spec: string, fromRoot: bool }

// The `Version` a FULL dependency spec string's trailing `@ref` names, or
// `(_, false)` if that ref is not an exact `vMAJOR.MINOR.PATCH` tag. Unlike
// `parseVersionTag` (above), which expects an already-bare ref, this takes
// the full spec a `bit.json` `dependencies` value or a `bit.lock` `requires`
// entry actually stores (`host/owner/repo@ref` or `vanityPath@ref`) and
// extracts the ref itself first.
function pendingVersionTag(spec: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  let at = lastIndexByte(spec, '@')
  if (at < 0) {
    return zero, false
  }
  return parseVersionTag(spec[at + 1:len(spec)])
}

// Whether `entries` already carries a top-level entry named `name` — the
// gate that stops this resolver from re-fetching (or re-considering) a
// dependency some earlier `bit add`/`bit up` already locked.
function lockHasEntry(entries: []LockEntry, name: string): bool {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// `queue` with one `PendingReq{fromRoot: false}` appended per entry of `rs`
// (a freshly-fetched dependency's own `requires`) — every edge discovered
// below the top level of this resolver's own walk.
function enqueueRequires(queue: []PendingReq, rs: []LockRequire): []PendingReq {
  let out = queue
  let i = 0
  while (i < len(rs)) {
    out = append(out, PendingReq{ name: rs[i].name, spec: rs[i].ref, fromRoot: false })
    i = i + 1
  }
  return out
}

// `rs` (raw `[]LockRequire`, full-spec-string refs) narrowed to its
// version-shaped subset, as pmresolve.bit's `[]Requirement` — the data a
// freshly-fetched module's own requirements become for `ReqGraph.modules`.
// Also reused by `checkVersionConflict` (below) for the dependency being
// added/refreshed's own requirements: before #2250, `checkVersionConflict`
// called `parseVersionTag` directly on a full spec string instead of
// extracting its `@ref` tail first (the now-removed `pmToRequirements`), so it
// never matched anything and MVS never had an already-locked transitive
// requirement to arbitrate against — this is the corrected extraction, and
// the reason `checkVersionConflict` never fired for a real diamond conflict
// before #2250. This resolver's own "already-locked names are never
// reconsidered" limitation (above) is the one piece #2250 does NOT cover:
// re-arbitrating an already-locked name against a newly discovered
// TRANSITIVE requirement (as opposed to a root `bit add`/`bit up`, which
// #2250 does fix) is still out of scope here.
function versionRequirementsOf(rs: []LockRequire): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(rs)) {
    let (v, ok) = pendingVersionTag(rs[i].ref)
    if (ok) {
      out = append(out, Requirement{ name: rs[i].name, min: v })
    }
    i = i + 1
  }
  return out
}

// Resolves one transitive requirement's full spec (a dependency's own
// `bit.json` value, e.g. `"local.invalid/dev/textutil@v0.1.0"`) to a fetched
// `LockEntry`, routing it through the identical direct-vs-vanity
// classification (`parseSpec`/`parseAddSpec`) and fetch machinery
// (`fetchSha`/`resolveVanityUrl`) a root `bit add` uses — a transitive
// dependency's own dependency can itself be a vanity name (#2068), so this
// must never assume the direct shape. `parseAddSpec` (not the stricter
// `parseSpec`) is used so a hand-authored manifest that omits `@ref` on one
// of ITS OWN dependencies resolves the same way an omitted `@ref` does for a
// root `bit add`, rather than failing the whole resolution.
function resolveTransitiveSpec(cacheRoot: string, gitBin: string, name: string, spec: string, timeoutMs: int): LockEntry! {
  let d = parseAddSpec(spec)?
  if (d.vanity) {
    let gitUrl = resolveVanityUrl(d.vanityName, vanityTimeoutMs)?
    let remote = parseGitRemoteUrl(gitUrl)?
    let sha = resolveDependencyRef(gitBin, gitUrl, d.ref, timeoutMs)?
    let fetched = fetchSha(gitBin, cacheRoot, remote.host, remote.owner, remote.repo, gitUrl, sha, timeoutMs)?
    let depManifest = readManifest(fetched.dir)?
    return LockEntry{ name: name, url: gitUrl, commit: sha, requires: manifestRequires(depManifest), vanity: d.vanityName }
  }
  let url = defaultDepUrl(d.host, d.owner, d.repo)
  let sha = resolveDependencyRef(gitBin, url, d.ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, d.host, d.owner, d.repo, url, sha, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  return LockEntry{ name: name, url: url, commit: sha, requires: manifestRequires(depManifest), vanity: "" }
}

// Fetches every dependency reachable from `seed` (typically every
// already-locked entry's own `requires`, flattened — `flattenRequires`,
// below) that does not already have a top-level `bit.lock` entry, giving
// each its own entry — the loop this file's own module comment above says
// `pmresolve.bit` is missing. Discovery never mutates `entries` — it only
// fetches and records candidates — so `entries` is exactly as it started
// throughout the walk regardless of queue order; both classes of winner
// (version-tagged and non-version) are written into `entries` only in the
// two materialization passes at the end.
//
// Bounded worklist: `queue` only ever grows from a freshly-fetched
// dependency's own `requires` list (`enqueueRequires`), and a `(name,
// version)` or bare `name` pair already visited is never re-enqueued for a
// fetch (`visitedVersions`/`visitedNonVersion`) — so the total number of
// fetches this performs is bounded by the number of distinct requirement
// edges reachable across every `bit.json` this walk actually reads, the same
// bound `resolveMVS`'s own worklist comment gives for its walk, and a cycle
// or self-dependency cannot loop it forever for the identical reason.
export function resolveTransitiveDeps(
  cacheRoot: string, gitBin: string, entries: []LockEntry, seed: []LockRequire, timeoutMs: int,
): []LockEntry! {
  let queue = []PendingReq(0)
  let i = 0
  while (i < len(seed)) {
    queue = append(queue, PendingReq{ name: seed[i].name, spec: seed[i].ref, fromRoot: true })
    i = i + 1
  }

  let rootRequires = []Requirement(0)
  let modules = []ModuleReqs(0)
  let fetchedByVersion = map<string, LockEntry>{}
  let visitedVersions = map<string, bool>{}
  let nonVersionFetched = map<string, LockEntry>{}
  let visitedNonVersion = map<string, bool>{}
  let nonVersionNames = []string(0)

  let qi = 0
  while (qi < len(queue)) {
    let req = queue[qi]
    qi = qi + 1
    if (lockHasEntry(entries, req.name)) {
      continue
    }

    let (ver, isVersion) = pendingVersionTag(req.spec)
    if (!isVersion) {
      let (_, seenNV) = visitedNonVersion[req.name]
      if (seenNV) {
        continue
      }
      visitedNonVersion[req.name] = true
      let entry = resolveTransitiveSpec(cacheRoot, gitBin, req.name, req.spec, timeoutMs)?
      nonVersionFetched[req.name] = entry
      nonVersionNames = append(nonVersionNames, req.name)
      queue = enqueueRequires(queue, entry.requires)
      continue
    }

    if (req.fromRoot) {
      rootRequires = append(rootRequires, Requirement{ name: req.name, min: ver })
    }

    let key = "${req.name}@${ver.major}.${ver.minor}.${ver.patch}"
    let (_, seenV) = visitedVersions[key]
    if (seenV) {
      continue
    }
    visitedVersions[key] = true
    let entry = resolveTransitiveSpec(cacheRoot, gitBin, req.name, req.spec, timeoutMs)?
    fetchedByVersion[key] = entry
    modules = append(modules, ModuleReqs{ name: req.name, version: ver, requires: versionRequirementsOf(entry.requires) })
    queue = enqueueRequires(queue, entry.requires)
  }

  let resolved = resolveMVS(ReqGraph{ rootRequires: rootRequires, modules: modules })

  // Version-tagged winners first — the tie-break rule this resolver's own
  // module comment names.
  let vi = 0
  while (vi < len(modules)) {
    let name = modules[vi].name
    vi = vi + 1
    if (lockHasEntry(entries, name)) {
      continue
    }
    let (winner, found) = resolved[name]
    if (!found) {
      continue
    }
    let winKey = "${name}@${winner.major}.${winner.minor}.${winner.patch}"
    let (entry, hasEntry) = fetchedByVersion[winKey]
    if (!hasEntry) {
      fail newError("pmcli: internal error resolving transitive dependency ${name}: MVS chose v${winner.major}.${winner.minor}.${winner.patch}, which this resolver never fetched")
    }
    entries = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, entry.vanity)
  }

  let ni = 0
  while (ni < len(nonVersionNames)) {
    let name = nonVersionNames[ni]
    ni = ni + 1
    if (lockHasEntry(entries, name)) {
      continue
    }
    let (entry, hasEntry) = nonVersionFetched[name]
    if (!hasEntry) {
      continue
    }
    entries = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires, entry.vanity)
  }

  return entries
}

// Every entry's own `requires`, flattened into one `[]LockRequire` — the
// seed `resolveTransitiveDeps` starts its walk from, covering not just a
// dependency just added but every requirement `bit.lock` already records (a
// lock file written before this walk existed, or an entry whose own
// requirements have grown since the last resolution).
function flattenRequires(entries: []LockEntry): []LockRequire {
  let out = []LockRequire(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      out = append(out, entries[i].requires[j])
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// ---- reading a fetched dependency's own requirements -------------------

// The `dependencies` object of a fetched dependency's `bit.json`
// (`d`, from pmfetch.bit's `readManifest`), as `[]LockRequire` — an absent
// manifest or an absent/malformed `dependencies` key is not an error, just
// no transitive requirements (`readManifest` already returns a well-formed,
// empty `JsonDoc` for a dependency with no manifest at all).
function manifestRequires(d: JsonDoc): []LockRequire {
  let out = []LockRequire(0)
  if (!jsonHas(d, d.root)) {
    return out
  }
  let depsId = jsonGet(d, d.root, "dependencies")
  if (depsId < 0 || jsonKindOf(d, depsId) != JsonKind.Obj) {
    return out
  }
  let n = jsonLen(d, depsId)
  let i = 0
  while (i < n) {
    let key = jsonKeyAt(d, depsId, i)
    out = append(out, LockRequire{ name: key, ref: jsonStrOf(d, jsonGet(d, depsId, key)) })
    i = i + 1
  }
  return out
}

// ---- Minimal Version Selection over just this one add ------------------

// An exact `vMAJOR.MINOR.PATCH` tag, or `(_, false)` for anything else (a
// branch name or a bare commit sha — spec §17.7 point 2: not an MVS-ordered
// version).
function parseVersionTag(ref: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  if (len(ref) < 2 || ref[0] != 'v') {
    return zero, false
  }
  let (major, i1, ok1) = pmScanUint(ref, 1)
  if (!ok1 || i1 >= len(ref) || ref[i1] != '.') {
    return zero, false
  }
  let (minor, i2, ok2) = pmScanUint(ref, i1 + 1)
  if (!ok2 || i2 >= len(ref) || ref[i2] != '.') {
    return zero, false
  }
  let (patch, i3, ok3) = pmScanUint(ref, i2 + 1)
  if (!ok3 || i3 != len(ref)) {
    return zero, false
  }
  return Version{ major: major, minor: minor, patch: patch }, true
}

// The decimal integer starting at `s[start]`, the index just past its last
// digit, and whether at least one digit was read.
function pmScanUint(s: string, start: int): (int, int, bool) {
  let i = start
  let n = 0
  let any = false
  while (i < len(s) && s[i] >= '0' && s[i] <= '9') {
    n = n * 10 + (int(s[i]) - int('0'))
    i = i + 1
    any = true
  }
  return n, i, any
}

// Every version-shaped requirement any ALREADY-locked dependency's own
// transitive `requires` states for `name` — the other half of "the current
// project's requirements" ticket #1734 step 3 asks to feed the resolver,
// alongside the dependency being added itself.
//
// #2250: this used to call `parseVersionTag(r.ref)` directly, which expects
// an already-bare ref (`"v2.0.0"`); `r.ref` (`LockRequire.ref`, pmlock.bit) is
// always a FULL spec (`"gitHost/owner/repo@ref"` or a vanity `path@ref`), so
// `parseVersionTag`'s `ref[0] == 'v'` check never matched — a full spec's
// first byte is a host name, never `'v'`. This function's result was
// therefore always empty, so `checkVersionConflict`, below, never had any
// ALREADY-LOCKED transitive requirement to arbitrate against: the MVS
// resolver itself (pmresolve.bit's `resolveMVS`, unchanged, still correct —
// see its own checks) never fired for a real conflict, because it was never
// handed one. `pendingVersionTag` (above) is the correct extraction — same
// one `versionRequirementsOf` (above) already uses for a freshly-fetched
// module's own requirements — so this now shares it instead of repeating the
// bug.
function pmExistingRequirementsFor(entries: []LockEntry, name: string): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      let r = entries[i].requires[j]
      if (r.name == name) {
        let (v, ok) = pendingVersionTag(r.ref)
        if (ok) {
          out = append(out, Requirement{ name: name, min: v })
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// Fails if some already-locked dependency's own transitive requirements
// demand a HIGHER version of `name` than `ref` — MVS's rule (spec §17.7 point
// 2: the resolved version is never lower than the highest of all
// requirements). A non-version `ref` (branch/sha) has nothing for MVS to
// arbitrate and always passes. Takes the project's already-read `[]LockEntry`
// rather than a path, so `addDependency` reads bit.lock once per run instead
// of once here and once again to build the upsert list.
function checkVersionConflict(
  existing: []LockEntry,
  name: string,
  ref: string,
  depRequires: []LockRequire,
): ()! {
  let (reqVersion, isVersion) = parseVersionTag(ref)
  if (!isVersion) {
    return
  }
  let transitive = pmExistingRequirementsFor(existing, name)

  let graph = ReqGraph{
    rootRequires: append(transitive, Requirement{ name: name, min: reqVersion }),
    // `depRequires` is `LockRequire` (full-spec refs), the same shape
    // `versionRequirementsOf` (above) already narrows for a freshly-fetched
    // module during transitive resolution — reused here rather than a second,
    // near-identical `pmToRequirements` (removed, #2250: it read the wrong
    // string and never matched anything).
    modules: [ModuleReqs{ name: name, version: reqVersion, requires: versionRequirementsOf(depRequires) }],
  }
  let resolved = resolveMVS(graph)
  let (finalVer, found) = resolved[name]
  if (found && versionLess(reqVersion, finalVer)) {
    fail newError("pmcli: ${name}@${ref} conflicts with a higher transitive requirement (v${finalVer.major}.${finalVer.minor}.${finalVer.patch} needed) — pick that version instead")
  }
}

// ---- bit.json / bit.lock writes -----------------------------------------

// Rewrites `<projectDir>/bit.json`'s `dependencies.<name>` entry to
// `specRef`, through the CST edit layer only — every other byte of the file
// (comments, formatting, every other entry) survives untouched. Fails rather
// than guessing if the project has no `bit.json` at all: `bit add` adds TO a
// project, it does not scaffold one (that is `bit init`'s job, out of scope
// here).
function rewriteManifest(projectDir: string, name: string, specRef: string): ()! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit add: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let root = ensureDependenciesObject(cstParse(src)?)
  let updated = cstSetStringPath(root, ["dependencies", name], specRef)?
  writeFile(path, cstPrint(updated))?
}

// Pre-creates a REAL, empty `"dependencies": {}` entry on `root` when it has
// none yet — the first `bit add` in a hand-written project, which starts from
// a manifest with no `dependencies` key at all (#2245).
//
// Root cause this works around, without touching stdlib/json (outside this
// file's fence): `cstSetStringPath` (stdlib/json/edit.bit), when the
// intermediate "dependencies" object doesn't exist, builds one via
// `emptyCstObject()`, whose single gap starts life as `Option<string>.None`.
// Appending the first entry into that object doubles the `None` (edit.bit's
// `appendGapSlot`) into a TAIL gap — the boundary after the last entry, before
// the closing `}` — that the printer (stdlib/json/cst_print.bit's
// `gapForIndex`) cannot distinguish from an ordinary BETWEEN-entries gap, so
// it synthesizes a leading comma there as if another sibling followed. The
// result is `"dependencies": {"textutil": "…",}"` — a trailing comma before
// the closing brace, invalid JSON. A manifest that already has `"dependencies":
// {}` never hits this: its object came from `cstParse` itself, whose tail gap
// is always a real `Some("")`, never `None`.
//
// The fix: build "dependencies": {} here ourselves, with a `Some("")` tail gap
// — exactly the shape `cstParse` itself would produce for `{}` in source — so
// `cstSetStringPath` above always finds an EXISTING "dependencies" object (the
// already-correct path) and never exercises `emptyCstObject()` for it. Only
// the top-level append is done here; `cstSetStringPath` still owns inserting
// the actual `name: specRef` entry into the now-real empty object.
function ensureDependenciesObject(root: CstNode): CstNode {
  match (cstGet(root, ["dependencies"])) {
    Some(v) => return root
    None => {}
  }
  match (root) {
    CstObject(entries, gaps, trivia) => {
      let depsEntry = CstEntry{
        keyText: "\"dependencies\"",
        key: "dependencies",
        midGap: ": ",
        value: CstNode.CstObject([]CstEntry(0), [Option<string>.Some("")], Trivia{ leading: "", trailing: "" }),
      }
      return CstNode.CstObject(append(entries, depsEntry), pmAppendGapSlot(gaps), trivia)
    }
    CstNull(t) => return root
    CstBool(b, t) => return root
    CstNumber(r, t) => return root
    CstString(s, t) => return root
    CstArray(a, g, t) => return root
  }
}

// A top-level-only mirror of stdlib/json/edit.bit's private `appendGapSlot`
// (unexported, and edit.bit is outside this file's fence): `gaps`
// (`len(entries) + 1`) with one more slot inserted for an appended entry — a
// fresh `None` leading gap for the new entry (the printer infers its comma
// and indentation from the preceding sibling), and the OLD tail gap reused as
// the new tail, since it still describes "after the last entry, before the
// close". Used only by `ensureDependenciesObject`, always at `root`'s own
// level, which already has a real (non-`None`) tail gap from `cstParse` — the
// exact case that does not trigger the bug this function's caller works
// around.
function pmAppendGapSlot(gaps: []Option<string>): []Option<string> {
  let out = []Option<string>(0)
  let i = 0
  while (i < len(gaps) - 1) {
    out = append(out, gaps[i])
    i = i + 1
  }
  out = append(out, Option<string>.None)
  out = append(out, gaps[len(gaps) - 1])
  return out
}

// `entries` with `name`'s entry replaced (or appended, if absent) by a fresh
// one built from this run's fetch — bit.lock is fully machine-owned, so the
// whole entry is regenerated rather than patched field-by-field.
function upsertLockEntry(
  entries: []LockEntry,
  name: string,
  url: string,
  commit: string,
  requires: []LockRequire,
  vanity: string,
): []LockEntry {
  let out = []LockEntry(0)
  let replaced = false
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      out = append(out, LockEntry{ name: name, url: url, commit: commit, requires: requires, vanity: vanity })
      replaced = true
    } else {
      out = append(out, entries[i])
    }
    i = i + 1
  }
  if (!replaced) {
    out = append(out, LockEntry{ name: name, url: url, commit: commit, requires: requires, vanity: vanity })
  }
  return out
}

// ---- the up flow, independent of argv/exit codes -----------------------

// One dependency `bit up`/`bit update` refreshed — enough to print a
// confirmation, mirroring `AddResult`.
struct UpResult { name: string, ref: string, url: string, commit: string }

// One `bit.json` `dependencies` entry, decoded.
struct DepSpecNamed { name: string, spec: DepSpec }

// Every dependency `<projectDir>/bit.json` names, decoded through
// `jsoncParse` (std/json) — unlike `readManifest` (pmfetch.bit), which reads
// a FETCHED dependency's manifest through the strict local JSON parser, this
// reads the PROJECT's OWN bit.json, which routinely carries the user's
// comments (JSONC, not plain JSON — same format the CST edit layer preserves
// for `bit add`). Each value is decoded through pmfetch.bit's own `parseSpec`
// — the identical `host/owner/repo@ref` shape `bit add` already validates —
// so a malformed entry fails the same way it would on `add`. Fails if the
// project has no `bit.json` at all: `bit up` refreshes an existing project,
// it does not scaffold one.
function projectDeps(projectDir: string): []DepSpecNamed! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit up: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let doc = jsoncParse(src)?
  let depsField = jsonGetC(doc, "dependencies")
  match (depsField) {
    Some(deps) => return projectDepsOf(deps)?
    None => return []DepSpecNamed(0)
  }
}

function projectDepsOf(deps: Json): []DepSpecNamed! {
  let out = []DepSpecNamed(0)
  match (deps) {
    JsonObject(entries) => {
      for e of entries {
        let refStr = jsonAsString(e.value)
        match (refStr) {
          Some(specRef) => {
            let spec = parseSpec(specRef)?
            out = append(out, DepSpecNamed{ name: e.key, spec: spec })
          }
          None => fail newError("bit up: bit.json dependency '${e.key}' is not a string")
        }
      }
    }
    JsonNull => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonBool(b) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonInt(n) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonFloat(f) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonString(s) => fail newError("bit up: bit.json 'dependencies' is not an object")
    JsonArray(a) => fail newError("bit up: bit.json 'dependencies' is not an object")
  }
  return out
}

// `deps` narrowed to the single entry named `name`. Fails if there is none —
// `bit up <name>` on a dependency `bit.json` doesn't name is a usage error,
// not a silent no-op.
function onlyNamed(deps: []DepSpecNamed, name: string): []DepSpecNamed! {
  let i = 0
  while (i < len(deps)) {
    if (deps[i].name == name) {
      return [deps[i]]
    }
    i = i + 1
  }
  fail newError("bit up: no such dependency '${name}' in bit.json")
}

// `name`'s already-locked `url`, or `fallbackUrl` when bit.lock has no entry
// for it yet (a dependency added to bit.json by hand, never yet `add`ed or
// `up`ed) — `bit up` reuses the URL a dependency was ORIGINALLY fetched from
// rather than re-deriving it, so a non-standard-https remote (recorded once,
// at `add` time) survives every later refresh unchanged.
function existingUrlFor(entries: []LockEntry, name: string, fallbackUrl: string): string {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return entries[i].url
    }
    i = i + 1
  }
  return fallbackUrl
}

// `bit up`'s/`bit update`'s core: every dependency `bit.json` names (or, when
// `only` is non-empty, just that one) refreshed and rewritten into bit.lock.
// `bit.json` itself is never touched here — its `ref` per entry is exactly
// what was already there; only bit.lock's resolved commit and transitive
// requirements move. bit.lock is read once and written once regardless of how
// many dependencies are refreshed: each iteration folds its result into the
// same in-memory `entries` via `upsertLockEntry` (the same accumulate-in-
// memory-then-write-once shape `addDependency` uses for its own single entry)
// rather than each dependency doing its own read-resolve-write round trip.
// After every direct dependency is refreshed, `resolveTransitiveDeps`
// (#2251) walks and fetches whatever `requires` edges are now reachable but
// still missing a top-level entry, so `bit up` backfills a lock written
// before that walk existed, not just newly-added dependencies.
export function upDependencies(
  projectDir: string, cacheRoot: string, gitBin: string, only: string, timeoutMs: int,
): []UpResult! {
  let deps = projectDeps(projectDir)?
  if (len(only) > 0) {
    deps = onlyNamed(deps, only)?
  }

  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?

  let out = []UpResult(0)
  let i = 0
  while (i < len(deps)) {
    let d = deps[i]
    if (d.spec.vanity) {
      // A vanity name always re-resolves its `bit-import:` document (there is
      // no non-network way to "refresh" it); `resolveVanityDependency` is
      // what refuses a resolution that disagrees with the URL bit.lock
      // already records for this name.
      let entry = resolveVanityDependency(cacheRoot, gitBin, d.name, d.spec.vanityName, d.spec.ref, entries, timeoutMs)?
      entries = upsertLockEntry(entries, d.name, entry.url, entry.commit, entry.requires, entry.vanity)
      out = append(out, UpResult{ name: d.name, ref: d.spec.ref, url: entry.url, commit: entry.commit })
    } else {
      let fallbackUrl = defaultDepUrl(d.spec.host, d.spec.owner, d.spec.repo)
      let url = existingUrlFor(entries, d.name, fallbackUrl)
      // `bit up` has no `--url` escape hatch: it refreshes what bit.lock
      // already records, so the fetch reaches the same url it will write back.
      let entry = resolveDependency(
        cacheRoot, gitBin, d.name, d.spec.host, d.spec.owner, d.spec.repo, d.spec.ref, url,
        url, entries, timeoutMs,
      )?
      entries = upsertLockEntry(entries, d.name, entry.url, entry.commit, entry.requires, "")
      out = append(out, UpResult{ name: d.name, ref: d.spec.ref, url: entry.url, commit: entry.commit })
    }
    i = i + 1
  }

  // Backfill every transitive dependency reachable from what's now locked
  // (#2251) — not just the ones the loop above touched: a `bit.lock` written
  // before this walk existed (or one whose refreshed entries grew new
  // `requires`) is caught the same way, since the seed is every CURRENT
  // entry's own requirements, not only the ones `bit up` refreshed this run.
  entries = resolveTransitiveDeps(cacheRoot, gitBin, entries, flattenRequires(entries), timeoutMs)?

  writeLock(lockPath, entries)?
  return out
}

// ---- `bit remove` (#1736) ----------------------------------------------

// `bit remove <gitHost/owner/repo | name> [--dir <path>]`. Returns the
// process exit code: 2 on a usage error, 1 if the named dependency doesn't
// exist (or the write fails), 0 on success. Accepts either the bare
// dependency name (the key under `bit.json`'s `dependencies`) or a full
// `gitHost/owner/repo[@ref]` spec — only the trailing path segment (the repo
// name, which is also the key `bit add` stores it under) is ever used, so
// both spellings resolve to the same lookup.
function removeCmd(a: []string): int {
  if (len(a) < 3) {
    eprint("usage: bit remove <name> [--dir <path>]\n")
    return 2
  }
  // #2267: `--help`/`-h` in the name position must print usage, not be
  // looked up as a dependency name.
  if (pmIsHelpFlag(a[2])) {
    print("usage: bit remove <name> [--dir <path>]\n")
    return 0
  }
  // #2107: as in `addCmd` — a flag here would be looked up as a dependency.
  if (cliRejectFlagOperand("remove", a[2], "usage: bit remove <name> [--dir <path>]\n")) {
    return 2
  }
  let name = removeNameOf(a[2])
  let (projectDir, badArg, hasBadArg) = parseDirFlag(a, 3)
  if (hasBadArg) {
    eprint("bit remove: unexpected argument '${badArg}'\n")
    return 2
  }

  removeDependency(projectDir, name) catch e {
    eprint("bit remove: ${e.message()}\n")
    return 1
  }

  print("bit remove: ${name}\n")
  return 0
}

// The `bit.json` dependency key for a `bit remove` operand: the trailing
// `/`-separated segment with any `@ref` suffix stripped, so `bit remove
// github.com/byteink/quicwire@v1.4.2` and `bit remove quicwire` name the
// same entry `bit add` stored the dependency under (`addDependency` above
// always keys `bit.json`/`bit.lock` by `repo`, never the full spec).
function removeNameOf(operand: string): string {
  let s = operand
  let at = lastIndexByte(s, '@')
  if (at >= 0) {
    s = s[0:at]
  }
  let slash = lastIndexByte(s, '/')
  if (slash >= 0) {
    s = s[slash + 1:len(s)]
  }
  return s
}

// Deletes `name`'s entry from `<projectDir>/bit.json`'s `dependencies` object
// through the CST edit layer (every other byte of the file survives
// untouched) and drops its entry from `bit.lock`. Fails, rather than a silent
// no-op, when `name` is not present in `bit.json` — the same "bit.json is the
// source of truth" contract `rewriteManifest` follows for `bit add`. Does
// NOT touch the on-disk `~/.bit/pkg` cache; cache pruning is a separate
// concern (#1736's own scope note).
export function removeDependency(projectDir: string, name: string): ()! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit remove: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let root = cstParse(src)?
  match (cstGet(root, ["dependencies", name])) {
    Some(v) => {}
    None => fail newError("no dependency named '${name}' in bit.json")
  }
  let updated = cstDeleteKey(root, ["dependencies", name])?
  writeFile(path, cstPrint(updated))?

  // bit.json first here, the reverse of addDependency's bit.lock-first order
  // — deliberately, not an oversight. addDependency writes bit.lock first
  // because the risk it guards against is bit.json claiming a dependency
  // bit.lock never recorded. That risk doesn't exist in this direction: if
  // this writeLock call fails after the bit.json delete above already
  // succeeded, bit.lock is left with one HARMLESS extra entry for a
  // dependency bit.json no longer declares — never a dependency bit.json
  // claims but bit.lock lacks. The invariant addDependency's ordering
  // protects is preserved either way; only the failure mode's shape differs.
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  writeLock(lockPath, removeLockEntry(entries, name))?
}

// `entries` without the one named `name`, if present — a name absent from
// `bit.lock` (e.g. a dependency declared in `bit.json` but never locked) is
// not an error here: `bit.json` is already confirmed to have had the entry by
// `removeDependency`'s caller, and `bit.lock` is fully machine-owned, so
// there is nothing to remove is a legitimate, silent outcome for THIS file.
function removeLockEntry(entries: []LockEntry, name: string): []LockEntry {
  let out = []LockEntry(0)
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name != name) {
      out = append(out, entries[i])
    }
    i = i + 1
  }
  return out
}
