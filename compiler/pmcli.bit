// compiler/pmcli.bit — `bit add` (#1734), epic #1480. Wires together the
// pieces landed by the sibling package-manager tasks into an end-to-end
// command:
//   - compiler/pmfetch.bit (#1733): parses `gitHost/owner/repo@ref`, resolves
//     `ref` to a commit sha, fetches it into the content-addressed cache.
//   - compiler/pmresolve.bit (#1731): Minimal Version Selection, used here to
//     confirm the version being added doesn't undercut something an existing
//     locked dependency already transitively requires.
//   - compiler/pmlock.bit (#1732): reads/writes bit.lock.
//   - stdlib/json's CST edit layer (#1725/#1726, epic #1479): the ONLY way
//     bit.json is ever rewritten — cstParse -> cstSetStringPath -> cstPrint,
//     never a plain parse-modify-reserialize, so a user's comments and
//     formatting survive except the one entry actually changed.
//   - compiler/pmz.bit (#2472): the resolve-one-dependency, transitive-walk
//     and MVS-conflict-check engine `bit add` calls into — split out here
//     only because this file outgrew the 800-line limit; it is the same
//     module, so every function below still calls it unqualified.
// `bit up`/`bit update` (#1735) and `bit remove` (#1736) moved out to
// compiler/pmcliup.bit and compiler/pmcliremove.bit (#2967 — this file
// crossed the 800-line limit again after #2244 landed dependency-spec forms).
// Same module, sibling files: every helper still shared with them
// (`pmIsHelpFlag`, `parseDirFlag`, `upsertLockEntry`, this file's own
// `import` group) stays here and is called from there unqualified.
// No code from a fetched dependency is ever executed: pmfetch.bit already
// refuses to run anything from a fetched checkout (no build/postinstall
// scripts), and nothing below adds a new execution path.
import {
  CstEntry,
  CstNode,
  Trivia,
  cstDeleteKey,
  cstGet,
  cstParse,
  cstPrint,
  cstSetStringPath,
  Json,
  jsoncParse,
  jsonGet as jsonGetC,
  jsonAsString,
} from "std/json"

const pmCliDefaultTimeoutMs: int = 30000

// One dependency this run added or updated — enough to print a confirmation
// and to hand to both the bit.json rewrite and the bit.lock upsert.
class AddResult { name: string, specRef: string, url: string, commit: string }

// ---- CLI entry --------------------------------------------------------

// `bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]`.
// `--url`, when given, is the URL actually fetched from instead of the
// `https://<host>/<owner>/<repo>.git` the spec derives — a CLI-only escape
// hatch for a private registry mirror or a `file://` fixture in a test. It is
// never recorded: `bit.json`'s dependency grammar (spec §17.7) has no field
// for a URL at all, and `bit.lock`'s `url` field keeps recording the derived
// `https://` URL so the lockfile stays reproducible from `bit.json` alone,
// exactly as spec §17.7 documents it, even on a run that used the override.
// Returns the process exit code: 2 on a usage error, 1 on a fetch/resolve/
// write failure, 0 on success.
fn addCmd(a: []string): int {
  if (len(a) < 3) {
    eprint("usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n")
    return 2
  }
  let specArg = a[2]
  // #2267: `--help`/`-h` in the spec position must print usage, not be parsed
  // as a dependency spec — before this, `bit add --help` failed with "bit
  // add: pmfetch: dependency spec must be gitHost/owner/repo@ref: --help@HEAD",
  // which reads as a spec-syntax error about a package named "--help".
  if (pmIsHelpFlag(specArg)) {
    print("usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n")
    return 0
  }
  // #2107: any OTHER flag here is a usage error, not a package name. This is
  // the one operand position in the CLI where the mistake reached the network.
  if (cliRejectFlagOperand(
    "add", specArg,
    "usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>] [--url <override>]\n",
  )) {
    return 2
  }
  let (projectDir, urlOverride, badArg, hasBadArg) = parseAddFlags(a, 3)
  if (hasBadArg) {
    eprint("bit add: unexpected argument '${badArg}'\n")
    return 2
  }

  let hadRef = hasExplicitRef(specArg)
  let d = parseAddSpec(specArg) catch e {
    eprint("bit add: ${e.message()}\n")
    return 2
  }

  // A local filesystem / "file://" dependency (#2244) never fetches at all —
  // no cache root, no `git`, no network — so it is dispatched before either
  // is even resolved.
  if (d.scheme == "local") {
    if (len(urlOverride) > 0) {
      eprint("bit add: --url is not supported for a local path dependency\n")
      return 2
    }
    let name = pmLocalDepName(d.localPath)
    let cacheRoot = defaultCacheRoot() catch e {
      eprint("bit add: ${e.message()}\n")
      return 1
    }
    let result = addLocalDependency(
      projectDir, cacheRoot, defaultGitBin, name, specArg, d.localPath, pmCliDefaultTimeoutMs,
    ) catch e {
      eprint("bit add: ${e.message()}\n")
      return 1
    }
    print("bit add: ${result.name} -> ${result.specRef} (local path)\n")
    return 0
  }

  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  // A vanity name (SPEC §17.7) resolves over HTTPS instead of deriving a URL
  // from a known git host, so it takes its own path — `--url`'s escape hatch
  // exists to override where a DIRECT spec's derived URL fetches from, and
  // has no equivalent meaning once the URL itself comes from a resolved
  // `bit-import:` document.
  if (d.vanity) {
    if (len(urlOverride) > 0) {
      eprint("bit add: --url is not supported for a vanity dependency\n")
      return 2
    }
    let name = pmLastSegment(d.vanityName)
    let result = addVanityDependency(
      projectDir, cacheRoot, defaultGitBin, name, d.vanityName, hadRef, d.ref, pmCliDefaultTimeoutMs,
    ) catch e {
      eprint("bit add: ${e.message()}\n")
      return 1
    }
    print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
    return 0
  }

  // An explicit ssh:// spec (#2244) shares `addDependency` unchanged with the
  // https direct form below — `fetchSha`/`resolveDependencyRef` pass `url`
  // straight to `git`, which handles an `ssh://` remote identically to an
  // `https://` one, so only the URL this branch constructs differs.
  if (d.scheme == "ssh") {
    let url = sshDepUrl(d.sshUser, d.host, d.owner, d.repo)
    let fetchUrl = url
    if (len(urlOverride) > 0) {
      fetchUrl = urlOverride
    }
    let result = addDependency(
      projectDir, cacheRoot, defaultGitBin,
      d.host, d.owner, d.repo, hadRef, d.ref, url, fetchUrl,
      pmCliDefaultTimeoutMs,
    ) catch e {
      eprint("bit add: ${e.message()}\n")
      return 1
    }
    print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
    return 0
  }

  let url = defaultDepUrl(d.host, d.owner, d.repo)
  let fetchUrl = url
  if (len(urlOverride) > 0) {
    fetchUrl = urlOverride
  }

  let result = addDependency(
    projectDir, cacheRoot, defaultGitBin,
    d.host, d.owner, d.repo, hadRef, d.ref, url, fetchUrl,
    pmCliDefaultTimeoutMs,
  ) catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
  return 0
}

// The trailing `/`-separated segment of a vanity path, e.g. `"http"` for
// `"bitlang.org/pkg/http"` — the `bit.json`/`bit.lock` key a vanity `bit add`
// stores a dependency under, mirroring how a direct spec keys by `repo`
// (`addDependency`'s own `let name = repo`). A SPEC §17.7 vanity name is
// '/'-separated by the wire format on every host, forever (#4187) — this
// must NEVER treat '\' as a separator, even on Windows, unlike the real
// local-filesystem-path variant below.
fn pmLastSegment(path: string): string {
  let slash = lastIndexByte(path, '/')
  if (slash >= 0) {
    return path[slash + 1:len(path)]
  }
  return path
}

// The `bit.json`/`bit.lock` key a local-path `bit add` stores a dependency
// under (#2244): the final path component of a REAL OS filesystem path,
// mirroring how a direct spec keys by `repo` and a vanity spec keys by its
// trailing segment (`pmLastSegment`, above). Unlike `pmLastSegment`, this
// must recognize '\' as a separator too on a native Windows host, or
// `bit add C:\Users\me\textutil` derives the wrong dependency name (#4187)
// — so it is its own function rather than sharing `pmLastSegment`, which
// stays '/'-only on every host by design. Delegates to mainpaths.bit's
// `isPathSepByte(b, hostBackslashSep())`, the same host-conditional
// separator decision `pathDir`/`pathBase`/`pathStem` already use, rather
// than inventing a second convention. A trailing separator is stripped
// first so "../textutil/" and "../textutil" (or, on Windows,
// "..\textutil\" and "..\textutil") name the same key.
fn pmLocalDepName(path: string): string {
  let winSep = hostBackslashSep()
  let b = []byte(path)
  let end = len(b)
  if (end > 0 && isPathSepByte(b[end - 1], winSep)) {
    end = end - 1
  }
  let start = 0
  let i = 0
  while (i < end) {
    if (isPathSepByte(b[i], winSep)) {
      start = i + 1
    }
    i = i + 1
  }
  return path[start:end]
}

// Shared by `addCmd`, `upCmd` and `removeCmd` (#2267): whether `s` is a help
// flag in the position each command would otherwise parse as its own operand
// (a dependency spec/name). Only the exact long and short forms main.bit's
// other subcommands already respond to (e.g. `bit ar`'s own usage line) —
// never a prefix match, so a dependency genuinely named `--help` (unlikely,
// but not disallowed by SPEC §17.7's segment charset) is never silently
// unreachable.
fn pmIsHelpFlag(s: string): bool {
  return s == "--help" || s == "-h"
}

// Shared by `addCmd`, `upCmd` and `removeCmd`: `a[start:]` is either empty or
// exactly `--dir <path>`, the one flag all three subcommands accept. Returns
// the resolved project directory (`"."` if `--dir` was never given), the
// offending trailing argument (if any), and whether one was found — a bool,
// not an empty-string sentinel on `badArg`, because an empty string is itself
// a legal (if useless) argv entry and would otherwise be silently swallowed
// instead of rejected. The caller prefixes `badArg` with its own subcommand
// name to keep `bit add: ...` vs `bit up: ...` vs `bit remove: ...` error
// text distinct without duplicating this loop.
fn parseDirFlag(a: []string, start: int): (string, string, bool) {
  let projectDir = "."
  let ai = start
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else {
      return projectDir, a[ai], true
    }
  }
  return projectDir, "", false
}

// `addCmd`-only: like `parseDirFlag`, but also accepts `--url <override>`
// (interleaved with `--dir` in any order) — the CLI-only fetch-URL escape
// hatch documented on `addCmd`. `removeCmd` has no use for a fetch URL and
// keeps using the plain `parseDirFlag` above. Returns the project directory,
// the URL override (`""` if `--url` was never given), the offending trailing
// argument, and whether one was found — same not-a-sentinel reasoning as
// `parseDirFlag`.
fn parseAddFlags(a: []string, start: int): (string, string, string, bool) {
  let projectDir = "."
  let urlOverride = ""
  let ai = start
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else if (a[ai] == "--url" && ai + 1 < len(a)) {
      urlOverride = a[ai + 1]
      ai = ai + 2
    } else {
      return projectDir, urlOverride, a[ai], true
    }
  }
  return projectDir, urlOverride, "", false
}

// `gitHost/owner/repo[@ref]` — like pmfetch.bit's own `parseSpec`, but `ref`
// is OPTIONAL here (ticket #1734, step 1: default to the remote's default
// branch HEAD). `resolveDependencyRef` already knows how to resolve the
// pseudo-ref `"HEAD"` (`git ls-remote <url> HEAD`), so this is a thin wrapper
// around `parseSpec`, not a fork of its validation.
//
// A local spec (#2244, `isLocalSpecPrefix`) is checked FIRST and never gets
// "@HEAD" appended: it has no ref concept at all (`parseLocalSpec`'s own
// comment), and blindly appending would corrupt the path itself (a real
// directory named "…@HEAD" is not what the user typed). For every other
// form, "already has a ref" is `hasExplicitRef` (pmfetch.bit) rather than a
// bare `lastIndexByte(spec, '@') >= 0` check — an `ssh://user@host/...` spec
// with NO ref contains an "@" too (the user separator), which the bare check
// would misread as "ref already given" and leave unresolved to "HEAD".
fn parseAddSpec(spec: string): DepSpec! {
  if (isLocalSpecPrefix(spec)) {
    return parseSpec(spec)?
  }
  if (hasExplicitRef(spec)) {
    return parseSpec(spec)?
  }
  return parseSpec(spec + "@HEAD")?
}

// ---- the add flow, independent of argv/exit codes ---------------------

// Steps (ticket #1734, ref resolution rewritten by #2367):
//  1. resolve what to fetch and what to write (`resolveAddRef`, below).
//     `hasRef` false (no `@ref` in the user's spec) means "the newest
//     available version" — `resolveAddRef` lists the target's tags
//     (pmfetchresolve.bit's `listVersions`, #2365) and picks the highest,
//     writing a caret constraint; an explicit `^`/`~`/exact version resolves
//     the highest tag satisfying IT, writing the constraint back canonically
//     (never a `v` prefix); an explicit branch name or bare commit sha is
//     not a version at all and passes through verbatim, exactly as before
//     this ticket.
//  2. fetch the resolved ref into the content-addressed cache
//     (pmfetch.fetchSha, via `resolveDependency`).
//  3. read the fetched dependency's own bit.json requirements (if any) and
//     confirm this add doesn't conflict with a version some existing locked
//     dependency already transitively requires (pmresolve.resolvePubGrub,
//     #2366) — non-version refs (a branch or bare sha) are not ordered
//     versions and are not run through it, matching spec §17.7 point 2.
//  4. rewrite bit.json's `dependencies.<name>` entry through the CST edit
//     layer, preserving every other byte.
//  5. walk the fetched dependency's own `requires` — and every dependency
//     THEY require, recursively — fetching and locking each one that has no
//     top-level bit.lock entry yet (`resolveTransitiveDeps`, #2251); a name
//     required at more than one (here, always exact) version resolves via
//     `resolvePubGrub`, failing the whole add if two disagree.
//  6. regenerate bit.lock (pmlock.writeLock) with the resolved commit, the
//     fetched dependency's own transitive requirements, and every
//     transitive dependency step 5 resolved.
//
// `url` and `fetchUrl` are plain parameters, not derived here — the same
// layering pmfetch.bit itself uses (its `DepSpec` never carries a url
// either) — so this is directly testable against a `file://` fixture
// (pmclicheck.bit) without needing a real `https://` remote. `addCmd` above
// always derives `url` as `https://<host>/<owner>/<repo>.git`, per SPEC
// §17.7's git-only registry model; `fetchUrl` is the same value unless its
// `--url` escape hatch overrode it. The two are kept apart deliberately:
// `fetchUrl` is where the fetch actually reaches (below), `url` is what ends
// up in `bit.lock` (`upsertLockEntry`, at the bottom of this function) — so
// an override never leaks into a written file, only into where this one run
// looked.
export fn addDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  host: string, owner: string, repo: string, hasRef: bool, rawRef: string,
  url: string, fetchUrl: string, timeoutMs: int,
): AddResult! {
  // #2751: checked before anything else in this function — no fetch, no
  // cache write, no bit.lock write — so a project with no bit.json (or an
  // unparsable one) is rejected before any of those happen, not after.
  checkManifestExists(projectDir)?
  let name = repo
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let resolvedRef = resolveAddRef(gitBin, fetchUrl, hasRef, rawRef, timeoutMs)?
  let entry = resolveDependency(
    cacheRoot,
    gitBin,
    name,
    host,
    owner,
    repo,
    resolvedRef.fetchRef,
    url,
    fetchUrl,
    entries,
    timeoutMs,
  )?

  // bit.lock first, bit.json second: bit.lock is fully machine-owned and
  // regenerated on every add/up/remove (pmlock.bit's own contract), so a
  // failure right after this write is self-healing — the next run recomputes
  // it from whatever bit.json says. The reverse order would risk bit.json
  // claiming a dependency bit.lock never recorded, a silent mismatch with no
  // rollback.
  let updated = upsertLockEntry(
    entries,
    name,
    entry.url,
    entry.commit,
    resolvedRef.resolvedVersion,
    entry.requires,
    "",
    "",
    "",
  )
  let resolved = resolveTransitiveDeps(
    cacheRoot,
    gitBin,
    updated,
    flattenRequires(updated),
    timeoutMs,
  )?
  writeLock(lockPath, resolved)?

  let specRef = "${host}/${owner}/${repo}@${resolvedRef.writtenRef}"
  rewriteManifest(projectDir, name, specRef)?

  return AddResult{ name: name, specRef: specRef, url: url, commit: entry.commit }
}

// `bit add`'s vanity counterpart to `addDependency` (SPEC §17.7, #2068):
// resolves `vanityName` to a git URL through its `bit-import:` document
// (pmfetch.bit's `resolveVanityUrl`) instead of deriving one from a known
// git host, then runs the same fetch/MVS/bit.lock/bit.json sequence
// `addDependency` runs for a direct spec. `name` is the `bit.json`/
// `bit.lock` key — `addCmd`'s `pmLastSegment(d.vanityName)`, mirroring how a
// direct spec keys by `repo`.
//
// `resolveVanityUrl` is called exactly ONCE, here — its `doc.gitUrl` feeds
// both `resolveAddRef` (listing tags for a version-constrained ref, #2367)
// and `resolveVanityDependency` (the actual fetch), which now takes an
// already-resolved `VanityDoc` rather than re-resolving it (pmz.bit): a
// second real HTTPS GET would be wrong regardless of cost, since a fixture
// that serves exactly one vanity-document request would fail it.
export fn addVanityDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  name: string, vanityName: string, hasRef: bool, rawRef: string, timeoutMs: int,
): AddResult! {
  // #2751: same precondition, checked first, as addDependency above.
  checkManifestExists(projectDir)?
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let doc = resolveVanityUrl(vanityName, vanityTimeoutMs)?
  let resolvedRef = resolveAddRef(gitBin, doc.gitUrl, hasRef, rawRef, timeoutMs)?
  let entry = resolveVanityDependency(
    cacheRoot,
    gitBin,
    name,
    vanityName,
    doc,
    resolvedRef.fetchRef,
    entries,
    timeoutMs,
  )?

  // Same bit.lock-first, bit.json-second ordering as `addDependency`, and
  // for the same reason: bit.lock is fully machine-owned and self-healing on
  // the next run, so a failure right after this write never leaves bit.json
  // claiming a dependency bit.lock does not record.
  let updated = upsertLockEntry(
    entries,
    name,
    entry.url,
    entry.commit,
    resolvedRef.resolvedVersion,
    entry.requires,
    entry.vanity,
    entry.localPath,
    entry.dir,
  )
  let resolved = resolveTransitiveDeps(
    cacheRoot,
    gitBin,
    updated,
    flattenRequires(updated),
    timeoutMs,
  )?
  writeLock(lockPath, resolved)?

  let specRef = "${vanityName}@${resolvedRef.writtenRef}"
  rewriteManifest(projectDir, name, specRef)?

  return AddResult{ name: name, specRef: specRef, url: entry.url, commit: entry.commit }
}

