fn checkObjectMath() {
  checkObjectAdd()
  checkObjectMul()
  checkObjectAlign()
  checkObjectBacked()
  checkObjectBss()
  checkObjectFixups()
}

fn checkObjectAdd() {
  let max = vI64Max()
  assert(
      (objectAdd(max - 1, 1, max) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (objectAdd(max, 1, max) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectAdd(-1, 0, max) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectMul() {
  let max = vI64Max()
  assert(
      (objectMul(max / 8, 8, max) catch _ {
        -1
      }) ==
      max / 8 * 8,
  )
  assert(
      (objectMul(max / 8 + 1, 8, max) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectMul(-1, 0, max) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectAlign() {
  let max = vI64Max()
  assert(
      (objectAlign(max - 7, 8, max) catch _ {
        -1
      }) ==
      max - 7,
  )
  assert(
      (objectAlign(max - 6, 8, max) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectAlign(0, 0, max) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectAlign(0, 3, max) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectBacked() {
  let backed = objectByteLimit()
  assert(
      (objectGlobalEnd(backed - 8, 8, 8, backed) catch _ {
        -1
      }) ==
      backed,
  )
  assert(
      (objectGlobalEnd(backed, 1, 1, backed) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectBss() {
  let max = vI64Max()
  assert(
      (objectGlobalEnd(max - 8, 8, 1, max) catch _ {
        -1
      }) ==
      max,
  )
  assert(
      (objectGlobalEnd(max, 1, 1, max) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectFixups() {
  let max = vI64Max()
  let backed = objectByteLimit()
  assert(
      (objectFixupOffset(8, 0, backed - 8) catch _ {
        -1
      }) ==
      backed - 8,
  )
  assert(
      (objectFixupOffset(8, -1, 0) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectFixupOffset(8, max, 0) catch _ {
        -1
      }) ==
      -1,
  )
  assert(
      (objectFixupOffset(16, 8, backed) catch _ {
        -1
      }) ==
      -1,
  )
}

fn checkObjectRefusals() {
  for storage of [0, 1, storageReadonly()] {
    let mod = roTestModule()
    mod.globals[0].storage = storage
    mod.globals[0].align = 0
    for target of [ElfTarget.X86_64, ElfTarget.Aarch64] {
      let obj = emitElfObject(mod, target, false, false, false) catch e {
        assert(e.message() == "ObjectSizeOverflow")
        []u8(0)
      }
      assert(len(obj) == 0)
    }
    if (storage == 1) {
      continue
    }
    let macho = emitMachoObject(mod, false, false, false) catch e {
      assert(e.message() == "ObjectSizeOverflow")
      []u8(0)
    }
    assert(len(macho) == 0)
    let pe = emitPeObject(mod, false, false, false) catch e {
      assert(e.message() == "ObjectSizeOverflow")
      []u8(0)
    }
    assert(len(pe) == 0)
  }
}

fn checkObjectPlacements() {
  let mod = roTestModule()
  let buf = newByteBuf()
  buf.bytes = [u8(91)]
  let ro = placeReadonlyGlobals(mod, buf, false) catch _ {
    assert(false)
    return
  }
  assert(ro.placements[0].offset == 16)
  assert(len(buf.bytes) == 40 && buf.bytes[0] == u8(91))
  mod.globals[0].storage = 0
  let split = placeGlobals(mod, 0, newByteBuf(), false, true) catch _ {
    assert(false)
    return
  }
  assert(len(split.data) == 1 && split.data[0].offset == 0 && split.bssSize == 0)
  mod.globals[0].bytes = []int(8)
  let zero = placeGlobals(mod, 0, newByteBuf(), false, true) catch _ {
    assert(false)
    return
  }
  assert(len(zero.bss) == 1 && zero.bssSize == 8 && len(zero.data) == 0)
  checkObjectInvalidFixups()
}

fn checkObjectInvalidFixups() {
  for storage of [0, storageReadonly()] {
    for offset of [-1, 1, vI64Max()] {
      let mod = roTestModule()
      let bad = IrGlobal{
        name = "bad", bytes = []int(8), align = 8, storage = storage,
        relocs = [IrGlobalReloc{ offset = offset, symbol = "bad", addend = 0 }],
      }
      mod.globals[0].storage = storage
      mod.globals = append(mod.globals, bad)
      let buf = newByteBuf()
      buf.bytes = [u8(91)]
      let refused = false
      if (storage == storageReadonly()) {
        placeReadonlyGlobals(mod, buf, false) catch _ {
          refused = true
        }
      } else {
        placeGlobals(mod, storage, buf, false, true) catch _ {
          refused = true
        }
      }
      assert(refused)
      assert(len(buf.bytes) == 1 && buf.bytes[0] == u8(91))
    }
  }
}
