// In-Bit self-checks for the PubGrub resolver (#2366, replacing the MVS
// checks this file used to carry — `checkPmResolveMax`/`Diamond`/
// `Deterministic` described MVS's max-of-minimums behaviour, which no
// longer exists). Run by `selfcheck()` under `./make test`; a failed
// `assert` panics with exit 2. Sibling of pmresolve.bit/pmresolvesolve.bit/
// pmresolveexplain.bit, same module.
//
// Per the ticket's own instruction, the unsatisfiable cases below assert on
// the ACTUAL structured failure (`ResolveFailure.package`/`.requirers`) —
// never a substring of `.message` alone — plus one direct check on rendered
// text where structure genuinely has nothing else to assert (the missing-
// version case: there is no second stated requirement to name, only the
// fact that reality has no matching version).

fn pgV(major: int, minor: int, patch: int): Version {
  return Version{ major: major, minor: minor, patch: patch }
}

fn pgCaret(major: int, minor: int, patch: int): Constraint {
  return Constraint{ op: ConstraintOp.Caret, version: pgV(major, minor, patch) }
}

fn pgExact(major: int, minor: int, patch: int): Constraint {
  return Constraint{ op: ConstraintOp.Exact, version: pgV(major, minor, patch) }
}

fn pgReq(name: string, c: Constraint): Requirement {
  return Requirement{ name: name, constraint: c }
}

fn pgRoot(requirer: string, name: string, c: Constraint): RootRequirement {
  return RootRequirement{ requirer: requirer, name: name, constraint: c }
}

fn pgAvail(name: string, versions: []Version): PackageVersions {
  return PackageVersions{ name: name, versions: versions }
}

fn pgModule(name: string, v: Version, requires: []Requirement): ModuleReqs {
  return ModuleReqs{ name: name, version: v, requires: requires }
}

// Finds `name` among a failure's `requirers`, panicking (not just failing an
// assert) if absent — so a missing entry is reported with the name that was
// missing, not a bare "assertion failed".
fn pgFindRequirer(rs: []ConflictRequirer, requirer: string, name: string): ConflictRequirer {
  let i = 0
  while (i < len(rs)) {
    if (rs[i].requirer == requirer && rs[i].name == name) {
      return rs[i]
    }
    i = i + 1
  }
  panic("pmresolvecheck: no requirer '${requirer}' naming '${name}' in the failure's requirers")
}

fn pgAssertOk(
  result: Result<map<string, Version>, ResolveFailure>,
  label: string,
): map<string, Version> {
  match (result) {
    Ok(resolved) => { return resolved }
    Err(f) => {
      panic("pmresolvecheck: ${label}: expected success, got failure naming '${f.package}': " + f.message)
    }
  }
}

fn pgAssertErr(
  result: Result<map<string, Version>, ResolveFailure>,
  label: string,
): ResolveFailure {
  match (result) {
    Ok(_) => {
      panic("pmresolvecheck: ${label}: expected an unsatisfiable failure, resolution succeeded")
    }
    Err(f) => { return f }
  }
}

// Ticket acceptance #1: a diamond where two requirers' ranges overlap
// (`^1.2.0` and `^1.4.0`, 1.5.0 available) resolves to the single highest
// satisfying version — owner decision 2026-08-09.
fn checkPubGrubDiamondOverlapResolvesHighest() {
  let graph = ReqGraph{
    rootRequires: [
      pgRoot("root", "app", pgExact(1, 0, 0)),
      pgRoot("root", "lib", pgExact(1, 0, 0)),
    ],
    modules: [
      pgModule("app", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 2, 0))]),
      pgModule("lib", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 4, 0))]),
    ],
    available: [
      pgAvail("app", [pgV(1, 0, 0)]), pgAvail("lib", [pgV(1, 0, 0)]),
      pgAvail("foo", [pgV(1, 2, 0), pgV(1, 4, 0), pgV(1, 5, 0)]),
    ],
  }
  let resolved = pgAssertOk(resolvePubGrub(graph), "diamond overlap")
  let (foo, ok) = resolved["foo"]
  assert(ok)
  assert(versionEq(foo, pgV(1, 5, 0)))
}

// Case 1 (dispatch): a direct conflict — two requirers state incompatible
// constraints on the SAME package with no transitive chain at all. Mirrors
// compiler/pmz.bit's real shape: a fresh `bit add` (requirer "root") against
// an already-locked dependency's own transitive requirement (requirer
// "existing").
fn checkPubGrubDirectConflict() {
  let graph = ReqGraph{
    rootRequires: [
      pgRoot("root", "x", pgCaret(1, 0, 0)),
      pgRoot("existing", "x", pgCaret(2, 0, 0)),
    ],
    modules: []ModuleReqs(0),
    available: [pgAvail("x", [pgV(1, 0, 0), pgV(2, 0, 0)])],
  }
  let f = pgAssertErr(resolvePubGrub(graph), "direct conflict")
  assert(f.package == "x")
  assert(len(f.requirers) == 2)
  let r1 = pgFindRequirer(f.requirers, "root", "x")
  assert(r1.constraint.op == ConstraintOp.Caret && versionEq(r1.constraint.version, pgV(1, 0, 0)))
  let r2 = pgFindRequirer(f.requirers, "existing", "x")
  assert(r2.constraint.op == ConstraintOp.Caret && versionEq(r2.constraint.version, pgV(2, 0, 0)))
}

// Case 2 (dispatch): a transitive conflict three levels deep. root -> a ->
// b -> c (^1.0.0), and root ALSO requires c (^2.0.0) directly — the
// conflict is only visible after walking three hops down from `a`.
fn checkPubGrubTransitiveConflictThreeLevels() {
  let graph = ReqGraph{
    rootRequires: [pgRoot("root", "a", pgExact(1, 0, 0)), pgRoot("root", "c", pgCaret(2, 0, 0))],
    modules: [
      pgModule("a", pgV(1, 0, 0), [pgReq("b", pgExact(1, 0, 0))]),
      pgModule("b", pgV(1, 0, 0), [pgReq("c", pgCaret(1, 0, 0))]),
    ],
    available: [
      pgAvail("a", [pgV(1, 0, 0)]), pgAvail("b", [pgV(1, 0, 0)]),
      pgAvail("c", [pgV(1, 0, 0), pgV(2, 0, 0)]),
    ],
  }
  let f = pgAssertErr(resolvePubGrub(graph), "transitive conflict, three levels deep")
  assert(f.package == "c")
  // See the identical note in checkPubGrubDiamondBothPathsIndividuallySatisfiable:
  // the chain can legitimately also carry `a`'s own root requirement and
  // `a`'s dependency on `b`, neither of which conflicts with itself.
  assert(len(f.requirers) >= 2)
  let r1 = pgFindRequirer(f.requirers, "b 1.0.0", "c")
  assert(r1.constraint.op == ConstraintOp.Caret && versionEq(r1.constraint.version, pgV(1, 0, 0)))
  let r2 = pgFindRequirer(f.requirers, "root", "c")
  assert(r2.constraint.op == ConstraintOp.Caret && versionEq(r2.constraint.version, pgV(2, 0, 0)))
}

// Ticket acceptance #2 / dispatch case 3: an unsatisfiable diamond
// (`^1.0.0` and `^2.0.0`) where BOTH paths are individually satisfiable —
// D has real candidates in each requester's own range (1.5.0 for `^1.0.0`,
// 2.5.0 for `^2.0.0`) — yet no single version satisfies both at once, since
// Bit links with a flat namespace and a package resolves to exactly one
// version.
fn checkPubGrubDiamondBothPathsIndividuallySatisfiable() {
  let graph = ReqGraph{
    rootRequires: [pgRoot("root", "b", pgExact(1, 0, 0)), pgRoot("root", "c", pgExact(1, 0, 0))],
    modules: [
      pgModule("b", pgV(1, 0, 0), [pgReq("d", pgCaret(1, 0, 0))]),
      pgModule("c", pgV(1, 0, 0), [pgReq("d", pgCaret(2, 0, 0))]),
    ],
    available: [
      pgAvail("b", [pgV(1, 0, 0)]), pgAvail("c", [pgV(1, 0, 0)]),
      pgAvail("d", [pgV(1, 5, 0), pgV(2, 5, 0)]),
    ],
  }
  let f = pgAssertErr(resolvePubGrub(graph), "diamond, both paths individually satisfiable")
  assert(f.package == "d")
  // The derivation chain conflict resolution walks can legitimately pass
  // through packages that never conflict with themselves (`b` and `c`
  // here, each pinned to a single exact version root-side) on its way to
  // the real disagreement over `d` — see `pickDisputedPackage`
  // (pmresolveexplain.bit) for why `.package` is still correctly "d"
  // regardless. So this asserts at least the two requirements that
  // actually disagree are present, not an exact count.
  assert(len(f.requirers) >= 2)
  let r1 = pgFindRequirer(f.requirers, "b 1.0.0", "d")
  assert(r1.constraint.op == ConstraintOp.Caret && versionEq(r1.constraint.version, pgV(1, 0, 0)))
  let r2 = pgFindRequirer(f.requirers, "c 1.0.0", "d")
  assert(r2.constraint.op == ConstraintOp.Caret && versionEq(r2.constraint.version, pgV(2, 0, 0)))
}

// Case 4 (dispatch): a conflict caused by a version that does not exist at
// all — root requires x `^3.0.0`, but only 1.x/2.x are ever published.
// There is no second STATED requirement to name here (the other side of the
// conflict is reality, not a requirer), so this asserts on the package and
// on the rendered "no available version" step rather than on a second
// `ConflictRequirer`.
fn checkPubGrubMissingVersionConflict() {
  let graph = ReqGraph{
    rootRequires: [pgRoot("root", "x", pgCaret(3, 0, 0))],
    modules: []ModuleReqs(0),
    available: [pgAvail("x", [pgV(1, 0, 0), pgV(2, 0, 0)])],
  }
  let f = pgAssertErr(resolvePubGrub(graph), "missing version")
  assert(f.package == "x")
  assert(len(f.requirers) == 1)
  let r1 = pgFindRequirer(f.requirers, "root", "x")
  assert(r1.constraint.op == ConstraintOp.Caret && versionEq(r1.constraint.version, pgV(3, 0, 0)))
  let hasNoVersionsStep = false
  let i = 0
  while (i < len(f.steps)) {
    if (contains(f.steps[i].text, "no available version of x")) {
      hasNoVersionsStep = true
    }
    i = i + 1
  }
  assert(hasNoVersionsStep)
}

// Ticket acceptance #3: resolution is deterministic — the same graph
// presented with its requirements (and available-versions list) in a
// different order yields the identical resolved map.
fn checkPubGrubDeterministic() {
  let g1 = ReqGraph{
    rootRequires: [
      pgRoot("root", "app", pgExact(1, 0, 0)),
      pgRoot("root", "lib", pgExact(1, 0, 0)),
    ],
    modules: [
      pgModule("app", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 2, 0))]),
      pgModule("lib", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 4, 0))]),
    ],
    available: [
      pgAvail("app", [pgV(1, 0, 0)]), pgAvail("lib", [pgV(1, 0, 0)]),
      pgAvail("foo", [pgV(1, 2, 0), pgV(1, 4, 0), pgV(1, 5, 0)]),
    ],
  }
  let g2 = ReqGraph{
    rootRequires: [
      pgRoot("root", "lib", pgExact(1, 0, 0)),
      pgRoot("root", "app", pgExact(1, 0, 0)),
    ],
    modules: [
      pgModule("lib", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 4, 0))]),
      pgModule("app", pgV(1, 0, 0), [pgReq("foo", pgCaret(1, 2, 0))]),
    ],
    available: [
      pgAvail("foo", [pgV(1, 5, 0), pgV(1, 2, 0), pgV(1, 4, 0)]),
      pgAvail("lib", [pgV(1, 0, 0)]), pgAvail("app", [pgV(1, 0, 0)]),
    ],
  }
  let r1 = pgAssertOk(resolvePubGrub(g1), "deterministic (order 1)")
  let r2 = pgAssertOk(resolvePubGrub(g2), "deterministic (order 2)")
  let (foo1, ok1) = r1["foo"]
  let (foo2, ok2) = r2["foo"]
  assert(ok1 && ok2)
  assert(versionEq(foo1, foo2))
  let (app1, okA1) = r1["app"]
  let (app2, okA2) = r2["app"]
  assert(okA1 && okA2)
  assert(versionEq(app1, app2))
}

// Not a ticket-required case, but the one that caught a real bug in
// `previousSatisfierLevel`'s no-other-terms default while this ticket was
// being built: `d`'s HIGHEST candidate (1.9.0) has its own transitive
// dependency that cannot be met, forcing a backtrack to `d`'s NEXT
// candidate (1.5.0), which succeeds. A resolver that only ever backtracks
// to failure never exercises retry-at-a-lower-candidate at all.
fn checkPubGrubBacktrackRetriesLowerCandidate() {
  let graph = ReqGraph{
    rootRequires: [pgRoot("root", "b", pgExact(1, 0, 0))],
    modules: [
      pgModule("b", pgV(1, 0, 0), [pgReq("d", pgCaret(1, 0, 0))]),
      pgModule("d", pgV(1, 9, 0), [pgReq("z", pgCaret(2, 0, 0))]),
      pgModule("d", pgV(1, 5, 0), [pgReq("z", pgCaret(1, 0, 0))]),
    ],
    available: [
      pgAvail("b", [pgV(1, 0, 0)]), pgAvail("d", [pgV(1, 5, 0), pgV(1, 9, 0)]), pgAvail(
        "z",
        [pgV(1, 0, 0)],
      ),
    ],
  }
  let resolved = pgAssertOk(resolvePubGrub(graph), "backtrack retries lower candidate")
  let (d, okD) = resolved["d"]
  assert(okD)
  assert(versionEq(d, pgV(1, 5, 0)))
  let (z, okZ) = resolved["z"]
  assert(okZ)
  assert(versionEq(z, pgV(1, 0, 0)))
}

fn checkPmResolve() {
  checkPubGrubDiamondOverlapResolvesHighest()
  checkPubGrubDirectConflict()
  checkPubGrubTransitiveConflictThreeLevels()
  checkPubGrubDiamondBothPathsIndividuallySatisfiable()
  checkPubGrubMissingVersionConflict()
  checkPubGrubDeterministic()
  checkPubGrubBacktrackRetriesLowerCandidate()
}
