// In-Bit self-checks for the MVS resolver (#1731). Run by `selfcheck()` under
// `./make test`; a failed `assert` panics with exit 2. Sibling of
// pmresolve.bit, same module (#1503), so `selfcheck()` calls these directly.

fn pmresolveV(major: int, minor: int, patch: int): Version {
  return Version{ major: major, minor: minor, patch: patch }
}

fn pmresolveReq(name: string, major: int, minor: int, patch: int): Requirement {
  return Requirement{ name: name, min: pmresolveV(major, minor, patch) }
}

fn assertResolvedVersion(resolved: map<string, Version>, name: string, major: int, minor: int, patch: int) {
  let (v, ok) = resolved[name]
  assert(ok)
  assert(versionEq(v, pmresolveV(major, minor, patch)))
}

// (a) Two requirers of the same module at different minimums resolve to the
// higher one. Root requires A directly at v1.0.0; B (also a root requirement)
// requires A at v2.0.0. MVS must select v2.0.0 for A, not the root's own,
// lower, direct minimum.
fn checkPmResolveMax() {
  let graph = ReqGraph{
    rootRequires: [
      pmresolveReq("A", 1, 0, 0),
      pmresolveReq("B", 1, 0, 0),
    ],
    modules: [
      ModuleReqs{ name: "B", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("A", 2, 0, 0)] },
    ],
  }
  let resolved = resolveMVS(graph)
  assertResolvedVersion(resolved, "A", 2, 0, 0)
  assertResolvedVersion(resolved, "B", 1, 0, 0)
}

// (b) A diamond (root -> B, C; B -> D@1.0.0; C -> D@1.2.0) resolves D to the
// higher requirement without ever expanding a (module, version) pair twice.
// The graph also carries a direct cycle (X -> Y -> X) and a self-dependency
// (Z -> Z) to prove the worklist terminates instead of looping forever.
fn checkPmResolveDiamond() {
  let graph = ReqGraph{
    rootRequires: [
      pmresolveReq("B", 1, 0, 0),
      pmresolveReq("C", 1, 0, 0),
      pmresolveReq("X", 1, 0, 0),
      pmresolveReq("Z", 1, 0, 0),
    ],
    modules: [
      ModuleReqs{ name: "B", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("D", 1, 0, 0)] },
      ModuleReqs{ name: "C", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("D", 1, 2, 0)] },
      ModuleReqs{ name: "X", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("Y", 1, 0, 0)] },
      ModuleReqs{ name: "Y", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("X", 1, 0, 0)] },
      ModuleReqs{ name: "Z", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("Z", 1, 0, 0)] },
    ],
  }
  let resolved = resolveMVS(graph)
  assertResolvedVersion(resolved, "D", 1, 2, 0)
  assertResolvedVersion(resolved, "X", 1, 0, 0)
  assertResolvedVersion(resolved, "Y", 1, 0, 0)
  assertResolvedVersion(resolved, "Z", 1, 0, 0)
}

// (c) Resolution is deterministic: the same graph resolved twice yields
// identical versions for every module, field by field.
fn checkPmResolveDeterministic() {
  let graph = ReqGraph{
    rootRequires: [
      pmresolveReq("A", 1, 0, 0),
      pmresolveReq("B", 1, 0, 0),
    ],
    modules: [
      ModuleReqs{ name: "B", version: pmresolveV(1, 0, 0),
        requires: [pmresolveReq("A", 2, 0, 0)] },
    ],
  }
  let r1 = resolveMVS(graph)
  let r2 = resolveMVS(graph)
  let (a1, ok1) = r1["A"]
  let (a2, ok2) = r2["A"]
  assert(ok1 && ok2)
  assert(versionEq(a1, a2))
  let (b1, ok3) = r1["B"]
  let (b2, ok4) = r2["B"]
  assert(ok3 && ok4)
  assert(versionEq(b1, b2))
}

fn checkPmResolve() {
  checkPmResolveMax()
  checkPmResolveDiamond()
  checkPmResolveDeterministic()
}
