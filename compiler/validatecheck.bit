// In-Bit self-checks for the checker's binder scopes and validation
// diagnostics. Split out of selfcheck.bit (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly.

// Regression: a for-of binder's type must survive a later same-named param.
// `env` is flat and module-wide, so before `binderTypes` the `v: string` param
// in `taker` retyped `loop`'s loop binder and `got` inferred as `string` where
// the seed says `i64` — a scalar typed as a GC reference. Nothing caught it:
// difftypes has no case with this shape.
fn checkForOfBinderScope() {
  let src = "function taker(v: string): string { return v }\n" +
    "function loop(m: map<string, int>): int {\n" +
    "  for (k, v) of m {\n" +
    "    let got = v\n" +
    "    return got\n" +
    "  }\n" +
    "  return -1\n" +
    "}\n"
  assert(checkSourceDump(src) == "4:9: got: i64\n")
}

// Regression: a match arm's payload binder must be typed from its VARIANT, not
// from whatever else in the module last bound that name. check.bit had zero
// `Tag.VariantPat` knowledge, so `Text(s) => …` typed `s` as `taker`'s
// `s: Shape`. Lowering bound it correctly on its own (bindArmPayload), so
// nothing consumed the wrong type and nothing noticed. `taker` sits between the
// two enums on purpose: it is what poisons the flat env.
fn checkMatchBinderScope() {
  let src = "enum Msg { Text(string), Num(i64), Empty }\n" +
    "function taker(s: Shape): f64 { return 1.0 }\n" +
    "enum Shape { Circle(f64) }\n" +
    "function show(m: Msg): string {\n" +
    "  match (m) {\n" +
    "    Text(s) => { let got = s\n" +
    "      return got }\n" +
    "    Num(n) => { return \"n\" }\n" +
    "    Empty => { return \"-\" }\n" +
    "  }\n" +
    "  return \"?\"\n" +
    "}\n"
  assert(checkSourceDump(src) == "6:22: got: string\n")
}

// Regression: a comma-ok binding must BIND its names, not merely type their
// nodes. `checkCommaOk` recorded `nodeTypes` (which is all `--dump-types` reads)
// and never touched `env`, so every expression that READ the name resolved to
// whatever else in the module last bound it — `taker`'s `v: string` here. It
// cost stdlib/quic 18 false rejections before `bit2 check` covered projects.
fn checkCommaOkBinderScope() {
  let src = "function taker(v: string): string { return v }\n" +
    "function get(m: map<string, i64>): i64 {\n" +
    "  let (v, ok) = m[\"k\"]\n" +
    "  let got = v\n" +
    "  return got\n" +
    "}\n"
  assert(checkSourceDump(src) == "3:8: v: i64\n3:11: ok: bool\n4:7: got: i64\n")
}

// E0053: an operator whose operands do not meet (§14.2), and the poisoning that
// keeps it to ONE diagnostic. `1 + 1.5` really is an error in Bit — two untyped
// constants with different default types (i64 vs f64) do not meet, so there is no
// implicit int->float widening even between literals. Verified against the seed.
fn checkValidateOperators() {
  assert(!hasErrors(checkFile("t.bit", "function f(): i64 { return 1 + 1 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): string { return \"a\" + \"b\" }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(x: i64): i64 { return x + 1 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(x: f64): f64 { return x * 2.0 }\n").diags))
  assert(hasErrors(checkFile("t.bit", "function f() { let x = 1 + \"a\" }\n").diags))
  assert(hasErrors(checkFile("t.bit", "function f() { let x = 1 + 1.5 }\n").diags))
  assert(hasErrors(checkFile("t.bit", "function f() { let x = true + 1 }\n").diags))
  // Bitwise/shift demand integers: a float is an error, an int is not.
  assert(hasErrors(checkFile("t.bit", "function f() { let x = 1.5 & 1 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): i64 { return 6 & 3 }\n").diags))

  // The cascade must stay ONE error, not two: `1 + "a"` types `x` invalid, so
  // `return x` against i32 says nothing further. That poisoning is the whole
  // reason checkBinary returns invalid rather than merging.
  let c = checkFile("t.bit", "function f(): i32 {\n  let x = 1 + \"a\"\n  return x\n}\n")
  assert(c.diags.errorCount == 1)
  assert(renderDiags(c.diags) ==
    "error[E0053]: operator not defined for 'untyped int' and 'untyped string'\n" +
    " --> t.bit:2:11\n" +
    "  |\n" +
    "2 |   let x = 1 + \"a\"\n" +
    "  |           ^^^^^^^\n")
}

// The validator rejects a return whose type does not match the declared result,
// with the seed's exact text (tests/cases/check_type_mismatch_return.expected).
fn checkValidateReturnMismatch() {
  let c = checkFile("t.bit", "function f(): i32 { return \"hi\" }\n")
  assert(hasErrors(c.diags))
  assert(renderDiags(c.diags) ==
    "error[E0041]: expected 'i32', found 'untyped string'\n" +
    " --> t.bit:1:28\n" +
    "  |\n" +
    "1 | function f(): i32 { return \"hi\" }\n" +
    "  |                            ^^^^\n")
}

// The half that matters more: valid programs must stay silent. A validator that
// invents an error breaks a working build, so each of these is a shape that
// must NOT report — an untyped literal in range, a fallible result (`return x`
// yields the OK type, not the boxed `T!`), and a bare return from void.
fn checkValidateAccepts() {
  assert(!hasErrors(checkFile("t.bit", "function f(): i8 { return 100 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): i64 { return -5 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): f64 { return 1 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): i32! { return 7 }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f() { return }\n").diags))
  assert(!hasErrors(checkFile("t.bit", "function f(): string { return \"s\" }\n").diags))
  // An out-of-range literal IS an error: i8 holds -128..127.
  assert(hasErrors(checkFile("t.bit", "function f(): i8 { return 300 }\n").diags))
  // A bare `return` from a non-void function is too.
  assert(hasErrors(checkFile("t.bit", "function f(): i64 { return }\n").diags))
}

// Assignability's core rules, independent of the walk.
fn checkValidateAssignable() {
  let c = checkFile("t.bit", "function f(): i64 { return 1 }\n")
  let i64t = primType(c.ctx, 3)
  let i8t = primType(c.ctx, 0)
  let f64t = primType(c.ctx, 9)
  let strt = primType(c.ctx, 11)
  // `invalid` (0) is permissive in both directions — an un-inferred node must
  // never become a false error.
  assert(vAssignable(c, 0, i64t))
  assert(vAssignable(c, i64t, 0))
  assert(vAssignable(c, i64t, i64t))
  assert(!vAssignable(c, strt, i64t))
  // An untyped constant assigns to its DEFAULT type only...
  assert(vAssignable(c, c.ctx.untypedIntId, i64t))
  assert(!vAssignable(c, c.ctx.untypedIntId, i8t))
  // ...except an untyped float, representable in either float width.
  assert(vAssignable(c, c.ctx.untypedFloatId, f64t))
  assert(!vAssignable(c, c.ctx.untypedStringId, i64t))
  assert(vAssignable(c, c.ctx.untypedStringId, strt))
  // `nil` needs a nilable target; a prim is not one.
  assert(!vAssignable(c, c.ctx.untypedNilId, i64t))
  // Range checks (§15.4).
  assert(vRepresentable(c, 127, i8t))
  assert(!vRepresentable(c, 128, i8t))
  assert(vRepresentable(c, 0 - 128, i8t))
  assert(!vRepresentable(c, 0 - 129, i8t))
  assert(vRepresentable(c, 1, f64t)) // int constant widened to float
  assert(!vRepresentable(c, 1, strt))
}

// A module's files are parsed as ONE concatenated source, so the parser can only
// report module-global spans; `remapDiags` puts each one back on the file it
// actually came from. Without it a real error renders against the wrong file and
// line as soon as a module has more than one file.
fn checkRemapDiags() {
  let sm = newSourceManager()
  let fa = addFile(sm, "/m/a.bit", "aaaaa\n")
  let fb = addFile(sm, "/m/b.bit", "bbb\n")
  let d = newDiagnostics(sm)
  // Concatenated: a.bit occupies 0..5, its newline 5, b.bit starts at 6.
  let starts = [0, 6]
  // One diagnostic BEFORE the remap window: an earlier module's, already mapped,
  // and it must be left alone.
  reportNoHint(d, 1, Span{ file: 99, start: 1, end: 2 }, "untouched")
  let mark = len(d.list)
  reportNoHint(d, 1, Span{ file: 0, start: 2, end: 4 }, "in a.bit")
  reportNoHint(d, 1, Span{ file: 0, start: 7, end: 9 }, "in b.bit")
  remapDiags(d, mark, [fa, fb], starts)
  assert(d.list[0].span.file == 99 && d.list[0].span.start == 1)
  assert(d.list[1].span.file == fa && d.list[1].span.start == 2 && d.list[1].span.end == 4)
  // Module offset 7 is b.bit's offset 1, and the span's WIDTH must survive the
  // move — a caret that grew or shrank would underline the wrong text.
  assert(d.list[2].span.file == fb && d.list[2].span.start == 1 && d.list[2].span.end == 3)
}
