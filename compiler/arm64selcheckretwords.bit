// compiler/arm64selcheckretwords.bit -- split out of arm64selcheckgen.bit
// (#5675, arm64selcheckgen.bit was 870 lines formatted against the
// 800-line limit, #4099/#4103's canonical-format debt on
// BIT_FMTZERO_DEBT). Same module as arm64selcheckgen.bit and
// selfcheck.bit (#1503), so this needs no imports and no call-site
// changes.
//
// #4239's return-convention-at-width-W family: assertRetRegs and the
// checkArm64Ret*/checkArm64CallWordDispatch checks built on it, plus
// assertCallWordBinding/assertMovFrom/firstBranchLinkAt — the raw-byte
// helpers that read the `bl`+move sequence a multi-word call binds its
// results out of. Moved as one group: assertCallWordBinding is the only
// caller of the two raw-byte helpers, and nothing outside this group
// calls any of the seven.

// #4239: the ARM64 return convention at width W — retRegsFor, bindCallResults
// and emitMultiWordRet. Every function the front end builds today returns W <= 1
// (`return a, b` is boxed into one tuple handle by lowerfunc.bit before
// codegen), so NOTHING in this tree emits a W > 1 return yet and these checks
// ARE that capability's only gate, not a supplement to one.
fn assertRetRegs(classes: []RegClass, want: []int) {
  let got = retRegsFor(classes)
  assert(len(got) == len(want))
  let i = 0
  while (i < len(want)) {
    assert(got[i] == want[i])
    i = i + 1
  }
}

fn checkArm64RetRegs() {
  // Width 1 is retRegNum in either class. Asserted rather than commented,
  // because bindCallResult (the width-1 fast path) and bindCallResults (the
  // general one) are separate bodies that have to agree about it.
  assertRetRegs([RegClass.Int], [retRegNum()])
  assertRetRegs([RegClass.Float], [retRegNum()])

  assertRetRegs([RegClass.Int, RegClass.Int], [0, 1]) // x0, x1

  // {i64, f64} is {x0, d0}, NOT {x0, x1} — the case a flat x0..x(W-1) gets
  // wrong. Both are register #0; they are different registers because they are
  // different files. `Option<f64>` (stdlib/json/value.bit) is exactly this
  // shape, and both #4167's and #4236's int-only aggregates were blind to it.
  assertRetRegs([RegClass.Int, RegClass.Float], [0, 0])

  // Interleaving perturbs neither count: the two files are independent.
  assertRetRegs([RegClass.Float, RegClass.Int, RegClass.Float, RegClass.Int], [0, 0, 1, 1])

  // Generalized by width, not hardcoded to the decided N = 2: a full integer
  // budget is legal and leaves the float file at its own zero.
  let wide = []RegClass(0)
  let i = 0
  while (i < maxArgRegs()) {
    wide = append(wide, RegClass.Int)
    i = i + 1
  }
  wide = append(wide, RegClass.Float)
  let wr = retRegsFor(wide)
  assert(len(wr) == maxArgRegs() + 1)
  assert(wr[maxArgRegs() - 1] == maxArgRegs() - 1) // x7
  assert(wr[maxArgRegs()] == 0)                    // d0
}

// The width-1 half: bindCallResults must emit BYTE FOR BYTE what bindCallResult
// already emits, in a register destination, in a spill destination, for a bool
// and for a float. That equality is the whole claim that adding the capability
// changed no existing call site, so it is checked rather than argued.
fn checkArm64RetWidthOne() {
  let probe = selCtx()
  let ctx = probe.module.ctx
  let i64t = primType(ctx, 3)
  let f64t = primType(ctx, 9)
  let boolt = primType(ctx, 10)

  // vreg 1 is x1: a plain register destination.
  let fast = selCtx()
  bindCallResult(fast, 1, i64t, false)
  let gen = selCtx()
  bindCallResults(gen, [1], [i64t], false)
  assertSameBytes(gen.code, fast.code)

  // A bool result is normalized with uxtb first, in the word's OWN return
  // register, before anything reads it.
  fast = selCtx()
  bindCallResult(fast, 1, boolt, true)
  gen = selCtx()
  bindCallResults(gen, [1], [boolt], true)
  assertSameBytes(gen.code, fast.code)
  let want = newByteBuf()
  uxtb(want, 0)
  movRR(want, 1, 0)
  assertSameBytes(gen.code, want)

  // vreg 1 as a float destination is d1.
  fast = selCtx()
  bindCallResult(fast, 1, f64t, false)
  gen = selCtx()
  bindCallResults(gen, [1], [f64t], false)
  assertSameBytes(gen.code, fast.code)

  // A SPILLED destination stores straight out of the return register — the arm
  // where the fast path uses putInt and the general one uses emitMove, i.e. the
  // one most likely to drift apart.
  let frame = FrameInfo{
    savedGpr = []int(0), savedFpr = []int(0), numSpillSlots = 2,
    outgoingBytes = 0, frameSize = 64,
  }
  fast = selCtx()
  fast.frame = frame
  setLoc(fast.result, 1, RegLoc{ isSpill = true, index = 1 })
  bindCallResult(fast, 1, i64t, false)
  gen = selCtx()
  gen.frame = frame
  setLoc(gen.result, 1, RegLoc{ isSpill = true, index = 1 })
  bindCallResults(gen, [1], [i64t], false)
  assertSameBytes(gen.code, fast.code)
  want = newByteBuf()
  storeImm(want, 0, regSp(), 8, 8)
  assertSameBytes(gen.code, want)
}

// The W > 1 half: the caller's binding, the callee's `ret`, and the aliasing
// case a sequence of single moves gets wrong.
fn checkArm64RetWords() {
  let probe = selCtx()
  let ctx = probe.module.ctx
  let i64t = primType(ctx, 3)
  let f64t = primType(ctx, 9)

  // Two int words into two ordinary destinations: x0 and x1, in word order.
  let cx = selCtx()
  bindCallResults(cx, [4, 5], [i64t, i64t], false)
  let want = newByteBuf()
  movRR(want, 4, 0)
  movRR(want, 5, 1)
  assertSameBytes(cx.code, want)

  // The mixed-class binding: word 1 comes out of d0, not x1.
  cx = selCtx()
  bindCallResults(cx, [4, 5], [i64t, f64t], false)
  want = newByteBuf()
  movRR(want, 4, 0)
  fmovFF(want, 5, 0, 8)
  assertSameBytes(cx.code, want)

  // A DISCARDED word still consumes its class's ordinal. Word 0 is dropped, so
  // word 1 must still come from x1 — deriving its register from the surviving
  // words alone would read x0 and bind the wrong value.
  cx = selCtx()
  bindCallResults(cx, [-1, 5], [i64t, i64t], false)
  want = newByteBuf()
  movRR(want, 5, 1)
  assertSameBytes(cx.code, want)

  // THE ALIASING CASE. Word 0 must land in x1 while word 1 is still IN x1: a
  // left-to-right `mov x1,x0; mov x0,x1` destroys word 1 and returns word 0
  // twice. Reachable whenever the function has no safepoint at all, since
  // buildIntRegs then hands out x0..x7 as well. One parallel move rotates it
  // through the reserved secondary scratch.
  cx = selCtx()
  bindCallResults(cx, [1, 0], [i64t, i64t], false)
  want = newByteBuf()
  movRR(want, scratch2(), 1)
  movRR(want, 1, 0)
  movRR(want, 0, scratch2())
  assertSameBytes(cx.code, want)

  // The callee half: two values into {x0, d0}, again per class.
  cx = selCtx()
  cx.f.instrs = [
    mkInstr(Op.BlockParam, i64t), mkInstr(Op.BlockParam, i64t),
    mkInstr(Op.BlockParam, i64t), mkInstr(Op.BlockParam, f64t),
  ]
  emitMultiWordRet(cx, [2, 3])
  want = newByteBuf()
  movRR(want, 0, 2)
  fmovFF(want, 0, 3, 8)
  assertSameBytes(cx.code, want)

  // End to end through compileFunction, so the `Op.Ret` dispatch arm is proven
  // wired and not just the helper. `ret %1, %0` on two int params is a genuine
  // swap through x0/x1, so it cannot be satisfied by self-moves: with the
  // multi-word arm removed this emits a bare `ret` (4 bytes) and passes nothing.
  let ctx2 = newTypeContext()
  let ai = primType(ctx2, 3)
  let r2 = mkInstr(Op.Ret, ctx2.voidId)
  r2.args = [1, 0]
  let f2 = irFuncOf(
    "ret2", [ai, ai], ai, [IrBlock{ instsStart = 0, paramCount = 2, instsLen = 3 }],
    [mkInstr(Op.BlockParam, ai), mkInstr(Op.BlockParam, ai), r2],
  )
  let c2 = a64FixtureCompile(
    IrModule{ funcs = [f2], ctx = ctx2, stringPool = []string(0), sm = newSourceManager() },
    f2,
  )
  assert(c2.frameSize == 0) // no safepoint -> frameless
  assert(len(c2.relocs) == 0)
  assert(len(c2.code) == 16) // three rotation moves, then ret
  assert(wordAt(ByteBuf{ bytes = c2.code }, 12) == 0xd65f03c0)
  checkArm64RetConstWord(i64t)
}

// #6696: `return v, nil` with `v` already in x1 and the nil allocated x0. The
// skipped nil is written straight into x1 after `v` leaves it: two moves.
// Unskipped it is still read from x0, which is the three-move rotation through
// the secondary scratch the ticket measured — the skip map alone decides.
fn checkArm64RetConstWord(i64t: int) {
  let cx = nilWordCtx(i64t, true)
  emitMultiWordRet(cx, [1, 0])
  let want = newByteBuf()
  movRR(want, 0, 1)
  movImm64(want, 1, 0)
  assertSameBytes(cx.code, want)

  let kept = nilWordCtx(i64t, false)
  emitMultiWordRet(kept, [1, 0])
  want = newByteBuf()
  movRR(want, scratch2(), 0)
  movRR(want, 0, 1)
  movRR(want, 1, scratch2())
  assertSameBytes(kept.code, want)

  // The fold half, on both skip maps: a nil read only as a word of a W == 2
  // ret is skipped, twice over when both words name it, and a W == 1 ret,
  // whose word goes through `getInt`, folds nothing.
  let ctx = newTypeContext()
  let ty = primType(ctx, 3)
  let r = mkInstr(Op.Ret, ctx.voidId)
  r.args = [0, 1]
  let f = irFuncOf(
    "f",
    [ty],
    ty,
    [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 3 }],
    [mkInstr(Op.BlockParam, ty), mkInstr(Op.ConstNil, ty), r],
  )
  assert(computeSkipConstMaterialize(ctx, f, false)[1])
  assert(xComputeSkipConstMaterialize(ctx, f)[1])
  f.instrs[2].args = [1, 1]
  assert(computeSkipConstMaterialize(ctx, f, false)[1])
  f.instrs[2].args = [1]
  assert(!computeSkipConstMaterialize(ctx, f, false)[1])
  assert(!xComputeSkipConstMaterialize(ctx, f)[1])
}

// selCtx with slot 0 a const_nil in x0 and slot 1 a value in x1.
fn nilWordCtx(i64t: int, skipped: bool): A64Ctx {
  let cx = selCtx()
  cx.f.instrs[0] = mkInstr(Op.ConstNil, i64t)
  cx.f.instrs[1] = mkInstr(Op.BlockParam, i64t)
  cx.skipConst = []bool(12)
  cx.skipConst[0] = skipped
  return cx
}

// #4405: the CALL SITE at width W. `checkArm64RetWords` above covers the
// convention's two halves in isolation — `bindCallResults` and
// `emitMultiWordRet` — and neither is reached by anything unless
// `compileInstCall` recognises an `Op.Call` followed by its `Op.CallWord` run
// (arm64dispatch.bit) and hands the WHOLE run to one `emitCallWords`.
//
// That recognition is the arm nothing else can see. Bind only word 0 and the
// caller reads a register the callee never wrote: a wrong answer at exit 0,
// with correct-looking IR, a silent verifier and a green golden corpus for
// every program whose second word happens not to matter.
//
// A SECOND call is what makes this check able to fail, and the first version
// of it could not. With one call, both words are already sitting in their own
// return registers and the parallel move emits NOTHING — `add x2, x0, x1`,
// byte-identical whether word 1 was bound or merely allocated x1 by luck.
// Living across a second call forces both words into callee-saved registers,
// so the binding has to be emitted to exist at all.
fn checkArm64CallWordDispatch() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let call = mkInstr(Op.Call, i64t)
  call.name = "callee"
  call.args = [0]
  let word1 = mkInstr(Op.CallWord, i64t)
  word1.args = [1]
  word1.ival = 1
  let clobber = mkInstr(Op.Call, i64t)
  clobber.name = "other"
  clobber.args = [0]
  let sum = mkInstr(Op.Add, i64t)
  sum.lhs = 1
  sum.rhs = 2
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [4]
  let f = irFuncOf(
    "cw",
    [i64t],
    i64t,
    [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 6 }],
    [mkInstr(Op.BlockParam, i64t), call, word1, clobber, sum, ret],
  )
  let c = a64FixtureCompile(
    IrModule{ funcs = [f], ctx = ctx, stringPool = []string(0), sm = newSourceManager() },
    f,
  )
  assert(len(c.safepoints) == 2, "both calls are safepoints: ${len(c.safepoints)}")
  assertCallWordBinding(c)
}

// #6683: the same call site through a closure. `Op.CallValue` is the one call
// op that bound a single word, so a CallValue + CallWord run (a fallible
// closure's ok word and error word) would leave word 1 unbound. The shape is
// `checkArm64CallWordDispatch`'s, with the first call a `call_value` through
// param 0 and the second call still what keeps both words live across it.
//
// The closure call emits a `blr`, not a `bl`, so the binding is read from the
// word after it. The nil check's own call is a `bl` and comes first, which is
// why this finds the `blr` and not `firstBranchLinkAt`.
fn checkArm64CallValueWordDispatch() {
  let ctx = newTypeContext()
  let i64t = primType(ctx, 3)
  let call = mkInstr(Op.CallValue, i64t)
  call.lhs = 0
  call.args = [0]
  let word1 = mkInstr(Op.CallWord, i64t)
  word1.args = [1]
  word1.ival = 1
  let clobber = mkInstr(Op.Call, i64t)
  clobber.name = "other"
  clobber.args = [0]
  let sum = mkInstr(Op.Add, i64t)
  sum.lhs = 1
  sum.rhs = 2
  let ret = mkInstr(Op.Ret, ctx.voidId)
  ret.args = [4]
  let f = irFuncOf(
    "cvw",
    [i64t],
    i64t,
    [IrBlock{ instsStart = 0, paramCount = 1, instsLen = 6 }],
    [mkInstr(Op.BlockParam, i64t), call, word1, clobber, sum, ret],
  )
  let c = a64FixtureCompile(
    IrModule{ funcs = [f], ctx = ctx, stringPool = []string(0), sm = newSourceManager() },
    f,
  )
  assert(len(c.safepoints) == 2, "both calls are safepoints: ${len(c.safepoints)}")
  let buf = ByteBuf{ bytes = c.code }
  let blr = firstBranchLinkRegAt(buf)
  assert(blr >= 0, "no blr was emitted for the closure call")
  assertMovFrom(wordAt(buf, blr + 4), 0, "word 0 must be bound out of x0 right after the blr")
  assertMovFrom(wordAt(buf, blr + 8), 1, "word 1 must be bound out of x1 in the same move")
}

// The binding itself: the two instructions immediately after the first `bl`
// move word 0 out of x0 and word 1 out of x1. The DESTINATIONS are whatever
// the allocator chose, so only the sources are pinned — the claim is that both
// return registers are read, in word order, in the window where reading them
// is still safe (#4236), not which callee-saved register each landed in.
fn assertCallWordBinding(c: FuncCode) {
  let buf = ByteBuf{ bytes = c.code }
  let bl = firstBranchLinkAt(buf)
  assert(bl >= 0, "no bl was emitted for the call")
  assertMovFrom(wordAt(buf, bl + 4), 0, "word 0 must be bound out of x0 right after the bl")
  assertMovFrom(wordAt(buf, bl + 8), 1, "word 1 must be bound out of x1 in the same move")
}

// `w` is `mov Xd, X<src>` for some destination: the ORR-with-XZR encoding
// `movRR` emits, with every field but the destination and the source pinned.
fn assertMovFrom(w: int, src: int, why: string) {
  assert((w & 0xffe0ffe0) == 0xaa0003e0, "${why} — not a register move: ${w}")
  assert(((w >> 16) & 31) == src, "${why} — reads x${(w >> 16) & 31}, not x${src}")
}

// The offset of the first `bl` in `buf`, or -1. `bl` is opcode 100101 in the
// top six bits with a signed 26-bit displacement below it.
fn firstBranchLinkAt(buf: ByteBuf): int {
  let i = 0
  while (i + 4 <= len(buf.bytes)) {
    if ((wordAt(buf, i) >> 26) == 0x25) {
      return i
    }
    i = i + 4
  }
  return -1
}

// The offset of the first `blr` in `buf`, or -1: `blr Xn` is 0xd63f0000 | n << 5.
fn firstBranchLinkRegAt(buf: ByteBuf): int {
  let i = 0
  while (i + 4 <= len(buf.bytes)) {
    if ((wordAt(buf, i) & 0xfffffc1f) == 0xd63f0000) {
      return i
    }
    i = i + 4
  }
  return -1
}
