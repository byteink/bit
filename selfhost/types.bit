// Self-host Stage 2 (#1337): the type universe, ported from compiler/check.zig's
// TypeContext + describeType. A TypeId is an index into the context's `types`
// array. Bit has no tagged unions, so a Type is a struct with a `kind` tag and
// per-kind fields (only those the kind uses are meaningful). This is the
// foundation the checker's inference produces and `--dump-types` renders.

// The type-data discriminant (the seed's TypeData union tags).
enum TypeKind {
  Invalid,
  Void,
  UntypedInt,
  UntypedFloat,
  UntypedRune,
  UntypedBool,
  UntypedString,
  UntypedNil,
  Prim,
  Slice,
  Array,
  Map,
  Tuple,
  Func,
  Chan,
  Struct,
  Interface,
  TypeParam,
  Enum,
  Fallible,
}

// The primitive scalar names (spec §15), indexed by the seed's Prim enum order.
function primName(prim: int): string {
  let names = ["i8", "i16", "i32", "i64", "u8", "u16", "u32", "u64", "f32", "f64", "bool", "string"]
  return names[prim]
}

// A type. `kind` selects which fields matter: Prim→prim; Slice/Chan/Array→elem
// (+arrayLen); Map→mapKey/mapVal; Tuple/Func→members (Func also result/variadic);
// Fallible→result(ok)/errTy; Struct/Interface/Enum/TypeParam→name (hasName marks
// a resolved display name). The full field/method/variant tables attach when
// inference lands; the renderer needs only the name.
struct Type {
  kind: TypeKind,
  prim: int,
  elem: int,
  arrayLen: int,
  mapKey: int,
  mapVal: int,
  members: []int,
  variadic: bool,
  result: int,
  errTy: int,
  name: string,
  hasName: bool,
  // Enum only: whether any variant carries a payload, so the value is a boxed
  // {tag, payloadPtr} object rather than a bare tag word (the seed's
  // `check.enumBoxed`). Codegen classifies GC references from the TypeContext
  // alone, so this must live on the type; not rendered by any dump, and never
  // compared by `compositeEq` (enums are named, not interned composites).
  enumBoxed: bool,
}

// The interned type table plus the well-known ids seeded at init.
struct TypeContext {
  types: []Type,
  voidId: int,
  untypedIntId: int,
  untypedFloatId: int,
  untypedRuneId: int,
  untypedBoolId: int,
  untypedStringId: int,
  untypedNilId: int,
  primIds: []int,
  errorId: int,
}

// A leaf type (no sub-parts) of the given kind.
function leafType(kind: TypeKind): Type {
  return Type{ kind: kind, prim: 0, elem: 0, arrayLen: 0, mapKey: 0, mapVal: 0,
    members: []int(0), variadic: false, result: 0, errTy: 0, name: "", hasName: false,
    enumBoxed: false }
}

// Appends `t` and returns its TypeId (no dedup — named types are one-per-decl).
function addType(ctx: TypeContext, t: Type): int {
  let id = len(ctx.types)
  ctx.types = append(ctx.types, t)
  return id
}

// True when two int lists are element-wise equal.
function intListEq(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// Structural equality of two composite types (by their already-interned field
// ids — matches the seed's `intern` dedup, where TypeId equality is identity).
function compositeEq(a: Type, b: Type): bool {
  if (a.kind != b.kind) {
    return false
  }
  let k = a.kind
  if (k == TypeKind.Slice || k == TypeKind.Chan) {
    return a.elem == b.elem
  }
  if (k == TypeKind.Array) {
    return a.arrayLen == b.arrayLen && a.elem == b.elem
  }
  if (k == TypeKind.Map) {
    return a.mapKey == b.mapKey && a.mapVal == b.mapVal
  }
  if (k == TypeKind.Tuple) {
    return intListEq(a.members, b.members)
  }
  if (k == TypeKind.Func) {
    return a.variadic == b.variadic && a.result == b.result && intListEq(a.members, b.members)
  }
  if (k == TypeKind.Fallible) {
    return a.result == b.result && a.errTy == b.errTy
  }
  return false
}

// Interns a composite type: reuses a structurally-identical existing id, else
// appends. The seed dedups all composites (`[]byte` referenced N× = one id at its
// first-touch position), which the touch-order type-id assignment relies on.
// ponytail: linear scan — a module has a few hundred types, O(n²) is negligible.
function internComposite(ctx: TypeContext, t: Type): int {
  let i = 0
  while (i < len(ctx.types)) {
    if (compositeEq(ctx.types[i], t)) {
      return i
    }
    i = i + 1
  }
  return addType(ctx, t)
}

// Seeds the context in the seed's exact order (invalid=0, void=1, untyped 2..7,
// prims 8..19, error=20) so well-known ids agree, then records the handles.
function newTypeContext(): TypeContext {
  let ctx = TypeContext{ types: []Type(0), voidId: 0, untypedIntId: 0, untypedFloatId: 0,
    untypedRuneId: 0, untypedBoolId: 0, untypedStringId: 0, untypedNilId: 0,
    primIds: []int(0), errorId: 0 }
  addType(ctx, leafType(TypeKind.Invalid))
  ctx.voidId = addType(ctx, leafType(TypeKind.Void))
  ctx.untypedIntId = addType(ctx, leafType(TypeKind.UntypedInt))
  ctx.untypedFloatId = addType(ctx, leafType(TypeKind.UntypedFloat))
  ctx.untypedRuneId = addType(ctx, leafType(TypeKind.UntypedRune))
  ctx.untypedBoolId = addType(ctx, leafType(TypeKind.UntypedBool))
  ctx.untypedStringId = addType(ctx, leafType(TypeKind.UntypedString))
  ctx.untypedNilId = addType(ctx, leafType(TypeKind.UntypedNil))
  let p = 0
  while (p < 12) {
    let t = leafType(TypeKind.Prim)
    t.prim = p
    ctx.primIds = append(ctx.primIds, addType(ctx, t))
    p = p + 1
  }
  // The predeclared `error` interface (a single `message(): string` method).
  // Only its display name matters to the renderer.
  let e = leafType(TypeKind.Interface)
  e.name = "error"
  e.hasName = true
  ctx.errorId = addType(ctx, e)
  return ctx
}

function primType(ctx: TypeContext, prim: int): int {
  return ctx.primIds[prim]
}

function mkSlice(ctx: TypeContext, elem: int): int {
  let t = leafType(TypeKind.Slice)
  t.elem = elem
  return internComposite(ctx, t)
}

function mkChan(ctx: TypeContext, elem: int): int {
  let t = leafType(TypeKind.Chan)
  t.elem = elem
  return internComposite(ctx, t)
}

function mkArray(ctx: TypeContext, n: int, elem: int): int {
  let t = leafType(TypeKind.Array)
  t.arrayLen = n
  t.elem = elem
  return internComposite(ctx, t)
}

function mkMap(ctx: TypeContext, key: int, val: int): int {
  let t = leafType(TypeKind.Map)
  t.mapKey = key
  t.mapVal = val
  return internComposite(ctx, t)
}

function mkTuple(ctx: TypeContext, members: []int): int {
  let t = leafType(TypeKind.Tuple)
  t.members = members
  return internComposite(ctx, t)
}

function mkFunc(ctx: TypeContext, params: []int, variadic: bool, result: int): int {
  let t = leafType(TypeKind.Func)
  t.members = params
  t.variadic = variadic
  t.result = result
  return internComposite(ctx, t)
}

function mkFallible(ctx: TypeContext, ok: int, err: int): int {
  let t = leafType(TypeKind.Fallible)
  t.result = ok
  t.errTy = err
  return internComposite(ctx, t)
}

// Joins the member type names with ", " (tuple/func parameter lists).
function joinTypeNames(ctx: TypeContext, ids: []int, depth: int): string {
  let s = ""
  let i = 0
  while (i < len(ids)) {
    if (i != 0) {
      s = s + ", "
    }
    s = s + typeNameDepth(ctx, ids[i], depth + 1)
    i = i + 1
  }
  return s
}

// Renders a TypeId to its canonical name, matching the seed's appendTypeName
// byte-for-byte. Recursion is capped at depth 128 (→ "...").
function typeNameDepth(ctx: TypeContext, id: int, depth: int): string {
  if (depth >= 128) {
    return "..."
  }
  let t = ctx.types[id]
  let k = t.kind
  if (k == TypeKind.Invalid) { return "<error>" }
  if (k == TypeKind.Void) { return "()" }
  if (k == TypeKind.UntypedInt) { return "untyped int" }
  if (k == TypeKind.UntypedFloat) { return "untyped float" }
  if (k == TypeKind.UntypedRune) { return "untyped rune" }
  if (k == TypeKind.UntypedBool) { return "untyped bool" }
  if (k == TypeKind.UntypedString) { return "untyped string" }
  if (k == TypeKind.UntypedNil) { return "nil" }
  if (k == TypeKind.Prim) { return primName(t.prim) }
  if (k == TypeKind.Slice) { return "[]" + typeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Chan) { return "chan<" + typeNameDepth(ctx, t.elem, depth + 1) + ">" }
  if (k == TypeKind.Array) { return "[${t.arrayLen}]" + typeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Map) {
    return "map<" + typeNameDepth(ctx, t.mapKey, depth + 1) + ", " + typeNameDepth(ctx, t.mapVal, depth + 1) + ">"
  }
  if (k == TypeKind.Tuple) { return "(" + joinTypeNames(ctx, t.members, depth) + ")" }
  if (k == TypeKind.Func) {
    return "(" + joinTypeNames(ctx, t.members, depth) + ") => " + typeNameDepth(ctx, t.result, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    let s = typeNameDepth(ctx, t.result, depth + 1) + "!"
    if (t.errTy != ctx.errorId) {
      s = s + typeNameDepth(ctx, t.errTy, depth + 1)
    }
    return s
  }
  if (k == TypeKind.TypeParam) { return t.name }
  // Struct / Interface / Enum: the display name, or a placeholder.
  if (t.hasName) {
    return t.name
  }
  if (k == TypeKind.Struct) { return "struct{...}" }
  if (k == TypeKind.Enum) { return "enum{...}" }
  return "interface{...}"
}

function typeName(ctx: TypeContext, id: int): string {
  return typeNameDepth(ctx, id, 0)
}
