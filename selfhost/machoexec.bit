// Self-host Stage 3 (#1344): dynamic Mach-O executable writer, ported from
// compiler/link/macho.zig. Lands in slices; this one carries the constants, the
// dyld opcode-stream encoders, and the layout helpers — everything that is
// verifiable on its own. The ~450-line linkExecutable core follows.
//
// Where the ELF path emits a fully static, zero-dependency image, macOS
// fundamentally cannot: the runtime reaches threads, TLS, mmap, and every
// syscall through /usr/lib/libSystem.B.dylib (Apple has forbidden static libc
// since 10.6), so the output is a normal dynamically-linked MH_EXECUTE that dyld
// loads and binds — exactly how Go, Zig, and Rust ship on macOS. "Own linker, no
// system ld" still holds; "one file, nothing else installed" becomes "one file,
// plus the libSystem every Mac already has".
//
// Pipeline: ingest generic modules, resolve + dead-strip from the entry root
// __start (macOS mangles _start with a leading underscore), treat any
// still-undefined global as a libSystem IMPORT (a leaf, not an error),
// synthesize a __got of non-lazy pointers plus __stubs for the imports that are
// branch targets, apply every relocation against the assigned addresses, and
// emit the four segments (__PAGEZERO/__TEXT/__DATA/__LINKEDIT) with the load
// commands dyld needs.
//
// PIE: the image is position-independent (dyld picks a random slide). Every
// AArch64 relocation this backend applies is PC-relative (branch/ADRP/ADD/
// LDR-off), hence slide-invariant, so link-time addresses stay correct under any
// slide; only absolute pointers (data abs64, internal GOT slots) carry a rebase,
// and imports carry a bind.

function meEntrySymbol(): string { return "__start" } // macOS-mangled _start
function meBaseVaddr(): int { return 0x100000000 }    // __TEXT load address, above __PAGEZERO
function meSegAlign(): int { return 0x4000 }          // arm64 macOS segment alignment (16 KiB)
function mePtrSize(): int { return 8 }
function meStubSize(): int { return 12 }              // adrp x16 ; ldr x16,[x16] ; br x16

function meDylinkerPath(): string { return "/usr/lib/dyld" }
function meLibsystemPath(): string { return "/usr/lib/libSystem.B.dylib" }

// ---- Mach-O load-command constants (<mach-o/loader.h>) --------------------

function mhExecute(): int { return 0x2 }
function mhDyldlink(): int { return 0x4 }
function mhTwolevel(): int { return 0x80 }
function mhPie(): int { return 0x200000 }
// Tells dyld the image carries S_THREAD_LOCAL_VARIABLES descriptors it must
// register (allocate a pthread key, replace each descriptor's _tlv_bootstrap
// thunk with the real resolver). Without it dyld skips TLV setup and the first
// thread-local access calls the placeholder thunk -> _tlv_bootstrap_error.
function mhHasTlvDescriptors(): int { return 0x800000 }

function lcReqDyld(): int { return 0x80000000 }
function lcSymtabCmd(): int { return 0x2 }
function lcDysymtab(): int { return 0xb }
function lcLoadDylinker(): int { return 0xe }
function lcLoadDylib(): int { return 0xc }
function lcMain(): int { return 0x28 | 0x80000000 }
function lcDyldInfoOnly(): int { return 0x22 | 0x80000000 }
function lcBuildVersion(): int { return 0x32 }
function lcCodeSignature(): int { return 0x1d }

function sNonLazySymbolPointers(): int { return 0x6 }
function sSymbolStubs(): int { return 0x8 }
function sThreadLocalRegular(): int { return 0x11 }   // __thread_data (init image)
function sThreadLocalZerofill(): int { return 0x12 }  // __thread_bss
function sThreadLocalVariables(): int { return 0x13 } // __thread_vars (tlv_descriptors)

function indirectSymbolLocal(): int { return 0x80000000 }
function platformMacos(): int { return 1 }

// Bind/rebase opcode bytecode (<mach-o/loader.h>).
function bindOpcodeDone(): int { return 0x00 }
function bindOpcodeSetDylibOrdinalImm(): int { return 0x10 }
function bindOpcodeSetSymbolTrailingFlagsImm(): int { return 0x40 }
function bindOpcodeSetTypeImm(): int { return 0x50 }
function bindOpcodeSetSegmentAndOffsetUleb(): int { return 0x70 }
function bindOpcodeDoBind(): int { return 0x90 }
function bindTypePointer(): int { return 1 }
function rebaseOpcodeDone(): int { return 0x00 }
function rebaseOpcodeSetTypeImm(): int { return 0x10 }
function rebaseOpcodeSetSegmentAndOffsetUleb(): int { return 0x20 }
// 0x50 is DO_REBASE_IMM_TIMES (count in the low nibble); 0x60 would be the
// _ULEB_TIMES form with a trailing count uleb. We rebase one pointer at a time.
function rebaseOpcodeDoRebaseImmTimes(): int { return 0x50 }
function rebaseTypePointer(): int { return 1 }

// ---- helpers --------------------------------------------------------------

function meAlignUp(v: int, a: int): int {
  let rem = v % a
  if (rem == 0) {
    return v
  }
  return v + a - rem
}

// LEB128, unsigned: 7 bits per byte, little-end first, high bit marking
// continuation. dyld's rebase/bind streams are encoded this way.
function meUleb(out: ByteBuf, value: int) {
  let v = value
  while (true) {
    let b = v & 0x7f
    v = v >> 7
    if (v != 0) {
      b = b | 0x80
    }
    out.bytes = append(out.bytes, u8(b))
    if (v == 0) {
      break
    }
  }
}

// pagezero, text, [data], linkedit, dyld_info, symtab, dysymtab, dylinker,
// dylib, build_version, main, code_signature.
function meNcmds(hasDataSeg: bool): int {
  if (hasDataSeg) {
    return 12
  }
  return 11
}

function meIsBranch(kind: LoRelocKind): bool {
  return kind == LoRelocKind.Aarch64Call26 || kind == LoRelocKind.Aarch64Jump26
}

// True for a writable, file-backed __DATA section kind that can hold a rebasable
// absolute pointer (plain data, or a tlv_descriptor's fields).
function meIsDataSeg(kind: LoSectionKind): bool {
  // GcMeta is in __DATA precisely so its absolute code pointers can be rebased:
  // a stack-map entry that dyld did not slide would send the collector walking a
  // stale code range under PIE.
  return kind == LoSectionKind.Data || kind == LoSectionKind.TlsVars ||
    kind == LoSectionKind.TlsData || kind == LoSectionKind.GcMeta
}

// One bind: name the symbol, say it is a pointer, point at the segment+offset,
// then do it. dyld replays this stream at load to fill each imported GOT slot.
function meEmitBind(ops: ByteBuf, name: string, seg: int, off: int) {
  ops.bytes = append(ops.bytes, u8(bindOpcodeSetSymbolTrailingFlagsImm() | 0))
  appendBytes(ops, []byte(name))
  ops.bytes = append(ops.bytes, u8(0))
  ops.bytes = append(ops.bytes, u8(bindOpcodeSetTypeImm() | bindTypePointer()))
  ops.bytes = append(ops.bytes, u8(bindOpcodeSetSegmentAndOffsetUleb() | seg))
  meUleb(ops, off)
  ops.bytes = append(ops.bytes, u8(bindOpcodeDoBind()))
}

// One rebase of a single pointer: dyld adds the image's slide to the word at
// segment+offset.
function meEmitRebase(ops: ByteBuf, seg: int, off: int) {
  ops.bytes = append(ops.bytes, u8(rebaseOpcodeSetTypeImm() | rebaseTypePointer()))
  ops.bytes = append(ops.bytes, u8(rebaseOpcodeSetSegmentAndOffsetUleb() | seg))
  meUleb(ops, off)
  ops.bytes = append(ops.bytes, u8(rebaseOpcodeDoRebaseImmTimes() | 1))
}

// Where one kept atom landed. The seed's Placed.
struct MePlaced {
  module: int,
  atom: int,
  vaddr: int,
  fileOff: int,
}

// Lays each atom out at its required alignment, advancing the cursor. Returns
// the new cursor; Bit has no out-parameter, so the caller threads it.
struct MePlaceResult {
  items: []MePlaced,
  cursor: int,
}

function mePlaceAtoms(modules: []LoModule, items: []MePlaced, cursor: int): MePlaceResult {
  let c = cursor
  let i = 0
  while (i < len(items)) {
    let a = modules[items[i].module].atoms[items[i].atom]
    let al = a.alignment
    if (al < 1) {
      al = 1
    }
    c = meAlignUp(c, al)
    items[i].vaddr = c
    items[i].fileOff = c - meBaseVaddr()
    c = c + a.size
    i = i + 1
  }
  return MePlaceResult{ items: items, cursor: c }
}

// Byte extent of a placed group: from its first atom's address to the end of its
// last (a section's `size` in the output header). Not the sum of the atoms'
// sizes — inter-atom alignment padding counts.
function mePlacedSize(modules: []LoModule, items: []MePlaced): int {
  if (len(items) == 0) {
    return 0
  }
  let last = items[len(items) - 1]
  let end = last.vaddr + modules[last.module].atoms[last.atom].size
  return end - items[0].vaddr
}

// ===========================================================================
// Dead-strip with libSystem imports, output partitioning, GOT + stub synthesis
// ===========================================================================

// A GOT slot points at either an internal defined atom (rebased at load) or a
// libSystem import (bound at load). Stubs and the indirect symbol table read
// this. Bit has no tagged union; `isImport` selects which fields are live.
struct MeGotSlot {
  isImport: bool,
  name: string,
  module: int,
  atom: int,
}

// Everything the layout and emission slices need from the analysis pass.
struct MeLinkState {
  // Packed AtomId -> kept. The reachable set from __start.
  kept: map<int, bool>,
  // Undefined globals, in first-seen order — these become libSystem imports and
  // the symbol table's only entries. Order is load-bearing: the indirect symbol
  // table indexes into it.
  importOrder: []string,
  // Imports that are branch targets and therefore need a __stubs entry.
  branchImports: map<string, bool>,
  // Kept atoms partitioned by output class, in module/atom order.
  text: []MePlaced,
  rodata: []MePlaced,
  data: []MePlaced,
  bss: []MePlaced,
  tlsVars: []MePlaced,
  tlsData: []MePlaced,
  tlsBss: []MePlaced,
  // The __got, in slot order, plus the two indices into it.
  gotList: []MeGotSlot,
  gotOfInternal: map<int, int>,
  gotOfImport: map<string, int>,
  // The __stubs, in slot order.
  stubList: []string,
  stubOfImport: map<string, int>,
}

// Walks the reachability graph from __start. Unlike the ELF path's deadStrip, an
// undefined global here is NOT an error — it is a libSystem import, and a leaf:
// nothing beyond it is reachable in this image.
function meDeadStripWithImports(modules: []LoModule, globals: map<string, int>): MeLinkState! {
  let st = MeLinkState{ kept: map<int, bool>{}, importOrder: []string(0),
    branchImports: map<string, bool>{}, text: []MePlaced(0), rodata: []MePlaced(0),
    data: []MePlaced(0), bss: []MePlaced(0), tlsVars: []MePlaced(0),
    tlsData: []MePlaced(0), tlsBss: []MePlaced(0), gotList: []MeGotSlot(0),
    gotOfInternal: map<int, int>{}, gotOfImport: map<string, int>{},
    stubList: []string(0), stubOfImport: map<string, int>{} }

  let (entry, hasEntry) = globals[meEntrySymbol()]
  if (!hasEntry) {
    fail newError("MissingEntry")
  }
  let importSet = map<string, bool>{}
  st.kept[entry] = true
  let stack = [entry]
  while (len(stack) > 0) {
    let id = stack[len(stack) - 1]
    stack = stack[0:len(stack) - 1]
    let atom = modules[atomKeyModule(id)].atoms[atomKeyAtom(id)]
    let r = 0
    while (r < len(atom.relocs)) {
      let rel = atom.relocs[r]
      if (!rel.target.isGlobal) {
        let tid = atomKey(atomKeyModule(id), rel.target.local)
        let (_, seen) = st.kept[tid]
        if (!seen) {
          st.kept[tid] = true
          stack = append(stack, tid)
        }
      } else {
        let (tid, defined) = globals[rel.target.name]
        if (defined) {
          let (_, seen) = st.kept[tid]
          if (!seen) {
            st.kept[tid] = true
            stack = append(stack, tid)
          }
        } else {
          // Undefined: a dynamic import from libSystem.
          let (_, known) = importSet[rel.target.name]
          if (!known) {
            importSet[rel.target.name] = true
            st.importOrder = append(st.importOrder, rel.target.name)
          }
          if (meIsBranch(rel.kind)) {
            st.branchImports[rel.target.name] = true
          }
        }
      }
      r = r + 1
    }
  }
  return st
}

// Partitions the kept atoms by output class, in module/atom order — the order
// the sections are laid out in, so it fixes the final address of everything.
function mePartition(modules: []LoModule, st: MeLinkState): MeLinkState {
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let (_, keep) = st.kept[atomKey(mi, ai)]
      if (!keep) {
        ai = ai + 1
        continue
      }
      let p = MePlaced{ module: mi, atom: ai, vaddr: 0, fileOff: 0 }
      let k = atoms[ai].kind
      if (k == LoSectionKind.Text) {
        st.text = append(st.text, p)
      } else if (k == LoSectionKind.Rodata) {
        st.rodata = append(st.rodata, p)
      } else if (k == LoSectionKind.Data) {
        st.data = append(st.data, p)
      } else if (k == LoSectionKind.Bss) {
        st.bss = append(st.bss, p)
      } else if (k == LoSectionKind.TlsVars) {
        st.tlsVars = append(st.tlsVars, p)
      } else if (k == LoSectionKind.TlsData) {
        st.tlsData = append(st.tlsData, p)
      } else if (k == LoSectionKind.GcMeta) {
        // Placed as one uninterrupted run by the caller, not here: their order
        // and adjacency are the merged table's whole contract.
        ai = ai
      } else {
        assert(k == LoSectionKind.TlsBss)
        st.tlsBss = append(st.tlsBss, p)
      }
      ai = ai + 1
    }
    mi = mi + 1
  }
  return st
}

// The GOT slot for an import, appending it if new.
function meGotForImport(st: MeLinkState, name: string): int {
  let (i, found) = st.gotOfImport[name]
  if (found) {
    return i
  }
  let idx = len(st.gotList)
  st.gotOfImport[name] = idx
  st.gotList = append(st.gotList, MeGotSlot{ isImport: true, name: name,
    module: 0, atom: 0 })
  return idx
}

// Synthesizes the __got and __stubs from every kept atom's relocations.
//
// A TLVP slot is a GOT-like pointer to an internal tlv_descriptor (the access
// site does adrp/ldr to load its address), so it uses the same internal-GOT
// machinery as a plain GOT reference.
function meBuildGotAndStubs(modules: []LoModule, globals: map<string, int>, st: MeLinkState): MeLinkState! {
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let (_, keep) = st.kept[atomKey(mi, ai)]
      if (!keep) {
        ai = ai + 1
        continue
      }
      let relocs = atoms[ai].relocs
      let r = 0
      while (r < len(relocs)) {
        let rel = relocs[r]
        let isImport = false
        if (rel.target.isGlobal) {
          let (_, defined) = globals[rel.target.name]
          isImport = !defined
        }
        if (needsGot(rel.kind) || needsTlvp(rel.kind)) {
          if (isImport) {
            meGotForImport(st, rel.target.name)
          } else {
            let tid = resolveRef(globals, mi, rel.target)?
            let (_, have) = st.gotOfInternal[tid]
            if (!have) {
              st.gotOfInternal[tid] = len(st.gotList)
              st.gotList = append(st.gotList, MeGotSlot{ isImport: false, name: "",
                module: atomKeyModule(tid), atom: atomKeyAtom(tid) })
            }
          }
        }
        if (meIsBranch(rel.kind) && isImport) {
          // A branch to an import goes through a stub, which loads the import's
          // GOT slot — so the stub needs one too.
          meGotForImport(st, rel.target.name)
          let (_, haveStub) = st.stubOfImport[rel.target.name]
          if (!haveStub) {
            st.stubOfImport[rel.target.name] = len(st.stubList)
            st.stubList = append(st.stubList, rel.target.name)
          }
        }
        r = r + 1
      }
      ai = ai + 1
    }
    mi = mi + 1
  }
  return st
}

// The __DATA segment's load command only exists if something lives in it.
function meHasDataSeg(st: MeLinkState): bool {
  return len(st.gotList) > 0 || len(st.data) > 0 || len(st.bss) > 0 ||
    len(st.tlsVars) > 0 || len(st.tlsData) > 0 || len(st.tlsBss) > 0
}

// ===========================================================================
// Address assignment, relocation application, and the dyld info streams
// ===========================================================================

// An absolute pointer to an import: dyld binds it at load, so the field stays
// zero in the file and this records where.
struct MeDataBind {
  segOff: int,
  name: string,
}

// Everything the emission slice needs once addresses are fixed.
struct MePatched {
  // Packed AtomId -> the atom's relocated bytes.
  bytes: map<int, []u8>,
  dataBinds: []MeDataBind,
  // __DATA segment offsets holding an absolute internal pointer dyld must slide.
  dataRebases: []int,
}

// Packed AtomId -> final virtual address, over every placed group.
function meAddrMap(st: MeLinkState): map<int, int> {
  let m = map<int, int>{}
  meAddrMapGroup(m, st.text)
  meAddrMapGroup(m, st.rodata)
  meAddrMapGroup(m, st.data)
  meAddrMapGroup(m, st.bss)
  meAddrMapGroup(m, st.tlsVars)
  meAddrMapGroup(m, st.tlsData)
  meAddrMapGroup(m, st.tlsBss)
  return m
}

function meAddrMapGroup(m: map<int, int>, group: []MePlaced) {
  let i = 0
  while (i < len(group)) {
    m[atomKey(group[i].module, group[i].atom)] = group[i].vaddr
    i = i + 1
  }
}

function meStubAddr(stubsVaddr: int, i: int): int {
  return stubsVaddr + i * meStubSize()
}

function meGotAddr(gotVaddr: int, i: int): int {
  return gotVaddr + i * mePtrSize()
}

// The addresses the reloc pass needs but that only layout knows.
struct MeAddrs {
  stubsVaddr: int,
  gotVaddr: int,
  dataSegVaddr: int,
  // Base of the per-thread TLV template (__thread_data then __thread_bss). A
  // tlv_descriptor's data field is the variable's OFFSET within this template (a
  // constant dyld validates against the template size), not an absolute address —
  // so an abs64 into TLS storage resolves relative to here.
  tlsTemplateBase: int,
}

// Applies every relocation into per-atom mutable copies, collecting the data
// binds and rebases the dyld streams need. The atom's own bytes are never
// mutated: two atoms can share a backing slice, and the file needs the patched
// copy only.
function meApplyRelocs(modules: []LoModule, globals: map<string, int>, st: MeLinkState,
  addrOf: map<int, int>, a: MeAddrs): MePatched! {
  let out = MePatched{ bytes: map<int, []u8>{}, dataBinds: []MeDataBind(0),
    dataRebases: []int(0) }
  let mi = 0
  while (mi < len(modules)) {
    let atoms = modules[mi].atoms
    let ai = 0
    while (ai < len(atoms)) {
      let atom = atoms[ai]
      let id = atomKey(mi, ai)
      let (_, keep) = st.kept[id]
      if (!keep || len(atom.data) == 0) {
        ai = ai + 1
        continue
      }
      let buf = []u8(len(atom.data))
      let c = 0
      while (c < len(atom.data)) {
        buf[c] = atom.data[c]
        c = c + 1
      }
      let (atomVaddr, _) = addrOf[id]
      let r = 0
      while (r < len(atom.relocs)) {
        let rel = atom.relocs[r]
        let p = atomVaddr + rel.offset
        let isImport = false
        if (rel.target.isGlobal) {
          let (_, defined) = globals[rel.target.name]
          isImport = !defined
        }

        if (meIsBranch(rel.kind) && isImport) {
          // Retarget the branch to the import.s stub.
          let (si, _) = st.stubOfImport[rel.target.name]
          applyReloc(rel.kind, buf, rel.offset,
            RelocValues{ s: meStubAddr(a.stubsVaddr, si), p: p, gotSlot: 0, tpOffset: 0 })?
          r = r + 1
          continue
        }
        if (needsGot(rel.kind) || needsTlvp(rel.kind)) {
          let gi = 0
          if (isImport) {
            let (g, _) = st.gotOfImport[rel.target.name]
            gi = g
          } else {
            let tid = resolveRef(globals, mi, rel.target)?
            let (g, _) = st.gotOfInternal[tid]
            gi = g
          }
          applyReloc(rel.kind, buf, rel.offset,
            RelocValues{ s: 0, p: p, gotSlot: meGotAddr(a.gotVaddr, gi), tpOffset: 0 })?
          r = r + 1
          continue
        }
        if (rel.kind == LoRelocKind.Abs64 && isImport) {
          // Absolute pointer to an import: dyld binds it, so leave the field zero.
          // (Includes a tlv_descriptor's thunk field -> _tlv_bootstrap.)
          out.dataBinds = append(out.dataBinds,
            MeDataBind{ segOff: (atomVaddr + rel.offset) - a.dataSegVaddr,
              name: rel.target.name })
          r = r + 1
          continue
        }

        let tid = resolveRef(globals, mi, rel.target)?
        let (tgt, known) = addrOf[tid]
        if (!known) {
          fail newError("UndefinedSymbol")
        }
        let targetKind = modules[atomKeyModule(tid)].atoms[atomKeyAtom(tid)].kind

        // A pointer into thread-local storage (a tlv_descriptor's data field ->
        // x$tlv$init) is stored as the variable's constant OFFSET within the TLV
        // template, which dyld reads directly — not an absolute address, and never
        // rebased.
        if (rel.kind == LoRelocKind.Abs64 &&
          (targetKind == LoSectionKind.TlsData || targetKind == LoSectionKind.TlsBss)) {
          applyReloc(LoRelocKind.Abs64, buf, rel.offset,
            RelocValues{ s: tgt - a.tlsTemplateBase + rel.addend, p: 0, gotSlot: 0,
              tpOffset: 0 })?
          r = r + 1
          continue
        }

        // Everything else resolves to a concrete address.
        applyReloc(rel.kind, buf, rel.offset,
          RelocValues{ s: tgt + rel.addend, p: p, gotSlot: 0, tpOffset: 0 })?
        // An absolute internal pointer in a writable segment is rebased so dyld
        // slides it.
        if (rel.kind == LoRelocKind.Abs64 && meIsDataSeg(atom.kind)) {
          out.dataRebases = append(out.dataRebases,
            (atomVaddr + rel.offset) - a.dataSegVaddr)
        }
        r = r + 1
      }
      out.bytes[id] = buf
      ai = ai + 1
    }
    mi = mi + 1
  }

  // Internal GOT slots hold an absolute internal address -> rebase them too.
  let g = 0
  while (g < len(st.gotList)) {
    if (!st.gotList[g].isImport) {
      out.dataRebases = append(out.dataRebases,
        meGotAddr(a.gotVaddr, g) - a.dataSegVaddr)
    }
    g = g + 1
  }
  return out
}

// Ascending sort of the rebase offsets. dyld replays them in stream order, and a
// sorted stream is what every real linker emits — keeping the output
// deterministic and diffable.
function meSortOffsets(xs: []int): []int {
  let i = 1
  while (i < len(xs)) {
    let v = xs[i]
    let j = i - 1
    while (j >= 0 && xs[j] > v) {
      xs[j + 1] = xs[j]
      j = j - 1
    }
    xs[j + 1] = v
    i = i + 1
  }
  return xs
}

// The rebase opcode stream: one SET_TYPE, then a segment+offset and a
// one-pointer rebase per slot. Empty when nothing needs sliding.
function meRebaseStream(dataRebases: []int, dataSegIndex: int): ByteBuf {
  let ops = newByteBuf()
  if (len(dataRebases) == 0) {
    return ops
  }
  let sorted = meSortOffsets(dataRebases)
  ops.bytes = append(ops.bytes, u8(rebaseOpcodeSetTypeImm() | rebaseTypePointer()))
  let i = 0
  while (i < len(sorted)) {
    ops.bytes = append(ops.bytes, u8(rebaseOpcodeSetSegmentAndOffsetUleb() | dataSegIndex))
    meUleb(ops, sorted[i])
    ops.bytes = append(ops.bytes, u8(rebaseOpcodeDoRebaseImmTimes() | 1))
    i = i + 1
  }
  ops.bytes = append(ops.bytes, u8(rebaseOpcodeDone()))
  return ops
}

// The bind opcode stream: every import's GOT slot, then every absolute data
// pointer to an import. libSystem is dylib ordinal 1 — the only one loaded.
function meBindStream(st: MeLinkState, dataBinds: []MeDataBind, gotVaddr: int,
  dataSegVaddr: int, dataSegIndex: int): ByteBuf {
  let ops = newByteBuf()
  ops.bytes = append(ops.bytes, u8(bindOpcodeSetDylibOrdinalImm() | 1))
  let i = 0
  while (i < len(st.gotList)) {
    if (st.gotList[i].isImport) {
      meEmitBind(ops, st.gotList[i].name, dataSegIndex,
        meGotAddr(gotVaddr, i) - dataSegVaddr)
    }
    i = i + 1
  }
  i = 0
  while (i < len(dataBinds)) {
    meEmitBind(ops, dataBinds[i].name, dataSegIndex, dataBinds[i].segOff)
    i = i + 1
  }
  ops.bytes = append(ops.bytes, u8(bindOpcodeDone()))
  return ops
}

// The symbol table: imports only. A statically resolved internal symbol needs no
// entry — nothing at runtime looks it up.
struct MeSymtab {
  strtab: ByteBuf,
  // One nlist_64 per import, in importOrder.
  nlists: ByteBuf,
  symIndex: map<string, int>,
}

function meBuildSymtab(st: MeLinkState): MeSymtab {
  let strtab = newByteBuf()
  strtab.bytes = append(strtab.bytes, u8(0)) // index 0 == ""
  let nlists = newByteBuf()
  let symIndex = map<string, int>{}
  let i = 0
  while (i < len(st.importOrder)) {
    let nm = st.importOrder[i]
    let strx = len(strtab.bytes)
    appendBytes(strtab, []byte(nm))
    strtab.bytes = append(strtab.bytes, u8(0))
    symIndex[nm] = i
    appendU32(nlists, strx)
    nlists.bytes = append(nlists.bytes, u8(0x0 | 0x01)) // N_UNDF | N_EXT
    nlists.bytes = append(nlists.bytes, u8(0))          // n_sect: NO_SECT
    appendU16(nlists, 0)                                // n_desc
    appendU64(nlists, 0)                                // n_value
    i = i + 1
  }
  return MeSymtab{ strtab: strtab, nlists: nlists, symIndex: symIndex }
}

// The indirect symbol table: stubs first, then the GOT — the order the section
// headers' reserved1 indices assume. An internal GOT slot has no symbol, so it
// is marked LOCAL.
function meIndirectSymbols(st: MeLinkState, symIndex: map<string, int>): []int {
  let out = []int(0)
  let i = 0
  while (i < len(st.stubList)) {
    let (idx, _) = symIndex[st.stubList[i]]
    out = append(out, idx)
    i = i + 1
  }
  i = 0
  while (i < len(st.gotList)) {
    if (st.gotList[i].isImport) {
      let (idx, _) = symIndex[st.gotList[i].name]
      out = append(out, idx)
    } else {
      out = append(out, indirectSymbolLocal())
    }
    i = i + 1
  }
  return out
}

// ===========================================================================
// Load-command emitters
//
// Each appends one command's exact on-disk bytes. Sizes are fixed and asserted
// against sizeofcmds at the end of linkExecutable: every file offset recorded in
// a command is computed from that total, so a wrong size makes every one a lie.
// ===========================================================================

function meAppendName16(lc: ByteBuf, s: string) {
  let b = []byte(s)
  assert(len(b) <= 16)
  appendBytes(lc, b)
  appendZeros(lc, 16 - len(b))
}

// A NUL-terminated path padded out to the command's declared size.
function meAppendPaddedStr(lc: ByteBuf, s: string, cmdsize: int, offset: int) {
  let b = []byte(s)
  appendBytes(lc, b)
  appendZeros(lc, cmdsize - offset - len(b))
}

function meAppendSeg(lc: ByteBuf, seg: string, vmaddr: int, vmsize: int,
  fileoff: int, filesize: int, initprot: int, maxprot: int, nsects: int) {
  appendU32(lc, lcSegment64())
  appendU32(lc, mrSizeofSegment() + nsects * mrSizeofSection())
  meAppendName16(lc, seg)
  appendU64(lc, vmaddr)
  appendU64(lc, vmsize)
  appendU64(lc, fileoff)
  appendU64(lc, filesize)
  appendU32(lc, maxprot)
  appendU32(lc, initprot)
  appendU32(lc, nsects)
  appendU32(lc, 0) // flags
}

function meAppendSect(lc: ByteBuf, sect: string, seg: string, addr: int, size: int,
  offset: int, alignLog2: int, flags: int, reserved1: int, reserved2: int) {
  meAppendName16(lc, sect)
  meAppendName16(lc, seg)
  appendU64(lc, addr)
  appendU64(lc, size)
  appendU32(lc, offset)
  appendU32(lc, alignLog2)
  appendU32(lc, 0) // reloff: an executable's sections carry no relocations
  appendU32(lc, 0) // nreloc
  appendU32(lc, flags)
  appendU32(lc, reserved1)
  appendU32(lc, reserved2)
  appendU32(lc, 0) // reserved3
}

// Only undefined symbols are described; the indirect table drives stubs/got.
function meAppendDysymtab(lc: ByteBuf, nundef: int, indirectOff: int, nindirect: int) {
  appendU32(lc, lcDysymtab())
  appendU32(lc, 80)
  appendU32(lc, 0) // ilocalsym
  appendU32(lc, 0) // nlocalsym
  appendU32(lc, 0) // iextdefsym
  appendU32(lc, 0) // nextdefsym
  appendU32(lc, 0) // iundefsym
  appendU32(lc, nundef)
  appendU32(lc, 0) // tocoff
  appendU32(lc, 0) // ntoc
  appendU32(lc, 0) // modtaboff
  appendU32(lc, 0) // nmodtab
  appendU32(lc, 0) // extrefsymoff
  appendU32(lc, 0) // nextrefsyms
  appendU32(lc, indirectOff)
  appendU32(lc, nindirect)
  appendU32(lc, 0) // extreloff
  appendU32(lc, 0) // nextrel
  appendU32(lc, 0) // locreloff
  appendU32(lc, 0) // nlocrel
}

function meDylinkerCmdsize(): int {
  return meAlignUp(12 + len([]byte(meDylinkerPath())) + 1, 8)
}

function meDylibCmdsize(): int {
  return meAlignUp(24 + len([]byte(meLibsystemPath())) + 1, 8)
}

function meAppendDylinker(lc: ByteBuf) {
  let cmdsize = meDylinkerCmdsize()
  appendU32(lc, lcLoadDylinker())
  appendU32(lc, cmdsize)
  appendU32(lc, 12) // name.offset
  meAppendPaddedStr(lc, meDylinkerPath(), cmdsize, 12)
}

function meAppendDylib(lc: ByteBuf) {
  let cmdsize = meDylibCmdsize()
  appendU32(lc, lcLoadDylib())
  appendU32(lc, cmdsize)
  appendU32(lc, 24) // name.offset
  appendU32(lc, 2)  // timestamp
  appendU32(lc, 0)  // current_version (any)
  appendU32(lc, 0)  // compatibility_version (any)
  meAppendPaddedStr(lc, meLibsystemPath(), cmdsize, 24)
}

// entryoff is the entry's FILE offset (__TEXT starts at file offset 0); dyld
// calls it with the C main(argc,argv,envp,apple) ABI.
function meAppendMain(lc: ByteBuf, entryoff: int) {
  appendU32(lc, lcMain())
  appendU32(lc, 24)
  appendU64(lc, entryoff)
  appendU64(lc, 0) // stacksize: 0 == default
}

function meAppendBuildVersion(lc: ByteBuf) {
  appendU32(lc, lcBuildVersion())
  appendU32(lc, 24)
  appendU32(lc, platformMacos())
  appendU32(lc, 0x000B0000) // minos: macOS 11.0
  appendU32(lc, 0x000B0000) // sdk:   macOS 11.0
  appendU32(lc, 0)          // ntools
}

function meAppendDyldInfo(lc: ByteBuf, rebaseOff: int, rebaseSize: int,
  bindOff: int, bindSize: int) {
  appendU32(lc, lcDyldInfoOnly())
  appendU32(lc, 48)
  appendU32(lc, rebaseOff)
  appendU32(lc, rebaseSize)
  appendU32(lc, bindOff)
  appendU32(lc, bindSize)
  appendU32(lc, 0) // weak_bind_off
  appendU32(lc, 0) // weak_bind_size
  appendU32(lc, 0) // lazy_bind_off
  appendU32(lc, 0) // lazy_bind_size
  appendU32(lc, 0) // export_off
  appendU32(lc, 0) // export_size
}

function meAppendSymtab(lc: ByteBuf, symoff: int, nsyms: int, stroff: int, strsize: int) {
  appendU32(lc, lcSymtabCmd())
  appendU32(lc, 24)
  appendU32(lc, symoff)
  appendU32(lc, nsyms)
  appendU32(lc, stroff)
  appendU32(lc, strsize)
}

function meAppendCodeSignature(lc: ByteBuf, sigOff: int, sigSize: int) {
  appendU32(lc, lcCodeSignature())
  appendU32(lc, 16)
  appendU32(lc, sigOff)
  appendU32(lc, sigSize)
}

// The Mach-O header. PIE: dyld picks a random slide, and every relocation this
// backend applies is PC-relative and so slide-invariant.
function meAppendHeader(out: ByteBuf, sizeofcmds: int, hasDataSeg: bool, hasTlvVars: bool) {
  appendU32(out, 0xfeedfacf)  // MH_MAGIC_64
  appendU32(out, 0x0100000C)  // CPU_TYPE_ARM64
  appendU32(out, 0)           // CPU_SUBTYPE_ARM64_ALL
  appendU32(out, mhExecute())
  appendU32(out, meNcmds(hasDataSeg))
  appendU32(out, sizeofcmds)
  let flags = mhDyldlink() | mhTwolevel() | mhPie()
  if (hasTlvVars) {
    // Without this dyld skips TLV setup and the first thread-local access calls
    // the placeholder thunk -> _tlv_bootstrap_error.
    flags = flags | mhHasTlvDescriptors()
  }
  appendU32(out, flags)
  appendU32(out, 0) // reserved
}

// The total load-command byte count. Computed before layout, because every file
// offset a command records is measured from the end of the commands.
function meSizeofcmds(textNsects: int, dataNsects: int, hasDataSeg: bool): int {
  let n = mrSizeofSegment()                                 // __PAGEZERO
  n = n + mrSizeofSegment() + textNsects * mrSizeofSection() // __TEXT
  if (hasDataSeg) {
    n = n + mrSizeofSegment() + dataNsects * mrSizeofSection() // __DATA
  }
  n = n + mrSizeofSegment() // __LINKEDIT
  n = n + 48                // LC_DYLD_INFO_ONLY
  n = n + 24                // LC_SYMTAB
  n = n + 80                // LC_DYSYMTAB
  n = n + meDylinkerCmdsize()
  n = n + meDylibCmdsize()
  n = n + 24                // LC_BUILD_VERSION
  n = n + 24                // LC_MAIN
  n = n + 16                // LC_CODE_SIGNATURE
  return n
}

function meTextNsects(st: MeLinkState): int {
  let n = 1 // __text always exists
  if (len(st.stubList) > 0) {
    n = n + 1
  }
  if (len(st.rodata) > 0) {
    n = n + 1
  }
  return n
}

function meDataNsects(st: MeLinkState): int {
  let n = 0
  if (len(st.gotList) > 0) { n = n + 1 }
  if (len(st.data) > 0) { n = n + 1 }
  if (len(st.tlsVars) > 0) { n = n + 1 }
  if (len(st.tlsData) > 0) { n = n + 1 }
  if (len(st.tlsBss) > 0) { n = n + 1 }
  if (len(st.bss) > 0) { n = n + 1 }
  return n
}

// The three-instruction stub dyld never touches: load the import's GOT slot and
// jump through it. adrp x16, got ; ldr x16, [x16, off] ; br x16.
function meWriteStub(file: []u8, off: int, stubVaddr: int, gotSlot: int): ()! {
  loWrU32(file, off, 0x90000010)     // adrp x16, 0
  loWrU32(file, off + 4, 0xF9400210) // ldr x16, [x16]
  loWrU32(file, off + 8, 0xD61F0200) // br x16
  applyReloc(LoRelocKind.Aarch64AdrGotPage, file, off,
    RelocValues{ s: 0, p: stubVaddr, gotSlot: gotSlot, tpOffset: 0 })?
  applyReloc(LoRelocKind.Aarch64Ld64GotLo12Nc, file, off + 4,
    RelocValues{ s: 0, p: 0, gotSlot: gotSlot, tpOffset: 0 })?
}

// ===========================================================================
// linkExecutable — the driver
// ===========================================================================

// Links `modules` into an ad-hoc-signed, dynamically-linked arm64 Mach-O
// executable, returned as owned bytes.
//
// The order below is forced: the load-command SIZES fix where __TEXT's content
// starts, which fixes every atom's address, which fixes every relocation — so
// sizeofcmds is computed from section COUNTS before a single address is
// assigned, and the commands themselves are only emitted at the end, once every
// offset they record is known.
function linkExecutable(inputModules: []LoModule, identifier: string): []u8! {
  // ABI.md §4: the merged GC stack-map table's bounds are linker-defined, so the
  // boundary symbols enter the link as a synthetic module appended last (stable
  // index) and BEFORE resolution, so the runtime's extern references resolve
  // like any other global.
  let modules = inputModules
  let markerModuleIdx = len(modules)
  modules = append(modules, markerModule("_"))

  let globals = resolveGlobals(modules)?
  let st0 = meDeadStripWithImports(modules, globals)?
  // The boundary markers are kept unconditionally: the runtime's externs must
  // resolve even for a program whose every stack-map entry was stripped, where
  // an empty extent (start == end) is the right answer.
  st0.kept[atomKey(markerModuleIdx, markerStartAtom())] = true
  st0.kept[atomKey(markerModuleIdx, markerEndAtom())] = true
  // A stack-map entry survives iff its function did — see keepLiveStackMaps.
  // Without it the entries, which nothing references, are all dead-stripped,
  // the merged extent comes out EMPTY, and the collector silently loses every
  // precise root.
  keepLiveStackMaps(modules, globals, st0.kept)?

  let st1 = mePartition(modules, st0)

  // ---- merged GC stack-map group (ABI.md §4) -----------------------------
  // Appended to __data as one contiguous run bounded by the two markers, with
  // nothing interleaved — the entries carry no count and no terminator, so those
  // bounds are the only thing that delimits the runtime's walk. Appending last
  // means no later atom can land inside the extent.
  let gcGroup = mergedStackMapAtoms(modules, st0.kept, markerModuleIdx)
  let gi = 0
  while (gi < len(gcGroup)) {
    st1.data = append(st1.data, MePlaced{ module: atomKeyModule(gcGroup[gi]),
      atom: atomKeyAtom(gcGroup[gi]), vaddr: 0, fileOff: 0 })
    gi = gi + 1
  }

  let st = meBuildGotAndStubs(modules, globals, st1)?

  let hasDataSeg = meHasDataSeg(st)
  let sizeofcmds = meSizeofcmds(meTextNsects(st), meDataNsects(st), hasDataSeg)
  let headersSize = mrSizeofHeader() + sizeofcmds

  // ---- __TEXT layout: headers, text atoms, stubs, rodata -----------------
  let cursor = meBaseVaddr() + headersSize
  let textRes = mePlaceAtoms(modules, st.text, cursor)
  st.text = textRes.items
  let stubsVaddr = meAlignUp(textRes.cursor, 4)
  cursor = stubsVaddr + len(st.stubList) * meStubSize()
  let rodataVaddr = cursor
  let rodataRes = mePlaceAtoms(modules, st.rodata, cursor)
  st.rodata = rodataRes.items
  let textSegFilesize = meAlignUp(rodataRes.cursor - meBaseVaddr(), meSegAlign())
  let textSegVmsize = textSegFilesize

  // ---- __DATA layout: got, data, TLS, then zero-fill last ----------------
  // File-backed sections first, then the zero-fill ones. __thread_data and
  // __thread_bss stay adjacent so they form one contiguous per-thread TLV
  // template dyld can copy.
  let dataSegVaddr = meBaseVaddr() + textSegVmsize
  cursor = dataSegVaddr
  let gotVaddr = cursor
  cursor = cursor + len(st.gotList) * mePtrSize()
  let dataRes = mePlaceAtoms(modules, st.data, cursor)
  st.data = dataRes.items
  let tvRes = mePlaceAtoms(modules, st.tlsVars, dataRes.cursor)
  st.tlsVars = tvRes.items
  let tdRes = mePlaceAtoms(modules, st.tlsData, tvRes.cursor)
  st.tlsData = tdRes.items
  let dataFileEnd = tdRes.cursor // the last file-backed byte in __DATA
  let tbRes = mePlaceAtoms(modules, st.tlsBss, dataFileEnd)
  st.tlsBss = tbRes.items
  let bssRes = mePlaceAtoms(modules, st.bss, tbRes.cursor)
  st.bss = bssRes.items
  let dataSegFilesize = 0
  let dataSegVmsize = 0
  if (hasDataSeg) {
    dataSegFilesize = meAlignUp(dataFileEnd - dataSegVaddr, meSegAlign())
    dataSegVmsize = meAlignUp(bssRes.cursor - dataSegVaddr, meSegAlign())
  }

  // Base of the per-thread TLV template (__thread_data then __thread_bss).
  let tlsTemplateBase = 0
  if (len(st.tlsData) > 0) {
    tlsTemplateBase = st.tlsData[0].vaddr
  } else if (len(st.tlsBss) > 0) {
    tlsTemplateBase = st.tlsBss[0].vaddr
  }

  let addrOf = meAddrMap(st)
  let (entryId, _) = globals[meEntrySymbol()]
  let (entryVaddr, haveEntry) = addrOf[entryId]
  if (!haveEntry) {
    fail newError("MissingEntry")
  }

  let addrs = MeAddrs{ stubsVaddr: stubsVaddr, gotVaddr: gotVaddr,
    dataSegVaddr: dataSegVaddr, tlsTemplateBase: tlsTemplateBase }
  let pat = meApplyRelocs(modules, globals, st, addrOf, addrs)?

  // ---- dyld info streams -------------------------------------------------
  let dataSegIndex = 0 // __PAGEZERO, __TEXT, __DATA
  if (hasDataSeg) {
    dataSegIndex = 2
  }
  let rebaseOps = meRebaseStream(pat.dataRebases, dataSegIndex)
  let bindOps = meBindStream(st, pat.dataBinds, gotVaddr, dataSegVaddr, dataSegIndex)
  let sym = meBuildSymtab(st)
  let indirect = meIndirectSymbols(st, sym.symIndex)

  // ---- __LINKEDIT layout -------------------------------------------------
  let linkeditFileoff = textSegFilesize + dataSegFilesize
  let leCursor = linkeditFileoff
  let rebaseOff = leCursor
  leCursor = leCursor + len(rebaseOps.bytes)
  let bindOff = leCursor
  leCursor = leCursor + len(bindOps.bytes)
  leCursor = meAlignUp(leCursor, 8)
  let symtabOff = leCursor
  leCursor = leCursor + len(sym.nlists.bytes)
  let indirectOff = leCursor
  leCursor = leCursor + len(indirect) * 4
  let strtabOff = leCursor
  leCursor = leCursor + len(sym.strtab.bytes)
  let sigOff = meAlignUp(leCursor, 16)
  let sigSize = codeSignatureSize(sigOff, identifier)
  let linkeditFileEnd = sigOff + sigSize
  let linkeditFilesize = linkeditFileEnd - linkeditFileoff
  let linkeditVaddr = meBaseVaddr() + textSegVmsize + dataSegVmsize

  // ---- assemble the file -------------------------------------------------
  let file = []u8(linkeditFileEnd)
  meCopyGroup(file, modules, pat, st.text)
  meCopyGroup(file, modules, pat, st.rodata)
  meCopyGroup(file, modules, pat, st.data)
  meCopyGroup(file, modules, pat, st.tlsVars)
  meCopyGroup(file, modules, pat, st.tlsData)
  // __thread_bss/__bss are zero-fill and carry no bytes.

  let i = 0
  while (i < len(st.stubList)) {
    let (gi, _) = st.gotOfImport[st.stubList[i]]
    let sv = meStubAddr(stubsVaddr, i)
    meWriteStub(file, sv - meBaseVaddr(), sv, meGotAddr(gotVaddr, gi))?
    i = i + 1
  }
  // Internal GOT slots hold their target's absolute address (dyld rebases them);
  // import slots stay zero until dyld binds them.
  i = 0
  while (i < len(st.gotList)) {
    if (!st.gotList[i].isImport) {
      let (tgt, _) = addrOf[atomKey(st.gotList[i].module, st.gotList[i].atom)]
      loWrU64(file, meGotAddr(gotVaddr, i) - meBaseVaddr(), tgt)
    }
    i = i + 1
  }

  meCopyBytes(file, rebaseOff, rebaseOps.bytes)
  meCopyBytes(file, bindOff, bindOps.bytes)
  meCopyBytes(file, symtabOff, sym.nlists.bytes)
  i = 0
  while (i < len(indirect)) {
    loWrU32(file, indirectOff + i * 4, indirect[i])
    i = i + 1
  }
  meCopyBytes(file, strtabOff, sym.strtab.bytes)

  // ---- header + load commands --------------------------------------------
  let lc = newByteBuf()
  meAppendSeg(lc, "__PAGEZERO", 0, meBaseVaddr(), 0, 0, 0, 0, 0)
  meAppendSeg(lc, "__TEXT", meBaseVaddr(), textSegVmsize, 0, textSegFilesize, 5, 5,
    meTextNsects(st))
  let textEnd = meBaseVaddr() + headersSize
  if (len(st.text) > 0) {
    let last = st.text[len(st.text) - 1]
    textEnd = last.vaddr + modules[last.module].atoms[last.atom].size
  }
  meAppendSect(lc, "__text", "__TEXT", meBaseVaddr() + headersSize,
    textEnd - (meBaseVaddr() + headersSize), headersSize, 2, 0x80000400, 0, 0)
  if (len(st.stubList) > 0) {
    meAppendSect(lc, "__stubs", "__TEXT", stubsVaddr, len(st.stubList) * meStubSize(),
      stubsVaddr - meBaseVaddr(), 2, sSymbolStubs() | 0x80000400, 0, meStubSize())
  }
  if (len(st.rodata) > 0) {
    meAppendSect(lc, "__const", "__TEXT", rodataVaddr, mePlacedSize(modules, st.rodata),
      rodataVaddr - meBaseVaddr(), 0, 0x0, 0, 0)
  }
  if (hasDataSeg) {
    meAppendSeg(lc, "__DATA", dataSegVaddr, dataSegVmsize, textSegFilesize,
      dataSegFilesize, 3, 3, meDataNsects(st))
    // The indirect table's stubs occupy [0, nstubs); the got starts at nstubs —
    // which is what __got's reserved1 records.
    if (len(st.gotList) > 0) {
      meAppendSect(lc, "__got", "__DATA", gotVaddr, len(st.gotList) * mePtrSize(),
        gotVaddr - meBaseVaddr(), 3, sNonLazySymbolPointers(), len(st.stubList), 0)
    }
    if (len(st.data) > 0) {
      meAppendSect(lc, "__data", "__DATA", st.data[0].vaddr,
        mePlacedSize(modules, st.data), st.data[0].vaddr - meBaseVaddr(), 3, 0x0, 0, 0)
    }
    if (len(st.tlsVars) > 0) {
      meAppendSect(lc, "__thread_vars", "__DATA", st.tlsVars[0].vaddr,
        mePlacedSize(modules, st.tlsVars), st.tlsVars[0].vaddr - meBaseVaddr(), 3,
        sThreadLocalVariables(), 0, 0)
    }
    if (len(st.tlsData) > 0) {
      meAppendSect(lc, "__thread_data", "__DATA", st.tlsData[0].vaddr,
        mePlacedSize(modules, st.tlsData), st.tlsData[0].vaddr - meBaseVaddr(), 3,
        sThreadLocalRegular(), 0, 0)
    }
    // The zero-fill sections carry no file offset.
    if (len(st.tlsBss) > 0) {
      meAppendSect(lc, "__thread_bss", "__DATA", st.tlsBss[0].vaddr,
        mePlacedSize(modules, st.tlsBss), 0, 3, sThreadLocalZerofill(), 0, 0)
    }
    if (len(st.bss) > 0) {
      meAppendSect(lc, "__bss", "__DATA", st.bss[0].vaddr,
        mePlacedSize(modules, st.bss), 0, 3, 0x1, 0, 0)
    }
  }
  meAppendSeg(lc, "__LINKEDIT", linkeditVaddr, meAlignUp(linkeditFilesize, meSegAlign()),
    linkeditFileoff, linkeditFilesize, 1, 1, 0)
  meAppendDyldInfo(lc, rebaseOff, len(rebaseOps.bytes), bindOff, len(bindOps.bytes))
  meAppendSymtab(lc, symtabOff, len(st.importOrder), strtabOff, len(sym.strtab.bytes))
  meAppendDysymtab(lc, len(st.importOrder), indirectOff, len(indirect))
  meAppendDylinker(lc)
  meAppendDylib(lc)
  meAppendBuildVersion(lc)
  meAppendMain(lc, entryVaddr - meBaseVaddr())
  meAppendCodeSignature(lc, sigOff, sigSize)

  // If this trips, a struct size above is wrong and every file offset recorded
  // in a command is a lie.
  assert(len(lc.bytes) == sizeofcmds)

  let hdr = newByteBuf()
  meAppendHeader(hdr, sizeofcmds, hasDataSeg, len(st.tlsVars) > 0)
  meCopyBytes(file, 0, hdr.bytes)
  meCopyBytes(file, mrSizeofHeader(), lc.bytes)

  // ---- ad-hoc code signature over [0, sigOff) ----------------------------
  let sig = buildCodeSignature(file[0:sigOff], identifier, textSegFilesize)
  meCopyBytes(file, sigOff, sig)
  return file
}

// Copies each placed atom's bytes (patched if it had relocations) to its file
// offset.
function meCopyGroup(file: []u8, modules: []LoModule, pat: MePatched, group: []MePlaced) {
  let i = 0
  while (i < len(group)) {
    let id = atomKey(group[i].module, group[i].atom)
    let (bytes, patched) = pat.bytes[id]
    if (!patched) {
      bytes = modules[group[i].module].atoms[group[i].atom].data
    }
    meCopyBytes(file, group[i].fileOff, bytes)
    i = i + 1
  }
}

function meCopyBytes(file: []u8, off: int, src: []u8) {
  let i = 0
  while (i < len(src)) {
    file[off + i] = src[i]
    i = i + 1
  }
}

// ===========================================================================
// link — the entry point
// ===========================================================================

// One linker input. Bit has no tagged union: `isArchive` selects how `bytes` is
// read.
struct MeInput {
  isArchive: bool,
  bytes: []u8,
}

// A single relocatable Mach-O object — the compiled Bit program.
function meObjectInput(bytes: []u8): MeInput {
  return MeInput{ isArchive: false, bytes: bytes }
}

// An ar archive (libbitrt.a); every member is read as its own module.
function meArchiveInput(bytes: []u8): MeInput {
  return MeInput{ isArchive: true, bytes: bytes }
}

// Reads `inputs` (the compiled Bit Mach-O object plus libbitrt.a) into the
// generic object model and links them into an ad-hoc-signed executable.
function linkMacho(inputs: []MeInput, identifier: string): []u8! {
  let modules = []LoModule(0)
  let i = 0
  while (i < len(inputs)) {
    if (inputs[i].isArchive) {
      let members = parseArchive(inputs[i].bytes)?
      let j = 0
      while (j < len(members)) {
        modules = append(modules, readMachoObject(members[j].name, members[j].data)?)
        j = j + 1
      }
    } else {
      modules = append(modules, readMachoObject("bit.o", inputs[i].bytes)?)
    }
    i = i + 1
  }
  return linkExecutable(modules, identifier)?
}
