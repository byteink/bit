// In-Bit self-checks for the Mach-O object reader. Split out of selfcheck.bit
// (#1503); sibling .bit files are the same module, so `selfcheck()` still
// calls these directly.

// Stage 3 (#1344) the Mach-O object reader. The seed's second test reads the
// real libbitrt.a off disk; selfcheck does no file I/O, so the equivalent here
// round-trips this compiler's OWN Mach-O writer (#1343) through the reader — the
// two are independent implementations of the same format, so agreement is real
// evidence. (The reader was additionally verified against the real 231KB
// libbitrt_zcu.o during development: 3855 relocations == otool's 4083 entries
// minus 228 folded ARM64_RELOC_ADDEND prefixes, and 90 == 90 globals. The
// ARM64_RELOC_ADDEND path has no round-trip coverage — the writer never emits
// one — which is why that check mattered.)

function mrErr(bytes: []u8): string {
  let msg = ""
  let m = readMachoObject("t", bytes) catch e {
    msg = e.message()
    LoModule{ name: "", atoms: []LoAtom(0) }
  }
  return msg
}

function checkMachoReaderRoundTrip() {
  // adrp x0, _msg ; add x0, x0, _msg ; ret — plus a rodata string it names, and
  // a branch to an undefined external.
  let code = [u8(0x00), u8(0x00), u8(0x00), u8(0x90), u8(0x00), u8(0x00), u8(0x00), u8(0x91),
    u8(0x00), u8(0x00), u8(0x00), u8(0x94), u8(0xc0), u8(0x03), u8(0x5f), u8(0xd6)]
  let rodata = []byte("hi")
  let obj = MachoObject{
    sections: [
      MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0, alignment: 4 },
      MachoSection{ kind: MachoSectionKind.Rodata, data: rodata, size: 0, alignment: 1 }],
    symbols: [
      MachoSymbol{ name: "_probe", hasSection: true, section: MachoSectionKind.Text,
        offset: 0, size: len(code), binding: MachoBinding.Global },
      MachoSymbol{ name: "_msg", hasSection: true, section: MachoSectionKind.Rodata,
        offset: 0, size: 2, binding: MachoBinding.Local },
      MachoSymbol{ name: "_bit_rt_gc_alloc", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [
      MachoRelocation{ section: MachoSectionKind.Text, offset: 0, symbol: "_msg",
        kind: MachoRelocKind.Page21 },
      MachoRelocation{ section: MachoSectionKind.Text, offset: 4, symbol: "_msg",
        kind: MachoRelocKind.Pageoff12 },
      MachoRelocation{ section: MachoSectionKind.Text, offset: 8,
        symbol: "_bit_rt_gc_alloc", kind: MachoRelocKind.Branch }] }
  let bytes = writeMacho(MachoTarget.Aarch64, obj) catch e {
    assert(false)
    []u8(0)
  }
  assert(mrErr(bytes) == "")
  let m = readMachoObject("libbitrt_zcu.o", bytes) catch e {
    LoModule{ name: "", atoms: []LoAtom(0) }
  }
  assert(m.name == "libbitrt_zcu.o")
  // One atom per defined symbol: _probe (text) and _msg (rodata). The undefined
  // external defines nothing, so it gets no atom.
  assert(len(m.atoms) == 2)
  assert(m.atoms[0].name == "_probe" && m.atoms[0].kind == LoSectionKind.Text)
  assert(m.atoms[0].binding == LoBinding.Global)
  assert(m.atoms[0].size == 16 && m.atoms[0].alignment == 4)
  assert(m.atoms[1].name == "_msg" && m.atoms[1].kind == LoSectionKind.Rodata)
  assert(m.atoms[1].binding == LoBinding.Local)

  // All three relocations land on the text atom, in order.
  assert(len(m.atoms[0].relocs) == 3)
  let r0 = m.atoms[0].relocs[0]
  let r1 = m.atoms[0].relocs[1]
  let r2 = m.atoms[0].relocs[2]
  assert(r0.offset == 0 && r0.kind == LoRelocKind.Aarch64AdrPrelPgHi21)
  // PAGEOFF12 is ONE Mach-O type spanning ADD and every LDR/STR width; the
  // reader decodes the instruction word to pick the kind. This one is an ADD.
  assert(r1.offset == 4 && r1.kind == LoRelocKind.Aarch64AddAbsLo12Nc)
  assert(r2.offset == 8 && r2.kind == LoRelocKind.Aarch64Call26)
  // A local target resolves within the module; an undefined external stays a
  // name for the whole-link table.
  assert(!r0.target.isGlobal && m.atoms[r0.target.local].name == "_msg")
  assert(r2.target.isGlobal && r2.target.name == "_bit_rt_gc_alloc")
}

function checkMachoReaderPageoff12() {
  // The PAGEOFF12 scale decode, one instruction per width. Each is `ldr Xt,
  // [x0, #imm]` at a different access size, and the generic kind must carry the
  // scale — the Mach-O type is identical for all of them.
  let ldr8 = [u8(0x00), u8(0x00), u8(0x40), u8(0x39)]   // ldrb w0, [x0]
  let ldr16 = [u8(0x00), u8(0x00), u8(0x40), u8(0x79)]  // ldrh w0, [x0]
  let ldr32 = [u8(0x00), u8(0x00), u8(0x40), u8(0xb9)]  // ldr w0, [x0]
  let ldr64 = [u8(0x00), u8(0x00), u8(0x40), u8(0xf9)]  // ldr x0, [x0]
  let ldr128 = [u8(0x00), u8(0x00), u8(0xc0), u8(0x3d)] // ldr q0, [x0]
  let add = [u8(0x00), u8(0x00), u8(0x00), u8(0x91)]    // add x0, x0, #0

  assert(mrPageoffKind(ldr8) == LoRelocKind.Aarch64Ldst8AbsLo12Nc)
  assert(mrPageoffKind(ldr16) == LoRelocKind.Aarch64Ldst16AbsLo12Nc)
  assert(mrPageoffKind(ldr32) == LoRelocKind.Aarch64Ldst32AbsLo12Nc)
  assert(mrPageoffKind(ldr64) == LoRelocKind.Aarch64Ldst64AbsLo12Nc)
  // 128-bit SIMD has size=00 but bit[23] set — it must NOT read as ldst8.
  assert(mrPageoffKind(ldr128) == LoRelocKind.Aarch64Ldst128AbsLo12Nc)
  assert(mrPageoffKind(add) == LoRelocKind.Aarch64AddAbsLo12Nc)

  // UNSIGNED picks its width from the reloc's length field, not the instruction.
  assert(mrKindOf(0, 3, ldr64) == LoRelocKind.Abs64)
  assert(mrKindOf(0, 2, ldr64) == LoRelocKind.Abs32)
  // The GOT and TLVP pairs map straight through.
  assert(mrKindOf(5, 2, ldr64) == LoRelocKind.Aarch64AdrGotPage)
  assert(mrKindOf(6, 2, ldr64) == LoRelocKind.Aarch64Ld64GotLo12Nc)
  assert(mrKindOf(8, 2, ldr64) == LoRelocKind.Aarch64TlvpAdrPage21)
  assert(mrKindOf(9, 2, ldr64) == LoRelocKind.Aarch64TlvpLd64Lo12)
  assert(mrKindOf(2, 2, ldr64) == LoRelocKind.Aarch64Call26)
  assert(mrKindOf(3, 2, ldr64) == LoRelocKind.Aarch64AdrPrelPgHi21)
}

function mrPageoffKind(insn: []u8): LoRelocKind {
  return mrKindOf(4, 2, insn)
}

function mrKindOf(rtype: int, length: int, insn: []u8): LoRelocKind {
  return mrRelocKind(rtype, length, insn, 0) catch e {
    assert(false)
    LoRelocKind.Abs64
  }
}

function checkMachoReaderRejects() {
  // A buffer long enough to hold a header, but not a Mach-O.
  let notMacho = []byte("this is definitely not a mach-o object file, padded long")
  assert(mrErr(notMacho) == "NotMachO")
  // Too short to even hold the header.
  assert(mrErr([]byte("tiny")) == "Truncated")

  // The right magic but the wrong architecture / filetype.
  let b = newByteBuf()
  appendU32(b, 0xfeedfacf)
  appendU32(b, 0x01000007) // CPU_TYPE_X86_64 — this reader is arm64-only
  appendZeros(b, 24)
  assert(mrErr(b.bytes) == "UnsupportedMachO")

  let b2 = newByteBuf()
  appendU32(b2, 0xfeedfacf)
  appendU32(b2, 0x0100000C)
  appendU32(b2, 0)
  appendU32(b2, 0x2) // MH_EXECUTE, not MH_OBJECT
  appendZeros(b2, 16)
  assert(mrErr(b2.bytes) == "UnsupportedMachO")

  // arm64 MH_OBJECT with no LC_SYMTAB at all.
  let b3 = newByteBuf()
  appendU32(b3, 0xfeedfacf)
  appendU32(b3, 0x0100000C)
  appendU32(b3, 0)
  appendU32(b3, 0x1)
  appendU32(b3, 0) // ncmds == 0
  appendZeros(b3, 12)
  assert(mrErr(b3.bytes) == "Malformed")
}
