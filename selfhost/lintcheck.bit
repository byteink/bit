// In-Bit self-checks for `bit lint` (#1379/#1380). Run by `selfcheck()` under
// `zig build test` and the x86_64 gate; a failed `assert` panics with exit 2.
//
// These cover the directive reader and the rule/render layer, which is
// everything that does not need a process. The CLI contract on top — path walk,
// exit codes, the summary line, `--json`, `--stats` — is execed and asserted by
// `tests/lintcmd.zig`, because an exit code cannot be observed from inside the
// process that would produce it.

// Reads directives from `src` into a throwaway sink; returns the config. `errs`
// is the caller's sink so a test can assert on what was reported.
function lintTestRead(src: string, errs: Diagnostics): LintConfig {
  let f = addFile(errs.sm, "t.bit", src)
  return readLintDirectives(src, f, errs)
}

function lintTestSink(): Diagnostics {
  return newDiagnostics(newSourceManager())
}

// The effective limit for `max-file-lines` under `cfg`.
function lintTestFileLimit(cfg: LintConfig): int {
  return cfg.limits[lintRuleIndex(lintRules(), "max-file-lines")]
}

function lintTestFileDisabled(cfg: LintConfig): bool {
  return cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")]
}

function checkLintDirectivesAccepted() {
  // No directive: the built-in default, and nothing overridden.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// just a comment\nfunction f() {}\n", d0)
  assert(!hasErrors(d0))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)
  assert(len(lintOverrideNotes(c0)) == 0)

  // A directive that restates the default is still an override in force: it
  // changes no behaviour but it is a claim about this file, so it must show up
  // in the count and the listing rather than vanishing.
  let dd = lintTestSink()
  let cd = lintTestRead("// bit:lint max-file-lines=800 -- deliberate, not drift\n", dd)
  assert(!hasErrors(dd))
  assert(lintOverrideCount(cd) == 1)
  assert(lintOverrideNotes(cd)[0] == "max-file-lines=800")

  // An assignment.
  let d1 = lintTestSink()
  let c1 = lintTestRead("// bit:lint max-file-lines=1204 -- known debt\nfunction f() {}\n", d1)
  assert(!hasErrors(d1))
  assert(lintTestFileLimit(c1) == 1204)
  assert(lintOverrideCount(c1) == 1)
  assert(lintOverrideNotes(c1)[0] == "max-file-lines=1204")

  // A disable.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// bit:lint disable max-file-lines -- generated\n", d2)
  assert(!hasErrors(d2))
  assert(lintTestFileDisabled(c2))
  assert(lintOverrideCount(c2) == 1)
  assert(lintOverrideNotes(c2)[0] == "disable max-file-lines")

  // Multiple directives: the LAST assignment for a rule wins, and both count as
  // one override, because the summary line reports settings in effect.
  let d3 = lintTestSink()
  let c3 = lintTestRead("// bit:lint max-file-lines=100 -- first\n" +
    "// bit:lint max-file-lines=900 -- second\n", d3)
  assert(!hasErrors(d3))
  assert(lintTestFileLimit(c3) == 900)
  assert(lintOverrideCount(c3) == 1)

  // Not pinned to line 1 — a golden case spends line 1 on the harness mode
  // directive, and the lint directive still has to be read.
  let d4 = lintTestSink()
  let c4 = lintTestRead("// lint\n// bit:lint max-file-lines=42 -- after the mode line\n", d4)
  assert(!hasErrors(d4))
  assert(lintTestFileLimit(c4) == 42)

  // Indented, and with no space between `//` and the directive.
  let d5 = lintTestSink()
  let c5 = lintTestRead("  //bit:lint max-file-lines=7 -- tight\n", d5)
  assert(!hasErrors(d5))
  assert(lintTestFileLimit(c5) == 7)

  // A reason may itself contain `--`; only the FIRST `--` after the assignment
  // terminates it.
  let d6 = lintTestSink()
  let c6 = lintTestRead("// bit:lint max-file-lines=9 -- see -- issue #1376\n", d6)
  assert(!hasErrors(d6))
  assert(lintTestFileLimit(c6) == 9)

  // `bit:` is a namespace claim for the whole toolchain. Another tool's
  // directive is skipped, not rejected.
  let d7 = lintTestSink()
  let c7 = lintTestRead("// bit:fmt something entirely else\n" +
    "// bit:lint max-file-lines=11 -- ours\n", d7)
  assert(!hasErrors(d7))
  assert(lintTestFileLimit(c7) == 11)
}

function checkLintDirectivePlacement() {
  // A blank line ends the leading comment block, so what follows is invisible.
  let d0 = lintTestSink()
  let c0 = lintTestRead("// header\n\n// bit:lint max-file-lines=42 -- too late\n", d0)
  assert(!hasErrors(d0))
  assert(lintTestFileLimit(c0) == 800)
  assert(lintOverrideCount(c0) == 0)

  // A declaration ends it too. Critically this must NOT report an error: the
  // directive is not recognised at all there, so it is neither honoured nor
  // diagnosed — it is an ordinary comment.
  let d1 = lintTestSink()
  let c1 = lintTestRead("function f() {}\n// bit:lint max-file-lines=42 -- too late\n", d1)
  assert(!hasErrors(d1))
  assert(lintTestFileLimit(c1) == 800)

  // A whitespace-only line counts as blank and ends the block.
  let d2 = lintTestSink()
  let c2 = lintTestRead("// header\n   \n// bit:lint max-file-lines=42 -- too late\n", d2)
  assert(!hasErrors(d2))
  assert(lintTestFileLimit(c2) == 800)
}

// The four error classes of §5.2. Every one is a hard error, never a silent
// no-op: a directive that quietly does nothing is how a lint rule dies.
function checkLintDirectiveErrors() {
  // 1. Malformed — no `=` and not the `disable` form.
  let d0 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines 900 -- nope\n", d0)
  assert(hasErrors(d0))
  assert(d0.list[0].code == ecLintBadDirective)

  // 1b. Malformed — nothing at all after the tool name.
  let d1 = lintTestSink()
  lintTestRead("// bit:lint\n", d1)
  assert(hasErrors(d1))
  assert(d1.list[0].code == ecLintBadDirective)

  // 1c. Malformed — `=` with no integer.
  let d2 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines= -- nope\n", d2)
  assert(hasErrors(d2))
  assert(d2.list[0].code == ecLintBadDirective)

  // 1d. Malformed — `disable` with no rule name.
  let d3 = lintTestSink()
  lintTestRead("// bit:lint disable -- nope\n", d3)
  assert(hasErrors(d3))
  assert(d3.list[0].code == ecLintBadDirective)

  // 2. Missing reason — no `--` at all.
  let d4 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=900\n", d4)
  assert(hasErrors(d4))
  assert(d4.list[0].code == ecLintBadDirective)

  // 3. Empty reason — whitespace only after `--`.
  let d5 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=900 --   \n", d5)
  assert(hasErrors(d5))
  assert(d5.list[0].code == ecLintBadDirective)

  // 4. Unknown rule name. Its own code, because this is the error that keeps a
  // renamed rule from turning every existing override into a no-op.
  let d6 = lintTestSink()
  lintTestRead("// bit:lint max-fyle-lines=900 -- typo\n", d6)
  assert(hasErrors(d6))
  assert(d6.list[0].code == ecLintUnknownRule)

  // 4b. Unknown rule in the `disable` form takes the same code.
  let d7 = lintTestSink()
  lintTestRead("// bit:lint disable no-such-rule -- typo\n", d7)
  assert(hasErrors(d7))
  assert(d7.list[0].code == ecLintUnknownRule)

  // A limit past the range guard is rejected rather than wrapped into a small
  // number that would silently TIGHTEN the rule.
  let d8 = lintTestSink()
  lintTestRead("// bit:lint max-file-lines=99999999999999999999 -- huge\n", d8)
  assert(hasErrors(d8))
  assert(d8.list[0].code == ecLintBadDirective)

  // Every directive error is error severity, so `hasErrors` marks the file and
  // the command exits 2.
  assert(d0.list[0].severity == 0)
}

function checkLintLineCount() {
  assert(lintCountLines("") == 0)
  assert(lintCountLines("a") == 1)
  assert(lintCountLines("a\n") == 1)
  assert(lintCountLines("a\nb") == 2)
  assert(lintCountLines("a\nb\n") == 2)
  // Blank lines count: the cost being bounded is the reader's (§4).
  assert(lintCountLines("\n\n\n") == 3)
}

// E0200 at the boundary: `limit` lines pass, `limit + 1` fails.
function checkLintMaxFileLines() {
  let three = "a\nb\nc\n"

  let d0 = lintTestSink()
  let f0 = addFile(d0.sm, "ok.bit", three)
  lintMaxFileLines(three, f0, 3, d0)
  assert(len(d0.list) == 0)

  let d1 = lintTestSink()
  let f1 = addFile(d1.sm, "big.bit", three)
  lintMaxFileLines(three, f1, 2, d1)
  assert(len(d1.list) == 1)
  assert(d1.list[0].code == ecLintMaxFileLines)
  // A finding is a WARNING and must not bump errorCount, or a lint hit could
  // fail an unrelated build (diagnostics.bit:93).
  assert(d1.list[0].severity == 1)
  assert(!hasErrors(d1))
  assert(d1.list[0].message == "file is 3 lines, limit is 2")
  // The hint carries the `-- <reason>` placeholder: without it the form it
  // teaches would itself exit 2 on first use.
  assert(d1.list[0].hint ==
    "split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`")

  // A disable really suppresses it, through the runner rather than the rule.
  let d2 = lintTestSink()
  let f2 = addFile(d2.sm, "off.bit", three)
  let cfg = newLintConfig()
  cfg.disabled[lintRuleIndex(lintRules(), "max-file-lines")] = true
  runLintRules(three, f2, cfg, d2)
  assert(len(d2.list) == 0)

  // And an override raising the limit suppresses it too, end to end from the
  // directive text.
  let src = "// bit:lint max-file-lines=5 -- fixture\n// b\n// c\n"
  let d3 = lintTestSink()
  let f3 = addFile(d3.sm, "raised.bit", src)
  let c3 = readLintDirectives(src, f3, d3)
  assert(!hasErrors(d3))
  runLintRules(src, f3, c3, d3)
  assert(len(d3.list) == 0)
}

function checkLintRender() {
  let src = "a\nb\nc\n"
  let d = lintTestSink()
  let f = addFile(d.sm, "big.bit", src)
  lintMaxFileLines(src, f, 2, d)

  // Human output goes through the shared renderer — same gutter, caret and
  // hint machinery as `bit check`.
  assert(renderDiags(d) ==
    "warning[E0200]: file is 3 lines, limit is 2\n" +
    " --> big.bit:1:1\n" +
    "  |\n" +
    "1 | a\n" +
    "  | ^ split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`\n")

  // JSON is the LSP shape `bit check --json` already emits: same keys, same
  // 0-based line/character range.
  assert(lintRenderJson(d) ==
    "[{\"code\":\"E0200\",\"severity\":\"warning\",\"file\":\"big.bit\"," +
    "\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":0}}," +
    "\"message\":\"file is 3 lines, limit is 2\"," +
    "\"hint\":\"split it, or raise the limit with `// bit:lint max-file-lines=3 -- <reason>`\"}]")

  // Quotes and control bytes are escaped, so a path or message containing one
  // cannot produce unparseable JSON.
  assert(lintJsonString("a\"b") == "\"a\\\"b\"")
  assert(lintJsonString("a\\b") == "\"a\\\\b\"")
  assert(lintJsonString("a\nb") == "\"a\\u000ab\"")
}

// Findings are ordered by file path, then line, then code — golden tests pin
// this order, so a stable one is a correctness property, not a nicety.
function checkLintOrdering() {
  let d = lintTestSink()
  let fb = addFile(d.sm, "b.bit", "x\n")
  let fa = addFile(d.sm, "a.bit", "x\ny\n")
  warn(d, 201, Span{ file: fb, start: 0, end: 0 }, "second file", "")
  warn(d, 201, Span{ file: fa, start: 2, end: 2 }, "line 2", "")
  warn(d, 200, Span{ file: fa, start: 0, end: 0 }, "line 1", "")
  lintSortDiags(d)
  assert(d.list[0].message == "line 1")
  assert(d.list[1].message == "line 2")
  assert(d.list[2].message == "second file")
}

function checkLintArgs() {
  // No paths defaults to ".".
  let a0 = parseLintArgs(["bit", "lint"])
  assert(a0.ok)
  assert(len(a0.paths) == 1)
  assert(a0.paths[0] == ".")
  assert(!a0.json)
  assert(!a0.stats)

  let a1 = parseLintArgs(["bit", "lint", "--json", "--stats", "selfhost", "stdlib"])
  assert(a1.ok)
  assert(a1.json)
  assert(a1.stats)
  assert(len(a1.paths) == 2)
  assert(a1.paths[1] == "stdlib")

  // An unknown flag is a usage error, not a path.
  let a2 = parseLintArgs(["bit", "lint", "--quiet"])
  assert(!a2.ok)
  assert(a2.badFlag == "--quiet")
}

function checkLint() {
  checkLintDirectivesAccepted()
  checkLintDirectivePlacement()
  checkLintDirectiveErrors()
  checkLintLineCount()
  checkLintMaxFileLines()
  checkLintRender()
  checkLintOrdering()
  checkLintArgs()
}
