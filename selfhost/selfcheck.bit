// In-Bit self-checks for the ported compiler modules. Runs under the seed-built
// `bitc2` (invoked by `zig build test` and the x86_64 gate); a failed `assert`
// panics with exit 2, so a regression in a ported module fails the build. As the
// port matures these are replaced by the differential harness (#1332) diffing
// bitc2 against the seed, but they guard each module as it lands.

function checkDiagnostics() {
  let sm = newSourceManager()
  let f = addFile(sm, "t.bit", "ab\ncde\nf")
  // Offsets: a=0 b=1 \n=2 c=3 d=4 e=5 \n=6 f=7, len=8.

  let l0 = locate(sm, f, 0)
  assert(l0.line == 0)
  assert(l0.column == 0)
  assert(l0.lineText == "ab")

  // Middle of the second line.
  let l4 = locate(sm, f, 4)
  assert(l4.line == 1)
  assert(l4.column == 1)
  assert(l4.lineText == "cde")

  // EOF just past the last byte, on the final (newline-free) line.
  let l8 = locate(sm, f, 8)
  assert(l8.line == 2)
  assert(l8.column == 1)
  assert(l8.lineText == "f")

  assert(filePath(sm, f) == "t.bit")

  // A second file gets the next id; the manager holds both.
  let g = addFile(sm, "u.bit", "x")
  assert(g == 1)
  assert(filePath(sm, g) == "u.bit")
}

function checkDiagRender() {
  // The renderer must be byte-identical to the seed's renderOne. Reproduce the
  // exact E0001 output for `lex_unexpected_char` (a stray `@` on line 2, col 9),
  // verified against `bitc --dump-ast tests/cases/lex_unexpected_char.bit`.
  let sm = newSourceManager()
  let f = addFile(sm, "lex_unexpected_char.bit", "// error\nlet x = @\n")
  // `@` is at offset 17 (line 2, 0-based col 8).
  let d = newDiagnostics(sm)
  report(d, 1, Span{ file: f, start: 17, end: 18 }, "unexpected character '@'", "remove this character")
  assert(renderDiags(d) ==
    "error[E0001]: unexpected character '@'\n" +
    " --> lex_unexpected_char.bit:2:9\n" +
    "  |\n" +
    "2 | let x = @\n" +
    "  |         ^ remove this character\n")

  // A no-hint, multi-caret diagnostic (E0021 shape): the caret run spans the
  // token width and no trailing hint is printed.
  let d2 = newDiagnostics(sm)
  reportNoHint(d2, 21, Span{ file: f, start: 9, end: 12 }, "expected 'case' or 'default', found kw_let")
  assert(renderDiags(d2) ==
    "error[E0021]: expected 'case' or 'default', found kw_let\n" +
    " --> lex_unexpected_char.bit:2:1\n" +
    "  |\n" +
    "2 | let x = @\n" +
    "  | ^^^\n")
}

function checkAst() {
  let t = newTree()
  // Build `a + 1`: two leaves, then a binary node over them.
  let a = addLeaf(t, Tag.Ident, pointSpan(0, 0))
  let one = addLeaf(t, Tag.IntLit, pointSpan(0, 4))
  assert(a == 1)          // index 0 is the reserved `none`
  assert(one == 2)
  let plus = addNode(t, Tag.Binary, pointSpan(0, 6), 42, [a, one])
  assert(plus == 3)

  let n = getNode(t, plus)
  assert(n.tag == Tag.Binary)
  assert(n.main == 42)     // the operator scalar round-trips

  let kids = kidsOf(t, plus)
  assert(len(kids) == 2)
  assert(kids[0] == a)
  assert(kids[1] == one)
  assert(getNode(t, kids[0]).tag == Tag.Ident)
  assert(getNode(t, kids[1]).tag == Tag.IntLit)

  // A leaf has no children; the reserved node reads as `none`.
  assert(len(kidsOf(t, a)) == 0)
  assert(getNode(t, 0).tag == Tag.None)
}

function assertTok(t: Token, k: Kind, s: int, e: int) {
  assert(t.kind == k)
  assert(t.start == s)
  assert(t.end == e)
}

function checkLexer() {
  // Keywords, ident, integer, and two ASI semicolons (after `42` and `3`, each
  // an int_lit terminator followed by a newline). Verified against the seed's
  // `--dump-tokens`.
  let toks = lexAll("let x = 42\nreturn x >= 3\n")
  assert(len(toks) == 11)
  assertTok(toks[0], Kind.KwLet, 0, 3)
  assertTok(toks[1], Kind.Ident, 4, 5)
  assertTok(toks[2], Kind.Eq, 6, 7)
  assertTok(toks[3], Kind.IntLit, 8, 10)
  assertTok(toks[4], Kind.Semicolon, 10, 10)
  assertTok(toks[5], Kind.KwReturn, 11, 17)
  assertTok(toks[6], Kind.Ident, 18, 19)
  assertTok(toks[7], Kind.GtEq, 20, 22)
  assertTok(toks[8], Kind.IntLit, 23, 24)
  assertTok(toks[9], Kind.Semicolon, 24, 24)
  assertTok(toks[10], Kind.Eof, 25, 25)

  // Maximal munch across the operator set; `>=` at EOF must NOT synthesize a
  // semicolon (it is not a terminator), unlike `++` which would.
  let ops = lexAll("<<= >> == != <- ... ++ >=")
  assert(len(ops) == 9)
  assertTok(ops[0], Kind.ShlEq, 0, 3)
  assertTok(ops[1], Kind.Shr, 4, 6)
  assertTok(ops[2], Kind.EqEq, 7, 9)
  assertTok(ops[3], Kind.BangEq, 10, 12)
  assertTok(ops[4], Kind.ArrowLeft, 13, 15)
  assertTok(ops[5], Kind.Ellipsis, 16, 19)
  assertTok(ops[6], Kind.PlusPlus, 20, 22)
  assertTok(ops[7], Kind.GtEq, 23, 25)
  assertTok(ops[8], Kind.Eof, 25, 25)
}

function checkNumbers() {
  // Bases, decimal/hex floats, `_` separators, leading-dot float — verified
  // against the seed's `--dump-tokens`. The trailing `2.5e-3` is a float_lit
  // terminator at EOF, so an ASI semicolon follows.
  let toks = lexAll("0xFF 0b1010 0o17 3.14 1e10 1_000 .5 2.5e-3")
  assert(len(toks) == 10)
  assertTok(toks[0], Kind.IntLit, 0, 4)
  assertTok(toks[1], Kind.IntLit, 5, 11)
  assertTok(toks[2], Kind.IntLit, 12, 16)
  assertTok(toks[3], Kind.FloatLit, 17, 21)
  assertTok(toks[4], Kind.FloatLit, 22, 26)
  assertTok(toks[5], Kind.IntLit, 27, 32)
  assertTok(toks[6], Kind.FloatLit, 33, 35)
  assertTok(toks[7], Kind.FloatLit, 36, 42)
  assertTok(toks[8], Kind.Semicolon, 42, 42)
  assertTok(toks[9], Kind.Eof, 42, 42)

  // Bad literals lex as a single Invalid token (matching the seed's .invalid):
  // empty base, C-octal, and a misused `_` separator.
  assert(lexAll("0x")[0].kind == Kind.Invalid)
  assert(lexAll("0123")[0].kind == Kind.Invalid)
  assert(lexAll("1__0")[0].kind == Kind.Invalid)
}

function checkStrings() {
  // A simple string spans both quotes and consumes escapes (`\t`, `\x41`), so
  // the closing quote is found after them. Trailing ASI semicolon (string_lit is
  // a terminator at EOF). Verified against the seed's `--dump-tokens`.
  let s = lexAll("\"a\\tb\\x41\"")
  assert(len(s) == 3)
  assertTok(s[0], Kind.StringLit, 0, 10)
  assertTok(s[1], Kind.Semicolon, 10, 10)
  assertTok(s[2], Kind.Eof, 10, 10)

  // A `\"` escape must not close the string.
  assertTok(lexAll("\"a\\\"b\"")[0], Kind.StringLit, 0, 6)

  // Raw string: no escape processing, backtick-delimited.
  assertTok(lexAll("`raw\\n`")[0], Kind.RawStringLit, 0, 7)

  // Runes: ASCII, an escape, and a 2-byte UTF-8 code point (π).
  assert(lexAll("'a'")[0].kind == Kind.RuneLit)
  assertTok(lexAll("'\\n'")[0], Kind.RuneLit, 0, 4)
  assertTok(lexAll("'π'")[0], Kind.RuneLit, 0, 4)

  // A multi-character rune is invalid.
  assert(lexAll("'ab'")[0].kind == Kind.Invalid)
}

function checkInterp() {
  // `"a${x}b"` — the flat interpolation sequence (§5.7), verified against the
  // seed. The literal `${` is written `\${` here so it is not interpolated in
  // this source; likewise the inner quotes below are escaped.
  let t = lexAll("\"a\${x}b\"")
  assert(len(t) == 7)
  assertTok(t[0], Kind.StrPart, 1, 2)
  assertTok(t[1], Kind.InterpStart, 2, 4)
  assertTok(t[2], Kind.Ident, 4, 5)
  assertTok(t[3], Kind.InterpEnd, 5, 6)
  assertTok(t[4], Kind.StrPart, 6, 7)
  assertTok(t[5], Kind.Semicolon, 8, 8)
  assertTok(t[6], Kind.Eof, 8, 8)

  // `"${f("x${y}")}"` — nesting: a call inside the interpolation whose argument
  // is itself an interpolated string. Exercises the brace-depth stack (the
  // `(`/`)` do not affect it) and a resumed inner string. Verified vs the seed.
  let n = lexAll("\"\${f(\"x\${y}\")}\"")
  assert(len(n) == 14)
  assertTok(n[0], Kind.StrPart, 1, 1)
  assertTok(n[1], Kind.InterpStart, 1, 3)
  assertTok(n[2], Kind.Ident, 3, 4)
  assertTok(n[3], Kind.LParen, 4, 5)
  assertTok(n[4], Kind.StrPart, 6, 7)
  assertTok(n[5], Kind.InterpStart, 7, 9)
  assertTok(n[6], Kind.Ident, 9, 10)
  assertTok(n[7], Kind.InterpEnd, 10, 11)
  assertTok(n[8], Kind.StrPart, 11, 11)
  assertTok(n[9], Kind.RParen, 12, 13)
  assertTok(n[10], Kind.InterpEnd, 13, 14)
  assertTok(n[11], Kind.StrPart, 14, 14)
  assertTok(n[12], Kind.Semicolon, 15, 15)
  assertTok(n[13], Kind.Eof, 15, 15)
}

function checkParser() {
  // A const, then a function whose body returns a precedence-sensitive binary
  // expression. dumpAst reads leaf text from the same source it parsed. The
  // expected s-expression matches the seed's ast.dump exactly (verified against
  // `bitc --dump-ast`).
  let src = "const K = 7\nfunction f(a: i64, b: i64): i64 { return a + b * 2 }"
  let tree = parseSource(src)
  assert(dumpAst(tree, src) ==
    "(program (const_decl (binding K _ 7)) (func_decl _ f _ (params (param a i64) (param b i64)) i64 (block (return_stmt (binary + a (binary * b 2))))))")

  // Postfix: a call whose argument is another call, and a member chain.
  let src2 = "function g() { let x = foo(1, bar(2)).baz }"
  let tree2 = parseSource(src2)
  assert(dumpAst(tree2, src2) ==
    "(program (func_decl _ g _ (params) _ (block (let_decl (binding x _ (member (call foo _ (args (arg 1) (arg (call bar _ (args (arg 2)))))) baz))))))")
}

function checkTypeNames() {
  // typeName must match the seed's appendTypeName byte-for-byte over the type
  // constructors, including the well-known ids and nested composites.
  let ctx = newTypeContext()
  assert(typeName(ctx, ctx.voidId) == "()")
  assert(typeName(ctx, ctx.untypedIntId) == "untyped int")
  assert(typeName(ctx, ctx.untypedNilId) == "nil")
  assert(typeName(ctx, primType(ctx, 3)) == "i64")
  assert(typeName(ctx, primType(ctx, 11)) == "string")
  assert(typeName(ctx, ctx.errorId) == "error")

  let i64t = primType(ctx, 3)
  let u8t = primType(ctx, 4)
  let strt = primType(ctx, 11)
  assert(typeName(ctx, mkSlice(ctx, u8t)) == "[]u8")
  assert(typeName(ctx, mkChan(ctx, i64t)) == "chan<i64>")
  assert(typeName(ctx, mkArray(ctx, 16, u8t)) == "[16]u8")
  assert(typeName(ctx, mkMap(ctx, strt, i64t)) == "map<string, i64>")
  assert(typeName(ctx, mkTuple(ctx, [i64t, strt])) == "(i64, string)")
  assert(typeName(ctx, mkFunc(ctx, [i64t, i64t], false, i64t)) == "(i64, i64) => i64")
  // Fallible with the default `error` type omits the error name; a custom one shows it.
  assert(typeName(ctx, mkFallible(ctx, i64t, ctx.errorId)) == "i64!")
  assert(typeName(ctx, mkFallible(ctx, i64t, strt)) == "i64!string")
  // Nested: []map<string, i64>
  assert(typeName(ctx, mkSlice(ctx, mkMap(ctx, strt, i64t))) == "[]map<string, i64>")
}

function checkResolveSubstrate() {
  // The universe binds every predeclared type and function; a symbol carries its
  // kind, and an absent name resolves to -1. Foundation for the resolver port.
  let u = universeModule()
  let stringId = lookupName(u, "string")
  assert(stringId >= 0)
  assert(u.symbols[stringId].kind == SymbolKind.BuiltinType)
  let lenId = lookupName(u, "len")
  assert(lenId >= 0)
  assert(u.symbols[lenId].kind == SymbolKind.BuiltinFunc)
  assert(lookupName(u, "nope") == -1)

  // A module-local binding appends and resolves independently of the universe.
  let m = newModule()
  let sid = addSymbol(m, Symbol{ name: "K", kind: SymbolKind.ConstBinding, decl: 3,
    fileIdx: 0, exported: true, importedFromModule: -1, importedFromSymbol: -1, namespaceModule: -1 })
  bindName(m, "K", sid)
  assert(lookupName(m, "K") == sid)
  assert(m.symbols[lookupName(m, "K")].exported)
}

// Runs every module's self-checks. Called by main; panics on the first failure.
function checkInferTypes() {
  // Literal-const bindings dump their defaulted concrete types, matching the
  // seed's `--dump-types` byte-for-byte (verified against `bitc --dump-types`).
  let dump = checkSourceDump("const K = 7\nconst S = \"hi\"\nconst B = true\nlet g = 3.5\n")
  assert(dump == "1:7: K: i64\n2:7: S: string\n3:7: B: bool\n4:5: g: f64\n")

  // An explicit annotation wins over the initializer's default.
  let dump2 = checkSourceDump("const N: u8 = 5\nlet y: string = \"x\"\nlet r: rune = 'a'\n")
  assert(dump2 == "1:7: N: u8\n2:5: y: string\n3:5: r: i32\n")
}

// The IR text dumper must match compiler/ir.zig `dump` byte-for-byte; pin it on
// a hand-built module (lowering, which produces these, lands next).
function checkIrDump() {
  let ctx = newTypeContext()
  // Trivial: an empty function is one block with a bare `ret`.
  let f0 = IrFunc{ name: "main", paramTypes: []int(0), result: ctx.voidId,
    blocks: [IrBlock{ instsStart: 0, paramCount: 0, instsLen: 1 }],
    instrs: [mkInstr(Op.Ret, ctx.voidId)], isFallible: false }
  assert(dumpIr(IrModule{ funcs: [f0], ctx: ctx }) == "func main() void {\nbb0():\n  ret\n}\n")

  // A block param, a constant, a binary op, and a value-returning ret exercise
  // the header, `%N` numbering, opName, and the value list.
  let i64t = primType(ctx, 3)
  let bp = mkInstr(Op.BlockParam, i64t)
  let ci = mkInstr(Op.ConstInt, i64t)
  ci.ival = 1
  let add = mkInstr(Op.Add, i64t)
  add.lhs = 0
  add.rhs = 1
  let rv = mkInstr(Op.Ret, ctx.voidId)
  rv.args = [2]
  let f1 = IrFunc{ name: "addOne", paramTypes: [i64t], result: i64t,
    blocks: [IrBlock{ instsStart: 0, paramCount: 1, instsLen: 4 }],
    instrs: [bp, ci, add, rv], isFallible: false }
  let want = "func addOne(%0: i64) i64 {\nbb0(%0: i64):\n  %1 = const_int i64 1\n  %2 = add i64 %0, %1\n  ret %2\n}\n"
  assert(dumpIr(IrModule{ funcs: [f1], ctx: ctx }) == want)

  // End-to-end through the real parse -> check -> lower pipeline: an empty
  // function is the fall-off `ret`; a signature carries its params + result.
  assert(lowerSourceDump("function main() {}\n") == "func main() void {\nbb0():\n  ret\n}\n")
  assert(lowerSourceDump("function sink(x: i64) {}\n") ==
    "func sink(%0: i64) void {\nbb0(%0: i64):\n  ret\n}\n")

  // A returned binary of two params: operand idents resolve to block-param value
  // ids, the op emits, and `ret` carries the result (matches the seed).
  assert(lowerSourceDump("function add(a: i64, b: i64): i64 { return a + b }\n") ==
    "func add(%0: i64, %1: i64) i64 {\nbb0(%0: i64, %1: i64):\n  %2 = add i64 %0, %1\n  ret %2\n}\n")

  // A let-bound direct call feeds a print: `call @f`, the local is its result
  // value id, and the string literal + `rt_call print` follow.
  let srcG = "function f(a: i64): i64 { return a }\nfunction g() {\n  let x = f(5)\n  print(\"hi\")\n}\n"
  let wantG = "func f(%0: i64) i64 {\nbb0(%0: i64):\n  ret %0\n}\n\n" +
    "func g() void {\nbb0():\n  %0 = const_int i64 5\n  %1 = call @f(%0) i64\n  %2 = const_string \"hi\"\n  %3 = rt_call print(%2) void\n  ret\n}\n"
  assert(lowerSourceDump(srcG) == wantG)

  // A guard `if (x == 0) { print }`: the compare + br split the entry, the then
  // block prints and jumps to the join, and the join takes the live local `x`
  // as a block param — the seed's block-threaded SSA (matches bitc --dump-ir-pre).
  let srcIf = "function f(x: i64) {\n  if (x == 0) {\n    print(\"z\")\n  }\n}\n"
  let wantIf = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_int i64 0\n" +
    "  %2 = icmp_eq bool %0, %1\n  br %2, bb1(), bb2(%0)\nbb1():\n  %4 = const_string \"z\"\n" +
    "  %5 = rt_call print(%4) void\n  jump bb2(%0)\nbb2(%7: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcIf) == wantIf)

  // String interpolation `"v=${n}!"`: literal segments -> const_string, the int
  // operand -> string_from_int, folded left with string_concat (seed parity).
  let srcIp = "function f(n: i64) {\n  print(\"v=\${n}!\")\n}\n"
  let wantIp = "func f(%0: i64) void {\nbb0(%0: i64):\n  %1 = const_string \"v=\"\n" +
    "  %2 = rt_call string_from_int(%0) string\n  %3 = const_string \"!\"\n" +
    "  %4 = rt_call string_concat(%1, %2) string\n  %5 = rt_call string_concat(%4, %3) string\n" +
    "  %6 = rt_call print(%5) void\n  ret\n}\n"
  assert(lowerSourceDump(srcIp) == wantIp)

  // A while loop: the entry jumps to a header carrying `i`, the header tests and
  // branches, the body increments and back-jumps, and the exit re-binds `i` —
  // the seed's loop-carried block-param SSA.
  let srcW = "function main() {\n  let i = 0\n  while (i < 3) {\n    i = i + 1\n  }\n}\n"
  let wantW = "func main() void {\nbb0():\n  %0 = const_int i64 0\n  jump bb1(%0)\n" +
    "bb1(%2: i64):\n  %3 = const_int i64 3\n  %4 = icmp_slt bool %2, %3\n" +
    "  br %4, bb2(), bb3(%2)\nbb2():\n  %6 = const_int i64 1\n  %7 = add i64 %2, %6\n" +
    "  jump bb1(%7)\nbb3(%9: i64):\n  ret\n}\n"
  assert(lowerSourceDump(srcW) == wantW)

  // A struct composite: gc_alloc (16 bytes, no ref fields) then a field_set per
  // field at its computed byte offset (0, 8) — the seed's struct layout.
  let srcS = "struct Point { x: i64, y: i64 }\nfunction mk(a: i64, b: i64): Point { return Point{x: a, y: b} }\n"
  let wantS = "func mk(%0: i64, %1: i64) Point {\nbb0(%0: i64, %1: i64):\n" +
    "  %2 = gc_alloc size=16 ptrs=[] Point\n  field_set %2[0] = %0\n  field_set %2[8] = %1\n  ret %2\n}\n"
  assert(lowerSourceDump(srcS) == wantS)

  // A for-of over a slice: hidden $iter/$idx locals thread the header/body/step/
  // exit blocks, the element reads via slice_get, the cursor advances in the
  // step — the seed's counted-loop SSA.
  let srcF = "function sum(xs: []i64): i64 {\n  let s = 0\n  for x of xs {\n    s = s + x\n  }\n  return s\n}\n"
  let wantF = "func sum(%0: []i64) i64 {\nbb0(%0: []i64):\n  %1 = const_int i64 0\n" +
    "  %2 = const_int i64 0\n  jump bb1(%0, %1, %0, %2)\n" +
    "bb1(%4: []i64, %5: i64, %6: []i64, %7: i64):\n  %8 = slice_len %6\n" +
    "  %9 = icmp_slt bool %7, %8\n  br %9, bb2(), bb4(%4, %5, %6, %7)\n" +
    "bb2():\n  %11 = rt_call slice_get(%6, %7) i64\n  %12 = add i64 %5, %11\n" +
    "  jump bb3(%4, %12, %6, %7)\n" +
    "bb3(%14: []i64, %15: i64, %16: []i64, %17: i64):\n  %18 = const_int i64 1\n" +
    "  %19 = add i64 %17, %18\n  jump bb1(%14, %15, %16, %19)\n" +
    "bb4(%21: []i64, %22: i64, %23: []i64, %24: i64):\n  ret %22\n}\n"
  assert(lowerSourceDump(srcF) == wantF)
}

// Stage 3 (#1340) codegen core: scalar classification, GC-reference
// classification, and the stack-map blob's byte layout (runtime/ABI.md §4).
function checkCodegenCore() {
  let ctx = newTypeContext()
  // Every prim classifies at its natural width; everything else is a boxed
  // 8-byte handle.
  let i8w = widthOf(ctx, primType(ctx, 0))
  assert(i8w.bytes == 1 && i8w.class == RegClass.Int && i8w.signed)
  let u8w = widthOf(ctx, primType(ctx, 4))
  assert(u8w.bytes == 1 && !u8w.signed)
  let i64w = widthOf(ctx, primType(ctx, 3))
  assert(i64w.bytes == 8 && i64w.class == RegClass.Int && i64w.signed)
  let f64w = widthOf(ctx, primType(ctx, 9))
  assert(f64w.bytes == 8 && f64w.class == RegClass.Float && !f64w.signed)
  let f32w = widthOf(ctx, primType(ctx, 8))
  assert(f32w.bytes == 4 && f32w.class == RegClass.Float)
  let boolw = widthOf(ctx, primType(ctx, 10))
  assert(boolw.bytes == 1 && boolw.class == RegClass.Int)
  let strw = widthOf(ctx, primType(ctx, 11))
  assert(strw.bytes == 8 && strw.class == RegClass.Int && !strw.signed)
  assert(regClassOf(ctx, primType(ctx, 9)) == RegClass.Float)
  // A slice is a boxed handle, not a scalar.
  let sl = mkSlice(ctx, primType(ctx, 3))
  assert(widthOf(ctx, sl).bytes == 8)

  // GC references: strings and every boxed shape; never a scalar or a void.
  assert(isRefType(ctx, primType(ctx, 11)))
  assert(!isRefType(ctx, primType(ctx, 3)))
  assert(!isRefType(ctx, primType(ctx, 9)))
  assert(!isRefType(ctx, ctx.voidId))
  assert(isRefType(ctx, sl))
  // A payload-less enum is a bare tag word; one with a payload is boxed.
  let bare = leafType(TypeKind.Enum)
  assert(!isRefType(ctx, addType(ctx, bare)))
  let boxed = leafType(TypeKind.Enum)
  boxed.enumBoxed = true
  assert(isRefType(ctx, addType(ctx, boxed)))

  // The stack-map blob: one function, one saved reg, one safepoint with one
  // live slot and one live reg. Layout per ABI.md §4, little-endian packed.
  let out = newByteBuf()
  let sp = SafepointView{ retOffset: 4, slots: [-16], regs: [7] }
  let fsm = FuncStackMap{ codeSize: 32, saved: [SavedReg{ reg: 29, fpOff: -8 }],
    safepoints: [sp] }
  let relocs = writeStackMaps(out, [fsm])
  // u32 numFuncs, then the reloc points at the 8-byte codeAddr right after it.
  assert(len(relocs) == 1 && relocs[0] == 4)
  // 4 (numFuncs) + 8 (codeAddr) + 4 (codeSize) + 2 (numSaved) + 6 (reg+fpOff)
  // + 2 (numSafepoints) + 4 (retOffset) + 2 (numSlots) + 4 (slot)
  // + 2 (numRegs) + 2 (reg) = 40.
  assert(len(out.bytes) == 40)
  assert(int(out.bytes[0]) == 1 && int(out.bytes[1]) == 0) // numFuncs = 1
  assert(int(out.bytes[12]) == 32) // codeSize = 32
  assert(int(out.bytes[16]) == 1) // numSaved = 1
  assert(int(out.bytes[18]) == 29) // saved reg = x29
  // fpOff = -8 sign-extends across the whole i32.
  assert(int(out.bytes[20]) == 248 && int(out.bytes[23]) == 255)
}

function mkIv(vreg: int, class: RegClass, start: int, end: int, isRef: bool): LiveInterval {
  return LiveInterval{ vreg: vreg, class: class, start: start, end: end, isRef: isRef }
}

function mkRegs(intCount: int, floatCount: int): TargetRegs {
  return TargetRegs{ intRegs: RegFile{ count: intCount, calleeSaved: 0 },
    floatRegs: RegFile{ count: floatCount, calleeSaved: 0 } }
}

// The allocator's core correctness invariant: no two intervals whose ranges
// overlap were assigned the same physical register within the same class.
function assertNoOverlappingRegs(intervals: []LiveInterval, locations: []RegLoc) {
  let i = 0
  while (i < len(intervals)) {
    let a = intervals[i]
    let locA = locations[a.vreg]
    if (locA.isSpill) {
      i = i + 1
      continue
    }
    let j = i + 1
    while (j < len(intervals)) {
      let b = intervals[j]
      let locB = locations[b.vreg]
      if (a.class == b.class && !locB.isSpill && locA.index == locB.index) {
        assert(!(a.start <= b.end && b.start <= a.end))
      }
      j = j + 1
    }
    i = i + 1
  }
}

// Stage 3 linear-scan register allocator — ports regalloc.zig's own tests.
function checkRegalloc() {
  // Non-overlapping intervals share a register (reused after expiry).
  let ivs = [mkIv(0, RegClass.Int, 0, 2, false), mkIv(1, RegClass.Int, 3, 5, false)]
  let r = allocate(mkRegs(2, 0), ivs, []int(0))
  assert(!r.locations[0].isSpill && r.locations[0].index == 0)
  assert(!r.locations[1].isSpill && r.locations[1].index == 0)
  assert(r.numSpillSlots == 0)
  assertNoOverlappingRegs(ivs, r.locations)

  // Out of registers: the interval with the furthest end spills.
  let ivs2 = [mkIv(0, RegClass.Int, 0, 4, false), mkIv(1, RegClass.Int, 1, 10, false)]
  let r2 = allocate(mkRegs(1, 0), ivs2, []int(0))
  assert(!r2.locations[0].isSpill && r2.locations[0].index == 0)
  assert(r2.locations[1].isSpill && r2.locations[1].index == 0)
  assert(r2.numSpillSlots == 1)
  assertNoOverlappingRegs(ivs2, r2.locations)

  // A freed spill slot is recycled: v1's slot frees at 6, so v3 (starting at 9)
  // reuses it instead of growing the frame.
  let ivs3 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 1, 6, false),
    mkIv(2, RegClass.Int, 7, 12, false), mkIv(3, RegClass.Int, 9, 15, false)]
  let r3 = allocate(mkRegs(1, 0), ivs3, []int(0))
  assert(!r3.locations[0].isSpill && r3.locations[0].index == 0)
  assert(r3.locations[1].isSpill && r3.locations[1].index == 0)
  assert(!r3.locations[2].isSpill && r3.locations[2].index == 0)
  assert(r3.locations[3].isSpill && r3.locations[3].index == 0)
  assert(r3.numSpillSlots == 1)
  assertNoOverlappingRegs(ivs3, r3.locations)

  // Int and float classes are independent register files.
  let ivs4 = [mkIv(0, RegClass.Int, 0, 10, false), mkIv(1, RegClass.Float, 0, 10, false)]
  let r4 = allocate(mkRegs(1, 1), ivs4, []int(0))
  assert(!r4.locations[0].isSpill && r4.locations[0].index == 0)
  assert(!r4.locations[1].isSpill && r4.locations[1].index == 0)
  assert(r4.numSpillSlots == 0)

  // A precise GC stack map: only v0 (a live ref spanning the safepoint) is
  // reported — not v1 (not a ref) or v2 (dead by pos 5).
  let ivs5 = [mkIv(0, RegClass.Int, 0, 10, true), mkIv(1, RegClass.Int, 0, 10, false),
    mkIv(2, RegClass.Int, 0, 3, true)]
  let r5 = allocate(mkRegs(2, 0), ivs5, [5])
  assert(len(r5.stackMaps) == 1)
  assert(r5.stackMaps[0].pos == 5)
  assert(len(r5.stackMaps[0].slots) == 0)
  assert(len(r5.stackMaps[0].regs) == 1)
  assert(r5.stackMaps[0].regs[0] == r5.locations[0].index)

  // A spilled reference is reported by slot, not register.
  let ivs6 = [mkIv(0, RegClass.Int, 0, 5, false), mkIv(1, RegClass.Int, 1, 20, true)]
  let r6 = allocate(mkRegs(1, 0), ivs6, [10])
  assert(r6.locations[1].isSpill)
  assert(len(r6.stackMaps[0].regs) == 0)
  assert(len(r6.stackMaps[0].slots) == 1)
  assert(r6.stackMaps[0].slots[0] == r6.locations[1].index)

  // Forced register pressure (cap of 4): four long-lived loop-carried values
  // already saturate the file, with 20 overlapping temporaries layered on top.
  // Registers must never overlap and spills must happen.
  let stress = []LiveInterval(0)
  let v = 0
  while (v < 4) {
    stress = append(stress, mkIv(v, RegClass.Int, 0, 200, v == 0))
    v = v + 1
  }
  let t = 0
  while (t < 20) {
    stress = append(stress, mkIv(v, RegClass.Int, t * 5, t * 5 + 40, false))
    v = v + 1
    t = t + 1
  }
  let r7 = allocate(mkRegs(4, 0), stress, [100, 150])
  assertNoOverlappingRegs(stress, r7.locations)
  assert(r7.numSpillSlots > 0)
  let k = 0
  while (k < len(r7.stackMaps)) {
    assert(len(r7.stackMaps[k].regs) + len(r7.stackMaps[k].slots) <= 1)
    k = k + 1
  }
}

// Reads the little-endian 32-bit word at `off` in an emitted code buffer.
function wordAt(code: ByteBuf, off: int): int {
  return int(code.bytes[off]) | (int(code.bytes[off + 1]) << 8) |
    (int(code.bytes[off + 2]) << 16) | (int(code.bytes[off + 3]) << 24)
}

// Stage 3 (#1342) ARM64 encoder. Every expected word below is the seed's own
// golden, cross-checked byte-for-byte against Apple's as/objdump — a
// hand-written encoder with no assembler to fall back on earns its trust here.
function checkArm64Encoder() {
  // mov x0, x1 == ORR X0, XZR, X1
  let c = newByteBuf()
  movRR(c, 0, 1)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0103e0)

  // add/sub/cmp x5, x2, x3
  c = newByteBuf()
  addRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8b030045)
  c = newByteBuf()
  subRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0xcb030045)
  c = newByteBuf()
  cmpRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xeb03005f)

  // and/orr/eor/tst x5, x2, x3
  c = newByteBuf()
  logicalRR(c, 0, 5, 2, 3)
  assert(wordAt(c, 0) == 0x8a030045)
  c = newByteBuf()
  logicalRR(c, 1, 5, 2, 3)
  assert(wordAt(c, 0) == 0xaa030045)
  c = newByteBuf()
  logicalRR(c, 2, 5, 2, 3)
  assert(wordAt(c, 0) == 0xca030045)
  c = newByteBuf()
  tstRR(c, 2, 3)
  assert(wordAt(c, 0) == 0xea03005f)

  // mvn / neg x5, x3
  c = newByteBuf()
  mvnR(c, 5, 3)
  assert(wordAt(c, 0) == 0xaa2303e5)
  c = newByteBuf()
  negR(c, 5, 3)
  assert(wordAt(c, 0) == 0xcb0303e5)

  // mul/sdiv/udiv/msub
  c = newByteBuf()
  mulRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9b037c45)
  c = newByteBuf()
  sdivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30c45)
  c = newByteBuf()
  udivRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac30845)
  c = newByteBuf()
  msubRR(c, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x9b039045)

  // lsl/lsr/asr x5, x2, #5
  c = newByteBuf()
  lslImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd37be845)
  c = newByteBuf()
  lsrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0xd345fc45)
  c = newByteBuf()
  asrImm(c, 5, 2, 5)
  assert(wordAt(c, 0) == 0x9345fc45)

  // lslv/lsrv/asrv x5, x2, x3
  c = newByteBuf()
  lslvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32045)
  c = newByteBuf()
  lsrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32445)
  c = newByteBuf()
  asrvRR(c, 5, 2, 3)
  assert(wordAt(c, 0) == 0x9ac32845)

  // cset x5, <cond> — every condition this backend uses.
  let conds = [condEq(), condNe(), condLt(), condLe(), condGt(), condGe(),
    condCc(), condLs(), condHi(), condCs(), condMi()]
  let wants = [0x9a9f17e5, 0x9a9f07e5, 0x9a9fa7e5, 0x9a9fc7e5, 0x9a9fd7e5,
    0x9a9fb7e5, 0x9a9f27e5, 0x9a9f87e5, 0x9a9f97e5, 0x9a9f37e5, 0x9a9f57e5]
  let i = 0
  while (i < len(conds)) {
    c = newByteBuf()
    cset(c, 5, conds[i])
    assert(wordAt(c, 0) == wants[i])
    i = i + 1
  }

  // movImm64 picks MOVZ/MOVK/MOVN optimally.
  c = newByteBuf()
  movImm64(c, 5, 0x1234)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd2824685) // movz x5, #0x1234
  // Upper halfwords all 0xFFFF -> a single MOVN.
  c = newByteBuf()
  movImm64(c, 5, -0x1235)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0x92824685)
  // 0 and all-ones are each one instruction.
  c = newByteBuf()
  movImm64(c, 5, 0)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  movImm64(c, 5, -1)
  assert(len(c.bytes) == 4)
  // Four distinct nonzero halfwords need MOVZ + 3x MOVK.
  c = newByteBuf()
  movImm64(c, 5, 0x0001000200030004)
  assert(len(c.bytes) == 16)

  // addSubImmWide: a small imm is one instruction; one needing both halves is
  // two (frame-size arithmetic).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 16)
  assert(len(c.bytes) == 4)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 4096 + 16)
  assert(len(c.bytes) == 8)
  // sub sp, sp, #0x100 and the lo==0 shifted-only form (sub sp,sp,#0x11,lsl#12).
  c = newByteBuf()
  addSubImmWide(c, false, 31, 31, 256)
  assert(wordAt(c, 0) == 0x910403ff)
  c = newByteBuf()
  addSubImmWide(c, true, 31, 31, 0x11000)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xd14047ff)
}

// Stage 3 (#1342) ARM64 loads/stores, floats, and branches — seed goldens.
// Stage 3 (#1342 slice 3) ARM64 per-function context: relocations, branch
// fixups, frame layout, and parallel-move sequencing.
function testA64Ctx(): A64Ctx {
  let ctx = newTypeContext()
  return A64Ctx{
    module: IrModule{ funcs: []IrFunc(0), ctx: ctx },
    f: IrFunc{ name: "t", paramTypes: []int(0), result: ctx.voidId,
      blocks: []IrBlock(0), instrs: []IrInstr(0), isFallible: false },
    code: newByteBuf(),
    relocs: []Reloc(0),
    instToVreg: []int(0),
    result: RegAllocResult{ locations: []RegLoc(0), numSpillSlots: 0,
      stackMaps: []StackMapEntry(0) },
    intRegs: []int(0),
    floatRegs: []int(0),
    frame: FrameInfo{ savedGpr: []int(0), savedFpr: []int(0), numSpillSlots: 0,
      outgoingBytes: 0, frameSize: 0 },
    blockOffsets: []int(0),
    jumpFixups: []JumpFixup(0),
    safepoints: []SafepointView(0),
    safepointPositions: []int(0),
    nextSafepointIdx: 0,
  }
}

function assertSameBytes(got: ByteBuf, want: ByteBuf) {
  assert(len(got.bytes) == len(want.bytes))
  let i = 0
  while (i < len(got.bytes)) {
    assert(got.bytes[i] == want.bytes[i])
    i = i + 1
  }
}

function checkArm64Relocs() {
  // BL is a placeholder with an all-zero imm26 plus a branch relocation.
  let cx = testA64Ctx()
  emitCallReloc(cx, "bit_rt_gc_alloc")
  assert(len(cx.code.bytes) == 4 && wordAt(cx.code, 0) == 0x94000000)
  assert(len(cx.relocs) == 1)
  assert(cx.relocs[0].offset == 0 && cx.relocs[0].symbol == "bit_rt_gc_alloc")
  assert(cx.relocs[0].kind == RelocKind.Branch)

  // adrp x3, sym / add x3, x3, #0 — two words, two relocations, and the ADD's
  // reloc must name the SECOND word (an object writer patching both fields at
  // the same offset would corrupt the ADRP).
  cx = testA64Ctx()
  emitAddrOf(cx, 3, "__bitstr_0")
  assert(len(cx.code.bytes) == 8)
  assert(wordAt(cx.code, 0) == 0x90000003)
  assert(wordAt(cx.code, 4) == 0x91000063)
  assert(len(cx.relocs) == 2)
  assert(cx.relocs[0].offset == 0 && cx.relocs[0].kind == RelocKind.Page21)
  assert(cx.relocs[1].offset == 4 && cx.relocs[1].kind == RelocKind.PageOff12)
  assert(cx.relocs[1].symbol == "__bitstr_0")

  // A jump fixup resolves against blockOffsets. AArch64's branch immediate is
  // PC-relative to the branch instruction's OWN address (not the next one), so
  // the word offset is exactly 1048/4 with no off-by-one.
  cx = testA64Ctx()
  cx.blockOffsets = [0, 0]
  emitJumpFixup(cx, 1) // patchOffset == 0
  cx.blockOffsets[1] = 1048
  patchJumpFixups(cx)
  assert(wordAt(cx.code, 0) == 0x14000000 | (1048 / 4))

  // A conditional fixup keeps its condition and takes the imm19 field.
  cx = testA64Ctx()
  cx.blockOffsets = [0, 0]
  emitCondJumpFixup(cx, condNe(), 1)
  cx.blockOffsets[1] = 16
  patchJumpFixups(cx)
  assert(wordAt(cx.code, 0) == 0x54000000 | (4 << 5) | condNe())

  // A local cond branch patches to wherever emission has reached.
  cx = testA64Ctx()
  let at = emitLocalCondBranch(cx, condEq())
  emitRet(cx.code)
  emitRet(cx.code)
  patchLocalCondBranch(cx, at) // target == 12, three words ahead
  assert(wordAt(cx.code, at) == 0x54000000 | (3 << 5) | condEq())
}

function checkArm64Frame() {
  assert(alignFrame16(0) == 0 && alignFrame16(1) == 16 && alignFrame16(16) == 16)
  assert(alignFrame16(17) == 32)

  // Layout, low to high: outgoing args, spills, saved GPRs, saved FPRs, then the
  // x29/x30 frame record in the top 16 bytes.
  let fr = FrameInfo{ savedGpr: [19, 20], savedFpr: [8], numSpillSlots: 3,
    outgoingBytes: 16, frameSize: 96 }
  assert(spillOffset(fr, 0) == 16 && spillOffset(fr, 2) == 32)
  assert(gprSaveOffset(fr, 0) == 40 && gprSaveOffset(fr, 1) == 48)
  assert(fprSaveOffset(fr, 0) == 56)
  assert(savedFpOffset(fr) == 80 && savedLrOffset(fr) == 88)
  assert(outgoingArgOffset(0) == 0 && outgoingArgOffset(2) == 16)
  // The callee reads the k-th incoming stack argument just above its own frame.
  assert(incomingArgOffset(fr, 0) == 96 && incomingArgOffset(fr, 1) == 104)
}

function checkArm64Moves() {
  // Independent moves emit as-is; a self-move is dropped entirely.
  let cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(1), dst: plocReg(2) },
    PMove{ src: plocReg(3), dst: plocReg(3) }], RegClass.Int)
  assert(len(cx.code.bytes) == 4 && wordAt(cx.code, 0) == 0xaa0103e2) // mov x2, x1

  // A dependent chain must drain in reverse: x1->x2 has to happen BEFORE x0->x1
  // overwrites x1, no matter what order the moves arrive in.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(0), dst: plocReg(1) },
    PMove{ src: plocReg(1), dst: plocReg(2) }], RegClass.Int)
  let want = newByteBuf()
  movRR(want, 2, 1)
  movRR(want, 1, 0)
  assertSameBytes(cx.code, want)

  // Regression (#1235): two spilled values swapping stack slots form a mem<->mem
  // 2-cycle. The cycle-break saves one slot's value in a scratch register held
  // across the whole rotation, so that register must differ from the one emitMove
  // uses as its own mem->mem copy temp (scratch1). Using scratch1 for both means
  // the first rotation step overwrites the saved value and the swap silently
  // corrupts — one loop-carried value takes another's. Byte-exact, so a revert to
  // scratch1 fails here and not only in an allocation-sensitive golden.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocMem(0), dst: plocMem(8) },
    PMove{ src: plocMem(8), dst: plocMem(0) }], RegClass.Int)
  want = newByteBuf()
  loadImm(want, scratch2(), regSp(), 8, 8, false)  // save start slot into x10 (NOT x9)
  loadImm(want, scratch1(), regSp(), 0, 8, false)  // rotate the mem->mem move via x9
  storeImm(want, scratch1(), regSp(), 8, 8)
  storeImm(want, scratch2(), regSp(), 0, 8)        // restore saved value from x10
  assertSameBytes(cx.code, want)

  // The float cycle uses the float scratch pair, not the int one.
  cx = testA64Ctx()
  sequentializeAndEmit(cx, [PMove{ src: plocReg(0), dst: plocReg(1) },
    PMove{ src: plocReg(1), dst: plocReg(0) }], RegClass.Float)
  want = newByteBuf()
  fmovFF(want, fscratch2(), 1, 8)
  fmovFF(want, 1, 0, 8)
  fmovFF(want, 0, fscratch2(), 8)
  assertSameBytes(cx.code, want)
}

function checkArm64Operands() {
  // A vreg in a register reads/writes with no memory traffic; a spilled one goes
  // through its frame slot at outgoingBytes + slot*8.
  let cx = testA64Ctx()
  cx.intRegs = [0, 1, 2]
  cx.floatRegs = [4, 5]
  cx.frame = FrameInfo{ savedGpr: []int(0), savedFpr: []int(0), numSpillSlots: 2,
    outgoingBytes: 16, frameSize: 64 }
  cx.result = RegAllocResult{
    locations: [RegLoc{ isSpill: false, index: 2 }, RegLoc{ isSpill: true, index: 1 },
      RegLoc{ isSpill: false, index: 1 }, RegLoc{ isSpill: true, index: 0 }],
    numSpillSlots: 2, stackMaps: []StackMapEntry(0) }

  assert(getInt(cx, 0, scratch1()) == 2 && len(cx.code.bytes) == 0)
  assert(getInt(cx, 1, scratch1()) == scratch1())
  assert(wordAt(cx.code, 0) == 0xf9400fe9) // ldr x9, [sp, #24]
  assert(getFloat(cx, 2, fscratch1()) == 5)
  assert(getFloat(cx, 3, fscratch1()) == fscratch1())
  assert(wordAt(cx.code, 4) == 0xfd400bfe) // ldr d30, [sp, #16]

  cx.code = newByteBuf()
  putInt(cx, 0, 7)
  assert(wordAt(cx.code, 0) == 0xaa0703e2) // mov x2, x7
  cx.code = newByteBuf()
  putInt(cx, 1, 7)
  assert(wordAt(cx.code, 0) == 0xf9000fe7) // str x7, [sp, #24]

  assert(plocOf(cx, 0, RegClass.Int).isReg && plocOf(cx, 0, RegClass.Int).v == 2)
  assert(plocOf(cx, 2, RegClass.Float).v == 5)
  assert(!plocOf(cx, 1, RegClass.Int).isReg && plocOf(cx, 1, RegClass.Int).v == 24)

  cx.instToVreg = [5, 6]
  assert(vregOf(cx, 1) == 6)
}

// Stage 3 (#1342 slice 4a) instruction selectors. The seed has no unit tests
// here — its selectors are covered end-to-end by tests/cases goldens, which need
// an object writer this port does not have yet. So these assert the subtleties
// directly: the scratch-aliasing rules, the width-canonical invariant, and the
// two condition-code mappings.

// A context where value N lives in vreg N lives in register xN/dN, so a
// selector's operands and result are trivially predictable.
function selCtx(): A64Ctx {
  let cx = testA64Ctx()
  cx.intRegs = [0, 1, 2, 3, 4, 5, 6, 7]
  cx.floatRegs = [0, 1, 2, 3, 4, 5, 6, 7]
  let locs = []RegLoc(0)
  let ivs = []int(0)
  let i = 0
  while (i < 8) {
    locs = append(locs, RegLoc{ isSpill: false, index: i })
    ivs = append(ivs, i)
    i = i + 1
  }
  cx.result = RegAllocResult{ locations: locs, numSpillSlots: 0, stackMaps: []StackMapEntry(0) }
  cx.instToVreg = ivs
  return cx
}

function w64(): Width { return mkWidth(8, RegClass.Int, true) }
function w8s(): Width { return mkWidth(1, RegClass.Int, true) }

function checkArm64Extend() {
  // SBFM/UBFM with the immr/imms pairs that name the low 1/2/4 bytes.
  let c = newByteBuf()
  extendRegA(c, 5, 3, 1, true)
  assert(wordAt(c, 0) == 0x93401c65) // sxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 1, false)
  assert(wordAt(c, 0) == 0xd3401c65) // uxtb x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 2, true)
  assert(wordAt(c, 0) == 0x93403c65) // sxth x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, true)
  assert(wordAt(c, 0) == 0x93407c65) // sxtw x5, w3
  c = newByteBuf()
  extendRegA(c, 5, 3, 4, false)
  assert(wordAt(c, 0) == 0xd3407c65) // ubfx x5, x3, #0, #32
  // Width 8 is a plain move, and a move to itself is nothing at all.
  c = newByteBuf()
  extendRegA(c, 5, 3, 8, true)
  assert(len(c.bytes) == 4 && wordAt(c, 0) == 0xaa0303e5)
  c = newByteBuf()
  extendRegA(c, 5, 5, 8, true)
  assert(len(c.bytes) == 0)

  // canonNarrow restores the width-canonical invariant only where it can be lost:
  // never for a full-width int, never for a float.
  c = newByteBuf()
  canonNarrow(c, 5, w64())
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, mkWidth(4, RegClass.Float, false))
  assert(len(c.bytes) == 0)
  c = newByteBuf()
  canonNarrow(c, 5, w8s())
  assert(wordAt(c, 0) == 0x93401ca5) // sxtb x5, w5
}

function checkArm64Selectors() {
  // add x9, x1, x2 ; mov x0, x9 — operands read from their registers, the result
  // computed in scratch1, then written out.
  let cx = selCtx()
  emitBinaryInt(cx, Op.Add, 0, 1, 2, w64())
  let want = newByteBuf()
  addRR(want, scratch1(), 1, 2)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // A narrow add can overflow its width, so it re-narrows; a narrow bitwise op
  // takes canonical operands to a canonical result, so it must NOT.
  cx = selCtx()
  emitBinaryInt(cx, Op.Add, 0, 1, 2, w8s())
  want = newByteBuf()
  addRR(want, scratch1(), 1, 2)
  extendRegA(want, scratch1(), scratch1(), 1, true)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  cx = selCtx()
  emitBinaryInt(cx, Op.BAnd, 0, 1, 2, w8s())
  want = newByteBuf()
  logicalRR(want, logicalOpc(LogicOp.And), scratch1(), 1, 2)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // srem: the divide goes to scratch3, NOT scratch1 — msub still needs `l`, which
  // aliases scratch1 whenever it was spilled and reloaded there. A quotient in
  // scratch1 would clobber it and yield q*(1-r).
  cx = selCtx()
  emitDivInt(cx, Op.SRem, 0, 1, 2)
  want = newByteBuf()
  sdivRR(want, scratch3(), 1, 2)
  msubRR(want, scratch1(), scratch3(), 2, 1)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // A plain divide has no later use of `l`, so it keeps its quotient in scratch1.
  cx = selCtx()
  emitDivInt(cx, Op.UDiv, 0, 1, 2)
  want = newByteBuf()
  udivRR(want, scratch1(), 1, 2)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // A const_int shift amount folds into the immediate form; anything else reads a
  // register.
  cx = selCtx()
  cx.f.instrs = [mkInstr(Op.BlockParam, 0), mkInstr(Op.BlockParam, 0),
    mkInstr(Op.ConstInt, 0)]
  cx.f.instrs[2].ival = 5
  emitShiftInt(cx, Op.Shl, 0, 1, 2, w64())
  want = newByteBuf()
  lslImm(want, scratch1(), 1, 5)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  cx = selCtx()
  cx.f.instrs = [mkInstr(Op.BlockParam, 0), mkInstr(Op.BlockParam, 0),
    mkInstr(Op.BlockParam, 0)]
  emitShiftInt(cx, Op.AShr, 0, 1, 2, w64())
  want = newByteBuf()
  asrvRR(want, scratch1(), 1, 2)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // Only shl pushes bits past the width.
  cx = selCtx()
  cx.f.instrs = [mkInstr(Op.BlockParam, 0), mkInstr(Op.BlockParam, 0),
    mkInstr(Op.BlockParam, 0)]
  emitShiftInt(cx, Op.LShr, 0, 1, 2, w8s())
  want = newByteBuf()
  lsrvRR(want, scratch1(), 1, 2)
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // cmp + cset materializes a bool.
  cx = selCtx()
  emitIcmp(cx, Op.ICmpSlt, 0, 1, 2)
  want = newByteBuf()
  cmpRR(want, 1, 2)
  cset(want, scratch1(), condLt())
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)

  // A float compare produces an INT result (the bool) from FLOAT operands.
  cx = selCtx()
  emitFcmp(cx, Op.FCmpLt, 0, 1, 2, 8)
  want = newByteBuf()
  fcmp(want, 1, 2, 8)
  cset(want, scratch1(), condMi())
  movRR(want, 0, scratch1())
  assertSameBytes(cx.code, want)
}

function checkArm64Conds() {
  assert(constShiftAmountOf(Op.ConstInt, 5) == 5)
  // A shift count is taken mod 64, and a non-constant operand has none at all.
  assert(constShiftAmountOf(Op.ConstInt, 70) == 6)
  assert(constShiftAmountOf(Op.BlockParam, 5) == -1)

  assert(icmpCond(Op.ICmpEq) == condEq() && icmpCond(Op.ICmpNe) == condNe())
  assert(icmpCond(Op.ICmpSlt) == condLt() && icmpCond(Op.ICmpSle) == condLe())
  assert(icmpCond(Op.ICmpSgt) == condGt() && icmpCond(Op.ICmpSge) == condGe())
  // Unsigned compares take the carry-flag conditions, not the signed ones.
  assert(icmpCond(Op.ICmpUlt) == condCc() && icmpCond(Op.ICmpUle) == condLs())
  assert(icmpCond(Op.ICmpUgt) == condHi() && icmpCond(Op.ICmpUge) == condCs())

  // The IEEE-754 gotcha: FCMP's plain EQ/NE/GT/GE are already correct, but LT and
  // LE must be MI and LS — LT/LE would read true on an unordered (NaN) compare.
  assert(fcmpCond(Op.FCmpEq) == condEq() && fcmpCond(Op.FCmpNe) == condNe())
  assert(fcmpCond(Op.FCmpGt) == condGt() && fcmpCond(Op.FCmpGe) == condGe())
  assert(fcmpCond(Op.FCmpLt) == condMi())
  assert(fcmpCond(Op.FCmpLe) == condLs())
  assert(fcmpCond(Op.FCmpLt) != condLt() && fcmpCond(Op.FCmpLe) != condLe())
}

// constShiftAmount takes a whole IrFunc; this builds the one-instruction function
// it needs.
function constShiftAmountOf(op: Op, ival: int): int {
  let ins = mkInstr(op, 0)
  ins.ival = ival
  return constShiftAmount(IrFunc{ name: "t", paramTypes: []int(0), result: 0,
    blocks: []IrBlock(0), instrs: [ins], isFallible: false }, 0)
}

function checkArm64MemFloat() {
  // ldr/str x5, [x1] and the w/b/h load variants.
  let c = newByteBuf()
  loadImm(c, 5, 1, 0, 8, false)
  assert(wordAt(c, 0) == 0xf9400025)
  c = newByteBuf()
  storeImm(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xf9000025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, false)
  assert(wordAt(c, 0) == 0xb9400025)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 4, true)
  assert(wordAt(c, 0) == 0xb9800025) // ldrsw
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, false)
  assert(wordAt(c, 0) == 0x39400025) // ldrb
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 1, true)
  assert(wordAt(c, 0) == 0x39800025) // ldrsb (64-bit dest)
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, false)
  assert(wordAt(c, 0) == 0x79400025) // ldrh
  c = newByteBuf()
  loadImm(c, 5, 1, 0, 2, true)
  assert(wordAt(c, 0) == 0x79800025) // ldrsh

  // Nonzero scaled offsets: #16 and the largest that still fits (#4088).
  c = newByteBuf()
  loadImm(c, 5, 1, 16, 8, false)
  assert(wordAt(c, 0) == 0xf9400825)
  c = newByteBuf()
  loadImm(c, 5, 1, 4088, 8, false)
  assert(wordAt(c, 0) == 0xf947fc25)

  // Register-offset forms, unshifted and scaled, int and fp.
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, false, 1, 5)
  assert(wordAt(c, 0) == 0xf8626825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, false, 0, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xf8227825)
  c = newByteBuf()
  loadStoreRegOffset(c, 3, true, 1, 2, true, 1, 5)
  assert(wordAt(c, 0) == 0xfc627825) // ldr d5,[x1,x2,lsl#3]

  // loadIndexed/storeIndexed pick the scaled register-offset form.
  c = newByteBuf()
  loadIndexed(c, 5, 1, 2, 8, false)
  assert(wordAt(c, 0) == 0xf8627825)
  c = newByteBuf()
  storeIndexed(c, 5, 1, 2, 4)
  assert(wordAt(c, 0) == 0xb8227825)

  // Float load/store, fmov transfers, arithmetic, fneg, fcmp.
  c = newByteBuf()
  storeImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd000025)
  c = newByteBuf()
  loadImmF(c, 5, 1, 0, 8)
  assert(wordAt(c, 0) == 0xfd400025)
  c = newByteBuf()
  storeImmF(c, 5, 1, 0, 4)
  assert(wordAt(c, 0) == 0xbd000025) // width dictates the size field: s-register
  c = newByteBuf()
  fmovToFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e670045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x9e660045)
  c = newByteBuf()
  fmovToFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e270045)
  c = newByteBuf()
  fmovFromFp(c, 5, 2, 4)
  assert(wordAt(c, 0) == 0x1e260045)
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 8) // fadd
  assert(wordAt(c, 0) == 0x1e632845)
  c = newByteBuf()
  fArithRR(c, 3, 5, 2, 3, 8) // fsub
  assert(wordAt(c, 0) == 0x1e633845)
  c = newByteBuf()
  fArithRR(c, 0, 5, 2, 3, 8) // fmul
  assert(wordAt(c, 0) == 0x1e630845)
  c = newByteBuf()
  fArithRR(c, 1, 5, 2, 3, 8) // fdiv
  assert(wordAt(c, 0) == 0x1e631845)
  c = newByteBuf()
  fnegF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e614045)
  c = newByteBuf()
  fcmp(c, 2, 3, 8)
  assert(wordAt(c, 0) == 0x1e632040)
  c = newByteBuf()
  fmovFF(c, 5, 2, 8)
  assert(wordAt(c, 0) == 0x1e604045)
  // width=4 selects the s-register encoding for the same register index.
  c = newByteBuf()
  fArithRR(c, 2, 5, 2, 3, 4)
  assert(wordAt(c, 0) == 0x1e232845)

  // ret / udf.
  c = newByteBuf()
  emitRet(c)
  assert(wordAt(c, 0) == 0xd65f03c0)
  c = newByteBuf()
  emitUdf(c)
  assert(wordAt(c, 0) == 0)

  // Branch fixups patch to the correct relative word offset. An unconditional
  // B at 0 targeting byte 8 is +2 words; a B.cond likewise, in its imm19 field.
  c = newByteBuf()
  emitWord(c, 0x14000000) // B placeholder at offset 0
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, -1)
  assert(wordAt(c, 0) == (0x14000000 | 2))
  c = newByteBuf()
  emitWord(c, 0x54000000 | condEq())
  emitWord(c, 0)
  emitWord(c, 0)
  patchBranchTo(c, 0, 8, condEq())
  assert(wordAt(c, 0) == (0x54000000 | (2 << 5) | condEq()))
  // A backward branch encodes a negative word offset (two's complement).
  c = newByteBuf()
  emitWord(c, 0)
  emitWord(c, 0)
  emitWord(c, 0x14000000) // B at offset 8 targeting 0 == -2 words
  patchBranchTo(c, 8, 0, -1)
  assert(wordAt(c, 8) == (0x14000000 | ((-2) & 0x3FFFFFF)))
}

function selfcheck() {
  checkArm64Encoder()
  checkArm64MemFloat()
  checkArm64Relocs()
  checkArm64Frame()
  checkArm64Moves()
  checkArm64Operands()
  checkArm64Extend()
  checkArm64Selectors()
  checkArm64Conds()
  checkRegalloc()
  checkCodegenCore()
  checkInferTypes()
  checkIrDump()
  checkTypeNames()
  checkResolveSubstrate()
  checkDiagnostics()
  checkDiagRender()
  checkAst()
  checkLexer()
  checkNumbers()
  checkStrings()
  checkInterp()
  checkParser()
}
