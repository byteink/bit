// Parser: patterns, match arms, and statements — if/while/for/select/switch,
// simple statements, blocks, and statement-level error recovery. Split out of
// parser.bit (#1503); sibling .bit files are the same module, so this is a pure
// move.

// A pattern: `_`/IDENT (both lex as ident) or a nested tuple pattern.
function parsePat(p: Parser): int {
  if (peekKind(p) == Kind.LParen) {
    return parseTuplePat(p)
  }
  return leaf(p, Tag.Ident)
}

// `( pat, pat, ... )` — a tuple destructuring pattern.
function parseTuplePat(p: Parser): int {
  let lp = peekTok(p) // the `(` — spanned so a diagnostic on the pattern (e.g. a
  expect(p, Kind.LParen) // destructuring assign, E0041) anchors from it, like the seed.
  let items = []int(0)
  while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
    items = append(items, parsePat(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  let rp = peekTok(p) // the `)`
  expect(p, Kind.RParen)
  return addNode(p.tree, Tag.TuplePat, Span{ file: 0, start: lp.start, end: rp.end }, 0, items)
}

// A variant pattern `V` or `V(a, b)` — `[name, binders_or_none]`, binders an
// expr_list of ident leaves.
function parseVariantPat(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let binders = 0
  if (accept(p, Kind.LParen)) {
    let ids = []int(0)
    while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
      ids = append(ids, leaf(p, Tag.Ident))
      if (!accept(p, Kind.Comma)) {
        break
      }
    }
    expect(p, Kind.RParen)
    binders = mkNode(p, Tag.ExprList, 0, ids)
  }
  return mkNode(p, Tag.VariantPat, 0, [name, binders])
}

// `pat => body` — the body is an expression (match expression) or a statement
// (match statement).
function parseMatchArm(p: Parser, asExpr: bool): int {
  let pat = parseVariantPat(p)
  expect(p, Kind.FatArrow)
  let body = 0
  if (asExpr) {
    body = parseExpr(p)
  } else {
    body = parseStatement(p)
  }
  return mkNode(p, Tag.MatchArm, 0, [pat, body])
}

// `match (subject) { arm , arm ; ... }` — arms separate on `,`/`;` (ASI at a
// newline). One shared node for the statement and expression forms.
function parseMatch(p: Parser, asExpr: bool): int {
  advance(p)
  expect(p, Kind.LParen)
  let subject = parseExpr(p)
  expect(p, Kind.RParen)
  expect(p, Kind.LBrace)
  let arms = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 100000) {
    if (accept(p, Kind.Semicolon) || accept(p, Kind.Comma)) {
      guard = guard + 1
      continue
    }
    arms = append(arms, parseMatchArm(p, asExpr))
    let atBoundary = peekKind(p) == Kind.RBrace || peekKind(p) == Kind.Eof
    if (!accept(p, Kind.Semicolon) && !accept(p, Kind.Comma) && !atBoundary) {
      advance(p)
    }
    guard = guard + 1
  }
  expect(p, Kind.RBrace)
  let armList = mkNode(p, Tag.ArmList, 0, arms)
  return mkNode(p, Tag.MatchStmt, 0, [subject, armList])
}

// Whether `k` can begin an expression. `parseReturn` is the only caller: it
// decides a bare `return` from `return expr`. The prefix-operator tail must
// therefore track `parseUnary`'s own set exactly — `Kind.Star`, the §11.4
// raw-pointer dereference, was missing here while `parseUnary` accepted it, so
// `return *p` was rejected as a bare return followed by stray input even though
// `let v = *p` parsed fine.
function canStartExpression(k: Kind): bool {
  return k == Kind.Ident || k == Kind.IntLit || k == Kind.FloatLit ||
    k == Kind.StringLit || k == Kind.StrPart || k == Kind.RawStringLit ||
    k == Kind.RuneLit || k == Kind.BoolLit || k == Kind.NilLit ||
    k == Kind.LParen || k == Kind.LBracket || k == Kind.KwMap ||
    k == Kind.KwChan || k == Kind.KwMatch || k == Kind.KwAsm || k == Kind.Bang ||
    k == Kind.Minus || k == Kind.Plus || k == Kind.Tilde ||
    k == Kind.ArrowLeft || k == Kind.Star
}

// `return [ expr { "," expr } ]` — a grouped return carries several exprs.
function parseReturn(p: Parser): int {
  let kw = peekTok(p)
  advance(p)
  // A bare `return`'s span is the keyword; with a value it runs from `return`
  // through the last value — the seed's `join(start, end)` (a kid-only span
  // would drop the keyword, and misplace a bare return at 1:1).
  if (!canStartExpression(peekKind(p))) {
    return addNode(p.tree, Tag.ReturnStmt, Span{ file: 0, start: kw.start, end: kw.end }, 0, []int(0))
  }
  let items = []int(0)
  items = append(items, parseExpr(p))
  while (accept(p, Kind.Comma)) {
    items = append(items, parseExpr(p))
  }
  return addNode(p.tree, Tag.ReturnStmt,
    Span{ file: 0, start: kw.start, end: getNode(p.tree, items[len(items) - 1]).span.end }, 0, items)
}

function isAssignOp(k: Kind): bool {
  return k == Kind.Eq || k == Kind.PlusEq || k == Kind.MinusEq ||
    k == Kind.StarEq || k == Kind.SlashEq || k == Kind.PercentEq ||
    k == Kind.AmpEq || k == Kind.PipeEq || k == Kind.CaretEq ||
    k == Kind.ShlEq || k == Kind.ShrEq
}

// `assign | inc | dec | send | expr` statement. The assign op (or `=`) is stored
// A non-empty comma-separated expression list (assignment rhs, multi-lhs).
function parseExprList1(p: Parser): []int {
  let xs = []int(0)
  xs = append(xs, parseExpr(p))
  while (accept(p, Kind.Comma)) {
    xs = append(xs, parseExpr(p))
  }
  return xs
}

// in `Node.main`; lhs/rhs are comma lists (lhs_list / expr_list).
function parseSimpleStmt(p: Parser): int {
  // A statement opening with `(` may be a tuple-pattern destructuring assign
  // `(a, b) = expr` — parse a tuple pat and require an assign op; on failure
  // reset and fall through to the normal expression parse (paren expr, call).
  if (peekKind(p) == Kind.LParen) {
    let mark = p.pos
    let dmark = len(p.diags.list)
    let pat = parseTuplePat(p)
    if (isAssignOp(peekKind(p))) {
      let op = peekKind(p)
      advance(p)
      let rhss = parseExprList1(p)
      let lhsList = mkNode(p, Tag.LhsList, 0, [pat])
      let rhsList = mkNode(p, Tag.ExprList, 0, rhss)
      return mkNode(p, Tag.Assign, int(op), [lhsList, rhsList])
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
  }
  let first = parseExpr(p)
  let k = peekKind(p)
  if (k == Kind.PlusPlus) {
    advance(p)
    return mkNode(p, Tag.IncStmt, 0, [first])
  }
  if (k == Kind.MinusMinus) {
    advance(p)
    return mkNode(p, Tag.DecStmt, 0, [first])
  }
  if (k == Kind.ArrowLeft) {
    advance(p)
    return mkNode(p, Tag.SendStmt, 0, [first, parseExpr(p)])
  }
  if (k == Kind.Comma || isAssignOp(k)) {
    let lhss = []int(0)
    lhss = append(lhss, first)
    while (accept(p, Kind.Comma)) {
      lhss = append(lhss, parseExpr(p))
    }
    if (!isAssignOp(peekKind(p))) {
      return mkNode(p, Tag.ExprStmt, 0, [first])
    }
    let op = peekKind(p)
    advance(p)
    let rhss = parseExprList1(p)
    let lhsList = mkNode(p, Tag.LhsList, 0, lhss)
    let rhsList = mkNode(p, Tag.ExprList, 0, rhss)
    return mkNode(p, Tag.Assign, int(op), [lhsList, rhsList])
  }
  return mkNode(p, Tag.ExprStmt, 0, [first])
}

function parseIfStmt(p: Parser): int {
  advance(p)
  expect(p, Kind.LParen)
  let cond = parseExpr(p)
  expect(p, Kind.RParen)
  let thenBlk = parseBlock(p)
  let elseBlk = 0
  if (accept(p, Kind.KwElse)) {
    if (peekKind(p) == Kind.KwIf) {
      elseBlk = parseIfStmt(p)
    } else {
      elseBlk = parseBlock(p)
    }
  }
  return mkNode(p, Tag.IfStmt, 0, [cond, thenBlk, elseBlk])
}

function parseWhileStmt(p: Parser): int {
  advance(p)
  expect(p, Kind.LParen)
  let cond = parseExpr(p)
  expect(p, Kind.RParen)
  let body = parseBlock(p)
  return mkNode(p, Tag.WhileStmt, 0, [cond, body])
}

// A `for..of`/`for..in` iterable has composite literals suppressed at its top
// level (the `{` after it opens the loop body).
function parseIterExpr(p: Parser): int {
  let saved = p.noComposite
  p.noComposite = true
  let e = parseExpr(p)
  p.noComposite = saved
  return e
}

// `for ( init ; cond ; post ) block` — each clause optional.
function parseForC(p: Parser): int {
  expect(p, Kind.LParen)
  let init = 0
  let k = peekKind(p)
  if (k == Kind.KwLet) {
    init = parseValueDecl(p, Tag.LetDecl, 0)
  } else if (k == Kind.KwConst) {
    init = parseValueDecl(p, Tag.ConstDecl, 0)
  } else if (k != Kind.Semicolon) {
    init = parseSimpleStmt(p)
  }
  expect(p, Kind.Semicolon)
  let cond = 0
  if (peekKind(p) != Kind.Semicolon) {
    cond = parseExpr(p)
  }
  expect(p, Kind.Semicolon)
  let post = 0
  if (peekKind(p) != Kind.RParen) {
    post = parseSimpleStmt(p)
  }
  expect(p, Kind.RParen)
  let body = parseBlock(p)
  return mkNode(p, Tag.ForC, 0, [init, cond, post, body])
}

// `for x of iter`, `for x in iter`, `for (init; cond; post)`, or `for {}`. The
// tuple binder form `for (k, v) of m` needs speculation and is a follow-up.
function parseForStmt(p: Parser): int {
  advance(p)
  let k = peekKind(p)
  if (k == Kind.LParen) {
    // `for (k, v) of m` — a tuple binder. Speculate a tuple pattern followed by
    // `of`; on failure, reset (orphaned nodes are harmless — the dump walks only
    // from the root) and take the C-style `for (init; cond; post)`.
    let mark = p.pos
    let dmark = len(p.diags.list)
    let binder = parseTuplePat(p)
    if (len(kidsOf(p.tree, binder)) >= 2 && peekKind(p) == Kind.KwOf) {
      advance(p)
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForOf, 0, [binder, iter, parseBlock(p)])
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
    return parseForC(p)
  }
  if (k == Kind.Ident) {
    let name = leaf(p, Tag.Ident)
    if (accept(p, Kind.KwOf)) {
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForOf, 0, [name, iter, parseBlock(p)])
    }
    if (accept(p, Kind.KwIn)) {
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForIn, 0, [name, iter, parseBlock(p)])
    }
    return mkNode(p, Tag.ForInf, 0, [parseBlock(p)])
  }
  return mkNode(p, Tag.ForInf, 0, [parseBlock(p)])
}

// Statements of a `case`/`default` clause body, up to the next clause or `}`.
function parseCaseStmts(p: Parser): []int {
  let stmts = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.KwCase && peekKind(p) != Kind.KwDefault &&
    peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 100000) {
    if (accept(p, Kind.Semicolon)) {
      guard = guard + 1
      continue
    }
    stmts = append(stmts, parseStatement(p))
    let atB = peekKind(p) == Kind.KwCase || peekKind(p) == Kind.KwDefault ||
      peekKind(p) == Kind.RBrace || peekKind(p) == Kind.Eof
    if (!accept(p, Kind.Semicolon) && !atB) {
      advance(p)
    }
    guard = guard + 1
  }
  return stmts
}

// A select-clause communication: `binder = <- chan` (recv_bind), `ch <- v`
// (send_stmt), or a bare receive/expression.
function parseComm(p: Parser): int {
  if (peekKind(p) == Kind.Ident || peekKind(p) == Kind.LParen) {
    let mark = p.pos
    let dmark = len(p.diags.list)
    let binder = 0
    if (peekKind(p) == Kind.LParen) {
      binder = parseTuplePat(p)
    } else {
      binder = leaf(p, Tag.Ident)
    }
    if (peekKind(p) == Kind.Eq && peekKindAt(p, 1) == Kind.ArrowLeft) {
      advance(p)
      advance(p)
      return mkNode(p, Tag.RecvBind, 0, [binder, parseExpr(p)])
    }
    truncateDiags(p.diags, dmark)
    p.pos = mark
  }
  let e = parseExpr(p)
  if (accept(p, Kind.ArrowLeft)) {
    return mkNode(p, Tag.SendStmt, 0, [e, parseExpr(p)])
  }
  return e
}

// `select { case comm: stmts ; default: stmts }`.
function parseSelectStmt(p: Parser): int {
  advance(p)
  expect(p, Kind.LBrace)
  let clauses = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 100000) {
    if (peekKind(p) == Kind.KwCase) {
      advance(p)
      let comm = parseComm(p)
      expect(p, Kind.Colon)
      let slist = mkNode(p, Tag.StmtList, 0, parseCaseStmts(p))
      clauses = append(clauses, mkNode(p, Tag.CommCase, 0, [comm, slist]))
    } else if (peekKind(p) == Kind.KwDefault) {
      advance(p)
      expect(p, Kind.Colon)
      let slist = mkNode(p, Tag.StmtList, 0, parseCaseStmts(p))
      clauses = append(clauses, mkNode(p, Tag.CommDefault, 0, [slist]))
    } else {
      advance(p)
    }
    guard = guard + 1
  }
  expect(p, Kind.RBrace)
  return mkNode(p, Tag.SelectStmt, 0, clauses)
}

// `switch [ (subject) ] { case e, e: stmts ; default: stmts }`.
function parseSwitchStmt(p: Parser): int {
  advance(p)
  let subject = 0
  if (accept(p, Kind.LParen)) {
    subject = parseExpr(p)
    expect(p, Kind.RParen)
  }
  expect(p, Kind.LBrace)
  let cases = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 100000) {
    if (peekKind(p) == Kind.KwCase) {
      advance(p)
      let exprs = []int(0)
      exprs = append(exprs, parseExpr(p))
      while (accept(p, Kind.Comma)) {
        exprs = append(exprs, parseExpr(p))
      }
      expect(p, Kind.Colon)
      let elist = mkNode(p, Tag.ExprList, 0, exprs)
      let slist = mkNode(p, Tag.StmtList, 0, parseCaseStmts(p))
      cases = append(cases, mkNode(p, Tag.SwitchCase, 0, [elist, slist]))
    } else if (peekKind(p) == Kind.KwDefault) {
      advance(p)
      expect(p, Kind.Colon)
      let slist = mkNode(p, Tag.StmtList, 0, parseCaseStmts(p))
      cases = append(cases, mkNode(p, Tag.SwitchDefault, 0, [slist]))
    } else {
      // A stray token where a clause is due: report once (E0021), then skip past
      // the whole offending run so the loop makes progress and does not
      // re-report each token (mirrors the seed's fail + synchronize).
      parseFail(p, "'case' or 'default'")
      advance(p)
      while (peekKind(p) != Kind.KwCase && peekKind(p) != Kind.KwDefault &&
        peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
        advance(p)
      }
    }
    guard = guard + 1
  }
  expect(p, Kind.RBrace)
  let clist = mkNode(p, Tag.CaseList, 0, cases)
  return mkNode(p, Tag.SwitchStmt, 0, [subject, clist])
}

function parseStatement(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.KwLet) { return parseValueDecl(p, Tag.LetDecl, 0) }
  if (k == Kind.KwConst) { return parseValueDecl(p, Tag.ConstDecl, 0) }
  if (k == Kind.KwIf) { return parseIfStmt(p) }
  if (k == Kind.KwWhile) { return parseWhileStmt(p) }
  if (k == Kind.KwFor) { return parseForStmt(p) }
  if (k == Kind.KwMatch) { return parseMatch(p, false) }
  if (k == Kind.KwSelect) { return parseSelectStmt(p) }
  if (k == Kind.KwSwitch) { return parseSwitchStmt(p) }
  if (k == Kind.KwReturn) { return parseReturn(p) }
  if (k == Kind.KwFail) {
    let kw = peekTok(p)
    advance(p)
    let e = parseExpr(p)
    return addNode(p.tree, Tag.FailStmt,
      Span{ file: 0, start: kw.start, end: getNode(p.tree, e).span.end }, 0, [e])
  }
  // A childless keyword statement has no kids for `mkNode` to span, so its span
  // is the keyword token itself — the seed's `break_stmt`/`continue_stmt` span.
  if (k == Kind.KwBreak) {
    let kw = peekTok(p)
    advance(p)
    return addNode(p.tree, Tag.BreakStmt, Span{ file: 0, start: kw.start, end: kw.end }, 0, []int(0))
  }
  if (k == Kind.KwContinue) {
    let kw = peekTok(p)
    advance(p)
    return addNode(p.tree, Tag.ContinueStmt, Span{ file: 0, start: kw.start, end: kw.end }, 0, []int(0))
  }
  // `spawn`/`defer` span the KEYWORD plus the call, not the call alone. `mkNode`
  // derives a span from the kids, and the keyword is a token rather than a child,
  // so it would be dropped — the same shape as the unary-operator and `@attr`
  // cases above. It surfaces as E0075 underlining `g()` instead of `spawn g()`.
  if (k == Kind.KwSpawn || k == Kind.KwDefer) {
    let kw = peekTok(p)
    advance(p)
    let call = parsePostfix(p)
    let tag = Tag.DeferStmt
    if (k == Kind.KwSpawn) { tag = Tag.SpawnStmt }
    return addNode(p.tree, tag,
      Span{ file: 0, start: kw.start, end: getNode(p.tree, call).span.end },
      0, [call])
  }
  if (k == Kind.LBrace) { return parseBlock(p) }
  return parseSimpleStmt(p)
}

// Skips to the next statement-starting token, `;` (consumed), or a block/case
// boundary — the seed's error recovery so cascading diagnostics align. Bounded
// by the remaining tokens.
function synchronizeStatement(p: Parser) {
  let guard = 0
  while (peekKind(p) != Kind.Eof && guard < 1000000) {
    let k = peekKind(p)
    if (k == Kind.Semicolon) {
      advance(p)
      return
    }
    if (k == Kind.RBrace || k == Kind.KwCase || k == Kind.KwDefault) {
      return
    }
    if (k == Kind.KwLet || k == Kind.KwConst || k == Kind.KwIf || k == Kind.KwWhile ||
      k == Kind.KwFor || k == Kind.KwSwitch || k == Kind.KwMatch || k == Kind.KwSelect ||
      k == Kind.KwReturn || k == Kind.KwFail || k == Kind.KwBreak || k == Kind.KwContinue ||
      k == Kind.KwSpawn || k == Kind.KwDefer) {
      return
    }
    advance(p)
    guard = guard + 1
  }
}

// Both braces bound the block and neither is a kid, so `mkNode` would span only
// the statements — an empty block would get a 1:1 span, and a diagnostic
// anchored on the block (E0067) would point at its last statement instead of at
// the block. The seed spans `join(start, end)`; capture both delimiters.
function parseBlock(p: Parser): int {
  let lb = peekTok(p)
  expect(p, Kind.LBrace)
  let stmts = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 1000000) {
    if (accept(p, Kind.Semicolon)) {
      guard = guard + 1
      continue
    }
    stmts = append(stmts, parseStatement(p))
    // A statement not closed by `;`/`}`/eof is malformed: report the missing
    // separator once and synchronize past the offending run (the seed's block
    // recovery), so the cascade matches rather than reparsing the garbage.
    if (!accept(p, Kind.Semicolon) && peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
      parseFail(p, "';'")
      synchronizeStatement(p)
    }
    guard = guard + 1
  }
  let rbEnd = peekTok(p).end
  expect(p, Kind.RBrace)
  return addNode(p.tree, Tag.Block, Span{ file: 0, start: lb.start, end: rbEnd }, 0, stmts)
}
