// In-Bit self-checks for the Mach-O object writer. Split out of selfcheck.bit
// (#1503); sibling .bit files are the same module, so `selfcheck()` still
// calls these directly.

// The message writeMacho failed with, or "" if it succeeded.
function machoErr(t: MachoTarget, obj: MachoObject): string {
  let msg = ""
  let b = writeMacho(t, obj) catch e {
    msg = e.message()
    []u8(0)
  }
  return msg
}

function checkMachoMinimal() {
  // push rbp; mov rbp,rsp; pop rbp; ret
  let code = [u8(0x55), u8(0x48), u8(0x89), u8(0xe5), u8(0x5d), u8(0xc3)]
  let obj = MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
      alignment: 16 }],
    symbols: [MachoSymbol{ name: "_main", hasSection: true,
      section: MachoSectionKind.Text, offset: 0, size: len(code),
      binding: MachoBinding.Global }],
    relocations: []MachoRelocation(0) }
  assert(machoErr(MachoTarget.X86_64, obj) == "") // a valid object is not rejected
  let b = writeMacho(MachoTarget.X86_64, obj) catch e { []u8(0) }

  assert(leAt(b, 0, 4) == 0xfeedfacf) // magic
  assert(leAt(b, 4, 4) == 0x01000007) // cputype == CPU_TYPE_X86_64
  assert(leAt(b, 12, 4) == 0x1)       // filetype == MH_OBJECT
  assert(leAt(b, 16, 4) == 2)         // ncmds

  let segOff = sizeofMachHeader64()
  assert(leAt(b, segOff, 4) == 0x19)           // LC_SEGMENT_64
  assert(leAt(b, segOff + 64, 4) == 1)         // nsects
  assert(leAt(b, segOff + 48, 8) == len(code)) // filesize

  let secOff = segOff + sizeofSegmentCommand64()
  assert(name16At(b, secOff) == "__text")
  assert(name16At(b, secOff + 16) == "__TEXT")
  assert(leAt(b, secOff + 40, 8) == len(code)) // size
  assert(leAt(b, secOff + 52, 4) == 4)         // alignment 16 -> log2 == 4
  let dataOff = leAt(b, secOff + 48, 4)
  let i = 0
  while (i < len(code)) {
    assert(b[dataOff + i] == code[i])
    i = i + 1
  }
}

function checkMachoFull() {
  // bl #0 (placeholder); ret
  let code = [u8(0x00), u8(0x00), u8(0x00), u8(0x94), u8(0xc0), u8(0x03), u8(0x5f), u8(0xd6)]
  let rodata = []byte("hello")
  let gcMeta = []u8(16)
  let obj = MachoObject{
    // Deliberately given in REVERSE canonical order: the file layout must not
    // follow argument order.
    sections: [
      MachoSection{ kind: MachoSectionKind.GcMeta, data: gcMeta, size: 0, alignment: 8 },
      MachoSection{ kind: MachoSectionKind.Bss, data: []u8(0), size: 64, alignment: 8 },
      MachoSection{ kind: MachoSectionKind.Rodata, data: rodata, size: 0, alignment: 1 },
      MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0, alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "_add", hasSection: true, section: MachoSectionKind.Text,
        offset: 0, size: len(code), binding: MachoBinding.Global },
      MachoSymbol{ name: "msg", hasSection: true, section: MachoSectionKind.Rodata,
        offset: 0, size: len(rodata), binding: MachoBinding.Local },
      MachoSymbol{ name: "_bit_rt_gc_alloc", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [
      MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
        symbol: "_bit_rt_gc_alloc", kind: MachoRelocKind.Branch },
      MachoRelocation{ section: MachoSectionKind.GcMeta, offset: 8, symbol: "msg",
        kind: MachoRelocKind.Unsigned64 }] }
  assert(machoErr(MachoTarget.Aarch64, obj) == "")
  let b = writeMacho(MachoTarget.Aarch64, obj) catch e { []u8(0) }
  assert(leAt(b, 4, 4) == 0x0100000C) // cputype == CPU_TYPE_ARM64

  // `present` is canonical order filtered to what this object has:
  // [text, rodata, bss, gc_meta] — no data section was given, so rodata lands
  // second. The sections were passed in reverse, so this ordering can only come
  // from machoCanonicalOrder.
  let s0 = sizeofMachHeader64() + sizeofSegmentCommand64()
  let s1 = s0 + sizeofSection64()
  let s2 = s1 + sizeofSection64()
  let s3 = s2 + sizeofSection64()
  assert(name16At(b, s0) == "__text")
  assert(name16At(b, s1) == "__const")
  assert(name16At(b, s2) == "__bss")
  assert(name16At(b, s3) == "__bit_gc")
  assert(name16At(b, s3 + 16) == "__DATA") // gc metadata lives in __DATA

  // bss is zerofill: a size and a flag, but no file bytes.
  assert(leAt(b, s2 + 40, 8) == 64)
  assert(leAt(b, s2 + 64, 4) == 0x1) // S_ZEROFILL
  assert(leAt(b, s2 + 48, 4) == 0)   // offset

  let gcOff = leAt(b, s3 + 48, 4)
  let i = 0
  while (i < len(gcMeta)) {
    assert(b[gcOff + i] == gcMeta[i])
    i = i + 1
  }
  let roOff = leAt(b, s1 + 48, 4)
  i = 0
  while (i < len(rodata)) {
    assert(b[roOff + i] == rodata[i])
    i = i + 1
  }

  // Section64: reloff @56, nreloc @60.
  assert(leAt(b, s0 + 60, 4) == 1) // text nreloc
  assert(leAt(b, s3 + 60, 4) == 1) // gc_meta nreloc

  // The branch relocation: pc-relative, 4 bytes, external, ARM64_RELOC_BRANCH26.
  let tr = leAt(b, s0 + 56, 4) // text reloff
  assert(leAt(b, tr, 4) == 0)  // r_address
  let ti = leAt(b, tr + 4, 4)
  assert((ti >> 24) & 1 == 1)  // r_pcrel
  assert((ti >> 25) & 3 == 2)  // r_length == 4 bytes
  assert((ti >> 27) & 1 == 1)  // r_extern
  assert((ti >> 28) & 15 == 2) // ARM64_RELOC_BRANCH26
  assert(ti & 0xFFFFFF == 2)   // r_symbolnum: _bit_rt_gc_alloc is symbol 2

  // The gc_meta relocation is absolute and 8 bytes wide.
  let gr = leAt(b, s3 + 56, 4) // gc_meta reloff
  assert(leAt(b, gr, 4) == 8)  // r_address
  let gi = leAt(b, gr + 4, 4)
  assert((gi >> 24) & 1 == 0)  // r_pcrel == 0 (absolute)
  assert((gi >> 25) & 3 == 3)  // r_length == 8 bytes
  assert((gi >> 28) & 15 == 0) // ARM64_RELOC_UNSIGNED
  assert(gi & 0xFFFFFF == 1)   // symbol 1 == msg

  // An external symbol is NO_SECT/N_UNDF; a defined one carries its section
  // ordinal and its address.
  let symtabOff = s3 + sizeofSection64()
  assert(leAt(b, symtabOff, 4) == 0x2) // LC_SYMTAB
  let symoff = leAt(b, symtabOff + 8, 4)
  assert(leAt(b, symtabOff + 12, 4) == 3) // nsyms
  let ext = symoff + 2 * sizeofNlist64()
  assert(leAt(b, ext + 4, 1) == 0x01) // N_UNDF | N_EXT
  assert(leAt(b, ext + 5, 1) == 0)    // NO_SECT
  assert(leAt(b, ext + 8, 8) == 0)    // no address
  assert(leAt(b, symoff + 4, 1) == 0xe | 0x01) // _add: N_SECT | N_EXT
  assert(leAt(b, symoff + 5, 1) == 1)          // text is section ordinal 1
  assert(leAt(b, symoff + sizeofNlist64() + 4, 1) == 0xe) // msg: N_SECT, local
}

function checkMachoRejects() {
  // A 4-byte section: big enough that a 4-byte branch relocation at offset 0
  // FITS, so the unknown-symbol case below reaches its own check instead of
  // tripping the bounds check first (validation order: bounds, then symbol).
  let code = [u8(0), u8(0), u8(0), u8(0)]
  let text = MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
    alignment: 1 }
  let noRelocs = []MachoRelocation(0)

  // Nothing can ever define an undefined local, so the binding is meaningless.
  assert(machoErr(MachoTarget.X86_64, MachoObject{
    sections: []MachoSection(0),
    symbols: [MachoSymbol{ name: "hidden", hasSection: false,
      section: MachoSectionKind.Text, offset: 0, size: 0,
      binding: MachoBinding.Local }],
    relocations: noRelocs }) == "UndefinedLocalSymbol")

  assert(machoErr(MachoTarget.X86_64, MachoObject{
    sections: [text, MachoSection{ kind: MachoSectionKind.Text, data: code,
      size: 0, alignment: 1 }],
    symbols: []MachoSymbol(0), relocations: noRelocs }) == "DuplicateSection")

  assert(machoErr(MachoTarget.X86_64, MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: code, size: 0,
      alignment: 3 }],
    symbols: []MachoSymbol(0), relocations: noRelocs }) == "InvalidSectionAlignment")

  let dup = MachoSymbol{ name: "same", hasSection: true,
    section: MachoSectionKind.Text, offset: 0, size: 4,
    binding: MachoBinding.Global }
  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: [dup, dup], relocations: noRelocs }) == "DuplicateSymbol")

  // A symbol naming a section this object does not carry.
  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: [MachoSymbol{ name: "d", hasSection: true,
      section: MachoSectionKind.Data, offset: 0, size: 0,
      binding: MachoBinding.Global }],
    relocations: noRelocs }) == "SectionNotPresent")

  // offset + size must fit inside the section.
  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: [MachoSymbol{ name: "big", hasSection: true,
      section: MachoSectionKind.Text, offset: 0, size: 99,
      binding: MachoBinding.Global }],
    relocations: noRelocs }) == "SymbolOutOfBounds")

  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: []MachoSymbol(0),
    relocations: [MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
      symbol: "nope", kind: MachoRelocKind.Branch }] }) == "UnknownSymbol")

  // The relocated FIELD must fit too: a 4-byte branch at offset 2 needs bytes
  // [2..6) of a 4-byte section.
  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: [dup],
    relocations: [MachoRelocation{ section: MachoSectionKind.Text, offset: 2,
      symbol: "same", kind: MachoRelocKind.Branch }] }) == "RelocOutOfBounds")

  // A valid object with a resolvable relocation reports no error.
  assert(machoErr(MachoTarget.X86_64, MachoObject{ sections: [text],
    symbols: [dup],
    relocations: [MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
      symbol: "same", kind: MachoRelocKind.Branch }] }) == "")
}
