// Self-host Stage 2 (#1337): the SSA IR data model + text dumper, ported from
// compiler/ir.zig's `Op`/`Module` + `dump`. This is the substrate the lowering
// pass (AST -> IR) builds on next; landing the model + printer first (pinned by
// selfcheck against a hand-built function) mirrors how types.bit's typeName
// landed before the checker used it. `bit2 --dump-ir` must byte-match the
// seed's `bit --dump-ir` over the corpus once lowering lands.
//
// SSA shape: a function is a flat `instrs` array whose index IS the value id
// (`%N`); each block owns a contiguous range `[instsStart, instsStart+instsLen)`
// whose first `paramCount` slots are its block parameters (phi results, printed
// in the block header, never as body lines).

// Every instruction opcode (compiler/ir.zig `Op`). The dumper prints arithmetic
// and compare ops by their tag name (opName); the rest are literal in dumpInst.
enum Op {
  BlockParam,
  ConstInt, ConstFloat, ConstBool, ConstString, ConstNil,
  Add, Sub, Mul, SDiv, UDiv, SRem, URem,
  FAdd, FSub, FMul, FDiv,
  BAnd, BOr, BXor, Shl, AShr, LShr,
  Neg, FNeg, BNot,
  // Primitives that ARE a machine instruction, not a runtime call. `FSqrt` is
  // `fsqrt`/`sqrtsd`; `Bitcast` is `floatBits`/`float32Bits`, a register-class
  // transfer (`fmov`/`movq`) that reinterprets a float's storage as the
  // same-width unsigned integer — unlike `Convert`, which is numeric. Ops
  // rather than RtCalls because an RtCall is a call, and a call is what makes
  // the matching `bit_rt_*` unimplementable in Bit: its body would compile to a
  // call to itself (tests/rootpins.zig). Being ops also makes them pure and
  // safepoint-free, which is what admits them inside `@nosplit`.
  // MUST stay between BNot and Convert: `opIsBinary` tests enum ORDINAL RANGES
  // (Add..LShr, ICmpEq..FCmpGe), so inserting anywhere inside those spans would
  // silently reclassify unrelated ops.
  FSqrt, Bitcast,
  // `ffloor`/`fceil`/`ftrunc`/`fround` (SPEC §17): round an f64 to an integral
  // f64 under the four IEEE-754 directions. Ops rather than RtCalls for the
  // same reason as `FSqrt`.
  //
  // One instruction on AArch64 (`FRINTM`/`FRINTP`/`FRINTZ`/`FRINTA`). On
  // x86-64 they would be one `roundsd`, but that is SSE4.1 and this backend
  // emits nothing above SSE2, so `x64.bit` expands each into a short SSE2
  // sequence instead. That is still not a call: it allocates nothing and
  // reaches no safepoint, which is the property that matters here.
  //
  // `FRound` is ties-AWAY-from-zero. It is therefore `FRINTA` and specifically
  // NOT `FRINTN`/`roundsd` mode 0, which are ties-to-even and differ on exactly
  // the halfway cases.
  // Same ordinal-range constraint as `FSqrt`/`Bitcast` above: these MUST stay
  // between `Bitcast` and `Convert`.
  FFloor, FCeil, FTrunc, FRound,
  Convert,
  ICmpEq, ICmpNe, ICmpSlt, ICmpSle, ICmpSgt, ICmpSge,
  ICmpUlt, ICmpUle, ICmpUgt, ICmpUge,
  FCmpEq, FCmpNe, FCmpLt, FCmpLe, FCmpGt, FCmpGe,
  Jump, Br, Ret, Unreachable,
  Call, CallValue, CallIface,
  GcAlloc, TypeInfo, FieldGet, FieldSet, IndexGet, IndexSet, SliceLen,
  // Atomics (§11.5): inline lock-free ops on a raw `*T`. `lhs`=ptr; store's
  // value / rmw's operand in `rhs`; cmpxchg's expected in `rhs`, desired in
  // `ival`. Strongest ordering only — no ordering operand.
  AtomicLoad, AtomicStore, AtomicCmpxchg,
  AtomicRmwAdd, AtomicRmwSub, AtomicRmwAnd, AtomicRmwOr, AtomicRmwXchg,
  MakeClosure, FuncAddr, RtCall,
  // Module-level state (§11.11): materializes a module variable's static
  // address as a raw `*T`. `name` is the global's emitted symbol. Pure address
  // arithmetic — no load, no call, no safepoint — which is what makes module
  // state reachable from a `@nosplit` body (§10.3.1). Reads and writes then go
  // through the ordinary FieldGet/FieldSet (offset 0) or IndexGet/IndexSet the
  // raw-pointer path already uses, so no new load/store op is needed.
  GlobalAddr,
  // Inline assembly (§11.6): `ival`=asm-block-pool index, `args`=input operand
  // values, `ival2`=1 iff it has a `result` operand. `ty` is the result type
  // (or void). The bulky per-arch payload lives in `IrModule.asmBlocks`.
  Asm,
  // Raw OS syscall (§11.8), Linux only: `lhs`=the syscall number, `args`=its
  // 0..6 arguments in order, result always i64. Unlike every other builtin
  // this is NOT an RtCall — there is no `bit_rt_syscall` symbol to relocate
  // against, since the backends emit the kernel trap inline.
  Syscall,
}

// The tag-name spelling the seed's `@tagName(op)` yields (used for the bin/un/
// convert/compare op mnemonics in the dump). Only the ops printed via opName
// need a row; the rest are literal in dumpInst.
function opName(op: Op): string {
  if (op == Op.Add) { return "add" }
  if (op == Op.Sub) { return "sub" }
  if (op == Op.Mul) { return "mul" }
  if (op == Op.SDiv) { return "sdiv" }
  if (op == Op.UDiv) { return "udiv" }
  if (op == Op.SRem) { return "srem" }
  if (op == Op.URem) { return "urem" }
  if (op == Op.FAdd) { return "fadd" }
  if (op == Op.FSub) { return "fsub" }
  if (op == Op.FMul) { return "fmul" }
  if (op == Op.FDiv) { return "fdiv" }
  if (op == Op.BAnd) { return "band" }
  if (op == Op.BOr) { return "bor" }
  if (op == Op.BXor) { return "bxor" }
  if (op == Op.Shl) { return "shl" }
  if (op == Op.AShr) { return "ashr" }
  if (op == Op.LShr) { return "lshr" }
  if (op == Op.Neg) { return "neg" }
  if (op == Op.FNeg) { return "fneg" }
  if (op == Op.BNot) { return "bnot" }
  if (op == Op.FSqrt) { return "fsqrt" }
  if (op == Op.Bitcast) { return "bitcast" }
  if (op == Op.FFloor) { return "ffloor" }
  if (op == Op.FCeil) { return "fceil" }
  if (op == Op.FTrunc) { return "ftrunc" }
  if (op == Op.FRound) { return "fround" }
  if (op == Op.Convert) { return "convert" }
  if (op == Op.ICmpEq) { return "icmp_eq" }
  if (op == Op.ICmpNe) { return "icmp_ne" }
  if (op == Op.ICmpSlt) { return "icmp_slt" }
  if (op == Op.ICmpSle) { return "icmp_sle" }
  if (op == Op.ICmpSgt) { return "icmp_sgt" }
  if (op == Op.ICmpSge) { return "icmp_sge" }
  if (op == Op.ICmpUlt) { return "icmp_ult" }
  if (op == Op.ICmpUle) { return "icmp_ule" }
  if (op == Op.ICmpUgt) { return "icmp_ugt" }
  if (op == Op.ICmpUge) { return "icmp_uge" }
  if (op == Op.FCmpEq) { return "fcmp_eq" }
  if (op == Op.FCmpNe) { return "fcmp_ne" }
  if (op == Op.FCmpLt) { return "fcmp_lt" }
  if (op == Op.FCmpLe) { return "fcmp_le" }
  if (op == Op.FCmpGt) { return "fcmp_gt" }
  if (op == Op.FCmpGe) { return "fcmp_ge" }
  if (op == Op.AtomicRmwAdd) { return "atomic_rmw_add" }
  if (op == Op.AtomicRmwSub) { return "atomic_rmw_sub" }
  if (op == Op.AtomicRmwAnd) { return "atomic_rmw_and" }
  if (op == Op.AtomicRmwOr) { return "atomic_rmw_or" }
  if (op == Op.AtomicRmwXchg) { return "atomic_rmw_xchg" }
  return "?"
}

// Whether an op is a two-operand arithmetic/bitwise/compare instruction printed
// as `%d = <op> <type> %lhs, %rhs`.
function opIsBinary(op: Op): bool {
  return int(op) >= int(Op.Add) && int(op) <= int(Op.LShr) ||
    int(op) >= int(Op.ICmpEq) && int(op) <= int(Op.FCmpGe)
}

// Bit `i` is set when argument `i` of the runtime primitive `rt` is an untyped
// 64-bit *word* — the container primitives (`slice_*`, `map_*`, `chan_*`,
// runtime/ABI.md §2/§11/§15) store one element per word and declare it `u64` in
// C, so it travels in an INTEGER register no matter what the Bit element type
// is. Lowering bitcasts a float operand into that word so the IR states the
// register class the callee's signature actually uses; without it codegen
// classifies by the Bit type and passes the element in d0/xmm0, which the
// callee never reads. Mirrors seed/ir.zig's `rtWordArgs`.
function rtWordArgs(rt: string): int {
  if (rt == "slice_append" || rt == "chan_send" || rt == "map_get" ||
    rt == "map_has" || rt == "map_delete") { return 2 }
  if (rt == "slice_set") { return 4 }
  // Both the key and the value of `map_set(m, key, val)` are words.
  if (rt == "map_set") { return 6 }
  return 0
}

// Whether `rt` returns an untyped word rather than a value of its Bit result
// type — the read half of `rtWordArgs`. The result comes back in the integer
// return register and lowering bitcasts it into a float result.
function rtReturnsWord(rt: string): bool {
  return rt == "slice_get" || rt == "map_get" || rt == "map_key_at" ||
    rt == "map_val_at" || rt == "chan_recv"
}

// One SSA instruction. A tagged record: only the fields an op needs are set
// (the seed packs these into an `extra` array; selfhost keeps them named). For
// call-shaped ops the callee/runtime name is resolved into `name` so the dumper
// stays self-contained.
struct IrInstr {
  op: Op,
  ty: int,        // result type id (TypeContext); void for terminators/void ops
  args: []int,    // call/rt_call/ret args, jump/br target args
  lhs: int,       // bin lhs / un operand / field-or-index base / call callee
  rhs: int,       // bin rhs / field-or-index value or index
  ival: int,      // const_int, offset, method_index, gc size, type disc, block ids
  ival2: int,     // second immediate (type_info size, br else block)
  fval: f64,      // const_float
  bval: bool,     // const_bool
  sval: string,   // const_string text
  name: string,   // call/make_closure/func_addr callee name, rt_call rt name
  offsets: []int, // gc_alloc / type_info pointer offsets
  thenArgs: []int, // br then-block args
  elseArgs: []int, // br else-block args
}

// A basic block: a contiguous slice of the function's flat instr array; the
// first `paramCount` slots are its block parameters.
struct IrBlock {
  instsStart: int,
  paramCount: int,
  instsLen: int,
}

// A lowered function: its signature, its blocks, and the flat SSA instr array
// (index == value id).
struct IrFunc {
  name: string,
  paramTypes: []int,
  result: int,
  blocks: []IrBlock,
  instrs: []IrInstr,
  // A `T!` function threads its error through the thread-local slot rather than
  // its result. Not rendered by the dump; the optimizer reads it to keep error
  // propagation out of the inliner's scope (the seed's `is_fallible`).
  isFallible: bool,
  // §10.3.1 @naked: no prologue/epilogue, raw `ret`. @nosplit: no back-edge
  // safepoint. Neither is rendered by the dump (like isFallible), so an
  // attr-less corpus stays byte-identical; codegen reads them to gate emission.
  isNaked: bool,
  isNosplit: bool,
  // §17.6 freestanding: true iff this function came from the build's ROOT
  // module. lowerProject lowers every imported module into the same IrModule,
  // so an object emitted from all of it carries their functions too — archive
  // two such objects and they collide. A freestanding emit keeps only the
  // functions tagged here. Not rendered by the dump (like isFallible), so the
  // differential corpus is unaffected. Mirrors the seed's `in_root_module`.
  inRootModule: bool,
}

// A whole module: the functions plus the shared type context for typeName.
// One entry in a type's method table: the method name's global dispatch id, and
// the IR function implementing it. The seed stores a FuncId; selfhost mangles a
// method's IR name by its receiver (`get$t21`), so the name IS the identity and
// no indirection is needed.
struct MethodSlot {
  id: int,
  func: string,
}

// A concrete type's method table (runtime/ABI.md §2.1). `typeDisc` is the type's
// id, matching the discriminator codegen threads into the type's TypeInfo symbol,
// so the emitter attaches the table to the right blob. call_iface resolves
// through these at runtime via bit_rt_iface_lookup.
struct MethodTable {
  typeDisc: int,
  methods: []MethodSlot,
}

// One inline-assembly block's static payload (§11.6), pooled on the module and
// referenced by an `Op.Asm`'s `ival` — the bulky, non-SSA data kept out of the
// instruction stream, like the string pool. Both target sub-blocks live here;
// each backend reads only its own arch's. Register codes follow
// `check.asmRegX64`/`asmRegArm64` (254 = the `memory` clobber sentinel). `inX64`/
// `inArm64` are parallel to the instruction's `args`.
struct AsmBlock {
  x64Bytes: []int,
  arm64Words: []int,
  hasResult: bool,
  resultX64: int,
  resultArm64: int,
  inX64: []int,
  inArm64: []int,
  clobX64: []int,
  clobArm64: []int,
}

struct IrModule {
  funcs: []IrFunc,
  ctx: TypeContext,
  // Inline-assembly payloads (§11.6), referenced by `Op.Asm.ival`.
  asmBlocks: []AsmBlock,
  // Functions emitted signature-only because their bodies could not be lowered.
  // Their code is a bare `ret` — it computes NOTHING — so a caller silently gets
  // a garbage result. `bit2 build` refuses a module with any of these; the dump
  // surfaces still render them, which is how the differential marks an unported
  // construct.
  stubbed: []string,
  // Per-type method tables, one per distinct receiver, in first-seen order.
  // Like stringPool: nothing in the IR dump renders these, so no differential
  // covers them — but they land in the binary.
  methodTables: []MethodTable,
  // Every distinct string literal the program materializes, in __bitstr_N order.
  // Interned during LOWERING, not codegen: the optimizer can delete a
  // const_string, and renumbering the pool afterwards would move every later
  // literal's .rodata slot. Not rendered by the dump (which prints each literal's
  // text inline), so no differential covers this ordering — it is load-bearing
  // for byte-identical output all the same.
  stringPool: []string,
  // Module-level mutable variables (§11.11), referenced by `Op.GlobalAddr.name`.
  // Empty for programs with no module state.
  globals: []IrGlobal,
  // §11.7 `extern function` names, raw and unmangled, in declaration order.
  // An extern decl emits no IrFunc at all (calls resolve by name), so without
  // this the names vanish before the linker sees them — and the Mach-O linker
  // needs exactly this set to tell a legal dylib import from a symbol the
  // compiler misspelled (#1445). The seed carries the same information as
  // `IrFunc.is_extern`; selfhost has no such function to hang it on.
  // Not rendered by the IR dump, so no differential covers it.
  externNames: []string,
}

// One module-level mutable variable: a statically allocated cell (§11.11).
// `bytes` is its complete initial image in target byte order, so emission is a
// straight blob copy and there is no run-time initialization pass at all.
//
// The type is guaranteed untraced by check.bit (scalars, raw `*T`, and fixed
// arrays of those), which is WHY this can be a plain byte image: no word here is
// ever a GC reference, so the collector never walks it and the cell needs no
// TypeInfo and no root registration. See SPEC §11.11.
//
// `storage` is the storage class: 0 = process-wide (one cell per program), 1 =
// per-thread, 2 = READ-ONLY (#1447). Only process-wide has a front-end surface
// today; the per-thread arm is specified but not yet emitted (it needs TLS
// sections and relocations, and the Mach-O half of that is a separate
// sub-feature).
//
// Class 2 is the static-data mechanism: one image for the program, placed in
// `.rodata`/`__TEXT,__const` so the loader maps it without write permission. It
// exists for static TABLES — SHA round constants, AES S-boxes — which today
// must be spelled as a function returning a literal, costing one GC allocation
// per call. The paragraph above about untraced types still holds, and more
// simply: a read-only image cannot be mutated, so it can never come to hold a
// pointer to a moved object.
//
// Unlike the two writable classes it may carry `relocs`. Empty for classes 0
// and 1, whose images are final at compile time.
struct IrGlobal {
  name: string,
  bytes: []int,
  align: int,
  storage: int,
  relocs: []IrGlobalReloc,
}

// One 64-bit absolute pointer inside a read-only global's image, filled in at
// link time. `abs64` is the only kind needed and so the only kind offered: the
// single construct requiring a relocation here is a `[]T` slice header, whose
// `buf` word must hold the address of the payload bytes. A `[N]T` fixed array
// needs none — its value IS its own base address in this IR.
//
// Deliberately NOT a general relocation list: every extra kind is a new
// arithmetic rule in two object writers and two linkers, and read-only data is
// the area of this project with the worst record for silent wrongness.
struct IrGlobalReloc {
  // Byte offset within the owning global's `bytes`. The 8 bytes there are
  // overwritten with `symbol + addend`.
  offset: int,
  symbol: string,
  addend: int,
}

// The read-only storage class (§11.11). Named rather than spelled `2` at each
// site, which is how the process/thread pair became hard to read.
function storageReadonly(): int { return 2 }

// The pool index of `s`, appending it if new. Identical literals share one
// __bitstr_N header.
function internString(m: IrModule, s: string): int {
  let i = 0
  while (i < len(m.stringPool)) {
    if (m.stringPool[i] == s) {
      return i
    }
    i = i + 1
  }
  m.stringPool = append(m.stringPool, s)
  return len(m.stringPool) - 1
}

// The IR dump's type spelling — compiler/ir.zig `writeTypeName`, which differs
// from the checker's typeName: void is `void` (not `()`), a func is `fn(P) R`
// (not `(P) => R`), a fallible always shows its error, a type param is `<T>`,
// and any untyped/invalid/over-deep type is a placeholder.
function irJoinNames(ctx: TypeContext, ids: []int, depth: int): string {
  let s = ""
  let i = 0
  while (i < len(ids)) {
    if (i > 0) {
      s = s + ", "
    }
    s = s + irTypeNameDepth(ctx, ids[i], depth + 1)
    i = i + 1
  }
  return s
}

function irTypeNameDepth(ctx: TypeContext, id: int, depth: int): string {
  if (depth >= 64) {
    return "<...>"
  }
  let t = ctx.types[id]
  let k = t.kind
  if (k == TypeKind.Invalid) { return "<invalid>" }
  if (k == TypeKind.Void) { return "void" }
  if (k == TypeKind.UntypedInt || k == TypeKind.UntypedFloat || k == TypeKind.UntypedRune ||
    k == TypeKind.UntypedBool || k == TypeKind.UntypedString || k == TypeKind.UntypedNil) {
    return "<untyped>"
  }
  if (k == TypeKind.Prim) { return primName(t.prim) }
  if (k == TypeKind.Slice) { return "[]" + irTypeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Ptr) { return "*" + irTypeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Chan) { return "chan<" + irTypeNameDepth(ctx, t.elem, depth + 1) + ">" }
  if (k == TypeKind.Array) { return "[${t.arrayLen}]" + irTypeNameDepth(ctx, t.elem, depth + 1) }
  if (k == TypeKind.Map) {
    return "map<" + irTypeNameDepth(ctx, t.mapKey, depth + 1) + ", " + irTypeNameDepth(ctx, t.mapVal, depth + 1) + ">"
  }
  if (k == TypeKind.Tuple) { return "(" + irJoinNames(ctx, t.members, depth) + ")" }
  if (k == TypeKind.Func) {
    return "fn(" + irJoinNames(ctx, t.members, depth) + ") " + irTypeNameDepth(ctx, t.result, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return irTypeNameDepth(ctx, t.result, depth + 1) + "!" + irTypeNameDepth(ctx, t.errTy, depth + 1)
  }
  if (k == TypeKind.TypeParam) { return "<T>" }
  if (t.hasName) { return t.name }
  return "<anon>"
}

function irTypeName(ctx: TypeContext, id: int): string {
  return irTypeNameDepth(ctx, id, 0)
}

// A zeroed instruction with only its op and result type set; callers fill the
// operand fields the op needs (the lowering builder and the selfcheck pin).
function mkInstr(op: Op, ty: int): IrInstr {
  return IrInstr{ op: op, ty: ty, args: []int(0), lhs: 0, rhs: 0, ival: 0, ival2: 0,
    fval: 0.0, bval: false, sval: "", name: "", offsets: []int(0),
    thenArgs: []int(0), elseArgs: []int(0) }
}

// Renders a comma-separated `%v0, %v1, …` value list.
function dumpValList(vals: []int): string {
  let s = ""
  let i = 0
  while (i < len(vals)) {
    if (i > 0) {
      s = s + ", "
    }
    s = s + "%${vals[i]}"
    i = i + 1
  }
  return s
}

// Renders one instruction line (with its trailing newline), matching
// compiler/ir.zig's dumpInst byte-for-byte. `id` is the instruction's value id.
function dumpInst(m: IrModule, ins: IrInstr, id: int): string {
  let op = ins.op
  let ty = irTypeName(m.ctx, ins.ty)
  if (op == Op.ConstInt) { return "  %${id} = const_int ${ty} ${ins.ival}\n" }
  if (op == Op.ConstFloat) { return "  %${id} = const_float ${ty} ${ins.fval}\n" }
  if (op == Op.ConstBool) { return "  %${id} = const_bool ${ins.bval}\n" }
  if (op == Op.ConstString) { return "  %${id} = const_string \"${ins.sval}\"\n" }
  if (op == Op.ConstNil) { return "  %${id} = const_nil\n" }
  if (opIsBinary(op)) {
    return "  %${id} = ${opName(op)} ${ty} %${ins.lhs}, %${ins.rhs}\n"
  }
  if (op == Op.Neg || op == Op.FNeg || op == Op.BNot || op == Op.Convert ||
    op == Op.FSqrt || op == Op.Bitcast ||
    op == Op.FFloor || op == Op.FCeil || op == Op.FTrunc || op == Op.FRound) {
    return "  %${id} = ${opName(op)} ${ty} %${ins.lhs}\n"
  }
  if (op == Op.Jump) {
    return "  jump bb${ins.ival}(${dumpValList(ins.args)})\n"
  }
  if (op == Op.Br) {
    return "  br %${ins.lhs}, bb${ins.ival}(${dumpValList(ins.thenArgs)}), bb${ins.ival2}(${dumpValList(ins.elseArgs)})\n"
  }
  if (op == Op.Ret) {
    if (len(ins.args) > 0) {
      return "  ret ${dumpValList(ins.args)}\n"
    }
    return "  ret\n"
  }
  if (op == Op.Unreachable) { return "  unreachable\n" }
  if (op == Op.Call) {
    return "  %${id} = call @${ins.name}(${dumpValList(ins.args)}) ${ty}\n"
  }
  if (op == Op.CallValue) {
    return "  %${id} = call_value %${ins.lhs}(${dumpValList(ins.args)}) ${ty}\n"
  }
  if (op == Op.CallIface) {
    return "  %${id} = call_iface %${ins.lhs}.${ins.ival}(${dumpValList(ins.args)}) ${ty}\n"
  }
  if (op == Op.GcAlloc) {
    return "  %${id} = gc_alloc size=${ins.ival} ptrs=[${dumpValList(ins.offsets)}] ${ty}\n"
  }
  if (op == Op.TypeInfo) {
    return "  %${id} = type_info disc=${ins.ival} size=${ins.ival2} ptrs=[${dumpValList(ins.offsets)}] ${ty}\n"
  }
  if (op == Op.FieldGet) {
    return "  %${id} = field_get %${ins.lhs}[${ins.ival}] ${ty}\n"
  }
  if (op == Op.FieldSet) {
    return "  field_set %${ins.lhs}[${ins.ival}] = %${ins.rhs}\n"
  }
  if (op == Op.IndexGet) {
    return "  %${id} = index_get %${ins.lhs}[%${ins.rhs}] ${ty}\n"
  }
  if (op == Op.IndexSet) {
    return "  index_set %${ins.lhs}[%${ins.rhs}] = %${ins.ival}\n"
  }
  if (op == Op.SliceLen) {
    return "  %${id} = slice_len %${ins.lhs}\n"
  }
  if (op == Op.AtomicLoad) {
    return "  %${id} = atomic_load %${ins.lhs} ${ty}\n"
  }
  if (op == Op.AtomicStore) {
    return "  atomic_store %${ins.lhs} = %${ins.rhs}\n"
  }
  if (op == Op.AtomicCmpxchg) {
    return "  %${id} = atomic_cmpxchg %${ins.lhs}, %${ins.rhs}, %${ins.ival} ${ty}\n"
  }
  if (op == Op.AtomicRmwAdd || op == Op.AtomicRmwSub || op == Op.AtomicRmwAnd ||
    op == Op.AtomicRmwOr || op == Op.AtomicRmwXchg) {
    return "  %${id} = ${opName(op)} %${ins.lhs}, %${ins.rhs} ${ty}\n"
  }
  if (op == Op.MakeClosure) {
    return "  %${id} = make_closure @${ins.name}, %${ins.lhs}\n"
  }
  if (op == Op.FuncAddr) {
    return "  %${id} = func_addr @${ins.name}\n"
  }
  if (op == Op.GlobalAddr) {
    return "  %${id} = global_addr @${ins.name}\n"
  }
  if (op == Op.RtCall) {
    return "  %${id} = rt_call ${ins.name}(${dumpValList(ins.args)}) ${ty}\n"
  }
  if (op == Op.Asm) {
    if (ins.ival2 == 1) {
      return "  %${id} = asm block=${ins.ival}(${dumpValList(ins.args)})\n"
    }
    return "  asm block=${ins.ival}(${dumpValList(ins.args)})\n"
  }
  if (op == Op.Syscall) {
    return "  %${id} = syscall %${ins.lhs}(${dumpValList(ins.args)}) ${ty}\n"
  }
  return ""
}

// Renders one `func …(…) … { … }` block, matching dumpFunction byte-for-byte.
function dumpFunction(m: IrModule, f: IrFunc): string {
  let s = "func ${f.name}("
  let i = 0
  while (i < len(f.paramTypes)) {
    if (i > 0) {
      s = s + ", "
    }
    s = s + "%${i}: " + irTypeName(m.ctx, f.paramTypes[i])
    i = i + 1
  }
  s = s + ") " + irTypeName(m.ctx, f.result) + " {\n"
  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    s = s + "bb${bi}("
    let p = 0
    while (p < b.paramCount) {
      if (p > 0) {
        s = s + ", "
      }
      let v = b.instsStart + p
      s = s + "%${v}: " + irTypeName(m.ctx, f.instrs[v].ty)
      p = p + 1
    }
    s = s + "):\n"
    let k = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (k < end) {
      s = s + dumpInst(m, f.instrs[k], k)
      k = k + 1
    }
    bi = bi + 1
  }
  return s + "}\n"
}

// Renders a module as deterministic IR text: one `func` block per function,
// blank-line separated, matching compiler/ir.zig `dump`.
function dumpIr(m: IrModule): string {
  let s = ""
  let i = 0
  while (i < len(m.funcs)) {
    if (i > 0) {
      s = s + "\n"
    }
    s = s + dumpFunction(m, m.funcs[i])
    i = i + 1
  }
  return s
}

// The static TypeInfo blob's symbol for one object shape (runtime/ABI.md §3).
// The name encodes the shape itself, so two allocation sites with identical
// layout share one blob and the linker folds them.
function typeInfoSymbol(disc: int, size: int, ptrOffsets: []int): string {
  let s = "__bittype_${disc}_${size}"
  let i = 0
  while (i < len(ptrOffsets)) {
    s = s + "_${ptrOffsets[i]}"
    i = i + 1
  }
  return s
}

// A type's method table, or an empty one if it has none.
function methodTableOf(m: IrModule, typeDisc: int): MethodTable {
  let i = 0
  while (i < len(m.methodTables)) {
    if (m.methodTables[i].typeDisc == typeDisc) {
      return m.methodTables[i]
    }
    i = i + 1
  }
  return MethodTable{ typeDisc: typeDisc, methods: []MethodSlot(0) }
}
