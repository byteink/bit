// Self-host Stage 2 (#1337): AST -> SSA IR lowering, ported from
// compiler/lower.zig. Builds an `IrModule` (selfhost/ir.bit) whose `dumpIr`
// byte-matches the seed's `bit --dump-ir` over the corpus. Grows
// statement/expression by statement/expression; this first slice lowers each
// function's *signature* and an empty body (`func f(…) R { bb0(…): ret }`),
// the shape every function ends with when it falls off the end.
//
// Reuses the checker (selfhost/check.bit) for types: a function's parameter and
// result types come from the same `typeFromNode`/`funcResults` the type dump
// uses, so IR types and inferred types stay consistent by construction.

// Alignment of every module-level cell (§11.11). Mirrors seed/lower.zig's
// `module_state_align`. 16, not the type's natural alignment: §11.11 admits a
// fixed array `[N]U` so the runtime can carve its own memory out of one, and a
// green-thread stack is that use. Both supported ABIs require a 16-byte-aligned
// stack pointer, so an 8-aligned array lands at `addr % 16 == 8` for some
// declaration orders and faults only then — a silent, order-dependent hazard.
// A uniform 16 makes the guarantee statable; the cost is at most 8 bytes of
// padding per cell.
const moduleStateAlign = 16

// The incremental IR builder: a flat instr array (index == value id) plus the
// blocks that slice it, and the block currently being appended to.
struct IrBuilder {
  instrs: []IrInstr,
  blocks: []IrBlock,
  cur: int,
  blockStart: int,
  blockParamCount: int,
}

function newBuilder(): IrBuilder {
  return IrBuilder{ instrs: []IrInstr(0), blocks: []IrBlock(0), cur: -1,
    blockStart: 0, blockParamCount: 0 }
}

// Reserves a fresh block id; its instruction range is recorded later at
// endBlock. Blocks are created ahead of being filled (e.g. an if's then/join),
// so the range is deferred, mirroring the seed's FunctionBuilder.
function builderNewBlock(b: IrBuilder): int {
  b.blocks = append(b.blocks, IrBlock{ instsStart: 0, paramCount: 0, instsLen: 0 })
  return len(b.blocks) - 1
}

// Opens a block for appending: its instructions start at the current end of the
// flat array.
function builderBeginBlock(b: IrBuilder, id: int) {
  b.cur = id
  b.blockStart = len(b.instrs)
  b.blockParamCount = 0
}

// Records the current block's final [start, len, paramCount] range. The
// terminator must already be emitted.
function builderEndBlock(b: IrBuilder) {
  b.blocks[b.cur] = IrBlock{ instsStart: b.blockStart, paramCount: b.blockParamCount,
    instsLen: len(b.instrs) - b.blockStart }
}

// Appends one instruction to the current block, returning its SSA value id.
function builderEmit(b: IrBuilder, ins: IrInstr): int {
  b.instrs = append(b.instrs, ins)
  return len(b.instrs) - 1
}

// Adds a block parameter (phi result) to the current block. Params must precede
// the block's body instructions, so this is called right after beginBlock.
function builderAddParam(b: IrBuilder, ty: int): int {
  let id = builderEmit(b, mkInstr(Op.BlockParam, ty))
  b.blockParamCount = b.blockParamCount + 1
  return id
}

// The parameter type list of a function declaration, in order, with a method
// receiver (if any) as the leading parameter — mirroring lowerFunctionDecl.
function lowerParamTypes(c: Checker, decl: int): []int {
  return lowerParamTypesIn(c, decl, noSubst())
}

// The IR parameter SLOTS for `decl`. Identical to `lowerParamTypes` except that
// a trailing `...xs: T` occupies one slot of type `[]T`: the declared type node
// holds the element type T, but the body binds — and the call ABI passes — the
// slice (§10.3). A signature built from the declared types alone would declare
// a scalar that the body then reads a slice header off of, so this is the
// callee-side half of variadic lowering; `lowerArgsRest` is the caller side.
function lowerParamSlotTypes(c: Checker, decl: int): []int {
  let types = lowerParamTypes(c, decl)
  // An extern decl is [name, params, result] — no kid 3 — and cannot be
  // variadic anyway (E0077), so it is never rewritten here.
  if (len(types) == 0 || isExternDecl(c.tree, decl)) {
    return types
  }
  if (paramsAreVariadic(c, kidsOf(c.tree, decl)[3])) {
    types[len(types) - 1] = mkSlice(c.ctx, types[len(types) - 1])
  }
  return types
}

// `sub` binds the decl's type params (by name, which is unambiguous WITHIN one
// decl) so a generic's parameter types come out concrete for one call.
function lowerParamTypesIn(c: Checker, decl: int, sub: TypeSubst): []int {
  let kids = kidsOf(c.tree, decl)
  let types = []int(0)
  // SPEC 11.7: an extern decl is [name, params, result] — its kid 0 is the NAME,
  // not a receiver, and it has no kid 3. Both must be resolved by tag, not shape.
  let paramsNode = 0
  if (isExternDecl(c.tree, decl)) {
    paramsNode = kids[1]
  } else {
    paramsNode = kids[3]
    if (kids[0] != 0) {
      types = append(types, typeFromNodeIn(c, kidsOf(c.tree, kids[0])[1], sub))
    }
  }
  let params = kidsOf(c.tree, paramsNode)
  let i = 0
  while (i < len(params)) {
    types = append(types, typeFromNodeIn(c, kidsOf(c.tree, params[i])[1], sub))
    i = i + 1
  }
  return types
}

// One in-scope local: its name, current SSA value id, and type. The env is an
// *ordered* list (not a map) so control-flow joins can snapshot/restore/rebind
// live locals by position, matching the seed's Env.
struct LocalBind {
  name: string,
  value: int,
  ty: int,
}

// Per-function lowering state: the checker (for types), the IR builder, the
// ordered local environment, and flags. `failed` trips on any construct not yet
// lowerable, so the function falls back to a signature-only stub rather than
// emitting partial/garbage IR.
struct FnCtx {
  c: Checker,
  b: IrBuilder,
  env: []LocalBind,
  failed: bool,
  terminated: bool,
  // Enclosing loops (innermost last): break jumps to `exit`, continue to `cont`,
  // both carrying the first `preLen` live locals.
  loops: []LoopFrame,
  // Module-level const name -> its initializer node, inlined at each reference
  // (the seed materializes a top-level const's value at every use site).
  moduleConsts: map<string, int>,
  // Shared, module-wide lowering state (interface-method dispatch ids).
  lowerer: Lowerer,
  // Pending deferred calls (their args already lowered at the `defer` site);
  // emitted in reverse (LIFO) at every function exit.
  defers: []IrInstr,
  // Fallible-function context (SPEC §18): the result's ok/err types when the
  // enclosing function returns `T!E`, else 0. `fail`/`?`/ok-return use these.
  fallibleOk: int,
  fallibleErr: int,
  // The enclosing function's declared result type, generic-substituted with a
  // fallible `T!` already unwrapped to `T`; 0 for a void function. Mirrors the
  // seed's `FnCtx.result_ty`. Two consumers:
  //   - `return a, b` boxes against this (ABI.md §1.1) rather than a tuple
  //     re-interned from the element expressions: an element may widen to its
  //     declared type, and the callee's promise is what callers destructure.
  //   - `lowerReturn` materializes the returned expression at it — `return 4.5`
  //     from an `f32!` otherwise lands at the untyped default f64 and the narrow
  //     return reads its zero low half (#1467).
  resultTy: int,
  // When lowering one monomorphization of a generic, that instantiation's
  // (type param -> concrete arg) bindings; empty otherwise. The body was checked
  // once against the template's unbound type params, so every body node's cached
  // type must pass through this to become concrete — see nodeType.
  genEnv: TypeEnv,
}

// A body node's CONCRETE type: what the checker recorded, with this
// instantiation's type-param bindings applied. Mirrors the seed's
// `FnCtx.nodeType` (`ctx.subst(checked.typeOf(node), gen_env, 0)`), and for the
// same reason — the checker types a generic body once, against unbound params,
// so its cached answer is `[]<T>` and only substitution makes it `[]i64`.
// Outside a generic instance genEnv is empty and this is exactly checkExprType.
//
// Lowering must never read checkExprType directly: a site that does silently
// keeps the template's type, which classifies as a GC reference and corrupts
// both the is_ref flag and the stack maps.
function nodeType(fc: FnCtx, node: int): int {
  return substType(fc.c.ctx, checkExprType(fc.c, node), fc.genEnv, 0)
}

// Module-wide lowering state shared across all functions (mutated as they lower
// in order). `methodIds` assigns each interface-method *name* a stable dispatch
// index on first encounter (the seed's methodId), so call_iface indices match.
// One method as the Pass A3' pre-pass discovers it, before the per-type tables
// are built and before any body is lowered.
struct MethodEntry {
  recvTy: int,
  // The method's RAW name. Its interface dispatch id is assigned from this, so
  // two modules' `area` methods share one id and one interface call site can
  // dispatch to either — the id is global, the symbol is not.
  name: string,
  // The declaring module's link prefix ("" for the root, else "m<id>$"). The
  // emitted symbol is prefix + name + "$t<recvType>"; keeping it separate from
  // `name` is what lets the dispatch id stay module-blind.
  prefix: string,
}

struct Lowerer {
  methodIds: map<string, int>,
  // Every method decl in declaration order — the seed's `l.method_table`. Filled
  // by `collectMethodEntries` (Pass A3') and turned into the per-type tables
  // before the first body is lowered, which is what makes the dispatch ids agree
  // with the seed's (#1471).
  methodEntries: []MethodEntry,
  // The module's string pool, interned here as each const_string is emitted so
  // __bitstr_N numbering follows lowering order (see IrModule.stringPool).
  stringPool: []string,
  // Inline-assembly payloads (§11.6), appended as each `asm` block is lowered;
  // referenced by an `Op.Asm`'s `ival`. Empty for programs with no `asm`.
  asmBlocks: []AsmBlock,
  // FuncId scheme for closures: the number of regular funcs (free + instances +
  // methods) reserved before any closure; synthesized func-value trampolines get
  // ids reservedCount, reservedCount+1, ... and their name embeds that id.
  reservedCount: int,
  closureFuncs: []IrFunc,
  // Function name -> its func-value trampoline's FuncId (deduped: one trampoline
  // per referenced function).
  fnValueTramps: map<string, int>,
  // Functions whose bodies could not be lowered and were emitted signature-only.
  // A stub RETURNS GARBAGE, so a build that produces one is not a build: `bit2
  // build` refuses rather than write a binary that silently computes the wrong
  // answer. The dump surfaces still render stubs — that is how the differential
  // marks a construct as not yet ported.
  stubbed: []string,
  // Module-level state (§11.11). `globals` is the emitted cell list; `globalSyms`
  // maps "<ownerModuleId>$<name>" to that cell's symbol, which is how a
  // reference site recognizes a module global (as opposed to a const or a
  // function) and finds its symbol without re-walking the owner's tree.
  globals: []IrGlobal,
  globalSyms: map<string, string>,
  // --- multi-module (#1345) -----------------------------------------------
  // The link prefix for the module currently being lowered: "" for the root,
  // else "m<id>$". Set before each module's pass; every emitted function name
  // goes through it.
  modPrefix: string,
  // The root module's id — the module being built. Its names stay bare so
  // `main` stays `main` and a single-module build is byte-identical to before.
  root: int,
  // The module currently being lowered, set beside `modPrefix` before each
  // pass. §17.6 tags every function `inRootModule: curModule == root` so a
  // freestanding emit can keep this module's own code and drop its imports'.
  // Kept as its own field rather than inferred from `modPrefix == ""`: that
  // equivalence is a coincidence of the naming scheme, not a statement about
  // ownership, and it would break silently if the prefix rule ever changed.
  curModule: int,
  // Named TypeId -> the module that DECLARES it. A method's symbol is prefixed
  // by its receiver type's module, not by whoever calls it: `s.area()` on an
  // imported `Shape` must reach `m2$area$t87` from any module. Filled before any
  // body is lowered, because a free function in Pass A can call a method whose
  // own decl is not walked until Pass A3.
  typeModule: map<int, int>,
}

// Interns a string literal into the module pool as it is emitted, so the pool's
// order is lowering order. const_string carries its pool index in `ival` (the
// text in `sval` is what the dump renders).
function internPoolString(fc: FnCtx, s: string): int {
  let i = 0
  while (i < len(fc.lowerer.stringPool)) {
    if (fc.lowerer.stringPool[i] == s) {
      return i
    }
    i = i + 1
  }
  fc.lowerer.stringPool = append(fc.lowerer.stringPool, s)
  return len(fc.lowerer.stringPool) - 1
}

// The dispatch index of an interface method name, assigned on first encounter.
function methodId(lw: Lowerer, name: string): int {
  for (k, v) of lw.methodIds {
    if (k == name) {
      return v
    }
  }
  let id = len(lw.methodIds)
  lw.methodIds[name] = id
  return id
}

// One enclosing loop's break/continue targets and its live-local count.
struct LoopFrame {
  exit: int,
  cont: int,
  preLen: int,
  // A switch frame is a `break` target but not a `continue` target — a
  // `continue` inside a switch reaches the enclosing loop, skipping switches.
  isSwitch: bool,
}

// Binds a name to a value id + type, appending to the ordered env.
function declareLocal(fc: FnCtx, name: string, value: int, ty: int) {
  fc.env = append(fc.env, LocalBind{ name: name, value: value, ty: ty })
}

// The current value id of a name (most recent binding wins), or -1 if unbound.
function envValue(fc: FnCtx, name: string): int {
  let i = len(fc.env) - 1
  while (i >= 0) {
    if (fc.env[i].name == name) {
      return fc.env[i].value
    }
    i = i - 1
  }
  return -1
}

// The current value ids of the first `n` env locals (a control-flow snapshot).
function snapshotValues(fc: FnCtx, n: int): []int {
  let vals = []int(0)
  let i = 0
  while (i < n) {
    vals = append(vals, fc.env[i].value)
    i = i + 1
  }
  return vals
}

// Restores the first `len(vals)` locals' value ids from a snapshot (after a
// branch that reassigned some of them).
function restoreValues(fc: FnCtx, vals: []int) {
  let i = 0
  while (i < len(vals)) {
    fc.env[i].value = vals[i]
    i = i + 1
  }
}

// At a reachable join, gives the current block one parameter per in-scope local
// (the first `n`) and rebinds each local to its new block-param value — the
// seed's addLoopParams. Params are added in env order.
function addJoinParams(fc: FnCtx, n: int) {
  let i = 0
  while (i < n) {
    fc.env[i].value = builderAddParam(fc.b, fc.env[i].ty)
    i = i + 1
  }
}

// The IR op for an arithmetic/bitwise binary operator, given whether its
// operands are floats and (for int div/rem/shr) signed. Returns Op.BlockParam
// as a "not lowerable yet" sentinel (never a real binary).
function binOpFor(op: int, isFloat: bool, signed: bool): Op {
  if (op == int(Kind.Plus)) {
    if (isFloat) {
      return Op.FAdd
    }
    return Op.Add
  }
  if (op == int(Kind.Minus)) {
    if (isFloat) {
      return Op.FSub
    }
    return Op.Sub
  }
  if (op == int(Kind.Star)) {
    if (isFloat) {
      return Op.FMul
    }
    return Op.Mul
  }
  if (op == int(Kind.Slash)) {
    if (isFloat) {
      return Op.FDiv
    }
    if (signed) {
      return Op.SDiv
    }
    return Op.UDiv
  }
  if (op == int(Kind.Percent)) {
    if (signed) {
      return Op.SRem
    }
    return Op.URem
  }
  if (op == int(Kind.Amp)) {
    return Op.BAnd
  }
  if (op == int(Kind.Pipe)) {
    return Op.BOr
  }
  if (op == int(Kind.Caret)) {
    return Op.BXor
  }
  if (op == int(Kind.Shl)) {
    return Op.Shl
  }
  if (op == int(Kind.Shr)) {
    if (signed) {
      return Op.AShr
    }
    return Op.LShr
  }
  return Op.BlockParam
}

// Whether an operator kind is a relational/equality comparison (not a logical
// `&&`/`||`, which needs short-circuit block lowering).
function isRelationalOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq) || op == int(Kind.Lt) ||
    op == int(Kind.Gt) || op == int(Kind.LtEq) || op == int(Kind.GtEq)
}

// The IR compare op for a relational operator over ints (signed/unsigned by
// `signed`) or floats. Returns Op.BlockParam as a not-yet-lowerable sentinel.
function cmpOpFor(op: int, isFloat: bool, signed: bool): Op {
  if (op == int(Kind.EqEq)) {
    if (isFloat) {
      return Op.FCmpEq
    }
    return Op.ICmpEq
  }
  if (op == int(Kind.BangEq)) {
    if (isFloat) {
      return Op.FCmpNe
    }
    return Op.ICmpNe
  }
  if (op == int(Kind.Lt)) {
    if (isFloat) {
      return Op.FCmpLt
    }
    if (signed) {
      return Op.ICmpSlt
    }
    return Op.ICmpUlt
  }
  if (op == int(Kind.LtEq)) {
    if (isFloat) {
      return Op.FCmpLe
    }
    if (signed) {
      return Op.ICmpSle
    }
    return Op.ICmpUle
  }
  if (op == int(Kind.Gt)) {
    if (isFloat) {
      return Op.FCmpGt
    }
    if (signed) {
      return Op.ICmpSgt
    }
    return Op.ICmpUgt
  }
  if (op == int(Kind.GtEq)) {
    if (isFloat) {
      return Op.FCmpGe
    }
    if (signed) {
      return Op.ICmpSge
    }
    return Op.ICmpUge
  }
  return Op.BlockParam
}

// The value of a hex digit, or -1.
function hexDigitVal(c: byte): int {
  if (c >= '0' && c <= '9') {
    return int(c) - int('0')
  }
  if (c >= 'a' && c <= 'f') {
    return int(c) - int('a') + 10
  }
  if (c >= 'A' && c <= 'F') {
    return int(c) - int('A') + 10
  }
  return -1
}

// Appends `cp` to `s` as UTF-8 — the seed's std.unicode.utf8Encode. A codepoint
// above U+10FFFF, or a surrogate (U+D800..U+DFFF, which UTF-8 must not encode),
// is rejected: the caller stops decoding, matching the seed's `catch break`.
function utf8Append(s: string, cp: int): string {
  if (cp < 0x80) {
    return s + string([u8(cp)])
  }
  if (cp < 0x800) {
    return s + string([u8(0xC0 | cp >> 6), u8(0x80 | cp & 0x3F)])
  }
  if (cp < 0x10000) {
    return s + string([u8(0xE0 | cp >> 12), u8(0x80 | cp >> 6 & 0x3F), u8(0x80 | cp & 0x3F)])
  }
  return s + string([u8(0xF0 | cp >> 18), u8(0x80 | cp >> 12 & 0x3F),
    u8(0x80 | cp >> 6 & 0x3F), u8(0x80 | cp & 0x3F)])
}

// Whether `cp` is encodable as UTF-8: in range, and not a UTF-16 surrogate half.
function isEncodableCodepoint(cp: int): bool {
  return cp >= 0 && cp <= 0x10FFFF && !(cp >= 0xD800 && cp <= 0xDFFF)
}

// Decodes the escape sequences in a content range [cstart, cend), matching the
// seed's unescapeInner: `n t r 0`, the literal `\\ " ' $`, `\xNN` (one byte) and
// `\u{...}` (a codepoint, UTF-8 encoded). A malformed escape stops the decode
// where the seed's `catch break` does, so both compilers produce the same bytes.
function decodeEscapes(src: string, cstart: int, cend: int): string {
  let s = ""
  let i = cstart
  while (i < cend) {
    let c = src[i]
    if (c != '\\') {
      s = s + src[i:i + 1]
      i = i + 1
      continue
    }
    i = i + 1
    if (i >= cend) {
      break
    }
    let e = src[i]
    i = i + 1
    if (e == 'n') {
      s = s + "\n"
    } else if (e == 't') {
      s = s + "\t"
    } else if (e == 'r') {
      s = s + "\r"
    } else if (e == '0') {
      s = s + "\0"
    } else if (e == 'x') {
      // `\xNN`: exactly two hex digits, one raw byte — no UTF-8 encoding, so
      // `"\xff"` is one 0xFF byte and NOT the two bytes of U+00FF.
      if (i + 2 > cend) {
        return s
      }
      let hi = hexDigitVal(src[i])
      let lo = hexDigitVal(src[i + 1])
      if (hi < 0 || lo < 0) {
        return s
      }
      s = s + string([u8(hi * 16 + lo)])
      i = i + 2
    } else if (e == 'u') {
      // `\u{...}`: hex digits to the closing brace, encoded as UTF-8.
      if (i >= cend || src[i] != '{') {
        return s
      }
      i = i + 1
      let cp = 0
      let digits = 0
      while (i < cend && src[i] != '}') {
        let d = hexDigitVal(src[i])
        if (d < 0) {
          return s
        }
        // Bounded: past U+10FFFF nothing is encodable, so stop rather than
        // overflow on a long digit run.
        if (cp > 0x10FFFF) {
          return s
        }
        cp = cp * 16 + d
        digits = digits + 1
        i = i + 1
      }
      if (digits == 0 || !isEncodableCodepoint(cp)) {
        return s
      }
      if (i < cend) {
        i = i + 1 // consume '}'
      }
      s = utf8Append(s, cp)
    } else {
      s = s + src[i - 1:i]
    }
  }
  return s
}

function decodeStringContent(src: string, start: int, endPos: int): string {
  return decodeEscapes(src, start + 1, endPos - 1)
}

// A raw string's only transformation: a CRLF pair becomes a lone LF, so a file
// with Windows line endings yields the same value as one without. Every other
// byte, backslash included, is literal. Mirrors seed lower.zig `normalizeRaw`.
function normalizeRawString(s: string): string {
  let out = ""
  let i = 0
  while (i < len(s)) {
    if (s[i] == 13 && i + 1 < len(s) && s[i + 1] == 10) {
      out = out + "\n"
      i = i + 2
    } else {
      out = out + s[i:i + 1]
      i = i + 1
    }
  }
  return out
}

// Lowers a call's argument expressions in order (unwrapping each `arg` node).
// Each arg takes the callee's matching parameter type as its context hint (so
// an untyped literal argument materializes at the parameter's width); an empty
// `paramTypes` gives no hints.
function lowerArgs(fc: FnCtx, node: int, paramTypes: []int): []int {
  return lowerArgsRest(fc, node, paramTypes, -1, 0)
}

// The declared parameter types of `recvTy`'s `mname` method, for `lowerArgs` to
// hint with; empty when the signature is not recorded. A method's arguments need
// the same materialization hint a free function's do — without it an untyped
// literal lands at its default type and a narrower parameter reads the wrong
// half of it, so `obj.take(4.5)` handed an f32 parameter an f64 (#1467).
function methodParamTypes(fc: FnCtx, recvTy: int, mname: string): []int {
  let fnTy = methodSigLookup(fc.c, "${recvTy}.${mname}")
  if (fnTy == 0) {
    return []int(0)
  }
  return fc.c.ctx.types[fnTy].members
}

// `lowerArgs` plus §10.3 variadic collection: the arguments from index `fixed`
// onward are gathered into ONE `[]elemTy` value, because that single slice is
// what the callee binds. Passing them as separate scalars instead leaves the
// callee reading a slice header off an integer — an immediate segfault, not a
// wrong answer. `fixed < 0` means the callee is not variadic and every argument
// keeps its own slot, which is what plain `lowerArgs` asks for.
function lowerArgsRest(fc: FnCtx, node: int, paramTypes: []int, fixed: int, elemTy: int): []int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let vals = []int(0)
  let stop = len(args)
  if (fixed >= 0 && fixed < stop) {
    stop = fixed
  }
  let i = 0
  while (i < stop && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let hint = 0
    if (i < len(paramTypes)) {
      hint = paramTypes[i]
    }
    // An array argument from a location is copied (value semantics).
    vals = append(vals, arrayValueForBind(fc, a, lowerExprH(fc, a, hint), defaultType(fc.c, nodeType(fc, a))))
    i = i + 1
  }
  if (fixed < 0 || fc.failed) {
    return vals
  }
  return append(vals, lowerVariadicTail(fc, elemTy, args[stop:len(args)]))
}

// `lowerArgs` for a call to `decl`, collecting the tail when that signature is
// variadic. `paramTypes` is supplied by the caller rather than derived here
// because a generic call substitutes its type params first.
function lowerArgsFor(fc: FnCtx, node: int, oc: Checker, decl: int, paramTypes: []int): []int {
  // An extern decl has no kid 3 and cannot be variadic (E0077).
  if (len(paramTypes) == 0 || isExternDecl(oc.tree, decl)) {
    return lowerArgs(fc, node, paramTypes)
  }
  if (!paramsAreVariadic(oc, kidsOf(oc.tree, decl)[3])) {
    return lowerArgs(fc, node, paramTypes)
  }
  let fixed = len(paramTypes) - 1
  return lowerArgsRest(fc, node, paramTypes, fixed, paramTypes[fixed])
}

// Materializes a variadic call's trailing arguments as the single `[]T` value
// the callee binds (§10.3). A lone `...s` spread (§12.4) forwards `s` itself
// rather than rebuilding it, which is what makes the pass-through form
// aliasing-free. The checker restricts `...` to the final argument (E0063), so
// a spread anywhere else in the tail means the tree disagrees with what was
// checked — refuse rather than emit something plausible.
function lowerVariadicTail(fc: FnCtx, elemTy: int, items: []int): int {
  let sliceTy = mkSlice(fc.c.ctx, elemTy)
  if (len(items) == 1 && getNode(fc.c.tree, items[0]).tag == Tag.ArgSpread) {
    return lowerExprH(fc, kidsOf(fc.c.tree, items[0])[0], sliceTy)
  }
  let i = 0
  while (i < len(items)) {
    if (getNode(fc.c.tree, items[i]).tag == Tag.ArgSpread) {
      fc.failed = true
      return 0
    }
    i = i + 1
  }
  return lowerSliceElems(fc, sliceTy, items)
}

// The integer word type a float of type `ty` crosses the container word ABI as,
// or -1 when `ty` is not a float. `f32` uses `u32` so the bitcast on each side
// is a 32-bit transfer — the stored word is zero-extended, so the round trip is
// exact.
function wordIntTy(fc: FnCtx, ty: int): int {
  let d = fc.c.ctx.types[ty]
  if (d.kind != TypeKind.Prim) {
    return -1
  }
  if (d.prim == 9) {
    return primType(fc.c.ctx, 7)
  }
  if (d.prim == 8) {
    return primType(fc.c.ctx, 6)
  }
  return -1
}

// The single lowering entry point for every `rt_call`. The container primitives
// declare their element operands and results as an untyped `u64` word
// (ir.bit's `rtWordArgs`/`rtReturnsWord`), so a float element must cross that
// boundary as its bit pattern, in an integer register. Emitting the bitcasts
// here — rather than letting codegen classify the operand by its Bit type —
// keeps the IR honest about the callee's actual C signature and fixes every
// backend at once. A non-word position, and any non-float type, passes through.
function emitRtCall(fc: FnCtx, ins: IrInstr): int {
  let mask = rtWordArgs(ins.name)
  if (mask != 0) {
    let cast = []int(0)
    let i = 0
    for a of ins.args {
      let bit = mask / pow2(i) % 2
      let wt = -1
      if (bit == 1) {
        wt = wordIntTy(fc, fc.b.instrs[a].ty)
      }
      if (wt < 0) {
        cast = append(cast, a)
      } else {
        let bc = mkInstr(Op.Bitcast, wt)
        bc.lhs = a
        cast = append(cast, builderEmit(fc.b, bc))
      }
      i = i + 1
    }
    ins.args = cast
  }
  if (rtReturnsWord(ins.name)) {
    let rt = wordIntTy(fc, ins.ty)
    if (rt >= 0) {
      let resTy = ins.ty
      ins.ty = rt
      let word = builderEmit(fc.b, ins)
      let bc = mkInstr(Op.Bitcast, resTy)
      bc.lhs = word
      return builderEmit(fc.b, bc)
    }
  }
  return builderEmit(fc.b, ins)
}

// 2^n for the small, statically bounded `n` the word-argument mask needs.
function pow2(n: int): int {
  let v = 1
  let i = 0
  for (; i < n; i = i + 1) {
    v = v * 2
  }
  return v
}

// Lowers `len(x)` / `cap(x)`: an array is its static length (const_int, len==cap),
// a slice's `len` is `slice_len` and its `cap` is `field_get [24]` (the header's
// cap word), a string/map `len` is `slice_len`/`rt_call map_len`. `cap` is
// slice/array-only — the checker rejects it elsewhere.
function lowerLen(fc: FnCtx, node: int, isCap: bool): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a = args[0]
  if (getNode(fc.c.tree, a).tag == Tag.Arg) {
    a = kidsOf(fc.c.tree, a)[0]
  }
  let argTy = defaultType(fc.c, nodeType(fc, a))
  let td = fc.c.ctx.types[argTy]
  let i64ty = primType(fc.c.ctx, 3)
  // A fixed-size array's length is static; the argument is not evaluated.
  if (td.kind == TypeKind.Array) {
    let ins = mkInstr(Op.ConstInt, i64ty)
    ins.ival = td.arrayLen
    return builderEmit(fc.b, ins)
  }
  let v = lowerExpr(fc, a)
  if (fc.failed) {
    return 0
  }
  if (td.kind == TypeKind.Slice) {
    if (isCap) {
      let ci = mkInstr(Op.FieldGet, i64ty)
      ci.lhs = v
      ci.ival = 24
      return builderEmit(fc.b, ci)
    }
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Prim && td.prim == 11) {
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, i64ty)
    ins.name = "map_len"
    ins.args = [v]
    return emitRtCall(fc, ins)
  }
  fc.failed = true
  return 0
}

// Lowers `append(s, e1, e2, ...)`: folds each element through `slice_append`,
// threading the returned (possibly regrown) header so a `s = append(s, ...)`
// observes the new length. Each element lowers with the slice's element hint.
function lowerAppend(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a0 = args[0]
  if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
    a0 = kidsOf(fc.c.tree, a0)[0]
  }
  let sliceTy = defaultType(fc.c, nodeType(fc, a0))
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let acc = lowerExpr(fc, a0)
  if (fc.failed) {
    return 0
  }
  let i = 1
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, sliceTy)
    ins.name = "slice_append"
    ins.args = [acc, v]
    acc = emitRtCall(fc, ins)
    i = i + 1
  }
  return acc
}

// `atomicAdd`/`atomicSub`/`atomicAnd`/`atomicOr`/`atomicXchg` -> its IR op.
function atomicRmwOpFor(name: string): Op {
  if (name == "atomicAdd") { return Op.AtomicRmwAdd }
  if (name == "atomicSub") { return Op.AtomicRmwSub }
  if (name == "atomicAnd") { return Op.AtomicRmwAnd }
  if (name == "atomicOr") { return Op.AtomicRmwOr }
  return Op.AtomicRmwXchg
}

// Lowers an atomic builtin (§11.5) to its dedicated inline IR op. The element
// type `T` is read off the `*T` argument; every value argument is lowered with
// `T` as its hint.
function lowerAtomic(fc: FnCtx, node: int, name: string): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let pn = args[0]
  if (getNode(fc.c.tree, pn).tag == Tag.Arg) {
    pn = kidsOf(fc.c.tree, pn)[0]
  }
  let elem = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, pn))].elem
  let ptr = lowerExpr(fc, pn)
  if (fc.failed) {
    return 0
  }
  if (name == "atomicLoad") {
    let ins = mkInstr(Op.AtomicLoad, elem)
    ins.lhs = ptr
    return builderEmit(fc.b, ins)
  }
  let a1 = args[1]
  if (getNode(fc.c.tree, a1).tag == Tag.Arg) {
    a1 = kidsOf(fc.c.tree, a1)[0]
  }
  let v1 = lowerExprH(fc, a1, elem)
  if (fc.failed) {
    return 0
  }
  if (name == "atomicStore") {
    let ins = mkInstr(Op.AtomicStore, fc.c.ctx.voidId)
    ins.lhs = ptr
    ins.rhs = v1
    return builderEmit(fc.b, ins)
  }
  if (name == "atomicCmpxchg") {
    let a2 = args[2]
    if (getNode(fc.c.tree, a2).tag == Tag.Arg) {
      a2 = kidsOf(fc.c.tree, a2)[0]
    }
    let v2 = lowerExprH(fc, a2, elem)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.AtomicCmpxchg, primType(fc.c.ctx, 10))
    ins.lhs = ptr
    ins.rhs = v1
    ins.ival = v2
    return builderEmit(fc.b, ins)
  }
  let ins = mkInstr(atomicRmwOpFor(name), elem)
  ins.lhs = ptr
  ins.rhs = v1
  return builderEmit(fc.b, ins)
}

// `ptrOf(s)` (§11.5): the byte address of `s`'s element 0, as a `*T`. The slice
// header is `{buf@0, len@8, off@16, cap@24, is_ref@32}` and each element is one
// 8-byte word, so element 0 sits at `buf + off*8`. The trailing `convert`
// retypes the address word from `i64` to `*T` (both are one int word).
// `entryOf(f)` (§11.10): `f`'s code address as a `*byte`, via the FuncAddr op —
// the same one `spawn` uses for its trampoline, so the relocation and every
// backend's emission of it are untouched and were already exercised on all three
// targets. `callQualified` supplies the emitted symbol name, exactly as a direct
// call does, so a pinned (§11.9) or imported callee is spelled the one way.
//
// validate.bit has already proved the operand is a direct reference to a
// non-generic, non-extern function declaration; `fc.failed` mirrors the seed's
// `UnsupportedConstruct` for the case that cannot legitimately arise, rather than
// emitting a relocation against a name nothing defines.
function lowerEntryOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let fn = args[0]
  if (getNode(fc.c.tree, fn).tag == Tag.Arg) {
    fn = kidsOf(fc.c.tree, fn)[0]
  }
  if (getNode(fc.c.tree, fn).tag != Tag.Ident) {
    fc.failed = true
    return 0
  }
  let fnNode = getNode(fc.c.tree, fn)
  let name = fc.c.source[fnNode.span.start:fnNode.span.end]
  if (funcDeclLookup(fc.c, name) == 0) {
    fc.failed = true
    return 0
  }
  let fa = mkInstr(Op.FuncAddr, nodeType(fc, node))
  fa.name = callQualified(fc.c, fc.lowerer.root, name)
  return builderEmit(fc.b, fa)
}

function lowerPtrOf(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let sn = args[0]
  if (getNode(fc.c.tree, sn).tag == Tag.Arg) {
    sn = kidsOf(fc.c.tree, sn)[0]
  }
  // Module-level state (§11.11) has a static address: GlobalAddr IS the answer,
  // with no slice header to walk.
  let pn = getNode(fc.c.tree, sn)
  if (pn.tag == Tag.Ident) {
    let psym = moduleGlobalSym(fc, fc.c.source[pn.span.start:pn.span.end])
    if (psym != "") {
      let cv = mkInstr(Op.Convert, nodeType(fc, node))
      cv.lhs = emitGlobalAddrVal(fc, psym)
      return builderEmit(fc.b, cv)
    }
  }
  let s = lowerExpr(fc, sn)
  if (fc.failed) {
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let bufIns = mkInstr(Op.FieldGet, i64ty)
  bufIns.lhs = s
  bufIns.ival = 0
  let buf = builderEmit(fc.b, bufIns)
  let offIns = mkInstr(Op.FieldGet, i64ty)
  offIns.lhs = s
  offIns.ival = 16
  let off = builderEmit(fc.b, offIns)
  let eightIns = mkInstr(Op.ConstInt, i64ty)
  eightIns.ival = 8
  let eight = builderEmit(fc.b, eightIns)
  let mulIns = mkInstr(Op.Mul, i64ty)
  mulIns.lhs = off
  mulIns.rhs = eight
  let byteoff = builderEmit(fc.b, mulIns)
  let addIns = mkInstr(Op.Add, i64ty)
  addIns.lhs = buf
  addIns.rhs = byteoff
  let addr = builderEmit(fc.b, addIns)
  let cvt = mkInstr(Op.Convert, nodeType(fc, node))
  cvt.lhs = addr
  return builderEmit(fc.b, cvt)
}

// Lowers a call: `print(x)` -> `rt_call print`, a direct call to a top-level
// function -> `call @name(args) result`. Other callees trip `failed`.
// Lowers a type conversion `T(x)`: a no-op if the source already has the target
// type; `string([]byte)` via `rt_call string_from_bytes`; otherwise the numeric
// `convert` op.
function lowerConvert(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let arg = args[0]
  if (getNode(fc.c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(fc.c.tree, arg)[0]
  }
  let dstTy = defaultType(fc.c, nodeType(fc, node))
  let srcTy = defaultType(fc.c, nodeType(fc, arg))
  let src = lowerExprH(fc, arg, srcTy)
  if (fc.failed) {
    return 0
  }
  if (srcTy == dstTy) {
    return src
  }
  let dd = fc.c.ctx.types[dstTy]
  if (dd.kind == TypeKind.Prim && dd.prim == 11 && fc.c.ctx.types[srcTy].kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, dstTy)
    ins.name = "string_from_bytes"
    ins.args = [src]
    return emitRtCall(fc, ins)
  }
  let ins = mkInstr(Op.Convert, dstTy)
  ins.lhs = src
  return builderEmit(fc.b, ins)
}

// Maps a runtime-primitive builtin name to its `rt_call` name, or "" for a
// non-primitive. Mirrors compiler/lower.zig's `prim_rt_fns` (the fs §14 / net §20
// / math §17 / time §18 / os §19 / crypto §21 surface); each lowers 1:1 to a
// runtime call whose result the checker already typed in `builtinResultType`.
// Maps a builtin name to the inline unary IR op that implements it, or
// `Op.BlockParam` (never a unary op, so it reads as "none") when the name is
// not one of these. These deliberately do NOT appear in `primRtName`: they are
// one hardware instruction on every backend, so they lower to an op — which is
// also what makes them pure and safepoint-free, and therefore usable inside
// `@nosplit`.
//
// `ffloor`/`fceil`/`ftrunc`/`fround` are here too, though they are one
// instruction only on AArch64 (`frintm`/`frintp`/`frintz`/`frinta`): the
// x86-64 form is `roundsd`, which is SSE4.1, and this backend emits nothing
// above SSE2. `x64.bit` expands them into a short SSE2 sequence rather than
// raising the baseline of every binary the compiler produces. An expansion is
// still not a call — no allocation, no safepoint — so the property that admits
// these inside `@nosplit` is unaffected.
function primUnaryOp(name: string): Op {
  if (name == "fsqrt") { return Op.FSqrt }
  if (name == "floatBits") { return Op.Bitcast }
  if (name == "float32Bits") { return Op.Bitcast }
  if (name == "ffloor") { return Op.FFloor }
  if (name == "fceil") { return Op.FCeil }
  if (name == "ftrunc") { return Op.FTrunc }
  if (name == "fround") { return Op.FRound }
  return Op.BlockParam
}

function primRtName(name: string): string {
  if (name == "fsOpen") { return "fs_open" }
  if (name == "fsReadAll") { return "fs_read_all" }
  if (name == "fsWrite") { return "fs_write" }
  if (name == "fsClose") { return "fs_close" }
  if (name == "fsAppend") { return "fs_append" }
  if (name == "fsRead") { return "fs_read" }
  if (name == "fsExists") { return "fs_exists" }
  if (name == "fsIsDir") { return "fs_is_dir" }
  if (name == "fsMkdir") { return "fs_mkdir" }
  if (name == "fsRemove") { return "fs_remove" }
  if (name == "fsListDir") { return "fs_list_dir" }
  if (name == "netListen") { return "net_listen" }
  if (name == "netLocalPort") { return "net_local_port" }
  if (name == "netAccept") { return "net_accept" }
  if (name == "netDial") { return "net_dial" }
  if (name == "netRead") { return "net_read" }
  if (name == "netWrite") { return "net_write" }
  if (name == "netUdpBind") { return "net_udp_bind" }
  if (name == "netUdpSend") { return "net_udp_send" }
  if (name == "netUdpRecv") { return "net_udp_recv" }
  if (name == "netUdpSenderHost") { return "net_udp_sender_host" }
  if (name == "netUdpSenderPort") { return "net_udp_sender_port" }
  if (name == "netResolve") { return "net_resolve" }
  if (name == "fpow") { return "pow" }
  if (name == "fatan2") { return "atan2" }
  if (name == "flog") { return "log" }
  if (name == "flog2") { return "log2" }
  if (name == "flog10") { return "log10" }
  if (name == "timeMonoNs") { return "time_mono_ns" }
  if (name == "timeUnixNs") { return "time_unix_ns" }
  if (name == "timeSleepNs") { return "time_sleep_ns" }
  if (name == "osArgc") { return "os_argc" }
  if (name == "osArgAt") { return "os_arg_at" }
  if (name == "osEnv") { return "os_env" }
  if (name == "osSelfExe") { return "os_self_exe" }
  if (name == "osExit") { return "os_exit" }
  if (name == "cryptoRandomBytes") { return "random_bytes" }
  if (name == "cryptoSecureZero") { return "secure_zero" }
  if (name == "fsChmod") { return "fs_chmod" }
  if (name == "osRun") { return "os_run" }
  if (name == "osRunTest") { return "os_run_test" }
  if (name == "hostTarget") { return "host_target" }
  if (name == "auxv") { return "auxv" }
  if (name == "parseFloat") { return "parse_float" }
  return ""
}

// A directly-named callee, fully resolved: the symbol the linker will see, the
// parameter types an argument list must be built against, and the IR result type.
struct CallTarget {
  ok: bool,
  symbol: string,
  paramTypes: []int,
  result: int,
  owner: Checker,
  decl: int,
}

// Resolves the callee of `callNode` (a Tag.Call whose callee is a Tag.Ident) to
// the symbol and signature to emit. `call`, `spawn` and `defer` ALL go through
// here — the seed's shape (seed/lower.zig `resolveCallTarget`), and the reason
// they cannot drift apart again. Deriving a name from the callee's source span
// instead skips BOTH generic instantiation (`g` where `g$0` was emitted) and
// module qualification (`work` where the definition is `m1$work`), producing an
// object with a dangling reference that only fails at dyld load.
function resolveCallTarget(fc: FnCtx, name: string, callNode: int): CallTarget {
  let none = CallTarget{ ok: false, symbol: "", paramTypes: []int(0), result: 0, owner: fc.c, decl: 0 }
  let decl = funcDeclLookup(fc.c, name)
  if (decl == 0) {
    return none
  }
  // An imported callee's decl lives in ITS module's tree — `decl` indexes that
  // arena, so every read of it must go through the owning checker.
  let oc = declOwner(fc.c, name)
  if (isGenericFunc(fc.c, name)) {
    // The instance is numbered in the project-wide ledger and emitted by the
    // module that DECLARES the generic, so its symbol carries that module's
    // prefix and its original name — identical from every caller.
    let targs = genericTypeArgs(fc.c, name, callNode)
    let idx = instantiationIndex(fc.c, name, targs)
    if (idx == -1) {
      return none
    }
    // SUBSTITUTED parameter types, never the template's. The template's `T` is a
    // non-primitive and so classifies as a GC reference: an argument list built
    // from it packs an `i64` into a slot the collector then walks as a pointer.
    return CallTarget{ ok: true,
      symbol: "${modulePrefix(oc.moduleId, fc.lowerer.root)}${declName2(fc.c, name)}\$${idx}",
      paramTypes: genericParamTypes(oc, decl, targs),
      result: unwrapFallible(fc.c, defaultType(fc.c, nodeType(fc, callNode))),
      owner: oc, decl: decl }
  }
  // A fallible callee's IR result is its ok type (the error rides the slot).
  return CallTarget{ ok: true,
    symbol: callQualified(fc.c, fc.lowerer.root, name),
    paramTypes: lowerParamTypes(oc, decl),
    result: unwrapFallible(fc.c, funcResultLookup(fc.c, name)),
    owner: oc, decl: decl }
}

function lowerCall(fc: FnCtx, node: int): int {
  let callee = kidsOf(fc.c.tree, node)[0]
  let cn = getNode(fc.c.tree, callee)
  if (cn.tag == Tag.Ident) {
    let name = fc.c.source[cn.span.start:cn.span.end]
    // PRECEDENCE: local binding > user declaration > builtin (§17.5), which is
    // what the seed gets for free by resolving the callee to a SYMBOL
    // (`env.lookup`/`nodeSymbol`) instead of matching its source text. Matching
    // text put the whole ~70-name `predeclaredFuncs()` list ahead of the user's
    // own declarations, so a program declaring any of those names — including an
    // `extern function close` — silently got the builtin instead of its own
    // function. Almost all of it failed quietly: a user `timeMonoNs` returned the
    // real clock, `fsClose` returned 0. These two paths must therefore stay ABOVE
    // the builtin block below, and in this order.
    // A local/param of function type called directly (`f(x)`) dispatches through
    // the closure via `call_value`.
    let lvi = envIndex(fc, name)
    if (lvi != -1 && fc.c.ctx.types[fc.env[lvi].ty].kind == TypeKind.Func) {
      let members = fc.c.ctx.types[fc.env[lvi].ty].members
      let vfixed = -1
      let velem = 0
      if (fc.c.ctx.types[fc.env[lvi].ty].variadic && len(members) > 0) {
        vfixed = len(members) - 1
        velem = members[vfixed]
      }
      let a = lowerArgsRest(fc, node, members, vfixed, velem)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.CallValue, unwrapFallible(fc.c, nodeType(fc, node)))
      ins.lhs = fc.env[lvi].value
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    if (funcDeclLookup(fc.c, name) != 0) {
      let t = resolveCallTarget(fc, name, node)
      if (!t.ok) {
        fc.failed = true
        return 0
      }
      // Hint each argument with the CONCRETE parameter type this call binds.
      let a = lowerArgsFor(fc, node, t.owner, t.decl, t.paramTypes)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.Call, t.result)
      ins.name = t.symbol
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    // `print` (fd 1) and `eprint` (fd 2): one string arg, void, distinct rt
    // primitives (ABI.md §12).
    if (name == "print" || name == "eprint") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed || len(a) != 1) {
        fc.failed = true
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = name
      ins.args = a
      return emitRtCall(fc, ins)
    }
    if (name == "panic") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed || len(a) != 1) {
        fc.failed = true
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "panic"
      ins.args = a
      let r = emitRtCall(fc, ins)
      // panic never returns: the block ends with unreachable.
      builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
      fc.terminated = true
      return r
    }
    if (name == "assert") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      // The runtime assert has a frozen 2-arg signature (ABI.md §12); a 1-arg
      // source form supplies the default message.
      if (len(a) == 1) {
        let cs = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
        cs.sval = "assertion failed"
        cs.ival = internPoolString(fc, cs.sval)
        a = append(a, builderEmit(fc.b, cs))
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "assert"
      ins.args = a
      return emitRtCall(fc, ins)
    }
    if (name == "len" || name == "cap") {
      return lowerLen(fc, node, name == "cap")
    }
    if (name == "append") {
      return lowerAppend(fc, node)
    }
    if (name == "delete") {
      let a0 = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])[0]
      if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
        a0 = kidsOf(fc.c.tree, a0)[0]
      }
      let keyTy = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, a0))].mapKey
      let a = lowerArgs(fc, node, [0, keyTy])
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "map_delete"
      ins.args = a
      return emitRtCall(fc, ins)
    }
    if (name == "close") {
      let ca = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])[0]
      if (getNode(fc.c.tree, ca).tag == Tag.Arg) {
        ca = kidsOf(fc.c.tree, ca)[0]
      }
      let cv = lowerExpr(fc, ca)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "chan_close"
      ins.args = [cv]
      return emitRtCall(fc, ins)
    }
    // Atomics (§11.5): dedicated inline IR ops on a raw `*T` (never an rt_call).
    if (name == "atomicLoad" || name == "atomicStore" || name == "atomicCmpxchg" ||
      name == "atomicAdd" || name == "atomicSub" || name == "atomicAnd" ||
      name == "atomicOr" || name == "atomicXchg") {
      return lowerAtomic(fc, node, name)
    }
    // `ptrOf(s)`: the address of a slice's element 0, as a `*T`.
    if (name == "ptrOf") {
      return lowerPtrOf(fc, node)
    }
    // `entryOf(f)` (§11.10): `f`'s code address, through the SAME FuncAddr op
    // `spawn` already uses for its trampoline — a source spelling for an existing
    // mechanism, not a new one. validate.bit has already proved the operand names
    // a non-generic, non-extern function declaration.
    if (name == "entryOf") {
      return lowerEntryOf(fc, node)
    }
    // `syscall` (§11.8) is the one builtin with no `bit_rt_*` symbol behind it —
    // the backends emit the kernel trap inline — so it takes its own IR op and
    // deliberately never reaches the `primRtName` path below.
    if (name == "syscall") {
      // Unhinted deliberately: `syscall` is variadic over i64 words, which is
      // exactly what an untyped int literal already defaults to.
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.Syscall, primType(fc.c.ctx, 3))
      ins.lhs = a[0]
      ins.args = a[1:len(a)]
      return builderEmit(fc.b, ins)
    }
    // Primitives that ARE a machine instruction rather than a runtime call
    // (mirrors compiler/lower.zig's `prim_unary_ops`). Checked before
    // `primRtName` and single-operand by construction. An `rt_call` here would
    // make the matching `bit_rt_*` unimplementable in Bit — its body would
    // compile to a call to itself (tests/rootpins.zig).
    let uop = primUnaryOp(name)
    if (uop != Op.BlockParam) {
      // Hinted by the primitive's declared signature: `float32Bits(4.5)` must
      // materialize its literal as f32, not at the untyped default f64 (#1467).
      let ua = lowerArgs(fc, node, builtinParamTypes(fc.c, name))
      if (fc.failed) {
        return 0
      }
      let uins = mkInstr(uop, nodeType(fc, node))
      uins.lhs = ua[0]
      return builderEmit(fc.b, uins)
    }
    // A runtime-primitive builtin lowers 1:1 to its `rt_call`, result already
    // typed by the checker.
    let rt = primRtName(name)
    if (rt != "") {
      let a = lowerArgs(fc, node, builtinParamTypes(fc.c, name))
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, nodeType(fc, node))
      ins.name = rt
      ins.args = a
      return emitRtCall(fc, ins)
    }
    // A primitive-named callee is a type conversion `T(x)`.
    if (primIndexByName(name) >= 0) {
      return lowerConvert(fc, node)
    }
  }
  // A slice-type callee is a length-sized allocation `[]E(n)`: `slice_new(n, n,
  // is_ref)`. Cap equals len (the single length arg reused).
  if (cn.tag == Tag.SliceType) {
    return lowerSliceAlloc(fc, node)
  }
  // A map-type callee is an empty-map construction `map<K,V>()`.
  if (cn.tag == Tag.MapType) {
    return lowerMapMake(fc, nodeType(fc, node))
  }
  // A chan-type callee is a channel construction `chan<T>(n)`.
  if (cn.tag == Tag.ChanType) {
    return lowerChanMake(fc, node)
  }
  // `ns.fn(...)` — a direct call to a namespaced module's exported function. The
  // dotted key resolves to the same CallTarget a plain import of that symbol
  // would, so generic instantiation and module qualification are unchanged.
  if (cn.tag == Tag.Member) {
    let qn = nsQualifiedName(fc.c, callee)
    if (qn != "" && funcDeclLookup(fc.c, qn) != 0) {
      let t = resolveCallTarget(fc, qn, node)
      if (!t.ok) {
        fc.failed = true
        return 0
      }
      let a = lowerArgsFor(fc, node, t.owner, t.decl, t.paramTypes)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.Call, t.result)
      ins.name = t.symbol
      ins.args = a
      return builderEmit(fc.b, ins)
    }
  }
  // A call whose callee is `Enum.Variant` constructs a payload-carrying variant.
  if (cn.tag == Tag.Member) {
    let mk0 = kidsOf(fc.c.tree, callee)
    let baseName = typeNodeName(fc.c, mk0[0])
    if (baseName != "") {
      let ut = userTypeLookup(fc.c, baseName)
      if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
        return lowerVariantConstruction(fc, node)
      }
    }
  }
  // A method call `recv.method(...)` on an interface value dispatches dynamically
  // via call_iface, using the method's stable dispatch index.
  if (cn.tag == Tag.Member) {
    let mk = kidsOf(fc.c.tree, callee)
    let recvTy = nodeType(fc, mk[0])
    if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
      let mn = getNode(fc.c.tree, mk[1])
      let mname = fc.c.source[mn.span.start:mn.span.end]
      let recvV = lowerExpr(fc, mk[0])
      let a = lowerArgs(fc, node, methodParamTypes(fc, recvTy, mname))
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.CallIface, unwrapFallible(fc.c, methodResultLookup(fc.c, "${recvTy}.${mname}")))
      ins.lhs = recvV
      ins.ival = methodId(fc.lowerer, mname)
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    // A FUNC-TYPED FIELD called through its owner, `r.read(4096)` (SPEC 9.4):
    // the member is a closure value, not a method, so it dispatches through
    // `call_value` like any other first-class function. Checked BEFORE the
    // struct-method branch below, which would otherwise mangle a `call
    // @read$t<recvId>` against a method that does not exist and fail at link.
    let fldTy = nodeType(fc, callee)
    if (fldTy != 0 && fc.c.ctx.types[fldTy].kind == TypeKind.Func &&
      methodSigLookup(fc.c, "${recvTy}." + fc.c.source[getNode(fc.c.tree, mk[1]).span.start:getNode(fc.c.tree, mk[1]).span.end]) == 0) {
      let members = fc.c.ctx.types[fldTy].members
      let fv = lowerExpr(fc, callee)
      let a = lowerArgs(fc, node, members)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.CallValue, unwrapFallible(fc.c, nodeType(fc, node)))
      ins.lhs = fv
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    // A method call on a concrete struct value dispatches statically to the
    // mangled method `call @method$t<recvId>(recv, args)`; the receiver is the
    // leading argument.
    if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Struct) {
      let mn = getNode(fc.c.tree, mk[1])
      let mname = fc.c.source[mn.span.start:mn.span.end]
      let recvV = lowerExpr(fc, mk[0])
      let a = lowerArgs(fc, node, methodParamTypes(fc, recvTy, mname))
      if (fc.failed) {
        return 0
      }
      let all = [recvV]
      let j = 0
      while (j < len(a)) {
        all = append(all, a[j])
        j = j + 1
      }
      let ins = mkInstr(Op.Call, unwrapFallible(fc.c, methodResultLookup(fc.c, "${recvTy}.${mname}")))
      ins.name = methodSymbol(fc.lowerer, mname, recvTy)
      ins.args = all
      return builderEmit(fc.b, ins)
    }
  }
  // Any OTHER callee expression that is itself a function VALUE: a slice
  // element `fs[0](41)`, a returned function `mk()(41)`, a parenthesized one.
  // No declaration backs these, so the callee lowers as an ordinary value and
  // dispatches through `call_value` — the same shape the Ident local-binding
  // and func-typed-field branches above emit. Pairs with the matching tail in
  // check.bit's `checkCall`; the two must agree on which callees are values.
  let cty = nodeType(fc, callee)
  if (cty != 0 && fc.c.ctx.types[cty].kind == TypeKind.Func) {
    let members = fc.c.ctx.types[cty].members
    let vfixed = -1
    let velem = 0
    if (fc.c.ctx.types[cty].variadic && len(members) > 0) {
      vfixed = len(members) - 1
      velem = members[vfixed]
    }
    let fv = lowerExpr(fc, callee)
    let a = lowerArgsRest(fc, node, members, vfixed, velem)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.CallValue, unwrapFallible(fc.c, nodeType(fc, node)))
    ins.lhs = fv
    ins.args = a
    return builderEmit(fc.b, ins)
  }
  fc.failed = true
  return 0
}

// A struct field's byte size and whether it holds a GC reference (ABI: prims by
// width, string/slice/map/chan/tuple/struct/interface/func are 8-byte handles).
// ponytail: enums treated as ref handles; C-like-enum non-ptr fields deferred.
struct FieldLayout {
  size: int,
  isPtr: bool,
}

function fieldLayoutFor(fc: FnCtx, ty: int): FieldLayout {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Prim) {
    let p = t.prim
    if (p == 0 || p == 4 || p == 10) {
      return FieldLayout{ size: 1, isPtr: false }
    }
    if (p == 1 || p == 5) {
      return FieldLayout{ size: 2, isPtr: false }
    }
    if (p == 2 || p == 6 || p == 8) {
      return FieldLayout{ size: 4, isPtr: false }
    }
    if (p == 3 || p == 7 || p == 9) {
      return FieldLayout{ size: 8, isPtr: false }
    }
  }
  // A raw pointer `*T` (§11.4) is a single word the GC must never follow: 8
  // bytes, isPtr=false so its offset stays out of the object's pointer map.
  if (t.kind == TypeKind.Ptr) {
    return FieldLayout{ size: 8, isPtr: false }
  }
  // A C-like enum's value is a bare i64 tag (not a traced pointer); only a boxed
  // (payload) enum's value is an object reference.
  if (t.kind == TypeKind.Enum && !t.enumBoxed) {
    return FieldLayout{ size: 8, isPtr: false }
  }
  return FieldLayout{ size: 8, isPtr: true }
}

// Rounds `x` up to a multiple of `a`.
function alignUp(x: int, a: int): int {
  if (a <= 1) {
    return x
  }
  return ((x + a - 1) / a) * a
}

// A struct's total size (8-aligned), per-field byte offsets, and the offsets of
// its reference fields (for the GC descriptor). Mirrors layoutFields.
struct StructLayout {
  size: int,
  offsets: []int,
  ptrOffsets: []int,
}

// The StructDecl node for a named struct, or 0.
// The Checker for the module that DECLARES `ty`, a named type. Fields, variants
// and payloads are all read back from the decl node, and a node index only means
// something in its own tree (the declOwner rule) — so an imported type (`File`
// from std/fs, `Option` from the prelude) must be read from its declaring
// module, not the importer's. Falls back to `c` when the module is unrecorded or
// out of range, which is the single-module case.
function typeOwner(c: Checker, ty: int): Checker {
  let m = c.ctx.types[ty].declModule
  if (m < 0 || m == c.moduleId || m >= len(c.mods)) {
    return c
  }
  return c.mods[m]
}

// The decl node of tag `tag` named `name` in `oc`'s tree, or 0.
function declNodeIn(oc: Checker, tag: Tag, name: string): int {
  let i = 1
  while (i < len(oc.tree.nodes)) {
    if (getNode(oc.tree, i).tag == tag && declName(oc, i) == name) {
      return i
    }
    i = i + 1
  }
  return 0
}

// The `struct_decl` node for `structTy`, or 0. The result indexes into
// `typeOwner(c, structTy)`'s tree — never `c`'s.
function structDeclOf(c: Checker, structTy: int): int {
  return declNodeIn(typeOwner(c, structTy), Tag.StructDecl, typeName(c.ctx, structTy))
}

// The `enum_decl` node for `enumTy`, or 0. The result indexes into
// `typeOwner(c, enumTy)`'s tree — never `c`'s.
function enumDeclOf(c: Checker, enumTy: int): int {
  return declNodeIn(typeOwner(c, enumTy), Tag.EnumDecl, typeName(c.ctx, enumTy))
}

// An enum declaration's variant nodes in order (kid 2 is the variant_list).
function enumVariantNodes(c: Checker, decl: int): []int {
  return kidsOf(c.tree, kidsOf(c.tree, decl)[2])
}

// The declaration-order tag of a variant name in `enumTy`, or 0 if not found
// (the checker has already validated the name).
function variantOrdinal(c: Checker, enumTy: int, variantName: string): int {
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return 0
  }
  let vs = enumVariantNodes(oc, decl)
  let i = 0
  while (i < len(vs)) {
    let vn = getNode(oc.tree, kidsOf(oc.tree, vs[i])[0])
    if (oc.source[vn.span.start:vn.span.end] == variantName) {
      return i
    }
    i = i + 1
  }
  return 0
}

// The resolved payload types of a variant (empty when it has none). The payload
// is `enum_variant`'s kid 1, a `type_list` of type nodes — resolved against the
// declaring module, since that is the tree the type nodes index into.
function variantPayloadTypes(c: Checker, enumTy: int, variantName: string): []int {
  let out = []int(0)
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return out
  }
  let vs = enumVariantNodes(oc, decl)
  let i = 0
  while (i < len(vs)) {
    let vn = getNode(oc.tree, kidsOf(oc.tree, vs[i])[0])
    if (oc.source[vn.span.start:vn.span.end] == variantName) {
      let payload = kidsOf(oc.tree, vs[i])[1]
      if (payload == 0) {
        return out
      }
      let types = kidsOf(oc.tree, payload)
      let j = 0
      while (j < len(types)) {
        out = append(out, typeFromNode(oc, types[j]))
        j = j + 1
      }
      return out
    }
    i = i + 1
  }
  return out
}

// The index of a type-parameter name in a generic enum's `<...>` list, or -1.
function enumTypeParamIndex(c: Checker, enumTy: int, tpname: string): int {
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return -1
  }
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  let i = 0
  while (i < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[i])[0])
    if (oc.source[tpn.span.start:tpn.span.end] == tpname) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Substitutes a variant-payload type-param with the scrutinee's concrete type
// argument: a bare `T` in `Opt<i64>` resolves to i64 via the enum's type-param
// index. Non-type-param payloads pass through.
function substPayloadType(c: Checker, enumTy: int, ty: int, typeArgs: []int): int {
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.TypeParam) {
    return ty
  }
  let idx = enumTypeParamIndex(c, enumTy, c.ctx.types[ty].name)
  if (idx >= 0 && idx < len(typeArgs)) {
    return typeArgs[idx]
  }
  return ty
}

// Builds a boxed enum object `{ tag: i64 @0, payloadPtr @8 }` (16 bytes, the
// payload pointer at offset 8 is the one GC-traced word; nil for a no-payload
// variant). `payload` is -1 for none — NOT 0, which is the value id of the first
// instruction in a function and so a perfectly valid payload (the seed's
// `?ir.ValueId` carries the distinction in the type; here it must be a value the
// id space can never produce).
function buildEnumObj(fc: FnCtx, enumTy: int, tag: int, payload: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let ga = mkInstr(Op.GcAlloc, enumTy)
  ga.ival = 16
  ga.offsets = [8]
  let obj = builderEmit(fc.b, ga)
  let tc = mkInstr(Op.ConstInt, i64ty)
  tc.ival = tag
  let fs0 = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs0.lhs = obj
  fs0.ival = 0
  fs0.rhs = builderEmit(fc.b, tc)
  builderEmit(fc.b, fs0)
  let payV = payload
  if (payload == -1) {
    let z = mkInstr(Op.ConstInt, i64ty)
    payV = builderEmit(fc.b, z)
  }
  let fs8 = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs8.lhs = obj
  fs8.ival = 8
  fs8.rhs = payV
  builderEmit(fc.b, fs8)
  return obj
}

// Lowers `Enum.Variant(args)` for a boxed enum: allocate the payload box (word i
// = arg i, GC-tracing its ref words), then wrap it in the enum object. A
// no-payload variant construction is just the wrapped nil.
function lowerVariantConstruction(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let enumTy = nodeType(fc, k[0])
  let mn = getNode(fc.c.tree, kidsOf(fc.c.tree, k[0])[1])
  let vname = fc.c.source[mn.span.start:mn.span.end]
  let tag = variantOrdinal(fc.c, enumTy, vname)
  // The concrete payload types come from the arguments, not the variant's
  // declared payload — so a generic enum `Opt<i64>.Some(x)` boxes the payload at
  // the substituted type (i64), giving the right size and GC-ptr offsets.
  let args = kidsOf(fc.c.tree, k[2])
  let box = -1
  if (len(args) > 0) {
    let offs = []int(0)
    let i = 0
    while (i < len(args)) {
      let at = defaultType(fc.c, checkArgType(fc.c, node, i))
      if (fieldLayoutFor(fc, at).isPtr) {
        offs = append(offs, 8 * i)
      }
      i = i + 1
    }
    let ga = mkInstr(Op.GcAlloc, enumTy)
    ga.ival = 8 * len(args)
    ga.offsets = offs
    box = builderEmit(fc.b, ga)
    let j = 0
    while (j < len(args) && !fc.failed) {
      let a = args[j]
      if (getNode(fc.c.tree, a).tag == Tag.Arg) {
        a = kidsOf(fc.c.tree, a)[0]
      }
      let av = lowerExprH(fc, a, defaultType(fc.c, checkArgType(fc.c, node, j)))
      if (fc.failed) {
        return 0
      }
      let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      fs.lhs = box
      fs.ival = 8 * j
      fs.rhs = av
      builderEmit(fc.b, fs)
      j = j + 1
    }
  }
  return buildEnumObj(fc, enumTy, tag, box)
}

// A struct declaration's field nodes in order (unwrapping exported fields).
function structFieldNodes(c: Checker, decl: int): []int {
  let raw = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  let out = []int(0)
  let i = 0
  while (i < len(raw)) {
    let f = raw[i]
    if (getNode(c.tree, f).tag == Tag.Export) {
      f = kidsOf(c.tree, f)[0]
    }
    out = append(out, f)
    i = i + 1
  }
  return out
}

// Computes a struct's layout from its declaration (field decl order). `sub`
// binds the struct's type parameters to concrete types at a generic
// construction site (`Box<i64>{...}` -> {T: i64}); noSubst() for a non-generic
// struct. Without it a generic field `val: T` resolves to the bare type param,
// which classifies as a pointer — mislabelling `Box<i64>`'s i64 in the GC
// descriptor.
function structLayout(fc: FnCtx, oc: Checker, decl: int, sub: TypeSubst): StructLayout {
  let fields = structFieldNodes(oc, decl)
  let offsets = []int(0)
  let ptrOffsets = []int(0)
  let cur = 0
  let i = 0
  while (i < len(fields)) {
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, fields[i])[1], sub)
    let ft = fc.c.ctx.types[fty]
    if (ft.kind == TypeKind.Array) {
      let el = fieldLayoutFor(fc, ft.elem)
      cur = alignUp(cur, el.size)
      offsets = append(offsets, cur)
      cur = cur + ft.arrayLen * el.size
    } else {
      let fl = fieldLayoutFor(fc, fty)
      cur = alignUp(cur, fl.size)
      offsets = append(offsets, cur)
      if (fl.isPtr) {
        ptrOffsets = append(ptrOffsets, cur)
      }
      cur = cur + fl.size
    }
    i = i + 1
  }
  return StructLayout{ size: alignUp(cur, 8), offsets: offsets, ptrOffsets: ptrOffsets }
}

// The declared-order index of a field name in a struct, or -1.
function fieldIndexByName(c: Checker, fields: []int, name: string): int {
  let i = 0
  while (i < len(fields)) {
    let fn = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    if (c.source[fn.span.start:fn.span.end] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Lowers a struct composite literal `T{f: v, ...}` to a `gc_alloc` (its GC
// descriptor is the ref-field offsets) followed by a `field_set` per field, in
// the literal's source order. ponytail: struct bodies only — []T/[N]T/map<K,V>
// composites and inline-array fields land next.
// Lowers a slice-type callee `[]E(...)`. A single `string` argument is the
// conversion `[]byte(s)` -> `bytes_from_string`. Otherwise it is a sized
// allocation `[]E(n)` / `[]E(n, m)`: `slice_new(n, cap, is_ref)`, cap defaulting
// to n, `is_ref` set when the element is pointer-sized.
function lowerSliceAlloc(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let sliceTy = typeFromNode(fc.c, kids[0])
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let args = kidsOf(fc.c.tree, kids[2])
  let arg0 = args[0]
  if (getNode(fc.c.tree, arg0).tag == Tag.Arg) {
    arg0 = kidsOf(fc.c.tree, arg0)[0]
  }
  // `[]byte(s)`: a lone string argument is the bytes-of-string conversion. A
  // string literal defaults through `untyped_string`, so default the type first.
  let a0ty = defaultType(fc.c, nodeType(fc, arg0))
  if (len(args) == 1 && fc.c.ctx.types[a0ty].kind == TypeKind.Prim && fc.c.ctx.types[a0ty].prim == 11) {
    let sv = lowerExprH(fc, arg0, primType(fc.c.ctx, 11))
    if (fc.failed) {
      return 0
    }
    let bs = mkInstr(Op.RtCall, sliceTy)
    bs.name = "bytes_from_string"
    bs.args = [sv]
    return emitRtCall(fc, bs)
  }
  let nV = lowerExprH(fc, arg0, primType(fc.c.ctx, 3))
  if (fc.failed) {
    return 0
  }
  let capV = nV
  if (len(args) >= 2) {
    let arg1 = args[1]
    if (getNode(fc.c.tree, arg1).tag == Tag.Arg) {
      arg1 = kidsOf(fc.c.tree, arg1)[0]
    }
    capV = lowerExprH(fc, arg1, primType(fc.c.ctx, 3))
    if (fc.failed) {
      return 0
    }
  }
  let refI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [nV, capV, refV]
  return emitRtCall(fc, sn)
}

// Lowers a `[]E{a, b, ...}` slice literal: allocate via `rt_call slice_new(len,
// len, is_ref)`, then `slice_set` each element in order. `items` are the element
// expression nodes (each possibly wrapped in an `arg`).
function lowerSliceElems(fc: FnCtx, sliceTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let lenI = mkInstr(Op.ConstInt, i64ty)
  lenI.ival = len(items)
  let lenV = builderEmit(fc.b, lenI)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [lenV, lenV, refV]
  let s = emitRtCall(fc, sn)
  let i = 0
  while (i < len(items)) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ss.name = "slice_set"
    ss.args = [s, idxV, v]
    emitRtCall(fc, ss)
    i = i + 1
  }
  return s
}

// Allocates an empty map: `rt_call map_new(key_is_string, val_is_ref)`. The two
// flags drive the runtime's key hashing and GC tracing (ABI.md §11). `mapTy` is
// the checker's interned map type.
function lowerMapMake(fc: FnCtx, mapTy: int): int {
  let m = fc.c.ctx.types[mapTy]
  let i64ty = primType(fc.c.ctx, 3)
  let kf = mkInstr(Op.ConstInt, i64ty)
  if (fc.c.ctx.types[m.mapKey].kind == TypeKind.Prim && fc.c.ctx.types[m.mapKey].prim == 11) {
    kf.ival = 1
  }
  let kflag = builderEmit(fc.b, kf)
  let vf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, m.mapVal).isPtr) {
    vf.ival = 1
  }
  let vflag = builderEmit(fc.b, vf)
  let ins = mkInstr(Op.RtCall, mapTy)
  ins.name = "map_new"
  ins.args = [kflag, vflag]
  return emitRtCall(fc, ins)
}

// A `map<K,V>{k: v, ...}` composite: allocate, then `map_set(m, k, v)` per entry
// in order (each key/val lowered at the map's key/val type).
function lowerMapLit(fc: FnCtx, mapTy: int, entries: []int): int {
  let m = fc.c.ctx.types[mapTy]
  let mv = lowerMapMake(fc, mapTy)
  let i = 0
  while (i < len(entries) && !fc.failed) {
    let ek = kidsOf(fc.c.tree, entries[i])
    let key = lowerExprH(fc, ek[0], m.mapKey)
    let val = lowerExprH(fc, ek[1], m.mapVal)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [mv, key, val]
    emitRtCall(fc, ins)
    i = i + 1
  }
  return mv
}

// Constructs a channel `chan<T>(n)`: `rt_call chan_make(cap, is_ref)`, cap
// defaulting to 0 (unbuffered) when omitted; is_ref marks a pointer element word
// so the runtime traces a buffered element as a GC root (ABI.md §11).
function lowerChanMake(fc: FnCtx, node: int): int {
  let chanTy = nodeType(fc, node)
  let elemTy = fc.c.ctx.types[chanTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let capV = 0
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExpr(fc, a)
    if (fc.failed) {
      return 0
    }
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    capV = builderEmit(fc.b, z)
  }
  let rf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    rf.ival = 1
  }
  let refV = builderEmit(fc.b, rf)
  let ins = mkInstr(Op.RtCall, chanTy)
  ins.name = "chan_make"
  ins.args = [capV, refV]
  return emitRtCall(fc, ins)
}

// The byte size of a fixed-size array `[N]T`: N inline scalar elements.
function arrayBytes(fc: FnCtx, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  return a.arrayLen * fieldLayoutFor(fc, a.elem).size
}

// A fresh, zeroed inline storage block for an `[N]T` value: `gc_alloc` hands back
// zeroed memory (no reference elements to trace), so every element reads 0.
function newArray(fc: FnCtx, arrayTy: int): int {
  let ga = mkInstr(Op.GcAlloc, arrayTy)
  ga.ival = arrayBytes(fc, arrayTy)
  ga.offsets = []int(0)
  return builderEmit(fc.b, ga)
}

// An independent copy of the `[N]T` value `src`: read every (scalar) element
// BEFORE allocating the destination — `gc_alloc` is a safepoint, so holding the
// loads past it keeps them off the far side of a possible collection.
function cloneArray(fc: FnCtx, src: int, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let elems = []int(0)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = builderEmit(fc.b, ci)
    elems = append(elems, builderEmit(fc.b, ig))
    i = i + 1
  }
  let dst = newArray(fc, arrayTy)
  i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = builderEmit(fc.b, ci)
    is.ival = elems[i]
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// The value to bind when an `[N]T`-typed expression flows into a new location
// (let/assign/arg/return): a reference expression (ident/field/index) names
// existing storage, so it is copied for value semantics; a fresh literal is not.
function arrayValueForBind(fc: FnCtx, node: int, val: int, ty: int): int {
  if (ty == 0 || fc.c.ctx.types[ty].kind != TypeKind.Array) {
    return val
  }
  let t = getNode(fc.c.tree, node).tag
  if (t == Tag.Ident || t == Tag.Member || t == Tag.Index) {
    return cloneArray(fc, val, ty)
  }
  return val
}

// Lowers an `[N]T{a, b, ...}` array literal: allocate the block, then `index_set`
// each element in order (elements are scalars, checker-restricted).
function lowerArrayElems(fc: FnCtx, arrayTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[arrayTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let dst = newArray(fc, arrayTy)
  let i = 0
  while (i < len(items) && !fc.failed) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = v
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// Copies every (scalar) element of the `[N]T` at `src` into the existing storage
// at `dst` (both element-base pointers) — read then write per element, no alloc.
function copyArrayInto(fc: FnCtx, dst: int, src: int, arrayTy: int) {
  let a = fc.c.ctx.types[arrayTy]
  let i64ty = primType(fc.c.ctx, 3)
  let i = 0
  while (i < a.arrayLen) {
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ig = mkInstr(Op.IndexGet, a.elem)
    ig.lhs = src
    ig.rhs = idxV
    let e = builderEmit(fc.b, ig)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = e
    builderEmit(fc.b, is)
    i = i + 1
  }
}

// The zero value of a type as an IR value (SPEC §13.4): a scalar constant, a
// fresh zeroed array/struct body (a live instance, not nil), else a nil word.
function zeroValue(fc: FnCtx, ty: int): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 10) {
      let b = mkInstr(Op.ConstBool, ty)
      b.bval = false
      return builderEmit(fc.b, b)
    }
    if (td.prim == 8 || td.prim == 9) {
      let f = mkInstr(Op.ConstFloat, ty)
      return builderEmit(fc.b, f)
    }
    if (td.prim == 11) {
      let s = mkInstr(Op.ConstString, ty)
      s.sval = ""
      s.ival = internPoolString(fc, s.sval)
      return builderEmit(fc.b, s)
    }
    let ci = mkInstr(Op.ConstInt, ty)
    return builderEmit(fc.b, ci)
  }
  if (td.kind == TypeKind.Array) {
    return newArray(fc, ty)
  }
  if (td.kind == TypeKind.Struct) {
    let decl = structDeclOf(fc.c, ty)
    if (decl == 0) {
      fc.failed = true
      return 0
    }
    let layout = structLayout(fc, typeOwner(fc.c, ty), decl, noSubst())
    let ga = mkInstr(Op.GcAlloc, ty)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    return builderEmit(fc.b, ga)
  }
  let nl = mkInstr(Op.ConstNil, ty)
  return builderEmit(fc.b, nl)
}

// Binds a generic struct's declared type-param names to the concrete arguments
// at a composite-literal site: `Box<i64>{...}` (a GenericInst type node) yields
// {T: i64}. Param names come from the declaration (`oc`), argument types from
// the construction site (`c`) — the two differ across a module boundary. Empty
// for a non-generic struct (the type node is a plain ident).
function structLitSubst(c: Checker, oc: Checker, decl: int, typeNode: int): TypeSubst {
  let sub = noSubst()
  if (getNode(c.tree, typeNode).tag != Tag.GenericInst) {
    return sub
  }
  let params = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  let targs = kidsOf(c.tree, kidsOf(c.tree, typeNode)[1])
  let i = 0
  while (i < len(params) && i < len(targs)) {
    let pn = getNode(oc.tree, kidsOf(oc.tree, params[i])[0])
    sub.names = append(sub.names, oc.source[pn.span.start:pn.span.end])
    sub.types = append(sub.types, typeFromNode(c, targs[i]))
    i = i + 1
  }
  return sub
}

function lowerCompositeLit(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let structTy = typeFromNode(fc.c, kids[0])
  // A `[]E{...}` slice composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Slice) {
    return lowerSliceElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // An `[N]T{...}` array composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Array) {
    return lowerArrayElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // A `map<K,V>{...}` composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Map) {
    return lowerMapLit(fc, nodeType(fc, node), kidsOf(fc.c.tree, kids[1]))
  }
  if (structTy == 0 || fc.c.ctx.types[structTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclOf(fc.c, structTy)
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let oc = typeOwner(fc.c, structTy)
  let sub = structLitSubst(fc.c, oc, decl, kids[0])
  let layout = structLayout(fc, oc, decl, sub)
  let fields = structFieldNodes(oc, decl)
  let ga = mkInstr(Op.GcAlloc, structTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  let inits = kidsOf(fc.c.tree, kids[1])
  let i = 0
  while (i < len(inits)) {
    let fk = kidsOf(fc.c.tree, inits[i])
    let fn = getNode(fc.c.tree, fk[0])
    let idx = fieldIndexByName(oc, fields, fc.c.source[fn.span.start:fn.span.end])
    if (idx == -1) {
      fc.failed = true
      return 0
    }
    // Substituted, for the same reason the layout above is: `items: []T` on a
    // `Stack<i64>{...}` must lower its initializer under `[]i64`. Under the bare
    // `[]T` the slice materializes with is_ref set, and the GC then walks plain
    // integers as pointers.
    let fty = typeFromNodeIn(oc, kidsOf(oc.tree, fields[idx])[1], sub)
    // An inline array field is copied into the struct's own storage (its
    // elements live in the struct body), not stored as a shared handle.
    if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
      let src = lowerExpr(fc, fk[1])
      if (fc.failed) {
        return 0
      }
      let fg = mkInstr(Op.FieldGet, fty)
      fg.lhs = obj
      fg.ival = layout.offsets[idx]
      copyArrayInto(fc, builderEmit(fc.b, fg), src, fty)
      i = i + 1
      continue
    }
    // The field's own type is the hint the initializer lowers under. Without it
    // an untyped literal materializes at its DEFAULT type — `4.5` as an `f64` —
    // and the field_set then writes the field's width from it, storing the low
    // half of an f64 into an `f32` field: a silent zero (#1457).
    let val = lowerExprH(fc, fk[1], fty)
    if (fc.failed) {
      return 0
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[idx]
    fs.rhs = val
    builderEmit(fc.b, fs)
    i = i + 1
  }
  return obj
}

// Lowers a struct field access `s.f` to `field_get %s[offset] fieldType`, or an
// enum variant reference `Enum.Variant` to its tag constant.
function lowerFieldAccess(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // `ns.member` — an exported const/state/function of a namespaced module, not a
  // field of a value. Its dotted key resolves through the ordinary name path.
  let qn = nsQualifiedName(fc.c, node)
  if (qn != "") {
    return lowerNamedValue(fc, node, qn)
  }
  // `Enum.Variant` (receiver is an enum type name): a C-like enum's variant is
  // its bare tag `const_int <Enum> <ordinal>`; a boxed enum's no-payload variant
  // wraps that tag in the `{tag, nil}` object.
  let baseName = typeNodeName(fc.c, kids[0])
  if (baseName != "") {
    let ut = userTypeLookup(fc.c, baseName)
    if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
      let mn0 = getNode(fc.c.tree, kids[1])
      let ord = variantOrdinal(fc.c, ut, fc.c.source[mn0.span.start:mn0.span.end])
      if (fc.c.ctx.types[ut].enumBoxed) {
        return buildEnumObj(fc, ut, ord, -1)
      }
      let ci = mkInstr(Op.ConstInt, ut)
      ci.ival = ord
      return builderEmit(fc.b, ci)
    }
  }
  let recvTy = nodeType(fc, kids[0])
  // An uncalled interface method `iface.m` is a closure over the receiver plus a
  // trampoline that dispatches dynamically (call_iface).
  if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
    return lowerIfaceMethodValue(fc, node, recvTy)
  }
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, kids[1])
  let idx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (idx == -1) {
    return lowerStructMethodValue(fc, node, recvTy)
  }
  let layout = structLayout(fc, oc, decl, noSubst())
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.FieldGet, fieldAccessType(fc, oc, fields[idx], node))
  ins.lhs = recvV
  ins.ival = layout.offsets[idx]
  return builderEmit(fc.b, ins)
}

// The concrete type of a struct field READ. The declared field node is the
// template's answer (`b: T` of a `Pair<T>` is the bare param), so a read off a
// `Pair<i64>` would emit `field_get ... <T>` — wrong width and, worse, wrong
// is_ref, which is a GC-tracing bug rather than a compile error.
//
// `checkMember` already substitutes the receiver's type arguments, so prefer the
// checker's answer for this node. It is only an improvement when it resolves the
// parameter away; when it cannot (an inferred receiver whose args are
// unrecoverable) it hands back the same TypeParam, and the declared type stands.
// Permissive when undecided: never trade a known type for an unknown one.
function fieldAccessType(fc: FnCtx, oc: Checker, field: int, node: int): int {
  let declTy = typeFromNode(oc, kidsOf(oc.tree, field)[1])
  if (declTy != 0 && fc.c.ctx.types[declTy].kind != TypeKind.TypeParam) {
    return declTy
  }
  let checked = nodeType(fc, node)
  if (checked != 0 && fc.c.ctx.types[checked].kind != TypeKind.TypeParam) {
    return checked
  }
  return declTy
}

// Lowers an index read `a[i]`: a slice via `rt_call slice_get`, a map via
// `map_get`, a string via `string_byte`, a fixed array via the `index_get` op.
function lowerIndex(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let ty = defaultType(fc.c, nodeType(fc, node))
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  let rd = fc.c.ctx.types[recvTy]
  if (rd.kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "slice_get"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  if (rd.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "map_get"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  if (rd.kind == TypeKind.Prim && rd.prim == 11) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "string_byte"
    ins.args = [recv, idx]
    return emitRtCall(fc, ins)
  }
  let ins = mkInstr(Op.IndexGet, ty)
  ins.lhs = recv
  ins.rhs = idx
  return builderEmit(fc.b, ins)
}

// Lowers a reslice `s[lo:hi]` (SPEC §12.7): `rt_call slice_slice(s, lo, hi)` for a
// slice, `string_slice` for a string. An omitted `lo` is 0; an omitted `hi` is
// the receiver's current length. Array reslice is not lowerable (matches seed).
function lowerSliceExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let isString = rd.kind == TypeKind.Prim && rd.prim == 11
  if (rd.kind != TypeKind.Slice && !isString) {
    fc.failed = true
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let recv = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let lo = 0
  if (k[1] != 0) {
    lo = lowerExprH(fc, k[1], i64ty)
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    lo = builderEmit(fc.b, z)
  }
  let hi = 0
  if (k[2] != 0) {
    hi = lowerExprH(fc, k[2], i64ty)
  } else {
    let sl = mkInstr(Op.SliceLen, i64ty)
    sl.lhs = recv
    hi = builderEmit(fc.b, sl)
  }
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, nodeType(fc, node))
  ins.name = "slice_slice"
  if (isString) {
    ins.name = "string_slice"
  }
  ins.args = [recv, lo, hi]
  return emitRtCall(fc, ins)
}

// Converts a lowered value to a string for interpolation (§5.7): a string is
// itself; bool/float/int dispatch to their `string_from_*` runtime call. A
// struct/interface `show()` operand falls back for now.
function lowerToString(fc: FnCtx, v: int, node: int): int {
  let ty = defaultType(fc.c, nodeType(fc, node))
  let td = fc.c.ctx.types[ty]
  let stringTy = primType(fc.c.ctx, 11)
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 11) {
      return v
    }
    let rt = "string_from_int"
    if (td.prim == 10) {
      rt = "string_from_bool"
    } else if (td.prim == 8 || td.prim == 9) {
      rt = "string_from_float"
    }
    let arg = v
    // `bit_rt_string_from_float` takes an `f64`, so an `f32` must be widened
    // first: passing a single leaves the callee's d0/xmm0 upper half undefined
    // and it formats a denormal near zero (a long all-zero fractional tail —
    // #1457). Converted here, not by the callee, because the C signature is f64.
    if (td.prim == 8) {
      let cv = mkInstr(Op.Convert, primType(fc.c.ctx, 9))
      cv.lhs = v
      arg = builderEmit(fc.b, cv)
    }
    let ins = mkInstr(Op.RtCall, stringTy)
    ins.name = rt
    ins.args = [arg]
    return emitRtCall(fc, ins)
  }
  // An interface value stringifies through its `show()` method (dynamic dispatch).
  if (td.kind == TypeKind.Interface) {
    let ins = mkInstr(Op.CallIface, stringTy)
    ins.lhs = v
    ins.ival = methodId(fc.lowerer, "show")
    ins.args = []int(0)
    return builderEmit(fc.b, ins)
  }
  // A struct value with a `show()` method stringifies through it (static call).
  if (td.kind == TypeKind.Struct && methodResultLookup(fc.c, "${ty}.show") != 0) {
    let ins = mkInstr(Op.Call, stringTy)
    ins.name = methodSymbol(fc.lowerer, "show", ty)
    ins.args = [v]
    return builderEmit(fc.b, ins)
  }
  fc.failed = true
  return 0
}

// Lowers a string interpolation `"a${x}b"`: each literal segment -> const_string
// (decoded), each interpolated expr -> lowerToString, then the parts fold left
// with string_concat — matching the seed's lowerStrInterp.
function lowerStrInterp(fc: FnCtx, node: int): int {
  let parts = kidsOf(fc.c.tree, node)
  let stringTy = primType(fc.c.ctx, 11)
  let vals = []int(0)
  let i = 0
  while (i < len(parts) && !fc.failed) {
    let p = parts[i]
    let pn = getNode(fc.c.tree, p)
    if (pn.tag == Tag.StrPart) {
      let cs = mkInstr(Op.ConstString, stringTy)
      cs.sval = decodeEscapes(fc.c.source, pn.span.start, pn.span.end)
      cs.ival = internPoolString(fc, cs.sval)
      vals = append(vals, builderEmit(fc.b, cs))
    } else {
      vals = append(vals, lowerToString(fc, lowerExpr(fc, p), p))
    }
    i = i + 1
  }
  if (fc.failed) {
    return 0
  }
  let acc = vals[0]
  let j = 1
  while (j < len(vals)) {
    let ins = mkInstr(Op.RtCall, stringTy)
    ins.name = "string_concat"
    ins.args = [acc, vals[j]]
    acc = emitRtCall(fc, ins)
    j = j + 1
  }
  return acc
}

// Whether a type id is a concrete numeric prim (i8..f64), so an untyped literal
// can be materialized at that context type instead of its default.
function isNumericPrim(fc: FnCtx, ty: int): bool {
  return ty != 0 && fc.c.ctx.types[ty].kind == TypeKind.Prim && fc.c.ctx.types[ty].prim <= 9
}

// The register code (`check.asmRegX64`/`asmRegArm64`) for one `asm` operand's
// register-name ident; an unknown name (validator's job, #1374) falls back to 0.
function asmRegCode(fc: FnCtx, ident: int, isArm64: bool): int {
  let sp = getNode(fc.c.tree, ident).span
  let name = fc.c.source[sp.start:sp.end]
  let code = -1
  if (isArm64) {
    code = asmRegArm64(name)
  } else {
    code = asmRegX64(name)
  }
  if (code < 0) {
    return 0
  }
  return code
}

// The pre-encoded byte/word values of an `asm_code` block (empty if none).
function asmCodeVals(fc: FnCtx, code: int): []int {
  let out = []int(0)
  if (code == 0) {
    return out
  }
  let lits = kidsOf(fc.c.tree, code)
  let i = 0
  while (i < len(lits)) {
    let sp = getNode(fc.c.tree, lits[i]).span
    out = append(out, parseIntText(fc.c.source[sp.start:sp.end]))
    i = i + 1
  }
  return out
}

// The register codes of an `asm_clobber` list (empty if none).
function asmRegVals(fc: FnCtx, list: int, isArm64: bool): []int {
  let out = []int(0)
  if (list == 0) {
    return out
  }
  let regs = kidsOf(fc.c.tree, list)
  let i = 0
  while (i < len(regs)) {
    out = append(out, asmRegCode(fc, regs[i], isArm64))
    i = i + 1
  }
  return out
}

// Lowers an `asm` block (§11.6) into an `IrModule.asmBlocks` entry plus the
// `Op.Asm` that references it. Both target sub-blocks are pooled; the backend
// reads only its own arch's. Result type is the checker's type for `result`, or
// void when there is none.
function lowerAsm(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node) // [x64_code, arm64_code, result?, clob_x64, clob_arm64, input...]
  let inX64 = []int(0)
  let inArm64 = []int(0)
  let inVals = []int(0)
  let i = 5
  while (i < len(k)) {
    let ik = kidsOf(fc.c.tree, k[i]) // [arm64_reg, x64_reg, value]
    inArm64 = append(inArm64, asmRegCode(fc, ik[0], true))
    inX64 = append(inX64, asmRegCode(fc, ik[1], false))
    inVals = append(inVals, lowerExpr(fc, ik[2]))
    i = i + 1
  }
  let hasResult = false
  let resultX64 = 0
  let resultArm64 = 0
  let ty = fc.c.ctx.voidId
  if (k[2] != 0) {
    let rk = kidsOf(fc.c.tree, k[2]) // [arm64_reg, x64_reg, type]
    hasResult = true
    resultArm64 = asmRegCode(fc, rk[0], true)
    resultX64 = asmRegCode(fc, rk[1], false)
    ty = nodeType(fc, node)
  }
  let blk = AsmBlock{
    x64Bytes: asmCodeVals(fc, k[0]),
    arm64Words: asmCodeVals(fc, k[1]),
    hasResult: hasResult,
    resultX64: resultX64,
    resultArm64: resultArm64,
    inX64: inX64,
    inArm64: inArm64,
    clobX64: asmRegVals(fc, k[3], false),
    clobArm64: asmRegVals(fc, k[4], true),
  }
  fc.lowerer.asmBlocks = append(fc.lowerer.asmBlocks, blk)
  let blockIdx = len(fc.lowerer.asmBlocks) - 1
  let ins = mkInstr(Op.Asm, ty)
  ins.ival = blockIdx
  ins.args = inVals
  if (hasResult) {
    ins.ival2 = 1
  }
  return builderEmit(fc.b, ins)
}

// Lowers an expression with no type context.
function lowerExpr(fc: FnCtx, node: int): int {
  return lowerExprH(fc, node, 0)
}

// Lowers an expression to its SSA value id under an optional expected type
// `hint` (0 = none), which types an otherwise-untyped numeric literal — the
// seed's lowerExprH. Trips `failed` (returning 0) for unhandled constructs.
function lowerExprH(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  let tag = n.tag
  if (tag == Tag.StrInterp) {
    return lowerStrInterp(fc, node)
  }
  if (tag == Tag.IntLit) {
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstInt, ty)
    ins.ival = parseIntText(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.BoolLit) {
    let ins = mkInstr(Op.ConstBool, primType(fc.c.ctx, 10))
    ins.bval = fc.c.source[n.span.start:n.span.end] == "true"
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.RuneLit) {
    // A rune's code point is a `const_int`, materialized at the context width
    // (`p[0] == '/'` over u8 -> const_int u8 47), like an int literal.
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstInt, ty)
    ins.ival = parseRuneText(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.NilLit) {
    // `nil` adopts its context type (a ref/interface); the dump shows no type.
    let ty = hint
    if (ty == 0) {
      ty = defaultType(fc.c, nodeType(fc, node))
    }
    return builderEmit(fc.b, mkInstr(Op.ConstNil, ty))
  }
  if (tag == Tag.FloatLit) {
    // An untyped float literal defaults to f64; an f32/f64 context adopts the
    // hint. `parseFloat` yields the same bits the seed does (both format via
    // `{d}`), so the const_float dump matches byte-for-byte.
    let ty = defaultType(fc.c, nodeType(fc, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstFloat, ty)
    ins.fval = parseFloat(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.StringLit) {
    let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
    ins.sval = decodeStringContent(fc.c.source, n.span.start, n.span.end)
    ins.ival = internPoolString(fc, ins.sval)
    return builderEmit(fc.b, ins)
  }
  // A raw string `` `...` `` has no escape processing (SPEC 5.6); only a CRLF
  // pair normalizes to a lone LF, so the source text between the backticks is
  // the value. Mirrors seed lower.zig `normalizeRaw`.
  if (tag == Tag.RawStringLit) {
    let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
    ins.sval = normalizeRawString(fc.c.source[n.span.start + 1:n.span.end - 1])
    ins.ival = internPoolString(fc, ins.sval)
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.Call) {
    return lowerCall(fc, node)
  }
  if (tag == Tag.AsmStmt) {
    return lowerAsm(fc, node)
  }
  if (tag == Tag.CompositeLit) {
    return lowerCompositeLit(fc, node)
  }
  if (tag == Tag.SliceLit) {
    let st = defaultType(fc.c, nodeType(fc, node))
    // A `[]Shape` context types `[nil]` as `[]Shape`, not the inferred
    // `[]untyped_nil`; prefer the hint slice type.
    if (hint != 0 && fc.c.ctx.types[hint].kind == TypeKind.Slice) {
      st = hint
    }
    if (fc.c.ctx.types[st].kind != TypeKind.Slice) {
      fc.failed = true
      return 0
    }
    return lowerSliceElems(fc, st, kidsOf(fc.c.tree, node))
  }
  if (tag == Tag.Member) {
    return lowerFieldAccess(fc, node)
  }
  if (tag == Tag.Index) {
    return lowerIndex(fc, node)
  }
  if (tag == Tag.SliceExpr) {
    return lowerSliceExpr(fc, node)
  }
  if (tag == Tag.Ident) {
    return lowerNamedValue(fc, node, fc.c.source[n.span.start:n.span.end])
  }
  if (tag == Tag.Unary) {
    return lowerUnary(fc, node, hint)
  }
  if (tag == Tag.Binary) {
    if (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe)) {
      return lowerShortCircuit(fc, node)
    }
    if (isRelationalOp(n.main)) {
      return lowerComparison(fc, node)
    }
    let ty = defaultType(fc.c, nodeType(fc, node))
    // String `+` is concatenation via the runtime, not an `add`.
    if (fc.c.ctx.types[ty].kind == TypeKind.Prim && fc.c.ctx.types[ty].prim == 11 &&
      n.main == int(Kind.Plus)) {
      let kids = kidsOf(fc.c.tree, node)
      let l = lowerExpr(fc, kids[0])
      let r = lowerExpr(fc, kids[1])
      if (fc.failed) {
        return 0
      }
      let sc = mkInstr(Op.RtCall, ty)
      sc.name = "string_concat"
      sc.args = [l, r]
      return emitRtCall(fc, sc)
    }
    // Pointer arithmetic (§11.4): `p ± n` scales `n` by sizeOf(elem) and offsets
    // the raw address. A `*T` is an int-classed word (is_ref=0), so this is plain
    // integer add/sub. The scaled byte offset is retyped to the pointer type with
    // a no-op `convert` so add/sub's operands and result share a type.
    if (fc.c.ctx.types[ty].kind == TypeKind.Ptr &&
      (n.main == int(Kind.Plus) || n.main == int(Kind.Minus))) {
      let pk = kidsOf(fc.c.tree, node)
      let elemTy = fc.c.ctx.types[ty].elem
      let scale = fieldLayoutFor(fc, elemTy).size
      let i64ty = primType(fc.c.ctx, 3)
      let baseVal = lowerExprH(fc, pk[0], ty)
      let off = lowerExprH(fc, pk[1], i64ty)
      if (fc.failed) {
        return 0
      }
      if (scale != 1) {
        let sc = mkInstr(Op.ConstInt, i64ty)
        sc.ival = scale
        let ml = mkInstr(Op.Mul, i64ty)
        ml.lhs = off
        ml.rhs = builderEmit(fc.b, sc)
        off = builderEmit(fc.b, ml)
      }
      let paConv = mkInstr(Op.Convert, ty)
      paConv.lhs = off
      let offPtr = builderEmit(fc.b, paConv)
      let pop = Op.Add
      if (n.main == int(Kind.Minus)) {
        pop = Op.Sub
      }
      let ins = mkInstr(pop, ty)
      ins.lhs = baseVal
      ins.rhs = offPtr
      return builderEmit(fc.b, ins)
    }
    let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
      (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
    let signed = !(fc.c.ctx.types[ty].kind == TypeKind.Prim &&
      fc.c.ctx.types[ty].prim >= 4 && fc.c.ctx.types[ty].prim <= 7)
    let op = binOpFor(n.main, isFloat, signed)
    if (op == Op.BlockParam) {
      fc.failed = true
      return 0
    }
    let kids = kidsOf(fc.c.tree, node)
    // Operands take the operation's type as context, so an untyped literal
    // operand materializes at the same width (`a + 1` over i32 -> const_int i32).
    let lhs = lowerExprH(fc, kids[0], ty)
    let rhs = lowerExprH(fc, kids[1], ty)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(op, ty)
    ins.lhs = lhs
    ins.rhs = rhs
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.TypeAssert) {
    return lowerTypeAssert(fc, node)
  }
  if (tag == Tag.ArrowFn) {
    return lowerArrowFn(fc, node)
  }
  if (tag == Tag.TryExpr) {
    return lowerTryExpr(fc, node)
  }
  if (tag == Tag.CatchDefault) {
    return lowerCatch(fc, node, false)
  }
  if (tag == Tag.CatchBind) {
    return lowerCatch(fc, node, true)
  }
  if (tag == Tag.MatchStmt) {
    return lowerMatchExpr(fc, node)
  }
  // `t.0` — a field read at the element's offset in the boxed tuple (ABI.md
  // §1.1). The checker has already range-checked the index against the arity.
  if (tag == Tag.TupleIndex) {
    let tk = kidsOf(fc.c.tree, node)
    let tupTy = nodeType(fc, tk[0])
    if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
      fc.failed = true
      return 0
    }
    let idxNode = getNode(fc.c.tree, tk[1])
    let idx = parseIntText(fc.c.source[idxNode.span.start:idxNode.span.end])
    if (idx < 0 || idx >= len(fc.c.ctx.types[tupTy].members)) {
      fc.failed = true
      return 0
    }
    let recv = lowerExpr(fc, tk[0])
    if (fc.failed) {
      return 0
    }
    return tupleElem(fc, tupTy, recv, idx)
  }
  fc.failed = true
  return 0
}

// Lowers the one-result assertion `iface.(T)` (SPEC §14.4): the receiver, then
// `T`'s TypeInfo descriptor, then `rt_call iface_assert(recv, info) T` — which
// panics on a mismatch. The two-result form `(v, ok) = iface.(T)` routes through
// the assign path instead.
function lowerTypeAssert(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let ty = nodeType(fc, node)
  let recv = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let info = lowerTypeInfo(fc, ty)
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, ty)
  ins.name = "iface_assert"
  ins.args = [recv, info]
  return emitRtCall(fc, ins)
}

// The two-result forms `<- c` / `m[k]` / `iface.(T)` (SPEC §12.6/§14.4/§16.2),
// returning [value, ok] — or an empty list if `node` is none of them. The
// chan/interface `ok` comes from a call reporting the immediately preceding one
// (ABI.md §2.2/§11), so each pair is emitted back to back.
function lowerTwoResult(fc: FnCtx, node: int): []int {
  let n = getNode(fc.c.tree, node)
  let k = kidsOf(fc.c.tree, node)
  let valTy = nodeType(fc, node)
  let boolTy = primType(fc.c.ctx, 10)
  if (n.tag == Tag.Unary && n.main == int(Kind.ArrowLeft)) {
    let ch = lowerExpr(fc, k[0])
    if (fc.failed) {
      return []int(0)
    }
    let rv = mkInstr(Op.RtCall, valTy)
    rv.name = "chan_recv"
    rv.args = [ch]
    let v = emitRtCall(fc, rv)
    let okI = mkInstr(Op.RtCall, boolTy)
    okI.name = "chan_recv_ok"
    return [v, emitRtCall(fc, okI)]
  }
  if (n.tag == Tag.Index) {
    let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
    if (fc.c.ctx.types[recvTy].kind != TypeKind.Map) {
      return []int(0)
    }
    let m = lowerExpr(fc, k[0])
    let key = lowerExprH(fc, k[1], fc.c.ctx.types[recvTy].mapKey)
    if (fc.failed) {
      return []int(0)
    }
    let gv = mkInstr(Op.RtCall, valTy)
    gv.name = "map_get"
    gv.args = [m, key]
    let v = emitRtCall(fc, gv)
    let hv = mkInstr(Op.RtCall, boolTy)
    hv.name = "map_has"
    hv.args = [m, key]
    return [v, emitRtCall(fc, hv)]
  }
  if (n.tag == Tag.TypeAssert) {
    let recv = lowerExpr(fc, k[0])
    if (fc.failed) {
      return []int(0)
    }
    let info = lowerTypeInfo(fc, valTy)
    if (fc.failed) {
      return []int(0)
    }
    let av = mkInstr(Op.RtCall, valTy)
    av.name = "iface_as"
    av.args = [recv, info]
    let v = emitRtCall(fc, av)
    let okI = mkInstr(Op.RtCall, boolTy)
    okI.name = "iface_as_ok"
    return [v, emitRtCall(fc, okI)]
  }
  return []int(0)
}

// Rebinds a name in the CHECKER for the body being lowered, so a later
// `checkExprType` on that name sees the type this scope/instance actually gives
// it (see lowerFunc). Both of the checker's name paths are written: the flat
// `env` by name, and `declTypes` at the binder's own node — the decl path a
// reference resolves through (nodeSymbols -> Symbol.decl -> declTypes, #1502).
// Writing only the env would leave the decl path holding the check pass's
// best-effort type, which for a monomorphized instance is the bare template.
function rebindCheckerName(fc: FnCtx, identNode: int, ty: int) {
  let n = getNode(fc.c.tree, identNode)
  fc.c.env[fc.c.source[n.span.start:n.span.end]] = ty
  if (identNode > 0 && identNode < len(fc.c.declTypes)) {
    fc.c.declTypes[identNode] = ty
  }
}

// Binds a two-result binder unless it is the blank `_` (which discards).
function declareUnlessBlank(fc: FnCtx, patNode: int, val: int, ty: int) {
  let pn = getNode(fc.c.tree, patNode)
  let name = fc.c.source[pn.span.start:pn.span.end]
  if (name == "_") {
    return
  }
  declareLocal(fc, name, val, ty)
  rebindCheckerName(fc, patNode, ty)
}

// The body layout of a boxed tuple (ABI.md §1.1) — a tuple is laid out exactly
// like a struct, so its element types go straight to `layoutFields`.
function tupleLayout(fc: FnCtx, ty: int): StructLayout {
  return layoutFields(fc, fc.c.ctx.types[ty].members)
}

// Boxes `vals` into a fresh tuple record of type `tupTy` (ABI.md §1.1): the same
// `gc_alloc` + one store per element that a struct composite literal emits,
// because a tuple is a struct without names.
function buildTuple(fc: FnCtx, tupTy: int, vals: []int): int {
  let layout = tupleLayout(fc, tupTy)
  let ga = mkInstr(Op.GcAlloc, tupTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  let i = 0
  while (i < len(vals)) {
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[i]
    fs.rhs = vals[i]
    builderEmit(fc.b, fs)
    i = i + 1
  }
  return obj
}

// Reads element `idx` out of the boxed tuple `recv` (ABI.md §1.1).
function tupleElem(fc: FnCtx, tupTy: int, recv: int, idx: int): int {
  let layout = tupleLayout(fc, tupTy)
  let fg = mkInstr(Op.FieldGet, fc.c.ctx.types[tupTy].members[idx])
  fg.lhs = recv
  fg.ival = layout.offsets[idx]
  return builderEmit(fc.b, fg)
}

// Binds each of `pats` to the corresponding element of the boxed tuple `val`,
// recursing into nested patterns (SPEC §10.1 `pat = IDENT | "_" | tuple_pat`).
// Arity is checker-enforced; a mismatch is refused rather than read past the end
// of the layout.
function destructureTuple(fc: FnCtx, pats: []int, tupTy: int, val: int) {
  if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    fc.failed = true
    return
  }
  let members = fc.c.ctx.types[tupTy].members
  if (len(members) != len(pats)) {
    fc.failed = true
    return
  }
  let i = 0
  while (i < len(pats)) {
    let pn = getNode(fc.c.tree, pats[i])
    if (pn.tag == Tag.TuplePat) {
      destructureTuple(fc, kidsOf(fc.c.tree, pats[i]), members[i], tupleElem(fc, tupTy, val, i))
      if (fc.failed) {
        return
      }
    } else {
      // `_` discards: skip the load entirely rather than emit a dead one.
      if (fc.c.source[pn.span.start:pn.span.end] != "_") {
        declareUnlessBlank(fc, pats[i], tupleElem(fc, tupTy, val, i), members[i])
      }
    }
    i = i + 1
  }
}

// `let (v, ok) = <two-result>` (SPEC §12.6/§14.4/§16.2), or the general
// `let (a, b, ...) = <tuple>` destructure (§10.1).
//
// The two-result forms are tried first and only at arity 2: `m[k]` and `<- c`
// are not tuple-typed — they are a value plus a separate presence flag — so they
// can never fall through to the tuple path, and a tuple can never be mistaken
// for one.
function lowerTwoResultLet(fc: FnCtx, binding: int) {
  let bk = kidsOf(fc.c.tree, binding)
  let pats = kidsOf(fc.c.tree, bk[0])
  if (bk[2] == 0) {
    fc.failed = true
    return
  }
  if (len(pats) == 2 && allIdentPats(fc, pats)) {
    let two = lowerTwoResult(fc, bk[2])
    if (fc.failed) {
      return
    }
    if (len(two) == 2) {
      declareUnlessBlank(fc, pats[0], two[0], nodeType(fc, bk[2]))
      declareUnlessBlank(fc, pats[1], two[1], primType(fc.c.ctx, 10))
      return
    }
  }
  let tupTy = nodeType(fc, bk[2])
  let val = lowerExpr(fc, bk[2])
  if (fc.failed) {
    return
  }
  destructureTuple(fc, pats, tupTy, val)
}

// Rebinds an existing local destructuring target to `val`. `_` discards, so it
// names no slot to rebind.
function assignEnvSlot(fc: FnCtx, target: int, val: int) {
  let tn = getNode(fc.c.tree, target)
  if (tn.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let name = fc.c.source[tn.span.start:tn.span.end]
  if (name == "_") {
    return
  }
  let ix = envIndex(fc, name)
  if (ix == -1) {
    fc.failed = true
    return
  }
  fc.env[ix].value = val
}

// True when every pattern is a plain identifier (so the two-result shape, which
// binds exactly two names, applies).
function allIdentPats(fc: FnCtx, pats: []int): bool {
  let i = 0
  while (i < len(pats)) {
    if (getNode(fc.c.tree, pats[i]).tag != Tag.Ident) {
      return false
    }
    i = i + 1
  }
  return true
}

// Emits a `type_info` for struct type `ty`: `disc` is the type id, `size` and
// `ptrs` its GC layout (ABI.md §2). Typed `u64` — it is a `.rodata` address, not
// a traced reference. The checker restricts assertion targets to structs.
function lowerTypeInfo(fc: FnCtx, ty: int): int {
  let decl = structDeclOf(fc.c, ty)
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let layout = structLayout(fc, typeOwner(fc.c, ty), decl, noSubst())
  let ti = mkInstr(Op.TypeInfo, primType(fc.c.ctx, 7))
  ti.ival = ty
  ti.ival2 = layout.size
  ti.offsets = layout.ptrOffsets
  return builderEmit(fc.b, ti)
}

// A concrete value flowing into an interface-typed slot is relabelled to the
// interface via `convert` (the pointer is unchanged; SPEC §14.3). `valTy` is the
// value's source type; a value already of the interface type passes through.
function coerceToIface(fc: FnCtx, val: int, valTy: int, targetTy: int): int {
  if (fc.c.ctx.types[targetTy].kind != TypeKind.Interface || valTy == targetTy) {
    return val
  }
  // A concrete struct (or a different interface) needs the relabel. An untyped
  // `nil` was lowered with the interface hint, so it is already that type — no
  // convert (matches the seed, which checks the value's actual IR type).
  let k = fc.c.ctx.types[valTy].kind
  if (k != TypeKind.Struct && k != TypeKind.Interface) {
    return val
  }
  let cv = mkInstr(Op.Convert, targetTy)
  cv.lhs = val
  return builderEmit(fc.b, cv)
}

// Lowers a unary `-x` (neg/fneg), `~x` (bnot), `!x`, or `<- ch`. The operand
// adopts the unary's materialized type so an untyped literal takes the context
// width (`let n: i8 = -5` -> `const_int i8 5; neg i8`).
function lowerUnary(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  let opNode = kidsOf(fc.c.tree, node)[0]
  // The result type, adopting a concrete numeric hint when the node is untyped
  // (the seed's materializeType).
  let raw = nodeType(fc, node)
  let ty = defaultType(fc.c, raw)
  if (isNumericPrim(fc, hint) && isUntyped(fc.c, raw)) {
    ty = hint
  }
  // `<- ch`: receive one word from a channel; the operand is the channel (lowered
  // plainly), the value is the result. The two-result `(v, ok) = <- ch` form
  // routes through the assign path.
  if (n.main == int(Kind.ArrowLeft)) {
    let operand = lowerExpr(fc, opNode)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "chan_recv"
    ins.args = [operand]
    return emitRtCall(fc, ins)
  }
  // `*p` (§11.4): load one word from the pointed-at address. Reuses FieldGet at
  // offset 0 — a plain `base + 0` load, no GC barrier. `ty` is the pointee.
  if (n.main == int(Kind.Star)) {
    let p = lowerExpr(fc, opNode)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.FieldGet, ty)
    ins.lhs = p
    ins.ival = 0
    return builderEmit(fc.b, ins)
  }
  let operand = lowerExprH(fc, opNode, ty)
  if (fc.failed) {
    return 0
  }
  // Logical not `!x` is `x == false` (§12.4).
  if (n.main == int(Kind.Bang)) {
    let f = mkInstr(Op.ConstBool, ty)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let eq = mkInstr(Op.ICmpEq, ty)
    eq.lhs = operand
    eq.rhs = fV
    return builderEmit(fc.b, eq)
  }
  let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
  let uop = Op.BlockParam
  if (n.main == int(Kind.Minus)) {
    if (isFloat) {
      uop = Op.FNeg
    } else {
      uop = Op.Neg
    }
  } else if (n.main == int(Kind.Tilde)) {
    uop = Op.BNot
  }
  if (uop == Op.BlockParam) {
    fc.failed = true
    return 0
  }
  let ins = mkInstr(uop, ty)
  ins.lhs = operand
  return builderEmit(fc.b, ins)
}

// Lowers a relational comparison to a bool: strings via `rt_call string_eq`
// (only `==` for now), floats via `fcmp_*`, ints via signed/unsigned `icmp_*`
// picked from the operand type.
function lowerComparison(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  // The comparison type is the operands merged, so a literal operand takes the
  // other's concrete width (`x == 0` over u8 -> both u8).
  let operandTy = defaultType(fc.c, mergeTypes(fc.c, nodeType(fc, kids[0]),
    nodeType(fc, kids[1])))
  let td = fc.c.ctx.types[operandTy]
  let boolTy = primType(fc.c.ctx, 10)
  let lhs = lowerExprH(fc, kids[0], operandTy)
  let rhs = lowerExprH(fc, kids[1], operandTy)
  if (fc.failed) {
    return 0
  }
  // String (in)equality dispatches to `string_eq`; `!=` negates it via `== false`
  // (the seed's form). Ordered string comparisons fall back for now.
  if (td.kind == TypeKind.Prim && td.prim == 11) {
    if (opKind != int(Kind.EqEq) && opKind != int(Kind.BangEq)) {
      fc.failed = true
      return 0
    }
    let se = mkInstr(Op.RtCall, boolTy)
    se.name = "string_eq"
    se.args = [lhs, rhs]
    let eq = emitRtCall(fc, se)
    if (opKind == int(Kind.EqEq)) {
      return eq
    }
    let f = mkInstr(Op.ConstBool, boolTy)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let ne = mkInstr(Op.ICmpEq, boolTy)
    ne.lhs = eq
    ne.rhs = fV
    return builderEmit(fc.b, ne)
  }
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  let cop = cmpOpFor(opKind, isFloat, signed)
  if (cop == Op.BlockParam) {
    fc.failed = true
    return 0
  }
  let ins = mkInstr(cop, boolTy)
  ins.lhs = lhs
  ins.rhs = rhs
  return builderEmit(fc.b, ins)
}

// Emits a `jump target(args)` terminator.
function emitJump(fc: FnCtx, target: int, args: []int) {
  let ins = mkInstr(Op.Jump, fc.c.ctx.voidId)
  ins.ival = target
  ins.args = args
  builderEmit(fc.b, ins)
}

// Lowers a short-circuit `a && b` / `a || b` to a bool value: branch on `a`;
// only when it doesn't decide the result is `b` evaluated in its own block; the
// join block's single bool parameter is the result. The condition sub-blocks
// carry just the bool value (no live locals — the operands are side-effect-free
// for env purposes). Mirrors the seed's lowerShortCircuit; join left open.
function lowerShortCircuit(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  let boolTy = primType(fc.c.ctx, 10)
  let lval = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let rhsBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = lval
  if (opKind == int(Kind.AmpAmp)) {
    // `a && b`: a true -> evaluate b; a false -> result is a.
    br.ival = rhsBlk
    br.thenArgs = []int(0)
    br.ival2 = join
    br.elseArgs = [lval]
  } else {
    // `a || b`: a true -> result is a; a false -> evaluate b.
    br.ival = join
    br.thenArgs = [lval]
    br.ival2 = rhsBlk
    br.elseArgs = []int(0)
  }
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, rhsBlk)
  let rval = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [rval])
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, boolTy)
}

// Lowers an `if (cond) then [else]` to br + then/else/join blocks, threading the
// live locals (env[0..preLen]) as join-block parameters — the seed's lowerIf.
// The join block is left open for the following statements.
function lowerIf(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let thenBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let hasElse = k[2] != 0
  let elseBlk = join
  if (hasElse) {
    elseBlk = builderNewBlock(fc.b)
  }
  // Branch: then edge carries no args; a missing else sends the fall-through
  // edge to the join with the live locals.
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = thenBlk
  br.thenArgs = []int(0)
  br.ival2 = elseBlk
  if (hasElse) {
    br.elseArgs = []int(0)
  } else {
    br.elseArgs = orig
  }
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, thenBlk)
  fc.terminated = false
  lowerStmtList(fc, k[1])
  let joinReachable = !hasElse
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)

  if (hasElse) {
    builderBeginBlock(fc.b, elseBlk)
    fc.terminated = false
    if (getNode(fc.c.tree, k[2]).tag == Tag.IfStmt) {
      lowerIf(fc, k[2])
    } else {
      lowerStmtList(fc, k[2])
    }
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
  }

  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// A single switch-case label test: `subject == label` for a subject switch, or
// the label evaluated as a bool for a subject-less switch.
function caseTest(fc: FnCtx, hasSubject: bool, subject: int, subjectTy: int, expr: int): int {
  if (!hasSubject) {
    return lowerExprH(fc, expr, primType(fc.c.ctx, 10))
  }
  let eq = mkInstr(Op.ICmpEq, primType(fc.c.ctx, 10))
  eq.lhs = subject
  eq.rhs = lowerExprH(fc, expr, subjectTy)
  return builderEmit(fc.b, eq)
}

// Lowers a `switch (subject) { case a, b: ...; default: ... }` over a value to a
// decision chain: each case's `subject == expr` (OR-folded across its labels)
// branches to the body or the next test; an unmatched value falls to `default`.
// ponytail: subject-less `switch { case cond: }` and break-in-case deferred.
function lowerSwitch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let boolTy = primType(fc.c.ctx, 10)
  // Subject-less `switch { case cond: ... }`: each label is a bool condition
  // tested directly. A subject switch compares `subject == label`.
  let hasSubject = k[0] != 0
  let subjectTy = boolTy
  let subject = 0
  if (hasSubject) {
    subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
    subject = lowerExprH(fc, k[0], subjectTy)
    if (fc.failed) {
      return
    }
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let cases = kidsOf(fc.c.tree, k[1])
  // Count the non-default cases and find the default body.
  let m = 0
  let defaultStmts = 0
  let ci = 0
  while (ci < len(cases)) {
    let t = getNode(fc.c.tree, cases[ci]).tag
    if (t == Tag.SwitchCase) {
      m = m + 1
    } else if (t == Tag.SwitchDefault) {
      defaultStmts = kidsOf(fc.c.tree, cases[ci])[0]
    }
    ci = ci + 1
  }
  let join = builderNewBlock(fc.b)
  let dflt = 0
  if (m > 0) {
    dflt = builderNewBlock(fc.b)
  }
  // A switch is a `break` target (to the join) but not a `continue` target.
  fc.loops = append(fc.loops, LoopFrame{ exit: join, cont: join, preLen: preLen, isSwitch: true })
  let joinReachable = false
  let seen = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.SwitchCase) {
      ci = ci + 1
      continue
    }
    let ck = kidsOf(fc.c.tree, cases[ci])
    let exprs = kidsOf(fc.c.tree, ck[0])
    let cond = caseTest(fc, hasSubject, subject, subjectTy, exprs[0])
    let ei = 1
    while (ei < len(exprs)) {
      let bor = mkInstr(Op.BOr, boolTy)
      bor.lhs = cond
      bor.rhs = caseTest(fc, hasSubject, subject, subjectTy, exprs[ei])
      cond = builderEmit(fc.b, bor)
      ei = ei + 1
    }
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = dflt
    if (seen != m - 1) {
      nextBlk = builderNewBlock(fc.b)
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    restoreValues(fc, orig)
    let mark = len(fc.env)
    lowerStmtList(fc, ck[1])
    truncateEnv(fc, mark)
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    seen = seen + 1
    ci = ci + 1
  }
  // Positioned in the "no case matched" block (dflt when m>0, else the caller's).
  fc.terminated = false
  restoreValues(fc, orig)
  if (defaultStmts != 0) {
    let mark = len(fc.env)
    lowerStmtList(fc, defaultStmts)
    truncateEnv(fc, mark)
  }
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// `select { case <comm>: <body> ... default: <body> }` (SPEC §16.3): each comm
// clause's channel operand (and a send's value) is evaluated once into a
// select_alloc'd descriptor buffer of 32-byte entries {dir @0, chan @8, word @16,
// ok @24}; the runtime `select` returns the fired case index (or n for default),
// which then dispatches like a value switch, binding a recv case's received word
// (field_get buf[off+16]) before its body. `nconst` is emitted once and shared by
// select_alloc and select.
function lowerSelect(fc: FnCtx, node: int) {
  let i64ty = primType(fc.c.ctx, 3)
  let boolTy = primType(fc.c.ctx, 10)
  let cases = kidsOf(fc.c.tree, node)
  // Count comm cases; find the default body.
  let n = 0
  let defaultStmts = 0
  let ci = 0
  while (ci < len(cases)) {
    let t = getNode(fc.c.tree, cases[ci]).tag
    if (t == Tag.CommCase) {
      n = n + 1
    } else if (t == Tag.CommDefault) {
      defaultStmts = kidsOf(fc.c.tree, cases[ci])[0]
    }
    ci = ci + 1
  }
  let hasDefault = defaultStmts != 0
  // Pass 1: allocate the descriptor buffer, evaluate every comm exactly once.
  let nc = mkInstr(Op.ConstInt, i64ty)
  nc.ival = n
  let nconst = builderEmit(fc.b, nc)
  let alloc = mkInstr(Op.RtCall, i64ty)
  alloc.name = "select_alloc"
  alloc.args = [nconst]
  let buf = emitRtCall(fc, alloc)
  let idx = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.CommCase) {
      ci = ci + 1
      continue
    }
    let comm = kidsOf(fc.c.tree, cases[ci])[0]
    let off = idx * 32
    if (getNode(fc.c.tree, comm).tag == Tag.SendStmt) {
      let sk = kidsOf(fc.c.tree, comm)
      let chanTy = defaultType(fc.c, nodeType(fc, sk[0]))
      let ch = lowerExpr(fc, sk[0])
      let v = lowerExprH(fc, sk[1], fc.c.ctx.types[chanTy].elem)
      let dc = mkInstr(Op.ConstInt, i64ty)
      dc.ival = 1
      selectSet(fc, buf, off + 0, builderEmit(fc.b, dc))
      selectSet(fc, buf, off + 8, ch)
      selectSet(fc, buf, off + 16, v)
    } else {
      // recv_bind: [binder_or_none, chan]
      let ch = lowerExpr(fc, kidsOf(fc.c.tree, comm)[1])
      let dc = mkInstr(Op.ConstInt, i64ty)
      selectSet(fc, buf, off + 0, builderEmit(fc.b, dc))
      selectSet(fc, buf, off + 8, ch)
    }
    idx = idx + 1
    ci = ci + 1
  }
  if (fc.failed) {
    return
  }
  let hd = mkInstr(Op.ConstInt, i64ty)
  if (hasDefault) {
    hd.ival = 1
  }
  let sel = mkInstr(Op.RtCall, i64ty)
  sel.name = "select"
  sel.args = [buf, nconst, builderEmit(fc.b, hd)]
  let fired = emitRtCall(fc, sel)

  // Pass 2: dispatch on `fired` — a value switch, binding recv results.
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let dflt = builderNewBlock(fc.b)
  fc.loops = append(fc.loops, LoopFrame{ exit: join, cont: join, preLen: preLen, isSwitch: true })
  let joinReachable = false
  let seen = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.CommCase) {
      ci = ci + 1
      continue
    }
    let ck = kidsOf(fc.c.tree, cases[ci])
    let comm = ck[0]
    let off = seen * 32
    let cst = mkInstr(Op.ConstInt, i64ty)
    cst.ival = seen
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = fired
    eq.rhs = builderEmit(fc.b, cst)
    let cond = builderEmit(fc.b, eq)
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = dflt
    if (seen != n - 1) {
      nextBlk = builderNewBlock(fc.b)
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    restoreValues(fc, orig)
    let mark = len(fc.env)
    // A recv case with a binder reads the received word from the descriptor.
    if (getNode(fc.c.tree, comm).tag == Tag.RecvBind) {
      let rk = kidsOf(fc.c.tree, comm)
      if (rk[0] != 0) {
        let bn = getNode(fc.c.tree, rk[0])
        if (bn.tag != Tag.Ident) {
          fc.failed = true
          return
        }
        let elemTy = fc.c.ctx.types[defaultType(fc.c, nodeType(fc, rk[1]))].elem
        let fg = mkInstr(Op.FieldGet, elemTy)
        fg.lhs = buf
        fg.ival = off + 16
        let rv = builderEmit(fc.b, fg)
        let name = fc.c.source[bn.span.start:bn.span.end]
        declareLocal(fc, name, rv, elemTy)
        rebindCheckerName(fc, rk[0], elemTy)
      }
    }
    lowerStmtList(fc, ck[1])
    truncateEnv(fc, mark)
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    seen = seen + 1
    ci = ci + 1
  }
  if (fc.failed) {
    return
  }
  // "no case matched" (dflt) block: run the default body, if any, then join.
  fc.terminated = false
  restoreValues(fc, orig)
  if (hasDefault) {
    let mark = len(fc.env)
    lowerStmtList(fc, defaultStmts)
    truncateEnv(fc, mark)
  }
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Emits `field_set buf[off] = val` for a select descriptor word.
function selectSet(fc: FnCtx, buf: int, off: int, val: int) {
  let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs.lhs = buf
  fs.ival = off
  fs.rhs = val
  builderEmit(fc.b, fs)
}

// Lowers a match arm's body — a `{ … }` block or a single statement.
function lowerArmBody(fc: FnCtx, body: int) {
  if (getNode(fc.c.tree, body).tag == Tag.Block) {
    lowerStmtList(fc, body)
  } else {
    lowerStmt(fc, body)
  }
}

// Lowers one match-statement arm's body in the current block; on a non-diverging
// arm, carries the live locals to `join`. Returns whether the join is reached.
// The scrutinee tag: a boxed enum's tag is word 0 of the object (i64); a C-like
// enum's value IS its tag.
function matchTag(fc: FnCtx, subject: int, subjectTy: int, boxed: bool): int {
  if (!boxed) {
    return subject
  }
  let fg = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  fg.lhs = subject
  fg.ival = 0
  return builderEmit(fc.b, fg)
}

// The tag type used for the arm comparison: i64 for boxed, the enum type for
// C-like (so the compare operands share a type).
function tagType(fc: FnCtx, subjectTy: int, boxed: bool): int {
  if (boxed) {
    return primType(fc.c.ctx, 3)
  }
  return subjectTy
}

// Binds a boxed variant arm's payload `V(a, b) =>`: word i of the box (object
// word 8) into binder i. No-op for a C-like enum or a no-binder arm.
function bindArmPayload(fc: FnCtx, arm: int, boxed: bool, enumTy: int, subject: int, scrutinee: int) {
  if (!boxed) {
    return
  }
  let vp = kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])
  if (vp[1] == 0) {
    return
  }
  let vn = getNode(fc.c.tree, vp[0])
  let ptypes = variantPayloadTypes(fc.c, enumTy, fc.c.source[vn.span.start:vn.span.end])
  // A generic enum's payload types are bare type-params; resolve them to the
  // scrutinee's concrete type-args (`Opt<i64>.Some(v)` binds v at i64).
  let typeArgs = scrutineeTypeArgs(fc.c, scrutinee)
  // The scrutinee's type-arg NODES, so a payload binder whose type is itself a
  // generic instance (`inner: Opt<i64>` from `Opt<Opt<i64>>.Some(inner)`) records
  // its declared type node — letting a nested match on it recover its type-args.
  let typeArgNodes = scrutineeTypeArgNodes(fc.c, scrutinee)
  let binders = kidsOf(fc.c.tree, vp[1])
  let box = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  box.lhs = subject
  box.ival = 8
  let boxV = builderEmit(fc.b, box)
  let i = 0
  while (i < len(binders)) {
    let bty = primType(fc.c.ctx, 3)
    if (i < len(ptypes)) {
      bty = substPayloadType(fc.c, enumTy, ptypes[i], typeArgs)
    }
    let fg = mkInstr(Op.FieldGet, bty)
    fg.lhs = boxV
    fg.ival = 8 * i
    let bn = getNode(fc.c.tree, binders[i])
    let bname = fc.c.source[bn.span.start:bn.span.end]
    declareLocal(fc, bname, builderEmit(fc.b, fg), bty)
    // Keep the checker consistent so `checkExprType` types the binder during
    // lowering (see lowerFunc).
    rebindCheckerName(fc, binders[i], bty)
    if (i < len(ptypes) && fc.c.ctx.types[ptypes[i]].kind == TypeKind.TypeParam) {
      let idx = enumTypeParamIndex(fc.c, enumTy, fc.c.ctx.types[ptypes[i]].name)
      if (idx >= 0 && idx < len(typeArgNodes)) {
        fc.c.declTypeNodes[bname] = typeArgNodes[idx]
      }
    }
    i = i + 1
  }
}

function lowerMatchArm(fc: FnCtx, arm: int, preLen: int, join: int, boxed: bool, enumTy: int, subject: int, scrutinee: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, subject, scrutinee)
  lowerArmBody(fc, ak[1])
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, snapshotValues(fc, preLen))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => body, ... }` statement over an enum to a
// decision tree: each arm but the last tests `tag == <ordinal>` and branches to
// its body or the next test; the last arm is the exhaustive fallthrough. A `join`
// block merges the non-diverging arms (unreachable if every arm diverges). A
// boxed enum's tag is object word 0 and its arms bind the payload.
function lowerMatch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fc.failed = true
    return
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return
  }
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchArm(fc, arm, preLen, join, boxed, subjectTy, subject, k[0])) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  // Last arm: the exhaustive fallthrough, lowered in the current block with no
  // test.
  fc.terminated = false
  if (lowerMatchArm(fc, arms[len(arms) - 1], preLen, join, boxed, subjectTy, subject, k[0])) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Lowers one match-expression arm: its body is an *expression* whose value is
// carried to the join as the trailing block param. Returns whether the join is
// reached.
function lowerMatchExprArm(fc: FnCtx, arm: int, preLen: int, join: int, resultTy: int, isVoid: bool, boxed: bool, enumTy: int, subject: int, scrutinee: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumTy, subject, scrutinee)
  let val = 0
  if (isVoid) {
    lowerExpr(fc, ak[1])
  } else {
    val = lowerExprH(fc, ak[1], resultTy)
  }
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), val, isVoid))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => expr, ... }` in expression position over a
// C-like enum: like the statement form, but each arm yields a value merged at the
// The result type of a generic-enum match expression: the first arm's body type
// with its payload binders substituted to the scrutinee's concrete type-args, so
// `match(o: Opt<i64>){ Some(v)=>v ... }` yields i64, not the bare type-param.
function matchExprResultTy(fc: FnCtx, node: int, enumTy: int): int {
  let k = kidsOf(fc.c.tree, node)
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return fc.c.ctx.voidId
  }
  let ak = kidsOf(fc.c.tree, arms[0])
  let vp = kidsOf(fc.c.tree, ak[0])
  let typeArgs = scrutineeTypeArgs(fc.c, k[0])
  if (vp[1] != 0) {
    let vn = getNode(fc.c.tree, vp[0])
    let ptypes = variantPayloadTypes(fc.c, enumTy, fc.c.source[vn.span.start:vn.span.end])
    let binders = kidsOf(fc.c.tree, vp[1])
    let i = 0
    while (i < len(binders)) {
      let bt = primType(fc.c.ctx, 3)
      if (i < len(ptypes)) {
        bt = substPayloadType(fc.c, enumTy, ptypes[i], typeArgs)
      }
      rebindCheckerName(fc, binders[i], bt)
      i = i + 1
    }
  }
  return defaultType(fc.c, nodeType(fc, ak[1]))
}

// join's trailing param — the whole match's value. ponytail: boxed enums deferred.
function lowerMatchExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let resultTy = defaultType(fc.c, nodeType(fc, node))
  let subjectTy = defaultType(fc.c, nodeType(fc, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fc.failed = true
    return 0
  }
  let boxed = fc.c.ctx.types[subjectTy].enumBoxed
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return 0
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    fc.failed = true
    return 0
  }
  // A generic-enum match's arms yield the substituted payload type, which the
  // whole-match type inference (over the bare type-param) misses — derive the
  // result from the first arm's body with its payload binders substituted.
  if (boxed && (resultTy == 0 || fc.c.ctx.types[resultTy].kind == TypeKind.TypeParam)) {
    resultTy = matchExprResultTy(fc, node, subjectTy)
  }
  let isVoid = resultTy == fc.c.ctx.voidId
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, subjectTy, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchExprArm(fc, arm, preLen, join, resultTy, isVoid, boxed, subjectTy, subject, k[0])) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  fc.terminated = false
  if (lowerMatchExprArm(fc, arms[len(arms) - 1], preLen, join, resultTy, isVoid, boxed, subjectTy, subject, k[0])) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (!joinReachable) {
    let phTy = resultTy
    if (isVoid) {
      phTy = primType(fc.c.ctx, 3)
    }
    let ph = zeroValue(fc, phTy)
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
    return ph
  }
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    let z = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
    return builderEmit(fc.b, z)
  }
  return builderAddParam(fc.b, resultTy)
}

// Drops env locals beyond `n` (a scope exit), keeping the first `n`.
function truncateEnv(fc: FnCtx, n: int) {
  fc.env = fc.env[0:n]
}

// The env index of a local (most recent binding), or -1 if unbound.
function envIndex(fc: FnCtx, name: string): int {
  let i = len(fc.env) - 1
  while (i >= 0) {
    if (fc.env[i].name == name) {
      return i
    }
    i = i - 1
  }
  return -1
}

// The base binary operator of a compound-assignment kind (`+=` -> `+`), or -1.
function compoundBase(op: int): int {
  if (op == int(Kind.PlusEq)) { return int(Kind.Plus) }
  if (op == int(Kind.MinusEq)) { return int(Kind.Minus) }
  if (op == int(Kind.StarEq)) { return int(Kind.Star) }
  if (op == int(Kind.SlashEq)) { return int(Kind.Slash) }
  if (op == int(Kind.PercentEq)) { return int(Kind.Percent) }
  if (op == int(Kind.AmpEq)) { return int(Kind.Amp) }
  if (op == int(Kind.PipeEq)) { return int(Kind.Pipe) }
  if (op == int(Kind.CaretEq)) { return int(Kind.Caret) }
  if (op == int(Kind.ShlEq)) { return int(Kind.Shl) }
  if (op == int(Kind.ShrEq)) { return int(Kind.Shr) }
  return -1
}

// The IR op for a base arithmetic operator over a value of type `ty`.
function arithOpFor(fc: FnCtx, base: int, ty: int): Op {
  let td = fc.c.ctx.types[ty]
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  return binOpFor(base, isFloat, signed)
}

// Lowers an assignment to a simple local `x`: `x = e` SSA-reassigns the local's
// value; `x op= e` reads it, applies the base op, and reassigns. ponytail:
// single simple-ident target only; field/index lvalues land next.
// Lowers `s.f = v` to `field_set %s[offset] = %v` at the field's byte offset.
// ponytail: inline-array fields (copy semantics) deferred.
function lowerFieldStore(fc: FnCtx, lhs: int, rhs: int) {
  let mk = kidsOf(fc.c.tree, lhs)
  let recvTy = nodeType(fc, mk[0])
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fc.failed = true
    return
  }
  let decl = structDeclOf(fc.c, recvTy)
  if (decl == 0) {
    fc.failed = true
    return
  }
  let oc = typeOwner(fc.c, recvTy)
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(fc.c.tree, mk[1])
  let fidx = fieldIndexByName(oc, fields, fc.c.source[mn.span.start:mn.span.end])
  if (fidx == -1) {
    fc.failed = true
    return
  }
  let fty = typeFromNode(oc, kidsOf(oc.tree, fields[fidx])[1])
  if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
    fc.failed = true
    return
  }
  let recv = lowerExpr(fc, mk[0])
  let v = lowerExprH(fc, rhs, fty)
  if (fc.failed) {
    return
  }
  let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  ins.lhs = recv
  ins.ival = structLayout(fc, oc, decl, noSubst()).offsets[fidx]
  ins.rhs = v
  builderEmit(fc.b, ins)
}

// `*p = x` (§11.4): store one word at the pointed-at address. Reuses FieldSet at
// offset 0 — the pointer is the base, the rhs is stored at the pointee type.
function lowerPtrStore(fc: FnCtx, lhs: int, rhs: int) {
  let opNode = kidsOf(fc.c.tree, lhs)[0]
  let elemTy = defaultType(fc.c, nodeType(fc, lhs))
  let p = lowerExpr(fc, opNode)
  let v = lowerExprH(fc, rhs, elemTy)
  if (fc.failed) {
    return
  }
  let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  ins.lhs = p
  ins.ival = 0
  ins.rhs = v
  builderEmit(fc.b, ins)
}

// Lowers `a[i] = v`: a slice via `rt_call slice_set`, a map via `map_set`, a
// fixed array via the `index_set` op.
function lowerIndexStore(fc: FnCtx, lhs: int, rhs: int) {
  let k = kidsOf(fc.c.tree, lhs)
  let recvTy = defaultType(fc.c, nodeType(fc, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  let elemTy = defaultType(fc.c, nodeType(fc, lhs))
  let v = lowerExprH(fc, rhs, elemTy)
  if (fc.failed) {
    return
  }
  if (rd.kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "slice_set"
    ins.args = [recv, idx, v]
    emitRtCall(fc, ins)
    return
  }
  if (rd.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [recv, idx, v]
    emitRtCall(fc, ins)
    return
  }
  let ins = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
  ins.lhs = recv
  ins.rhs = idx
  ins.ival = v
  builderEmit(fc.b, ins)
}

function lowerAssign(fc: FnCtx, node: int) {
  let opKind = getNode(fc.c.tree, node).main
  let k = kidsOf(fc.c.tree, node)
  let lhsItems = kidsOf(fc.c.tree, k[0])
  let rhsItems = kidsOf(fc.c.tree, k[1])
  // A two-result comma-ok assign to existing locals, either bare `v, ok = m[k]`
  // (two lhs items) or parenthesized `(v, ok) = m[k]` (one tuple_pat item).
  if (opKind == int(Kind.Eq) && len(rhsItems) == 1) {
    let targets = []int(0)
    if (len(lhsItems) == 2) {
      targets = lhsItems
    } else if (len(lhsItems) == 1 && getNode(fc.c.tree, lhsItems[0]).tag == Tag.TuplePat) {
      targets = kidsOf(fc.c.tree, lhsItems[0])
    }
    if (len(targets) == 2) {
      let two = lowerTwoResult(fc, rhsItems[0])
      if (fc.failed) {
        return
      }
      if (len(two) == 2) {
        let t = 0
        while (t < 2) {
          assignEnvSlot(fc, targets[t], two[t])
          if (fc.failed) {
            return
          }
          t = t + 1
        }
        return
      }
    }
    // `a, b = f()` / `(a, b) = f()` where `f` returns a tuple (SPEC §13.1): one
    // value spread positionally over the targets.
    if (len(targets) > 1) {
      let tupTy = nodeType(fc, rhsItems[0])
      if (tupTy != 0 && fc.c.ctx.types[tupTy].kind == TypeKind.Tuple &&
          len(fc.c.ctx.types[tupTy].members) == len(targets)) {
        let val = lowerExpr(fc, rhsItems[0])
        if (fc.failed) {
          return
        }
        let ti = 0
        while (ti < len(targets)) {
          assignEnvSlot(fc, targets[ti], tupleElem(fc, tupTy, val, ti))
          if (fc.failed) {
            return
          }
          ti = ti + 1
        }
        return
      }
      fc.failed = true
      return
    }
  }
  if (len(lhsItems) != 1 || len(rhsItems) != 1) {
    fc.failed = true
    return
  }
  let ln = getNode(fc.c.tree, lhsItems[0])
  // A plain assignment to a struct field or a collection element.
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Member) {
    lowerFieldStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Index) {
    lowerIndexStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  // `*p = x` (§11.4): store one word at the pointed-at address.
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Unary && ln.main == int(Kind.Star)) {
    lowerPtrStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  if (ln.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let lname = fc.c.source[ln.span.start:ln.span.end]
  let idx = envIndex(fc, lname)
  if (idx == -1) {
    // Not a local: a module-level `let` (§11.11). Its cell is written through
    // the ordinary FieldSet at offset 0, the same lvalue shape `*p = x` uses.
    let wsym = moduleGlobalSym(fc, lname)
    if (wsym != "" && opKind == int(Kind.Eq)) {
      // The lvalue's address is materialized BEFORE the right-hand side, which
      // is the seed's resolveLvalue-then-lowerExpr order; matching it keeps the
      // two compilers' IR byte-identical.
      let waddr = emitGlobalAddrVal(fc, wsym)
      let wty = nodeType(fc, lhsItems[0])
      let wv = lowerExprH(fc, rhsItems[0], wty)
      if (fc.failed) {
        return
      }
      let st = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      st.lhs = waddr
      st.ival = 0
      st.rhs = wv
      builderEmit(fc.b, st)
      return
    }
    fc.failed = true
    return
  }
  let ty = fc.env[idx].ty
  if (opKind == int(Kind.Eq)) {
    let rhsTy = defaultType(fc.c, nodeType(fc, rhsItems[0]))
    let v = lowerExprH(fc, rhsItems[0], ty)
    if (fc.failed) {
      return
    }
    // A concrete value assigned into an interface-typed local is relabelled.
    fc.env[idx].value = coerceToIface(fc, v, rhsTy, ty)
    return
  }
  let base = compoundBase(opKind)
  if (base == -1) {
    fc.failed = true
    return
  }
  let cur = fc.env[idx].value
  let rhs = lowerExprH(fc, rhsItems[0], ty)
  if (fc.failed) {
    return
  }
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fc.failed = true
    return
  }
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = rhs
  fc.env[idx].value = builderEmit(fc.b, ins)
}

// Lowers `x++` / `x--` on a local: `base` is Plus/Minus. Emits `const_int 1`
// then the add/sub, and reassigns the local.
function lowerIncDec(fc: FnCtx, node: int, base: int) {
  let ln = getNode(fc.c.tree, kidsOf(fc.c.tree, node)[0])
  if (ln.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let iname = fc.c.source[ln.span.start:ln.span.end]
  let idx = envIndex(fc, iname)
  if (idx == -1) {
    // A module-level `let` (§11.11): read the cell, add/sub one, store it back.
    let isym = moduleGlobalSym(fc, iname)
    if (isym == "") {
      fc.failed = true
      return
    }
    let ity = nodeType(fc, kidsOf(fc.c.tree, node)[0])
    let iop = arithOpFor(fc, base, ity)
    if (iop == Op.BlockParam) {
      fc.failed = true
      return
    }
    let iaddr = emitGlobalAddrVal(fc, isym)
    let ld = mkInstr(Op.FieldGet, ity)
    ld.lhs = iaddr
    ld.ival = 0
    let curv = builderEmit(fc.b, ld)
    let onei = mkInstr(Op.ConstInt, ity)
    onei.ival = 1
    let onev = builderEmit(fc.b, onei)
    let ar = mkInstr(iop, ity)
    ar.lhs = curv
    ar.rhs = onev
    let nv = builderEmit(fc.b, ar)
    let st = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    st.lhs = iaddr
    st.ival = 0
    st.rhs = nv
    builderEmit(fc.b, st)
    return
  }
  let ty = fc.env[idx].ty
  let cur = fc.env[idx].value
  let one = mkInstr(Op.ConstInt, ty)
  one.ival = 1
  let oneV = builderEmit(fc.b, one)
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fc.failed = true
    return
  }
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = oneV
  fc.env[idx].value = builderEmit(fc.b, ins)
}

// Lowers a `while (cond) body`: jump to a header block (loop-carried live locals
// as block params), test the condition, branch into the body or out to the
// exit; the body back-jumps to the header. break/continue target exit/header via
// the loop stack. Mirrors the seed's lowerWhile. Exit block left open.
function lowerWhile(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  // Entry edge into the header.
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: loop-carried params, then the condition + branch.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return
  }
  // The body is dominated by the header (single predecessor), so it takes no
  // params; only the exit is a real merge (this edge + every break).
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  // Body.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: header, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  lowerStmtList(fc, k[1])
  if (!fc.terminated) {
    emitJump(fc, header, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  truncateEnv(fc, preLen)
  // Exit: merges the false-branch and every break.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
}

// Lowers `for x of it` over a slice or array to the seed's counted-loop SSA:
// hidden `$iter`/`$idx` locals thread through a header (test idx < len), a body
// (bind the element, run the body), a step (advance idx, back to header), and an
// exit. break -> exit, continue -> step. ponytail: slice/array only — map
// iteration ($idx cursor via map_iter_*) deferred.
function lowerForOf(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let iterTy = defaultType(fc.c, nodeType(fc, k[1]))
  let id = fc.c.ctx.types[iterTy]
  let isMap = id.kind == TypeKind.Map
  if (id.kind != TypeKind.Slice && id.kind != TypeKind.Array && !isMap) {
    fc.failed = true
    return
  }
  // A slice/array binds one element; a map binds a `(key, value)` pair.
  let binderNode = getNode(fc.c.tree, k[0])
  if (isMap && binderNode.tag != Tag.TuplePat) {
    fc.failed = true
    return
  }
  if (!isMap && binderNode.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let elemTy = id.elem
  let i64ty = primType(fc.c.ctx, 3)
  let iterVal = lowerExpr(fc, k[1])
  if (fc.failed) {
    return
  }
  // Carry the iterable + cursor as hidden locals so they thread through the
  // loop's block params. A map's cursor starts at its first live slot (or -1);
  // a slice/array counts up from 0.
  declareLocal(fc, "$iter", iterVal, iterTy)
  let startV = 0
  if (isMap) {
    let mi = mkInstr(Op.RtCall, i64ty)
    mi.name = "map_iter_init"
    mi.args = [iterVal]
    startV = emitRtCall(fc, mi)
  } else {
    let zero = mkInstr(Op.ConstInt, i64ty)
    startV = builderEmit(fc.b, zero)
  }
  declareLocal(fc, "$idx", startV, i64ty)
  let preLen = len(fc.env)
  let idxSlot = preLen - 1
  let iterSlot = preLen - 2
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let stepBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: a map continues while the slot cursor is >= 0; a slice/array while
  // the index is below the length.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let idxVal = fc.env[idxSlot].value
  let iterCur = fc.env[iterSlot].value
  let cmp = mkInstr(Op.ICmpSge, primType(fc.c.ctx, 10))
  if (isMap) {
    let z = mkInstr(Op.ConstInt, i64ty)
    cmp.lhs = idxVal
    cmp.rhs = builderEmit(fc.b, z)
  } else {
    let lenVal = 0
    if (id.kind == TypeKind.Array) {
      let ci = mkInstr(Op.ConstInt, i64ty)
      ci.ival = id.arrayLen
      lenVal = builderEmit(fc.b, ci)
    } else {
      let sl = mkInstr(Op.SliceLen, i64ty)
      sl.lhs = iterCur
      lenVal = builderEmit(fc.b, sl)
    }
    cmp = mkInstr(Op.ICmpSlt, primType(fc.c.ctx, 10))
    cmp.lhs = idxVal
    cmp.rhs = lenVal
  }
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = builderEmit(fc.b, cmp)
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  // Body: bind the element (or key/value pair), run the body, fall to the step.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: stepBlk, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  let bodyMark = len(fc.env)
  if (isMap) {
    let subs = kidsOf(fc.c.tree, k[0])
    let kv = mkInstr(Op.RtCall, id.mapKey)
    kv.name = "map_key_at"
    kv.args = [iterCur, idxVal]
    let keyV = emitRtCall(fc, kv)
    let vv = mkInstr(Op.RtCall, id.mapVal)
    vv.name = "map_val_at"
    vv.args = [iterCur, idxVal]
    let valV = emitRtCall(fc, vv)
    let kn = getNode(fc.c.tree, subs[0])
    let vn = getNode(fc.c.tree, subs[1])
    declareLocal(fc, fc.c.source[kn.span.start:kn.span.end], keyV, id.mapKey)
    declareLocal(fc, fc.c.source[vn.span.start:vn.span.end], valV, id.mapVal)
    // Keep the checker env consistent so the body types the binders (see
    // lowerFunc) — matters when a monomorphized instance substitutes an element
    // type the check pass recorded as a bare type-param.
    rebindCheckerName(fc, subs[0], id.mapKey)
    rebindCheckerName(fc, subs[1], id.mapVal)
  } else {
    let elemV = 0
    if (id.kind == TypeKind.Slice) {
      let sg = mkInstr(Op.RtCall, elemTy)
      sg.name = "slice_get"
      sg.args = [iterCur, idxVal]
      elemV = emitRtCall(fc, sg)
    } else {
      let ig = mkInstr(Op.IndexGet, elemTy)
      ig.lhs = iterCur
      ig.rhs = idxVal
      elemV = builderEmit(fc.b, ig)
    }
    declareLocal(fc, fc.c.source[binderNode.span.start:binderNode.span.end], elemV, elemTy)
    rebindCheckerName(fc, k[0], elemTy)
  }
  lowerStmtList(fc, k[2])
  truncateEnv(fc, bodyMark)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  if (!fc.terminated) {
    emitJump(fc, stepBlk, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  // Step: advance the cursor (map: next live slot; slice/array: +1), back to the
  // header.
  builderBeginBlock(fc.b, stepBlk)
  addJoinParams(fc, preLen)
  if (isMap) {
    let nx = mkInstr(Op.RtCall, i64ty)
    nx.name = "map_iter_next"
    nx.args = [fc.env[iterSlot].value, fc.env[idxSlot].value]
    fc.env[idxSlot].value = emitRtCall(fc, nx)
  } else {
    let one = mkInstr(Op.ConstInt, i64ty)
    one.ival = 1
    let add = mkInstr(Op.Add, i64ty)
    add.lhs = fc.env[idxSlot].value
    add.rhs = builderEmit(fc.b, one)
    fc.env[idxSlot].value = builderEmit(fc.b, add)
  }
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Exit.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
  // Drop the hidden $iter/$idx locals.
  truncateEnv(fc, preLen - 2)
}

// Lowers a C-style `for (init; cond; post) body`. `init` declares the loop
// variables (threaded through the loop's block params); the header tests `cond`
// (an absent cond loops forever), `continue` targets the `post` block so the step
// always runs, and `post` advances before re-testing. Kids: [init, cond, post,
// body], each possibly absent (0).
function lowerForC(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let outerMark = len(fc.env)
  if (k[0] != 0) {
    lowerStmt(fc, k[0])
    if (fc.failed) {
      return
    }
  }
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let postBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: test the condition; body is reached only here (no params), exit
  // merges this edge with every break (carries the loop values).
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  if (k[1] != 0) {
    let cond = lowerExpr(fc, k[1])
    if (fc.failed) {
      return
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = exitBlk
    br.elseArgs = snapshotValues(fc, preLen)
    builderEmit(fc.b, br)
  } else {
    emitJump(fc, bodyBlk, []int(0))
  }
  builderEndBlock(fc.b)
  // Body: run it, fall through to the post block.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: postBlk, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  let bodyMark = len(fc.env)
  lowerStmtList(fc, k[3])
  truncateEnv(fc, bodyMark)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  if (!fc.terminated) {
    emitJump(fc, postBlk, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  // Post: run the step, back to the header.
  builderBeginBlock(fc.b, postBlk)
  addJoinParams(fc, preLen)
  if (k[2] != 0) {
    lowerStmt(fc, k[2])
    if (fc.failed) {
      return
    }
  }
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Exit: drop the loop variables.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
  truncateEnv(fc, outerMark)
}

// Lowers one `let`/`const` binding: a simple `name = init` binds the init's
// value id in env (no instruction — the local IS its init value). tuple/zero-
// init bindings fall back for now.
function lowerBinding(fc: FnCtx, node: int) {
  let kids = kidsOf(fc.c.tree, node)
  let pat = getNode(fc.c.tree, kids[0])
  // `let (v, ok) = <two-result>` destructures a comma-ok pair.
  if (pat.tag == Tag.TuplePat) {
    lowerTwoResultLet(fc, node)
    return
  }
  if (pat.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  // The checker's recorded type for the bound name, made concrete for this
  // instantiation. `nodeTypes` is the raw table — inside a generic body it still
  // holds the template's `[]T`, and a local typed that way becomes a loop block
  // param typed `[]<T>`, which classifies as a GC reference.
  let declared = substType(fc.c.ctx, fc.c.nodeTypes[kids[0]], fc.genEnv, 0)
  let bname0 = fc.c.source[pat.span.start:pat.span.end]
  // An initializer-less typed binding (`let z: [4]u32` / `let s: S`) is its
  // type's zero value — a live, zeroed array/struct body, not nil (SPEC §13.4).
  if (kids[2] == 0) {
    if (declared == 0) {
      fc.failed = true
      return
    }
    let zv = zeroValue(fc, declared)
    if (fc.failed) {
      return
    }
    declareLocal(fc, bname0, zv, declared)
    rebindCheckerName(fc, kids[0], declared)
    return
  }
  // The binding's declared type is the initializer's context, so a typed
  // literal (`let a: i32 = 0x7F`) materializes at that width.
  let rhsTy = defaultType(fc.c, nodeType(fc, kids[2]))
  let v = arrayValueForBind(fc, kids[2], lowerExprH(fc, kids[2], declared), rhsTy)
  if (fc.failed) {
    return
  }
  // A concrete initializer into an interface-typed binding is relabelled to the
  // interface (SPEC §14.3).
  v = coerceToIface(fc, v, rhsTy, declared)
  let bname = fc.c.source[pat.span.start:pat.span.end]
  declareLocal(fc, bname, v, declared)
  // Keep the checker consistent with this body's locals so a later
  // `checkExprType` on the name resolves to this type (see lowerFunc).
  rebindCheckerName(fc, kids[0], declared)
}

// A `defer <call>`: the call's arguments are evaluated now (lowered at the defer
// site), but the call itself is emitted at every function exit, in reverse
// (LIFO) order. Only print/direct-function-call deferrals for now.
function lowerDefer(fc: FnCtx, node: int) {
  let call = kidsOf(fc.c.tree, node)[0]
  if (getNode(fc.c.tree, call).tag != Tag.Call) {
    fc.failed = true
    return
  }
  let callee = kidsOf(fc.c.tree, call)[0]
  let cn = getNode(fc.c.tree, callee)
  // `defer recv.method(...)` — the idiom every resource-releasing `defer` uses
  // (`defer f.close()`). Receiver and arguments are evaluated HERE, at the defer
  // site; only the call itself is held back to the exit.
  if (cn.tag == Tag.Member) {
    let mk = kidsOf(fc.c.tree, callee)
    let recvTy = nodeType(fc, mk[0])
    if (recvTy == 0) {
      fc.failed = true
      return
    }
    let mn = getNode(fc.c.tree, mk[1])
    let mname = fc.c.source[mn.span.start:mn.span.end]
    let recvV = lowerExpr(fc, mk[0])
    // `defer` evaluates its arguments HERE but hands the stashed values to the
    // callee at the exit, so a literal materialized at the wrong type is never
    // corrected later — the same hint a direct method call gets (#1467).
    let a = lowerArgs(fc, call, methodParamTypes(fc, recvTy, mname))
    if (fc.failed) {
      return
    }
    let mi = mkInstr(Op.Call, fc.c.ctx.voidId)
    if (fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
      mi = mkInstr(Op.CallIface, fc.c.ctx.voidId)
      mi.lhs = recvV
      mi.ival = methodId(fc.lowerer, mname)
      mi.args = a
      fc.defers = append(fc.defers, mi)
      return
    }
    // A concrete receiver leads the argument list, as in a direct method call.
    let all = [recvV]
    let j = 0
    while (j < len(a)) {
      all = append(all, a[j])
      j = j + 1
    }
    mi.name = methodSymbol(fc.lowerer, mname, recvTy)
    mi.args = all
    fc.defers = append(fc.defers, mi)
    return
  }
  if (cn.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let name = fc.c.source[cn.span.start:cn.span.end]
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  if (name == "print" || name == "eprint") {
    ins.name = name
    ins.args = lowerArgs(fc, call, []int(0))
  } else {
    // The same resolution a direct call gets — module qualification AND generic
    // instantiation. Deriving the name from source text here emitted a bare `g`
    // for a deferred generic whose only definition was `g$0`.
    let t = resolveCallTarget(fc, name, call)
    if (!t.ok) {
      fc.failed = true
      return
    }
    ins = mkInstr(Op.Call, t.result)
    ins.name = t.symbol
    ins.args = lowerArgsFor(fc, call, t.owner, t.decl, t.paramTypes)
  }
  if (fc.failed) {
    return
  }
  fc.defers = append(fc.defers, ins)
}

// Emits the pending deferred calls in reverse (LIFO) order at a function exit.
function runDefers(fc: FnCtx) {
  let i = len(fc.defers) - 1
  while (i >= 0) {
    builderEmit(fc.b, fc.defers[i])
    i = i - 1
  }
}

// ---- fallible-result error channel (SPEC §18) -----------------------------

// `err_set(e)` — publish the pending error for the caller's `?`/`catch`.
function setErr(fc: FnCtx, val: int) {
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ins.name = "err_set"
  ins.args = [val]
  emitRtCall(fc, ins)
}

// `err_set(nil)` — an ok return / handled `catch` clears the slot.
function clearErr(fc: FnCtx) {
  let nl = mkInstr(Op.ConstNil, fc.c.ctx.errorId)
  setErr(fc, builderEmit(fc.b, nl))
}

// `err_get()` — read the pending error right after a fallible call.
function getErr(fc: FnCtx, errTy: int): int {
  let ins = mkInstr(Op.RtCall, errTy)
  ins.name = "err_get"
  return emitRtCall(fc, ins)
}

// `err != nil` — the test that decides the `?`/`catch` error path.
function neNil(fc: FnCtx, errv: int, errTy: int): int {
  let nl = mkInstr(Op.ConstNil, errTy)
  let ne = mkInstr(Op.ICmpNe, primType(fc.c.ctx, 10))
  ne.lhs = errv
  ne.rhs = builderEmit(fc.b, nl)
  return builderEmit(fc.b, ne)
}

// Return from a fallible function on the err path: a zero ok value, or nothing
// when the ok type is void (`()!`).
function emitFallibleZeroRet(fc: FnCtx) {
  if (fc.fallibleOk == fc.c.ctx.voidId) {
    builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
    fc.terminated = true
    return
  }
  let zv = zeroValue(fc, fc.fallibleOk)
  let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
  r.args = [zv]
  builderEmit(fc.b, r)
  fc.terminated = true
}

// `fail e` (§18.3): evaluate the error, run defers, publish it, return zero ok.
function lowerFail(fc: FnCtx, node: int) {
  let errv = lowerExprH(fc, kidsOf(fc.c.tree, node)[0], fc.fallibleErr)
  if (fc.failed) {
    return
  }
  runDefers(fc)
  setErr(fc, errv)
  emitFallibleZeroRet(fc)
}

// `expr?` (§18.3): lower the fallible call (its ok value lands normally), then
// branch on the error slot — on error propagate (defers, restore the error,
// return zero ok); on ok the value is the call's ok result.
function lowerTryExpr(fc: FnCtx, node: int): int {
  let operand = kidsOf(fc.c.tree, node)[0]
  let errTy = fc.c.ctx.types[nodeType(fc, operand)].errTy
  let okv = lowerExpr(fc, operand)
  if (fc.failed) {
    return 0
  }
  let errv = getErr(fc, errTy)
  let isErr = neNil(fc, errv, errTy)
  let prop = builderNewBlock(fc.b)
  let cont = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = prop
  br.thenArgs = []int(0)
  br.ival2 = cont
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, prop)
  fc.terminated = false
  runDefers(fc)
  setErr(fc, errv)
  emitFallibleZeroRet(fc)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, cont)
  fc.terminated = false
  // `cont` has a single predecessor (dominated by the branch), so the ok value
  // flows in directly — no block param.
  return okv
}

// The block-param args for a catch/match-expr join edge: the live locals, plus
// the merged value unless the ok type is void. Copies `locals` (append can grow
// its input in place, and a caller reuses the snapshot for `restoreValues`).
function catchEdgeArgs(fc: FnCtx, locals: []int, val: int, isVoid: bool): []int {
  let out = []int(0)
  let i = 0
  while (i < len(locals)) {
    out = append(out, locals[i])
    i = i + 1
  }
  if (!isVoid) {
    out = append(out, val)
  }
  return out
}

// `expr catch d` / `expr catch e { … }` (§18.3): merge the ok value and the
// handled value at a join. A void ok type carries no value (the catch is a
// statement); the ok value stands in as the placeholder.
function lowerCatch(fc: FnCtx, node: int, bind: bool): int {
  let k = kidsOf(fc.c.tree, node)
  let fty = nodeType(fc, k[0])
  let okTy = fc.c.ctx.types[fty].result
  let errTy = fc.c.ctx.types[fty].errTy
  let isVoid = okTy == fc.c.ctx.voidId
  let okv = coerceToIface(fc, lowerExpr(fc, k[0]), fty, okTy)
  if (fc.failed) {
    return 0
  }
  let errv = getErr(fc, errTy)
  let isErr = neNil(fc, errv, errTy)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let errBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = errBlk
  br.thenArgs = []int(0)
  br.ival2 = join
  br.elseArgs = catchEdgeArgs(fc, orig, okv, isVoid)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, errBlk)
  fc.terminated = false
  clearErr(fc)
  let handled = 0
  // The handler's own value type (for widening a concrete handler value to an
  // interface ok type at the merge).
  let handledTy = okTy
  if (bind) {
    let mark = len(fc.env)
    let en = getNode(fc.c.tree, k[1])
    declareLocal(fc, fc.c.source[en.span.start:en.span.end], errv, errTy)
    rebindCheckerName(fc, k[1], errTy)
    handled = lowerCatchBlock(fc, k[2], okTy)
    handledTy = catchBlockType(fc, k[2])
    truncateEnv(fc, mark)
  } else {
    handled = lowerExprH(fc, k[1], okTy)
    handledTy = defaultType(fc.c, nodeType(fc, k[1]))
  }
  if (fc.failed) {
    return 0
  }
  // A bind-catch block that produced no value. Harmless when nothing merges —
  // a void ok type carries no value, and a diverted block never reaches the
  // join. A FALL-THROUGH with a non-void ok type is exactly what E0067 rejects,
  // so arriving here means the validator's divergence analysis and the lowerer's
  // `terminated` disagree; stub the function rather than merge a bogus operand
  // (before #1519 that operand was value id 0, i.e. the function's own first
  // instruction, silently typed as whatever that instruction produced).
  if (handled == -1) {
    if (!isVoid && !fc.terminated) {
      fc.failed = true
      return 0
    }
    handled = okv
    handledTy = okTy
  }
  if (!fc.terminated) {
    let merged = coerceToIface(fc, handled, handledTy, okTy)
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), merged, isVoid))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    return okv
  }
  return builderAddParam(fc.b, okTy)
}

// The body of a `catch e { … }`: a block of statements whose final expression (if
// the ok type is non-void) is the handled value. ponytail: a bind-catch body that
// yields a value uses its trailing expression statement.
// The value type a `catch e { … }` block yields: its trailing expression's type,
// or void.
function catchBlockType(fc: FnCtx, block: int): int {
  let stmts = kidsOf(fc.c.tree, block)
  if (len(stmts) == 0) {
    return fc.c.ctx.voidId
  }
  let last = stmts[len(stmts) - 1]
  if (getNode(fc.c.tree, last).tag == Tag.ExprStmt) {
    return defaultType(fc.c, nodeType(fc, kidsOf(fc.c.tree, last)[0]))
  }
  return fc.c.ctx.voidId
}

// Returns the block's value, or -1 when it yields none — NOT 0, which is the
// value id of a function's first instruction and so a perfectly valid result
// (#1519, the same collision that produced the #1493 miscompile). The seed keeps
// the two apart with `?ir.ValueId`; here the sentinel must sit outside the id
// space. On `fc.failed` the return is meaningless and the caller re-checks the
// flag, so -1 is right there too.
function lowerCatchBlock(fc: FnCtx, block: int, okTy: int): int {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) - 1 && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
  if (fc.failed || len(stmts) == 0) {
    return -1
  }
  // The last statement yields the value for a non-void catch; a void catch runs
  // it as a statement.
  let last = stmts[len(stmts) - 1]
  if (okTy == fc.c.ctx.voidId || fc.terminated) {
    lowerStmt(fc, last)
    return -1
  }
  if (getNode(fc.c.tree, last).tag == Tag.ExprStmt) {
    return lowerExprH(fc, kidsOf(fc.c.tree, last)[0], okTy)
  }
  lowerStmt(fc, last)
  return -1
}

function lowerStmt(fc: FnCtx, node: int) {
  let n = getNode(fc.c.tree, node)
  if (n.tag == Tag.ExprStmt) {
    // A bare expression statement (e.g. `print(x)`); its value is discarded.
    lowerExpr(fc, kidsOf(fc.c.tree, node)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    lowerDefer(fc, node)
    return
  }
  // A nested block `{ … }` as a statement: its own local scope.
  if (n.tag == Tag.Block) {
    let mark = len(fc.env)
    lowerStmtList(fc, node)
    truncateEnv(fc, mark)
    return
  }
  if (n.tag == Tag.SpawnStmt) {
    lowerSpawn(fc, node)
    return
  }
  if (n.tag == Tag.SendStmt) {
    // `ch <- v`: send one word; the value lowers at the channel's element type.
    let sk = kidsOf(fc.c.tree, node)
    let chanTy = defaultType(fc.c, nodeType(fc, sk[0]))
    let ch = lowerExpr(fc, sk[0])
    let v = lowerExprH(fc, sk[1], fc.c.ctx.types[chanTy].elem)
    if (fc.failed) {
      return
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "chan_send"
    ins.args = [ch, v]
    emitRtCall(fc, ins)
    return
  }
  if (n.tag == Tag.LetDecl || n.tag == Tag.ConstDecl) {
    let binds = kidsOf(fc.c.tree, node)
    let i = 0
    while (i < len(binds) && !fc.failed) {
      lowerBinding(fc, binds[i])
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let vals = kidsOf(fc.c.tree, node)
    if (len(vals) == 0) {
      runDefers(fc)
      // A fallible function's ok return must leave the error slot null (§11.6).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
      fc.terminated = true
      return
    }
    // `return a, b` builds one boxed tuple and returns a single handle (ABI.md
    // §1.1) — a `ret` carries at most one value. Elements are lowered against the
    // DECLARED element types: an untyped literal must widen to the element's
    // width before it is stored into the box, unlike a single-value return where
    // the ret register absorbs the difference.
    if (len(vals) > 1) {
      let tupTy = fc.resultTy
      if (tupTy == 0 || fc.c.ctx.types[tupTy].kind != TypeKind.Tuple) {
        fc.failed = true
        return
      }
      let members = fc.c.ctx.types[tupTy].members
      if (len(members) != len(vals)) {
        fc.failed = true
        return
      }
      let elems = []int(0)
      let ei = 0
      while (ei < len(vals)) {
        elems = append(elems, arrayValueForBind(fc, vals[ei], lowerExprH(fc, vals[ei], members[ei]), members[ei]))
        if (fc.failed) {
          return
        }
        ei = ei + 1
      }
      let boxed = buildTuple(fc, tupTy, elems)
      runDefers(fc)
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
      rt.args = [boxed]
      builderEmit(fc.b, rt)
      fc.terminated = true
      return
    }
    // The declared result type is the hint, matching the seed: without it an
    // untyped literal lands at its default type and a narrower result reads the
    // wrong half of it — `return 4.5` from an `f32!` (#1467). Defers run after
    // the return value is evaluated, before the ret. Returning an array from a
    // location copies it.
    let v = arrayValueForBind(fc, vals[0], lowerExprH(fc, vals[0], fc.resultTy), nodeType(fc, vals[0]))
    if (fc.failed) {
      return
    }
    runDefers(fc)
    if (fc.fallibleErr != 0) {
      clearErr(fc)
    }
    let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
    r.args = [v]
    builderEmit(fc.b, r)
    fc.terminated = true
    return
  }
  if (n.tag == Tag.FailStmt) {
    lowerFail(fc, node)
    return
  }
  if (n.tag == Tag.IfStmt) {
    lowerIf(fc, node)
    return
  }
  if (n.tag == Tag.WhileStmt) {
    lowerWhile(fc, node)
    return
  }
  if (n.tag == Tag.ForOf) {
    lowerForOf(fc, node)
    return
  }
  if (n.tag == Tag.ForC) {
    lowerForC(fc, node)
    return
  }
  if (n.tag == Tag.MatchStmt) {
    lowerMatch(fc, node)
    return
  }
  if (n.tag == Tag.SwitchStmt) {
    lowerSwitch(fc, node)
    return
  }
  if (n.tag == Tag.SelectStmt) {
    lowerSelect(fc, node)
    return
  }
  if (n.tag == Tag.Assign) {
    lowerAssign(fc, node)
    return
  }
  if (n.tag == Tag.IncStmt) {
    lowerIncDec(fc, node, int(Kind.Plus))
    return
  }
  if (n.tag == Tag.DecStmt) {
    lowerIncDec(fc, node, int(Kind.Minus))
    return
  }
  if (n.tag == Tag.BreakStmt || n.tag == Tag.ContinueStmt) {
    if (len(fc.loops) == 0) {
      fc.failed = true
      return
    }
    // `break` targets the innermost frame (loop or switch); `continue` targets
    // the innermost real loop, skipping switch frames.
    let fi = len(fc.loops) - 1
    if (n.tag == Tag.ContinueStmt) {
      while (fi >= 0 && fc.loops[fi].isSwitch) {
        fi = fi - 1
      }
      if (fi < 0) {
        fc.failed = true
        return
      }
    }
    let frame = fc.loops[fi]
    let target = frame.exit
    if (n.tag == Tag.ContinueStmt) {
      target = frame.cont
    }
    emitJump(fc, target, snapshotValues(fc, frame.preLen))
    fc.terminated = true
    return
  }
  fc.failed = true
}

// Lowers a body block's statements in order, stopping at the first unlowerable
// one (`failed`) or once the block has terminated (dead code after it).
function lowerStmtList(fc: FnCtx, block: int) {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
}

// A signature-only stub: params + the fall-off `ret`, for functions whose body
// is not yet fully lowerable.
function signatureOnlyFunc(c: Checker, name: string, paramTypes: []int, result: int): IrFunc {
  let b = newBuilder()
  builderBeginBlock(b, builderNewBlock(b))
  let i = 0
  while (i < len(paramTypes)) {
    builderAddParam(b, paramTypes[i])
    i = i + 1
  }
  builderEmit(b, mkInstr(Op.Ret, c.ctx.voidId))
  builderEndBlock(b)
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false }
}

// Lowers one function declaration to an `IrFunc`: the full signature plus the
// body if every statement lowers, else a signature-only stub.
// Maps every top-level (and, harmlessly, nested — locals shadow via env) const
// binding name to its initializer node, so a reference inlines the value.
function collectModuleConsts(c: Checker): map<string, int> {
  let m = map<string, int>{}
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0) {
          m[c.source[pat.span.start:pat.span.end]] = bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return m
}

function lowerFunc(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer): IrFunc {
  return lowerFuncNamed(c, decl, moduleConsts, lowerer, "", emptyTypeEnv())
}

// §10.3.1: true if the func_decl carries `@want` in its trailing attr_list
// (the 7th child, elided for attr-less functions).
function funcHasAttr(c: Checker, decl: int, want: string): bool {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return false
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let an = getNode(c.tree, kidsOf(c.tree, attrs[i])[0])
    if (c.source[an.span.start:an.span.end] == want) {
      return true
    }
    i = i + 1
  }
  return false
}

// §11.9: the string argument of `@want("...")` on this func_decl, or "" if the
// attribute is absent or carries no argument. The literal's quotes are stripped;
// a symbol name has no use for escapes, and the checker has already rejected
// anything outside the C identifier charset.
function funcAttrArg(c: Checker, decl: int, want: string): string {
  let kids = kidsOf(c.tree, decl)
  if (len(kids) <= 6 || kids[6] == 0) {
    return ""
  }
  let attrs = kidsOf(c.tree, kids[6])
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i])
    let an = getNode(c.tree, ak[0])
    if (c.source[an.span.start:an.span.end] == want && len(ak) > 1 && ak[1] != 0) {
      let sn = getNode(c.tree, ak[1])
      return c.source[sn.span.start + 1:sn.span.end - 1]
    }
    i = i + 1
  }
  return ""
}

// Lowers a function; `nameOverride` (non-empty) forces the IR name — used for a
// monomorphized instance `name$index`, which bypasses method mangling. `genEnv`
// carries that instance's type-param bindings (empty for an ordinary function),
// which every body node's type is resolved through — see nodeType.
function lowerFuncNamed(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer, nameOverride: string, genEnv: TypeEnv): IrFunc {
  let kids = kidsOf(c.tree, decl)
  let nm = getNode(c.tree, kids[1])
  let name = c.source[nm.span.start:nm.span.end]
  // A method's IR name is mangled by its receiver type's id (`get$t21`), so two
  // types can share a method name (the seed's method FuncId scheme).
  if (kids[0] != 0) {
    let recvId = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
    // The entry itself is recorded by Pass A3' (collectMethodEntries), which runs
    // BEFORE any body is lowered — see the ordering note there. Only the name
    // mangling happens here.
    //
    // A monomorphized instance (nameOverride set) is always a FREE function
    // today — generic-type methods do not parse — so it never reaches here.
    // Asserted rather than guarded: if generic methods land, this fires loudly
    // instead of silently emitting a method the pre-pass never saw.
    assert(nameOverride == "")
    name = lowerer.modPrefix + name + "\$t${recvId}"
  } else {
    name = lowerer.modPrefix + name
  }
  // An override (a monomorphized instance) is already module-qualified by the
  // caller, so it is used verbatim — prefixing again would produce `m2$m2$f$0`.
  if (nameOverride != "") {
    name = nameOverride
  }
  // §11.9: `@symbol("name")` pins the link-level name, bypassing module
  // qualification entirely — the `m<id>$` ordinal is assigned by whichever build
  // imports the module, so a qualified name is not stable enough to be the
  // symbol codegen calls a runtime primitive by. Applied after nameOverride
  // because a pinned function is never generic (the checker rejects that), so
  // the two can never both be set.
  let pinned = funcAttrArg(c, decl, "symbol")
  if (pinned != "") {
    name = pinned
  }
  let paramTypes = lowerParamSlotTypes(c, decl)
  // An omitted result is void; a fallible result `T!E` shows its ok type in the
  // header, and its ok/err feed the error channel (`fail`/`?`/ok-return).
  let result = c.ctx.voidId
  let fallibleOk = 0
  let fallibleErr = 0
  if (kids[4] != 0) {
    let rawResult = typeFromNode(c, kids[4])
    if (rawResult != 0 && c.ctx.types[rawResult].kind == TypeKind.Fallible) {
      fallibleOk = c.ctx.types[rawResult].result
      fallibleErr = c.ctx.types[rawResult].errTy
    }
    result = unwrapFallible(c, rawResult)
  }
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let fc = FnCtx{ c: c, b: b, env: []LocalBind(0), failed: false, terminated: false,
    loops: []LoopFrame(0), moduleConsts: moduleConsts, lowerer: lowerer, defers: []IrInstr(0),
    fallibleOk: fallibleOk, fallibleErr: fallibleErr, genEnv: genEnv, resultTy: result }
  // Bind params (receiver first, if any) to their block-param value ids. The
  // checker's env is flat across the whole module, so a later function's
  // same-named param can have overwritten this one's type; rebind ours here so
  // `checkExprType` resolves this body's identifiers to the correct types during
  // lowering (`x: f64` here vs `x: int` in a sibling).
  let names = paramNames(c, decl)
  let i = 0
  while (i < len(paramTypes)) {
    let id = builderAddParam(b, paramTypes[i])
    declareLocal(fc, names[i], id, paramTypes[i])
    c.env[names[i]] = paramTypes[i]
    i = i + 1
  }
  // Record each parameter's declared type NODE for this body (a generic-enum
  // scrutinee `o: Opt<i64>` recovers its type-args from it during a match).
  let pnodes = kidsOf(c.tree, kids[3])
  let pi = 0
  while (pi < len(pnodes)) {
    let pnn = getNode(c.tree, kidsOf(c.tree, pnodes[pi])[0])
    c.declTypeNodes[c.source[pnn.span.start:pnn.span.end]] = kidsOf(c.tree, pnodes[pi])[1]
    pi = pi + 1
  }
  let isNaked = funcHasAttr(c, decl, "naked")
  let isNosplit = funcHasAttr(c, decl, "nosplit")
  lowerStmtList(fc, kids[5])
  if (fc.failed) {
    lowerer.stubbed = append(lowerer.stubbed, name)
    return signatureOnlyFunc(c, name, paramTypes, result)
  }
  // §10.3.1 @naked: lowering emits no implicit `ret` — there is no frame to tear
  // down, and the body is return-only (a fall-through is the seed's E0055, which
  // selfhost cannot yet diagnose; see #1360).
  if (!fc.terminated && !isNaked) {
    runDefers(fc)
    // A void fallible function `()!` that falls off the end still clears the
    // error slot on its ok path (§11.6).
    if (fc.fallibleErr != 0) {
      clearErr(fc)
    }
    builderEmit(fc.b, mkInstr(Op.Ret, c.ctx.voidId))
  }
  builderEndBlock(fc.b)
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: fc.b.blocks, instrs: fc.b.instrs, isFallible: fc.fallibleErr != 0,
    isNaked: isNaked, isNosplit: isNosplit,
    inRootModule: lowerer.curModule == lowerer.root }
}

// The parameter names of a function declaration, in the same order as
// lowerParamTypes (method receiver first).
function paramNames(c: Checker, decl: int): []string {
  let kids = kidsOf(c.tree, decl)
  let names = []string(0)
  if (kids[0] != 0) {
    let rn = getNode(c.tree, kidsOf(c.tree, kids[0])[0])
    names = append(names, c.source[rn.span.start:rn.span.end])
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    let pn = getNode(c.tree, kidsOf(c.tree, params[i])[0])
    names = append(names, c.source[pn.span.start:pn.span.end])
    i = i + 1
  }
  return names
}

// Lowers every top-level function into an `IrModule`. FuncId order matches the
// seed's passes: free functions first (Pass A), then struct methods (Pass A3),
// each in declaration order — so the dump's `func` blocks line up.
// Lays out a closure's captured fields (like structLayout, over arbitrary field
// types) into offsets + GC pointer offsets + total size.
function layoutFields(fc: FnCtx, fieldTypes: []int): StructLayout {
  let offsets = []int(0)
  let ptrOffsets = []int(0)
  let cur = 0
  let i = 0
  while (i < len(fieldTypes)) {
    let fl = fieldLayoutFor(fc, fieldTypes[i])
    cur = alignUp(cur, fl.size)
    offsets = append(offsets, cur)
    if (fl.isPtr) {
      ptrOffsets = append(ptrOffsets, cur)
    }
    cur = cur + fl.size
    i = i + 1
  }
  return StructLayout{ size: alignUp(cur, 8), offsets: offsets, ptrOffsets: ptrOffsets }
}

// Synthesizes a closure function `closure$<fid>(env, params) { body }`: the body
// reads its captures from the env object (word i) and its params from block
// params. Returns the FuncId (post-order: nested closures get lower ids). Appends
// the function to the shared closure list.
function lowerClosureBody(fc: FnCtx, node: int, closureTy: int, capNames: []string, capTypes: []int, layout: StructLayout): int {
  let k = kidsOf(fc.c.tree, node)
  let ft = fc.c.ctx.types[closureTy]
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let cfc = FnCtx{ c: fc.c, b: b, env: []LocalBind(0), failed: false, terminated: false,
    loops: []LoopFrame(0), moduleConsts: fc.moduleConsts, lowerer: fc.lowerer, defers: []IrInstr(0),
    fallibleOk: 0, fallibleErr: 0, genEnv: fc.genEnv, resultTy: ft.result }
  let envParam = builderAddParam(b, closureTy)
  let allParams = [closureTy]
  let pnodes = kidsOf(fc.c.tree, k[0])
  let i = 0
  while (i < len(pnodes)) {
    let pty = ft.members[i]
    let p = builderAddParam(b, pty)
    let pn = getNode(fc.c.tree, kidsOf(fc.c.tree, pnodes[i])[0])
    let pname = fc.c.source[pn.span.start:pn.span.end]
    declareLocal(cfc, pname, p, pty)
    fc.c.env[pname] = pty
    allParams = append(allParams, pty)
    i = i + 1
  }
  // Unpack captures from the env object (field_get word i).
  i = 0
  while (i < len(capNames)) {
    let fg = mkInstr(Op.FieldGet, capTypes[i])
    fg.lhs = envParam
    fg.ival = layout.offsets[i]
    declareLocal(cfc, capNames[i], builderEmit(b, fg), capTypes[i])
    fc.c.env[capNames[i]] = capTypes[i]
    i = i + 1
  }
  let body = k[1]
  if (getNode(fc.c.tree, body).tag == Tag.Block) {
    lowerStmtList(cfc, body)
    if (!cfc.terminated) {
      builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
    }
  } else {
    let v = lowerExprH(cfc, body, ft.result)
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [v]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  if (cfc.failed) {
    fc.failed = true
  }
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "closure\$${fid}", paramTypes: allParams, result: ft.result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  return fid
}

// Lowers an arrow function `(params) => body` to a closure: captures every
// in-scope local not shadowed by its own params (innermost first, the seed's
// order), packs them into a gc_alloc'd env (nil when none), synthesizes the
// closure body, and wraps them with `make_closure`.
function lowerArrowFn(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let closureTy = nodeType(fc, node)
  let ownNames = []string(0)
  let pnodes = kidsOf(fc.c.tree, k[0])
  let pi = 0
  while (pi < len(pnodes)) {
    let pn = getNode(fc.c.tree, kidsOf(fc.c.tree, pnodes[pi])[0])
    ownNames = append(ownNames, fc.c.source[pn.span.start:pn.span.end])
    pi = pi + 1
  }
  let capNames = []string(0)
  let capTypes = []int(0)
  let capValues = []int(0)
  let i = len(fc.env) - 1
  while (i >= 0) {
    let bd = fc.env[i]
    if (!stringInList(ownNames, bd.name) && !stringInList(capNames, bd.name)) {
      capNames = append(capNames, bd.name)
      capTypes = append(capTypes, bd.ty)
      capValues = append(capValues, bd.value)
    }
    i = i - 1
  }
  let layout = layoutFields(fc, capTypes)
  let envObj = 0
  if (len(capNames) == 0) {
    envObj = builderEmit(fc.b, mkInstr(Op.ConstNil, closureTy))
  } else {
    let ga = mkInstr(Op.GcAlloc, closureTy)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    envObj = builderEmit(fc.b, ga)
    let ci = 0
    while (ci < len(capNames)) {
      let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      fs.lhs = envObj
      fs.ival = layout.offsets[ci]
      fs.rhs = capValues[ci]
      builderEmit(fc.b, fs)
      ci = ci + 1
    }
  }
  let fid = lowerClosureBody(fc, node, closureTy, capNames, capTypes, layout)
  if (fc.failed) {
    return 0
  }
  let mc = mkInstr(Op.MakeClosure, closureTy)
  mc.name = "closure\$${fid}"
  mc.lhs = envObj
  return builderEmit(fc.b, mc)
}

// Synthesizes a spawn thunk trampoline `spawn$trampoline$<fid>(env)`: it reads
// each packed argument from the env object and calls the target function, then
// returns (a task yields nothing). Returns the FuncId.
function synthSpawnTrampoline(fc: FnCtx, targetName: string, paramTypes: []int, result: int, fty: int, layout: StructLayout): int {
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  builderAddParam(b, fty)
  let envParam = 0
  let callArgs = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    let fg = mkInstr(Op.FieldGet, paramTypes[i])
    fg.lhs = envParam
    fg.ival = layout.offsets[i]
    callArgs = append(callArgs, builderEmit(b, fg))
    i = i + 1
  }
  let call = mkInstr(Op.Call, result)
  call.name = targetName
  call.args = callArgs
  builderEmit(b, call)
  builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  builderEndBlock(b)
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "spawn\$trampoline\$${fid}", paramTypes: [fty], result: fc.c.ctx.voidId, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  return fid
}

// Lowers `spawn f(args)` for a direct named function: pack the args (typed by the
// callee's parameters) into a gc_alloc'd thunk, then `spawn(func_addr trampoline,
// thunk)`. Closure/method spawn targets are out of scope.
function lowerSpawn(fc: FnCtx, node: int) {
  let call = kidsOf(fc.c.tree, node)[0]
  let ck = kidsOf(fc.c.tree, call)
  let callee = getNode(fc.c.tree, ck[0])
  if (callee.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let targetName = fc.c.source[callee.span.start:callee.span.end]
  let fty = nodeType(fc, ck[0])
  if (fty == 0 || fc.c.ctx.types[fty].kind != TypeKind.Func) {
    fc.failed = true
    return
  }
  // `spawn` packs one thunk slot per declared parameter, so a variadic callee
  // would need its tail collected into a `[]T` first. Refuse explicitly: an
  // arity-only guard would let `spawn f(x)` against `...xs: T` through, and the
  // thunk would then hand the callee a scalar where it binds a slice.
  if (fc.c.ctx.types[fty].variadic) {
    fc.failed = true
    return
  }
  // Resolve the callee the way a direct call does. Reading the signature off
  // `fty` instead yields the TEMPLATE members for a generic callee, and the
  // thunk layout below derives `ptr_offsets` from these types — an unsubstituted
  // `T` is a GC reference, so the collector would walk a packed int as a pointer.
  let t = resolveCallTarget(fc, targetName, call)
  if (!t.ok) {
    fc.failed = true
    return
  }
  let paramTypes = t.paramTypes
  let result = t.result
  // The thunk object's type, and the trampoline's env parameter. Interned from
  // the RESOLVED signature, not taken from `fty`: for a generic callee `fty` is
  // the unbound template, so the emitted IR carried `fn(<T>, chan<<T>>)`. For
  // every non-generic spawn this interns to precisely `fty` again.
  let envTy = mkFunc(fc.c.ctx, paramTypes, false, result)
  let argVals = lowerArgs(fc, call, paramTypes)
  if (fc.failed) {
    return
  }
  let layout = layoutFields(fc, paramTypes)
  let ga = mkInstr(Op.GcAlloc, envTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let thunk = builderEmit(fc.b, ga)
  let i = 0
  while (i < len(argVals)) {
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = thunk
    fs.ival = layout.offsets[i]
    fs.rhs = argVals[i]
    builderEmit(fc.b, fs)
    i = i + 1
  }
  let fid = synthSpawnTrampoline(fc, t.symbol, paramTypes, result, envTy, layout)
  let fa = mkInstr(Op.FuncAddr, envTy)
  fa.name = "spawn\$trampoline\$${fid}"
  let faV = builderEmit(fc.b, fa)
  let sp = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  sp.name = "spawn"
  sp.args = [faV, thunk]
  emitRtCall(fc, sp)
}

// Lowers an uncalled interface method value `iface.m`: a closure over the
// interface receiver plus a synthesized `ifacemethod$trampoline$<fid>(recv, args)`
// that dispatches dynamically via call_iface.
// A concrete struct method taken as a value, `v.m` (§11.10): a closure whose
// environment IS the receiver and whose code IS the method itself.
//
// No trampoline is synthesized, unlike the interface (`lowerIfaceMethodValue`)
// and bare-function (`fnValueTrampoline`) cases. A method's ABI already takes
// its receiver as the leading parameter, which is exactly the closure calling
// convention `(env, args...)` — so the method's own symbol is directly
// call-compatible with `call_value`. Mirrors seed lower.zig `lowerMember`.
//
// Reached only when the member named no field, so a miss here (`m` is neither
// field nor method) is the genuine failure the caller used to report directly.
function lowerStructMethodValue(fc: FnCtx, node: int, recvTy: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let mn = getNode(fc.c.tree, kids[1])
  let mname = fc.c.source[mn.span.start:mn.span.end]
  let fnTy = methodSigLookup(fc.c, "${recvTy}.${mname}")
  if (fnTy == 0) {
    fc.failed = true
    return 0
  }
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let mc = mkInstr(Op.MakeClosure, fnTy)
  mc.name = methodSymbol(fc.lowerer, mname, recvTy)
  mc.lhs = recvV
  return builderEmit(fc.b, mc)
}

function lowerIfaceMethodValue(fc: FnCtx, node: int, recvTy: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let mn = getNode(fc.c.tree, kids[1])
  let mname = fc.c.source[mn.span.start:mn.span.end]
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let sigKey = "${recvTy}.${mname}"
  let fnTy = methodSigLookup(fc.c, sigKey)
  let result = methodResultLookup(fc.c, sigKey)
  let mid = methodId(fc.lowerer, mname)
  let paramTypes = fc.c.ctx.types[fnTy].members
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let recvParam = builderAddParam(b, recvTy)
  let allParams = [recvTy]
  let callArgs = []int(0)
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  let ci = mkInstr(Op.CallIface, result)
  ci.lhs = recvParam
  ci.ival = mid
  ci.args = callArgs
  let r = builderEmit(b, ci)
  if (result == fc.c.ctx.voidId) {
    builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  } else {
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [r]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "ifacemethod\$trampoline\$${fid}", paramTypes: allParams, result: result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  let mc = mkInstr(Op.MakeClosure, fnTy)
  mc.name = "ifacemethod\$trampoline\$${fid}"
  mc.lhs = recvV
  return builderEmit(fc.b, mc)
}

// Whether `name` is in a string list.
function stringInList(xs: []string, name: string): bool {
  let i = 0
  while (i < len(xs)) {
    if (xs[i] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// The FuncId of the trampoline that wraps top-level function `funcName` as a
// first-class value, synthesizing it on first use. The trampoline takes the
// closure env (ignored) plus the target's parameters and tail-calls the target,
// so a bare function value is call-compatible with arrow closures.
function fnValueTrampoline(fc: FnCtx, funcName: string): int {
  for (nm, existing) of fc.lowerer.fnValueTramps {
    if (nm == funcName) {
      return existing
    }
  }
  let fid = fc.lowerer.reservedCount + len(fc.lowerer.closureFuncs)
  let decl = funcDeclLookup(fc.c, funcName)
  // An imported target's params are declared in ITS tree (see declOwner).
  //
  // The SIGNATURE types, not the callee's body slot types: a variadic tail is
  // `...xs: i32`, which the callee's own frame binds as `[]i32` but which the
  // function TYPE carries as the element type with variadic-ness held as a
  // separate flag. The trampoline is declared against the type, so it takes the
  // element type here — matching the seed. The value that actually arrives is
  // the caller's slice either way (one word, identical call sites), so this is
  // the declared type only; no call site or lowering changes with it.
  let paramTypes = lowerParamTypes(declOwner(fc.c, funcName), decl)
  let result = unwrapFallible(fc.c, funcResultLookup(fc.c, funcName))
  let fnTy = funcSigLookup(fc.c, funcName)
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  // Leading env param (ignored), then one block param per target parameter.
  builderAddParam(b, fnTy)
  let callArgs = []int(0)
  let allParams = [fnTy]
  let i = 0
  while (i < len(paramTypes)) {
    callArgs = append(callArgs, builderAddParam(b, paramTypes[i]))
    allParams = append(allParams, paramTypes[i])
    i = i + 1
  }
  let call = mkInstr(Op.Call, result)
  // The trampoline body calls the real function, so it needs the same qualified
  // symbol a direct call would use — an imported target lives under its own
  // module's name.
  call.name = callQualified(fc.c, fc.lowerer.root, funcName)
  call.args = callArgs
  let r = builderEmit(b, call)
  if (result == fc.c.ctx.voidId) {
    builderEmit(b, mkInstr(Op.Ret, fc.c.ctx.voidId))
  } else {
    let rt = mkInstr(Op.Ret, fc.c.ctx.voidId)
    rt.args = [r]
    builderEmit(b, rt)
  }
  builderEndBlock(b)
  fc.lowerer.closureFuncs = append(fc.lowerer.closureFuncs, IrFunc{ name: "fnvalue\$trampoline\$${fid}", paramTypes: allParams, result: result, blocks: b.blocks, instrs: b.instrs, isFallible: false, isNaked: false, isNosplit: false, inRootModule: fc.lowerer.curModule == fc.lowerer.root })
  fc.lowerer.fnValueTramps[funcName] = fid
  return fid
}

// Whether a func decl is a generic template (has a non-empty `<...>` list). Such
// a template is not lowered directly — one instance per call-site type-arg combo
// is emitted instead (monomorphization).
function isGenericFuncDecl(c: Checker, decl: int): bool {
  if (isExternDecl(c.tree, decl)) {
    return false // SPEC 11.7: never generic
  }
  let gp = kidsOf(c.tree, decl)[2]
  return gp != 0 && len(kidsOf(c.tree, gp)) > 0
}

// Every regular func a module contributes (free + methods) — part of the FuncId
// budget that must be reserved before any closure trampoline takes an id.
// Generic INSTANCES are not counted here: the ledger is project-wide now, so
// lowerProject adds them once rather than once per module.
function moduleReservedCount(c: Checker): int {
  let reserved = 0
  let ri = 1
  while (ri < len(c.tree.nodes)) {
    let rn = getNode(c.tree, ri)
    if (rn.tag == Tag.FuncDecl) {
      if (kidsOf(c.tree, ri)[0] != 0 || !isGenericFuncDecl(c, ri)) {
        reserved = reserved + 1
      }
    }
    // SPEC 11.7: an extern decl emits NO function here (calls resolve by name),
    // but the seed still reserves it a FuncId in its Pass A. Closure ids count
    // up from this total and their SYMBOL NAME embeds the id, so failing to
    // count externs would rename every closure in a program that uses one.
    if (rn.tag == Tag.ExternFnDecl) {
      reserved = reserved + 1
    }
    ri = ri + 1
  }
  return reserved
}

// Lowers a whole checked project into ONE IrModule. Modules are walked in id
// (dependency) order within each pass, matching the seed's module-major
// Pass A/A2/A3 order, so the emitted function order is the seed's.
//
// The root module keeps bare names; every other module's functions are prefixed
// `m<id>$`, so two modules that both declare `join` cannot collide in the
// object's flat symbol namespace.
// The in-memory size of a module-level `let`'s type (§11.11). Only the untraced
// shapes the checker admits reach here: a scalar or raw `*T` is one field slot,
// and `[N]U` is N elements at their natural width — the same stride
// IndexGet/IndexSet use, which is what lets a static cell stand in for a heap
// array without touching either op.
function moduleGlobalSize(ctx: TypeContext, ty: int): int {
  let t = ctx.types[ty]
  if (t.kind == TypeKind.Array) {
    return t.arrayLen * moduleGlobalScalarSize(ctx, t.elem)
  }
  return moduleGlobalScalarSize(ctx, ty)
}

function moduleGlobalScalarSize(ctx: TypeContext, ty: int): int {
  let t = ctx.types[ty]
  if (t.kind == TypeKind.Prim) {
    let p = t.prim
    if (p == 0 || p == 4 || p == 10) { return 1 }
    if (p == 1 || p == 5) { return 2 }
    if (p == 2 || p == 6 || p == 8) { return 4 }
  }
  return 8
}

// A module global's rendered static image. `ok: false` means the initializer is
// a shape this cannot evaluate EXACTLY — the caller must then refuse (stub)
// rather than emit a cell holding the wrong value. Silent wrongness is the one
// outcome worth failing the build over.
struct GlobalImage {
  ok: bool,
  bytes: []int,
}

// Renders a module-level `let`'s initial value into its static byte image
// (§11.11). Little-endian: every target Bit emits for.
function moduleGlobalImage(c: Checker, ty: int, initNode: int): GlobalImage {
  let size = moduleGlobalSize(c.ctx, ty)
  let bytes = []int(size)
  if (initNode == 0) {
    return GlobalImage{ ok: true, bytes: bytes }   // zero-valued
  }
  // The SAME folder the checker admitted this initializer with (§15.4), so
  // "check accepted it" and "lowering can render it" cannot drift apart — that
  // drift was #1430: `vLiteralValue` folded only a signed literal, so
  // `let x: i64 = 0 - 1` passed check and then failed to lower.
  let cv = vConstEval(c, initNode, 0)
  if (!cv.ok) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  // A constant STRING folds (#1534) but has no scalar value to render: vcString
  // carries no payload, so falling through would write `ival`'s 0 into the cell
  // and ship a silently wrong image — the one outcome this function exists to
  // prevent. Unreachable today, because a string is traced and §11.11 keeps it
  // out of module state, so this is the guard for the day that changes.
  if (cv.kind == vcString) {
    return GlobalImage{ ok: false, bytes: bytes }
  }
  let v = cv.ival
  if (cv.kind == vcFloat) {
    // The cell holds the IEEE-754 bit pattern, at the cell's own width: an f32
    // global stores the f32 encoding, not a truncated f64 one.
    if (size == 4) {
      v = int(float32Bits(f32(cv.fval)))
    } else {
      v = int(floatBits(cv.fval))
    }
  }
  let i = 0
  while (i < size) {
    bytes[i] = (v >> (i * 8)) & 255
    i = i + 1
  }
  return GlobalImage{ ok: true, bytes: bytes }
}

// Pass A0: walk every module's top-level `let` declarations (§11.11) and give
// each one an `IrGlobal` — a symbol name and the complete static image of its
// initial value.
//
// The checker has already proved each is a single-name binding of an untraced
// type, so this never diagnoses. A global whose initializer cannot be rendered
// exactly is simply not registered; every reference to it then fails its
// function, which `bit build` refuses — never a cell holding a wrong value.
function registerGlobals(mods: []Checker, lowerer: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let i = 1
    while (i < len(c.tree.nodes)) {
      if (getNode(c.tree, i).tag == Tag.LetDecl) {
        // §11.11 storage class, recorded by the parser in the decl's `main`:
        // 0 = process-wide, 1 = per-thread (`@threadlocal let`). Both classes
        // obey identical untraced-type/constant-initializer rules, so only the
        // cell's placement differs and that is decided right here.
        let storage = getNode(c.tree, i).main
        let binds = kidsOf(c.tree, i)
        let j = 0
        while (j < len(binds)) {
          let bk = kidsOf(c.tree, binds[j])
          let pat = getNode(c.tree, bk[0])
          if (pat.tag == Tag.Ident && isModuleStateBinding(c, binds[j])) {
            let nm = c.source[pat.span.start:pat.span.end]
            let ty = c.nodeTypes[bk[0]]
            if (ty != 0) {
              let img = moduleGlobalImage(c, ty, bk[2])
              if (img.ok) {
                let sym = "__bitg_${c.moduleId}_${nm}"
                lowerer.globals = append(lowerer.globals, IrGlobal{ name: sym,
                  bytes: img.bytes, align: moduleStateAlign, storage: storage,
                  relocs: []IrGlobalReloc(0) })
                lowerer.globalSyms["${c.moduleId}\$${nm}"] = sym
              }
            }
          }
          j = j + 1
        }
      }
      i = i + 1
    }
    mi = mi + 1
  }
}

// The symbol of the module global `name` refers to at this use site, or "" when
// `name` is not module state. The owner lookup is the declOwner rule: a name
// imported from another module resolves against THAT module's id.
function moduleGlobalSym(fc: FnCtx, name: string): string {
  let owner = declOwner(fc.c, name)
  let (sym, ok) = fc.lowerer.globalSyms["${owner.moduleId}\$${name}"]
  if (!ok) {
    return ""
  }
  return sym
}

// The address of a module-level `let`'s static cell (§11.11), as a raw pointer
// value. GlobalAddr is pure address arithmetic — no load, no call, no safepoint
// — which is what makes module state reachable from a `@nosplit` body.
function emitGlobalAddrVal(fc: FnCtx, sym: string): int {
  let ga = mkInstr(Op.GlobalAddr, primType(fc.c.ctx, 3))
  ga.name = sym
  return builderEmit(fc.b, ga)
}

function lowerProject(mods: []Checker, root: int): IrModule {
  assert(len(mods) >= 1)
  assert(root >= 0 && root < len(mods))
  // The FuncId budget spans every module: closure trampolines are numbered after
  // all of them, so a per-module count would hand two modules the same ids.
  let reserved = len(mods[root].ctx.instantiations)
  let ri = 0
  while (ri < len(mods)) {
    reserved = reserved + moduleReservedCount(mods[ri])
    ri = ri + 1
  }
  // One Lowerer for the whole project: interface dispatch ids, the string pool
  // and func-value trampolines are all program-wide, not per-module.
  let lowerer = Lowerer{ methodIds: map<string, int>{}, methodEntries: []MethodEntry(0),
    stringPool: []string(0), asmBlocks: []AsmBlock(0), reservedCount: reserved, closureFuncs: []IrFunc(0),
    fnValueTramps: map<string, int>{}, modPrefix: "", root: root, curModule: root,
    typeModule: map<int, int>{}, stubbed: []string(0),
    globals: []IrGlobal(0), globalSyms: map<string, string>{} }
  // Pass A0: every module-level `let` (§11.11) gets a static cell before any
  // function body is lowered, so a reference from a function declared above the
  // `let` resolves just as well as one below it.
  registerGlobals(mods, lowerer)
  // Every named type -> its declaring module, before any body is lowered: a
  // method's symbol takes its receiver TYPE's prefix, and a Pass A body can call
  // a method whose decl Pass A3 has not reached yet. `typeDecls` holds only the
  // names a module declares itself, so an imported type is not claimed here.
  let ti = 0
  while (ti < len(mods)) {
    for (nm, _) of mods[ti].typeDecls {
      let id = userTypeLookup(mods[ti], nm)
      if (id != 0) {
        lowerer.typeModule[id] = ti
      }
    }
    ti = ti + 1
  }
  // Pass A3' (#1471): record every method decl, and assign the global dispatch
  // ids from them, BEFORE any body is lowered. The seed does the same — it fills
  // `l.method_table` while reserving method FuncIds and builds the per-type
  // tables at seed/lower.zig:998, both ahead of "Pass B: lower bodies". Doing it
  // after instead lets the first `call_iface` in a body claim id 0, so a program
  // mixing a concrete method with an interface method numbered them differently
  // in the two compilers. Neither numbering is wrong per runtime/ABI.md §2.1
  // (dense, one id per name, consistent program-wide), but the IR differential
  // is only useful if it is quiet.
  //
  // The walk must match Pass A3 node-for-node, and the ids come out of
  // buildMethodTables' GROUPED-BY-RECEIVER loop, not this flat order: for
  // `A.m1; B.m2; A.m3` the seed's ids are m1, m3, m2.
  collectMethodEntries(mods, root, lowerer)
  let methodTables = buildMethodTables(lowerer)
  let funcs = []IrFunc(0)

  // Pass A: every module's non-generic free functions, in declaration order.
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lowerer.modPrefix = modulePrefix(mi, root)
    lowerer.curModule = mi
    let consts = collectModuleConsts(c)
    let i = 1
    while (i < len(c.tree.nodes)) {
      let n = getNode(c.tree, i)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, i)[0] == 0 && !isGenericFuncDecl(c, i)) {
        funcs = append(funcs, lowerFunc(c, i, consts, lowerer))
      }
      i = i + 1
    }
    mi = mi + 1
  }

  // Pass A2: the project's monomorphized generic instances, in the checker's
  // discovery order (the index IS the `$n` suffix). Each is lowered against the
  // module that DECLARES the generic — its tree holds the template — and named
  // with that module's prefix, so every caller resolves to the one symbol.
  let insts = mods[root].ctx.instantiations
  let g = 0
  while (g < len(insts)) {
    let owner = mods[insts[g].module]
    lowerer.modPrefix = modulePrefix(insts[g].module, root)
    lowerer.curModule = insts[g].module
    funcs = append(funcs, lowerInstance(owner, collectModuleConsts(owner), lowerer, g,
      modulePrefix(insts[g].module, root)))
    g = g + 1
  }

  // Pass A3: each module's methods, in declaration order.
  mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lowerer.modPrefix = modulePrefix(mi, root)
    lowerer.curModule = mi
    let consts = collectModuleConsts(c)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
        funcs = append(funcs, lowerFunc(c, m, consts, lowerer))
      }
      m = m + 1
    }
    mi = mi + 1
  }

  // Pass A4: synthesized closure trampolines, at the FuncIds reserved for them.
  let ci = 0
  while (ci < len(lowerer.closureFuncs)) {
    funcs = append(funcs, lowerer.closureFuncs[ci])
    ci = ci + 1
  }
  return IrModule{ funcs: funcs, ctx: mods[root].ctx, stringPool: lowerer.stringPool,
    asmBlocks: lowerer.asmBlocks, methodTables: methodTables, stubbed: lowerer.stubbed,
    globals: lowerer.globals, externNames: collectExternNames(mods) }
}

// Every §11.7 `extern function` name declared anywhere in the project, raw and
// unmangled. These are the only symbols the compiled program may legitimately
// leave undefined for dyld to bind; the Mach-O linker refuses any other (#1445).
//
// Scans EVERY module, not just the root: an extern declared in an imported
// module is still linked into this image, and missing one would turn a valid
// program into a link error. `kidsOf(...)[0]` is the name node (§ lowerFunc).
function collectExternNames(mods: []Checker): []string {
  let out = []string(0)
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.ExternFnDecl) {
        let nameNode = getNode(c.tree, kidsOf(c.tree, m)[0])
        out = append(out, c.source[nameNode.span.start:nameNode.span.end])
      }
      m = m + 1
    }
    mi = mi + 1
  }
  return out
}

// A method's link symbol: prefixed by the module that DECLARES the receiver
// type, not by the caller's — `s.area()` on an imported Shape must reach the
// same symbol from every module — then mangled by the receiver's type id so two
// types can share a method name.
function methodSymbol(lw: Lowerer, name: string, recvTy: int): string {
  let (mod, known) = lw.typeModule[recvTy]
  if (!known) {
    return name + "\$t${recvTy}" // an unnamed receiver: not an importable decl
  }
  return modulePrefix(mod, lw.root) + name + "\$t${recvTy}"
}

// A module's link prefix: bare for the root, `m<id>$` otherwise.
function modulePrefix(mod: int, root: int): string {
  if (mod == root) {
    return ""
  }
  return "m${mod}\$"
}

// The (type param -> concrete arg) bindings a call's type arguments make. `oc`
// must OWN `decl` (its tree and its type tables).
//
// The ids come from the ledger registerGenerics filled, NOT from looking the
// param names up in `userTypes`: every generic registers its params under their
// bare names, so in a module declaring both `mapped<T, U>` and `fold<T, A>` the
// name `T` resolves only to whichever was declared last. Binding by name there
// silently produces an env keyed on ANOTHER decl's `T`, which matches nothing in
// this body and leaves every local a slice-of-type-param.
function genericEnvOf(oc: Checker, decl: int, targs: []int): TypeEnv {
  let env = emptyTypeEnv()
  let genNode = kidsOf(oc.tree, decl)[2]
  if (genNode == 0) {
    return env
  }
  let ids = oc.genericParamIds[genNode]
  let tps = kidsOf(oc.tree, genNode)
  let j = 0
  while (j < len(ids) && j < len(targs)) {
    if (ids[j] != 0) {
      env.params = append(env.params, ids[j])
      env.args = append(env.args, targs[j])
    }
    // ...and ALSO the id the name resolves to right now, which is not always the
    // same id. registerGenerics records this decl's ids during the COLLECT pass,
    // but `userTypes` is flat and keyed by bare name, so the next generic in the
    // module to declare a `T` overwrites it. Bodies are checked in a later pass
    // (#1238's two-phase bind-then-body), by which point every body in the module
    // that mentions `T` was typed against the LAST-registered `T`, not its own.
    // Binding only the registered id therefore left `${got}` in `eq<T>`'s body
    // still typed as a bare type param after substitution, and lowerToString
    // refused it — four stubbed instances and a permanently red difftests gate
    // (#1485). A type param name inside a body can only mean that body's own
    // param, so binding both ids is sound; the duplicate is a no-op when they
    // agree (the last-declared generic).
    if (j < len(tps)) {
      let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
      let byName = userTypeLookup(oc, oc.source[tpn.span.start:tpn.span.end])
      if (byName != 0 && byName != ids[j]) {
        env.params = append(env.params, byName)
        env.args = append(env.args, targs[j])
      }
    }
    j = j + 1
  }
  return env
}

// A generic callee's declared parameter types with THIS call's type arguments
// substituted in. The template's params still name its own type params, so an
// argument hinted with the raw `[]T` is built as a slice of a type param — which
// classifies as holding GC references, handing slice_new is_ref=1 so the
// collector walks raw integers as pointers.
//
// Bound by NAME while resolving the decl's own type nodes, not by substituting
// the ids `lowerParamTypes` returns: that re-resolves `T` through `userTypes`,
// which by lowering time names whichever generic in the module declared a `T`
// last — a different id than this decl's, matching nothing.
function genericParamTypes(oc: Checker, decl: int, targs: []int): []int {
  let sub = noSubst()
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[2])
  let j = 0
  while (j < len(tps) && j < len(targs)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[j])[0])
    sub.names = append(sub.names, oc.source[tpn.span.start:tpn.span.end])
    sub.types = append(sub.types, targs[j])
    j = j + 1
  }
  return lowerParamTypesIn(oc, decl, sub)
}

// Lowers generic instantiation `g` of module `c` — the type params bound to the
// instantiation's concrete args for the duration, then restored.
function lowerInstance(c: Checker, consts: map<string, int>, lowerer: Lowerer, g: int,
    prefix: string): IrFunc {
  let inst = c.ctx.instantiations[g]
  // `c` IS the declaring module (lowerProject picks it), so the template's decl
  // and every type name it mentions resolve in this checker's own tree.
  let decl = funcDeclLookup(c, inst.name)
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  // Built BEFORE the rebinding below, so it captures the template's own TypeParam
  // ids — what the body's checked types actually mention. Rebinding `userTypes`
  // only fixes sites that RE-RESOLVE a type node during lowering; every site that
  // reads a checked node type needs this env instead (see nodeType).
  let genEnv = genericEnvOf(c, decl, inst.args)
  let saved = []int(0)
  let j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    let tpname = c.source[tpn.span.start:tpn.span.end]
    saved = append(saved, userTypeLookup(c, tpname))
    if (j < len(inst.args)) {
      c.userTypes[tpname] = inst.args[j]
    }
    j = j + 1
  }
  let f = lowerFuncNamed(c, decl, consts, lowerer, "${prefix}${inst.name}\$${g}", genEnv)
  j = 0
  while (j < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[j])[0])
    c.userTypes[c.source[tpn.span.start:tpn.span.end]] = saved[j]
    j = j + 1
  }
  return f
}

// One module on its own — the single-file path (`--dump-ir`, `bit2 build
// <file.bit>`). Delegates to lowerProject so there is exactly ONE lowering
// order: with a single module that IS the root, every prefix is empty and the
// output is what it was before modules existed. This is also why the existing
// single-file IR differential covers lowerProject.
function lowerModuleIr(c: Checker): IrModule {
  return lowerProject([c], 0)
}

// Parse -> check -> lower -> render IR text, the `bit2 --dump-ir` pipeline.
// Builds `src`'s IR module: parse -> check -> lower.
function lowerSourceModule(src: string): IrModule {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return lowerModuleIr(c)
}

// The raw lowering dump (`--dump-ir-pre`).
function lowerSourceDump(src: string): string {
  return dumpIr(lowerSourceModule(src))
}

// The optimized dump (`--dump-ir`): the seed runs its -O1 pipeline before
// rendering, so bit2 must too for the post-opt differential.
function lowerSourceDumpOpt(src: string): string {
  let m = lowerSourceModule(src)
  optimizeModule(m)
  return dumpIr(m)
}

// Pass A3' — every method decl in the project, in exactly the order Pass A3
// lowers them (module order, then node order, `FuncDecl` with a receiver).
// Split out of `lowerFuncNamed` so the entries, and therefore the dispatch ids,
// exist before the first body is lowered (#1471). Everything an entry holds is
// derivable from the decl alone, so this needs no lowering state beyond the
// module prefix.
function collectMethodEntries(mods: []Checker, root: int, lw: Lowerer) {
  let mi = 0
  while (mi < len(mods)) {
    let c = mods[mi]
    lw.modPrefix = modulePrefix(mi, root)
    let m = 1
    while (m < len(c.tree.nodes)) {
      let n = getNode(c.tree, m)
      if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
        let kids = kidsOf(c.tree, m)
        let nm = getNode(c.tree, kids[1])
        lw.methodEntries = append(lw.methodEntries,
          MethodEntry{ recvTy: userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1])),
            name: c.source[nm.span.start:nm.span.end], prefix: lw.modPrefix })
      }
      m = m + 1
    }
    mi = mi + 1
  }
}

// Per-type method tables (runtime/ABI.md §2.1) from Pass A3's entries: one table
// per distinct receiver type in first-seen order, each holding that type's
// methods in declaration order with their global dispatch ids. call_iface
// resolves through these at runtime.
function buildMethodTables(lw: Lowerer): []MethodTable {
  let tables = []MethodTable(0)
  let seen = map<int, bool>{}
  let i = 0
  while (i < len(lw.methodEntries)) {
    let disc = lw.methodEntries[i].recvTy
    let (_, already) = seen[disc]
    if (already) {
      i = i + 1
      continue
    }
    seen[disc] = true
    let methods = []MethodSlot(0)
    let j = 0
    while (j < len(lw.methodEntries)) {
      if (lw.methodEntries[j].recvTy == disc) {
        // The id is assigned from the raw name (global across modules); the
        // symbol carries the declaring module's prefix.
        methods = append(methods, MethodSlot{ id: methodId(lw, lw.methodEntries[j].name),
          func: lw.methodEntries[j].prefix + lw.methodEntries[j].name + "\$t${disc}" })
      }
      j = j + 1
    }
    tables = append(tables, MethodTable{ typeDisc: disc, methods: methods })
    i = i + 1
  }
  return tables
}

// The value of a NAME that is not a local: a module-level `let` cell, a
// module-level const (inlined at the use site), or a top-level function taken
// as a first-class value. Every lookup here is name-keyed, so a namespace
// member `ns.c` passes its DOTTED key and resolves exactly as a plain import
// of the same symbol would (see check.bit `bindNamespaceImport`).
function lowerNamedValue(fc: FnCtx, node: int, name: string): int {
  let v = envValue(fc, name)
  if (v != -1) {
    return v
  }
  // Not a local: a module-level `let` (§11.11) is a static cell. An `[N]T`
  // array IS its base address in this IR (IndexGet/IndexSet take an
  // element-base pointer), so the address is the value; every other
  // admissible type is one word in the cell, so it takes one load — FieldGet
  // at offset 0, the same op `*p` lowers to.
  let gsym = moduleGlobalSym(fc, name)
  if (gsym != "") {
    let addr = emitGlobalAddrVal(fc, gsym)
    let gty = nodeType(fc, node)
    if (fc.c.ctx.types[gty].kind == TypeKind.Array) {
      return addr
    }
    let ld = mkInstr(Op.FieldGet, gty)
    ld.lhs = addr
    ld.ival = 0
    return builderEmit(fc.b, ld)
  }
  // Not a local: a module-level const inlines its initializer at the use site.
  // An IMPORTED const's initializer node indexes its OWN module's arena, so it
  // must be lowered against that module's checker — reading the node against
  // this tree lands on an unrelated node (the declOwner rule). Both the tree
  // and the const table are swapped for the duration, so an initializer that
  // references another const of its own module resolves there too.
  // ponytail: the owner's const table is rescanned per imported reference —
  // consts are rare; cache it on the Lowerer if a project ever makes it hot.
  let oc = declOwner(fc.c, name)
  let ocName = declName2(fc.c, name)
  let ocConsts = fc.moduleConsts
  if (oc.moduleId != fc.c.moduleId) {
    ocConsts = collectModuleConsts(oc)
  }
  for (k, initNode) of ocConsts {
    if (k == ocName) {
      let savedC = fc.c
      let savedConsts = fc.moduleConsts
      fc.c = oc
      fc.moduleConsts = ocConsts
      let cv = lowerExpr(fc, initNode)
      fc.c = savedC
      fc.moduleConsts = savedConsts
      return cv
    }
  }
  // A bare top-level function used as a first-class value: wrap it in a closure
  // over a nil env and its trampoline.
  if (funcDeclLookup(fc.c, name) != 0) {
    let fnTy = funcSigLookup(fc.c, name)
    let fid = fnValueTrampoline(fc, name)
    let nl = mkInstr(Op.ConstNil, fnTy)
    let mc = mkInstr(Op.MakeClosure, fnTy)
    mc.name = "fnvalue\$trampoline\$${fid}"
    mc.lhs = builderEmit(fc.b, nl)
    return builderEmit(fc.b, mc)
  }
  fc.failed = true
  return 0
}
