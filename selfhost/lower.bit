// Self-host Stage 2 (#1337): AST -> SSA IR lowering, ported from
// compiler/lower.zig. Builds an `IrModule` (selfhost/ir.bit) whose `dumpIr`
// byte-matches the seed's `bitc --dump-ir` over the corpus. Grows
// statement/expression by statement/expression; this first slice lowers each
// function's *signature* and an empty body (`func f(…) R { bb0(…): ret }`),
// the shape every function ends with when it falls off the end.
//
// Reuses the checker (selfhost/check.bit) for types: a function's parameter and
// result types come from the same `typeFromNode`/`funcResults` the type dump
// uses, so IR types and inferred types stay consistent by construction.

// The incremental IR builder: a flat instr array (index == value id) plus the
// blocks that slice it, and the block currently being appended to.
struct IrBuilder {
  instrs: []IrInstr,
  blocks: []IrBlock,
  cur: int,
  blockStart: int,
  blockParamCount: int,
}

function newBuilder(): IrBuilder {
  return IrBuilder{ instrs: []IrInstr(0), blocks: []IrBlock(0), cur: -1,
    blockStart: 0, blockParamCount: 0 }
}

// Reserves a fresh block id; its instruction range is recorded later at
// endBlock. Blocks are created ahead of being filled (e.g. an if's then/join),
// so the range is deferred, mirroring the seed's FunctionBuilder.
function builderNewBlock(b: IrBuilder): int {
  b.blocks = append(b.blocks, IrBlock{ instsStart: 0, paramCount: 0, instsLen: 0 })
  return len(b.blocks) - 1
}

// Opens a block for appending: its instructions start at the current end of the
// flat array.
function builderBeginBlock(b: IrBuilder, id: int) {
  b.cur = id
  b.blockStart = len(b.instrs)
  b.blockParamCount = 0
}

// Records the current block's final [start, len, paramCount] range. The
// terminator must already be emitted.
function builderEndBlock(b: IrBuilder) {
  b.blocks[b.cur] = IrBlock{ instsStart: b.blockStart, paramCount: b.blockParamCount,
    instsLen: len(b.instrs) - b.blockStart }
}

// Appends one instruction to the current block, returning its SSA value id.
function builderEmit(b: IrBuilder, ins: IrInstr): int {
  b.instrs = append(b.instrs, ins)
  return len(b.instrs) - 1
}

// Adds a block parameter (phi result) to the current block. Params must precede
// the block's body instructions, so this is called right after beginBlock.
function builderAddParam(b: IrBuilder, ty: int): int {
  let id = builderEmit(b, mkInstr(Op.BlockParam, ty))
  b.blockParamCount = b.blockParamCount + 1
  return id
}

// The parameter type list of a function declaration, in order, with a method
// receiver (if any) as the leading parameter — mirroring lowerFunctionDecl.
function lowerParamTypes(c: Checker, decl: int): []int {
  let kids = kidsOf(c.tree, decl)
  let types = []int(0)
  if (kids[0] != 0) {
    types = append(types, typeFromNode(c, kidsOf(c.tree, kids[0])[1]))
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    types = append(types, typeFromNode(c, kidsOf(c.tree, params[i])[1]))
    i = i + 1
  }
  return types
}

// One in-scope local: its name, current SSA value id, and type. The env is an
// *ordered* list (not a map) so control-flow joins can snapshot/restore/rebind
// live locals by position, matching the seed's Env.
struct LocalBind {
  name: string,
  value: int,
  ty: int,
}

// Per-function lowering state: the checker (for types), the IR builder, the
// ordered local environment, and flags. `failed` trips on any construct not yet
// lowerable, so the function falls back to a signature-only stub rather than
// emitting partial/garbage IR.
struct FnCtx {
  c: Checker,
  b: IrBuilder,
  env: []LocalBind,
  failed: bool,
  terminated: bool,
  // Enclosing loops (innermost last): break jumps to `exit`, continue to `cont`,
  // both carrying the first `preLen` live locals.
  loops: []LoopFrame,
  // Module-level const name -> its initializer node, inlined at each reference
  // (the seed materializes a top-level const's value at every use site).
  moduleConsts: map<string, int>,
  // Shared, module-wide lowering state (interface-method dispatch ids).
  lowerer: Lowerer,
  // Pending deferred calls (their args already lowered at the `defer` site);
  // emitted in reverse (LIFO) at every function exit.
  defers: []IrInstr,
  // Fallible-function context (SPEC §18): the result's ok/err types when the
  // enclosing function returns `T!E`, else 0. `fail`/`?`/ok-return use these.
  fallibleOk: int,
  fallibleErr: int,
}

// Module-wide lowering state shared across all functions (mutated as they lower
// in order). `methodIds` assigns each interface-method *name* a stable dispatch
// index on first encounter (the seed's methodId), so call_iface indices match.
struct Lowerer {
  methodIds: map<string, int>,
}

// The dispatch index of an interface method name, assigned on first encounter.
function methodId(lw: Lowerer, name: string): int {
  for (k, v) of lw.methodIds {
    if (k == name) {
      return v
    }
  }
  let id = len(lw.methodIds)
  lw.methodIds[name] = id
  return id
}

// One enclosing loop's break/continue targets and its live-local count.
struct LoopFrame {
  exit: int,
  cont: int,
  preLen: int,
  // A switch frame is a `break` target but not a `continue` target — a
  // `continue` inside a switch reaches the enclosing loop, skipping switches.
  isSwitch: bool,
}

// Binds a name to a value id + type, appending to the ordered env.
function declareLocal(fc: FnCtx, name: string, value: int, ty: int) {
  fc.env = append(fc.env, LocalBind{ name: name, value: value, ty: ty })
}

// The current value id of a name (most recent binding wins), or -1 if unbound.
function envValue(fc: FnCtx, name: string): int {
  let i = len(fc.env) - 1
  while (i >= 0) {
    if (fc.env[i].name == name) {
      return fc.env[i].value
    }
    i = i - 1
  }
  return -1
}

// The current value ids of the first `n` env locals (a control-flow snapshot).
function snapshotValues(fc: FnCtx, n: int): []int {
  let vals = []int(0)
  let i = 0
  while (i < n) {
    vals = append(vals, fc.env[i].value)
    i = i + 1
  }
  return vals
}

// Restores the first `len(vals)` locals' value ids from a snapshot (after a
// branch that reassigned some of them).
function restoreValues(fc: FnCtx, vals: []int) {
  let i = 0
  while (i < len(vals)) {
    fc.env[i].value = vals[i]
    i = i + 1
  }
}

// At a reachable join, gives the current block one parameter per in-scope local
// (the first `n`) and rebinds each local to its new block-param value — the
// seed's addLoopParams. Params are added in env order.
function addJoinParams(fc: FnCtx, n: int) {
  let i = 0
  while (i < n) {
    fc.env[i].value = builderAddParam(fc.b, fc.env[i].ty)
    i = i + 1
  }
}

// The IR op for an arithmetic/bitwise binary operator, given whether its
// operands are floats and (for int div/rem/shr) signed. Returns Op.BlockParam
// as a "not lowerable yet" sentinel (never a real binary).
function binOpFor(op: int, isFloat: bool, signed: bool): Op {
  if (op == int(Kind.Plus)) {
    if (isFloat) {
      return Op.FAdd
    }
    return Op.Add
  }
  if (op == int(Kind.Minus)) {
    if (isFloat) {
      return Op.FSub
    }
    return Op.Sub
  }
  if (op == int(Kind.Star)) {
    if (isFloat) {
      return Op.FMul
    }
    return Op.Mul
  }
  if (op == int(Kind.Slash)) {
    if (isFloat) {
      return Op.FDiv
    }
    if (signed) {
      return Op.SDiv
    }
    return Op.UDiv
  }
  if (op == int(Kind.Percent)) {
    if (signed) {
      return Op.SRem
    }
    return Op.URem
  }
  if (op == int(Kind.Amp)) {
    return Op.BAnd
  }
  if (op == int(Kind.Pipe)) {
    return Op.BOr
  }
  if (op == int(Kind.Caret)) {
    return Op.BXor
  }
  if (op == int(Kind.Shl)) {
    return Op.Shl
  }
  if (op == int(Kind.Shr)) {
    if (signed) {
      return Op.AShr
    }
    return Op.LShr
  }
  return Op.BlockParam
}

// Whether an operator kind is a relational/equality comparison (not a logical
// `&&`/`||`, which needs short-circuit block lowering).
function isRelationalOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq) || op == int(Kind.Lt) ||
    op == int(Kind.Gt) || op == int(Kind.LtEq) || op == int(Kind.GtEq)
}

// The IR compare op for a relational operator over ints (signed/unsigned by
// `signed`) or floats. Returns Op.BlockParam as a not-yet-lowerable sentinel.
function cmpOpFor(op: int, isFloat: bool, signed: bool): Op {
  if (op == int(Kind.EqEq)) {
    if (isFloat) {
      return Op.FCmpEq
    }
    return Op.ICmpEq
  }
  if (op == int(Kind.BangEq)) {
    if (isFloat) {
      return Op.FCmpNe
    }
    return Op.ICmpNe
  }
  if (op == int(Kind.Lt)) {
    if (isFloat) {
      return Op.FCmpLt
    }
    if (signed) {
      return Op.ICmpSlt
    }
    return Op.ICmpUlt
  }
  if (op == int(Kind.LtEq)) {
    if (isFloat) {
      return Op.FCmpLe
    }
    if (signed) {
      return Op.ICmpSle
    }
    return Op.ICmpUle
  }
  if (op == int(Kind.Gt)) {
    if (isFloat) {
      return Op.FCmpGt
    }
    if (signed) {
      return Op.ICmpSgt
    }
    return Op.ICmpUgt
  }
  if (op == int(Kind.GtEq)) {
    if (isFloat) {
      return Op.FCmpGe
    }
    if (signed) {
      return Op.ICmpSge
    }
    return Op.ICmpUge
  }
  return Op.BlockParam
}

// Whether a string literal's body uses a `\x`/`\u{…}` byte/codepoint escape,
// which the simple decoder below cannot yet build. Such a literal falls back.
// Whether the content range [cstart, cend) uses a `\x`/`\u` byte/codepoint
// escape the simple decoder cannot build.
function spanNeedsByteEscape(src: string, cstart: int, cend: int): bool {
  let i = cstart
  while (i < cend - 1) {
    if (src[i] == '\\' && (src[i + 1] == 'x' || src[i + 1] == 'u')) {
      return true
    }
    i = i + 1
  }
  return false
}

// Decodes the escape sequences in a content range [cstart, cend), matching the
// seed's unescapeInner for n/t/r/0 and the literal `\\ " ' $`. ponytail: `\x`/
// `\u` are screened out by spanNeedsByteEscape before this runs.
function decodeEscapes(src: string, cstart: int, cend: int): string {
  let s = ""
  let i = cstart
  while (i < cend) {
    let c = src[i]
    if (c != '\\') {
      s = s + src[i:i + 1]
      i = i + 1
      continue
    }
    i = i + 1
    if (i >= cend) {
      break
    }
    let e = src[i]
    i = i + 1
    if (e == 'n') {
      s = s + "\n"
    } else if (e == 't') {
      s = s + "\t"
    } else if (e == 'r') {
      s = s + "\r"
    } else if (e == '0') {
      s = s + "\0"
    } else {
      s = s + src[i - 1:i]
    }
  }
  return s
}

// A string literal's body is its span minus the surrounding quotes.
function stringNeedsByteEscape(src: string, start: int, endPos: int): bool {
  return spanNeedsByteEscape(src, start + 1, endPos - 1)
}

function decodeStringContent(src: string, start: int, endPos: int): string {
  return decodeEscapes(src, start + 1, endPos - 1)
}

// Lowers a call's argument expressions in order (unwrapping each `arg` node).
// Each arg takes the callee's matching parameter type as its context hint (so
// an untyped literal argument materializes at the parameter's width); an empty
// `paramTypes` gives no hints.
function lowerArgs(fc: FnCtx, node: int, paramTypes: []int): []int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let vals = []int(0)
  let i = 0
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let hint = 0
    if (i < len(paramTypes)) {
      hint = paramTypes[i]
    }
    vals = append(vals, lowerExprH(fc, a, hint))
    i = i + 1
  }
  return vals
}

// Lowers `len(x)` / `cap(x)`: an array is its static length (const_int, len==cap),
// a slice's `len` is `slice_len` and its `cap` is `field_get [24]` (the header's
// cap word), a string/map `len` is `slice_len`/`rt_call map_len`. `cap` is
// slice/array-only — the checker rejects it elsewhere.
function lowerLen(fc: FnCtx, node: int, isCap: bool): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a = args[0]
  if (getNode(fc.c.tree, a).tag == Tag.Arg) {
    a = kidsOf(fc.c.tree, a)[0]
  }
  let argTy = defaultType(fc.c, checkExprType(fc.c, a))
  let td = fc.c.ctx.types[argTy]
  let i64ty = primType(fc.c.ctx, 3)
  // A fixed-size array's length is static; the argument is not evaluated.
  if (td.kind == TypeKind.Array) {
    let ins = mkInstr(Op.ConstInt, i64ty)
    ins.ival = td.arrayLen
    return builderEmit(fc.b, ins)
  }
  let v = lowerExpr(fc, a)
  if (fc.failed) {
    return 0
  }
  if (td.kind == TypeKind.Slice) {
    if (isCap) {
      let ci = mkInstr(Op.FieldGet, i64ty)
      ci.lhs = v
      ci.ival = 24
      return builderEmit(fc.b, ci)
    }
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Prim && td.prim == 11) {
    let ins = mkInstr(Op.SliceLen, i64ty)
    ins.lhs = v
    return builderEmit(fc.b, ins)
  }
  if (!isCap && td.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, i64ty)
    ins.name = "map_len"
    ins.args = [v]
    return builderEmit(fc.b, ins)
  }
  fc.failed = true
  return 0
}

// Lowers `append(s, e1, e2, ...)`: folds each element through `slice_append`,
// threading the returned (possibly regrown) header so a `s = append(s, ...)`
// observes the new length. Each element lowers with the slice's element hint.
function lowerAppend(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let a0 = args[0]
  if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
    a0 = kidsOf(fc.c.tree, a0)[0]
  }
  let sliceTy = defaultType(fc.c, checkExprType(fc.c, a0))
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let acc = lowerExpr(fc, a0)
  if (fc.failed) {
    return 0
  }
  let i = 1
  while (i < len(args) && !fc.failed) {
    let a = args[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, sliceTy)
    ins.name = "slice_append"
    ins.args = [acc, v]
    acc = builderEmit(fc.b, ins)
    i = i + 1
  }
  return acc
}

// Lowers a call: `print(x)` -> `rt_call print`, a direct call to a top-level
// function -> `call @name(args) result`. Other callees trip `failed`.
// Lowers a type conversion `T(x)`: a no-op if the source already has the target
// type; `string([]byte)` via `rt_call string_from_bytes`; otherwise the numeric
// `convert` op.
function lowerConvert(fc: FnCtx, node: int): int {
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let arg = args[0]
  if (getNode(fc.c.tree, arg).tag == Tag.Arg) {
    arg = kidsOf(fc.c.tree, arg)[0]
  }
  let dstTy = defaultType(fc.c, checkExprType(fc.c, node))
  let srcTy = defaultType(fc.c, checkExprType(fc.c, arg))
  let src = lowerExprH(fc, arg, srcTy)
  if (fc.failed) {
    return 0
  }
  if (srcTy == dstTy) {
    return src
  }
  let dd = fc.c.ctx.types[dstTy]
  if (dd.kind == TypeKind.Prim && dd.prim == 11 && fc.c.ctx.types[srcTy].kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, dstTy)
    ins.name = "string_from_bytes"
    ins.args = [src]
    return builderEmit(fc.b, ins)
  }
  let ins = mkInstr(Op.Convert, dstTy)
  ins.lhs = src
  return builderEmit(fc.b, ins)
}

// Maps a runtime-primitive builtin name to its `rt_call` name, or "" for a
// non-primitive. Mirrors compiler/lower.zig's `prim_rt_fns` (the fs §14 / net §20
// / math §17 / time §18 / os §19 / crypto §21 surface); each lowers 1:1 to a
// runtime call whose result the checker already typed in `builtinResultType`.
function primRtName(name: string): string {
  if (name == "fsOpen") { return "fs_open" }
  if (name == "fsReadAll") { return "fs_read_all" }
  if (name == "fsWrite") { return "fs_write" }
  if (name == "fsClose") { return "fs_close" }
  if (name == "fsAppend") { return "fs_append" }
  if (name == "fsRead") { return "fs_read" }
  if (name == "fsExists") { return "fs_exists" }
  if (name == "fsIsDir") { return "fs_is_dir" }
  if (name == "fsMkdir") { return "fs_mkdir" }
  if (name == "fsRemove") { return "fs_remove" }
  if (name == "fsListDir") { return "fs_list_dir" }
  if (name == "netListen") { return "net_listen" }
  if (name == "netLocalPort") { return "net_local_port" }
  if (name == "netAccept") { return "net_accept" }
  if (name == "netDial") { return "net_dial" }
  if (name == "netRead") { return "net_read" }
  if (name == "netWrite") { return "net_write" }
  if (name == "netUdpBind") { return "net_udp_bind" }
  if (name == "netUdpSend") { return "net_udp_send" }
  if (name == "netUdpRecv") { return "net_udp_recv" }
  if (name == "netUdpSenderHost") { return "net_udp_sender_host" }
  if (name == "netUdpSenderPort") { return "net_udp_sender_port" }
  if (name == "netResolve") { return "net_resolve" }
  if (name == "fsqrt") { return "sqrt" }
  if (name == "ffloor") { return "floor" }
  if (name == "fceil") { return "ceil" }
  if (name == "fround") { return "round" }
  if (name == "ftrunc") { return "trunc" }
  if (name == "fpow") { return "pow" }
  if (name == "fatan2") { return "atan2" }
  if (name == "flog") { return "log" }
  if (name == "flog2") { return "log2" }
  if (name == "flog10") { return "log10" }
  if (name == "timeMonoNs") { return "time_mono_ns" }
  if (name == "timeUnixNs") { return "time_unix_ns" }
  if (name == "timeSleepNs") { return "time_sleep_ns" }
  if (name == "osArgc") { return "os_argc" }
  if (name == "osArgAt") { return "os_arg_at" }
  if (name == "osEnv") { return "os_env" }
  if (name == "osExit") { return "os_exit" }
  if (name == "cryptoRandomBytes") { return "random_bytes" }
  if (name == "cryptoSecureZero") { return "secure_zero" }
  if (name == "parseFloat") { return "parse_float" }
  return ""
}

function lowerCall(fc: FnCtx, node: int): int {
  let callee = kidsOf(fc.c.tree, node)[0]
  let cn = getNode(fc.c.tree, callee)
  if (cn.tag == Tag.Ident) {
    let name = fc.c.source[cn.span.start:cn.span.end]
    if (name == "print") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed || len(a) != 1) {
        fc.failed = true
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "print"
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    if (name == "panic") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed || len(a) != 1) {
        fc.failed = true
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "panic"
      ins.args = a
      let r = builderEmit(fc.b, ins)
      // panic never returns: the block ends with unreachable.
      builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
      fc.terminated = true
      return r
    }
    if (name == "assert") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      // The runtime assert has a frozen 2-arg signature (ABI.md §12); a 1-arg
      // source form supplies the default message.
      if (len(a) == 1) {
        let cs = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
        cs.sval = "assertion failed"
        a = append(a, builderEmit(fc.b, cs))
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "assert"
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    if (name == "len" || name == "cap") {
      return lowerLen(fc, node, name == "cap")
    }
    if (name == "append") {
      return lowerAppend(fc, node)
    }
    if (name == "delete") {
      let a0 = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])[0]
      if (getNode(fc.c.tree, a0).tag == Tag.Arg) {
        a0 = kidsOf(fc.c.tree, a0)[0]
      }
      let keyTy = fc.c.ctx.types[defaultType(fc.c, checkExprType(fc.c, a0))].mapKey
      let a = lowerArgs(fc, node, [0, keyTy])
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "map_delete"
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    if (name == "close") {
      let ca = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])[0]
      if (getNode(fc.c.tree, ca).tag == Tag.Arg) {
        ca = kidsOf(fc.c.tree, ca)[0]
      }
      let cv = lowerExpr(fc, ca)
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
      ins.name = "chan_close"
      ins.args = [cv]
      return builderEmit(fc.b, ins)
    }
    // A runtime-primitive builtin lowers 1:1 to its `rt_call`, result already
    // typed by the checker.
    let rt = primRtName(name)
    if (rt != "") {
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.RtCall, checkExprType(fc.c, node))
      ins.name = rt
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    // A primitive-named callee is a type conversion `T(x)`.
    if (primIndexByName(name) >= 0) {
      return lowerConvert(fc, node)
    }
    let decl = funcDeclLookup(fc.c, name)
    if (decl != 0) {
      let a = lowerArgs(fc, node, lowerParamTypes(fc.c, decl))
      if (fc.failed) {
        return 0
      }
      // A fallible callee's IR result is its ok type (the error rides the slot).
      let ins = mkInstr(Op.Call, unwrapFallible(fc.c, funcResultLookup(fc.c, name)))
      ins.name = name
      ins.args = a
      return builderEmit(fc.b, ins)
    }
  }
  // A slice-type callee is a length-sized allocation `[]E(n)`: `slice_new(n, n,
  // is_ref)`. Cap equals len (the single length arg reused).
  if (cn.tag == Tag.SliceType) {
    return lowerSliceAlloc(fc, node)
  }
  // A map-type callee is an empty-map construction `map<K,V>()`.
  if (cn.tag == Tag.MapType) {
    return lowerMapMake(fc, checkExprType(fc.c, node))
  }
  // A chan-type callee is a channel construction `chan<T>(n)`.
  if (cn.tag == Tag.ChanType) {
    return lowerChanMake(fc, node)
  }
  // A call whose callee is `Enum.Variant` constructs a payload-carrying variant.
  if (cn.tag == Tag.Member) {
    let mk0 = kidsOf(fc.c.tree, callee)
    let baseName = typeNodeName(fc.c, mk0[0])
    if (baseName != "") {
      let ut = userTypeLookup(fc.c, baseName)
      if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
        return lowerVariantConstruction(fc, node)
      }
    }
  }
  // A method call `recv.method(...)` on an interface value dispatches dynamically
  // via call_iface, using the method's stable dispatch index.
  if (cn.tag == Tag.Member) {
    let mk = kidsOf(fc.c.tree, callee)
    let recvTy = checkExprType(fc.c, mk[0])
    if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Interface) {
      let mn = getNode(fc.c.tree, mk[1])
      let mname = fc.c.source[mn.span.start:mn.span.end]
      let recvV = lowerExpr(fc, mk[0])
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      let ins = mkInstr(Op.CallIface, methodResultLookup(fc.c, typeName(fc.c.ctx, recvTy) + "." + mname))
      ins.lhs = recvV
      ins.ival = methodId(fc.lowerer, mname)
      ins.args = a
      return builderEmit(fc.b, ins)
    }
    // A method call on a concrete struct value dispatches statically to the
    // mangled method `call @method$t<recvId>(recv, args)`; the receiver is the
    // leading argument.
    if (recvTy != 0 && fc.c.ctx.types[recvTy].kind == TypeKind.Struct) {
      let mn = getNode(fc.c.tree, mk[1])
      let mname = fc.c.source[mn.span.start:mn.span.end]
      let recvV = lowerExpr(fc, mk[0])
      let a = lowerArgs(fc, node, []int(0))
      if (fc.failed) {
        return 0
      }
      let all = [recvV]
      let j = 0
      while (j < len(a)) {
        all = append(all, a[j])
        j = j + 1
      }
      let ins = mkInstr(Op.Call, unwrapFallible(fc.c, methodResultLookup(fc.c, typeName(fc.c.ctx, recvTy) + "." + mname)))
      ins.name = mname + "\$t${recvTy}"
      ins.args = all
      return builderEmit(fc.b, ins)
    }
  }
  fc.failed = true
  return 0
}

// A struct field's byte size and whether it holds a GC reference (ABI: prims by
// width, string/slice/map/chan/tuple/struct/interface/func are 8-byte handles).
// ponytail: enums treated as ref handles; C-like-enum non-ptr fields deferred.
struct FieldLayout {
  size: int,
  isPtr: bool,
}

function fieldLayoutFor(fc: FnCtx, ty: int): FieldLayout {
  let t = fc.c.ctx.types[ty]
  if (t.kind == TypeKind.Prim) {
    let p = t.prim
    if (p == 0 || p == 4 || p == 10) {
      return FieldLayout{ size: 1, isPtr: false }
    }
    if (p == 1 || p == 5) {
      return FieldLayout{ size: 2, isPtr: false }
    }
    if (p == 2 || p == 6 || p == 8) {
      return FieldLayout{ size: 4, isPtr: false }
    }
    if (p == 3 || p == 7 || p == 9) {
      return FieldLayout{ size: 8, isPtr: false }
    }
  }
  return FieldLayout{ size: 8, isPtr: true }
}

// Rounds `x` up to a multiple of `a`.
function alignUp(x: int, a: int): int {
  if (a <= 1) {
    return x
  }
  return ((x + a - 1) / a) * a
}

// A struct's total size (8-aligned), per-field byte offsets, and the offsets of
// its reference fields (for the GC descriptor). Mirrors layoutFields.
struct StructLayout {
  size: int,
  offsets: []int,
  ptrOffsets: []int,
}

// The StructDecl node for a named struct, or 0.
function structDeclByName(c: Checker, name: string): int {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.StructDecl && declName(c, i) == name) {
      return i
    }
    i = i + 1
  }
  return 0
}

// The `enum_decl` node with the given type name, or 0.
function enumDeclByName(c: Checker, name: string): int {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.EnumDecl && declName(c, i) == name) {
      return i
    }
    i = i + 1
  }
  return 0
}

// An enum declaration's variant nodes in order (kid 2 is the variant_list).
function enumVariantNodes(c: Checker, decl: int): []int {
  return kidsOf(c.tree, kidsOf(c.tree, decl)[2])
}

// The declaration-order tag of a variant name in `enumName`, or 0 if not found
// (the checker has already validated the name).
function variantOrdinal(c: Checker, enumName: string, variantName: string): int {
  let decl = enumDeclByName(c, enumName)
  if (decl == 0) {
    return 0
  }
  let vs = enumVariantNodes(c, decl)
  let i = 0
  while (i < len(vs)) {
    let vn = getNode(c.tree, kidsOf(c.tree, vs[i])[0])
    if (c.source[vn.span.start:vn.span.end] == variantName) {
      return i
    }
    i = i + 1
  }
  return 0
}

// Whether an enum carries payloads (any variant has a non-empty payload) — such
// an enum's value is a boxed `{tag, payload...}` object, not a bare tag.
function enumIsBoxed(c: Checker, enumName: string): bool {
  let decl = enumDeclByName(c, enumName)
  if (decl == 0) {
    return false
  }
  let vs = enumVariantNodes(c, decl)
  let i = 0
  while (i < len(vs)) {
    if (kidsOf(c.tree, vs[i])[1] != 0) {
      return true
    }
    i = i + 1
  }
  return false
}

// The resolved payload types of a variant (empty when it has none). The payload
// is `enum_variant`'s kid 1, a `type_list` of type nodes.
function variantPayloadTypes(c: Checker, enumName: string, variantName: string): []int {
  let out = []int(0)
  let decl = enumDeclByName(c, enumName)
  if (decl == 0) {
    return out
  }
  let vs = enumVariantNodes(c, decl)
  let i = 0
  while (i < len(vs)) {
    let vn = getNode(c.tree, kidsOf(c.tree, vs[i])[0])
    if (c.source[vn.span.start:vn.span.end] == variantName) {
      let payload = kidsOf(c.tree, vs[i])[1]
      if (payload == 0) {
        return out
      }
      let types = kidsOf(c.tree, payload)
      let j = 0
      while (j < len(types)) {
        out = append(out, typeFromNode(c, types[j]))
        j = j + 1
      }
      return out
    }
    i = i + 1
  }
  return out
}

// Builds a boxed enum object `{ tag: i64 @0, payloadPtr @8 }` (16 bytes, the
// payload pointer at offset 8 is the one GC-traced word; nil for a no-payload
// variant). `payload` is 0 for none.
function buildEnumObj(fc: FnCtx, enumTy: int, tag: int, payload: int): int {
  let i64ty = primType(fc.c.ctx, 3)
  let ga = mkInstr(Op.GcAlloc, enumTy)
  ga.ival = 16
  ga.offsets = [8]
  let obj = builderEmit(fc.b, ga)
  let tc = mkInstr(Op.ConstInt, i64ty)
  tc.ival = tag
  let fs0 = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs0.lhs = obj
  fs0.ival = 0
  fs0.rhs = builderEmit(fc.b, tc)
  builderEmit(fc.b, fs0)
  let payV = payload
  if (payload == 0) {
    let z = mkInstr(Op.ConstInt, i64ty)
    payV = builderEmit(fc.b, z)
  }
  let fs8 = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  fs8.lhs = obj
  fs8.ival = 8
  fs8.rhs = payV
  builderEmit(fc.b, fs8)
  return obj
}

// Lowers `Enum.Variant(args)` for a boxed enum: allocate the payload box (word i
// = arg i, GC-tracing its ref words), then wrap it in the enum object. A
// no-payload variant construction is just the wrapped nil.
function lowerVariantConstruction(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let enumTy = checkExprType(fc.c, k[0])
  let enumName = typeName(fc.c.ctx, enumTy)
  let mn = getNode(fc.c.tree, kidsOf(fc.c.tree, k[0])[1])
  let vname = fc.c.source[mn.span.start:mn.span.end]
  let tag = variantOrdinal(fc.c, enumName, vname)
  let payloadTypes = variantPayloadTypes(fc.c, enumName, vname)
  let box = 0
  if (len(payloadTypes) > 0) {
    let offs = []int(0)
    let i = 0
    while (i < len(payloadTypes)) {
      if (fieldLayoutFor(fc, payloadTypes[i]).isPtr) {
        offs = append(offs, 8 * i)
      }
      i = i + 1
    }
    let ga = mkInstr(Op.GcAlloc, enumTy)
    ga.ival = 8 * len(payloadTypes)
    ga.offsets = offs
    box = builderEmit(fc.b, ga)
    let args = kidsOf(fc.c.tree, k[2])
    let j = 0
    while (j < len(args) && !fc.failed) {
      let a = args[j]
      if (getNode(fc.c.tree, a).tag == Tag.Arg) {
        a = kidsOf(fc.c.tree, a)[0]
      }
      let av = lowerExprH(fc, a, payloadTypes[j])
      if (fc.failed) {
        return 0
      }
      let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
      fs.lhs = box
      fs.ival = 8 * j
      fs.rhs = av
      builderEmit(fc.b, fs)
      j = j + 1
    }
  }
  return buildEnumObj(fc, enumTy, tag, box)
}

// A struct declaration's field nodes in order (unwrapping exported fields).
function structFieldNodes(c: Checker, decl: int): []int {
  let raw = kidsOf(c.tree, kidsOf(c.tree, decl)[2])
  let out = []int(0)
  let i = 0
  while (i < len(raw)) {
    let f = raw[i]
    if (getNode(c.tree, f).tag == Tag.Export) {
      f = kidsOf(c.tree, f)[0]
    }
    out = append(out, f)
    i = i + 1
  }
  return out
}

// Computes a struct's layout from its declaration (field decl order).
function structLayout(fc: FnCtx, decl: int): StructLayout {
  let fields = structFieldNodes(fc.c, decl)
  let offsets = []int(0)
  let ptrOffsets = []int(0)
  let cur = 0
  let i = 0
  while (i < len(fields)) {
    let fty = typeFromNode(fc.c, kidsOf(fc.c.tree, fields[i])[1])
    let ft = fc.c.ctx.types[fty]
    if (ft.kind == TypeKind.Array) {
      let el = fieldLayoutFor(fc, ft.elem)
      cur = alignUp(cur, el.size)
      offsets = append(offsets, cur)
      cur = cur + ft.arrayLen * el.size
    } else {
      let fl = fieldLayoutFor(fc, fty)
      cur = alignUp(cur, fl.size)
      offsets = append(offsets, cur)
      if (fl.isPtr) {
        ptrOffsets = append(ptrOffsets, cur)
      }
      cur = cur + fl.size
    }
    i = i + 1
  }
  return StructLayout{ size: alignUp(cur, 8), offsets: offsets, ptrOffsets: ptrOffsets }
}

// The declared-order index of a field name in a struct, or -1.
function fieldIndexByName(c: Checker, fields: []int, name: string): int {
  let i = 0
  while (i < len(fields)) {
    let fn = getNode(c.tree, kidsOf(c.tree, fields[i])[0])
    if (c.source[fn.span.start:fn.span.end] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// Lowers a struct composite literal `T{f: v, ...}` to a `gc_alloc` (its GC
// descriptor is the ref-field offsets) followed by a `field_set` per field, in
// the literal's source order. ponytail: struct bodies only — []T/[N]T/map<K,V>
// composites and inline-array fields land next.
// Lowers a slice-type callee `[]E(...)`. A single `string` argument is the
// conversion `[]byte(s)` -> `bytes_from_string`. Otherwise it is a sized
// allocation `[]E(n)` / `[]E(n, m)`: `slice_new(n, cap, is_ref)`, cap defaulting
// to n, `is_ref` set when the element is pointer-sized.
function lowerSliceAlloc(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let sliceTy = typeFromNode(fc.c, kids[0])
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let args = kidsOf(fc.c.tree, kids[2])
  let arg0 = args[0]
  if (getNode(fc.c.tree, arg0).tag == Tag.Arg) {
    arg0 = kidsOf(fc.c.tree, arg0)[0]
  }
  // `[]byte(s)`: a lone string argument is the bytes-of-string conversion. A
  // string literal defaults through `untyped_string`, so default the type first.
  let a0ty = defaultType(fc.c, checkExprType(fc.c, arg0))
  if (len(args) == 1 && fc.c.ctx.types[a0ty].kind == TypeKind.Prim && fc.c.ctx.types[a0ty].prim == 11) {
    let sv = lowerExprH(fc, arg0, primType(fc.c.ctx, 11))
    if (fc.failed) {
      return 0
    }
    let bs = mkInstr(Op.RtCall, sliceTy)
    bs.name = "bytes_from_string"
    bs.args = [sv]
    return builderEmit(fc.b, bs)
  }
  let nV = lowerExprH(fc, arg0, primType(fc.c.ctx, 3))
  if (fc.failed) {
    return 0
  }
  let capV = nV
  if (len(args) >= 2) {
    let arg1 = args[1]
    if (getNode(fc.c.tree, arg1).tag == Tag.Arg) {
      arg1 = kidsOf(fc.c.tree, arg1)[0]
    }
    capV = lowerExprH(fc, arg1, primType(fc.c.ctx, 3))
    if (fc.failed) {
      return 0
    }
  }
  let refI = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [nV, capV, refV]
  return builderEmit(fc.b, sn)
}

// Lowers a `[]E{a, b, ...}` slice literal: allocate via `rt_call slice_new(len,
// len, is_ref)`, then `slice_set` each element in order. `items` are the element
// expression nodes (each possibly wrapped in an `arg`).
function lowerSliceElems(fc: FnCtx, sliceTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[sliceTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let lenI = mkInstr(Op.ConstInt, i64ty)
  lenI.ival = len(items)
  let lenV = builderEmit(fc.b, lenI)
  let refI = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    refI.ival = 1
  }
  let refV = builderEmit(fc.b, refI)
  let sn = mkInstr(Op.RtCall, sliceTy)
  sn.name = "slice_new"
  sn.args = [lenV, lenV, refV]
  let s = builderEmit(fc.b, sn)
  let i = 0
  while (i < len(items)) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let ss = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ss.name = "slice_set"
    ss.args = [s, idxV, v]
    builderEmit(fc.b, ss)
    i = i + 1
  }
  return s
}

// Allocates an empty map: `rt_call map_new(key_is_string, val_is_ref)`. The two
// flags drive the runtime's key hashing and GC tracing (ABI.md §11). `mapTy` is
// the checker's interned map type.
function lowerMapMake(fc: FnCtx, mapTy: int): int {
  let m = fc.c.ctx.types[mapTy]
  let i64ty = primType(fc.c.ctx, 3)
  let kf = mkInstr(Op.ConstInt, i64ty)
  if (fc.c.ctx.types[m.mapKey].kind == TypeKind.Prim && fc.c.ctx.types[m.mapKey].prim == 11) {
    kf.ival = 1
  }
  let kflag = builderEmit(fc.b, kf)
  let vf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, m.mapVal).isPtr) {
    vf.ival = 1
  }
  let vflag = builderEmit(fc.b, vf)
  let ins = mkInstr(Op.RtCall, mapTy)
  ins.name = "map_new"
  ins.args = [kflag, vflag]
  return builderEmit(fc.b, ins)
}

// A `map<K,V>{k: v, ...}` composite: allocate, then `map_set(m, k, v)` per entry
// in order (each key/val lowered at the map's key/val type).
function lowerMapLit(fc: FnCtx, mapTy: int, entries: []int): int {
  let m = fc.c.ctx.types[mapTy]
  let mv = lowerMapMake(fc, mapTy)
  let i = 0
  while (i < len(entries) && !fc.failed) {
    let ek = kidsOf(fc.c.tree, entries[i])
    let key = lowerExprH(fc, ek[0], m.mapKey)
    let val = lowerExprH(fc, ek[1], m.mapVal)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [mv, key, val]
    builderEmit(fc.b, ins)
    i = i + 1
  }
  return mv
}

// Constructs a channel `chan<T>(n)`: `rt_call chan_make(cap, is_ref)`, cap
// defaulting to 0 (unbuffered) when omitted; is_ref marks a pointer element word
// so the runtime traces a buffered element as a GC root (ABI.md §11).
function lowerChanMake(fc: FnCtx, node: int): int {
  let chanTy = checkExprType(fc.c, node)
  let elemTy = fc.c.ctx.types[chanTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let args = kidsOf(fc.c.tree, kidsOf(fc.c.tree, node)[2])
  let capV = 0
  if (len(args) >= 1) {
    let a = args[0]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    capV = lowerExpr(fc, a)
    if (fc.failed) {
      return 0
    }
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    capV = builderEmit(fc.b, z)
  }
  let rf = mkInstr(Op.ConstInt, i64ty)
  if (fieldLayoutFor(fc, elemTy).isPtr) {
    rf.ival = 1
  }
  let refV = builderEmit(fc.b, rf)
  let ins = mkInstr(Op.RtCall, chanTy)
  ins.name = "chan_make"
  ins.args = [capV, refV]
  return builderEmit(fc.b, ins)
}

// The byte size of a fixed-size array `[N]T`: N inline scalar elements.
function arrayBytes(fc: FnCtx, arrayTy: int): int {
  let a = fc.c.ctx.types[arrayTy]
  return a.arrayLen * fieldLayoutFor(fc, a.elem).size
}

// A fresh, zeroed inline storage block for an `[N]T` value: `gc_alloc` hands back
// zeroed memory (no reference elements to trace), so every element reads 0.
function newArray(fc: FnCtx, arrayTy: int): int {
  let ga = mkInstr(Op.GcAlloc, arrayTy)
  ga.ival = arrayBytes(fc, arrayTy)
  ga.offsets = []int(0)
  return builderEmit(fc.b, ga)
}

// Lowers an `[N]T{a, b, ...}` array literal: allocate the block, then `index_set`
// each element in order (elements are scalars, checker-restricted).
function lowerArrayElems(fc: FnCtx, arrayTy: int, items: []int): int {
  let elemTy = fc.c.ctx.types[arrayTy].elem
  let i64ty = primType(fc.c.ctx, 3)
  let dst = newArray(fc, arrayTy)
  let i = 0
  while (i < len(items) && !fc.failed) {
    let a = items[i]
    if (getNode(fc.c.tree, a).tag == Tag.Arg) {
      a = kidsOf(fc.c.tree, a)[0]
    }
    let v = lowerExprH(fc, a, elemTy)
    if (fc.failed) {
      return 0
    }
    let ci = mkInstr(Op.ConstInt, i64ty)
    ci.ival = i
    let idxV = builderEmit(fc.b, ci)
    let is = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
    is.lhs = dst
    is.rhs = idxV
    is.ival = v
    builderEmit(fc.b, is)
    i = i + 1
  }
  return dst
}

// The zero value of a type as an IR value (SPEC §13.4): a scalar constant, a
// fresh zeroed array/struct body (a live instance, not nil), else a nil word.
function zeroValue(fc: FnCtx, ty: int): int {
  let td = fc.c.ctx.types[ty]
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 10) {
      let b = mkInstr(Op.ConstBool, ty)
      b.bval = false
      return builderEmit(fc.b, b)
    }
    if (td.prim == 8 || td.prim == 9) {
      let f = mkInstr(Op.ConstFloat, ty)
      return builderEmit(fc.b, f)
    }
    if (td.prim == 11) {
      let s = mkInstr(Op.ConstString, ty)
      s.sval = ""
      return builderEmit(fc.b, s)
    }
    let ci = mkInstr(Op.ConstInt, ty)
    return builderEmit(fc.b, ci)
  }
  if (td.kind == TypeKind.Array) {
    return newArray(fc, ty)
  }
  if (td.kind == TypeKind.Struct) {
    let decl = structDeclByName(fc.c, typeName(fc.c.ctx, ty))
    if (decl == 0) {
      fc.failed = true
      return 0
    }
    let layout = structLayout(fc, decl)
    let ga = mkInstr(Op.GcAlloc, ty)
    ga.ival = layout.size
    ga.offsets = layout.ptrOffsets
    return builderEmit(fc.b, ga)
  }
  let nl = mkInstr(Op.ConstNil, ty)
  return builderEmit(fc.b, nl)
}

function lowerCompositeLit(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let structTy = typeFromNode(fc.c, kids[0])
  // A `[]E{...}` slice composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Slice) {
    return lowerSliceElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // An `[N]T{...}` array composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Array) {
    return lowerArrayElems(fc, structTy, kidsOf(fc.c.tree, kids[1]))
  }
  // A `map<K,V>{...}` composite.
  if (structTy != 0 && fc.c.ctx.types[structTy].kind == TypeKind.Map) {
    return lowerMapLit(fc, checkExprType(fc.c, node), kidsOf(fc.c.tree, kids[1]))
  }
  if (structTy == 0 || fc.c.ctx.types[structTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclByName(fc.c, typeName(fc.c.ctx, structTy))
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let layout = structLayout(fc, decl)
  let fields = structFieldNodes(fc.c, decl)
  let ga = mkInstr(Op.GcAlloc, structTy)
  ga.ival = layout.size
  ga.offsets = layout.ptrOffsets
  let obj = builderEmit(fc.b, ga)
  let inits = kidsOf(fc.c.tree, kids[1])
  let i = 0
  while (i < len(inits)) {
    let fk = kidsOf(fc.c.tree, inits[i])
    let fn = getNode(fc.c.tree, fk[0])
    let idx = fieldIndexByName(fc.c, fields, fc.c.source[fn.span.start:fn.span.end])
    if (idx == -1) {
      fc.failed = true
      return 0
    }
    let fty = typeFromNode(fc.c, kidsOf(fc.c.tree, fields[idx])[1])
    if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
      fc.failed = true
      return 0
    }
    let val = lowerExpr(fc, fk[1])
    if (fc.failed) {
      return 0
    }
    let fs = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
    fs.lhs = obj
    fs.ival = layout.offsets[idx]
    fs.rhs = val
    builderEmit(fc.b, fs)
    i = i + 1
  }
  return obj
}

// Lowers a struct field access `s.f` to `field_get %s[offset] fieldType`, or an
// enum variant reference `Enum.Variant` to its tag constant.
function lowerFieldAccess(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  // `Enum.Variant` (receiver is an enum type name): a C-like enum's variant is
  // its bare tag `const_int <Enum> <ordinal>`; a boxed enum's no-payload variant
  // wraps that tag in the `{tag, nil}` object.
  let baseName = typeNodeName(fc.c, kids[0])
  if (baseName != "") {
    let ut = userTypeLookup(fc.c, baseName)
    if (ut != 0 && fc.c.ctx.types[ut].kind == TypeKind.Enum) {
      let mn0 = getNode(fc.c.tree, kids[1])
      let ord = variantOrdinal(fc.c, baseName, fc.c.source[mn0.span.start:mn0.span.end])
      if (enumIsBoxed(fc.c, baseName)) {
        return buildEnumObj(fc, ut, ord, 0)
      }
      let ci = mkInstr(Op.ConstInt, ut)
      ci.ival = ord
      return builderEmit(fc.b, ci)
    }
  }
  let recvTy = checkExprType(fc.c, kids[0])
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fc.failed = true
    return 0
  }
  let decl = structDeclByName(fc.c, typeName(fc.c.ctx, recvTy))
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let fields = structFieldNodes(fc.c, decl)
  let mn = getNode(fc.c.tree, kids[1])
  let idx = fieldIndexByName(fc.c, fields, fc.c.source[mn.span.start:mn.span.end])
  if (idx == -1) {
    fc.failed = true
    return 0
  }
  let layout = structLayout(fc, decl)
  let recvV = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.FieldGet, typeFromNode(fc.c, kidsOf(fc.c.tree, fields[idx])[1]))
  ins.lhs = recvV
  ins.ival = layout.offsets[idx]
  return builderEmit(fc.b, ins)
}

// Lowers an index read `a[i]`: a slice via `rt_call slice_get`, a map via
// `map_get`, a string via `string_byte`, a fixed array via the `index_get` op.
function lowerIndex(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
  let ty = defaultType(fc.c, checkExprType(fc.c, node))
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  let rd = fc.c.ctx.types[recvTy]
  if (rd.kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "slice_get"
    ins.args = [recv, idx]
    return builderEmit(fc.b, ins)
  }
  if (rd.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "map_get"
    ins.args = [recv, idx]
    return builderEmit(fc.b, ins)
  }
  if (rd.kind == TypeKind.Prim && rd.prim == 11) {
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "string_byte"
    ins.args = [recv, idx]
    return builderEmit(fc.b, ins)
  }
  let ins = mkInstr(Op.IndexGet, ty)
  ins.lhs = recv
  ins.rhs = idx
  return builderEmit(fc.b, ins)
}

// Lowers a reslice `s[lo:hi]` (SPEC §12.7): `rt_call slice_slice(s, lo, hi)` for a
// slice, `string_slice` for a string. An omitted `lo` is 0; an omitted `hi` is
// the receiver's current length. Array reslice is not lowerable (matches seed).
function lowerSliceExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let recvTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let isString = rd.kind == TypeKind.Prim && rd.prim == 11
  if (rd.kind != TypeKind.Slice && !isString) {
    fc.failed = true
    return 0
  }
  let i64ty = primType(fc.c.ctx, 3)
  let recv = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let lo = 0
  if (k[1] != 0) {
    lo = lowerExprH(fc, k[1], i64ty)
  } else {
    let z = mkInstr(Op.ConstInt, i64ty)
    lo = builderEmit(fc.b, z)
  }
  let hi = 0
  if (k[2] != 0) {
    hi = lowerExprH(fc, k[2], i64ty)
  } else {
    let sl = mkInstr(Op.SliceLen, i64ty)
    sl.lhs = recv
    hi = builderEmit(fc.b, sl)
  }
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, checkExprType(fc.c, node))
  ins.name = "slice_slice"
  if (isString) {
    ins.name = "string_slice"
  }
  ins.args = [recv, lo, hi]
  return builderEmit(fc.b, ins)
}

// Converts a lowered value to a string for interpolation (§5.7): a string is
// itself; bool/float/int dispatch to their `string_from_*` runtime call. A
// struct/interface `show()` operand falls back for now.
function lowerToString(fc: FnCtx, v: int, node: int): int {
  let ty = defaultType(fc.c, checkExprType(fc.c, node))
  let td = fc.c.ctx.types[ty]
  let stringTy = primType(fc.c.ctx, 11)
  if (td.kind == TypeKind.Prim) {
    if (td.prim == 11) {
      return v
    }
    let rt = "string_from_int"
    if (td.prim == 10) {
      rt = "string_from_bool"
    } else if (td.prim == 8 || td.prim == 9) {
      rt = "string_from_float"
    }
    let ins = mkInstr(Op.RtCall, stringTy)
    ins.name = rt
    ins.args = [v]
    return builderEmit(fc.b, ins)
  }
  fc.failed = true
  return 0
}

// Lowers a string interpolation `"a${x}b"`: each literal segment -> const_string
// (decoded), each interpolated expr -> lowerToString, then the parts fold left
// with string_concat — matching the seed's lowerStrInterp.
function lowerStrInterp(fc: FnCtx, node: int): int {
  let parts = kidsOf(fc.c.tree, node)
  let stringTy = primType(fc.c.ctx, 11)
  let vals = []int(0)
  let i = 0
  while (i < len(parts) && !fc.failed) {
    let p = parts[i]
    let pn = getNode(fc.c.tree, p)
    if (pn.tag == Tag.StrPart) {
      if (spanNeedsByteEscape(fc.c.source, pn.span.start, pn.span.end)) {
        fc.failed = true
        return 0
      }
      let cs = mkInstr(Op.ConstString, stringTy)
      cs.sval = decodeEscapes(fc.c.source, pn.span.start, pn.span.end)
      vals = append(vals, builderEmit(fc.b, cs))
    } else {
      vals = append(vals, lowerToString(fc, lowerExpr(fc, p), p))
    }
    i = i + 1
  }
  if (fc.failed) {
    return 0
  }
  let acc = vals[0]
  let j = 1
  while (j < len(vals)) {
    let ins = mkInstr(Op.RtCall, stringTy)
    ins.name = "string_concat"
    ins.args = [acc, vals[j]]
    acc = builderEmit(fc.b, ins)
    j = j + 1
  }
  return acc
}

// Whether a type id is a concrete numeric prim (i8..f64), so an untyped literal
// can be materialized at that context type instead of its default.
function isNumericPrim(fc: FnCtx, ty: int): bool {
  return ty != 0 && fc.c.ctx.types[ty].kind == TypeKind.Prim && fc.c.ctx.types[ty].prim <= 9
}

// Lowers an expression with no type context.
function lowerExpr(fc: FnCtx, node: int): int {
  return lowerExprH(fc, node, 0)
}

// Lowers an expression to its SSA value id under an optional expected type
// `hint` (0 = none), which types an otherwise-untyped numeric literal — the
// seed's lowerExprH. Trips `failed` (returning 0) for unhandled constructs.
function lowerExprH(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  let tag = n.tag
  if (tag == Tag.StrInterp) {
    return lowerStrInterp(fc, node)
  }
  if (tag == Tag.IntLit) {
    let ty = defaultType(fc.c, checkExprType(fc.c, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstInt, ty)
    ins.ival = parseIntText(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.BoolLit) {
    let ins = mkInstr(Op.ConstBool, primType(fc.c.ctx, 10))
    ins.bval = fc.c.source[n.span.start:n.span.end] == "true"
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.FloatLit) {
    // An untyped float literal defaults to f64; an f32/f64 context adopts the
    // hint. `parseFloat` yields the same bits the seed does (both format via
    // `{d}`), so the const_float dump matches byte-for-byte.
    let ty = defaultType(fc.c, checkExprType(fc.c, node))
    if (isNumericPrim(fc, hint)) {
      ty = hint
    }
    let ins = mkInstr(Op.ConstFloat, ty)
    ins.fval = parseFloat(fc.c.source[n.span.start:n.span.end])
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.StringLit) {
    if (stringNeedsByteEscape(fc.c.source, n.span.start, n.span.end)) {
      fc.failed = true
      return 0
    }
    let ins = mkInstr(Op.ConstString, primType(fc.c.ctx, 11))
    ins.sval = decodeStringContent(fc.c.source, n.span.start, n.span.end)
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.Call) {
    return lowerCall(fc, node)
  }
  if (tag == Tag.CompositeLit) {
    return lowerCompositeLit(fc, node)
  }
  if (tag == Tag.SliceLit) {
    let st = defaultType(fc.c, checkExprType(fc.c, node))
    if (fc.c.ctx.types[st].kind != TypeKind.Slice) {
      fc.failed = true
      return 0
    }
    return lowerSliceElems(fc, st, kidsOf(fc.c.tree, node))
  }
  if (tag == Tag.Member) {
    return lowerFieldAccess(fc, node)
  }
  if (tag == Tag.Index) {
    return lowerIndex(fc, node)
  }
  if (tag == Tag.SliceExpr) {
    return lowerSliceExpr(fc, node)
  }
  if (tag == Tag.Ident) {
    let name = fc.c.source[n.span.start:n.span.end]
    let v = envValue(fc, name)
    if (v != -1) {
      return v
    }
    // Not a local: a module-level const inlines its initializer at the use site.
    for (k, initNode) of fc.moduleConsts {
      if (k == name) {
        return lowerExpr(fc, initNode)
      }
    }
    fc.failed = true
    return 0
  }
  if (tag == Tag.Unary) {
    return lowerUnary(fc, node, hint)
  }
  if (tag == Tag.Binary) {
    if (n.main == int(Kind.AmpAmp) || n.main == int(Kind.PipePipe)) {
      return lowerShortCircuit(fc, node)
    }
    if (isRelationalOp(n.main)) {
      return lowerComparison(fc, node)
    }
    let ty = defaultType(fc.c, checkExprType(fc.c, node))
    // String `+` is concatenation via the runtime, not an `add`.
    if (fc.c.ctx.types[ty].kind == TypeKind.Prim && fc.c.ctx.types[ty].prim == 11 &&
      n.main == int(Kind.Plus)) {
      let kids = kidsOf(fc.c.tree, node)
      let l = lowerExpr(fc, kids[0])
      let r = lowerExpr(fc, kids[1])
      if (fc.failed) {
        return 0
      }
      let sc = mkInstr(Op.RtCall, ty)
      sc.name = "string_concat"
      sc.args = [l, r]
      return builderEmit(fc.b, sc)
    }
    let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
      (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
    let signed = !(fc.c.ctx.types[ty].kind == TypeKind.Prim &&
      fc.c.ctx.types[ty].prim >= 4 && fc.c.ctx.types[ty].prim <= 7)
    let op = binOpFor(n.main, isFloat, signed)
    if (op == Op.BlockParam) {
      fc.failed = true
      return 0
    }
    let kids = kidsOf(fc.c.tree, node)
    // Operands take the operation's type as context, so an untyped literal
    // operand materializes at the same width (`a + 1` over i32 -> const_int i32).
    let lhs = lowerExprH(fc, kids[0], ty)
    let rhs = lowerExprH(fc, kids[1], ty)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(op, ty)
    ins.lhs = lhs
    ins.rhs = rhs
    return builderEmit(fc.b, ins)
  }
  if (tag == Tag.TypeAssert) {
    return lowerTypeAssert(fc, node)
  }
  if (tag == Tag.TryExpr) {
    return lowerTryExpr(fc, node)
  }
  if (tag == Tag.CatchDefault) {
    return lowerCatch(fc, node, false)
  }
  if (tag == Tag.CatchBind) {
    return lowerCatch(fc, node, true)
  }
  if (tag == Tag.MatchStmt) {
    return lowerMatchExpr(fc, node)
  }
  fc.failed = true
  return 0
}

// Lowers the one-result assertion `iface.(T)` (SPEC §14.4): the receiver, then
// `T`'s TypeInfo descriptor, then `rt_call iface_assert(recv, info) T` — which
// panics on a mismatch. The two-result form `(v, ok) = iface.(T)` routes through
// the assign path instead.
function lowerTypeAssert(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let ty = checkExprType(fc.c, node)
  let recv = lowerExpr(fc, kids[0])
  if (fc.failed) {
    return 0
  }
  let info = lowerTypeInfo(fc, ty)
  if (fc.failed) {
    return 0
  }
  let ins = mkInstr(Op.RtCall, ty)
  ins.name = "iface_assert"
  ins.args = [recv, info]
  return builderEmit(fc.b, ins)
}

// Emits a `type_info` for struct type `ty`: `disc` is the type id, `size` and
// `ptrs` its GC layout (ABI.md §2). Typed `u64` — it is a `.rodata` address, not
// a traced reference. The checker restricts assertion targets to structs.
function lowerTypeInfo(fc: FnCtx, ty: int): int {
  let decl = structDeclByName(fc.c, typeName(fc.c.ctx, ty))
  if (decl == 0) {
    fc.failed = true
    return 0
  }
  let layout = structLayout(fc, decl)
  let ti = mkInstr(Op.TypeInfo, primType(fc.c.ctx, 7))
  ti.ival = ty
  ti.ival2 = layout.size
  ti.offsets = layout.ptrOffsets
  return builderEmit(fc.b, ti)
}

// A concrete value flowing into an interface-typed slot is relabelled to the
// interface via `convert` (the pointer is unchanged; SPEC §14.3). `valTy` is the
// value's source type; a value already of the interface type passes through.
function coerceToIface(fc: FnCtx, val: int, valTy: int, targetTy: int): int {
  if (fc.c.ctx.types[targetTy].kind != TypeKind.Interface || valTy == targetTy) {
    return val
  }
  let k = fc.c.ctx.types[valTy].kind
  if (k != TypeKind.Struct && k != TypeKind.Interface && k != TypeKind.UntypedNil) {
    return val
  }
  let cv = mkInstr(Op.Convert, targetTy)
  cv.lhs = val
  return builderEmit(fc.b, cv)
}

// Lowers a unary `-x` (neg/fneg), `~x` (bnot), `!x`, or `<- ch`. The operand
// adopts the unary's materialized type so an untyped literal takes the context
// width (`let n: i8 = -5` -> `const_int i8 5; neg i8`).
function lowerUnary(fc: FnCtx, node: int, hint: int): int {
  let n = getNode(fc.c.tree, node)
  let opNode = kidsOf(fc.c.tree, node)[0]
  // The result type, adopting a concrete numeric hint when the node is untyped
  // (the seed's materializeType).
  let raw = checkExprType(fc.c, node)
  let ty = defaultType(fc.c, raw)
  if (isNumericPrim(fc, hint) && isUntyped(fc.c, raw)) {
    ty = hint
  }
  // `<- ch`: receive one word from a channel; the operand is the channel (lowered
  // plainly), the value is the result. The two-result `(v, ok) = <- ch` form
  // routes through the assign path.
  if (n.main == int(Kind.ArrowLeft)) {
    let operand = lowerExpr(fc, opNode)
    if (fc.failed) {
      return 0
    }
    let ins = mkInstr(Op.RtCall, ty)
    ins.name = "chan_recv"
    ins.args = [operand]
    return builderEmit(fc.b, ins)
  }
  let operand = lowerExprH(fc, opNode, ty)
  if (fc.failed) {
    return 0
  }
  // Logical not `!x` is `x == false` (§12.4).
  if (n.main == int(Kind.Bang)) {
    let f = mkInstr(Op.ConstBool, ty)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let eq = mkInstr(Op.ICmpEq, ty)
    eq.lhs = operand
    eq.rhs = fV
    return builderEmit(fc.b, eq)
  }
  let isFloat = fc.c.ctx.types[ty].kind == TypeKind.Prim &&
    (fc.c.ctx.types[ty].prim == 8 || fc.c.ctx.types[ty].prim == 9)
  let uop = Op.BlockParam
  if (n.main == int(Kind.Minus)) {
    if (isFloat) {
      uop = Op.FNeg
    } else {
      uop = Op.Neg
    }
  } else if (n.main == int(Kind.Tilde)) {
    uop = Op.BNot
  }
  if (uop == Op.BlockParam) {
    fc.failed = true
    return 0
  }
  let ins = mkInstr(uop, ty)
  ins.lhs = operand
  return builderEmit(fc.b, ins)
}

// Lowers a relational comparison to a bool: strings via `rt_call string_eq`
// (only `==` for now), floats via `fcmp_*`, ints via signed/unsigned `icmp_*`
// picked from the operand type.
function lowerComparison(fc: FnCtx, node: int): int {
  let kids = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  // The comparison type is the operands merged, so a literal operand takes the
  // other's concrete width (`x == 0` over u8 -> both u8).
  let operandTy = defaultType(fc.c, mergeTypes(fc.c, checkExprType(fc.c, kids[0]),
    checkExprType(fc.c, kids[1])))
  let td = fc.c.ctx.types[operandTy]
  let boolTy = primType(fc.c.ctx, 10)
  let lhs = lowerExprH(fc, kids[0], operandTy)
  let rhs = lowerExprH(fc, kids[1], operandTy)
  if (fc.failed) {
    return 0
  }
  // String (in)equality dispatches to `string_eq`; `!=` negates it via `== false`
  // (the seed's form). Ordered string comparisons fall back for now.
  if (td.kind == TypeKind.Prim && td.prim == 11) {
    if (opKind != int(Kind.EqEq) && opKind != int(Kind.BangEq)) {
      fc.failed = true
      return 0
    }
    let se = mkInstr(Op.RtCall, boolTy)
    se.name = "string_eq"
    se.args = [lhs, rhs]
    let eq = builderEmit(fc.b, se)
    if (opKind == int(Kind.EqEq)) {
      return eq
    }
    let f = mkInstr(Op.ConstBool, boolTy)
    f.bval = false
    let fV = builderEmit(fc.b, f)
    let ne = mkInstr(Op.ICmpEq, boolTy)
    ne.lhs = eq
    ne.rhs = fV
    return builderEmit(fc.b, ne)
  }
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  let cop = cmpOpFor(opKind, isFloat, signed)
  if (cop == Op.BlockParam) {
    fc.failed = true
    return 0
  }
  let ins = mkInstr(cop, boolTy)
  ins.lhs = lhs
  ins.rhs = rhs
  return builderEmit(fc.b, ins)
}

// Emits a `jump target(args)` terminator.
function emitJump(fc: FnCtx, target: int, args: []int) {
  let ins = mkInstr(Op.Jump, fc.c.ctx.voidId)
  ins.ival = target
  ins.args = args
  builderEmit(fc.b, ins)
}

// Lowers a short-circuit `a && b` / `a || b` to a bool value: branch on `a`;
// only when it doesn't decide the result is `b` evaluated in its own block; the
// join block's single bool parameter is the result. The condition sub-blocks
// carry just the bool value (no live locals — the operands are side-effect-free
// for env purposes). Mirrors the seed's lowerShortCircuit; join left open.
function lowerShortCircuit(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let opKind = getNode(fc.c.tree, node).main
  let boolTy = primType(fc.c.ctx, 10)
  let lval = lowerExpr(fc, k[0])
  if (fc.failed) {
    return 0
  }
  let rhsBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = lval
  if (opKind == int(Kind.AmpAmp)) {
    // `a && b`: a true -> evaluate b; a false -> result is a.
    br.ival = rhsBlk
    br.thenArgs = []int(0)
    br.ival2 = join
    br.elseArgs = [lval]
  } else {
    // `a || b`: a true -> result is a; a false -> evaluate b.
    br.ival = join
    br.thenArgs = [lval]
    br.ival2 = rhsBlk
    br.elseArgs = []int(0)
  }
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, rhsBlk)
  let rval = lowerExpr(fc, k[1])
  if (fc.failed) {
    return 0
  }
  emitJump(fc, join, [rval])
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, join)
  return builderAddParam(fc.b, boolTy)
}

// Lowers an `if (cond) then [else]` to br + then/else/join blocks, threading the
// live locals (env[0..preLen]) as join-block parameters — the seed's lowerIf.
// The join block is left open for the following statements.
function lowerIf(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let thenBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let hasElse = k[2] != 0
  let elseBlk = join
  if (hasElse) {
    elseBlk = builderNewBlock(fc.b)
  }
  // Branch: then edge carries no args; a missing else sends the fall-through
  // edge to the join with the live locals.
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = thenBlk
  br.thenArgs = []int(0)
  br.ival2 = elseBlk
  if (hasElse) {
    br.elseArgs = []int(0)
  } else {
    br.elseArgs = orig
  }
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)

  builderBeginBlock(fc.b, thenBlk)
  fc.terminated = false
  lowerStmtList(fc, k[1])
  let joinReachable = !hasElse
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)

  if (hasElse) {
    builderBeginBlock(fc.b, elseBlk)
    fc.terminated = false
    if (getNode(fc.c.tree, k[2]).tag == Tag.IfStmt) {
      lowerIf(fc, k[2])
    } else {
      lowerStmtList(fc, k[2])
    }
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
  }

  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// A single switch-case label test: `subject == label` for a subject switch, or
// the label evaluated as a bool for a subject-less switch.
function caseTest(fc: FnCtx, hasSubject: bool, subject: int, subjectTy: int, expr: int): int {
  if (!hasSubject) {
    return lowerExprH(fc, expr, primType(fc.c.ctx, 10))
  }
  let eq = mkInstr(Op.ICmpEq, primType(fc.c.ctx, 10))
  eq.lhs = subject
  eq.rhs = lowerExprH(fc, expr, subjectTy)
  return builderEmit(fc.b, eq)
}

// Lowers a `switch (subject) { case a, b: ...; default: ... }` over a value to a
// decision chain: each case's `subject == expr` (OR-folded across its labels)
// branches to the body or the next test; an unmatched value falls to `default`.
// ponytail: subject-less `switch { case cond: }` and break-in-case deferred.
function lowerSwitch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let boolTy = primType(fc.c.ctx, 10)
  // Subject-less `switch { case cond: ... }`: each label is a bool condition
  // tested directly. A subject switch compares `subject == label`.
  let hasSubject = k[0] != 0
  let subjectTy = boolTy
  let subject = 0
  if (hasSubject) {
    subjectTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
    subject = lowerExprH(fc, k[0], subjectTy)
    if (fc.failed) {
      return
    }
  }
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let cases = kidsOf(fc.c.tree, k[1])
  // Count the non-default cases and find the default body.
  let m = 0
  let defaultStmts = 0
  let ci = 0
  while (ci < len(cases)) {
    let t = getNode(fc.c.tree, cases[ci]).tag
    if (t == Tag.SwitchCase) {
      m = m + 1
    } else if (t == Tag.SwitchDefault) {
      defaultStmts = kidsOf(fc.c.tree, cases[ci])[0]
    }
    ci = ci + 1
  }
  let join = builderNewBlock(fc.b)
  let dflt = 0
  if (m > 0) {
    dflt = builderNewBlock(fc.b)
  }
  // A switch is a `break` target (to the join) but not a `continue` target.
  fc.loops = append(fc.loops, LoopFrame{ exit: join, cont: join, preLen: preLen, isSwitch: true })
  let joinReachable = false
  let seen = 0
  ci = 0
  while (ci < len(cases) && !fc.failed) {
    if (getNode(fc.c.tree, cases[ci]).tag != Tag.SwitchCase) {
      ci = ci + 1
      continue
    }
    let ck = kidsOf(fc.c.tree, cases[ci])
    let exprs = kidsOf(fc.c.tree, ck[0])
    let cond = caseTest(fc, hasSubject, subject, subjectTy, exprs[0])
    let ei = 1
    while (ei < len(exprs)) {
      let bor = mkInstr(Op.BOr, boolTy)
      bor.lhs = cond
      bor.rhs = caseTest(fc, hasSubject, subject, subjectTy, exprs[ei])
      cond = builderEmit(fc.b, bor)
      ei = ei + 1
    }
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = dflt
    if (seen != m - 1) {
      nextBlk = builderNewBlock(fc.b)
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    restoreValues(fc, orig)
    let mark = len(fc.env)
    lowerStmtList(fc, ck[1])
    truncateEnv(fc, mark)
    if (!fc.terminated) {
      joinReachable = true
      emitJump(fc, join, snapshotValues(fc, preLen))
    }
    builderEndBlock(fc.b)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    seen = seen + 1
    ci = ci + 1
  }
  // Positioned in the "no case matched" block (dflt when m>0, else the caller's).
  fc.terminated = false
  restoreValues(fc, orig)
  if (defaultStmts != 0) {
    let mark = len(fc.env)
    lowerStmtList(fc, defaultStmts)
    truncateEnv(fc, mark)
  }
  if (!fc.terminated) {
    joinReachable = true
    emitJump(fc, join, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Lowers a match arm's body — a `{ … }` block or a single statement.
function lowerArmBody(fc: FnCtx, body: int) {
  if (getNode(fc.c.tree, body).tag == Tag.Block) {
    lowerStmtList(fc, body)
  } else {
    lowerStmt(fc, body)
  }
}

// Lowers one match-statement arm's body in the current block; on a non-diverging
// arm, carries the live locals to `join`. Returns whether the join is reached.
// The scrutinee tag: a boxed enum's tag is word 0 of the object (i64); a C-like
// enum's value IS its tag.
function matchTag(fc: FnCtx, subject: int, subjectTy: int, boxed: bool): int {
  if (!boxed) {
    return subject
  }
  let fg = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  fg.lhs = subject
  fg.ival = 0
  return builderEmit(fc.b, fg)
}

// The tag type used for the arm comparison: i64 for boxed, the enum type for
// C-like (so the compare operands share a type).
function tagType(fc: FnCtx, subjectTy: int, boxed: bool): int {
  if (boxed) {
    return primType(fc.c.ctx, 3)
  }
  return subjectTy
}

// Binds a boxed variant arm's payload `V(a, b) =>`: word i of the box (object
// word 8) into binder i. No-op for a C-like enum or a no-binder arm.
function bindArmPayload(fc: FnCtx, arm: int, boxed: bool, enumName: string, subject: int) {
  if (!boxed) {
    return
  }
  let vp = kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])
  if (vp[1] == 0) {
    return
  }
  let vn = getNode(fc.c.tree, vp[0])
  let ptypes = variantPayloadTypes(fc.c, enumName, fc.c.source[vn.span.start:vn.span.end])
  let binders = kidsOf(fc.c.tree, vp[1])
  let box = mkInstr(Op.FieldGet, primType(fc.c.ctx, 3))
  box.lhs = subject
  box.ival = 8
  let boxV = builderEmit(fc.b, box)
  let i = 0
  while (i < len(binders)) {
    let bty = primType(fc.c.ctx, 3)
    if (i < len(ptypes)) {
      bty = ptypes[i]
    }
    let fg = mkInstr(Op.FieldGet, bty)
    fg.lhs = boxV
    fg.ival = 8 * i
    let bn = getNode(fc.c.tree, binders[i])
    let bname = fc.c.source[bn.span.start:bn.span.end]
    declareLocal(fc, bname, builderEmit(fc.b, fg), bty)
    // Keep the checker env consistent so `checkExprType` types the binder during
    // lowering (see lowerFunc).
    fc.c.env[bname] = bty
    i = i + 1
  }
}

function lowerMatchArm(fc: FnCtx, arm: int, preLen: int, join: int, boxed: bool, enumName: string, subject: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumName, subject)
  lowerArmBody(fc, ak[1])
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, snapshotValues(fc, preLen))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => body, ... }` statement over an enum to a
// decision tree: each arm but the last tests `tag == <ordinal>` and branches to
// its body or the next test; the last arm is the exhaustive fallthrough. A `join`
// block merges the non-diverging arms (unreachable if every arm diverges). A
// boxed enum's tag is object word 0 and its arms bind the payload.
function lowerMatch(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let subjectTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fc.failed = true
    return
  }
  let enumName = typeName(fc.c.ctx, subjectTy)
  let boxed = enumIsBoxed(fc.c, enumName)
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    return
  }
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, enumName, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchArm(fc, arm, preLen, join, boxed, enumName, subject)) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  // Last arm: the exhaustive fallthrough, lowered in the current block with no
  // test.
  fc.terminated = false
  if (lowerMatchArm(fc, arms[len(arms) - 1], preLen, join, boxed, enumName, subject)) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (joinReachable) {
    addJoinParams(fc, preLen)
    fc.terminated = false
  } else {
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
  }
}

// Lowers one match-expression arm: its body is an *expression* whose value is
// carried to the join as the trailing block param. Returns whether the join is
// reached.
function lowerMatchExprArm(fc: FnCtx, arm: int, preLen: int, join: int, resultTy: int, isVoid: bool, boxed: bool, enumName: string, subject: int): bool {
  let ak = kidsOf(fc.c.tree, arm)
  bindArmPayload(fc, arm, boxed, enumName, subject)
  let val = 0
  if (isVoid) {
    lowerExpr(fc, ak[1])
  } else {
    val = lowerExprH(fc, ak[1], resultTy)
  }
  if (fc.failed) {
    return false
  }
  if (!fc.terminated) {
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), val, isVoid))
    return true
  }
  return false
}

// Lowers a `match (subject) { V => expr, ... }` in expression position over a
// C-like enum: like the statement form, but each arm yields a value merged at the
// join's trailing param — the whole match's value. ponytail: boxed enums deferred.
function lowerMatchExpr(fc: FnCtx, node: int): int {
  let k = kidsOf(fc.c.tree, node)
  let resultTy = defaultType(fc.c, checkExprType(fc.c, node))
  let subjectTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
  if (fc.c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    fc.failed = true
    return 0
  }
  let enumName = typeName(fc.c.ctx, subjectTy)
  let boxed = enumIsBoxed(fc.c, enumName)
  let subject = lowerExprH(fc, k[0], subjectTy)
  if (fc.failed) {
    return 0
  }
  let arms = kidsOf(fc.c.tree, k[1])
  if (len(arms) == 0) {
    fc.failed = true
    return 0
  }
  let isVoid = resultTy == fc.c.ctx.voidId
  let boolTy = primType(fc.c.ctx, 10)
  let tagTy = tagType(fc, subjectTy, boxed)
  let tag = matchTag(fc, subject, subjectTy, boxed)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let join = builderNewBlock(fc.b)
  let joinReachable = false
  let i = 0
  while (i < len(arms) - 1 && !fc.failed) {
    let arm = arms[i]
    let vn = getNode(fc.c.tree, kidsOf(fc.c.tree, kidsOf(fc.c.tree, arm)[0])[0])
    let armTag = variantOrdinal(fc.c, enumName, fc.c.source[vn.span.start:vn.span.end])
    let bodyBlk = builderNewBlock(fc.b)
    let nextBlk = builderNewBlock(fc.b)
    let ci = mkInstr(Op.ConstInt, tagTy)
    ci.ival = armTag
    let eq = mkInstr(Op.ICmpEq, boolTy)
    eq.lhs = tag
    eq.rhs = builderEmit(fc.b, ci)
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = builderEmit(fc.b, eq)
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = nextBlk
    br.elseArgs = []int(0)
    builderEmit(fc.b, br)
    builderEndBlock(fc.b)
    builderBeginBlock(fc.b, bodyBlk)
    fc.terminated = false
    if (lowerMatchExprArm(fc, arm, preLen, join, resultTy, isVoid, boxed, enumName, subject)) {
      joinReachable = true
    }
    builderEndBlock(fc.b)
    truncateEnv(fc, preLen)
    restoreValues(fc, orig)
    builderBeginBlock(fc.b, nextBlk)
    i = i + 1
  }
  fc.terminated = false
  if (lowerMatchExprArm(fc, arms[len(arms) - 1], preLen, join, resultTy, isVoid, boxed, enumName, subject)) {
    joinReachable = true
  }
  builderEndBlock(fc.b)
  truncateEnv(fc, preLen)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  if (!joinReachable) {
    let phTy = resultTy
    if (isVoid) {
      phTy = primType(fc.c.ctx, 3)
    }
    let ph = zeroValue(fc, phTy)
    builderEmit(fc.b, mkInstr(Op.Unreachable, fc.c.ctx.voidId))
    fc.terminated = true
    return ph
  }
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    let z = mkInstr(Op.ConstInt, primType(fc.c.ctx, 3))
    return builderEmit(fc.b, z)
  }
  return builderAddParam(fc.b, resultTy)
}

// Drops env locals beyond `n` (a scope exit), keeping the first `n`.
function truncateEnv(fc: FnCtx, n: int) {
  fc.env = fc.env[0:n]
}

// The env index of a local (most recent binding), or -1 if unbound.
function envIndex(fc: FnCtx, name: string): int {
  let i = len(fc.env) - 1
  while (i >= 0) {
    if (fc.env[i].name == name) {
      return i
    }
    i = i - 1
  }
  return -1
}

// The base binary operator of a compound-assignment kind (`+=` -> `+`), or -1.
function compoundBase(op: int): int {
  if (op == int(Kind.PlusEq)) { return int(Kind.Plus) }
  if (op == int(Kind.MinusEq)) { return int(Kind.Minus) }
  if (op == int(Kind.StarEq)) { return int(Kind.Star) }
  if (op == int(Kind.SlashEq)) { return int(Kind.Slash) }
  if (op == int(Kind.PercentEq)) { return int(Kind.Percent) }
  if (op == int(Kind.AmpEq)) { return int(Kind.Amp) }
  if (op == int(Kind.PipeEq)) { return int(Kind.Pipe) }
  if (op == int(Kind.CaretEq)) { return int(Kind.Caret) }
  if (op == int(Kind.ShlEq)) { return int(Kind.Shl) }
  if (op == int(Kind.ShrEq)) { return int(Kind.Shr) }
  return -1
}

// The IR op for a base arithmetic operator over a value of type `ty`.
function arithOpFor(fc: FnCtx, base: int, ty: int): Op {
  let td = fc.c.ctx.types[ty]
  let isFloat = td.kind == TypeKind.Prim && (td.prim == 8 || td.prim == 9)
  let signed = !(td.kind == TypeKind.Prim && td.prim >= 4 && td.prim <= 7)
  return binOpFor(base, isFloat, signed)
}

// Lowers an assignment to a simple local `x`: `x = e` SSA-reassigns the local's
// value; `x op= e` reads it, applies the base op, and reassigns. ponytail:
// single simple-ident target only; field/index lvalues land next.
// Lowers `s.f = v` to `field_set %s[offset] = %v` at the field's byte offset.
// ponytail: inline-array fields (copy semantics) deferred.
function lowerFieldStore(fc: FnCtx, lhs: int, rhs: int) {
  let mk = kidsOf(fc.c.tree, lhs)
  let recvTy = checkExprType(fc.c, mk[0])
  if (recvTy == 0 || fc.c.ctx.types[recvTy].kind != TypeKind.Struct) {
    fc.failed = true
    return
  }
  let decl = structDeclByName(fc.c, typeName(fc.c.ctx, recvTy))
  if (decl == 0) {
    fc.failed = true
    return
  }
  let fields = structFieldNodes(fc.c, decl)
  let mn = getNode(fc.c.tree, mk[1])
  let fidx = fieldIndexByName(fc.c, fields, fc.c.source[mn.span.start:mn.span.end])
  if (fidx == -1) {
    fc.failed = true
    return
  }
  let fty = typeFromNode(fc.c, kidsOf(fc.c.tree, fields[fidx])[1])
  if (fc.c.ctx.types[fty].kind == TypeKind.Array) {
    fc.failed = true
    return
  }
  let recv = lowerExpr(fc, mk[0])
  let v = lowerExprH(fc, rhs, fty)
  if (fc.failed) {
    return
  }
  let ins = mkInstr(Op.FieldSet, fc.c.ctx.voidId)
  ins.lhs = recv
  ins.ival = structLayout(fc, decl).offsets[fidx]
  ins.rhs = v
  builderEmit(fc.b, ins)
}

// Lowers `a[i] = v`: a slice via `rt_call slice_set`, a map via `map_set`, a
// fixed array via the `index_set` op.
function lowerIndexStore(fc: FnCtx, lhs: int, rhs: int) {
  let k = kidsOf(fc.c.tree, lhs)
  let recvTy = defaultType(fc.c, checkExprType(fc.c, k[0]))
  let rd = fc.c.ctx.types[recvTy]
  let recv = lowerExpr(fc, k[0])
  let idx = lowerExpr(fc, k[1])
  let elemTy = defaultType(fc.c, checkExprType(fc.c, lhs))
  let v = lowerExprH(fc, rhs, elemTy)
  if (fc.failed) {
    return
  }
  if (rd.kind == TypeKind.Slice) {
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "slice_set"
    ins.args = [recv, idx, v]
    builderEmit(fc.b, ins)
    return
  }
  if (rd.kind == TypeKind.Map) {
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "map_set"
    ins.args = [recv, idx, v]
    builderEmit(fc.b, ins)
    return
  }
  let ins = mkInstr(Op.IndexSet, fc.c.ctx.voidId)
  ins.lhs = recv
  ins.rhs = idx
  ins.ival = v
  builderEmit(fc.b, ins)
}

function lowerAssign(fc: FnCtx, node: int) {
  let opKind = getNode(fc.c.tree, node).main
  let k = kidsOf(fc.c.tree, node)
  let lhsItems = kidsOf(fc.c.tree, k[0])
  let rhsItems = kidsOf(fc.c.tree, k[1])
  if (len(lhsItems) != 1 || len(rhsItems) != 1) {
    fc.failed = true
    return
  }
  let ln = getNode(fc.c.tree, lhsItems[0])
  // A plain assignment to a struct field or a collection element.
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Member) {
    lowerFieldStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  if (opKind == int(Kind.Eq) && ln.tag == Tag.Index) {
    lowerIndexStore(fc, lhsItems[0], rhsItems[0])
    return
  }
  if (ln.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let idx = envIndex(fc, fc.c.source[ln.span.start:ln.span.end])
  if (idx == -1) {
    fc.failed = true
    return
  }
  let ty = fc.env[idx].ty
  if (opKind == int(Kind.Eq)) {
    let v = lowerExprH(fc, rhsItems[0], ty)
    if (fc.failed) {
      return
    }
    fc.env[idx].value = v
    return
  }
  let base = compoundBase(opKind)
  if (base == -1) {
    fc.failed = true
    return
  }
  let cur = fc.env[idx].value
  let rhs = lowerExprH(fc, rhsItems[0], ty)
  if (fc.failed) {
    return
  }
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fc.failed = true
    return
  }
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = rhs
  fc.env[idx].value = builderEmit(fc.b, ins)
}

// Lowers `x++` / `x--` on a local: `base` is Plus/Minus. Emits `const_int 1`
// then the add/sub, and reassigns the local.
function lowerIncDec(fc: FnCtx, node: int, base: int) {
  let ln = getNode(fc.c.tree, kidsOf(fc.c.tree, node)[0])
  if (ln.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let idx = envIndex(fc, fc.c.source[ln.span.start:ln.span.end])
  if (idx == -1) {
    fc.failed = true
    return
  }
  let ty = fc.env[idx].ty
  let cur = fc.env[idx].value
  let one = mkInstr(Op.ConstInt, ty)
  one.ival = 1
  let oneV = builderEmit(fc.b, one)
  let op = arithOpFor(fc, base, ty)
  if (op == Op.BlockParam) {
    fc.failed = true
    return
  }
  let ins = mkInstr(op, ty)
  ins.lhs = cur
  ins.rhs = oneV
  fc.env[idx].value = builderEmit(fc.b, ins)
}

// Lowers a `while (cond) body`: jump to a header block (loop-carried live locals
// as block params), test the condition, branch into the body or out to the
// exit; the body back-jumps to the header. break/continue target exit/header via
// the loop stack. Mirrors the seed's lowerWhile. Exit block left open.
function lowerWhile(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  // Entry edge into the header.
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: loop-carried params, then the condition + branch.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let cond = lowerExpr(fc, k[0])
  if (fc.failed) {
    return
  }
  // The body is dominated by the header (single predecessor), so it takes no
  // params; only the exit is a real merge (this edge + every break).
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = cond
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  // Body.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: header, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  lowerStmtList(fc, k[1])
  if (!fc.terminated) {
    emitJump(fc, header, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  truncateEnv(fc, preLen)
  // Exit: merges the false-branch and every break.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
}

// Lowers `for x of it` over a slice or array to the seed's counted-loop SSA:
// hidden `$iter`/`$idx` locals thread through a header (test idx < len), a body
// (bind the element, run the body), a step (advance idx, back to header), and an
// exit. break -> exit, continue -> step. ponytail: slice/array only — map
// iteration ($idx cursor via map_iter_*) deferred.
function lowerForOf(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let iterTy = defaultType(fc.c, checkExprType(fc.c, k[1]))
  let id = fc.c.ctx.types[iterTy]
  let isMap = id.kind == TypeKind.Map
  if (id.kind != TypeKind.Slice && id.kind != TypeKind.Array && !isMap) {
    fc.failed = true
    return
  }
  // A slice/array binds one element; a map binds a `(key, value)` pair.
  let binderNode = getNode(fc.c.tree, k[0])
  if (isMap && binderNode.tag != Tag.TuplePat) {
    fc.failed = true
    return
  }
  if (!isMap && binderNode.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let elemTy = id.elem
  let i64ty = primType(fc.c.ctx, 3)
  let iterVal = lowerExpr(fc, k[1])
  if (fc.failed) {
    return
  }
  // Carry the iterable + cursor as hidden locals so they thread through the
  // loop's block params. A map's cursor starts at its first live slot (or -1);
  // a slice/array counts up from 0.
  declareLocal(fc, "$iter", iterVal, iterTy)
  let startV = 0
  if (isMap) {
    let mi = mkInstr(Op.RtCall, i64ty)
    mi.name = "map_iter_init"
    mi.args = [iterVal]
    startV = builderEmit(fc.b, mi)
  } else {
    let zero = mkInstr(Op.ConstInt, i64ty)
    startV = builderEmit(fc.b, zero)
  }
  declareLocal(fc, "$idx", startV, i64ty)
  let preLen = len(fc.env)
  let idxSlot = preLen - 1
  let iterSlot = preLen - 2
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let stepBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: a map continues while the slot cursor is >= 0; a slice/array while
  // the index is below the length.
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  let idxVal = fc.env[idxSlot].value
  let iterCur = fc.env[iterSlot].value
  let cmp = mkInstr(Op.ICmpSge, primType(fc.c.ctx, 10))
  if (isMap) {
    let z = mkInstr(Op.ConstInt, i64ty)
    cmp.lhs = idxVal
    cmp.rhs = builderEmit(fc.b, z)
  } else {
    let lenVal = 0
    if (id.kind == TypeKind.Array) {
      let ci = mkInstr(Op.ConstInt, i64ty)
      ci.ival = id.arrayLen
      lenVal = builderEmit(fc.b, ci)
    } else {
      let sl = mkInstr(Op.SliceLen, i64ty)
      sl.lhs = iterCur
      lenVal = builderEmit(fc.b, sl)
    }
    cmp = mkInstr(Op.ICmpSlt, primType(fc.c.ctx, 10))
    cmp.lhs = idxVal
    cmp.rhs = lenVal
  }
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = builderEmit(fc.b, cmp)
  br.ival = bodyBlk
  br.thenArgs = []int(0)
  br.ival2 = exitBlk
  br.elseArgs = snapshotValues(fc, preLen)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  // Body: bind the element (or key/value pair), run the body, fall to the step.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: stepBlk, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  let bodyMark = len(fc.env)
  if (isMap) {
    let subs = kidsOf(fc.c.tree, k[0])
    let kv = mkInstr(Op.RtCall, id.mapKey)
    kv.name = "map_key_at"
    kv.args = [iterCur, idxVal]
    let keyV = builderEmit(fc.b, kv)
    let vv = mkInstr(Op.RtCall, id.mapVal)
    vv.name = "map_val_at"
    vv.args = [iterCur, idxVal]
    let valV = builderEmit(fc.b, vv)
    let kn = getNode(fc.c.tree, subs[0])
    let vn = getNode(fc.c.tree, subs[1])
    declareLocal(fc, fc.c.source[kn.span.start:kn.span.end], keyV, id.mapKey)
    declareLocal(fc, fc.c.source[vn.span.start:vn.span.end], valV, id.mapVal)
  } else {
    let elemV = 0
    if (id.kind == TypeKind.Slice) {
      let sg = mkInstr(Op.RtCall, elemTy)
      sg.name = "slice_get"
      sg.args = [iterCur, idxVal]
      elemV = builderEmit(fc.b, sg)
    } else {
      let ig = mkInstr(Op.IndexGet, elemTy)
      ig.lhs = iterCur
      ig.rhs = idxVal
      elemV = builderEmit(fc.b, ig)
    }
    declareLocal(fc, fc.c.source[binderNode.span.start:binderNode.span.end], elemV, elemTy)
  }
  lowerStmtList(fc, k[2])
  truncateEnv(fc, bodyMark)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  if (!fc.terminated) {
    emitJump(fc, stepBlk, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  // Step: advance the cursor (map: next live slot; slice/array: +1), back to the
  // header.
  builderBeginBlock(fc.b, stepBlk)
  addJoinParams(fc, preLen)
  if (isMap) {
    let nx = mkInstr(Op.RtCall, i64ty)
    nx.name = "map_iter_next"
    nx.args = [fc.env[iterSlot].value, fc.env[idxSlot].value]
    fc.env[idxSlot].value = builderEmit(fc.b, nx)
  } else {
    let one = mkInstr(Op.ConstInt, i64ty)
    one.ival = 1
    let add = mkInstr(Op.Add, i64ty)
    add.lhs = fc.env[idxSlot].value
    add.rhs = builderEmit(fc.b, one)
    fc.env[idxSlot].value = builderEmit(fc.b, add)
  }
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Exit.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
  // Drop the hidden $iter/$idx locals.
  truncateEnv(fc, preLen - 2)
}

// Lowers a C-style `for (init; cond; post) body`. `init` declares the loop
// variables (threaded through the loop's block params); the header tests `cond`
// (an absent cond loops forever), `continue` targets the `post` block so the step
// always runs, and `post` advances before re-testing. Kids: [init, cond, post,
// body], each possibly absent (0).
function lowerForC(fc: FnCtx, node: int) {
  let k = kidsOf(fc.c.tree, node)
  let outerMark = len(fc.env)
  if (k[0] != 0) {
    lowerStmt(fc, k[0])
    if (fc.failed) {
      return
    }
  }
  let preLen = len(fc.env)
  let header = builderNewBlock(fc.b)
  let bodyBlk = builderNewBlock(fc.b)
  let postBlk = builderNewBlock(fc.b)
  let exitBlk = builderNewBlock(fc.b)
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Header: test the condition; body is reached only here (no params), exit
  // merges this edge with every break (carries the loop values).
  builderBeginBlock(fc.b, header)
  addJoinParams(fc, preLen)
  if (k[1] != 0) {
    let cond = lowerExpr(fc, k[1])
    if (fc.failed) {
      return
    }
    let br = mkInstr(Op.Br, fc.c.ctx.voidId)
    br.lhs = cond
    br.ival = bodyBlk
    br.thenArgs = []int(0)
    br.ival2 = exitBlk
    br.elseArgs = snapshotValues(fc, preLen)
    builderEmit(fc.b, br)
  } else {
    emitJump(fc, bodyBlk, []int(0))
  }
  builderEndBlock(fc.b)
  // Body: run it, fall through to the post block.
  fc.loops = append(fc.loops, LoopFrame{ exit: exitBlk, cont: postBlk, preLen: preLen, isSwitch: false })
  builderBeginBlock(fc.b, bodyBlk)
  fc.terminated = false
  let bodyMark = len(fc.env)
  lowerStmtList(fc, k[3])
  truncateEnv(fc, bodyMark)
  fc.loops = fc.loops[0:len(fc.loops) - 1]
  if (!fc.terminated) {
    emitJump(fc, postBlk, snapshotValues(fc, preLen))
  }
  builderEndBlock(fc.b)
  // Post: run the step, back to the header.
  builderBeginBlock(fc.b, postBlk)
  addJoinParams(fc, preLen)
  if (k[2] != 0) {
    lowerStmt(fc, k[2])
    if (fc.failed) {
      return
    }
  }
  emitJump(fc, header, snapshotValues(fc, preLen))
  builderEndBlock(fc.b)
  // Exit: drop the loop variables.
  builderBeginBlock(fc.b, exitBlk)
  addJoinParams(fc, preLen)
  fc.terminated = false
  truncateEnv(fc, outerMark)
}

// Lowers one `let`/`const` binding: a simple `name = init` binds the init's
// value id in env (no instruction — the local IS its init value). tuple/zero-
// init bindings fall back for now.
function lowerBinding(fc: FnCtx, node: int) {
  let kids = kidsOf(fc.c.tree, node)
  let pat = getNode(fc.c.tree, kids[0])
  if (pat.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let declared = fc.c.nodeTypes[kids[0]]
  let bname0 = fc.c.source[pat.span.start:pat.span.end]
  // An initializer-less typed binding (`let z: [4]u32` / `let s: S`) is its
  // type's zero value — a live, zeroed array/struct body, not nil (SPEC §13.4).
  if (kids[2] == 0) {
    if (declared == 0) {
      fc.failed = true
      return
    }
    let zv = zeroValue(fc, declared)
    if (fc.failed) {
      return
    }
    declareLocal(fc, bname0, zv, declared)
    fc.c.env[bname0] = declared
    return
  }
  // The binding's declared type is the initializer's context, so a typed
  // literal (`let a: i32 = 0x7F`) materializes at that width.
  let rhsTy = defaultType(fc.c, checkExprType(fc.c, kids[2]))
  let v = lowerExprH(fc, kids[2], declared)
  if (fc.failed) {
    return
  }
  // A concrete initializer into an interface-typed binding is relabelled to the
  // interface (SPEC §14.3).
  v = coerceToIface(fc, v, rhsTy, declared)
  let bname = fc.c.source[pat.span.start:pat.span.end]
  declareLocal(fc, bname, v, declared)
  // Keep the checker's flat env consistent with this body's locals so a later
  // `checkExprType` on the name resolves to this type (see lowerFunc).
  fc.c.env[bname] = declared
}

// A `defer <call>`: the call's arguments are evaluated now (lowered at the defer
// site), but the call itself is emitted at every function exit, in reverse
// (LIFO) order. Only print/direct-function-call deferrals for now.
function lowerDefer(fc: FnCtx, node: int) {
  let call = kidsOf(fc.c.tree, node)[0]
  if (getNode(fc.c.tree, call).tag != Tag.Call) {
    fc.failed = true
    return
  }
  let cn = getNode(fc.c.tree, kidsOf(fc.c.tree, call)[0])
  if (cn.tag != Tag.Ident) {
    fc.failed = true
    return
  }
  let name = fc.c.source[cn.span.start:cn.span.end]
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  if (name == "print") {
    ins.name = "print"
    ins.args = lowerArgs(fc, call, []int(0))
  } else {
    let decl = funcDeclLookup(fc.c, name)
    if (decl == 0) {
      fc.failed = true
      return
    }
    ins = mkInstr(Op.Call, funcResultLookup(fc.c, name))
    ins.name = name
    ins.args = lowerArgs(fc, call, lowerParamTypes(fc.c, decl))
  }
  if (fc.failed) {
    return
  }
  fc.defers = append(fc.defers, ins)
}

// Emits the pending deferred calls in reverse (LIFO) order at a function exit.
function runDefers(fc: FnCtx) {
  let i = len(fc.defers) - 1
  while (i >= 0) {
    builderEmit(fc.b, fc.defers[i])
    i = i - 1
  }
}

// ---- fallible-result error channel (SPEC §18) -----------------------------

// `err_set(e)` — publish the pending error for the caller's `?`/`catch`.
function setErr(fc: FnCtx, val: int) {
  let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
  ins.name = "err_set"
  ins.args = [val]
  builderEmit(fc.b, ins)
}

// `err_set(nil)` — an ok return / handled `catch` clears the slot.
function clearErr(fc: FnCtx) {
  let nl = mkInstr(Op.ConstNil, fc.c.ctx.errorId)
  setErr(fc, builderEmit(fc.b, nl))
}

// `err_get()` — read the pending error right after a fallible call.
function getErr(fc: FnCtx, errTy: int): int {
  let ins = mkInstr(Op.RtCall, errTy)
  ins.name = "err_get"
  return builderEmit(fc.b, ins)
}

// `err != nil` — the test that decides the `?`/`catch` error path.
function neNil(fc: FnCtx, errv: int, errTy: int): int {
  let nl = mkInstr(Op.ConstNil, errTy)
  let ne = mkInstr(Op.ICmpNe, primType(fc.c.ctx, 10))
  ne.lhs = errv
  ne.rhs = builderEmit(fc.b, nl)
  return builderEmit(fc.b, ne)
}

// Return from a fallible function on the err path: a zero ok value, or nothing
// when the ok type is void (`()!`).
function emitFallibleZeroRet(fc: FnCtx) {
  if (fc.fallibleOk == fc.c.ctx.voidId) {
    builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
    fc.terminated = true
    return
  }
  let zv = zeroValue(fc, fc.fallibleOk)
  let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
  r.args = [zv]
  builderEmit(fc.b, r)
  fc.terminated = true
}

// `fail e` (§18.3): evaluate the error, run defers, publish it, return zero ok.
function lowerFail(fc: FnCtx, node: int) {
  let errv = lowerExprH(fc, kidsOf(fc.c.tree, node)[0], fc.fallibleErr)
  if (fc.failed) {
    return
  }
  runDefers(fc)
  setErr(fc, errv)
  emitFallibleZeroRet(fc)
}

// `expr?` (§18.3): lower the fallible call (its ok value lands normally), then
// branch on the error slot — on error propagate (defers, restore the error,
// return zero ok); on ok the value is the call's ok result.
function lowerTryExpr(fc: FnCtx, node: int): int {
  let operand = kidsOf(fc.c.tree, node)[0]
  let errTy = fc.c.ctx.types[checkExprType(fc.c, operand)].errTy
  let okv = lowerExpr(fc, operand)
  if (fc.failed) {
    return 0
  }
  let errv = getErr(fc, errTy)
  let isErr = neNil(fc, errv, errTy)
  let prop = builderNewBlock(fc.b)
  let cont = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = prop
  br.thenArgs = []int(0)
  br.ival2 = cont
  br.elseArgs = []int(0)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, prop)
  fc.terminated = false
  runDefers(fc)
  setErr(fc, errv)
  emitFallibleZeroRet(fc)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, cont)
  fc.terminated = false
  // `cont` has a single predecessor (dominated by the branch), so the ok value
  // flows in directly — no block param.
  return okv
}

// The block-param args for a catch/match-expr join edge: the live locals, plus
// the merged value unless the ok type is void. Copies `locals` (append can grow
// its input in place, and a caller reuses the snapshot for `restoreValues`).
function catchEdgeArgs(fc: FnCtx, locals: []int, val: int, isVoid: bool): []int {
  let out = []int(0)
  let i = 0
  while (i < len(locals)) {
    out = append(out, locals[i])
    i = i + 1
  }
  if (!isVoid) {
    out = append(out, val)
  }
  return out
}

// `expr catch d` / `expr catch e { … }` (§18.3): merge the ok value and the
// handled value at a join. A void ok type carries no value (the catch is a
// statement); the ok value stands in as the placeholder.
function lowerCatch(fc: FnCtx, node: int, bind: bool): int {
  let k = kidsOf(fc.c.tree, node)
  let fty = checkExprType(fc.c, k[0])
  let okTy = fc.c.ctx.types[fty].result
  let errTy = fc.c.ctx.types[fty].errTy
  let isVoid = okTy == fc.c.ctx.voidId
  let okv = coerceToIface(fc, lowerExpr(fc, k[0]), fty, okTy)
  if (fc.failed) {
    return 0
  }
  let errv = getErr(fc, errTy)
  let isErr = neNil(fc, errv, errTy)
  let preLen = len(fc.env)
  let orig = snapshotValues(fc, preLen)
  let errBlk = builderNewBlock(fc.b)
  let join = builderNewBlock(fc.b)
  let br = mkInstr(Op.Br, fc.c.ctx.voidId)
  br.lhs = isErr
  br.ival = errBlk
  br.thenArgs = []int(0)
  br.ival2 = join
  br.elseArgs = catchEdgeArgs(fc, orig, okv, isVoid)
  builderEmit(fc.b, br)
  builderEndBlock(fc.b)
  builderBeginBlock(fc.b, errBlk)
  fc.terminated = false
  clearErr(fc)
  let handled = 0
  if (bind) {
    let mark = len(fc.env)
    let en = getNode(fc.c.tree, k[1])
    declareLocal(fc, fc.c.source[en.span.start:en.span.end], errv, errTy)
    fc.c.env[fc.c.source[en.span.start:en.span.end]] = errTy
    handled = lowerCatchBlock(fc, k[2], okTy)
    truncateEnv(fc, mark)
  } else {
    handled = lowerExprH(fc, k[1], okTy)
  }
  if (fc.failed) {
    return 0
  }
  if (!fc.terminated) {
    let merged = coerceToIface(fc, handled, okTy, okTy)
    emitJump(fc, join, catchEdgeArgs(fc, snapshotValues(fc, preLen), merged, isVoid))
  }
  builderEndBlock(fc.b)
  restoreValues(fc, orig)
  builderBeginBlock(fc.b, join)
  addJoinParams(fc, preLen)
  fc.terminated = false
  if (isVoid) {
    return okv
  }
  return builderAddParam(fc.b, okTy)
}

// The body of a `catch e { … }`: a block of statements whose final expression (if
// the ok type is non-void) is the handled value. ponytail: a bind-catch body that
// yields a value uses its trailing expression statement.
function lowerCatchBlock(fc: FnCtx, block: int, okTy: int): int {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) - 1 && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
  if (fc.failed || len(stmts) == 0) {
    return 0
  }
  // The last statement yields the value for a non-void catch; a void catch runs
  // it as a statement.
  let last = stmts[len(stmts) - 1]
  if (okTy == fc.c.ctx.voidId || fc.terminated) {
    lowerStmt(fc, last)
    return 0
  }
  if (getNode(fc.c.tree, last).tag == Tag.ExprStmt) {
    return lowerExprH(fc, kidsOf(fc.c.tree, last)[0], okTy)
  }
  lowerStmt(fc, last)
  return 0
}

function lowerStmt(fc: FnCtx, node: int) {
  let n = getNode(fc.c.tree, node)
  if (n.tag == Tag.ExprStmt) {
    // A bare expression statement (e.g. `print(x)`); its value is discarded.
    lowerExpr(fc, kidsOf(fc.c.tree, node)[0])
    return
  }
  if (n.tag == Tag.DeferStmt) {
    lowerDefer(fc, node)
    return
  }
  // A nested block `{ … }` as a statement: its own local scope.
  if (n.tag == Tag.Block) {
    let mark = len(fc.env)
    lowerStmtList(fc, node)
    truncateEnv(fc, mark)
    return
  }
  if (n.tag == Tag.SendStmt) {
    // `ch <- v`: send one word; the value lowers at the channel's element type.
    let sk = kidsOf(fc.c.tree, node)
    let chanTy = defaultType(fc.c, checkExprType(fc.c, sk[0]))
    let ch = lowerExpr(fc, sk[0])
    let v = lowerExprH(fc, sk[1], fc.c.ctx.types[chanTy].elem)
    if (fc.failed) {
      return
    }
    let ins = mkInstr(Op.RtCall, fc.c.ctx.voidId)
    ins.name = "chan_send"
    ins.args = [ch, v]
    builderEmit(fc.b, ins)
    return
  }
  if (n.tag == Tag.LetDecl || n.tag == Tag.ConstDecl) {
    let binds = kidsOf(fc.c.tree, node)
    let i = 0
    while (i < len(binds) && !fc.failed) {
      lowerBinding(fc, binds[i])
      i = i + 1
    }
    return
  }
  if (n.tag == Tag.ReturnStmt) {
    let vals = kidsOf(fc.c.tree, node)
    if (len(vals) == 0) {
      runDefers(fc)
      // A fallible function's ok return must leave the error slot null (§18.5).
      if (fc.fallibleErr != 0) {
        clearErr(fc)
      }
      builderEmit(fc.b, mkInstr(Op.Ret, fc.c.ctx.voidId))
      fc.terminated = true
      return
    }
    if (len(vals) != 1) {
      fc.failed = true
      return
    }
    // The seed materializes a returned literal at its default type (not the
    // result type), so no context hint here. Defers run after the return value
    // is evaluated, before the ret.
    let v = lowerExpr(fc, vals[0])
    if (fc.failed) {
      return
    }
    runDefers(fc)
    if (fc.fallibleErr != 0) {
      clearErr(fc)
    }
    let r = mkInstr(Op.Ret, fc.c.ctx.voidId)
    r.args = [v]
    builderEmit(fc.b, r)
    fc.terminated = true
    return
  }
  if (n.tag == Tag.FailStmt) {
    lowerFail(fc, node)
    return
  }
  if (n.tag == Tag.IfStmt) {
    lowerIf(fc, node)
    return
  }
  if (n.tag == Tag.WhileStmt) {
    lowerWhile(fc, node)
    return
  }
  if (n.tag == Tag.ForOf) {
    lowerForOf(fc, node)
    return
  }
  if (n.tag == Tag.ForC) {
    lowerForC(fc, node)
    return
  }
  if (n.tag == Tag.MatchStmt) {
    lowerMatch(fc, node)
    return
  }
  if (n.tag == Tag.SwitchStmt) {
    lowerSwitch(fc, node)
    return
  }
  if (n.tag == Tag.Assign) {
    lowerAssign(fc, node)
    return
  }
  if (n.tag == Tag.IncStmt) {
    lowerIncDec(fc, node, int(Kind.Plus))
    return
  }
  if (n.tag == Tag.DecStmt) {
    lowerIncDec(fc, node, int(Kind.Minus))
    return
  }
  if (n.tag == Tag.BreakStmt || n.tag == Tag.ContinueStmt) {
    if (len(fc.loops) == 0) {
      fc.failed = true
      return
    }
    // `break` targets the innermost frame (loop or switch); `continue` targets
    // the innermost real loop, skipping switch frames.
    let fi = len(fc.loops) - 1
    if (n.tag == Tag.ContinueStmt) {
      while (fi >= 0 && fc.loops[fi].isSwitch) {
        fi = fi - 1
      }
      if (fi < 0) {
        fc.failed = true
        return
      }
    }
    let frame = fc.loops[fi]
    let target = frame.exit
    if (n.tag == Tag.ContinueStmt) {
      target = frame.cont
    }
    emitJump(fc, target, snapshotValues(fc, frame.preLen))
    fc.terminated = true
    return
  }
  fc.failed = true
}

// Lowers a body block's statements in order, stopping at the first unlowerable
// one (`failed`) or once the block has terminated (dead code after it).
function lowerStmtList(fc: FnCtx, block: int) {
  let stmts = kidsOf(fc.c.tree, block)
  let i = 0
  while (i < len(stmts) && !fc.failed && !fc.terminated) {
    lowerStmt(fc, stmts[i])
    i = i + 1
  }
}

// A signature-only stub: params + the fall-off `ret`, for functions whose body
// is not yet fully lowerable.
function signatureOnlyFunc(c: Checker, name: string, paramTypes: []int, result: int): IrFunc {
  let b = newBuilder()
  builderBeginBlock(b, builderNewBlock(b))
  let i = 0
  while (i < len(paramTypes)) {
    builderAddParam(b, paramTypes[i])
    i = i + 1
  }
  builderEmit(b, mkInstr(Op.Ret, c.ctx.voidId))
  builderEndBlock(b)
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: b.blocks, instrs: b.instrs }
}

// Lowers one function declaration to an `IrFunc`: the full signature plus the
// body if every statement lowers, else a signature-only stub.
// Maps every top-level (and, harmlessly, nested — locals shadow via env) const
// binding name to its initializer node, so a reference inlines the value.
function collectModuleConsts(c: Checker): map<string, int> {
  let m = map<string, int>{}
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0) {
          m[c.source[pat.span.start:pat.span.end]] = bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return m
}

function lowerFunc(c: Checker, decl: int, moduleConsts: map<string, int>, lowerer: Lowerer): IrFunc {
  let kids = kidsOf(c.tree, decl)
  let nm = getNode(c.tree, kids[1])
  let name = c.source[nm.span.start:nm.span.end]
  // A method's IR name is mangled by its receiver type's id (`get$t21`), so two
  // types can share a method name (the seed's method FuncId scheme).
  if (kids[0] != 0) {
    let recvId = userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))
    name = name + "\$t${recvId}"
  }
  let paramTypes = lowerParamTypes(c, decl)
  // An omitted result is void; a fallible result `T!E` shows its ok type in the
  // header, and its ok/err feed the error channel (`fail`/`?`/ok-return).
  let result = c.ctx.voidId
  let fallibleOk = 0
  let fallibleErr = 0
  if (kids[4] != 0) {
    let rawResult = typeFromNode(c, kids[4])
    if (rawResult != 0 && c.ctx.types[rawResult].kind == TypeKind.Fallible) {
      fallibleOk = c.ctx.types[rawResult].result
      fallibleErr = c.ctx.types[rawResult].errTy
    }
    result = unwrapFallible(c, rawResult)
  }
  let b = newBuilder()
  let entry = builderNewBlock(b)
  builderBeginBlock(b, entry)
  let fc = FnCtx{ c: c, b: b, env: []LocalBind(0), failed: false, terminated: false,
    loops: []LoopFrame(0), moduleConsts: moduleConsts, lowerer: lowerer, defers: []IrInstr(0),
    fallibleOk: fallibleOk, fallibleErr: fallibleErr }
  // Bind params (receiver first, if any) to their block-param value ids. The
  // checker's env is flat across the whole module, so a later function's
  // same-named param can have overwritten this one's type; rebind ours here so
  // `checkExprType` resolves this body's identifiers to the correct types during
  // lowering (`x: f64` here vs `x: int` in a sibling).
  let names = paramNames(c, decl)
  let i = 0
  while (i < len(paramTypes)) {
    let id = builderAddParam(b, paramTypes[i])
    declareLocal(fc, names[i], id, paramTypes[i])
    c.env[names[i]] = paramTypes[i]
    i = i + 1
  }
  lowerStmtList(fc, kids[5])
  if (fc.failed) {
    return signatureOnlyFunc(c, name, paramTypes, result)
  }
  if (!fc.terminated) {
    runDefers(fc)
    // A void fallible function `()!` that falls off the end still clears the
    // error slot on its ok path (§18.5).
    if (fc.fallibleErr != 0) {
      clearErr(fc)
    }
    builderEmit(fc.b, mkInstr(Op.Ret, c.ctx.voidId))
  }
  builderEndBlock(fc.b)
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: fc.b.blocks, instrs: fc.b.instrs }
}

// The parameter names of a function declaration, in the same order as
// lowerParamTypes (method receiver first).
function paramNames(c: Checker, decl: int): []string {
  let kids = kidsOf(c.tree, decl)
  let names = []string(0)
  if (kids[0] != 0) {
    let rn = getNode(c.tree, kidsOf(c.tree, kids[0])[0])
    names = append(names, c.source[rn.span.start:rn.span.end])
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    let pn = getNode(c.tree, kidsOf(c.tree, params[i])[0])
    names = append(names, c.source[pn.span.start:pn.span.end])
    i = i + 1
  }
  return names
}

// Lowers every top-level function into an `IrModule`. FuncId order matches the
// seed's passes: free functions first (Pass A), then struct methods (Pass A3),
// each in declaration order — so the dump's `func` blocks line up.
function lowerModuleIr(c: Checker): IrModule {
  let moduleConsts = collectModuleConsts(c)
  let lowerer = Lowerer{ methodIds: map<string, int>{} }
  let funcs = []IrFunc(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    let n = getNode(c.tree, i)
    if (n.tag == Tag.FuncDecl && kidsOf(c.tree, i)[0] == 0) {
      funcs = append(funcs, lowerFunc(c, i, moduleConsts, lowerer))
    }
    i = i + 1
  }
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl && kidsOf(c.tree, m)[0] != 0) {
      funcs = append(funcs, lowerFunc(c, m, moduleConsts, lowerer))
    }
    m = m + 1
  }
  return IrModule{ funcs: funcs, ctx: c.ctx }
}

// Parse -> check -> lower -> render IR text, the `bitc2 --dump-ir` pipeline.
function lowerSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpIr(lowerModuleIr(c))
}
