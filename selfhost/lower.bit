// Self-host Stage 2 (#1337): AST -> SSA IR lowering, ported from
// compiler/lower.zig. Builds an `IrModule` (selfhost/ir.bit) whose `dumpIr`
// byte-matches the seed's `bitc --dump-ir` over the corpus. Grows
// statement/expression by statement/expression; this first slice lowers each
// function's *signature* and an empty body (`func f(…) R { bb0(…): ret }`),
// the shape every function ends with when it falls off the end.
//
// Reuses the checker (selfhost/check.bit) for types: a function's parameter and
// result types come from the same `typeFromNode`/`funcResults` the type dump
// uses, so IR types and inferred types stay consistent by construction.

// The incremental IR builder: a flat instr array (index == value id) plus the
// blocks that slice it, and the block currently being appended to.
struct IrBuilder {
  instrs: []IrInstr,
  blocks: []IrBlock,
  cur: int,
}

function newBuilder(): IrBuilder {
  return IrBuilder{ instrs: []IrInstr(0), blocks: []IrBlock(0), cur: -1 }
}

// Starts a fresh block, returns its id, and makes it current. Its instr range
// begins at the current end of the flat array.
function builderNewBlock(b: IrBuilder): int {
  b.blocks = append(b.blocks, IrBlock{ instsStart: len(b.instrs), paramCount: 0, instsLen: 0 })
  b.cur = len(b.blocks) - 1
  return b.cur
}

// Appends one instruction to the current block, returning its SSA value id.
function builderEmit(b: IrBuilder, ins: IrInstr): int {
  b.instrs = append(b.instrs, ins)
  b.blocks[b.cur].instsLen = b.blocks[b.cur].instsLen + 1
  return len(b.instrs) - 1
}

// Adds a block parameter (phi result) to the current block. Params must precede
// the block's body instructions, so this is called right after the block opens.
function builderAddParam(b: IrBuilder, ty: int): int {
  let id = builderEmit(b, mkInstr(Op.BlockParam, ty))
  b.blocks[b.cur].paramCount = b.blocks[b.cur].paramCount + 1
  return id
}

// The parameter type list of a function declaration, in order, with a method
// receiver (if any) as the leading parameter — mirroring lowerFunctionDecl.
function lowerParamTypes(c: Checker, decl: int): []int {
  let kids = kidsOf(c.tree, decl)
  let types = []int(0)
  if (kids[0] != 0) {
    types = append(types, typeFromNode(c, kidsOf(c.tree, kids[0])[1]))
  }
  let params = kidsOf(c.tree, kids[3])
  let i = 0
  while (i < len(params)) {
    types = append(types, typeFromNode(c, kidsOf(c.tree, params[i])[1]))
    i = i + 1
  }
  return types
}

// Lowers one function declaration to an `IrFunc`. The signature is complete; the
// body is not yet lowered, so the block ends in the fall-off `ret` (correct for
// an empty void body). ponytail: body lowering lands construct-by-construct next.
function lowerFunc(c: Checker, decl: int): IrFunc {
  let kids = kidsOf(c.tree, decl)
  let nm = getNode(c.tree, kids[1])
  let name = c.source[nm.span.start:nm.span.end]
  let paramTypes = lowerParamTypes(c, decl)
  // An omitted result is void; a fallible result shows its ok type in the header.
  let result = c.ctx.voidId
  if (kids[4] != 0) {
    result = unwrapFallible(c, typeFromNode(c, kids[4]))
  }
  let b = newBuilder()
  builderNewBlock(b)
  let i = 0
  while (i < len(paramTypes)) {
    builderAddParam(b, paramTypes[i])
    i = i + 1
  }
  // ponytail: body not yet lowered — emit the fall-off void return.
  builderEmit(b, mkInstr(Op.Ret, c.ctx.voidId))
  return IrFunc{ name: name, paramTypes: paramTypes, result: result,
    blocks: b.blocks, instrs: b.instrs }
}

// Lowers every top-level function in declaration (arena) order into an
// `IrModule`, matching the seed's FuncId ordering for the dump.
function lowerModuleIr(c: Checker): IrModule {
  let funcs = []IrFunc(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.FuncDecl) {
      funcs = append(funcs, lowerFunc(c, i))
    }
    i = i + 1
  }
  return IrModule{ funcs: funcs, ctx: c.ctx }
}

// Parse -> check -> lower -> render IR text, the `bitc2 --dump-ir` pipeline.
function lowerSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpIr(lowerModuleIr(c))
}
