// Self-host Stage 2 (#1339): the size-budgeted inlining pass. Split out of
// opt.bit (#1503).

// ponytail: size-budget heuristic — small leaf helpers only; retune once a real
// corpus shows the right number.
function maxInlineInsts(): int {
  return 8
}

// The index of the function named `name`, or -1. The seed keys calls by FuncId;
// selfhost resolves the callee name into `IrInstr.name`, so the lookup is here.
function funcIndexByName(m: IrModule, name: string): int {
  let i = 0
  while (i < len(m.funcs)) {
    if (m.funcs[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// A callee is inlinable when it is straight-line code under budget: exactly one
// block (no branches to re-target, so splicing needs no CFG surgery), terminated
// by a plain `ret` (not `unreachable`, so there is always a value to substitute),
// not fallible (keeps error propagation out of this pass), and not the caller
// itself (never inline a self-call). It must also not carry another module's
// MODULE STATE into this one — see importsForeignState (#1630).
function inlineEligible(m: IrModule, callerIdx: int, calleeIdx: int): bool {
  if (calleeIdx < 0 || calleeIdx == callerIdx) {
    return false
  }
  let g = m.funcs[calleeIdx]
  if (len(g.blocks) != 1 || g.isFallible) {
    return false
  }
  if (importsForeignState(m, m.funcs[callerIdx], g)) {
    return false
  }
  let b = g.blocks[0]
  if (g.instrs[b.instsStart + b.instsLen - 1].op != Op.Ret) {
    return false
  }
  return b.instsLen - b.paramCount - 1 <= maxInlineInsts()
}

// True if splicing `callee` into `caller` would move a reference to a module
// cell across a module boundary (#1630). Mirrors the seed's importsForeignState.
//
// §11.11 state is a per-module cell, and §17.6 gives each module its OWN object:
// the cell is defined by that object and by no other. Inlining is the one thing
// that can put a GlobalAddr naming module M's cell inside code emitted as module
// N's — and then N's object either re-defines M's cell (two cells, one logical
// global, each module updating its own — silent, unbounded wrongness with no
// diagnostic at any stage) or leaves a dangling reference under a name M's own
// object does not use. That was live: the inliner spliced runtime/root's pinned
// rootBindMemory into runtime/root/darwin's boot, so the two objects held
// separate gcAddr and gcState cells and the collector booted against the wrong
// one.
//
// Refused unconditionally rather than only under --freestanding, so the managed
// and freestanding lowerings of one program cannot disagree about which cell a
// function touches. The cost is one un-inlined call in a cross-module helper
// that reads module state.
//
// The comparison is over inRootModule because that is the module identity the IR
// carries. It is coarse — two distinct imported modules both read as "not root"
// — but it composes: a splice into a non-root caller leaves a non-root global
// reference behind, which this then refuses to carry into any root caller.
function importsForeignState(m: IrModule, caller: IrFunc, callee: IrFunc): bool {
  let i = 0
  while (i < len(callee.instrs)) {
    let ins = callee.instrs[i]
    if (ins.op == Op.GlobalAddr) {
      let gi = 0
      while (gi < len(m.globals)) {
        if (m.globals[gi].name == ins.name &&
            m.globals[gi].inRootModule != caller.inRootModule) {
          return true
        }
        gi = gi + 1
      }
    }
    i = i + 1
  }
  return false
}

// Splices `g`'s single block into `b`'s currently open block: `g`'s params bind
// directly to the already-translated call `args`, its body is emitted in place
// (no folding, no block retargeting — `g` has exactly one block and its only
// terminator is the `ret`, which is read separately rather than spliced).
// Returns the value the call site now yields.
function spliceCallee(b: IrBuilder, g: IrFunc, args: []int): int {
  let blk = g.blocks[0]
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(g.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  // Never indexed: inlineEligible guarantees the only terminator is the `ret`
  // excluded below, so no jump/br inside the spliced range reads this.
  let dummyBlockMap = [0]
  let idx = blk.instsStart
  let paramsEnd = blk.instsStart + blk.paramCount
  let p = 0
  while (idx < paramsEnd) {
    remap[idx] = args[p]
    p = p + 1
    idx = idx + 1
  }
  let last = blk.instsStart + blk.instsLen - 1
  while (idx < last) {
    emitTranslated(b, g, noFold, remap, dummyBlockMap, idx)
    idx = idx + 1
  }
  let ret = g.instrs[last]
  if (len(ret.args) == 0) {
    return 0 // void callee: the result is never a usable value, never read
  }
  return remap[ret.args[0]]
}

// Pass 3: simple size-budgeted inlining. Blocks are walked in id order, which is
// emission order here — every preceding pass rebuilds with ids assigned in
// ascending instsStart.
function inlineCalls(m: IrModule, fidx: int): IrFunc {
  let f = m.funcs[fidx]
  let n = len(f.blocks)
  let blockMap = []int(0)
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  let b = newBuilder()
  i = 0
  while (i < n) {
    blockMap = append(blockMap, builderNewBlock(b))
    i = i + 1
  }
  let bi = 0
  while (bi < n) {
    let blk = f.blocks[bi]
    builderBeginBlock(b, blockMap[bi])
    let idx = blk.instsStart
    let paramsEnd = blk.instsStart + blk.paramCount
    while (idx < paramsEnd) {
      remap[idx] = builderAddParam(b, f.instrs[idx].ty)
      idx = idx + 1
    }
    let end = blk.instsStart + blk.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      let handled = false
      if (ins.op == Op.Call) {
        let calleeIdx = funcIndexByName(m, ins.name)
        if (inlineEligible(m, fidx, calleeIdx)) {
          remap[idx] = spliceCallee(b, m.funcs[calleeIdx], trList(remap, ins.args))
          handled = true
        }
      }
      if (!handled) {
        emitTranslated(b, f, noFold, remap, blockMap, idx)
      }
      idx = idx + 1
    }
    builderEndBlock(b)
    bi = bi + 1
  }
  return IrFunc{ name: f.name, paramTypes: f.paramTypes, result: f.result,
    blocks: b.blocks, instrs: b.instrs, isFallible: f.isFallible,
    isNaked: f.isNaked, isNosplit: f.isNosplit,
    // §17.6: carry the module tag across the rebuild. Every pass here builds a
    // fresh IrFunc, and a field left off a literal zero-fills — so omitting
    // this would silently mark the function "not mine" and drop it from a
    // freestanding object. The seed gates the same invariant with a unit test.
    // §11.9: the pin flag rides the same rebuild and has the same failure mode —
    // losing it makes a runtime entry point LOCAL and fails the link loudly.
    inRootModule: f.inRootModule, isPinned: f.isPinned }
}
