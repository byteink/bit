// In-Bit self-checks for the Mach-O executable writer and linker. Split out of
// selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

// Stage 3 (#1344 part 5a) the Mach-O executable writer's constants, dyld opcode
// encoders, and layout helpers. Expected bytes were computed independently in
// Python; uleb(624485) == e5 8e 26 is the canonical LEB128 example from the
// DWARF spec, so the encoder is anchored to a published vector, not just to
// itself.

function meBytesAre(b: ByteBuf, want: []u8): bool {
  if (len(b.bytes) != len(want)) {
    return false
  }
  let i = 0
  while (i < len(want)) {
    if (b.bytes[i] != want[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

function meUlebOf(v: int): ByteBuf {
  let b = newByteBuf()
  meUleb(b, v)
  return b
}

function checkMachoExecUleb() {
  assert(meBytesAre(meUlebOf(0), [u8(0x00)]))
  assert(meBytesAre(meUlebOf(1), [u8(0x01)]))
  // 127 is the largest single-byte value; 128 is the first that continues.
  assert(meBytesAre(meUlebOf(127), [u8(0x7f)]))
  assert(meBytesAre(meUlebOf(128), [u8(0x80), u8(0x01)]))
  assert(meBytesAre(meUlebOf(255), [u8(0xff), u8(0x01)]))
  assert(meBytesAre(meUlebOf(300), [u8(0xac), u8(0x02)]))
  // The DWARF spec's worked example.
  assert(meBytesAre(meUlebOf(624485), [u8(0xe5), u8(0x8e), u8(0x26)]))
  // A value whose low 7 bits are zero must still emit a continued byte, not
  // stop early.
  assert(meBytesAre(meUlebOf(0x4000), [u8(0x80), u8(0x80), u8(0x01)]))
  assert(meBytesAre(meUlebOf(0x2000), [u8(0x80), u8(0x40)]))
}

function checkMachoExecOpcodes() {
  // dyld replays this stream at load to fill an imported GOT slot: name the
  // symbol, declare it a pointer, point at segment+offset, bind.
  let b = newByteBuf()
  meEmitBind(b, "_malloc", 2, 0x10)
  assert(meBytesAre(b, [u8(0x40),
    u8(0x5f), u8(0x6d), u8(0x61), u8(0x6c), u8(0x6c), u8(0x6f), u8(0x63), u8(0x00),
    u8(0x51), u8(0x72), u8(0x10), u8(0x90)]))

  // One rebase: dyld adds the image slide to the word at segment+offset.
  let r = newByteBuf()
  meEmitRebase(r, 2, 0x2000)
  assert(meBytesAre(r, [u8(0x11), u8(0x22), u8(0x80), u8(0x40), u8(0x51)]))

  // The opcode nibbles must not collide: each is an opcode ORed with an
  // immediate, so a wrong constant silently changes the instruction.
  assert(bindOpcodeSetTypeImm() | bindTypePointer() == 0x51)
  assert(bindOpcodeSetSegmentAndOffsetUleb() | 2 == 0x72)
  assert(rebaseOpcodeSetTypeImm() | rebaseTypePointer() == 0x11)
  assert(rebaseOpcodeDoRebaseImmTimes() | 1 == 0x51)
}

function checkMachoExecLayout() {
  assert(meAlignUp(0, 0x4000) == 0)
  assert(meAlignUp(1, 0x4000) == 0x4000)
  assert(meAlignUp(0x4000, 0x4000) == 0x4000)
  assert(meAlignUp(0x4001, 0x4000) == 0x8000)

  // A branch to an import needs a stub; a page/GOT reference does not.
  assert(meIsBranch(LoRelocKind.Aarch64Call26))
  assert(meIsBranch(LoRelocKind.Aarch64Jump26))
  assert(!meIsBranch(LoRelocKind.Aarch64AdrPrelPgHi21))
  assert(!meIsBranch(LoRelocKind.Abs64))

  // Only writable, file-backed __DATA kinds can hold a rebasable pointer. bss
  // has no file bytes to rebase; rodata is not writable.
  assert(meIsDataSeg(LoSectionKind.Data))
  assert(meIsDataSeg(LoSectionKind.TlsVars))
  assert(meIsDataSeg(LoSectionKind.TlsData))
  assert(!meIsDataSeg(LoSectionKind.Bss))
  assert(!meIsDataSeg(LoSectionKind.TlsBss))
  assert(!meIsDataSeg(LoSectionKind.Rodata))
  assert(!meIsDataSeg(LoSectionKind.Text))

  // The __DATA segment's load command only exists if something lives in it.
  assert(meNcmds(true) == 12 && meNcmds(false) == 11)

  // Atom placement honours each atom's alignment, and a placed group's size
  // spans the padding between atoms — not the sum of their sizes.
  let mod = LoModule{ name: "m", atoms: [
    LoAtom{ name: "a", kind: LoSectionKind.Text, binding: LoBinding.Global,
      data: []u8(0), size: 5, alignment: 4, weak: false, relocs: []LoReloc(0) },
    LoAtom{ name: "b", kind: LoSectionKind.Text, binding: LoBinding.Global,
      data: []u8(0), size: 8, alignment: 16, weak: false, relocs: []LoReloc(0) }]}
  let items = [MePlaced{ module: 0, atom: 0, vaddr: 0, fileOff: 0 },
    MePlaced{ module: 0, atom: 1, vaddr: 0, fileOff: 0 }]
  let res = mePlaceAtoms([mod], items, meBaseVaddr())
  assert(res.items[0].vaddr == meBaseVaddr())      // already 4-aligned
  assert(res.items[0].fileOff == 0)                // __TEXT starts at file offset 0
  assert(res.items[1].vaddr == meBaseVaddr() + 16) // 5 bytes in, rounded up to 16
  assert(res.items[1].fileOff == 16)
  assert(res.cursor == meBaseVaddr() + 24)
  // 16 (padding included) + 8, not 5 + 8.
  assert(mePlacedSize([mod], res.items) == 24)
  assert(mePlacedSize([mod], []MePlaced(0)) == 0)
}

// Stage 3 (#1344 part 5b) the executable writer's analysis pass: dead-strip with
// libSystem imports as leaves, output partitioning, and GOT/stub synthesis.

function meAtom(name: string, kind: LoSectionKind, b: LoBinding, size: int, relocs: []LoReloc): LoAtom {
  return LoAtom{ name: name, kind: kind, binding: b, data: []u8(size), size: size,
    alignment: 1, weak: false, relocs: relocs }
}

// A text atom whose first word is a real instruction. Relocation only patches an
// instruction's immediate field and preserves its opcode bits, so an all-zero
// fixture would assert against a relocated NOP rather than a relocated branch.
function meCodeAtom(name: string, b: LoBinding, insn: int, relocs: []LoReloc): LoAtom {
  let a = meAtom(name, LoSectionKind.Text, b, 8, relocs)
  loWrU32(a.data, 0, insn)
  return a
}

function meRel(off: int, kind: LoRelocKind, target: LoSymbolRef): LoReloc {
  return LoReloc{ offset: off, kind: kind, target: target, addend: 0 }
}

// An empty state — the value a failing catch must produce, since `panic` is
// typed void rather than bottom and so cannot BE the value of a catch block that
// must yield a MeLinkState. The assert(false) beside it is what actually fails.
function meEmptyState(): MeLinkState {
  return MeLinkState{ kept: map<int, bool>{}, importOrder: []string(0),
    branchImports: map<string, bool>{}, text: []MePlaced(0), rodata: []MePlaced(0),
    data: []MePlaced(0), bss: []MePlaced(0), tlsVars: []MePlaced(0),
    tlsData: []MePlaced(0), tlsBss: []MePlaced(0), gotList: []MeGotSlot(0),
    gotOfInternal: map<int, int>{}, gotOfImport: map<string, int>{},
    stubList: []string(0), stubOfImport: map<string, int>{} }
}

// The analysis pass, run end to end the way linkExecutable will.
function meAnalyze(modules: []LoModule): MeLinkState {
  let g = resolveGlobals(modules) catch e {
    assert(false)
    map<string, int>{}
  }
  let st = meDeadStripWithImports(modules, g, 0, []string(0)) catch e {
    assert(false)
    meEmptyState()
  }
  let st2 = mePartition(modules, st)
  return meBuildGotAndStubs(modules, g, st2) catch e {
    assert(false)
    meEmptyState()
  }
}

function checkMachoExecDeadStrip() {
  // __start branches to an undefined _malloc (a libSystem import), calls an
  // internal helper, and references a rodata string. `dead` is unreachable.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 16, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_malloc")),
      meRel(4, LoRelocKind.Aarch64Call26, loGlobalRef("helper")),
      meRel(8, LoRelocKind.Aarch64AdrPrelPgHi21, loLocalRef(3))]),  // atom 0
    meAtom("helper", LoSectionKind.Text, LoBinding.Global, 8, []LoReloc(0)), // 1
    meAtom("dead", LoSectionKind.Text, LoBinding.Global, 8, []LoReloc(0)),   // 2
    meAtom("msg", LoSectionKind.Rodata, LoBinding.Local, 4, []LoReloc(0))]}  // 3
  let st = meAnalyze([m])

  // An undefined global is an IMPORT, not an error — that is the whole
  // difference from the ELF path, where it would fail the link.
  assert(len(st.importOrder) == 1 && st.importOrder[0] == "_malloc")
  let (_, isBranchImport) = st.branchImports["_malloc"]
  assert(isBranchImport)

  // Reachable: __start, helper, msg. Not `dead`.
  assert(len(st.kept) == 3)
  let (_, k2) = st.kept[atomKey(0, 2)]
  assert(!k2)

  // Partitioned by class, in module/atom order.
  assert(len(st.text) == 2)
  assert(st.text[0].atom == 0 && st.text[1].atom == 1)
  assert(len(st.rodata) == 1 && st.rodata[0].atom == 3)
  assert(len(st.data) == 0 && len(st.bss) == 0)

  // A branch to an import needs both a stub and the GOT slot the stub loads.
  assert(len(st.stubList) == 1 && st.stubList[0] == "_malloc")
  assert(len(st.gotList) == 1 && st.gotList[0].isImport)
  assert(st.gotList[0].name == "_malloc")
  let (gi, _) = st.gotOfImport["_malloc"]
  assert(gi == 0)
  // A plain internal branch does NOT get a stub — it resolves direct.
  let (_, helperStub) = st.stubOfImport["helper"]
  assert(!helperStub)
  // Nothing here needs a __DATA segment: no got-internal, data, or bss... but the
  // import GOT slot does live in __DATA.
  assert(meHasDataSeg(st))
}

function checkMachoExecGot() {
  // A GOT-page reference to an internal symbol takes an internal slot (rebased);
  // one to an undefined symbol takes an import slot (bound). A TLVP reference
  // reuses the same internal-GOT machinery.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 32, [
      meRel(0, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("gvar")),
      meRel(4, LoRelocKind.Aarch64Ld64GotLo12Nc, loGlobalRef("gvar")),
      meRel(8, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("_environ")),
      meRel(12, LoRelocKind.Aarch64TlvpAdrPage21, loLocalRef(2)),
      meRel(16, LoRelocKind.Aarch64Call26, loGlobalRef("_exit"))]),
    meAtom("gvar", LoSectionKind.Data, LoBinding.Global, 8, []LoReloc(0)),
    meAtom("tlvdesc", LoSectionKind.TlsVars, LoBinding.Local, 24, []LoReloc(0))]}
  let st = meAnalyze([m])

  // Two references to one internal symbol share ONE slot.
  assert(len(st.gotList) == 4)
  assert(!st.gotList[0].isImport && st.gotList[0].atom == 1) // gvar, once
  assert(st.gotList[1].isImport && st.gotList[1].name == "_environ")
  assert(!st.gotList[2].isImport && st.gotList[2].atom == 2) // the tlv_descriptor
  assert(st.gotList[3].isImport && st.gotList[3].name == "_exit")

  // _environ is imported but never branched to, so it needs no stub; _exit is.
  assert(len(st.stubList) == 1 && st.stubList[0] == "_exit")
  let (_, envIsBranch) = st.branchImports["_environ"]
  assert(!envIsBranch)
  // Import order is first-seen: the indirect symbol table indexes into it.
  assert(len(st.importOrder) == 2)
  assert(st.importOrder[0] == "_environ" && st.importOrder[1] == "_exit")

  assert(len(st.data) == 1 && len(st.tlsVars) == 1)
  assert(meHasDataSeg(st))
}

function checkMachoExecNoDataSeg() {
  // A pure-text image with no GOT, data, bss or TLS needs no __DATA segment at
  // all — and one fewer load command.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Aarch64Call26, loLocalRef(1))]),
    meAtom("f", LoSectionKind.Text, LoBinding.Local, 4, []LoReloc(0))]}
  let st = meAnalyze([m])
  assert(!meHasDataSeg(st))
  assert(len(st.gotList) == 0 && len(st.stubList) == 0)
  assert(len(st.importOrder) == 0)
  assert(meNcmds(meHasDataSeg(st)) == 11)

  // A missing entry point is a hard error, not an import: nothing can define
  // __start but the runtime.
  let bad = LoModule{ name: "x", atoms: [
    meAtom("notstart", LoSectionKind.Text, LoBinding.Global, 4, []LoReloc(0))]}
  let g = resolveGlobals([bad]) catch e { map<string, int>{} }
  let msg = ""
  let st2 = meDeadStripWithImports([bad], g, 0, []string(0)) catch e {
    msg = e.message()
    meEmptyState()
  }
  assert(msg == "MissingEntry")
}

// #1445: an undefined symbol the PROGRAM object references is a link error, not
// a dyld import. Mirrors the seed's macho.zig tests so the two linkers accept
// and reject the same programs — the seed is the differential oracle, so a gate
// only one of them enforces is worse than none.
function checkMachoExecUndefinedSymbol() {
  // __start (program module 0) calls _helper, which archive module 1 defines;
  // _helper calls _libsystem_fn, which nothing defines. That is the legitimate
  // arrangement — an archive member reaching libSystem — and must keep linking.
  // __start additionally calls _maybe_bogus, the name under test.
  let prog = LoModule{ name: "bit.o", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_helper")),
      meRel(4, LoRelocKind.Aarch64Call26, loGlobalRef("_maybe_bogus"))])]}
  let arch = LoModule{ name: "libbitrt.a(rt.o)", atoms: [
    meAtom("_helper", LoSectionKind.Text, LoBinding.Global, 4, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_libsystem_fn"))])]}
  let mods = [prog, arch]
  let g = resolveGlobals(mods) catch e { map<string, int>{} }

  // (1) Undeclared: refused, naming the symbol AND the referencing module.
  let msg = ""
  let st = meDeadStripWithImports(mods, g, 1, []string(0)) catch e {
    msg = e.message()
    meEmptyState()
  }
  assert(msg == "undefined symbol '_maybe_bogus', referenced from bit.o")

  // (2) The same name declared `extern function`: a legal dylib import. This
  // also proves _libsystem_fn — undefined, but referenced from the ARCHIVE
  // module — stayed a leaf, since otherwise this would fail too.
  let ok = ""
  let st2 = meDeadStripWithImports(mods, g, 1, ["_maybe_bogus"]) catch e {
    ok = e.message()
    meEmptyState()
  }
  assert(ok == "")
  assert(len(st2.importOrder) == 2)

  // (3) An allowlist naming something else must not rescue it: the check has to
  // compare the symbol's CONTENT, not merely count entries or measure it. The
  // decoy is deliberately the SAME LENGTH as _maybe_bogus and differs by one
  // character — with a shorter decoy a length-only comparison reproduces correct
  // behaviour on both arms and the mutant survives.
  assert(len("_maybe_bogos") == len("_maybe_bogus"))
  let msg3 = ""
  let st3 = meDeadStripWithImports(mods, g, 1, ["_maybe_bogos"]) catch e {
    msg3 = e.message()
    meEmptyState()
  }
  assert(msg3 == "undefined symbol '_maybe_bogus', referenced from bit.o")

  // (4) Provenance is what distinguishes an import: counting BOTH modules as
  // program objects removes the archive's exemption. This is the direction that
  // proves the exemption in (2) does real work rather than the walk simply
  // never reaching module 1.
  let msg4 = ""
  let st4 = meDeadStripWithImports(mods, g, 2, ["_maybe_bogus"]) catch e {
    msg4 = e.message()
    meEmptyState()
  }
  assert(msg4 == "undefined symbol '_libsystem_fn', referenced from libbitrt.a(rt.o)")
}

// The rule above is only live in production if linkMacho actually counts the
// program's modules — and it is linkMacho, not linkExecutable, that the driver
// calls. Testing only the inner walk left programModules free to be wrong (a
// mutation that never incremented it SURVIVED), so this drives a real object,
// written by our own writer and read back by our own reader, through the real
// entry point. Mirrors the seed's "link() counts the program's own modules".
function checkMachoExecLinkCountsProgramModules() {
  // The ARCHIVE is not decoration. programModules counts a PREFIX, so a
  // linkMacho that appended archive members before object modules would still
  // count 1 and still blame module 0 — with an object-only input the reordering
  // is unobservable. With an archive present it flips which symbol is named,
  // which is what makes the order a tested property rather than an assumed one.
  let progCode = [u8(0x00), u8(0x00), u8(0x00), u8(0x94),
                  u8(0x00), u8(0x00), u8(0x00), u8(0x94)] // bl _helper ; bl _bogus
  let obj = writeMacho(MachoTarget.Aarch64, MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: progCode,
      size: len(progCode), alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "__start", hasSection: true,
        section: MachoSectionKind.Text, offset: 0, size: len(progCode),
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_helper", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_bogus", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [
      MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
        symbol: "_helper", kind: MachoRelocKind.Branch },
      MachoRelocation{ section: MachoSectionKind.Text, offset: 4,
        symbol: "_bogus", kind: MachoRelocKind.Branch }]}) catch e {
    panic("writeMacho prog: ${e.message()}")
    []u8(0)
  }

  // The archive member: defines _helper, and reaches libSystem itself.
  let rtCode = [u8(0x00), u8(0x00), u8(0x00), u8(0x94)] // bl _libsystem_fn
  let rtObj = writeMacho(MachoTarget.Aarch64, MachoObject{
    sections: [MachoSection{ kind: MachoSectionKind.Text, data: rtCode,
      size: len(rtCode), alignment: 4 }],
    symbols: [
      MachoSymbol{ name: "_helper", hasSection: true,
        section: MachoSectionKind.Text, offset: 0, size: len(rtCode),
        binding: MachoBinding.Global },
      MachoSymbol{ name: "_libsystem_fn", hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global }],
    relocations: [MachoRelocation{ section: MachoSectionKind.Text, offset: 0,
      symbol: "_libsystem_fn", kind: MachoRelocKind.Branch }]}) catch e {
    panic("writeMacho rt: ${e.message()}")
    []u8(0)
  }
  let lib = writeArchive([ArMember{ name: "rt.o", data: rtObj }], arFormatBsd())

  let inputs = [meObjectInput(obj), meArchiveInput(lib)]

  let msg = ""
  let exe = linkMacho(inputs, "t", []string(0)) catch e {
    msg = e.message()
    []u8(0)
  }
  // Naming _bogus (not _libsystem_fn) is what proves the object module landed
  // in the counted prefix and the archive member did not.
  assert(msg == "undefined symbol '_bogus', referenced from bit.o")

  // The same inputs link once _bogus is a declared `extern function`, so the
  // gate discriminates rather than rejecting the program outright. This also
  // proves _libsystem_fn stayed a leaf.
  let ok = ""
  let exe2 = linkMacho(inputs, "t", ["_bogus"]) catch e {
    ok = e.message()
    []u8(0)
  }
  assert(ok == "")
  assert(len(exe2) > 0)
}

// Stage 3 (#1344 part 5c) address assignment, relocation application, and the
// dyld info streams.

// `panic` is void, not bottom, so a catch that must yield a MePatched needs a
// real value beside the assert that actually fails.
function meEmptyPatched(): MePatched {
  return MePatched{ bytes: map<int, []u8>{}, dataBinds: []MeDataBind(0),
    dataRebases: []int(0) }
}

function meAddrs(stubs: int, got: int, dataSeg: int, tlsBase: int): MeAddrs {
  return MeAddrs{ stubsVaddr: stubs, gotVaddr: got, dataSegVaddr: dataSeg,
    tlsTemplateBase: tlsBase }
}

function checkMachoExecSymtab() {
  // Only imports get symbol-table entries; an internal symbol is resolved
  // statically and nothing looks it up at runtime.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 12, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_exit")),
      meRel(4, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("_environ")),
      meRel(8, LoRelocKind.Aarch64Call26, loLocalRef(1))]),
    meAtom("helper", LoSectionKind.Text, LoBinding.Local, 4, []LoReloc(0))]}
  let st = meAnalyze([m])
  let sym = meBuildSymtab(st)

  // strtab starts with the empty string at index 0, then each import NUL-
  // terminated. "_exit" is seen first.
  assert(sym.strtab.bytes[0] == u8(0))
  assert(string(sym.strtab.bytes[1:6]) == "_exit")
  assert(sym.strtab.bytes[6] == u8(0))
  assert(string(sym.strtab.bytes[7:15]) == "_environ")
  assert(len(sym.strtab.bytes) == 1 + 6 + 9)

  // One 16-byte nlist_64 per import: N_UNDF|N_EXT, NO_SECT, no address.
  assert(len(sym.nlists.bytes) == 2 * 16)
  assert(leAt(sym.nlists.bytes, 0, 4) == 1)  // n_strx -> "_exit"
  assert(int(sym.nlists.bytes[4]) == 0x01)   // N_UNDF | N_EXT
  assert(int(sym.nlists.bytes[5]) == 0)      // NO_SECT
  assert(leAt(sym.nlists.bytes, 8, 8) == 0)  // n_value
  assert(leAt(sym.nlists.bytes, 16, 4) == 7) // n_strx -> "_environ"

  // The indirect table is stubs first, then the GOT — the order the section
  // headers' reserved1 indices assume.
  let ind = meIndirectSymbols(st, sym.symIndex)
  assert(len(ind) == len(st.stubList) + len(st.gotList))
  assert(ind[0] == 0) // the one stub: _exit, symbol 0
  // GOT order is _exit (from the branch) then _environ.
  assert(ind[1] == 0 && ind[2] == 1)
}

function checkMachoExecStreams() {
  // Rebase offsets are emitted in ASCENDING order regardless of discovery order,
  // so the output stays deterministic.
  let ops = meRebaseStream([0x2000, 0x8, 0x100], 2)
  // SET_TYPE_IMM|POINTER, then (SET_SEG_AND_OFF|2, uleb, DO_REBASE|1) x3, DONE.
  assert(ops.bytes[0] == u8(0x11))
  assert(ops.bytes[1] == u8(0x22) && ops.bytes[2] == u8(0x08)) // 0x8 first
  assert(ops.bytes[3] == u8(0x51))
  assert(ops.bytes[4] == u8(0x22) && ops.bytes[5] == u8(0x80) && ops.bytes[6] == u8(0x02)) // uleb(0x100)
  assert(ops.bytes[7] == u8(0x51))
  assert(ops.bytes[8] == u8(0x22) && ops.bytes[9] == u8(0x80) && ops.bytes[10] == u8(0x40)) // uleb(0x2000)
  assert(ops.bytes[11] == u8(0x51))
  assert(ops.bytes[12] == u8(0x00)) // DONE
  assert(len(ops.bytes) == 13)

  // Nothing to slide: no stream at all, not an empty-but-present one.
  assert(len(meRebaseStream([]int(0), 2).bytes) == 0)

  // The bind stream names libSystem as dylib #1, then binds each import's GOT
  // slot, then each absolute data pointer to an import.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Aarch64AdrGotPage, loGlobalRef("_environ"))])]}
  let st = meAnalyze([m])
  let b = meBindStream(st, [MeDataBind{ segOff: 0x40, name: "_malloc" }],
    0x100008000, 0x100008000, 2)
  assert(b.bytes[0] == u8(0x11)) // SET_DYLIB_ORDINAL_IMM | 1
  // _environ's GOT slot is at offset 0 of __DATA.
  assert(b.bytes[1] == u8(0x40))
  assert(string(b.bytes[2:10]) == "_environ")
  assert(b.bytes[10] == u8(0x00)) // NUL
  assert(b.bytes[11] == u8(0x51)) // SET_TYPE_IMM | POINTER
  assert(b.bytes[12] == u8(0x72)) // SET_SEGMENT_AND_OFFSET_ULEB | 2
  assert(b.bytes[13] == u8(0x00)) // uleb(0)
  assert(b.bytes[14] == u8(0x90)) // DO_BIND
  assert(b.bytes[len(b.bytes) - 1] == u8(0x00)) // DONE
}

function checkMachoExecApply() {
  // __start branches to an internal helper and holds an abs64 to it; `ptr` is a
  // data atom whose abs64 must be rebased.
  let m = LoModule{ name: "rt", atoms: [
    meCodeAtom("__start", LoBinding.Global, 0x94000000, [
      meRel(0, LoRelocKind.Aarch64Call26, loLocalRef(1))]),
    meAtom("helper", LoSectionKind.Text, LoBinding.Global, 8, []LoReloc(0)),
    meAtom("ptr", LoSectionKind.Data, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Abs64, loLocalRef(1))])]}
  let g = resolveGlobals([m]) catch e { map<string, int>{} }
  // `ptr` is data, unreachable from __start's code, so dead-strip would drop it.
  // Force it kept to exercise the abs64/rebase path. (Reading a dropped atom out
  // of pat.bytes returns the zero slice, and using it without checking the
  // comma-ok flag crashes silently — which is exactly what the flag is for.)
  let st0 = meDeadStripWithImports([m], g, 0, []string(0)) catch e {
    assert(false)
    meEmptyState()
  }
  st0.kept[atomKey(0, 2)] = true
  let st1 = mePartition([m], st0)
  let st = meBuildGotAndStubs([m], g, st1) catch e {
    assert(false)
    meEmptyState()
  }

  // Place text at a known base; put the data atom in __DATA.
  let addrOf = map<int, int>{}
  addrOf[atomKey(0, 0)] = 0x100000000
  addrOf[atomKey(0, 1)] = 0x100000010
  addrOf[atomKey(0, 2)] = 0x100008000
  let a = meAddrs(0x100004000, 0x100008100, 0x100008000, 0)
  let pat = meApplyRelocs([m], g, st, addrOf, a) catch e {
    assert(false)
    meEmptyPatched()
  }

  // The internal branch resolves direct: bl +16 == the assembler's 0x94000004.
  let (code, _) = pat.bytes[atomKey(0, 0)]
  assert(loRdU32(code, 0) == 0x94000004)

  // The data atom's abs64 holds helper's absolute address...
  let (data, _) = pat.bytes[atomKey(0, 2)]
  assert(loRdU64(data, 0) == 0x100000010)
  // ...and is rebased, since __data is writable and dyld slides the image.
  // The GOT is empty here, so the only rebase is the data pointer's.
  assert(len(pat.dataRebases) == 1)
  assert(pat.dataRebases[0] == 0) // 0x100008000 - dataSegVaddr
  assert(len(pat.dataBinds) == 0)

  // The atom's ORIGINAL bytes are untouched — only the patched copy carries the
  // relocated value. Two atoms can share a backing slice.
  assert(loRdU64(m.atoms[2].data, 0) == 0)
}

function checkMachoExecApplyImports() {
  // A branch to an import is retargeted to its STUB, not to the symbol; an
  // abs64 to an import is left zero for dyld to bind.
  let m = LoModule{ name: "rt", atoms: [
    meCodeAtom("__start", LoBinding.Global, 0x94000000, [
      meRel(0, LoRelocKind.Aarch64Call26, loGlobalRef("_exit"))]),
    meAtom("fnptr", LoSectionKind.Data, LoBinding.Global, 8, [
      meRel(0, LoRelocKind.Abs64, loGlobalRef("_malloc"))])]}
  let g = resolveGlobals([m]) catch e { map<string, int>{} }
  let st0 = meDeadStripWithImports([m], g, 0, []string(0)) catch e { meEmptyState() }
  // fnptr is not reachable from __start, so force it kept to exercise the path.
  st0.kept[atomKey(0, 1)] = true
  let st1 = mePartition([m], st0)
  let st = meBuildGotAndStubs([m], g, st1) catch e { meEmptyState() }

  let addrOf = map<int, int>{}
  addrOf[atomKey(0, 0)] = 0x100000000
  addrOf[atomKey(0, 1)] = 0x100008000
  let a = meAddrs(0x100004000, 0x100008100, 0x100008000, 0)
  let pat = meApplyRelocs([m], g, st, addrOf, a) catch e {
    assert(false)
    meEmptyPatched()
  }

  // The branch targets stub 0 at 0x100004000, from p = 0x100000000:
  // disp = 0x4000, imm26 = 0x1000.
  let (code, _) = pat.bytes[atomKey(0, 0)]
  assert(loRdU32(code, 0) == 0x94001000)

  // The import pointer stays zero in the file and is recorded as a bind.
  let (data, _) = pat.bytes[atomKey(0, 1)]
  assert(loRdU64(data, 0) == 0)
  assert(len(pat.dataBinds) == 1)
  assert(pat.dataBinds[0].name == "_malloc" && pat.dataBinds[0].segOff == 0)
  // The import's GOT slot is NOT rebased — dyld binds it instead.
  assert(len(pat.dataRebases) == 0)
}

function checkMachoExecTlsOffset() {
  // A tlv_descriptor's data field points at the variable's storage, and must be
  // stored as its constant OFFSET within the TLV template — not an absolute
  // address, and never rebased. dyld reads the offset directly.
  let m = LoModule{ name: "rt", atoms: [
    meAtom("__start", LoSectionKind.Text, LoBinding.Global, 4, [
      meRel(0, LoRelocKind.Aarch64AdrPrelPgHi21, loLocalRef(1))]),
    meAtom("desc", LoSectionKind.TlsVars, LoBinding.Global, 24, [
      meRel(16, LoRelocKind.Abs64, loLocalRef(2))]),
    meAtom("x$tlv$init", LoSectionKind.TlsData, LoBinding.Local, 8, []LoReloc(0))]}
  let g = resolveGlobals([m]) catch e { map<string, int>{} }
  let st = meAnalyze([m])

  let addrOf = map<int, int>{}
  addrOf[atomKey(0, 0)] = 0x100000000
  addrOf[atomKey(0, 1)] = 0x100008000
  addrOf[atomKey(0, 2)] = 0x100008040 // the TLV template base
  let a = meAddrs(0x100004000, 0x100008100, 0x100008000, 0x100008040)
  let pat = meApplyRelocs([m], g, st, addrOf, a) catch e {
    assert(false)
    meEmptyPatched()
  }

  // The variable sits at the template's base, so its offset is 0 — NOT
  // 0x100008040.
  let (desc, _) = pat.bytes[atomKey(0, 1)]
  assert(loRdU64(desc, 16) == 0)
  // A TLS offset is a constant dyld validates; rebasing it would corrupt it.
  assert(len(pat.dataRebases) == 0)
}

// Stage 3 (#1344 part 5d) the executable writer's load commands and stubs. The
// stub's three base words were produced by the system assembler for
// `adrp x16, _g@PAGE ; ldr x16, [x16, _g@PAGEOFF] ; br x16` — 90000010 f9400210
// d61f0200.

function checkMachoExecStub() {
  // The stub loads the import's GOT slot and jumps through it. dyld never
  // touches the stub itself; it binds the GOT slot the stub reads.
  let file = []u8(16)
  meWriteStub(file, 0, 0x100004000, 0x100008000) catch e {
    assert(false)
  }
  // adrp x16: (page(got) - page(stub)) >> 12 == 4 -> immlo=0, immhi=1.
  assert(loRdU32(file, 0) == 0x90000010 | (1 << 5))
  // ldr x16, [x16, #0]: the GOT slot is page-aligned here, so imm12 == 0.
  assert(loRdU32(file, 4) == 0xf9400210)
  assert(loRdU32(file, 8) == 0xd61f0200) // br x16 — untouched

  // A GOT slot at a nonzero page offset lands in the ldr's scaled imm12.
  let f2 = []u8(16)
  meWriteStub(f2, 0, 0x100004000, 0x100008040) catch e {
    assert(false)
  }
  assert(loRdU32(f2, 0) == 0x90000010 | (1 << 5))
  // (0x40 & 0xfff) >> 3 == 8 -> imm12 field at bits [21:10].
  assert(loRdU32(f2, 4) == 0xf9400210 | (8 << 10))
}

function checkMachoExecCmdSizes() {
  // Every file offset a load command records is measured from the end of the
  // commands, so sizeofcmds must match the bytes actually emitted — exactly.
  // These are the real <mach-o/loader.h> struct sizes.
  assert(mrSizeofSegment() == 72)
  assert(mrSizeofSection() == 80)

  // A segment command's cmdsize covers its trailing section headers.
  let lc = newByteBuf()
  meAppendSeg(lc, "__TEXT", 0x100000000, 0x4000, 0, 0x4000, 5, 5, 2)
  assert(len(lc.bytes) == 72)
  assert(leAt(lc.bytes, 0, 4) == 0x19)          // LC_SEGMENT_64
  assert(leAt(lc.bytes, 4, 4) == 72 + 2 * 80)   // cmdsize includes 2 sections
  assert(name16At(lc.bytes, 8) == "__TEXT")
  assert(leAt(lc.bytes, 24, 8) == 0x100000000)  // vmaddr
  assert(leAt(lc.bytes, 64, 4) == 2)            // nsects

  let sc = newByteBuf()
  meAppendSect(sc, "__text", "__TEXT", 0x100001000, 0x200, 0x1000, 2, 0x80000400, 0, 0)
  assert(len(sc.bytes) == 80)
  assert(name16At(sc.bytes, 0) == "__text")
  assert(name16At(sc.bytes, 16) == "__TEXT")
  assert(leAt(sc.bytes, 32, 8) == 0x100001000) // addr
  assert(leAt(sc.bytes, 48, 4) == 0x1000)      // offset
  assert(leAt(sc.bytes, 56, 4) == 0)           // reloff: an exec has none
  assert(leAt(sc.bytes, 60, 4) == 0)           // nreloc
  assert(leAt(sc.bytes, 64, 4) == 0x80000400)  // flags

  // The dylinker/dylib commands carry a NUL-terminated path padded to 8.
  let dl = newByteBuf()
  meAppendDylinker(dl)
  assert(len(dl.bytes) == meDylinkerCmdsize())
  assert(len(dl.bytes) % 8 == 0)
  assert(leAt(dl.bytes, 0, 4) == 0xe) // LC_LOAD_DYLINKER
  assert(leAt(dl.bytes, 8, 4) == 12)  // name.offset
  assert(string(dl.bytes[12:12 + 13]) == "/usr/lib/dyld")
  assert(dl.bytes[12 + 13] == u8(0))

  let dy = newByteBuf()
  meAppendDylib(dy)
  assert(len(dy.bytes) == meDylibCmdsize())
  assert(len(dy.bytes) % 8 == 0)
  assert(leAt(dy.bytes, 0, 4) == 0xc) // LC_LOAD_DYLIB
  assert(leAt(dy.bytes, 8, 4) == 24)  // name.offset
  assert(string(dy.bytes[24:24 + 26]) == "/usr/lib/libSystem.B.dylib")

  let mn = newByteBuf()
  meAppendMain(mn, 0x1234)
  assert(len(mn.bytes) == 24)
  assert(leAt(mn.bytes, 0, 4) == 0x28 | 0x80000000) // LC_MAIN | LC_REQ_DYLD
  assert(leAt(mn.bytes, 8, 8) == 0x1234)            // entryoff
  assert(leAt(mn.bytes, 16, 8) == 0)                // stacksize: default

  let ds = newByteBuf()
  meAppendDysymtab(ds, 3, 0x900, 5)
  assert(len(ds.bytes) == 80)
  assert(leAt(ds.bytes, 28, 4) == 3)     // nundefsym
  assert(leAt(ds.bytes, 56, 4) == 0x900) // indirectsymoff
  assert(leAt(ds.bytes, 60, 4) == 5)     // nindirectsyms

  let di = newByteBuf()
  meAppendDyldInfo(di, 0x100, 8, 0x108, 16)
  assert(len(di.bytes) == 48)
  let sy = newByteBuf()
  meAppendSymtab(sy, 0x200, 2, 0x300, 9)
  assert(len(sy.bytes) == 24)
  let bv = newByteBuf()
  meAppendBuildVersion(bv)
  assert(len(bv.bytes) == 24)
  let cs = newByteBuf()
  meAppendCodeSignature(cs, 0x400, 0x100)
  assert(len(cs.bytes) == 16)
}

function checkMachoExecHeaderAndCounts() {
  // A pure-text image: __text only, no __DATA at all.
  let m = LoModule{ name: "rt", atoms: [
    meCodeAtom("__start", LoBinding.Global, 0xd65f03c0, []LoReloc(0))]}
  let st = meAnalyze([m])
  assert(meTextNsects(st) == 1 && meDataNsects(st) == 0)
  assert(!meHasDataSeg(st))

  // sizeofcmds must equal the bytes the emitters actually produce. Assemble the
  // no-__DATA command set and compare — this is the invariant every recorded
  // file offset depends on.
  let want = meSizeofcmds(1, 0, false)
  let lc = newByteBuf()
  meAppendSeg(lc, "__PAGEZERO", 0, meBaseVaddr(), 0, 0, 0, 0, 0)
  meAppendSeg(lc, "__TEXT", meBaseVaddr(), 0x4000, 0, 0x4000, 5, 5, 1)
  meAppendSect(lc, "__text", "__TEXT", meBaseVaddr(), 4, 0, 2, 0x80000400, 0, 0)
  meAppendSeg(lc, "__LINKEDIT", meBaseVaddr() + 0x4000, 0x4000, 0x4000, 0x100, 1, 1, 0)
  meAppendDyldInfo(lc, 0, 0, 0, 0)
  meAppendSymtab(lc, 0, 0, 0, 1)
  meAppendDysymtab(lc, 0, 0, 0)
  meAppendDylinker(lc)
  meAppendDylib(lc)
  meAppendBuildVersion(lc)
  meAppendMain(lc, 0)
  meAppendCodeSignature(lc, 0, 0)
  assert(len(lc.bytes) == want)

  // The header: arm64 MH_EXECUTE, PIE, two-level, dyld-linked.
  let h = newByteBuf()
  meAppendHeader(h, want, false, false)
  assert(len(h.bytes) == 32)
  assert(leAt(h.bytes, 0, 4) == 0xfeedfacf)
  assert(leAt(h.bytes, 4, 4) == 0x0100000C) // CPU_TYPE_ARM64
  assert(leAt(h.bytes, 12, 4) == 0x2)       // MH_EXECUTE
  assert(leAt(h.bytes, 16, 4) == 11)        // ncmds: no __DATA
  assert(leAt(h.bytes, 20, 4) == want)
  assert(leAt(h.bytes, 24, 4) == 0x4 | 0x80 | 0x200000) // DYLDLINK|TWOLEVEL|PIE
  // No TLV descriptors here, so the TLV flag must be OFF — with it set, dyld
  // would look for descriptors that do not exist.
  assert(leAt(h.bytes, 24, 4) & 0x800000 == 0)

  // An image WITH tlv_descriptors must set the flag, or dyld skips TLV setup and
  // the first thread-local access hits _tlv_bootstrap_error.
  let h2 = newByteBuf()
  meAppendHeader(h2, want, true, true)
  assert(leAt(h2.bytes, 24, 4) & 0x800000 == 0x800000)
  assert(leAt(h2.bytes, 16, 4) == 12) // ncmds: __DATA present
}
