// Self-host Stage 2 (#1337): the type checker, ported from compiler/check.zig.
// This first chunk is the inference skeleton + the `--dump-types` surface: it
// assigns a TypeId to every node (`nodeTypes`), infers literal expressions and
// their default types, resolves simple type annotations, and renders the
// binding/arrow-param/call type dump the seed's `bit --dump-types` emits. The
// full inference (idents, calls, operators, generics — needs resolve + method
// sets) grows on top, verified by the corpus `--dump-types` differential.

// A 0-based source position (line, column) for the dump gutter.
struct LineCol {
  line: int,
  col: int,
}

// Maps a byte offset to 0-based line/column. Bounded by the offset.
function locateOffset(source: string, offset: int): LineCol {
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  return LineCol{ line: line, col: offset - lineStart }
}

struct Checker {
  ctx: TypeContext,
  tree: Tree,
  source: string,
  // True when RESOLUTION already failed before this module was checked. The
  // seed's CLI short-circuits the checker entirely on a resolver error (an
  // undefined name makes every downstream type a guess), so any check-stage
  // diagnostic it would have produced never appears. Module-state validation
  // (§11.11) honours the same rule rather than reporting into a broken tree —
  // otherwise bit2 reports where the seed is silent, which is the one
  // divergence direction that breaks builds.
  resolveFailed: bool,
  nodeTypes: []int,
  // name -> TypeId for the bindings/params in scope, and name -> result type for
  // top-level functions (a pre-pass fills the latter so forward calls resolve).
  // ponytail: one flat env, no per-function scoping yet — fine until two
  // functions bind the same name to different types.
  env: map<string, int>,
  funcResults: map<string, int>,
  // Declared struct/enum/alias name -> its named TypeId.
  userTypes: map<string, int>,
  // Free-function name -> its full `(params) => result` func TypeId, so a bare
  // function reference (`let g = inc`) types as a first-class value.
  funcSigs: map<string, int>,
  // Free-function name -> its FuncDecl node, so a generic call can substitute
  // its type parameters from the argument types at the call site.
  funcDecls: map<string, int>,
  // SPEC 11.7: free-function name -> true when it is an `extern function`. This
  // is what tells lowering to emit a declaration carrying the RAW symbol name
  // instead of a module-qualified definition.
  externFns: map<string, bool>,
  // Type-parameter name -> its constraint interface type, so a method call on a
  // constrained generic value `s.area()` (s: T, `T: Shape`) resolves via Shape.
  typeParamConstraints: map<string, int>,
  // Local/param name -> its declared type NODE (rebound per function in
  // lowering), so a generic-enum scrutinee `o: Opt<i64>` can recover its type
  // arguments for match-binder substitution.
  declTypeNodes: map<string, int>,
  // Local name -> the CALL node that initialized it, for an un-annotated
  // `let found = find<i64>(xs, …)`. A generic INSTANCE type carries no type
  // arguments (`Option<i64>` and `Option<string>` are one TypeId, deliberately —
  // carrying them would move --dump-types off seed parity), and `declTypeNodes`
  // only has an entry when the type was WRITTEN. So a type param reachable only
  // through `Option<T>` had nothing to bind from and `unwrap(found)` stayed a
  // bare type param (#1498). Recording the initializer lets the binder re-derive
  // the instance's type arguments on demand instead.
  declInitNodes: map<string, int>,
  // Named type -> its decl node, so a forward reference during declTypeOf can
  // reserve+resolve it on first touch (the seed's declTypeOf recursion), giving
  // type ids in source-order touch order (needed for method-name mangling).
  typeDecls: map<string, int>,
  // A generic list node (`<T, U>`) -> that decl's OWN TypeParam ids, in
  // declaration order. `userTypes[name]` cannot answer this: every generic
  // registers its params under their bare names, so the last `<T>` declared in
  // the module wins and an earlier decl's `T` becomes unreachable by name. The
  // ids are what a template body's checked types actually mention, so
  // monomorphization needs them exactly (see genericEnvOf).
  genericParamIds: map<int, []int>,
  // --- module identity (#1345) --------------------------------------------
  // This module's id. The root is the module being built; lowering leaves the
  // root's names bare (so `main` stays `main`) and prefixes every other
  // module's with `m<id>$`.
  moduleId: int,
  // Every module's checker, indexed by module id. A name imported from another
  // module has its DECLARATION in that module's tree, so reading the decl needs
  // that module's `tree`/`source` — see `declOwner`. Type information does not:
  // TypeIds are global to the shared TypeContext, so an import copies the
  // exporting module's type entries straight into the maps above and the whole
  // checker keeps working name-keyed and unchanged.
  mods: []Checker,
  // Local name -> where it was imported from. A name absent here is declared in
  // this module.
  importedFrom: map<string, ImportOrigin>,
  // The names this module declares under `export` — the only ones another
  // module may import, and the set the prelude auto-imports everywhere.
  exports: map<string, bool>,
  // Import path text ("std/fs") -> module id, filled by the loader before
  // checking. -1 marks a path that resolved to no module.
  importPaths: map<string, int>,
  // Module-scope binding name -> type, for `const`/`let` declared at the top
  // level. `env` cannot answer this: it is FLAT, so a function-local `let e`
  // anywhere in the module overwrites the module-level `e`'s entry and never
  // restores it. An importer that read `env` therefore inherited the LOCAL's
  // type for an exported constant — a silent miscompile (#1499). Written only
  // by top-level bindings, so it is the one honest source for `importName`.
  moduleEnv: map<string, int>,
  // Namespace alias -> module id, from `import ns from "..."` / `import * as ns`.
  // Every export of that module is ALSO bound in the maps above under the dotted
  // key "ns.name", so `ns.member` resolves through the same name-keyed lookups a
  // plain `import { member }` uses — see `bindNamespaceImports`.
  namespaces: map<string, int>,
  // An ArrowFn NODE -> the function type the arrow is written against, where
  // the source supplies one (#1487). The seed threads an `expected` type down
  // every checkExpr; this checker infers bottom-up and has no such parameter,
  // so the two positions that can supply one — an annotated binding's
  // initializer and a resolved free call's argument — record it here, keyed by
  // node, before anything types an arrow. Sparse: arrows are rare, and only
  // `checkArrowFn` ever reads it.
  arrowExpected: map<int, int>,
  // --- resolver handoff (#1370) -------------------------------------------
  // The resolver's per-node symbol table for THIS module: `nodeSymbols[node]`
  // is the symbol id an identifier reference resolves to (0 = none), and
  // `symbols[id]` is that Symbol. Empty on the bare dump entry points (which
  // never run the resolver); checkExprType falls back to the flat env there and
  // whenever a reference has no resolved decl (imports, builtins).
  symbols: []Symbol,
  nodeSymbols: []int,
  // A local decl's name-ident NODE -> its type, recorded where the flat env is
  // written. Keyed by node, it is immune to the same-name-across-functions
  // clobbering the flat env suffers, so an identifier typed via its resolved
  // decl (nodeSymbols) is always this decl's type — inside a generic body it
  // holds the template type, which lowering's `nodeType` substitutes exactly as
  // it does the env's, so the two paths agree byte-for-byte.
  declTypes: []int,
  // --- diagnostics --------------------------------------------------------
  // Where validation (validate.bit) reports to. Every module in a project
  // shares one sink, so `renderDiags` prints the whole build's errors in one
  // pass and `hasErrors` is a single question.
  diags: Diagnostics,
  // This module's files, as SourceManager ids and as the module-global offset
  // each one's text begins at — parallel arrays mirroring the SrcModule's
  // fileNames/fileStarts. A module is its files concatenated, so a span is
  // module-global and needs both to name a file and a line (see `vSpan`).
  files: []int,
  fileStarts: []int,
}

// Where an imported name comes from: the module that declares it, and the name
// it is declared under THERE — which differs from the local name whenever the
// import renames it (`import { readFile as slurp }`). Both are needed: the
// declaration is looked up in the exporter under `name`, and the link symbol is
// built from `name` too, so an alias never reaches the object file.
struct ImportOrigin {
  module: int,
  name: string,
}

// One generic-function instantiation: the module that DECLARES the generic, the
// generic's name there, and the concrete argument types it was called with (one
// per parameter, in order). `module` is what makes an instantiation of an
// imported generic resolve to one symbol from every caller.
struct Instantiation {
  module: int,
  name: string,
  args: []int,
}

// A checker over one module's concatenated source. The diagnostics sink it comes
// with is a private one over a single unnamed file — enough for the dump entry
// points, which parse a bare source string. `checkProject` replaces it (and the
// file map) with the project's shared sink, so real builds render real paths.
function newChecker(tree: Tree, source: string, ctx: TypeContext): Checker {
  let nt = []int(0)
  let i = 0
  while (i < len(tree.nodes)) {
    nt = append(nt, 0)
    i = i + 1
  }
  let dt = []int(0)
  let d = 0
  while (d < len(tree.nodes)) {
    dt = append(dt, 0)
    d = d + 1
  }
  let sm = newSourceManager()
  let f = addFile(sm, "", source)
  return Checker{ ctx: ctx, tree: tree, source: source, nodeTypes: nt,
    arrowExpected: map<int, int>{},
    symbols: []Symbol(0), nodeSymbols: []int(0), declTypes: dt,
    diags: newDiagnostics(sm), files: [f], fileStarts: [0],
    env: map<string, int>{}, funcResults: map<string, int>{}, userTypes: map<string, int>{},
    funcSigs: map<string, int>{}, funcDecls: map<string, int>{},
    externFns: map<string, bool>{},
    typeParamConstraints: map<string, int>{},
    declTypeNodes: map<string, int>{}, declInitNodes: map<string, int>{},
    typeDecls: map<string, int>{}, genericParamIds: map<int, []int>{},
    moduleId: 0, mods: []Checker(0),
    importedFrom: map<string, ImportOrigin>{}, exports: map<string, bool>{},
    importPaths: map<string, int>{}, namespaces: map<string, int>{},
    moduleEnv: map<string, int>{} }
}

// The declared name of a top-level decl node. A FuncDecl carries its name at
// kid 1 (kid 0 is the optional receiver); every other decl has it at kid 0.
// Getting this wrong reads a receiver as a name and exports nothing.
function topDeclName(c: Checker, node: int): string {
  let n = getNode(c.tree, node)
  if (n.tag == Tag.FuncDecl) {
    let k = kidsOf(c.tree, node)
    if (k[1] == 0) {
      return ""
    }
    let nm = getNode(c.tree, k[1])
    return c.source[nm.span.start:nm.span.end]
  }
  // SPEC 11.7: an extern decl carries its name at kid 0 (there is no receiver).
  if (n.tag == Tag.ExternFnDecl) {
    let k = kidsOf(c.tree, node)
    if (k[0] == 0) {
      return ""
    }
    let en = getNode(c.tree, k[0])
    return c.source[en.span.start:en.span.end]
  }
  if (n.tag == Tag.StructDecl || n.tag == Tag.EnumDecl || n.tag == Tag.InterfaceDecl ||
      n.tag == Tag.TypeAlias) {
    return declName(c, node)
  }
  return ""
}

// Records every name declared under `export` — the decls this module makes
// importable. `export` wraps its decl rather than replacing it, so the collect
// pass already sees the inner node; this only records visibility.
function collectExports(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.Export) {
      let inner = kidsOf(c.tree, i)[0]
      if (inner != 0) {
        // `export const A = 1, B = 2` / `export let s: int` declares one name per
        // BINDING, so it has no single decl name. Omitting them left every
        // exported constant and every piece of module state out of `exports` —
        // invisible to a namespace import and to the prelude's auto-import,
        // though a named `import { A }` still found it (that path never consults
        // this table).
        let it = getNode(c.tree, inner).tag
        if (it == Tag.ConstDecl || it == Tag.LetDecl) {
          for b of kidsOf(c.tree, inner) {
            if (b != 0) {
              c.exports[declName(c, b)] = true
            }
          }
        }
        let nm = topDeclName(c, inner)
        if (nm != "") {
          c.exports[nm] = true
        }
      }
    }
    i = i + 1
  }
}

// SPEC 11.7: an `extern function` node is [name, params, result_or_none] — three
// kids — where a FuncDecl is [recv, name, generics, params, result, body(, attrs)].
// Every reader that indexes a FuncDecl's kid 2/3/4 must branch on the tag first
// or it runs off the end of the kid list. An extern is never generic and never
// has a receiver, so the generic paths simply bail on one.
function isExternDecl(t: Tree, decl: int): bool {
  return getNode(t, decl).tag == Tag.ExternFnDecl
}

// The parameter-list node of either decl shape, or -1 when the callee is
// generic (its arity and param types are resolved by instantiation, so callers
// skip it). This is the safe reader the comment above demands: a FuncDecl keeps
// its params at kid 3 behind a generics list at kid 2, while an ExternFnDecl —
// three kids, never generic — keeps them at kid 1. Reading an extern with
// FuncDecl indices runs off the end when it declares no result, and silently
// mistakes its RESULT node for a generics list when it declares one.
function declParamListNode(owner: Checker, decl: int): int {
  let dk = kidsOf(owner.tree, decl)
  if (isExternDecl(owner.tree, decl)) {
    return dk[1] // SPEC 11.7: [name, params, result_or_none]
  }
  if (dk[2] != 0) {
    return -1 // generic
  }
  return dk[3]
}

// The checker whose tree holds `name`'s declaration: this one, unless `name` was
// imported. Every site that reads a declaration NODE for a name must go through
// this, because a node index only means anything inside its own tree — reading
// an imported function's decl against the importing module's tree would land on
// an unrelated node and silently miscompile.
function declOwner(c: Checker, name: string): Checker {
  // Local shadows import (see funcDeclLookup): a function this module declares
  // itself owns its node in THIS tree, never the exporter's — so the two agree
  // on which tree `funcDeclLookup`'s node belongs to.
  for (k, _) of c.funcDecls {
    if (k == name) {
      return c
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok || o.module < 0 || o.module >= len(c.mods)) {
    return c
  }
  return c.mods[o.module]
}

// `name` as the module that declares it spells it — the same name, unless this
// module imported it under an alias.
function declName2(c: Checker, name: string): string {
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return name
  }
  return o.name
}

// The link-level name for a function `base` declared in module `mod`, given the
// root module id. Mirrors the seed's `moduleQualified` exactly: the root keeps
// bare names (so `main` stays `main`, and a single-module build stays
// byte-identical), every other module gets an `m<id>$` prefix so two modules'
// same-named functions cannot collide in the object's flat symbol namespace.
function moduleQualified(mod: int, root: int, base: string): string {
  if (mod == root) {
    return base
  }
  return "m${mod}\$${base}"
}

// SPEC 11.7: the raw external symbol `name` binds to, or "" when `name` is not
// an `extern function`. Mirrors declOwner's local-shadows-import rule so the
// answer always comes from the module that actually declares the name.
function externSymbolOf(c: Checker, name: string): string {
  for (k, _) of c.funcDecls {
    if (k == name) {
      let (_, local) = c.externFns[name]
      if (local) {
        return name
      }
      return ""
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok || o.module < 0 || o.module >= len(c.mods)) {
    let (_, here) = c.externFns[name]
    if (here) {
      return name
    }
    return ""
  }
  let (_, remote) = c.mods[o.module].externFns[o.name]
  if (remote) {
    return o.name
  }
  return ""
}

// SPEC 11.9: the link name `name` is pinned to by `@symbol("...")`, or "" when
// it pins none. The decl NODE is read against declOwner's tree, never `c`'s: an
// imported function's node index only means anything inside its own tree.
function pinnedSymbolOf(c: Checker, name: string): string {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return ""
  }
  return funcAttrArg(declOwner(c, name), decl, "symbol")
}

// The link name for a call to `name` from `c`: an imported name resolves to its
// DEFINING module's prefix under its ORIGINAL spelling, so neither the caller's
// module nor a local alias reaches the object file.
function callQualified(c: Checker, root: int, name: string): string {
  // SPEC 11.7: an extern symbol is NEVER module-qualified — the raw name is
  // precisely the symbol the linker must import from the dylib.
  let ext = externSymbolOf(c, name)
  if (ext != "") {
    return ext
  }
  // SPEC 11.9: a pinned function's DEFINITION is emitted under the pinned name
  // (lowerFuncNamed), bypassing module qualification, so a call to it must be
  // spelled the same way. Without this the definition lands as `bit_rt_f` while
  // the call emits `m<id>$f` — an unresolvable reference that fails far from its
  // cause: dead-stripped when unreferenced, a dyld abort at load on Darwin.
  // Checked AFTER extern so an `extern function` (which has no attribute list at
  // kid 6) never reaches funcAttrArg; §11.7 consumes a symbol, §11.9 produces
  // one, and the two are disjoint by construction.
  let pin = pinnedSymbolOf(c, name)
  if (pin != "") {
    return pin
  }
  // A locally-declared function shadows a same-named prelude/import (§17.5), so
  // it links against THIS module's symbol — the same prefix its definition gets
  // (they share a module). Consulting the import first mis-qualifies a local
  // `unwrapOr` to the prelude's `m0$unwrapOr` while its definition stays bare,
  // and the link fails on the unresolved symbol. Mirrors funcDeclLookup.
  for (k, v) of c.funcDecls {
    if (k == name) {
      return moduleQualified(c.moduleId, root, name)
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return moduleQualified(c.moduleId, root, name)
  }
  return moduleQualified(o.module, root, o.name)
}

// The enum type-args a variant construction `Enum.Variant(args)` binds, inferred
// from the variant's bare-type-param payload slots and their argument types
// (`Opt.Some(9)` binds Opt's T from arg 9 -> i64). The decl is read from the
// module that declares the enum (see typeOwner); only the CALL node and its
// arguments belong to this module's tree.
function variantConstructionTypeArgs(c: Checker, callNode: int): []int {
  let out = []int(0)
  let mk = kidsOf(c.tree, kidsOf(c.tree, callNode)[0])
  let enumName = typeNodeName(c, mk[0])
  let vnn = getNode(c.tree, mk[1])
  let vname = c.source[vnn.span.start:vnn.span.end]
  let enumTy = userTypeLookup(c, enumName)
  if (enumTy == 0 || c.ctx.types[enumTy].kind != TypeKind.Enum) {
    return out
  }
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return out
  }
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  // Locate this variant's payload type nodes.
  let vs = enumVariantNodes(oc, decl)
  let payloadNodes = []int(0)
  let vi = 0
  while (vi < len(vs)) {
    let vn2 = getNode(oc.tree, kidsOf(oc.tree, vs[vi])[0])
    if (oc.source[vn2.span.start:vn2.span.end] == vname) {
      let pl = kidsOf(oc.tree, vs[vi])[1]
      if (pl != 0) {
        payloadNodes = kidsOf(oc.tree, pl)
      }
      vi = len(vs)
    } else {
      vi = vi + 1
    }
  }
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let bound = c.ctx.voidId
    let pj = 0
    while (pj < len(payloadNodes)) {
      let pn2 = getNode(oc.tree, payloadNodes[pj])
      if (pn2.tag == Tag.Ident && oc.source[pn2.span.start:pn2.span.end] == tpname) {
        bound = defaultType(c, checkArgType(c, callNode, pj))
        pj = len(payloadNodes)
      } else {
        pj = pj + 1
      }
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}

// The declared type NODE of the struct field a member expression `recv.f` reads,
// or 0 when the receiver is not a struct, the field is unknown, or the struct is
// declared in another module.
//
// The cross-module case is dropped deliberately: the returned node indexes the
// DECLARING module's tree, and every caller resolves it against `c` — the same
// restriction the imported-callee arm of `scrutineeTypeArgs` already applies.
function memberFieldTypeNode(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let rt = checkExprType(c, kids[0])
  if (rt == 0 || c.ctx.types[rt].kind != TypeKind.Struct) {
    return 0
  }
  let decl = structDeclOf(c, rt)
  if (decl == 0) {
    return 0
  }
  let oc = typeOwner(c, rt)
  if (oc.moduleId != c.moduleId) {
    return 0
  }
  let fields = structFieldNodes(oc, decl)
  let mn = getNode(c.tree, kids[1])
  let idx = fieldIndexByName(oc, fields, c.source[mn.span.start:mn.span.end])
  if (idx == -1) {
    return 0
  }
  return kidsOf(oc.tree, fields[idx])[1]
}

// The concrete type arguments of a generic-enum scrutinee expression, or empty:
// a local/param recovers them from its declared type node, a struct field from
// its declared field type node, a call from the callee's result type node (each
// a `Name<...>` GenericInst).
function scrutineeTypeArgs(c: Checker, node: int): []int {
  let out = []int(0)
  let n = getNode(c.tree, node)
  let tnode = 0
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        tnode = v
      }
    }
  } else if (n.tag == Tag.Member) {
    // `st.chOpt` — a struct field scrutinee recovers its type-args from the
    // field's declared type node, exactly as a local recovers them from its
    // annotation. Without this a `match (st.f)` on an `Option<T>` field bound
    // the arm payload at the unsubstituted type param (#1483).
    tnode = memberFieldTypeNode(c, node)
  } else if (n.tag == Tag.Call) {
    let ck = kidsOf(c.tree, node)
    let callee = getNode(c.tree, ck[0])
    if (callee.tag == Tag.Ident) {
      let cname = c.source[callee.span.start:callee.span.end]
      let decl = funcDeclLookup(c, cname)
      // An imported decl's nodes index its own module's tree; a generic
      // instance read from it would not be resolvable here anyway, so only a
      // locally-declared callee contributes a result node.
      //
      // OWNERSHIP IS CHECKED FIRST, and that order is load-bearing (#1476).
      // `funcDeclLookup` follows imports, so `decl` may index the EXPORTING
      // module's tree — its own doc comment requires callers to read it against
      // `declOwner(...).tree`. Testing `isExternDecl(c.tree, decl)` ahead of the
      // module check broke exactly that rule: it read a foreign node index
      // against THIS tree, and when the index ran past this tree's node count it
      // panicked "index out of range". Every corpus file reaching stdlib/http
      // crashed on `TlsTrustStore{ roots: bundled().roots }` — a cross-module
      // call whose result feeds a struct-literal field.
      if (decl != 0 && declOwner(c, cname).moduleId == c.moduleId && !isExternDecl(c.tree, decl)) {
        tnode = kidsOf(c.tree, decl)[4]
      }
    } else if (callee.tag == Tag.Member) {
      // `Enum.Variant(args)` construction: infer the enum's type-args from the
      // variant's bare-type-param payload slots and their argument types.
      return variantConstructionTypeArgs(c, node)
    }
  }
  if (tnode == 0 || getNode(c.tree, tnode).tag != Tag.GenericInst) {
    return out
  }
  // A generic instance `Name<A, B>` — kid 1 is the type-argument list.
  let targs = kidsOf(c.tree, kidsOf(c.tree, tnode)[1])
  let i = 0
  while (i < len(targs)) {
    out = append(out, typeFromNode(c, targs[i]))
    i = i + 1
  }
  return out
}

// The scrutinee's type-argument AST nodes (parallel to scrutineeTypeArgs, but
// unresolved), so a match binder can be recorded with its declared type node and
// a nested match on it can recover its own type-args. Empty when the scrutinee's
// type-args are inferred rather than written (variant construction).
function scrutineeTypeArgNodes(c: Checker, node: int): []int {
  let out = []int(0)
  let n = getNode(c.tree, node)
  let tnode = 0
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        tnode = v
      }
    }
  } else if (n.tag == Tag.Member) {
    // `st.chOpt` — a struct field scrutinee recovers its type-args from the
    // field's declared type node, exactly as a local recovers them from its
    // annotation. Without this a `match (st.f)` on an `Option<T>` field bound
    // the arm payload at the unsubstituted type param (#1483).
    tnode = memberFieldTypeNode(c, node)
  } else if (n.tag == Tag.Call) {
    let ck = kidsOf(c.tree, node)
    let callee = getNode(c.tree, ck[0])
    if (callee.tag == Tag.Ident) {
      let cname = c.source[callee.span.start:callee.span.end]
      let decl = funcDeclLookup(c, cname)
      // An imported decl's nodes index its own module's tree; a generic
      // instance read from it would not be resolvable here anyway, so only a
      // locally-declared callee contributes a result node.
      //
      // Ownership first, for the reason spelled out in `scrutineeTypeArgs`
      // (#1476): `decl` may index the exporting module's tree, so it must not
      // reach `isExternDecl(c.tree, ...)` until it is known to be local. This
      // twin had the identical latent bug; only the other one had a corpus file
      // that reached it.
      if (decl != 0 && declOwner(c, cname).moduleId == c.moduleId && !isExternDecl(c.tree, decl)) {
        tnode = kidsOf(c.tree, decl)[4]
      }
    }
  }
  if (tnode == 0 || getNode(c.tree, tnode).tag != Tag.GenericInst) {
    return out
  }
  let targs = kidsOf(c.tree, kidsOf(c.tree, tnode)[1])
  let i = 0
  while (i < len(targs)) {
    out = append(out, targs[i])
    i = i + 1
  }
  return out
}

function structFieldLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.structFields {
    if (k == key) {
      return v
    }
  }
  return 0
}

// The base name of a type node: a plain ident's text, or a generic instance's
// base (`Box<i64>` -> "Box"). Empty for anything else.
function typeNodeName(c: Checker, node: int): string {
  if (node == 0) {
    return ""
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Ident) {
    return c.source[n.span.start:n.span.end]
  }
  if (n.tag == Tag.GenericInst) {
    return typeNodeName(c, kidsOf(c.tree, node)[0])
  }
  return ""
}

function methodResultLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.methodResults {
    if (k == key) {
      return v
    }
  }
  return 0
}

// "TypeName.method" -> the method's `(params) => result` func type, or 0.
function methodSigLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.methodSigs {
    if (k == key) {
      return v
    }
  }
  return 0
}

// Builds a `(params) => result` func type from a params-list node (each kid a
// `param[name, type]`), for a method value or a signature.
// Interns a parameter list's types in source order, returning the id list.
function paramTypeIds(c: Checker, paramsNode: int): []int {
  let ptypes = []int(0)
  let params = kidsOf(c.tree, paramsNode)
  let i = 0
  while (i < len(params)) {
    ptypes = append(ptypes, typeFromNode(c, kidsOf(c.tree, params[i])[1]))
    i = i + 1
  }
  return ptypes
}

// The type a parameter's NAME binds to in the body. For `...name: T` the
// declared type node is the element type T but the body sees `[]T` (§10.3);
// every other parameter binds its declared type unchanged.
function paramBindType(c: Checker, tag: Tag, typeNode: int): int {
  let ty = typeFromNode(c, typeNode)
  if (tag == Tag.ParamRest) {
    return mkSlice(c.ctx, ty)
  }
  return ty
}

// A signature is variadic when its LAST parameter is `...name: T` (the grammar
// permits it only there). The interned param type stays the element type T —
// the seed does the same, and call-site arity checking reads the flag.
function paramsAreVariadic(c: Checker, paramsNode: int): bool {
  let params = kidsOf(c.tree, paramsNode)
  if (len(params) == 0) {
    return false
  }
  return getNode(c.tree, params[len(params) - 1]).tag == Tag.ParamRest
}

function funcTypeFromParams(c: Checker, paramsNode: int, resultTy: int): int {
  return mkFunc(c.ctx, paramTypeIds(c, paramsNode),
    paramsAreVariadic(c, paramsNode), resultTy)
}

// The type to resolve a method call against: a constrained type parameter `T`
// dispatches through its constraint interface, so `s.area()` (s: T, `T: Shape`)
// resolves on Shape. Any other type is its own receiver.
function methodRecvType(c: Checker, recvType: int): int {
  if (c.ctx.types[recvType].kind != TypeKind.TypeParam) {
    return recvType
  }
  for (k, v) of c.typeParamConstraints {
    if (k == c.ctx.types[recvType].name) {
      return v
    }
  }
  return recvType
}

function userTypeLookup(c: Checker, name: string): int {
  for (k, v) of c.userTypes {
    if (k == name) {
      return v
    }
  }
  return 0
}

// name -> TypeId from the scope env, or 0 (invalid) if unbound. ponytail: linear
// scan pending map comma-ok lowering. [[bit-maps]]
function envLookup(c: Checker, name: string): int {
  for (k, v) of c.env {
    if (k == name) {
      return v
    }
  }
  return 0
}

function funcResultLookup(c: Checker, name: string): int {
  for (k, v) of c.funcResults {
    if (k == name) {
      return v
    }
  }
  return 0
}

// The full `(params) => result` type of a free function used as a value, or 0.
function funcSigLookup(c: Checker, name: string): int {
  for (k, v) of c.funcSigs {
    if (k == name) {
      return v
    }
  }
  return 0
}

// The FuncDecl node for a free function, or 0. An imported name's decl lives in
// the exporting module's tree, so the lookup follows the import — callers that
// then read the node MUST read it against `declOwner(c, name).tree`.
function funcDeclLookup(c: Checker, name: string): int {
  // A locally-declared function shadows a same-named prelude/import (§17.5): the
  // user's own name wins, matching the resolver's rInjectPrelude and the seed.
  // Consulting the import first mis-resolved a local `unwrap` to the prelude's
  // generic `unwrap<T>`, so `genericResultAt` bound a phantom type param and the
  // call's type came out as the argument's rather than the declared result.
  for (k, v) of c.funcDecls {
    if (k == name) {
      return v
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (ok && o.module >= 0 && o.module < len(c.mods)) {
    let e = c.mods[o.module]
    for (k, v) of e.funcDecls {
      if (k == o.name) {
        return v
      }
    }
  }
  return 0
}

// Copies every entry whose key is exactly `orig`, or is prefixed `orig.` (a
// type's fields and methods are keyed "Type.member"), rebinding the key's
// leading name to `alias`. Named `orig`/`alias` because `from` is a keyword.
function copyQualified(dst: map<string, int>, src: map<string, int>, orig: string, alias: string) {
  for (k, v) of src {
    if (k == orig) {
      dst[alias] = v
      continue
    }
    if (len(k) > len(orig) && k[0:len(orig)] == orig && k[len(orig)] == '.') {
      dst[alias + k[len(orig):len(k)]] = v
    }
  }
}

// Binds `name` (as declared in module `mid`'s checker `e`) into `c` under
// `alias`. TypeIds are global to the shared TypeContext, so the type side of an
// import is a plain copy — which is what lets the rest of the checker stay
// name-keyed and completely unaware that modules exist. Only the declaration
// NODE cannot be copied; it stays in the exporter's tree, reached via declOwner.
function importName(c: Checker, e: Checker, mid: int, name: string, alias: string) {
  c.importedFrom[alias] = ImportOrigin{ module: mid, name: name }
  copyQualified(c.funcResults, e.funcResults, name, alias)
  copyQualified(c.funcSigs, e.funcSigs, name, alias)
  copyQualified(c.userTypes, e.userTypes, name, alias)
  // A module-level `export const` records its type in `env` (checkBinding), and
  // an importer that cannot type the name cannot use it at all: `${pi}` has no
  // idea what to interpolate. The exporting module is fully checked before this
  // runs (module ids are dependency order), so its env holds the const already.
  // From `moduleEnv`, never `env`: see the field comment. A local shadowing an
  // exported name is legal Bit (E0048 is only a warning), so reading the flat
  // env here handed the importer the shadowing local's type.
  copyQualified(c.env, e.moduleEnv, name, alias)
  // Fields and methods are NOT copied: they live on the type in the shared
  // TypeContext, so they resolve from any module that can name the type at all.
}

// Type-checks every module of a loaded project into ONE shared TypeContext, in
// module-id order — which the loader guarantees is dependency order, so each
// module's imports are already checked (their type maps populated) by the time
// it binds them. Returns the checkers, indexed by module id, for lowering.
// A checker over one file, with diagnostics that render against its real path —
// the single-file entry `check` and a single-file `build` share. The `--dump-*`
// entries deliberately do not use it: they take a bare source string and print
// their inference output whether or not the program is valid.
function checkFile(path: string, src: string): Checker {
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  let tree = parseSourceD(src, f, d)
  let c = newChecker(tree, src, newTypeContext())
  c.diags = d
  c.files = [f]
  c.fileStarts = [0]
  // A tree the parser rejected has holes the checker would read as real nodes,
  // so its errors are noise on top of the parse errors that caused them. The
  // seed stops here for the same reason.
  if (hasErrors(d)) {
    return c
  }
  checkModule(c)
  return c
}

// Prints any check errors and reports whether the caller must stop. Lowering an
// invalid program is exactly the silent miscompile the validator exists to
// prevent, so `build` must not proceed past a true here.
function reportCheckErrors(d: Diagnostics): bool {
  if (!hasErrors(d)) {
    return false
  }
  eprint(renderDiags(d))
  return true
}

// Phase 1 of the front end: build a Checker per module and run the RESOLVER over
// each, in module-id order.
//
// Split out from `checkProject` so `check`/`build` can report module-graph
// diagnostics (E0040/E0042/E0044/E0045/…) BEFORE the parse-error gate, which is
// where the seed reports them: its `loadProject` resolves as it loads, so a
// resolve error on a tree the parser also rejected still reaches the user. bit2
// resolved inside the check phase, behind that gate, so a malformed `import`
// reported its parse errors and then silently dropped the E0045 the seed emits.
function resolveProject(p: Project): []Checker {
  let ctx = newTypeContext()
  // The LOADER's sink and file map, not a fresh pair: it already registered
  // every file (it read them) and already reported any lex/parse error against
  // them. One sink for the whole build — an error in an imported module is still
  // this build's error — and check errors land beside the parse errors that
  // preceded them, in source order.
  let mods = []Checker(0)
  let i = 0
  while (i < len(p.mods)) {
    let c = newChecker(p.mods[i].tree, p.mods[i].source, ctx)
    c.moduleId = i
    c.importPaths = p.mods[i].imports
    c.diags = p.diags
    c.files = p.mods[i].files
    c.fileStarts = p.mods[i].fileStarts
    mods = append(mods, c)
    i = i + 1
  }
  // Hand out the shared table only now: `append` may move the backing array, so
  // a checker given the slice mid-build would hold a stale, short view of it.
  i = 0
  while (i < len(mods)) {
    mods[i].mods = mods
    i = i + 1
  }
  // Resolve before checking, in module-id order. The loader loads imports first,
  // so id order IS dependency order — every module's imports are already in
  // `resolved` by the time it resolves, which is what lets an import be checked
  // against its target's exports. The prelude self-guards: when module i IS the
  // prelude, `resolved` has only ids 0..i-1, so `rInjectPrelude` finds
  // prelude >= len(allModules) and skips.
  let resolved = []Module(0)
  i = 0
  while (i < len(mods)) {
    let rm = resolveModule(p.diags, p.mods[i], resolved, p.prelude)
    resolved = append(resolved, rm)
    // Hand this module's symbol table to its checker so checkExprType can type an
    // identifier from the decl it resolves to rather than the flat env.
    mods[i].symbols = rm.symbols
    mods[i].nodeSymbols = rm.nodeSymbols
    i = i + 1
  }
  return mods
}

// Phase 2: type-check every already-resolved module.
function checkResolved(p: Project, mods: []Checker) {
  let i = 0
  while (i < len(mods)) {
    collectExports(mods[i])
    bindImports(mods[i], p.prelude)
    checkModule(mods[i])
    i = i + 1
  }
}

function checkProject(p: Project): []Checker {
  let mods = resolveProject(p)
  checkResolved(p, mods)
  return mods
}

// Binds every name a module imports, before its own declarations are collected —
// an import is in scope for the whole module, including decls written above it.
// The prelude's exports bind first so an explicit import of the same name wins.
function bindImports(c: Checker, preludeId: int) {
  if (preludeId >= 0 && preludeId < len(c.mods) && preludeId != c.moduleId) {
    let p = c.mods[preludeId]
    for (n, _) of p.exports {
      importName(c, p, preludeId, n, n)
    }
  }
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0 || getNode(c.tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let dk = kidsOf(c.tree, d)
    let pathNode = getNode(c.tree, dk[1])
    let path = stringLitText(c.source, pathNode.span)
    let (mid, found) = c.importPaths[path]
    if (!found || mid < 0 || mid >= len(c.mods)) {
      continue // unresolved import: already reported by the loader
    }
    let e = c.mods[mid]
    let body = getNode(c.tree, dk[0])
    if (body.tag == Tag.ImportNs || body.tag == Tag.ImportStar) {
      bindNamespaceImport(c, e, mid, dk[0])
      continue
    }
    if (body.tag != Tag.ImportGroup) {
      continue
    }
    for item of kidsOf(c.tree, dk[0]) {
      let ik = kidsOf(c.tree, item)
      let nn = getNode(c.tree, ik[0])
      let name = c.source[nn.span.start:nn.span.end]
      let alias = name
      if (ik[1] != 0) {
        let an = getNode(c.tree, ik[1])
        alias = c.source[an.span.start:an.span.end]
      }
      importName(c, e, mid, name, alias)
    }
  }
}

// `import ns from "..."` / `import * as ns from "..."` (#1154): binds every one
// of the module's exports under the dotted key "ns.name", which is exactly what
// `import { name } from "..."` would have bound under the bare name. Every
// downstream lookup — funcResultLookup, declOwner, callQualified, the const
// tables — is name-keyed, so nothing else has to learn what a namespace is.
function bindNamespaceImport(c: Checker, e: Checker, mid: int, body: int) {
  let nn = getNode(c.tree, kidsOf(c.tree, body)[0])
  let alias = c.source[nn.span.start:nn.span.end]
  c.namespaces[alias] = mid
  for (n, _) of e.exports {
    importName(c, e, mid, n, alias + "." + n)
  }
}

// The dotted lookup key for `ns.member`, or "" when the member's receiver is not
// a bound namespace (an ordinary field or method access). Only an Ident receiver
// can name a namespace, so a shadowing local never reaches here as a Member.
function nsQualifiedName(c: Checker, node: int): string {
  let k = kidsOf(c.tree, node)
  if (getNode(c.tree, k[0]).tag != Tag.Ident) {
    return ""
  }
  let bn = getNode(c.tree, k[0]).span
  let base = c.source[bn.start:bn.end]
  let (_, ok) = c.namespaces[base]
  if (!ok) {
    return ""
  }
  let mn = getNode(c.tree, k[1]).span
  return base + "." + c.source[mn.start:mn.end]
}

// Whether `name` is one of the FuncDecl's declared generic type parameters.
function isTypeParamName(c: Checker, decl: int, name: string): bool {
  let g = kidsOf(c.tree, decl)[2]
  if (g == 0) {
    return false
  }
  let ps = kidsOf(c.tree, g)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    if (c.source[nm.span.start:nm.span.end] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// The concrete result type of a call to a generic function: bind every type
// param from the arguments, then resolve the declared result node with those
// bindings in force. Returns -1 when the rule does not apply (non-generic, or no
// declared result) so the caller falls back.
//
// A bare `T` result and a composite `[]T` are the SAME operation — only the node
// shape differs — so both go through typeFromNodeIn. Handling only the bare case
// (as this did) left `[]T` resolving with `T` unsubstituted: `len()` still worked
// (it ignores the element type) but indexing or iterating the result could not
// compute an element width, and lowering silently stubbed the whole caller out.
function genericResultAt(c: Checker, name: string, callNode: int): int {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return -1
  }
  // An imported callee's decl indexes ITS module's node arena; reading it
  // against this module's tree is an out-of-range panic at best and a silently
  // unrelated node at worst.
  let oc = declOwner(c, name)
  if (isExternDecl(oc.tree, decl)) {
    return -1 // SPEC 11.7: never generic
  }
  let dk = kidsOf(oc.tree, decl)
  if (dk[2] == 0 || dk[4] == 0) {
    return -1 // not generic, or no declared result: the plain path handles it
  }
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let sub = noSubst()
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    // A type param no parameter mentions (`function zero<T>(): T`) stays
    // unbound and resolves as it always did — no worse than before.
    let bound = bindTypeParamAtCall(oc, c, callNode, params, tpname)
    if (bound != 0) {
      sub.names = append(sub.names, tpname)
      sub.types = append(sub.types, bound)
    }
    ti = ti + 1
  }
  if (len(sub.names) == 0) {
    return -1 // nothing bound: the plain path renders it just as well
  }
  let r = typeFromNodeIn(oc, dk[4], sub)
  if (r == 0) {
    return -1
  }
  return r
}

// Whether `name` is a generic free function (has a non-empty `<...>` list).
function isGenericFunc(c: Checker, name: string): bool {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return false
  }
  // The decl may belong to an imported module, whose node indices only mean
  // anything in ITS tree.
  let oc = declOwner(c, name)
  if (isExternDecl(oc.tree, decl)) {
    return false // SPEC 11.7: never generic
  }
  let gp = kidsOf(oc.tree, decl)[2]
  return gp != 0 && len(kidsOf(oc.tree, gp)) > 0
}

// Structurally binds type-param `tpname` from a parameter's type node against a
// concrete argument type: a bare `T` binds directly; `[]T`/`[N]T`/`chan<T>`
// recurse into the element, `map<K,V>` into key then value, `T!E` into the ok
// type. Returns 0 when this parameter does not mention `tpname`.
// `pc` owns `paramNode`'s tree — the module DECLARING the generic, which is not
// the caller's when the generic was imported. `argType` is a TypeId, global to
// the shared context, so it needs no module of its own.
function bindTypeParamFromNode(pc: Checker, paramNode: int, argType: int, tpname: string): int {
  let pn = getNode(pc.tree, paramNode)
  if (pn.tag == Tag.Ident) {
    if (pc.source[pn.span.start:pn.span.end] == tpname) {
      return argType
    }
    return 0
  }
  if (argType == 0) {
    return 0
  }
  let at = pc.ctx.types[argType]
  let pk = kidsOf(pc.tree, paramNode)
  if (pn.tag == Tag.SliceType && at.kind == TypeKind.Slice) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.ArrayType && at.kind == TypeKind.Array) {
    return bindTypeParamFromNode(pc, pk[1], at.elem, tpname)
  }
  if (pn.tag == Tag.ChanType && at.kind == TypeKind.Chan) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.MapType && at.kind == TypeKind.Map) {
    let k = bindTypeParamFromNode(pc, pk[0], at.mapKey, tpname)
    if (k != 0) {
      return k
    }
    return bindTypeParamFromNode(pc, pk[1], at.mapVal, tpname)
  }
  if (pn.tag == Tag.Fallible && at.kind == TypeKind.Fallible) {
    return bindTypeParamFromNode(pc, pk[0], at.result, tpname)
  }
  // `f: (T) => U` against a concrete `(i64) => i64`. Without this a type param
  // reachable ONLY through a function-typed parameter — `U` in
  // `mapped<T, U>(xs: []T, f: (T) => U): []U` — can never bind. Func params live
  // in `members`; try each position, then the result.
  if (pn.tag == Tag.FuncType && at.kind == TypeKind.Func) {
    let plist = kidsOf(pc.tree, pk[0])
    let i = 0
    while (i < len(plist) && i < len(at.members)) {
      let b = bindTypeParamFromNode(pc, plist[i], at.members[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
    return bindTypeParamFromNode(pc, pk[1], at.result, tpname)
  }
  return 0
}

// A call argument expression's node (unwrapping a named `Arg`), or 0.
function callArgNode(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  if (i >= len(args)) {
    return 0
  }
  let a = args[i]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  return a
}

// The declared type NODE of a call argument: an ident binding's recorded type
// node, or a composite literal's own `Pair<i64>` type. 0 if unknown.
function argTypeNode(c: Checker, argNode: int): int {
  if (argNode == 0) {
    return 0
  }
  let n = getNode(c.tree, argNode)
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        return v
      }
    }
    return 0
  }
  if (n.tag == Tag.CompositeLit) {
    return kidsOf(c.tree, argNode)[0]
  }
  return 0
}

// Binds `tpname` by structurally matching a parameter type NODE against an
// argument type NODE (both AST): a bare `T` binds to the arg node's type; a
// generic instance `Pair<T>` recurses into matching type-arg positions. Node-based
// because a generic-struct instance TYPE does not carry its type-args (carrying
// them would perturb the type-id parity). Returns 0 if unbound.
// `pnode` (the declared parameter) and `anode` (the call's argument) come from
// DIFFERENT trees whenever the generic was imported, so each side carries its
// own checker. Reading one against the other's tree is the whole bug class this
// exists to avoid.
function bindTypeParamNodeVsNode(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (pnode == 0 || anode == 0) {
    return 0
  }
  let pt = getNode(pc.tree, pnode)
  if (pt.tag == Tag.Ident) {
    if (pc.source[pt.span.start:pt.span.end] == tpname) {
      return typeFromNode(ac, anode)
    }
    return 0
  }
  if (pt.tag == Tag.GenericInst && getNode(ac.tree, anode).tag == Tag.GenericInst) {
    let pta = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
    let ata = kidsOf(ac.tree, kidsOf(ac.tree, anode)[1])
    let i = 0
    while (i < len(pta) && i < len(ata)) {
      let b = bindTypeParamNodeVsNode(pc, pta[i], ac, ata[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
  }
  return 0
}

// The concrete type arguments of a generic call's RESULT, when that result is
// written as the generic instance `wantName<...>`: `find<T>(xs: []T, …): Option<T>`
// applied to a `[]i64` yields [i64] for wantName "Option". Empty for anything
// else — a non-generic callee, a result that is not an instance of `wantName`,
// or any argument that does not resolve to a concrete type.
//
// Only the TYPE-based binder runs here, never `bindTypeParamAtCall`: that one
// can reach back into this function through a binding's initializer, and two
// functions with same-named locals (`let v = f(w)` / `let w = g(v)`) would make
// the flat name map a cycle. Type-based binding terminates on the AST alone.
function callResultTypeArgs(c: Checker, callNode: int, wantName: string): []int {
  let out = []int(0)
  let name = typeNodeName(c, kidsOf(c.tree, callNode)[0])
  if (name == "") {
    return out
  }
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return out
  }
  // The decl's nodes index its OWN module's tree (see declOwner); an extern is
  // never generic (SPEC 11.7).
  let oc = declOwner(c, name)
  if (isExternDecl(oc.tree, decl)) {
    return out
  }
  let dk = kidsOf(oc.tree, decl)
  if (dk[2] == 0 || dk[4] == 0) {
    return out
  }
  if (getNode(oc.tree, dk[4]).tag != Tag.GenericInst || typeNodeName(oc, dk[4]) != wantName) {
    return out
  }
  let params = kidsOf(oc.tree, dk[3])
  let tps = kidsOf(oc.tree, dk[2])
  let sub = noSubst()
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let pi = 0
    while (pi < len(params)) {
      let b = bindTypeParamFromNode(oc, kidsOf(oc.tree, params[pi])[1],
        defaultType(c, checkArgType(c, callNode, pi)), tpname)
      if (b != 0) {
        sub.names = append(sub.names, tpname)
        sub.types = append(sub.types, b)
        pi = len(params)
      }
      pi = pi + 1
    }
    ti = ti + 1
  }
  let targs = kidsOf(oc.tree, kidsOf(oc.tree, dk[4])[1])
  let i = 0
  while (i < len(targs)) {
    let a = typeFromNodeIn(oc, targs[i], sub)
    // An unresolved or still-type-param argument is no better than binding
    // nothing; report NOTHING rather than a wrong answer.
    if (a == 0 || c.ctx.types[a].kind == TypeKind.TypeParam) {
      return []int(0)
    }
    out = append(out, a)
    i = i + 1
  }
  return out
}

// Binds `tpname` from a `Name<T>` parameter against an argument that is a local
// with no written type, by re-deriving the type args of the call that
// initialized it (#1498). This is the case `bindTypeParamNodeVsNode` cannot
// reach: it needs the argument's written type node, and `let found = find<i64>(…)`
// has none. Returns 0 unless the initializer's result is an instance of the same
// generic the parameter names.
function bindTypeParamFromInit(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (anode == 0) {
    return 0
  }
  let an = getNode(ac.tree, anode)
  if (an.tag != Tag.Ident) {
    return 0
  }
  let name = ac.source[an.span.start:an.span.end]
  let init = 0
  for (k, v) of ac.declInitNodes {
    if (k == name) {
      init = v
    }
  }
  if (init == 0) {
    return 0
  }
  let args = callResultTypeArgs(ac, init, typeNodeName(pc, pnode))
  let pta = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
  if (len(pta) != len(args)) {
    return 0 // arity disagreement: bind nothing rather than bind by luck
  }
  let i = 0
  while (i < len(pta)) {
    let b = bindTypeParamFromNode(pc, pta[i], args[i], tpname)
    if (b != 0) {
      return b
    }
    i = i + 1
  }
  return 0
}

// Binds `tpname` from the first call parameter whose type mentions it: a
// type-based structural match (`[]T`, `map<K,V>`, `T!`) or, for a generic-instance
// param (`Pair<T>`) whose arg type carries no type-args, a node-vs-node match.
// Returns 0 if no parameter binds it.
// `pc` declares the generic (its tree holds `params`); `ac` is the caller (its
// tree holds `callNode`). They are the same checker for a local generic.
function bindTypeParamAtCall(pc: Checker, ac: Checker, callNode: int, params: []int, tpname: string): int {
  let pi = 0
  while (pi < len(params)) {
    let pnode = kidsOf(pc.tree, params[pi])[1]
    let b = bindTypeParamFromNode(pc, pnode, defaultType(ac, checkArgType(ac, callNode, pi)), tpname)
    if (b == 0 && getNode(pc.tree, pnode).tag == Tag.GenericInst) {
      b = bindTypeParamNodeVsNode(pc, pnode, ac, argTypeNode(ac, callArgNode(ac, callNode, pi)), tpname)
      if (b == 0) {
        b = bindTypeParamFromInit(pc, pnode, ac, callArgNode(ac, callNode, pi), tpname)
      }
    }
    if (b != 0) {
      return b
    }
    pi = pi + 1
  }
  return 0
}

// The concrete type arguments a generic call binds, one per type-parameter, in
// declaration order: each type-param is bound structurally from the first
// parameter whose type mentions it. A type-param bound by no parameter (rare)
// resolves to void.
function genericTypeArgs(c: Checker, name: string, callNode: int): []int {
  let out = []int(0)
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return out
  }
  // The decl's nodes belong to its own module's tree (see declOwner).
  let oc = declOwner(c, name)
  if (isExternDecl(oc.tree, decl)) {
    return out // SPEC 11.7: never generic
  }
  let dk = kidsOf(oc.tree, decl)
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let bound = bindTypeParamAtCall(oc, c, callNode, params, tpname)
    if (bound == 0) {
      bound = c.ctx.voidId
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}

// Whether two type-arg lists are equal.
function typeArgsEqual(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The project-wide index of the (defining module, name, args) instantiation, or
// -1 if not recorded. The index IS the monomorphized suffix, so it must be the
// same number for every module that calls this generic with these arguments.
function instantiationIndexIn(ctx: TypeContext, mod: int, name: string, args: []int): int {
  let i = 0
  while (i < len(ctx.instantiations)) {
    let inst = ctx.instantiations[i]
    if (inst.module == mod && inst.name == name && typeArgsEqual(inst.args, args)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The index of `name`'s (args) instantiation as seen from `c` — resolving where
// the generic is actually declared, so a caller and the definer agree.
function instantiationIndex(c: Checker, name: string, args: []int): int {
  return instantiationIndexIn(c.ctx, declOwner(c, name).moduleId, declName2(c, name), args)
}

// Records a generic-function instantiation the first time its (module, name,
// args) combo is seen, preserving discovery order (the monomorphized index).
function recordInstantiation(c: Checker, name: string, args: []int) {
  if (instantiationIndex(c, name, args) == -1) {
    c.ctx.instantiations = append(c.ctx.instantiations,
      Instantiation{ module: declOwner(c, name).moduleId, name: declName2(c, name), args: args })
  }
}

function isUntyped(c: Checker, t: int): bool {
  return t == c.ctx.untypedIntId || t == c.ctx.untypedFloatId || t == c.ctx.untypedRuneId ||
    t == c.ctx.untypedBoolId || t == c.ctx.untypedStringId || t == c.ctx.untypedNilId
}

// The result type of a binary arithmetic/bitwise operator: an untyped operand
// takes the other's concrete type; matching types stay; otherwise the left one.
function mergeTypes(c: Checker, a: int, b: int): int {
  if (a == b) {
    return a
  }
  if (isUntyped(c, a) && !isUntyped(c, b)) {
    return b
  }
  if (isUntyped(c, b) && !isUntyped(c, a)) {
    return a
  }
  return a
}

function isComparisonOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq) || op == int(Kind.Lt) ||
    op == int(Kind.Gt) || op == int(Kind.LtEq) || op == int(Kind.GtEq) ||
    op == int(Kind.AmpAmp) || op == int(Kind.PipePipe)
}

// The prim-enum index for a predeclared type name, or -1 if not a primitive.
// Includes the size aliases (`int`/`uint`/`byte`/`rune`) that map onto a prim.
function primIndexByName(name: string): int {
  if (name == "i8") { return 0 }
  if (name == "i16") { return 1 }
  if (name == "i32") { return 2 }
  if (name == "i64") { return 3 }
  if (name == "u8") { return 4 }
  if (name == "u16") { return 5 }
  if (name == "u32") { return 6 }
  if (name == "u64") { return 7 }
  if (name == "f32") { return 8 }
  if (name == "f64") { return 9 }
  if (name == "bool") { return 10 }
  if (name == "string") { return 11 }
  if (name == "int") { return 3 }
  if (name == "uint") { return 7 }
  if (name == "byte") { return 4 }
  if (name == "rune") { return 2 }
  return -1
}

// The default concrete type of an untyped value (spec §15.4): int→i64, float→f64,
// rune→i32, bool→bool, string→string; anything else is unchanged.
function defaultType(c: Checker, ty: int): int {
  if (ty == c.ctx.untypedIntId) { return primType(c.ctx, 3) }
  if (ty == c.ctx.untypedFloatId) { return primType(c.ctx, 9) }
  if (ty == c.ctx.untypedRuneId) { return primType(c.ctx, 2) }
  if (ty == c.ctx.untypedBoolId) { return primType(c.ctx, 10) }
  if (ty == c.ctx.untypedStringId) { return primType(c.ctx, 11) }
  return ty
}

// Infers a type-annotation node to a TypeId. Primitives and simple composites
// (slice/array/map/chan) are handled here; named types need resolve and infer
// to invalid (0) for now.
// A type-parameter substitution in force while resolving a type node: `names[i]`
// resolves to `types[i]` rather than to whatever it names in scope. Parallel
// slices, not a map — a generic declares a handful of type params, and a linear
// scan of two beats hashing on typeFromNode's hot path.
struct TypeSubst {
  names: []string,
  types: []int,
}

function noSubst(): TypeSubst {
  return TypeSubst{ names: []string(0), types: []int(0) }
}

// The type bound to `name`, or 0 when `name` is not a substituted type param.
// A type param can never legally bind to type id 0, so 0 is an unambiguous miss.
function substLookup(sub: TypeSubst, name: string): int {
  let i = 0
  while (i < len(sub.names)) {
    if (sub.names[i] == name) {
      return sub.types[i]
    }
    i = i + 1
  }
  return 0
}

function typeFromNode(c: Checker, node: int): int {
  return typeFromNodeIn(c, node, noSubst())
}

// Resolves a type node to a TypeId with `sub`'s type-param bindings applied at
// every depth. `[]T` under {T -> i64} is `[]i64`, and so on through every
// composite — substitution is not a special case of the shape, it is a rule
// about names, so it belongs in the one resolver rather than a parallel walker.
function typeFromNodeIn(c: Checker, node: int, sub: TypeSubst): int {
  if (node == 0) {
    return 0
  }
  let n = getNode(c.tree, node)
  let tag = n.tag
  if (tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    // A bound type param wins outright: it cannot collide with a prim or with
    // `error` (both reserved), so order costs nothing and states the intent.
    let s = substLookup(sub, name)
    if (s != 0) {
      return s
    }
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    // The predeclared `error` interface (§10.6) is a builtin, not a user type.
    if (name == "error") {
      return c.ctx.errorId
    }
    return resolveNamed(c, name)
  }
  let kids = kidsOf(c.tree, node)
  if (tag == Tag.SliceType) {
    return mkSlice(c.ctx, typeFromNodeIn(c, kids[0], sub))
  }
  if (tag == Tag.PtrType) {
    return mkPtr(c.ctx, typeFromNodeIn(c, kids[0], sub))
  }
  if (tag == Tag.ChanType) {
    return mkChan(c.ctx, typeFromNodeIn(c, kids[0], sub))
  }
  if (tag == Tag.MapType) {
    return mkMap(c.ctx, typeFromNodeIn(c, kids[0], sub), typeFromNodeIn(c, kids[1], sub))
  }
  if (tag == Tag.ArrayType) {
    let sn = getNode(c.tree, kids[0])
    return mkArray(c.ctx, parseIntText(c.source[sn.span.start:sn.span.end]),
      typeFromNodeIn(c, kids[1], sub))
  }
  if (tag == Tag.VoidType) {
    return c.ctx.voidId
  }
  // A generic instance `Name<...>` renders by its base name (the seed omits the
  // type arguments in --dump-types), so resolve to the base named type.
  if (tag == Tag.GenericInst) {
    return resolveNamed(c, typeNodeName(c, node))
  }
  // A fallible result `T!` / `T!E` — the error defaults to the `error` interface.
  if (tag == Tag.Fallible) {
    let errT = c.ctx.errorId
    if (kids[1] != 0) {
      errT = typeFromNodeIn(c, kids[1], sub)
    }
    return mkFallible(c.ctx, typeFromNodeIn(c, kids[0], sub), errT)
  }
  // A function type `(P, Q) => R` (func_type `[type_list, result]`).
  // `(A, B, ...)` — the element types in order. Without this a tuple annotation
  // resolved to 0 (unknown), which made every tuple-typed value permissive and
  // silenced the diagnostics that depend on its type (E0041/E0059).
  if (tag == Tag.TupleType) {
    let members = []int(0)
    let mi = 0
    while (mi < len(kids)) {
      members = append(members, typeFromNodeIn(c, kids[mi], sub))
      mi = mi + 1
    }
    return mkTuple(c.ctx, members)
  }
  if (tag == Tag.FuncType) {
    let params = []int(0)
    let plist = kidsOf(c.tree, kids[0])
    let pi = 0
    while (pi < len(plist)) {
      params = append(params, typeFromNodeIn(c, plist[pi], sub))
      pi = pi + 1
    }
    return mkFunc(c.ctx, params, false, typeFromNodeIn(c, kids[1], sub))
  }
  return 0
}

// The value of a digit char in a radix up to 16, or -1 if not a digit (so
// underscores and separators are skipped by the caller).
function digitValue(ch: u8): int {
  if (ch >= '0' && ch <= '9') {
    return int(ch) - 48
  }
  if (ch >= 'a' && ch <= 'f') {
    return int(ch) - 87
  }
  if (ch >= 'A' && ch <= 'F') {
    return int(ch) - 55
  }
  return -1
}

// Parses an integer literal's value, honoring a `0x`/`0b`/`0o` radix prefix and
// skipping `_` separators (§5.4). Used for array sizes and const_int lowering.
function parseIntText(s: string): int {
  let radix = 10
  let start = 0
  if (len(s) >= 2 && s[0] == '0') {
    let c = s[1]
    if (c == 'x' || c == 'X') {
      radix = 16
      start = 2
    } else if (c == 'b' || c == 'B') {
      radix = 2
      start = 2
    } else if (c == 'o' || c == 'O') {
      radix = 8
      start = 2
    }
  }
  let n = 0
  let i = start
  while (i < len(s)) {
    let d = digitValue(s[i])
    if (d >= 0 && d < radix) {
      n = n * radix + d
    }
    i = i + 1
  }
  return n
}

// Register codes for `asm` operands (§11.6). x64 codes are the ModRM register
// number (codegen `Reg` order); arm64 codes are the physical register number
// (`x0`..`x30` = 0..30). 254 is the `memory` clobber sentinel (a barrier only);
// arm64 31 is `sp`/`xzr`. Shared by the type inferencer and lowering so the two
// never disagree. -1 = unknown name.
function asmRegX64(name: string): int {
  if (name == "rax") { return 0 }
  if (name == "rcx") { return 1 }
  if (name == "rdx") { return 2 }
  if (name == "rbx") { return 3 }
  if (name == "rsp") { return 4 }
  if (name == "rbp") { return 5 }
  if (name == "rsi") { return 6 }
  if (name == "rdi") { return 7 }
  if (name == "memory") { return 254 }
  if (len(name) >= 2 && name[0:1] == "r") {
    let num = parseIntText(name[1:len(name)])
    if (num >= 8 && num <= 15) { return num }
  }
  return -1
}

function asmRegArm64(name: string): int {
  if (name == "memory") { return 254 }
  if (name == "sp" || name == "xzr") { return 31 }
  if (len(name) >= 2 && name[0:1] == "x") {
    let num = parseIntText(name[1:len(name)])
    if (num >= 0 && num <= 30) { return num }
  }
  return -1
}

// Inline assembly (§11.6) as an expression: its type is the `result` operand's
// declared type, or `()` when it declares none.
function checkAsm(c: Checker, node: int): int {
  let k = kidsOf(c.tree, node) // [x64_code, arm64_code, result?, clob_x64, clob_arm64, input...]
  if (k[2] != 0) {
    let rk = kidsOf(c.tree, k[2]) // [arm64_reg, x64_reg, type]
    return typeFromNode(c, rk[2])
  }
  return c.ctx.voidId
}

// The code point of a rune literal `'c'` (§5.4): a bare byte/UTF-8 sequence or a
// `\n`/`\x41`/`\u{1F600}`-style escape. Mirrors the seed's parseRuneLiteral.
function parseRuneText(s: string): int {
  if (len(s) < 3) {
    return 0
  }
  let c0 = int(s[1])
  if (s[1] != '\\') {
    // A bare code point: ASCII is one byte; a multi-byte UTF-8 lead byte
    // (110/1110/11110xxxx) is decoded with its continuation bytes.
    if (c0 < 0x80) {
      return c0
    }
    if (c0 >= 0xF0 && len(s) >= 6) {
      return (c0 - 0xF0) * 0x40000 + (int(s[2]) - 0x80) * 0x1000 + (int(s[3]) - 0x80) * 0x40 + (int(s[4]) - 0x80)
    }
    if (c0 >= 0xE0 && len(s) >= 5) {
      return (c0 - 0xE0) * 0x1000 + (int(s[2]) - 0x80) * 0x40 + (int(s[3]) - 0x80)
    }
    if (c0 >= 0xC0 && len(s) >= 4) {
      return (c0 - 0xC0) * 0x40 + (int(s[2]) - 0x80)
    }
    return c0
  }
  let e = s[2]
  if (e == 'n') { return 10 }
  if (e == 'r') { return 13 }
  if (e == 't') { return 9 }
  if (e == '\\') { return 92 }
  if (e == '\'') { return 39 }
  if (e == '"') { return 34 }
  if (e == '0') { return 0 }
  if (e == 'x' && len(s) >= 6) {
    return digitValue(s[3]) * 16 + digitValue(s[4])
  }
  if (e == 'u') {
    // `\u{HEX}`: the hex digits between the braces.
    let n = 0
    let i = 4
    while (i < len(s) && s[i] != '}') {
      let d = digitValue(s[i])
      if (d >= 0) {
        n = n * 16 + d
      }
      i = i + 1
    }
    return n
  }
  return 0
}

// The predeclared builtins that return void `()` (spec §5.3). Their call
// expressions type as the void id regardless of arguments.
function builtinReturnsVoid(name: string): bool {
  return name == "print" || name == "eprint" || name == "panic" || name == "assert" ||
    name == "close" || name == "delete" || name == "atomicStore"
}

// The declared parameter types of a runtime-primitive builtin (the `params` half
// of compiler/check.zig's `prim_sigs`; `builtinResultType` below is the `ret`
// half). Empty for a non-builtin or a nullary one.
//
// `lowerBuiltinCall` materializes each argument at its declared type. Without
// that hint an untyped literal lands at its DEFAULT type and the operand carries
// the wrong width — `float32Bits(4.5)` handing an f64 to a signature that says
// f32, so the narrow read takes the f64's low half, which is zero (#1467).
//
// Kept complete rather than float-only on purpose: a partial table silently
// regresses the moment a primitive gains a narrow parameter. Drift against the
// seed's `prim_sigs` shows up as an IR-dump differential, because a hinted
// literal's const type is in the dump.
function builtinParamTypes(c: Checker, name: string): []int {
  let i64t = primType(c.ctx, 3)
  let strt = primType(c.ctx, 11)
  let boolt = primType(c.ctx, 10)
  let f64t = primType(c.ctx, 9)
  let f32t = primType(c.ctx, 8)
  // Float primitives — the only ones whose parameter differs from the untyped
  // default, and so the only ones where a missing hint is observable today.
  if (name == "float32Bits") { return [f32t] }
  if (name == "fsqrt" || name == "ffloor" || name == "fceil" || name == "fround" ||
    name == "ftrunc" || name == "flog" || name == "flog2" || name == "flog10" ||
    name == "floatBits") {
    return [f64t]
  }
  if (name == "fpow" || name == "fatan2") { return [f64t, f64t] }
  // Filesystem (§14).
  if (name == "fsOpen") { return [strt, boolt] }
  if (name == "fsWrite") { return [i64t, strt] }
  if (name == "fsRead") { return [i64t, i64t] }
  if (name == "fsChmod") { return [strt, i64t] }
  if (name == "fsReadAll" || name == "fsClose" || name == "netLocalPort" ||
    name == "netAccept" || name == "timeSleepNs" || name == "osArgAt" ||
    name == "osExit" || name == "cryptoRandomBytes") {
    return [i64t]
  }
  if (name == "fsAppend" || name == "fsExists" || name == "fsIsDir" ||
    name == "fsMkdir" || name == "fsRemove" || name == "fsListDir" ||
    name == "netResolve" || name == "osEnv" || name == "parseFloat" ||
    name == "osRun") {
    return [strt]
  }
  // Network (§15).
  if (name == "netListen" || name == "netDial" || name == "netUdpBind") { return [strt, i64t] }
  if (name == "netRead" || name == "netUdpRecv") { return [i64t, i64t] }
  if (name == "netWrite") { return [i64t, strt] }
  if (name == "netUdpSend") { return [i64t, strt, i64t, strt] }
  if (name == "osRunTest") { return [strt, i64t] }
  // Nullary: netUdpSenderHost/Port, timeMonoNs, timeUnixNs, osArgc, hostTarget,
  // auxv — and every non-primitive name.
  return []int(0)
}

// The result type of a runtime-primitive builtin (compiler/check.zig `prim_sigs`
// / the ABI runtime surface), or -1 for a non-builtin.
function builtinResultType(c: Checker, name: string): int {
  if (name == "fsReadAll" || name == "fsRead" || name == "fsListDir" ||
    name == "netRead" || name == "netUdpRecv" || name == "netUdpSenderHost" ||
    name == "netResolve" || name == "osArgAt" || name == "osEnv" || name == "osSelfExe" ||
    name == "cryptoRandomBytes") {
    return primType(c.ctx, 11)
  }
  if (name == "fsOpen" || name == "fsWrite" || name == "fsClose" || name == "fsAppend" ||
    name == "fsMkdir" || name == "fsRemove" || name == "netListen" || name == "netLocalPort" ||
    name == "netAccept" || name == "netDial" || name == "netWrite" || name == "netUdpBind" ||
    name == "netUdpSend" || name == "netUdpSenderPort" || name == "timeMonoNs" ||
    name == "timeUnixNs" || name == "osArgc") {
    return primType(c.ctx, 3)
  }
  if (name == "fsExists" || name == "fsIsDir") {
    return primType(c.ctx, 10)
  }
  if (name == "fsqrt" || name == "ffloor" || name == "fceil" || name == "fround" ||
    name == "ftrunc" || name == "fpow" || name == "fatan2" || name == "flog" ||
    name == "flog2" || name == "flog10" || name == "parseFloat") {
    return primType(c.ctx, 9)
  }
  // fsChmod(path: string, mode: i64) -> i64 (0 ok, -1 err).
  if (name == "fsChmod") {
    return primType(c.ctx, 3)
  }
  // osRun(path: string) -> i64 (child exit code, -1 on failure).
  if (name == "osRun") {
    return primType(c.ctx, 3)
  }
  // osRunTest(path: string, idx: i64) -> i64 (child exit code with BIT_TEST_INDEX).
  if (name == "osRunTest") {
    return primType(c.ctx, 3)
  }
  // hostTarget() -> i64 (the host BuildTarget ordinal).
  if (name == "hostTarget") {
    return primType(c.ctx, 3)
  }
  // auxv() -> i64 (this process's ELF auxiliary-vector address, 0 when none).
  if (name == "auxv") {
    return primType(c.ctx, 3)
  }
  // floatBits(v: f64) -> u64, float32Bits(v: f32) -> u32.
  if (name == "floatBits") {
    return primType(c.ctx, 7)
  }
  if (name == "float32Bits") {
    return primType(c.ctx, 6)
  }
  if (name == "timeSleepNs" || name == "osExit" || name == "cryptoSecureZero") {
    return c.ctx.voidId
  }
  return -1
}

// Infers a call expression's result type: a void builtin is `()`; a top-level
// function call is its declared result; `chan<T>(n)`/`map<K,V>{}`-style
// constructors are the constructed type. Unknown callees infer to invalid (0).
function checkCall(c: Checker, node: int): int {
  let callee = kidsOf(c.tree, node)[0]
  let cn = getNode(c.tree, callee)
  if (cn.tag == Tag.Ident) {
    let name = c.source[cn.span.start:cn.span.end]
    // PRECEDENCE: local binding > user declaration > builtin (SPEC 17.5).
    // Matching the callee's SOURCE TEXT against the predeclared names first put
    // every one of them ahead of the user's own declarations, so a program
    // declaring `close`/`osExit`/`print` typed its own call as the builtin's `()`
    // and failed with a spurious E0073 — while `fsClose`/`timeMonoNs` typed
    // wrongly but silently. Shadowing a predeclared name is legal (E0048 is a
    // warning), so these must be consulted BEFORE the cascade below. lowerCall
    // hoists the same two paths in the same order; the two must agree, or the
    // checker and the lowerer disagree about which function is being called.
    // Calling a func-typed value `f(...)` yields the value's result type.
    let ev = envLookup(c, name)
    if (ev != 0 && c.ctx.types[ev].kind == TypeKind.Func) {
      return c.ctx.types[ev].result
    }
    // A generic call `identity(42)` whose result is a bare type parameter binds
    // that parameter from the matching argument's type.
    let g = genericResultAt(c, name, node)
    if (g != -1) {
      return g
    }
    let r = funcResultLookup(c, name)
    if (r != 0) {
      return r
    }
    if (builtinReturnsVoid(name)) {
      return c.ctx.voidId
    }
    // `len`/`cap` always yield i64 regardless of argument.
    if (name == "len" || name == "cap") {
      return primType(c.ctx, 3)
    }
    // `append(slice, ...)` yields the slice's type (its first argument's).
    if (name == "append") {
      return checkArgType(c, node, 0)
    }
    // Atomics (§11.5): the `*T` first argument's element type drives the result.
    // Load and the rmw family return `T`; `atomicCmpxchg` returns `bool`.
    if (name == "atomicLoad" || name == "atomicAdd" || name == "atomicSub" ||
      name == "atomicAnd" || name == "atomicOr" || name == "atomicXchg") {
      return c.ctx.types[checkArgType(c, node, 0)].elem
    }
    if (name == "atomicCmpxchg") {
      return primType(c.ctx, 10)
    }
    // `ptrOf(s: []T): *T` — a raw pointer to the slice's element 0. Module
    // state (§11.11) is also addressable: its cell has a static address, which
    // is the addressability the atomic builtins need. A scalar cell yields
    // `*T`; an array cell yields a pointer to its element 0, like a slice.
    if (name == "ptrOf") {
      let at = checkArgType(c, node, 0)
      if (at != 0 && c.ctx.types[at].kind == TypeKind.Prim) {
        return mkPtr(c.ctx, at)
      }
      return mkPtr(c.ctx, c.ctx.types[at].elem)
    }
    // `entryOf(f): *byte` (§11.10) — a named function's code entry address. The
    // result never depends on the operand: it is one machine address whatever
    // `f`'s signature is, so unlike `ptrOf` there is no argument to inspect.
    // validate.bit is what proves the operand may have an address at all.
    if (name == "entryOf") {
      return mkPtr(c.ctx, primType(c.ctx, 4))
    }
    // `syscall(nr, a0..a5): i64` (§11.8) — variable arity, every operand and
    // the result i64, so the result needs no argument inspection at all.
    if (name == "syscall") {
      return primType(c.ctx, 3)
    }
    // A runtime-primitive builtin (`cryptoRandomBytes`, `fsReadAll`, ...).
    let bt = builtinResultType(c, name)
    if (bt != -1) {
      return bt
    }
    // A primitive name used as a call is a conversion: `f64(x)` -> f64.
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    return 0
  }
  // `chan<T>(n)` / `[]T(n)` / `map<K,V>()` — the callee is a type node, so the
  // result is that type.
  if (cn.tag == Tag.ChanType || cn.tag == Tag.SliceType || cn.tag == Tag.MapType || cn.tag == Tag.ArrayType) {
    return typeFromNode(c, callee)
  }
  if (cn.tag == Tag.Member) {
    // `ns.fn(...)` — the namespace binds the callee under a dotted key, so it
    // resolves through the same two lookups the Ident branch uses.
    let qn = nsQualifiedName(c, callee)
    if (qn != "") {
      let qg = genericResultAt(c, qn, node)
      if (qg != -1) {
        return qg
      }
      return funcResultLookup(c, qn)
    }
    let mk = kidsOf(c.tree, callee)
    // Enum variant constructor `Enum.Variant(...)` / `Enum<T>.Variant(...)`.
    let baseName = typeNodeName(c, mk[0])
    if (baseName != "") {
      let ut = userTypeLookup(c, baseName)
      if (ut != 0 && c.ctx.types[ut].kind == TypeKind.Enum) {
        return ut
      }
    }
    // Method call `recv.method(...)` -> the method's declared result. A
    // constrained type parameter dispatches through its constraint interface.
    let recvType = checkExprType(c, mk[0])
    if (recvType != 0) {
      let mn = getNode(c.tree, mk[1])
      let key = "${methodRecvType(c, recvType)}." + c.source[mn.span.start:mn.span.end]
      let mr = methodResultLookup(c, key)
      if (mr != 0) {
        // A method on a generic type declares its result against the template's
        // bare params (`function (s: Stack<T>) top(): T`), so resolve it to the
        // receiver's concrete type argument — the same substitution a field
        // access needs (SPEC 10.4). A non-type-param result passes through.
        return substFieldType(c, recvType, mr, scrutineeTypeArgs(c, mk[0]))
      }
    }
  }
  // Calling any other FUNC-TYPED VALUE expression: a func-typed field
  // `r.read(4096)` (§9.4), a slice element `fs[0](41)`, a returned function
  // `mk()(41)`. None of the branches above resolve a declaration for these, so
  // the callee's own type IS the signature and the call yields its result.
  // Mirrors the seed's tail in `checkCall`, which types the callee and reads
  // `.func.result` once every declaration-shaped case has been ruled out. The
  // Ident branch returns on every path and so never reaches here, which keeps
  // its local>declaration>builtin precedence (SPEC 17.5) intact.
  let ft = checkExprType(c, callee)
  if (ft != 0 && c.ctx.types[ft].kind == TypeKind.Func) {
    return c.ctx.types[ft].result
  }
  return 0
}

// The inferred type of a call's `i`-th argument (unwrapping the `arg` node).
function checkArgType(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  if (i >= len(args)) {
    return 0
  }
  let a = args[i]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  return checkExprType(c, a)
}

// A receive `<-ch` yields the channel's element type; other unary operators
// (`-`/`+`/`~`) preserve the operand type, and `!` yields its (bool) operand.
function checkUnary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let ot = checkExprType(c, kidsOf(c.tree, node)[0])
  if (n.main == int(Kind.ArrowLeft)) {
    if (ot != 0 && c.ctx.types[ot].kind == TypeKind.Chan) {
      return c.ctx.types[ot].elem
    }
    return 0
  }
  // `*p` (§11.4): load the pointee. Result is the pointer's elem type.
  if (n.main == int(Kind.Star)) {
    if (ot != 0 && c.ctx.types[ot].kind == TypeKind.Ptr) {
      return c.ctx.types[ot].elem
    }
    return 0
  }
  return ot
}

// Arithmetic/bitwise binaries merge their operand types; comparisons and logical
// operators yield an (untyped) boolean.
// The single type an operator's two operands meet at, or `invalid` if they do
// not meet (§14.2). Ported from the seed's `joinOperandTypes`.
//
// An untyped operand takes the other's concrete type — but only if it is
// ASSIGNABLE to it, which is where `1 + 1.5` dies: two untyped constants with
// different default types (i64 vs f64) do not meet, so Bit has no implicit
// int->float widening even between literals. `lty == rty` is answered first, so
// `1 + 1` stays untyped int rather than defaulting early.
function joinOperandTypes(c: Checker, lhs: int, rhs: int, lty: int, rty: int): int {
  if (lty == 0 || rty == 0) { return 0 }
  if (lty == rty) { return lty }
  let lUn = isUntyped(c, lty)
  let rUn = isUntyped(c, rty)
  if (lUn && !rUn) {
    if (vAssignableNode(c, lhs, lty, rty)) { return rty }
    return 0
  }
  if (rUn && !lUn) {
    if (vAssignableNode(c, rhs, rty, lty)) { return lty }
    return 0
  }
  if (lUn && rUn) {
    if (defaultType(c, lty) == defaultType(c, rty)) { return defaultType(c, lty) }
    return 0
  }
  return 0
}

// Is `joined` a legal operand type for an arithmetic (or, with `requireInteger`,
// a bitwise/shift) operator? The seed's `checkNumericBinary` ok-test.
function numericBinaryOk(c: Checker, joined: int, requireInteger: bool): bool {
  if (joined == 0) { return false }
  let k = c.ctx.types[joined].kind
  if (k == TypeKind.Prim) {
    if (requireInteger) { return vPrimIsInt(c.ctx.types[joined].prim) }
    return vPrimIsInt(c.ctx.types[joined].prim) || vPrimIsFloat(c.ctx.types[joined].prim)
  }
  if (k == TypeKind.UntypedInt || k == TypeKind.UntypedRune) { return true }
  if (k == TypeKind.UntypedFloat) { return !requireInteger }
  return false
}

// An integer operand for pointer arithmetic (§11.4): a concrete integer prim or
// an untyped int/rune constant — never a float. Mirrors the seed's helper.
function isIntegerOperand(c: Checker, ty: int): bool {
  if (ty == 0) { return false }
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Prim) { return vPrimIsInt(c.ctx.types[ty].prim) }
  return k == TypeKind.UntypedInt || k == TypeKind.UntypedRune
}

// True for `&`/`|`/`^`/`<<`/`>>` — the operators that demand integers.
function isBitwiseOp(op: int): bool {
  return op == int(Kind.Amp) || op == int(Kind.Pipe) || op == int(Kind.Caret) ||
    op == int(Kind.Shl) || op == int(Kind.Shr)
}

// `ty` is `string` or an untyped string constant — `+` concatenates those.
function stringish(c: Checker, ty: int): bool {
  if (ty == c.ctx.untypedStringId) { return true }
  return ty != 0 && c.ctx.types[ty].kind == TypeKind.Prim && c.ctx.types[ty].prim == 11
}

// Arithmetic/bitwise binaries meet their operand types; comparisons and logical
// operators yield a boolean.
//
// Returns `invalid` when the operands do not admit the operator — that poisoning
// is what stops a cascade: the seed diagnoses `let x = 1 + "a"` once, types `x`
// invalid, and a later `return x` then stays quiet instead of reporting a second,
// derived error.
//
// Emits NOTHING. `checkExprType` is a RECOMPUTE, not a cache — the sweep calls it
// at Binding/Call nodes and validate.bit calls it again per Binary node — so a
// diagnostic here would double-report. `vBinary` owns the E0053.
function checkBinary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let kids = kidsOf(c.tree, node)
  let a = checkExprType(c, kids[0])
  let b = checkExprType(c, kids[1])
  if (a == 0 || b == 0) { return 0 }
  if (isComparisonOp(n.main)) {
    return c.ctx.untypedBoolId
  }
  // `+` over two stringish operands concatenates; everything else is numeric.
  if (n.main == int(Kind.Plus) && stringish(c, a) && stringish(c, b)) {
    return primType(c.ctx, 11)
  }
  // Pointer arithmetic (§11.4): `p + n` / `p - n` advance a `*T` by n*sizeOf(T)
  // and yield a `*T`. Carved out before the numeric path, like the string case.
  if ((n.main == int(Kind.Plus) || n.main == int(Kind.Minus)) &&
      c.ctx.types[a].kind == TypeKind.Ptr && isIntegerOperand(c, b)) {
    return a
  }
  let joined = joinOperandTypes(c, kids[0], kids[1], a, b)
  if (!numericBinaryOk(c, joined, isBitwiseOp(n.main))) {
    return 0
  }
  return joined
}

// The type of an identifier reference from the DECL it resolves to (the
// resolver's `nodeSymbols`), or 0 to let the caller fall back to the flat env.
// This is the flat-env kill: a name is typed by the binding it actually
// resolves to in its scope, never by whatever same-named binding another
// function left in the module-wide env. Returns 0 (fall back) when there is no
// resolved local decl to read a type from — an import, a builtin, a bare
// function value, a not-yet-typed forward reference, or the bare dump entry
// points that never run the resolver (`nodeSymbols` empty). A local decl holds
// its TEMPLATE type inside a generic body, exactly as the env does, so lowering's
// `nodeType` substitution yields the same concrete type on either path.
function declRefType(c: Checker, node: int): int {
  if (node < 0 || node >= len(c.nodeSymbols)) {
    return 0
  }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return 0
  }
  let decl = c.symbols[sid].decl
  if (decl <= 0 || decl >= len(c.declTypes)) {
    return 0
  }
  return c.declTypes[decl]
}

// True when the identifier at `node` names a VALUE BINDING — a local, a param, a
// receiver, or a module const — rather than the free function / builtin of the
// same name. Every "does a local shadow this callee?" guard asks this before
// validating a call against a free function's signature (SPEC §17.5).
//
// The resolver answers it exactly, because it knows scopes. The flat env cannot:
// `envLookup(name) != 0` is true as soon as ANY function in the module binds that
// name, so a single unrelated local anywhere silently disabled the guard's whole
// validation for every call site in the module. That is permissive, so it cost
// diagnostics rather than correctness — but it is a guess where the resolver has
// the fact.
//
// Falls back to the env guess when there is no resolved symbol, which is the
// resolver-less dump entry points (`nodeSymbols` empty) — see declRefType.
function shadowedByValue(c: Checker, node: int, name: string): bool {
  if (node > 0 && node < len(c.nodeSymbols)) {
    let sid = c.nodeSymbols[node]
    if (sid > 0 && sid < len(c.symbols)) {
      let k = c.symbols[sid].kind
      return k == SymbolKind.LetBinding || k == SymbolKind.ConstBinding ||
        k == SymbolKind.Param || k == SymbolKind.Receiver
    }
  }
  return envLookup(c, name) != 0
}

// Infers an expression's (possibly untyped) type. Literals and void-builtin
// calls for now; every other construct infers to invalid (0) until its
// inference lands.
function checkExprType(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.IntLit) { return c.ctx.untypedIntId }
  if (tag == Tag.FloatLit) { return c.ctx.untypedFloatId }
  if (tag == Tag.RuneLit) { return c.ctx.untypedRuneId }
  if (tag == Tag.BoolLit) { return c.ctx.untypedBoolId }
  if (tag == Tag.StringLit || tag == Tag.RawStringLit) { return c.ctx.untypedStringId }
  if (tag == Tag.NilLit) { return c.ctx.untypedNilId }
  // A string interpolation `"...${x}..."` is a concrete string.
  if (tag == Tag.StrInterp) { return primType(c.ctx, 11) }
  if (tag == Tag.Ident) {
    // Type the name from the decl it resolves to (#1370). Falls back to the flat
    // env only when there is no resolved local decl — imports, builtins, forward
    // references, and the resolver-less dump entry points.
    let d = declRefType(c, node)
    if (d != 0) {
      return d
    }
    let sp = getNode(c.tree, node).span
    let name = c.source[sp.start:sp.end]
    let e = envLookup(c, name)
    if (e != 0) {
      return e
    }
    // A bare reference to a top-level function is a first-class func value.
    return funcSigLookup(c, name)
  }
  if (tag == Tag.Unary) { return checkUnary(c, node) }
  if (tag == Tag.Binary) { return checkBinary(c, node) }
  if (tag == Tag.Call) { return checkCall(c, node) }
  if (tag == Tag.SliceLit) { return checkSliceLit(c, node) }
  // A composite literal `Name{...}` / `map<K,V>{...}` / `[]T{...}` has the type
  // of its type node.
  if (tag == Tag.CompositeLit) { return typeFromNode(c, kidsOf(c.tree, node)[0]) }
  if (tag == Tag.Index) { return checkIndex(c, node) }
  if (tag == Tag.TupleIndex) { return checkTupleIndex(c, node) }
  if (tag == Tag.Member) { return checkMember(c, node) }
  // A type assertion `x.(T)` yields the asserted type.
  if (tag == Tag.TypeAssert) { return typeFromNode(c, kidsOf(c.tree, node)[1]) }
  // A match expression's type is its arms' body type (all arms agree).
  if (tag == Tag.MatchStmt) { return checkMatch(c, node) }
  // Inline assembly (§11.6) yields its `result` operand's type, or `()` when it
  // declares none. Register/payload validation is the validator's job (#1374).
  if (tag == Tag.AsmStmt) { return checkAsm(c, node) }
  if (tag == Tag.SliceExpr) { return checkSliceExpr(c, node) }
  if (tag == Tag.ArrowFn) { return checkArrowFn(c, node) }
  // `e?` / `e catch d` / `e catch x { … }` all unwrap the operand's fallible
  // type `T!` to its success type `T`.
  if (tag == Tag.TryExpr || tag == Tag.CatchDefault || tag == Tag.CatchBind) {
    return unwrapFallible(c, checkExprType(c, kidsOf(c.tree, node)[0]))
  }
  return 0
}

// The success type of a fallible `T!`, or the type unchanged if not fallible.
function unwrapFallible(c: Checker, t: int): int {
  if (t != 0 && c.ctx.types[t].kind == TypeKind.Fallible) {
    return c.ctx.types[t].result
  }
  return t
}

// The result an arrow is written AGAINST, if the source supplied one — see
// `Checker.arrowExpected`. 0 when there is no expectation to honour.
//
// Two callers, one rule: `checkArrowFn` types the arrow with it, and the
// validator judges the body's `return`s against it (#1522). It is deliberately
// the EXPECTED result and not the arrow's final one — an arrow with no
// expectation INFERS its result from the first `return` (#1488), and checking
// the later `return`s against an inference drawn from the first is a rule the
// seed does not have (its `inner_fctx.result_ty` is `expected_result`, left
// `.invalid` when absent).
function arrowExpectedResult(c: Checker, node: int): int {
  let (et, ok) = c.arrowExpected[node]
  if (ok && et != 0 && c.ctx.types[et].kind == TypeKind.Func) {
    return c.ctx.types[et].result
  }
  return 0
}

// A closure `(x: T, ...) => body` has function type `(T, ...) => R`, R the
// (defaulted) type of its body. ponytail: annotated params only — an untyped
// param is left at 0 and recovered by lowering.
function checkArrowFn(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let params = []int(0)
  let ps = kidsOf(c.tree, kids[0])
  let i = 0
  while (i < len(ps)) {
    let pk = kidsOf(c.tree, ps[i])
    let pt = 0
    if (pk[1] != 0) {
      pt = typeFromNode(c, pk[1])
    }
    params = append(params, pt)
    i = i + 1
  }
  let want = arrowExpectedResult(c, node)
  // A `=> { … }` body returns explicitly (SPEC 12.8), so its result comes from
  // the expectation if there is one and from the first `return` otherwise
  // (#1488) — falling through to `()` typed `(x: f32) => { return 4.5 }` as
  // returning nothing, and every use of its value then failed against '()'.
  if (getNode(c.tree, kids[1]).tag == Tag.Block) {
    let br = want
    if (br == 0) {
      br = arrowBlockResult(c, kids[1])
    }
    if (br == 0) {
      br = c.ctx.voidId
    }
    return mkFunc(c.ctx, params, false, br)
  }
  let bt = checkExprType(c, kids[1])
  // An UNTYPED constant body takes the expected result as the arrow's own
  // (#1487): `(x: f32) => 4.5` otherwise interned as `(f32) => f64` and failed
  // E0041 against the very `(f32) => f32` that supplied the expectation.
  //
  // Two guards keep this from SWALLOWING a real error. The body must be untyped
  // — a body with a type of its own keeps it — and it must be assignable to the
  // expected result, which is the same question the seed's `expect` asks at the
  // body. Without the second guard `(x: f32) => 4.5` against `(f32) => i32`
  // adopted i32, the arrow matched, and the seed's E0041 went missing.
  if (want != 0 && defaultType(c, bt) != bt && vAssignableNode(c, kids[1], bt, want)) {
    return mkFunc(c.ctx, params, false, want)
  }
  // Otherwise the body's type must be DEFAULTED before it becomes the
  // function's result (#1472): an untyped constant is not a storable type, and
  // leaving one here makes the call site and the callee disagree about the
  // return's ABI slot — `(x: f32) => 4.5` then printed 4.5 while comparing
  // unequal to 4.5.
  return mkFunc(c.ctx, params, false, defaultType(c, bt))
}

// The result type a `=> { … }` arrow infers when no expected function type
// supplies one: the DEFAULTED type of the first `return <expr>` in the body, or
// 0 when the body returns nothing. A nested arrow's `return`s belong to that
// arrow, so its subtree is skipped. Mirrors the seed's `arrowBlockResult`.
function arrowBlockResult(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.ArrowFn) {
    return 0
  }
  if (tag == Tag.ReturnStmt) {
    let rk = kidsOf(c.tree, node)
    if (len(rk) != 1) {
      return 0 // a bare `return`, or a multi-value tuple result
    }
    return defaultType(c, checkExprType(c, rk[0]))
  }
  let kids = kidsOf(c.tree, node)
  let i = 0
  while (i < len(kids)) {
    let t = arrowBlockResult(c, kids[i])
    if (t != 0) {
      return t
    }
    i = i + 1
  }
  return 0
}

// `let f: (i32) => i32 = (x) => …` — the annotation is the initializer's
// expected type. Only an ArrowFn initializer is recorded; nothing else reads
// the table.
function seedArrowExpectedBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pattern, type_or_none, init_or_none]
  if (kids[1] == 0 || kids[2] == 0) {
    return
  }
  if (getNode(c.tree, kids[2]).tag != Tag.ArrowFn) {
    return
  }
  let ty = typeFromNode(c, kids[1])
  if (ty != 0 && c.ctx.types[ty].kind == TypeKind.Func) {
    c.arrowExpected[kids[2]] = ty
  }
}

// `apply((x: f32) => 4.5)` — the matching parameter's declared type is the
// argument's expected type.
//
// Resolution is vCall's, guard for guard: a bare-ident callee that no local
// shadows, naming a known non-generic free function whose arity matches. Every
// undecidable shape (method, value call, builtin, generic, variadic, spread)
// records nothing and leaves the arrow inferred exactly as before, which is
// what keeps a wrong expectation — the only way this could manufacture a
// diagnostic the seed does not have — out of reach.
function seedArrowExpectedCall(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let args = kidsOf(c.tree, kids[2])
  if (!hasArrowArg(c, args)) {
    return
  }
  let cn = getNode(c.tree, kids[0])
  if (cn.tag != Tag.Ident) {
    return
  }
  let name = c.source[cn.span.start:cn.span.end]
  if (shadowedByValue(c, kids[0], name)) {
    return // a local value shadows the free function
  }
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return
  }
  let owner = declOwner(c, name)
  let plist = declParamListNode(owner, decl)
  if (plist < 0) {
    return // generic: the parameter type is not known until instantiation
  }
  let params = kidsOf(owner.tree, plist)
  if (len(params) != len(args)) {
    return // variadic, spread, or an arity error: which parameter is undecided
  }
  let i = 0
  while (i < len(args)) {
    let a = argInner(c, args[i])
    if (getNode(c.tree, a).tag == Tag.ArrowFn) {
      let pty = typeFromNode(owner, kidsOf(owner.tree, params[i])[1])
      if (pty != 0 && c.ctx.types[pty].kind == TypeKind.Func) {
        c.arrowExpected[a] = pty
      }
    }
    i = i + 1
  }
}

// The expression an argument node wraps, unwrapping the `Arg` shell.
function argInner(c: Checker, arg: int): int {
  if (getNode(c.tree, arg).tag == Tag.Arg) {
    return kidsOf(c.tree, arg)[0]
  }
  return arg
}

// Whether any argument is an arrow literal — the cheap guard that keeps the
// seeding pass off every call in the program.
function hasArrowArg(c: Checker, args: []int): bool {
  let i = 0
  while (i < len(args)) {
    if (getNode(c.tree, argInner(c, args[i])).tag == Tag.ArrowFn) {
      return true
    }
    i = i + 1
  }
  return false
}

// `a[i:j]` preserves a slice/string type; slicing an array yields a slice of its
// element.
function checkSliceExpr(c: Checker, node: int): int {
  let rt = checkExprType(c, kidsOf(c.tree, node)[0])
  if (rt == 0) {
    return 0
  }
  let t = c.ctx.types[rt]
  if (t.kind == TypeKind.Slice) {
    return rt
  }
  if (t.kind == TypeKind.Array) {
    return mkSlice(c.ctx, t.elem)
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return rt
  }
  return 0
}

// Binds a for-of / match-arm / catch / comma-ok binder. The type is recorded on
// the binder's own NODE (`declTypes`) as well as in the flat env, so a reference
// that resolves to this binder (nodeSymbols -> Symbol.decl -> declTypes) is typed
// by THIS binder and not by whatever same-named binding another function left in
// the module-wide env — see `declRefType`.
//
// This was a separate `binderTypes` table until #1502, kept out of `declTypes`
// because a binder is typed at pre-pass 3, BEFORE its iterable local is typed, so
// the value is best-effort and lowering recomputes the real element type per
// scope/instance. That is still true — lowering now rewrites `declTypes` at the
// same binder node wherever it rewrites `env` (see lower.bit's binder sites), so
// the corrected type wins on the decl path exactly as it does on the env path,
// and one table serves both.
function envBind(c: Checker, identNode: int, ty: int) {
  let n = getNode(c.tree, identNode)
  c.env[c.source[n.span.start:n.span.end]] = ty
  c.declTypes[identNode] = ty
}

// The element type yielded by iterating a value: a slice/array element, or a
// rune (i32) for a string. ponytail: rune-iteration is a guess — for-of binders
// are typed for env resolution only, never dumped, so a wrong string element
// cannot diverge the output unless the binder feeds a dumped call.
function elementType(c: Checker, iterT: int): int {
  if (iterT == 0) {
    return 0
  }
  let t = c.ctx.types[iterT]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
    return t.elem
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return primType(c.ctx, 2)
  }
  return 0
}

// Types a `for x of it` / `for (k, v) of it` loop binder into env so the loop
// body resolves it. A tuple binder over a map yields (key, value); over a
// slice/array it yields (index i64, element).
function typeForOfBinder(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let binder = kids[0]
  let iterT = checkExprType(c, kids[1])
  if (getNode(c.tree, binder).tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, binder)
    if (len(subs) == 2 && iterT != 0) {
      let t = c.ctx.types[iterT]
      if (t.kind == TypeKind.Map) {
        envBind(c, subs[0], t.mapKey)
        envBind(c, subs[1], t.mapVal)
      } else if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
        envBind(c, subs[0], primType(c.ctx, 3))
        envBind(c, subs[1], t.elem)
      }
    }
    return
  }
  envBind(c, binder, elementType(c, iterT))
}

// Types a `match (subject) { V(a, b) => … }`'s arm payload binders (§13.8).
//
// The checker never knew `Tag.VariantPat` existed. Lowering bound these itself
// (`bindArmPayload`) and patched `c.env` as it went, so codegen was correct while
// the checker's own view of an arm body was whatever ELSE in the module last
// bound that name — `Text(s) => return s` typed `s` as another function's
// `s: Shape`. Nothing consumed those types, so nothing noticed.
//
// Called from pre-pass 3, not the main sweep: a MatchStmt node sits AFTER its arm
// bodies in arena order, exactly like a for-of header, so the type is only
// knowable here. `envBind` records each binder on its NODE, and a binder precedes
// its own arm body, so the sweep re-applies it in time and no other function's
// names can reach it (see `Checker.binderTypes`).
//
// The payload resolution itself is lowering's, reused verbatim: those helpers
// take a `Checker` and answer a purely type-level question — they live in
// lower.bit only because lowering needed them first.
function typeMatchBinders(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [subject, arm_list]
  let subjectTy = defaultType(c, checkExprType(c, k[0]))
  if (subjectTy == 0 || c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    return
  }
  // A generic enum's payloads are bare type params; resolve them against the
  // scrutinee's concrete arguments (`Opt<i64>.Some(v)` binds `v` at i64).
  let typeArgs = scrutineeTypeArgs(c, k[0])
  for arm of kidsOf(c.tree, k[1]) {
    let pat = kidsOf(c.tree, arm)[0]
    if (getNode(c.tree, pat).tag != Tag.VariantPat) {
      continue
    }
    let vp = kidsOf(c.tree, pat) // [name, binders]
    if (vp[1] == 0) {
      continue
    }
    let vn = getNode(c.tree, vp[0])
    let ptypes = variantPayloadTypes(c, subjectTy, c.source[vn.span.start:vn.span.end])
    let binders = kidsOf(c.tree, vp[1])
    let i = 0
    while (i < len(binders) && i < len(ptypes)) {
      envBind(c, binders[i], substPayloadType(c, subjectTy, ptypes[i], typeArgs))
      i = i + 1
    }
  }
}

// A match expression yields the type of its (first) arm's body.
function checkMatch(c: Checker, node: int): int {
  let arms = kidsOf(c.tree, kidsOf(c.tree, node)[1])
  if (len(arms) == 0) {
    return 0
  }
  return checkExprType(c, kidsOf(c.tree, arms[0])[1])
}

// `a[i]` yields the element/value type: slice/array element, map value, or a
// byte (u8) for a string.
function checkIndex(c: Checker, node: int): int {
  let rt = checkExprType(c, kidsOf(c.tree, node)[0])
  if (rt == 0) {
    return 0
  }
  let t = c.ctx.types[rt]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
    return t.elem
  }
  if (t.kind == TypeKind.Map) {
    return t.mapVal
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return primType(c.ctx, 4)
  }
  return 0
}

// `t.N` yields the N-th element type of a tuple. An out-of-range index or a
// non-tuple receiver is the validator's business (E0059/E0054); here they simply
// yield 0 (unknown), which keeps every downstream check permissive.
function checkTupleIndex(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let rt = checkExprType(c, kids[0])
  if (rt == 0) {
    return 0
  }
  let t = c.ctx.types[rt]
  if (t.kind != TypeKind.Tuple) {
    return 0
  }
  let n = getNode(c.tree, kids[1])
  let i = parseIntText(c.source[n.span.start:n.span.end])
  if (i < 0 || i >= len(t.members)) {
    return 0
  }
  return t.members[i]
}

// The index of a type-param name in a generic struct's `<...>` list, or -1.
// Mirrors enumTypeParamIndex; reads the struct decl's generic list (kid 1).
function structTypeParamIndex(c: Checker, structTy: int, tpname: string): int {
  let oc = typeOwner(c, structTy)
  let decl = structDeclOf(c, structTy)
  if (decl == 0) {
    return -1
  }
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  let i = 0
  while (i < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[i])[0])
    if (oc.source[tpn.span.start:tpn.span.end] == tpname) {
      return i
    }
    i = i + 1
  }
  return -1
}

// How many type params a generic struct declares, or 0 when `structTy` is not a
// struct or is not generic. The count `structTypeParamIndex` searches within.
function structTypeParamCount(c: Checker, structTy: int): int {
  let oc = typeOwner(c, structTy)
  let decl = structDeclOf(c, structTy)
  if (decl == 0) {
    return 0
  }
  let gen = kidsOf(oc.tree, decl)[1]
  if (gen == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, gen))
}

// Substitutes a struct field's bare type param with the receiver's concrete type
// argument: `val: T` of a `Box<i64>` value resolves to i64 via the struct's
// type-param index. Non-type-param fields (and an unrecoverable arg list, e.g.
// an inferred `let p = make(7)`) pass through unchanged.
function substFieldType(c: Checker, structTy: int, ty: int, typeArgs: []int): int {
  if (ty == 0 || c.ctx.types[ty].kind != TypeKind.TypeParam) {
    return ty
  }
  let idx = structTypeParamIndex(c, structTy, c.ctx.types[ty].name)
  if (idx >= 0 && idx < len(typeArgs)) {
    return typeArgs[idx]
  }
  return ty
}

function checkMember(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let recv = kids[0]
  // Enum-variant access `Enum.Variant` / `Enum<T>.Variant` -> the enum type.
  let baseName = typeNodeName(c, recv)
  if (baseName != "") {
    let ut = userTypeLookup(c, baseName)
    if (ut != 0 && c.ctx.types[ut].kind == TypeKind.Enum) {
      return ut
    }
  }
  // `ns.member` — an exported const, module state or function of the namespaced
  // module, bound under the dotted key. Consulted before the receiver is typed:
  // a namespace alias is not a value and has no type of its own.
  let qn = nsQualifiedName(c, node)
  if (qn != "") {
    let qe = envLookup(c, qn)
    if (qe != 0) {
      return qe
    }
    return funcSigLookup(c, qn)
  }
  let rt = checkExprType(c, recv)
  if (rt != 0) {
    let mn = getNode(c.tree, kids[1])
    let mname = c.source[mn.span.start:mn.span.end]
    let recvKey = "${methodRecvType(c, rt)}"
    // Struct field access `value.field`. A generic struct's field is stored
    // against the template (`Box.val` -> the bare param `T`); substitute the
    // receiver's concrete type argument so `p.val` on a `Box<i64>` is i64.
    if (c.ctx.types[rt].kind == TypeKind.Struct) {
      let ft = structFieldLookup(c, recvKey + "." + mname)
      if (ft != 0) {
        return substFieldType(c, rt, ft, scrutineeTypeArgs(c, recv))
      }
    }
    // An uncalled method value `value.method` -> the method's func type.
    return methodSigLookup(c, recvKey + "." + mname)
  }
  return 0
}

// Registers a struct/enum/interface declaration as a named type so references
// to it resolve. Called in a pre-pass (types may be referenced before their
// declaration, §9).
// Mints a named type (struct / enum / interface). Records the declaring module:
// fields, variants and payloads are all read back from the decl node later, and
// only this module's tree can be indexed by it (see typeOwner).
function registerNamedType(c: Checker, name: string, kind: TypeKind) {
  let t = leafType(kind)
  t.name = name
  t.hasName = true
  t.declModule = c.moduleId
  c.userTypes[name] = addType(c.ctx, t)
}

// The source text of a declaration's name (kid 0 is the name leaf).
function declName(c: Checker, node: int): string {
  let nm = getNode(c.tree, kidsOf(c.tree, node)[0])
  return c.source[nm.span.start:nm.span.end]
}

// An untyped slice literal `[a, b, ...]` is `[]E`, E the (defaulted) type of its
// first element. ponytail: first element only — a heterogeneous literal would
// need element unification, which the checker rejects anyway.
function checkSliceLit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0) {
    return 0
  }
  let first = kids[0]
  if (getNode(c.tree, first).tag == Tag.Arg) {
    first = kidsOf(c.tree, first)[0]
  }
  return mkSlice(c.ctx, defaultType(c, checkExprType(c, first)))
}

// Types each binder of a tuple pattern against the corresponding element of
// `tupTy`, recursing into nested patterns (SPEC §10.1). When the type is unknown
// or the arity disagrees the binders are left untyped rather than given a made-up
// type: an inferencer that guesses here turns a checker gap into a wrong answer,
// and the validator reports the mismatch on its own terms.
function checkTupleBinders(c: Checker, binders: []int, tupTy: int) {
  if (tupTy == 0 || c.ctx.types[tupTy].kind != TypeKind.Tuple) {
    return
  }
  let members = c.ctx.types[tupTy].members
  if (len(members) != len(binders)) {
    return
  }
  let i = 0
  while (i < len(binders)) {
    if (getNode(c.tree, binders[i]).tag == Tag.TuplePat) {
      checkTupleBinders(c, kidsOf(c.tree, binders[i]), members[i])
    } else {
      c.nodeTypes[binders[i]] = members[i]
      envBind(c, binders[i], members[i])
    }
    i = i + 1
  }
}

// Types one `binding` node whose pattern is a tuple: either a two-result
// comma-ok form (`<-ch` / `m[k]` / `x.(T)`, where the value binder gets the
// received/indexed/asserted element and the `ok` binder a bool), or the general
// positional destructure of a tuple-typed initializer.
function checkCommaOk(c: Checker, pat: int, init: int) {
  let binders = kidsOf(c.tree, pat)
  if (init == 0) {
    return
  }
  let inNode = getNode(c.tree, init)
  let valType = 0
  let isTwoResult = false
  if (len(binders) == 2) {
    if (inNode.tag == Tag.Unary && inNode.main == int(Kind.ArrowLeft)) {
      let chT = checkExprType(c, kidsOf(c.tree, init)[0])
      if (chT != 0 && c.ctx.types[chT].kind == TypeKind.Chan) {
        valType = c.ctx.types[chT].elem
      }
      isTwoResult = true
    } else if (inNode.tag == Tag.Index) {
      // Only a MAP index is a two-result form. Indexing a slice of tuples is an
      // ordinary one-result read that happens to yield a tuple, and must fall
      // through to the tuple path below.
      let recvT = checkExprType(c, kidsOf(c.tree, init)[0])
      if (recvT != 0 && c.ctx.types[recvT].kind == TypeKind.Map) {
        valType = checkIndex(c, init)
        isTwoResult = true
      }
    } else if (inNode.tag == Tag.TypeAssert) {
      // `let (v, ok) = x.(T)` narrows to T with a success flag.
      valType = typeFromNode(c, kidsOf(c.tree, init)[1])
      isTwoResult = true
    }
  }
  // `let (a, b, ...) = <tuple>` (SPEC §10.1/§13.1) — bind each element to its own
  // declared type. Before this, ANY non-comma-ok initializer fell through with
  // `valType` still 0 and the second binder typed `bool` REGARDLESS, so a tuple
  // destructure silently bound a bool-typed name over a real element and the
  // wrong value was read back with no diagnostic anywhere.
  if (!isTwoResult) {
    checkTupleBinders(c, binders, checkExprType(c, init))
    return
  }
  c.nodeTypes[binders[0]] = valType
  c.nodeTypes[binders[1]] = primType(c.ctx, 10)
  // BIND them, not just type them. Recording `nodeTypes` feeds `--dump-types`,
  // but every expression that READS a name resolves through `env` — so without
  // this, `let (c, ok) = <- ch` left `c` typed by whatever else in the module
  // last bound that name (in stdlib/quic: a `c: quicconnCmd` param 1600 lines
  // up, making `return c` from a `StreamChunk!` method look like a mismatch).
  // Same omission the for-of and match-arm binders had; `envBind` also records
  // `binderTypes`, so the sweep re-applies each at its own node — which precedes
  // the body that reads it.
  envBind(c, binders[0], valType)
  envBind(c, binders[1], primType(c.ctx, 10))
}

// True iff `binding` is a module-level `let` binding (§11.11) — a static cell
// — as opposed to any local `let`, which is an ordinary SSA value. Both carry
// SymbolKind.LetBinding; only the resolver's `moduleScoped` separates them.
function isModuleStateBinding(c: Checker, binding: int): bool {
  let pat = kidsOf(c.tree, binding)[0]
  if (pat >= 0 && pat < len(c.nodeSymbols)) {
    let sid = c.nodeSymbols[pat]
    if (sid > 0 && sid < len(c.symbols)) {
      let sym = c.symbols[sid]
      return sym.kind == SymbolKind.LetBinding && sym.moduleScoped
    }
  }
  // The dump entry points (`--dump-ir`, `--dump-types`) never run the resolver,
  // so `nodeSymbols` is empty there — see declRefType's note. Fall back to the
  // structural fact the resolver would have recorded: a module-level `let` is a
  // binding of a LetDecl that is a DIRECT child of the tree root. Any deeper
  // LetDecl is a local.
  return isTopLevelLetBinding(c, binding)
}

// True iff `binding` belongs to a `let` declared at module scope, determined
// structurally rather than through the resolver. Bounded by the top-level decl
// count.
// A binding of ANY module-level declaration — `let` (§11.11 module state) or
// `const`. isTopLevelLetBinding answers only the `let` half because module state
// is what it exists to identify; this is the one to ask when the question is
// merely "is this binding outside every function body", which is what decides
// whether the statement sweep will ever reach it.
function isTopLevelBinding(c: Checker, binding: int): bool {
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(c.tree, inner).tag == Tag.Export) {
      inner = kidsOf(c.tree, inner)[0]
    }
    let dt = getNode(c.tree, inner).tag
    if (dt != Tag.LetDecl && dt != Tag.ConstDecl) {
      continue
    }
    for b of kidsOf(c.tree, inner) {
      if (b == binding) {
        return true
      }
    }
  }
  return false
}

function isTopLevelLetBinding(c: Checker, binding: int): bool {
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0) {
      continue
    }
    let inner = d
    if (getNode(c.tree, inner).tag == Tag.Export) {
      inner = kidsOf(c.tree, inner)[0]
    }
    if (getNode(c.tree, inner).tag != Tag.LetDecl) {
      continue
    }
    for b of kidsOf(c.tree, inner) {
      if (b == binding) {
        return true
      }
    }
  }
  return false
}

function checkBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  let ann = kids[1]
  let init = kids[2]
  if (getNode(c.tree, pat).tag == Tag.TuplePat) {
    checkCommaOk(c, pat, init)
    return
  }
  let ty = 0
  if (ann != 0) {
    ty = typeFromNode(c, ann)
  } else if (init != 0) {
    ty = defaultType(c, checkExprType(c, init))
  }
  c.nodeTypes[pat] = ty
  // Record a simple-ident binding so later expressions resolve it.
  let pn = getNode(c.tree, pat)
  if (pn.tag == Tag.Ident) {
    let bname = c.source[pn.span.start:pn.span.end]
    c.env[bname] = ty
    if (isTopLevelBinding(c, node)) {
      c.moduleEnv[bname] = ty
    }
    c.declTypes[pat] = ty
    // Record the binding's declared type NODE (annotation, or a composite
    // literal's `Pair<i64>` type) so a generic call passing this binding can
    // recover its type-args (`firstOf(p)` binds T from p's `Pair<i64>`).
    let tnode = ann
    if (tnode == 0 && init != 0 && getNode(c.tree, init).tag == Tag.CompositeLit) {
      tnode = kidsOf(c.tree, init)[0]
    }
    if (tnode != 0) {
      c.declTypeNodes[bname] = tnode
    }
    // No written type: remember the initializing CALL so a later generic call
    // taking this binding can re-derive the instance type-args it needs (#1498).
    if (tnode == 0 && init != 0 && getNode(c.tree, init).tag == Tag.Call) {
      c.declInitNodes[bname] = init
    }
  }
}

// Pre-seeds a simple `let x = …` binding's type into `declTypes` — the decl-path
// (#1370) — during pre-pass 3, so a for-of / match binder typed in that same pass
// resolves its ITERABLE through the binding it actually refers to.
//
// Without this the iterable was unknowable at pre-pass 3 (bindings are typed in
// the main sweep, which runs later), so `checkExprType` fell through to the
// module-wide flat `env` and read whatever same-named binding another function
// had left there. The binder then got element type 0 — which ALSO suppressed the
// main sweep's `binderTypes` rebind, leaving the binder NAME resolving to an
// unrelated function's local. In stdlib/crypto that is #1375: `blocks` is
// `[]byte` in gcm.bit and `[]PemBlock` in truststore.bit, so `for b of blocks`
// typed `b` as u8 and every `b.label` looked like an unknown member.
//
// Only `declTypes` is written — never `env` or `nodeTypes` — so this is a
// resolution input, not an inference result. The main sweep's `checkBinding`
// overwrites the same slot with the authoritative value, so a best-effort miss
// here (an initializer not yet typeable) costs nothing.
//
// A type-param-bearing result is dropped rather than recorded: generic argument
// binding is not resolvable this early (`declTypeNodes` is filled by the main
// sweep), so `let evens = keep<i64>(squares, …)` reads back as the TEMPLATE
// `[]U`. Recording that would freeze a bogus binder type into `binderTypes`,
// which the main sweep re-applies — and the main sweep cannot undo it. Leaving
// the slot at 0 keeps the binder merely unknown, which every validator already
// treats permissively. Seed only what is confidently concrete.
function seedBindingDeclType(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  if (getNode(c.tree, pat).tag != Tag.Ident) {
    return
  }
  let ty = 0
  if (kids[1] != 0) {
    ty = typeFromNode(c, kids[1])
  } else if (kids[2] != 0) {
    ty = defaultType(c, checkExprType(c, kids[2]))
  }
  if (ty == 0 || vHasTypeParam(c, ty, 0) || vMentionsInvalid(c, ty, 0)) {
    return
  }
  c.declTypes[pat] = ty
}

// Walks every node and types the bindings. (arrow-param and call typing land
// with expression inference; a flat arena walk catches bindings at any nesting.)
// Resolves a named-type reference, reserving+resolving it on first touch if it
// is a not-yet-seen forward reference (the seed's declTypeOf recursion). After
// the collect pass every named type is reserved, so this is a plain lookup.
function resolveNamed(c: Checker, name: string): int {
  let id = userTypeLookup(c, name)
  if (id != 0) {
    return id
  }
  if (c.typeDecls[name] != 0) {
    return declTypeOf(c, name)
  }
  return 0
}

// Registers a `<T, U: Bound>` list: every param name first (each a distinct
// named TypeParam), then each constraint interface — matching the seed's
// buildOwnGenericEnv two-loop order so ids line up.
function registerGenerics(c: Checker, genNode: int) {
  if (genNode == 0) {
    return
  }
  let ps = kidsOf(c.tree, genNode)
  let ids = []int(0)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    // Each decl's type params are distinct ids (the seed's per-symbol
    // typeParamId), even when two decls share a param name — reusing an id would
    // undercount and shift a later named type. userTypes[name] is overwritten to
    // this decl's param, which is correct: members resolve against the decl being
    // built, and a template body's param id never reaches a dump (monomorphized).
    let pname = c.source[nm.span.start:nm.span.end]
    registerNamedType(c, pname, TypeKind.TypeParam)
    // Keep THIS decl's ids: the next generic to declare a `T` overwrites
    // userTypes["T"], and monomorphizing this one then needs the id its body was
    // actually checked against.
    ids = append(ids, userTypeLookup(c, pname))
    i = i + 1
  }
  c.genericParamIds[genNode] = ids
  i = 0
  while (i < len(ps)) {
    let gk = kidsOf(c.tree, ps[i])
    if (gk[1] != 0) {
      let cons = kidsOf(c.tree, gk[1])
      if (len(cons) > 0) {
        let nm = getNode(c.tree, gk[0])
        c.typeParamConstraints[c.source[nm.span.start:nm.span.end]] = typeFromNode(c, cons[0])
      }
    }
    i = i + 1
  }
}

// Resolves a struct's field types into `structFields` (interning each in field
// order). An exported field is wrapped `export[field[name, type]]`.
function resolveStructFields(c: Checker, node: int, sname: string) {
  let fields = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let fi = 0
  while (fi < len(fields)) {
    let fld = fields[fi]
    if (getNode(c.tree, fld).tag == Tag.Export) {
      fld = kidsOf(c.tree, fld)[0]
    }
    let fk = kidsOf(c.tree, fld)
    let fnn = getNode(c.tree, fk[0])
    c.ctx.structFields["${userTypeLookup(c, sname)}." + c.source[fnn.span.start:fnn.span.end]] = typeFromNode(c, fk[1])
    fi = fi + 1
  }
}

// Interns an enum's variant payload types (in variant then payload order) for
// their id side effects — matching the seed's buildEnumTemplate — and records on
// the type whether any variant carries a payload (so the value is boxed), which
// codegen reads to classify GC references. Variant info itself is read back from
// the decl node — see registerNamedType, which records the module that node
// indexes into so an importer can find the right tree.
function resolveEnumPayloads(c: Checker, node: int, enumTy: int) {
  let vs = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let i = 0
  while (i < len(vs)) {
    let payload = kidsOf(c.tree, vs[i])[1]
    if (payload != 0) {
      c.ctx.types[enumTy].enumBoxed = true
      let types = kidsOf(c.tree, payload)
      let j = 0
      while (j < len(types)) {
        typeFromNode(c, types[j])
        j = j + 1
      }
    }
    i = i + 1
  }
}

// Resolves an interface's method results into methodResults, interning each
// sig's params (source order) then result — the seed's walk. The func-type sig
// wrapper is deferred to buildSignatures (see collectFuncDecl).
function resolveInterfaceSigs(c: Checker, node: int, iname: string) {
  let sigs = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let mi = 0
  while (mi < len(sigs)) {
    let mk = kidsOf(c.tree, sigs[mi])
    let mnn = getNode(c.tree, mk[0])
    paramTypeIds(c, mk[1])
    let mres = c.ctx.voidId
    if (mk[2] != 0) {
      mres = typeFromNode(c, mk[2])
    }
    c.ctx.methodResults["${userTypeLookup(c, iname)}." + c.source[mnn.span.start:mnn.span.end]] = mres
    mi = mi + 1
  }
}

// The seed's declTypeOf: reserves `name`'s TypeId (memoized via userTypes
// presence) BEFORE resolving its members, so members' composites/forward-named
// refs intern after it (source touch order) and self/mutual references
// terminate. An alias resolves transparently to its underlying (no reserved id).
function declTypeOf(c: Checker, name: string): int {
  let existing = userTypeLookup(c, name)
  if (existing != 0) {
    return existing
  }
  let node = c.typeDecls[name]
  if (node == 0) {
    return 0
  }
  let dn = getNode(c.tree, node)
  let k = kidsOf(c.tree, node)
  if (dn.tag == Tag.TypeAlias) {
    let u = typeFromNode(c, k[2])
    c.userTypes[name] = u
    return u
  }
  let kind = TypeKind.Struct
  if (dn.tag == Tag.EnumDecl) {
    kind = TypeKind.Enum
  } else if (dn.tag == Tag.InterfaceDecl) {
    kind = TypeKind.Interface
  }
  registerNamedType(c, name, kind)
  registerGenerics(c, k[1])
  if (dn.tag == Tag.StructDecl) {
    resolveStructFields(c, node, name)
  } else if (dn.tag == Tag.EnumDecl) {
    resolveEnumPayloads(c, node, userTypeLookup(c, name))
  } else if (dn.tag == Tag.InterfaceDecl) {
    resolveInterfaceSigs(c, node, name)
  }
  return userTypeLookup(c, name)
}

// The seed's collectFuncDecl: interns a function's signature composites in touch
// order — generics, then params (source order), then result, then (for a method)
// the receiver — and records its result + decl. The `(params)=>result` func-type
// id itself is NOT minted here (the seed stores a FuncShape, not a TypeId, so a
// sig wrapper would wrongly consume an id before later named types); it is built
// afterward by buildSignatures.
function collectFuncDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name, generics, params, result, body]
  registerGenerics(c, kids[2])
  paramTypeIds(c, kids[3])
  let rty = c.ctx.voidId
  if (kids[4] != 0) {
    rty = typeFromNode(c, kids[4])
  }
  let nm = getNode(c.tree, kids[1])
  let fname = c.source[nm.span.start:nm.span.end]
  if (kids[0] != 0) {
    let recvType = typeNodeName(c, kidsOf(c.tree, kids[0])[1])
    resolveNamed(c, recvType)
    c.ctx.methodResults["${userTypeLookup(c, recvType)}.${fname}"] = rty
  } else {
    c.funcResults[fname] = rty
    c.funcDecls[fname] = node
  }
}

// SPEC 11.7: records an `extern function`'s signature exactly like a free
// function's, so call sites type-check through the ordinary path, plus the
// extern marker lowering reads. There is no body and no receiver.
function collectExternFnDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [name, params, result_or_none]
  paramTypeIds(c, kids[1])
  let rty = c.ctx.voidId
  if (kids[2] != 0) {
    rty = typeFromNode(c, kids[2])
  }
  let nm = getNode(c.tree, kids[0])
  let fname = c.source[nm.span.start:nm.span.end]
  c.funcResults[fname] = rty
  c.funcDecls[fname] = node
  c.externFns[fname] = true
}

// Builds the `(params)=>result` func-type id for every free function, method, and
// interface method, filling funcSigs/methodSigs. Runs AFTER the collect pass so a
// sig wrapper's id lands past every named type (the seed mints these lazily, at
// the same relative position) — keeping named-type ids in touch order.
function buildSignatures(c: Checker) {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl) {
      let kids = kidsOf(c.tree, m)
      let rty = c.ctx.voidId
      if (kids[4] != 0) {
        rty = typeFromNode(c, kids[4])
      }
      let sig = funcTypeFromParams(c, kids[3], rty)
      let nm = getNode(c.tree, kids[1])
      let fname = c.source[nm.span.start:nm.span.end]
      if (kids[0] != 0) {
        c.ctx.methodSigs["${userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))}.${fname}"] = sig
      } else {
        c.funcSigs[fname] = sig
      }
    } else if (n.tag == Tag.ExternFnDecl) {
      let ek = kidsOf(c.tree, m) // [name, params, result_or_none]
      let erty = c.ctx.voidId
      if (ek[2] != 0) {
        erty = typeFromNode(c, ek[2])
      }
      let enn = getNode(c.tree, ek[0])
      c.funcSigs[c.source[enn.span.start:enn.span.end]] = funcTypeFromParams(c, ek[1], erty)
    } else if (n.tag == Tag.InterfaceDecl) {
      let iname = declName(c, m)
      let sigs = kidsOf(c.tree, kidsOf(c.tree, m)[2])
      let mi = 0
      while (mi < len(sigs)) {
        let mk = kidsOf(c.tree, sigs[mi])
        let mnn = getNode(c.tree, mk[0])
        let mres = c.ctx.voidId
        if (mk[2] != 0) {
          mres = typeFromNode(c, mk[2])
        }
        c.ctx.methodSigs["${userTypeLookup(c, iname)}." + c.source[mnn.span.start:mnn.span.end]] = funcTypeFromParams(c, mk[1], mres)
        mi = mi + 1
      }
    }
    m = m + 1
  }
}

function checkModule(c: Checker) {
  // Snapshot BEFORE any check-stage diagnostic: anything already recorded came
  // from parsing or resolution (see `Checker.resolveFailed`).
  c.resolveFailed = c.diags.errorCount > 0
  // The predeclared `error` interface's method `message(): string` (§10.6), so
  // `e.message()` on a caught error resolves like any interface method.
  c.ctx.methodResults["${c.ctx.errorId}.message"] = primType(c.ctx, 11)
  // Pre-scan: record every named type's decl node so a forward reference during
  // the collect pass can reserve+resolve it on first touch (§9: order-independent
  // top-level declarations).
  let t = 1
  while (t < len(c.tree.nodes)) {
    let dt = getNode(c.tree, t).tag
    if (dt == Tag.StructDecl || dt == Tag.EnumDecl || dt == Tag.InterfaceDecl || dt == Tag.TypeAlias) {
      c.typeDecls[declName(c, t)] = t
    }
    t = t + 1
  }
  // Collect pass: assign type ids in the seed's source touch order. A top-level
  // decl node's arena index falls between its own children and the next decl's,
  // so ascending iteration visits decls in source order. A type decl reserves its
  // id then resolves members inline (declTypeOf); a func decl interns its
  // signature (collectFuncDecl). Composites dedup; forward-named refs reserve on
  // first touch — reproducing the seed's declTypeOf/collectFuncDecl id order so
  // method-name mangling `name$t{recvId}` lines up.
  let m = 1
  while (m < len(c.tree.nodes)) {
    let mt = getNode(c.tree, m).tag
    if (mt == Tag.StructDecl || mt == Tag.EnumDecl || mt == Tag.InterfaceDecl || mt == Tag.TypeAlias) {
      declTypeOf(c, declName(c, m))
    } else if (mt == Tag.FuncDecl) {
      collectFuncDecl(c, m)
    } else if (mt == Tag.ExternFnDecl) {
      collectExternFnDecl(c, m)
    }
    m = m + 1
  }
  // After every named/composite id is fixed, build the func-type sig wrappers
  // (their ids land past all named types, so they never perturb touch order).
  buildSignatures(c)
  // Pre-pass 3: type params and for-of loop binders into env before the main
  // sweep. A loop header sits *after* its body in arena order, so typing binders
  // in the main sweep would be too late; params precede their loops, so this
  // ascending sweep resolves a param-typed iterable before its loop.
  let p3 = 1
  while (p3 < len(c.tree.nodes)) {
    let pn = getNode(c.tree, p3)
    if (pn.tag == Tag.Param || pn.tag == Tag.ParamRest || pn.tag == Tag.Receiver) {
      // A param `(x: T)` or a method receiver `(s: S)`: bind its name to its
      // declared type so the body resolves it.
      let pk = kidsOf(c.tree, p3)
      let nm = getNode(c.tree, pk[0])
      let pname = c.source[nm.span.start:nm.span.end]
      let ptype = paramBindType(c, pn.tag, pk[1])
      c.env[pname] = ptype
      c.declTypes[pk[0]] = ptype
      // Record the declared type NODE too. A generic scrutinee recovers its type
      // ARGUMENTS from this node — `match (xs)` with `xs: List<i64>` needs the
      // `<i64>` to bind `Cons(h, t)`'s payload at i64 rather than leaving it the
      // bare `T`. Lowering records the same thing for its own pass (lowerFunc),
      // which is why codegen was right while the checker read `h: T`.
      c.declTypeNodes[pname] = pk[1]
    } else if (pn.tag == Tag.Binding) {
      // Seed the decl-path so a binder below resolves its iterable/scrutinee by
      // the binding it refers to, not by the flat env (#1375). Ascending order
      // guarantees a `let xs = …` node precedes the `for x of xs` header.
      seedBindingDeclType(c, p3)
    } else if (pn.tag == Tag.ForOf) {
      typeForOfBinder(c, p3)
    } else if (pn.tag == Tag.MatchStmt) {
      typeMatchBinders(c, p3)
    } else if (pn.tag == Tag.CatchBind) {
      // `catch e { … }` binds the caught error as the `error` interface.
      envBind(c, kidsOf(c.tree, p3)[1], c.ctx.errorId)
    }
    p3 = p3 + 1
  }
  // Pre-pass 3b: the expected function type of every arrow literal written
  // against one (#1487) — see `Checker.arrowExpected`. AFTER pre-pass 3, whose
  // env is what `seedArrowExpectedCall` consults to see a local shadowing a
  // free function, and BEFORE every pass that types an expression.
  let ae = 1
  while (ae < len(c.tree.nodes)) {
    let at = getNode(c.tree, ae).tag
    if (at == Tag.Binding) {
      seedArrowExpectedBinding(c, ae)
    } else if (at == Tag.Call) {
      seedArrowExpectedCall(c, ae)
    }
    ae = ae + 1
  }
  // Pre-pass 4: annotated module-level `let`/`const` initializers against their
  // annotations. The statement sweep (vStmt) only walks function bodies, so
  // nothing else reaches these — `const c: f32 = "s"` was accepted by the
  // self-hosted compiler and rejected by the seed (#1470's hole, one scope up).
  //
  // A SEPARATE pass, before the main one, purely for DIAGNOSTIC ORDER: the seed
  // checks module-level declarations ahead of function bodies, so a bad `const`
  // declared after `main` is reported before `main`'s errors. Folded into the
  // main arena-order pass instead, it reported last and the two compilers'
  // diagnostic streams diverged in order while agreeing on content.
  let mb = 1
  while (mb < len(c.tree.nodes)) {
    if (getNode(c.tree, mb).tag == Tag.Binding && isTopLevelBinding(c, mb)) {
      vBinding(c, mb)
    }
    mb = mb + 1
  }

  // Main pass, in arena (source) order so a param/binding is recorded before the
  // expressions that reference it.
  let i = 1
  while (i < len(c.tree.nodes)) {
    let tag = getNode(c.tree, i).tag
    // Re-apply a DECL's own type into the flat env at its own name node. Pre-pass
    // 3 types params, receivers, and for-of / match / catch binders; every
    // same-named decl bound since has overwritten the module-wide env, and a name
    // node precedes the body that reads it, so this is where the decl's own type
    // goes back in scope. Without it a receiver reads a later param's type and a
    // valid `recv.field` false-misses (#1370/#1373), and a loop binder reads
    // another function's local (#1375).
    //
    // One rebind covers all of them because `declTypes` is now the single
    // per-node decl table (#1502). Ident-only: a tuple pattern's slot is keyed by
    // the pattern node, whose source text is not a name.
    if (tag == Tag.Ident && c.declTypes[i] != 0) {
      let bn = getNode(c.tree, i)
      c.env[c.source[bn.span.start:bn.span.end]] = c.declTypes[i]
    }
    if (tag == Tag.ArrowP) {
      // An annotated closure parameter: type it (and bind it so the body can
      // reference it). Children precede parents in arena order, so this runs
      // before the arrow body and enclosing binding are typed. An arrow
      // speculation that failed (a plain `(expr)`) leaves an orphan untyped
      // ArrowP in the arena; guard the env write so it cannot clobber a real
      // binding of the same name — its dump entry still renders `<error>`,
      // matching the seed.
      let kids = kidsOf(c.tree, i)
      let nm = getNode(c.tree, kids[0])
      let pt = 0
      if (kids[1] != 0) {
        pt = typeFromNode(c, kids[1])
      }
      c.nodeTypes[kids[0]] = pt
      if (pt != 0) {
        c.env[c.source[nm.span.start:nm.span.end]] = pt
        c.declTypes[kids[0]] = pt
      }
    } else if (tag == Tag.Binding) {
      checkBinding(c, i)
      // §11.11: a module-level `let` is mutable state with a static address,
      // not an SSA value. Validate it HERE (the checker), so an invalid form is
      // a real diagnostic rather than a late `cannot lower` refusal. The
      // resolver's `moduleScoped` is what separates it from a local `let` —
      // both are LetBinding.
      if (isModuleStateBinding(c, i)) {
        vModuleState(c, i)
      }
    } else if (tag == Tag.Call) {
      c.nodeTypes[i] = checkCall(c, i)
      // Record a generic-function call's instantiation in source order (its
      // monomorphized index), once, during the check pass.
      let callee = getNode(c.tree, kidsOf(c.tree, i)[0])
      if (callee.tag == Tag.Ident) {
        let cname = c.source[callee.span.start:callee.span.end]
        if (isGenericFunc(c, cname)) {
          recordInstantiation(c, cname, genericTypeArgs(c, cname, i))
        }
      }
    } else if (tag == Tag.FuncDecl) {
      // Validate this function's body (validate.bit) — everything above only
      // INFERS types. Here and nowhere else: children precede parents in arena
      // order, so at the FuncDecl node the body is fully swept and the flat
      // `env` holds exactly this function's params and locals, with no later
      // function's yet. See validate.bit's header.
      vFuncDecl(c, i)
    } else if (tag == Tag.ExternFnDecl) {
      // §11.7 E0077: the C-ABI restriction on an extern signature. A leaf decl
      // with no body, so unlike a FuncDecl it needs no sweep ordering.
      vExternFnDecl(c, i)
    }
    i = i + 1
  }
}

// One `--dump-types` line's data: the name's start offset, its source text, type.
struct TypeEntry {
  start: int,
  text: string,
  ty: int,
}

// Appends a dump entry per name bound by `pat` (recursing tuple_pat), reading
// the already-typed pattern node (the seed's collectBindingIdents).
function collectBindingIdents(c: Checker, pat: int, entries: []TypeEntry): []TypeEntry {
  let n = getNode(c.tree, pat)
  if (n.tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, pat)
    let i = 0
    while (i < len(subs)) {
      entries = collectBindingIdents(c, subs[i], entries)
      i = i + 1
    }
    return entries
  }
  return append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[pat] })
}

// Insertion-sort dump entries by source offset (the seed sorts (file, start);
// one file here, so start alone). Bounded by the entry count.
function sortEntries(entries: []TypeEntry): []TypeEntry {
  let i = 1
  while (i < len(entries)) {
    let cur = entries[i]
    let j = i - 1
    while (j >= 0 && entries[j].start > cur.start) {
      entries[j + 1] = entries[j]
      j = j - 1
    }
    entries[j + 1] = cur
    i = i + 1
  }
  return entries
}

// Renders `--dump-types`: one `line:col: text: typename` line per binding name,
// arrow parameter, and call expression, sorted by source position — matching the
// seed's dumpTypesText.
function dumpTypesText(c: Checker): string {
  let entries = []TypeEntry(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    let n = getNode(c.tree, i)
    if (n.tag == Tag.Binding) {
      entries = collectBindingIdents(c, kidsOf(c.tree, i)[0], entries)
    } else if (n.tag == Tag.ArrowP) {
      let name = kidsOf(c.tree, i)[0]
      let nn = getNode(c.tree, name)
      entries = append(entries, TypeEntry{ start: nn.span.start, text: c.source[nn.span.start:nn.span.end], ty: c.nodeTypes[name] })
    } else if (n.tag == Tag.Call) {
      entries = append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[i] })
    }
    i = i + 1
  }
  entries = sortEntries(entries)
  let out = ""
  let k = 0
  while (k < len(entries)) {
    let e = entries[k]
    let lc = locateOffset(c.source, e.start)
    out = out + "${lc.line + 1}:${lc.col + 1}: " + e.text + ": " + typeName(c.ctx, e.ty) + "\n"
    k = k + 1
  }
  return out
}

// Parses `src`, type-checks it, and returns the `--dump-types` text.
function checkSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpTypesText(c)
}
