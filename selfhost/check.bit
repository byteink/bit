// Self-host Stage 2 (#1337): the type checker, ported from compiler/check.zig.
// This first chunk is the inference skeleton + the `--dump-types` surface: it
// assigns a TypeId to every node (`nodeTypes`), infers literal expressions and
// their default types, resolves simple type annotations, and renders the
// binding/arrow-param/call type dump the seed's `bitc --dump-types` emits. The
// full inference (idents, calls, operators, generics — needs resolve + method
// sets) grows on top, verified by the corpus `--dump-types` differential.

// A 0-based source position (line, column) for the dump gutter.
struct LineCol {
  line: int,
  col: int,
}

// Maps a byte offset to 0-based line/column. Bounded by the offset.
function locateOffset(source: string, offset: int): LineCol {
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  return LineCol{ line: line, col: offset - lineStart }
}

struct Checker {
  ctx: TypeContext,
  tree: Tree,
  source: string,
  nodeTypes: []int,
  // name -> TypeId for the bindings/params in scope, and name -> result type for
  // top-level functions (a pre-pass fills the latter so forward calls resolve).
  // ponytail: one flat env, no per-function scoping yet — fine until two
  // functions bind the same name to different types.
  env: map<string, int>,
  funcResults: map<string, int>,
  // Declared struct/enum/alias name -> its named TypeId.
  userTypes: map<string, int>,
}

function newChecker(tree: Tree, source: string, ctx: TypeContext): Checker {
  let nt = []int(0)
  let i = 0
  while (i < len(tree.nodes)) {
    nt = append(nt, 0)
    i = i + 1
  }
  return Checker{ ctx: ctx, tree: tree, source: source, nodeTypes: nt,
    env: map<string, int>{}, funcResults: map<string, int>{}, userTypes: map<string, int>{} }
}

function userTypeLookup(c: Checker, name: string): int {
  for (k, v) of c.userTypes {
    if (k == name) {
      return v
    }
  }
  return 0
}

// name -> TypeId from the scope env, or 0 (invalid) if unbound. ponytail: linear
// scan pending map comma-ok lowering. [[bit-maps]]
function envLookup(c: Checker, name: string): int {
  for (k, v) of c.env {
    if (k == name) {
      return v
    }
  }
  return 0
}

function funcResultLookup(c: Checker, name: string): int {
  for (k, v) of c.funcResults {
    if (k == name) {
      return v
    }
  }
  return 0
}

function isUntyped(c: Checker, t: int): bool {
  return t == c.ctx.untypedIntId || t == c.ctx.untypedFloatId || t == c.ctx.untypedRuneId ||
    t == c.ctx.untypedBoolId || t == c.ctx.untypedStringId || t == c.ctx.untypedNilId
}

// The result type of a binary arithmetic/bitwise operator: an untyped operand
// takes the other's concrete type; matching types stay; otherwise the left one.
function mergeTypes(c: Checker, a: int, b: int): int {
  if (a == b) {
    return a
  }
  if (isUntyped(c, a) && !isUntyped(c, b)) {
    return b
  }
  if (isUntyped(c, b) && !isUntyped(c, a)) {
    return a
  }
  return a
}

function isComparisonOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq) || op == int(Kind.Lt) ||
    op == int(Kind.Gt) || op == int(Kind.LtEq) || op == int(Kind.GtEq) ||
    op == int(Kind.AmpAmp) || op == int(Kind.PipePipe)
}

// The prim-enum index for a predeclared type name, or -1 if not a primitive.
// Includes the size aliases (`int`/`uint`/`byte`/`rune`) that map onto a prim.
function primIndexByName(name: string): int {
  if (name == "i8") { return 0 }
  if (name == "i16") { return 1 }
  if (name == "i32") { return 2 }
  if (name == "i64") { return 3 }
  if (name == "u8") { return 4 }
  if (name == "u16") { return 5 }
  if (name == "u32") { return 6 }
  if (name == "u64") { return 7 }
  if (name == "f32") { return 8 }
  if (name == "f64") { return 9 }
  if (name == "bool") { return 10 }
  if (name == "string") { return 11 }
  if (name == "int") { return 3 }
  if (name == "uint") { return 7 }
  if (name == "byte") { return 4 }
  if (name == "rune") { return 2 }
  return -1
}

// The default concrete type of an untyped value (spec §15.4): int→i64, float→f64,
// rune→i32, bool→bool, string→string; anything else is unchanged.
function defaultType(c: Checker, ty: int): int {
  if (ty == c.ctx.untypedIntId) { return primType(c.ctx, 3) }
  if (ty == c.ctx.untypedFloatId) { return primType(c.ctx, 9) }
  if (ty == c.ctx.untypedRuneId) { return primType(c.ctx, 2) }
  if (ty == c.ctx.untypedBoolId) { return primType(c.ctx, 10) }
  if (ty == c.ctx.untypedStringId) { return primType(c.ctx, 11) }
  return ty
}

// Infers a type-annotation node to a TypeId. Primitives and simple composites
// (slice/array/map/chan) are handled here; named types need resolve and infer
// to invalid (0) for now.
function typeFromNode(c: Checker, node: int): int {
  if (node == 0) {
    return 0
  }
  let n = getNode(c.tree, node)
  let tag = n.tag
  if (tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    return userTypeLookup(c, name)
  }
  let kids = kidsOf(c.tree, node)
  if (tag == Tag.SliceType) {
    return mkSlice(c.ctx, typeFromNode(c, kids[0]))
  }
  if (tag == Tag.ChanType) {
    return mkChan(c.ctx, typeFromNode(c, kids[0]))
  }
  if (tag == Tag.MapType) {
    return mkMap(c.ctx, typeFromNode(c, kids[0]), typeFromNode(c, kids[1]))
  }
  if (tag == Tag.VoidType) {
    return c.ctx.voidId
  }
  return 0
}

// The predeclared builtins that return void `()` (spec §5.3). Their call
// expressions type as the void id regardless of arguments.
function builtinReturnsVoid(name: string): bool {
  return name == "print" || name == "panic" || name == "assert" ||
    name == "close" || name == "delete"
}

// Infers a call expression's result type: a void builtin is `()`; a top-level
// function call is its declared result; `chan<T>(n)`/`map<K,V>{}`-style
// constructors are the constructed type. Unknown callees infer to invalid (0).
function checkCall(c: Checker, node: int): int {
  let callee = kidsOf(c.tree, node)[0]
  let cn = getNode(c.tree, callee)
  if (cn.tag == Tag.Ident) {
    let name = c.source[cn.span.start:cn.span.end]
    if (builtinReturnsVoid(name)) {
      return c.ctx.voidId
    }
    // `len`/`cap` always yield i64 regardless of argument.
    if (name == "len" || name == "cap") {
      return primType(c.ctx, 3)
    }
    let r = funcResultLookup(c, name)
    if (r != 0) {
      return r
    }
    // A primitive name used as a call is a conversion: `f64(x)` -> f64.
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    return 0
  }
  // `chan<T>(n)` / `[]T(n)` / `map<K,V>()` — the callee is a type node, so the
  // result is that type.
  if (cn.tag == Tag.ChanType || cn.tag == Tag.SliceType || cn.tag == Tag.MapType || cn.tag == Tag.ArrayType) {
    return typeFromNode(c, callee)
  }
  return 0
}

// A receive `<-ch` yields the channel's element type; other unary operators
// (`-`/`+`/`~`) preserve the operand type, and `!` yields its (bool) operand.
function checkUnary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let ot = checkExprType(c, kidsOf(c.tree, node)[0])
  if (n.main == int(Kind.ArrowLeft)) {
    if (ot != 0 && c.ctx.types[ot].kind == TypeKind.Chan) {
      return c.ctx.types[ot].elem
    }
    return 0
  }
  return ot
}

// Arithmetic/bitwise binaries merge their operand types; comparisons and logical
// operators yield an (untyped) boolean.
function checkBinary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let kids = kidsOf(c.tree, node)
  let a = checkExprType(c, kids[0])
  let b = checkExprType(c, kids[1])
  if (isComparisonOp(n.main)) {
    return c.ctx.untypedBoolId
  }
  return mergeTypes(c, a, b)
}

// Infers an expression's (possibly untyped) type. Literals and void-builtin
// calls for now; every other construct infers to invalid (0) until its
// inference lands.
function checkExprType(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.IntLit) { return c.ctx.untypedIntId }
  if (tag == Tag.FloatLit) { return c.ctx.untypedFloatId }
  if (tag == Tag.RuneLit) { return c.ctx.untypedRuneId }
  if (tag == Tag.BoolLit) { return c.ctx.untypedBoolId }
  if (tag == Tag.StringLit || tag == Tag.RawStringLit) { return c.ctx.untypedStringId }
  if (tag == Tag.NilLit) { return c.ctx.untypedNilId }
  if (tag == Tag.Ident) {
    let sp = getNode(c.tree, node).span
    return envLookup(c, c.source[sp.start:sp.end])
  }
  if (tag == Tag.Unary) { return checkUnary(c, node) }
  if (tag == Tag.Binary) { return checkBinary(c, node) }
  if (tag == Tag.Call) { return checkCall(c, node) }
  if (tag == Tag.SliceLit) { return checkSliceLit(c, node) }
  // A composite literal `Name{...}` / `map<K,V>{...}` / `[]T{...}` has the type
  // of its type node.
  if (tag == Tag.CompositeLit) { return typeFromNode(c, kidsOf(c.tree, node)[0]) }
  return 0
}

// Registers a struct/enum/interface declaration as a named type so references
// to it resolve. Called in a pre-pass (types may be referenced before their
// declaration, §9).
function registerNamedType(c: Checker, name: string, kind: TypeKind) {
  let t = leafType(kind)
  t.name = name
  t.hasName = true
  c.userTypes[name] = addType(c.ctx, t)
}

// The source text of a declaration's name (kid 0 is the name leaf).
function declName(c: Checker, node: int): string {
  let nm = getNode(c.tree, kidsOf(c.tree, node)[0])
  return c.source[nm.span.start:nm.span.end]
}

// An untyped slice literal `[a, b, ...]` is `[]E`, E the (defaulted) type of its
// first element. ponytail: first element only — a heterogeneous literal would
// need element unification, which the checker rejects anyway.
function checkSliceLit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0) {
    return 0
  }
  let first = kids[0]
  if (getNode(c.tree, first).tag == Tag.Arg) {
    first = kidsOf(c.tree, first)[0]
  }
  return mkSlice(c.ctx, defaultType(c, checkExprType(c, first)))
}

// Types one `binding` node ([pat, annotation, init]): an explicit annotation
// wins; otherwise the initializer's type is defaulted to concrete. The pattern
// node carries the result so the dump reads it back.
function checkBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  let ann = kids[1]
  let init = kids[2]
  let ty = 0
  if (ann != 0) {
    ty = typeFromNode(c, ann)
  } else if (init != 0) {
    ty = defaultType(c, checkExprType(c, init))
  }
  c.nodeTypes[pat] = ty
  // Record a simple-ident binding so later expressions resolve it.
  let pn = getNode(c.tree, pat)
  if (pn.tag == Tag.Ident) {
    c.env[c.source[pn.span.start:pn.span.end]] = ty
  }
}

// Walks every node and types the bindings. (arrow-param and call typing land
// with expression inference; a flat arena walk catches bindings at any nesting.)
function checkModule(c: Checker) {
  // Pre-pass 1: register every declared type, so later references (function
  // results, annotations, composites) resolve regardless of order (§9).
  let t = 1
  while (t < len(c.tree.nodes)) {
    let n = getNode(c.tree, t)
    if (n.tag == Tag.StructDecl) {
      registerNamedType(c, declName(c, t), TypeKind.Struct)
    } else if (n.tag == Tag.EnumDecl) {
      registerNamedType(c, declName(c, t), TypeKind.Enum)
    } else if (n.tag == Tag.InterfaceDecl) {
      registerNamedType(c, declName(c, t), TypeKind.Interface)
    }
    t = t + 1
  }
  // Pre-pass 2: every top-level function's declared result type, so a call to a
  // function defined later still resolves.
  let f = 1
  while (f < len(c.tree.nodes)) {
    if (getNode(c.tree, f).tag == Tag.FuncDecl) {
      let kids = kidsOf(c.tree, f)
      let nm = getNode(c.tree, kids[1])
      // An omitted result type is void `()` (§10.3).
      let rty = c.ctx.voidId
      if (kids[4] != 0) {
        rty = typeFromNode(c, kids[4])
      }
      c.funcResults[c.source[nm.span.start:nm.span.end]] = rty
    }
    f = f + 1
  }
  // Main pass, in arena (source) order so a param/binding is recorded before the
  // expressions that reference it.
  let i = 1
  while (i < len(c.tree.nodes)) {
    let tag = getNode(c.tree, i).tag
    if (tag == Tag.Param) {
      let kids = kidsOf(c.tree, i)
      let nm = getNode(c.tree, kids[0])
      c.env[c.source[nm.span.start:nm.span.end]] = typeFromNode(c, kids[1])
    } else if (tag == Tag.Binding) {
      checkBinding(c, i)
    } else if (tag == Tag.Call) {
      c.nodeTypes[i] = checkCall(c, i)
    }
    i = i + 1
  }
}

// One `--dump-types` line's data: the name's start offset, its source text, type.
struct TypeEntry {
  start: int,
  text: string,
  ty: int,
}

// Appends a dump entry per name bound by `pat` (recursing tuple_pat), reading
// the already-typed pattern node (the seed's collectBindingIdents).
function collectBindingIdents(c: Checker, pat: int, entries: []TypeEntry): []TypeEntry {
  let n = getNode(c.tree, pat)
  if (n.tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, pat)
    let i = 0
    while (i < len(subs)) {
      entries = collectBindingIdents(c, subs[i], entries)
      i = i + 1
    }
    return entries
  }
  return append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[pat] })
}

// Insertion-sort dump entries by source offset (the seed sorts (file, start);
// one file here, so start alone). Bounded by the entry count.
function sortEntries(entries: []TypeEntry): []TypeEntry {
  let i = 1
  while (i < len(entries)) {
    let cur = entries[i]
    let j = i - 1
    while (j >= 0 && entries[j].start > cur.start) {
      entries[j + 1] = entries[j]
      j = j - 1
    }
    entries[j + 1] = cur
    i = i + 1
  }
  return entries
}

// Renders `--dump-types`: one `line:col: text: typename` line per binding name,
// arrow parameter, and call expression, sorted by source position — matching the
// seed's dumpTypesText.
function dumpTypesText(c: Checker): string {
  let entries = []TypeEntry(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    let n = getNode(c.tree, i)
    if (n.tag == Tag.Binding) {
      entries = collectBindingIdents(c, kidsOf(c.tree, i)[0], entries)
    } else if (n.tag == Tag.ArrowP) {
      let name = kidsOf(c.tree, i)[0]
      let nn = getNode(c.tree, name)
      entries = append(entries, TypeEntry{ start: nn.span.start, text: c.source[nn.span.start:nn.span.end], ty: c.nodeTypes[name] })
    } else if (n.tag == Tag.Call) {
      entries = append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[i] })
    }
    i = i + 1
  }
  entries = sortEntries(entries)
  let out = ""
  let k = 0
  while (k < len(entries)) {
    let e = entries[k]
    let lc = locateOffset(c.source, e.start)
    out = out + "${lc.line + 1}:${lc.col + 1}: " + e.text + ": " + typeName(c.ctx, e.ty) + "\n"
    k = k + 1
  }
  return out
}

// Parses `src`, type-checks it, and returns the `--dump-types` text.
function checkSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpTypesText(c)
}
