// Self-host Stage 2 (#1337): the type checker, ported from compiler/check.zig.
// This first chunk is the inference skeleton + the `--dump-types` surface: it
// assigns a TypeId to every node (`nodeTypes`), infers literal expressions and
// their default types, resolves simple type annotations, and renders the
// binding/arrow-param/call type dump the seed's `bitc --dump-types` emits. The
// full inference (idents, calls, operators, generics — needs resolve + method
// sets) grows on top, verified by the corpus `--dump-types` differential.

// A 0-based source position (line, column) for the dump gutter.
struct LineCol {
  line: int,
  col: int,
}

// Maps a byte offset to 0-based line/column. Bounded by the offset.
function locateOffset(source: string, offset: int): LineCol {
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  return LineCol{ line: line, col: offset - lineStart }
}

struct Checker {
  ctx: TypeContext,
  tree: Tree,
  source: string,
  nodeTypes: []int,
  // name -> TypeId for the bindings/params in scope, and name -> result type for
  // top-level functions (a pre-pass fills the latter so forward calls resolve).
  // ponytail: one flat env, no per-function scoping yet — fine until two
  // functions bind the same name to different types.
  env: map<string, int>,
  funcResults: map<string, int>,
  // Declared struct/enum/alias name -> its named TypeId.
  userTypes: map<string, int>,
  // Free-function name -> its full `(params) => result` func TypeId, so a bare
  // function reference (`let g = inc`) types as a first-class value.
  funcSigs: map<string, int>,
  // Free-function name -> its FuncDecl node, so a generic call can substitute
  // its type parameters from the argument types at the call site.
  funcDecls: map<string, int>,
  // Type-parameter name -> its constraint interface type, so a method call on a
  // constrained generic value `s.area()` (s: T, `T: Shape`) resolves via Shape.
  typeParamConstraints: map<string, int>,
  // Local/param name -> its declared type NODE (rebound per function in
  // lowering), so a generic-enum scrutinee `o: Opt<i64>` can recover its type
  // arguments for match-binder substitution.
  declTypeNodes: map<string, int>,
  // Named type -> its decl node, so a forward reference during declTypeOf can
  // reserve+resolve it on first touch (the seed's declTypeOf recursion), giving
  // type ids in source-order touch order (needed for method-name mangling).
  typeDecls: map<string, int>,
  // --- module identity (#1345) --------------------------------------------
  // This module's id. The root is the module being built; lowering leaves the
  // root's names bare (so `main` stays `main`) and prefixes every other
  // module's with `m<id>$`.
  moduleId: int,
  // Every module's checker, indexed by module id. A name imported from another
  // module has its DECLARATION in that module's tree, so reading the decl needs
  // that module's `tree`/`source` — see `declOwner`. Type information does not:
  // TypeIds are global to the shared TypeContext, so an import copies the
  // exporting module's type entries straight into the maps above and the whole
  // checker keeps working name-keyed and unchanged.
  mods: []Checker,
  // Local name -> where it was imported from. A name absent here is declared in
  // this module.
  importedFrom: map<string, ImportOrigin>,
  // The names this module declares under `export` — the only ones another
  // module may import, and the set the prelude auto-imports everywhere.
  exports: map<string, bool>,
  // Import path text ("std/fs") -> module id, filled by the loader before
  // checking. -1 marks a path that resolved to no module.
  importPaths: map<string, int>,
}

// Where an imported name comes from: the module that declares it, and the name
// it is declared under THERE — which differs from the local name whenever the
// import renames it (`import { readFile as slurp }`). Both are needed: the
// declaration is looked up in the exporter under `name`, and the link symbol is
// built from `name` too, so an alias never reaches the object file.
struct ImportOrigin {
  module: int,
  name: string,
}

// One generic-function instantiation: the module that DECLARES the generic, the
// generic's name there, and the concrete argument types it was called with (one
// per parameter, in order). `module` is what makes an instantiation of an
// imported generic resolve to one symbol from every caller.
struct Instantiation {
  module: int,
  name: string,
  args: []int,
}

function newChecker(tree: Tree, source: string, ctx: TypeContext): Checker {
  let nt = []int(0)
  let i = 0
  while (i < len(tree.nodes)) {
    nt = append(nt, 0)
    i = i + 1
  }
  return Checker{ ctx: ctx, tree: tree, source: source, nodeTypes: nt,
    env: map<string, int>{}, funcResults: map<string, int>{}, userTypes: map<string, int>{},
    funcSigs: map<string, int>{}, funcDecls: map<string, int>{},
    typeParamConstraints: map<string, int>{},
    declTypeNodes: map<string, int>{},
    typeDecls: map<string, int>{}, moduleId: 0, mods: []Checker(0),
    importedFrom: map<string, ImportOrigin>{}, exports: map<string, bool>{},
    importPaths: map<string, int>{} }
}

// The declared name of a top-level decl node. A FuncDecl carries its name at
// kid 1 (kid 0 is the optional receiver); every other decl has it at kid 0.
// Getting this wrong reads a receiver as a name and exports nothing.
function topDeclName(c: Checker, node: int): string {
  let n = getNode(c.tree, node)
  if (n.tag == Tag.FuncDecl) {
    let k = kidsOf(c.tree, node)
    if (k[1] == 0) {
      return ""
    }
    let nm = getNode(c.tree, k[1])
    return c.source[nm.span.start:nm.span.end]
  }
  if (n.tag == Tag.StructDecl || n.tag == Tag.EnumDecl || n.tag == Tag.InterfaceDecl ||
      n.tag == Tag.TypeAlias) {
    return declName(c, node)
  }
  return ""
}

// Records every name declared under `export` — the decls this module makes
// importable. `export` wraps its decl rather than replacing it, so the collect
// pass already sees the inner node; this only records visibility.
function collectExports(c: Checker) {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.Export) {
      let inner = kidsOf(c.tree, i)[0]
      if (inner != 0) {
        let nm = topDeclName(c, inner)
        if (nm != "") {
          c.exports[nm] = true
        }
      }
    }
    i = i + 1
  }
}

// The checker whose tree holds `name`'s declaration: this one, unless `name` was
// imported. Every site that reads a declaration NODE for a name must go through
// this, because a node index only means anything inside its own tree — reading
// an imported function's decl against the importing module's tree would land on
// an unrelated node and silently miscompile.
function declOwner(c: Checker, name: string): Checker {
  let (o, ok) = c.importedFrom[name]
  if (!ok || o.module < 0 || o.module >= len(c.mods)) {
    return c
  }
  return c.mods[o.module]
}

// `name` as the module that declares it spells it — the same name, unless this
// module imported it under an alias.
function declName2(c: Checker, name: string): string {
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return name
  }
  return o.name
}

// The link-level name for a function `base` declared in module `mod`, given the
// root module id. Mirrors the seed's `moduleQualified` exactly: the root keeps
// bare names (so `main` stays `main`, and a single-module build stays
// byte-identical), every other module gets an `m<id>$` prefix so two modules'
// same-named functions cannot collide in the object's flat symbol namespace.
function moduleQualified(mod: int, root: int, base: string): string {
  if (mod == root) {
    return base
  }
  return "m${mod}\$${base}"
}

// The link name for a call to `name` from `c`: an imported name resolves to its
// DEFINING module's prefix under its ORIGINAL spelling, so neither the caller's
// module nor a local alias reaches the object file.
function callQualified(c: Checker, root: int, name: string): string {
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return moduleQualified(c.moduleId, root, name)
  }
  return moduleQualified(o.module, root, o.name)
}

// The enum type-args a variant construction `Enum.Variant(args)` binds, inferred
// from the variant's bare-type-param payload slots and their argument types
// (`Opt.Some(9)` binds Opt's T from arg 9 -> i64).
function variantConstructionTypeArgs(c: Checker, callNode: int): []int {
  let out = []int(0)
  let mk = kidsOf(c.tree, kidsOf(c.tree, callNode)[0])
  let enumName = typeNodeName(c, mk[0])
  let vnn = getNode(c.tree, mk[1])
  let vname = c.source[vnn.span.start:vnn.span.end]
  let decl = enumDeclByName(c, enumName)
  if (decl == 0) {
    return out
  }
  let tps = kidsOf(c.tree, kidsOf(c.tree, decl)[1])
  // Locate this variant's payload type nodes.
  let vs = enumVariantNodes(c, decl)
  let payloadNodes = []int(0)
  let vi = 0
  while (vi < len(vs)) {
    let vn2 = getNode(c.tree, kidsOf(c.tree, vs[vi])[0])
    if (c.source[vn2.span.start:vn2.span.end] == vname) {
      let pl = kidsOf(c.tree, vs[vi])[1]
      if (pl != 0) {
        payloadNodes = kidsOf(c.tree, pl)
      }
      vi = len(vs)
    } else {
      vi = vi + 1
    }
  }
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(c.tree, kidsOf(c.tree, tps[ti])[0])
    let tpname = c.source[tpn.span.start:tpn.span.end]
    let bound = c.ctx.voidId
    let pj = 0
    while (pj < len(payloadNodes)) {
      let pn2 = getNode(c.tree, payloadNodes[pj])
      if (pn2.tag == Tag.Ident && c.source[pn2.span.start:pn2.span.end] == tpname) {
        bound = defaultType(c, checkArgType(c, callNode, pj))
        pj = len(payloadNodes)
      } else {
        pj = pj + 1
      }
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}

// The concrete type arguments of a generic-enum scrutinee expression, or empty:
// a local/param recovers them from its declared type node, a call from the
// callee's result type node (each a `Name<...>` GenericInst).
function scrutineeTypeArgs(c: Checker, node: int): []int {
  let out = []int(0)
  let n = getNode(c.tree, node)
  let tnode = 0
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        tnode = v
      }
    }
  } else if (n.tag == Tag.Call) {
    let ck = kidsOf(c.tree, node)
    let callee = getNode(c.tree, ck[0])
    if (callee.tag == Tag.Ident) {
      let cname = c.source[callee.span.start:callee.span.end]
      let decl = funcDeclLookup(c, cname)
      // An imported decl's nodes index its own module's tree; a generic
      // instance read from it would not be resolvable here anyway, so only a
      // locally-declared callee contributes a result node.
      if (decl != 0 && declOwner(c, cname).moduleId == c.moduleId) {
        tnode = kidsOf(c.tree, decl)[4]
      }
    } else if (callee.tag == Tag.Member) {
      // `Enum.Variant(args)` construction: infer the enum's type-args from the
      // variant's bare-type-param payload slots and their argument types.
      return variantConstructionTypeArgs(c, node)
    }
  }
  if (tnode == 0 || getNode(c.tree, tnode).tag != Tag.GenericInst) {
    return out
  }
  // A generic instance `Name<A, B>` — kid 1 is the type-argument list.
  let targs = kidsOf(c.tree, kidsOf(c.tree, tnode)[1])
  let i = 0
  while (i < len(targs)) {
    out = append(out, typeFromNode(c, targs[i]))
    i = i + 1
  }
  return out
}

// The scrutinee's type-argument AST nodes (parallel to scrutineeTypeArgs, but
// unresolved), so a match binder can be recorded with its declared type node and
// a nested match on it can recover its own type-args. Empty when the scrutinee's
// type-args are inferred rather than written (variant construction).
function scrutineeTypeArgNodes(c: Checker, node: int): []int {
  let out = []int(0)
  let n = getNode(c.tree, node)
  let tnode = 0
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        tnode = v
      }
    }
  } else if (n.tag == Tag.Call) {
    let ck = kidsOf(c.tree, node)
    let callee = getNode(c.tree, ck[0])
    if (callee.tag == Tag.Ident) {
      let cname = c.source[callee.span.start:callee.span.end]
      let decl = funcDeclLookup(c, cname)
      // An imported decl's nodes index its own module's tree; a generic
      // instance read from it would not be resolvable here anyway, so only a
      // locally-declared callee contributes a result node.
      if (decl != 0 && declOwner(c, cname).moduleId == c.moduleId) {
        tnode = kidsOf(c.tree, decl)[4]
      }
    }
  }
  if (tnode == 0 || getNode(c.tree, tnode).tag != Tag.GenericInst) {
    return out
  }
  let targs = kidsOf(c.tree, kidsOf(c.tree, tnode)[1])
  let i = 0
  while (i < len(targs)) {
    out = append(out, targs[i])
    i = i + 1
  }
  return out
}

function structFieldLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.structFields {
    if (k == key) {
      return v
    }
  }
  return 0
}

// The base name of a type node: a plain ident's text, or a generic instance's
// base (`Box<i64>` -> "Box"). Empty for anything else.
function typeNodeName(c: Checker, node: int): string {
  if (node == 0) {
    return ""
  }
  let n = getNode(c.tree, node)
  if (n.tag == Tag.Ident) {
    return c.source[n.span.start:n.span.end]
  }
  if (n.tag == Tag.GenericInst) {
    return typeNodeName(c, kidsOf(c.tree, node)[0])
  }
  return ""
}

function methodResultLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.methodResults {
    if (k == key) {
      return v
    }
  }
  return 0
}

// "TypeName.method" -> the method's `(params) => result` func type, or 0.
function methodSigLookup(c: Checker, key: string): int {
  for (k, v) of c.ctx.methodSigs {
    if (k == key) {
      return v
    }
  }
  return 0
}

// Builds a `(params) => result` func type from a params-list node (each kid a
// `param[name, type]`), for a method value or a signature.
// Interns a parameter list's types in source order, returning the id list.
function paramTypeIds(c: Checker, paramsNode: int): []int {
  let ptypes = []int(0)
  let params = kidsOf(c.tree, paramsNode)
  let i = 0
  while (i < len(params)) {
    ptypes = append(ptypes, typeFromNode(c, kidsOf(c.tree, params[i])[1]))
    i = i + 1
  }
  return ptypes
}

function funcTypeFromParams(c: Checker, paramsNode: int, resultTy: int): int {
  return mkFunc(c.ctx, paramTypeIds(c, paramsNode), false, resultTy)
}

// The type to resolve a method call against: a constrained type parameter `T`
// dispatches through its constraint interface, so `s.area()` (s: T, `T: Shape`)
// resolves on Shape. Any other type is its own receiver.
function methodRecvType(c: Checker, recvType: int): int {
  if (c.ctx.types[recvType].kind != TypeKind.TypeParam) {
    return recvType
  }
  for (k, v) of c.typeParamConstraints {
    if (k == c.ctx.types[recvType].name) {
      return v
    }
  }
  return recvType
}

function userTypeLookup(c: Checker, name: string): int {
  for (k, v) of c.userTypes {
    if (k == name) {
      return v
    }
  }
  return 0
}

// name -> TypeId from the scope env, or 0 (invalid) if unbound. ponytail: linear
// scan pending map comma-ok lowering. [[bit-maps]]
function envLookup(c: Checker, name: string): int {
  for (k, v) of c.env {
    if (k == name) {
      return v
    }
  }
  return 0
}

function funcResultLookup(c: Checker, name: string): int {
  for (k, v) of c.funcResults {
    if (k == name) {
      return v
    }
  }
  return 0
}

// The full `(params) => result` type of a free function used as a value, or 0.
function funcSigLookup(c: Checker, name: string): int {
  for (k, v) of c.funcSigs {
    if (k == name) {
      return v
    }
  }
  return 0
}

// The FuncDecl node for a free function, or 0. An imported name's decl lives in
// the exporting module's tree, so the lookup follows the import — callers that
// then read the node MUST read it against `declOwner(c, name).tree`.
function funcDeclLookup(c: Checker, name: string): int {
  let (o, ok) = c.importedFrom[name]
  if (ok && o.module >= 0 && o.module < len(c.mods)) {
    let e = c.mods[o.module]
    for (k, v) of e.funcDecls {
      if (k == o.name) {
        return v
      }
    }
    return 0
  }
  for (k, v) of c.funcDecls {
    if (k == name) {
      return v
    }
  }
  return 0
}

// Copies every entry whose key is exactly `orig`, or is prefixed `orig.` (a
// type's fields and methods are keyed "Type.member"), rebinding the key's
// leading name to `alias`. Named `orig`/`alias` because `from` is a keyword.
function copyQualified(dst: map<string, int>, src: map<string, int>, orig: string, alias: string) {
  for (k, v) of src {
    if (k == orig) {
      dst[alias] = v
      continue
    }
    if (len(k) > len(orig) && k[0:len(orig)] == orig && k[len(orig)] == '.') {
      dst[alias + k[len(orig):len(k)]] = v
    }
  }
}

// Binds `name` (as declared in module `mid`'s checker `e`) into `c` under
// `alias`. TypeIds are global to the shared TypeContext, so the type side of an
// import is a plain copy — which is what lets the rest of the checker stay
// name-keyed and completely unaware that modules exist. Only the declaration
// NODE cannot be copied; it stays in the exporter's tree, reached via declOwner.
function importName(c: Checker, e: Checker, mid: int, name: string, alias: string) {
  c.importedFrom[alias] = ImportOrigin{ module: mid, name: name }
  copyQualified(c.funcResults, e.funcResults, name, alias)
  copyQualified(c.funcSigs, e.funcSigs, name, alias)
  copyQualified(c.userTypes, e.userTypes, name, alias)
  // Fields and methods are NOT copied: they live on the type in the shared
  // TypeContext, so they resolve from any module that can name the type at all.
}

// Type-checks every module of a loaded project into ONE shared TypeContext, in
// module-id order — which the loader guarantees is dependency order, so each
// module's imports are already checked (their type maps populated) by the time
// it binds them. Returns the checkers, indexed by module id, for lowering.
function checkProject(p: Project): []Checker {
  let ctx = newTypeContext()
  let mods = []Checker(0)
  let i = 0
  while (i < len(p.mods)) {
    let c = newChecker(p.mods[i].tree, p.mods[i].source, ctx)
    c.moduleId = i
    c.importPaths = p.mods[i].imports
    mods = append(mods, c)
    i = i + 1
  }
  // Hand out the shared table only now: `append` may move the backing array, so
  // a checker given the slice mid-build would hold a stale, short view of it.
  i = 0
  while (i < len(mods)) {
    mods[i].mods = mods
    i = i + 1
  }
  i = 0
  while (i < len(mods)) {
    collectExports(mods[i])
    bindImports(mods[i], p.prelude)
    checkModule(mods[i])
    i = i + 1
  }
  return mods
}

// Binds every name a module imports, before its own declarations are collected —
// an import is in scope for the whole module, including decls written above it.
// The prelude's exports bind first so an explicit import of the same name wins.
function bindImports(c: Checker, preludeId: int) {
  if (preludeId >= 0 && preludeId < len(c.mods) && preludeId != c.moduleId) {
    let p = c.mods[preludeId]
    for (n, _) of p.exports {
      importName(c, p, preludeId, n, n)
    }
  }
  for d of kidsOf(c.tree, c.tree.root) {
    if (d == 0 || getNode(c.tree, d).tag != Tag.ImportDecl) {
      continue
    }
    let dk = kidsOf(c.tree, d)
    let pathNode = getNode(c.tree, dk[1])
    let path = c.source[pathNode.span.start + 1:pathNode.span.end - 1]
    let (mid, found) = c.importPaths[path]
    if (!found || mid < 0 || mid >= len(c.mods)) {
      continue // unresolved import: already reported by the loader
    }
    let e = c.mods[mid]
    let body = getNode(c.tree, dk[0])
    if (body.tag != Tag.ImportGroup) {
      continue // namespace/star imports bind in bindNamespaceImports
    }
    for item of kidsOf(c.tree, dk[0]) {
      let ik = kidsOf(c.tree, item)
      let nn = getNode(c.tree, ik[0])
      let name = c.source[nn.span.start:nn.span.end]
      let alias = name
      if (ik[1] != 0) {
        let an = getNode(c.tree, ik[1])
        alias = c.source[an.span.start:an.span.end]
      }
      importName(c, e, mid, name, alias)
    }
  }
}

// Whether `name` is one of the FuncDecl's declared generic type parameters.
function isTypeParamName(c: Checker, decl: int, name: string): bool {
  let g = kidsOf(c.tree, decl)[2]
  if (g == 0) {
    return false
  }
  let ps = kidsOf(c.tree, g)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    if (c.source[nm.span.start:nm.span.end] == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// If a call targets a generic function whose result is a bare type parameter
// `T`, substitute it: find the parameter typed `T` and return that argument's
// (defaulted) type. Returns -1 when the rule does not apply (concrete result,
// non-generic, or `T` bound to no parameter) so the caller falls back.
// ponytail: bare-`T` results only — a composite `[]T` result is rarer and the
// default `funcResults` path already renders it structurally.
function genericResultAt(c: Checker, name: string, callNode: int): int {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return -1
  }
  // An imported callee's decl indexes ITS module's node arena; reading it
  // against this module's tree is an out-of-range panic at best and a silently
  // unrelated node at worst.
  let oc = declOwner(c, name)
  let dk = kidsOf(oc.tree, decl)
  if (dk[2] == 0 || dk[4] == 0) {
    return -1 // not generic, or no declared result: the plain path handles it
  }
  let rn = getNode(oc.tree, dk[4])
  if (rn.tag != Tag.Ident) {
    return -1
  }
  let rname = oc.source[rn.span.start:rn.span.end]
  if (!isTypeParamName(oc, decl, rname)) {
    return -1
  }
  // Bind the result type-param from a parameter mentioning it — bare (`x: T`) or
  // nested in a generic instance (`p: Pair<T>`).
  let bound = bindTypeParamAtCall(oc, c, callNode, kidsOf(oc.tree, dk[3]), rname)
  if (bound != 0) {
    return bound
  }
  return -1
}

// Whether `name` is a generic free function (has a non-empty `<...>` list).
function isGenericFunc(c: Checker, name: string): bool {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return false
  }
  // The decl may belong to an imported module, whose node indices only mean
  // anything in ITS tree.
  let oc = declOwner(c, name)
  let gp = kidsOf(oc.tree, decl)[2]
  return gp != 0 && len(kidsOf(oc.tree, gp)) > 0
}

// Structurally binds type-param `tpname` from a parameter's type node against a
// concrete argument type: a bare `T` binds directly; `[]T`/`[N]T`/`chan<T>`
// recurse into the element, `map<K,V>` into key then value, `T!E` into the ok
// type. Returns 0 when this parameter does not mention `tpname`.
// `pc` owns `paramNode`'s tree — the module DECLARING the generic, which is not
// the caller's when the generic was imported. `argType` is a TypeId, global to
// the shared context, so it needs no module of its own.
function bindTypeParamFromNode(pc: Checker, paramNode: int, argType: int, tpname: string): int {
  let pn = getNode(pc.tree, paramNode)
  if (pn.tag == Tag.Ident) {
    if (pc.source[pn.span.start:pn.span.end] == tpname) {
      return argType
    }
    return 0
  }
  if (argType == 0) {
    return 0
  }
  let at = pc.ctx.types[argType]
  let pk = kidsOf(pc.tree, paramNode)
  if (pn.tag == Tag.SliceType && at.kind == TypeKind.Slice) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.ArrayType && at.kind == TypeKind.Array) {
    return bindTypeParamFromNode(pc, pk[1], at.elem, tpname)
  }
  if (pn.tag == Tag.ChanType && at.kind == TypeKind.Chan) {
    return bindTypeParamFromNode(pc, pk[0], at.elem, tpname)
  }
  if (pn.tag == Tag.MapType && at.kind == TypeKind.Map) {
    let k = bindTypeParamFromNode(pc, pk[0], at.mapKey, tpname)
    if (k != 0) {
      return k
    }
    return bindTypeParamFromNode(pc, pk[1], at.mapVal, tpname)
  }
  if (pn.tag == Tag.Fallible && at.kind == TypeKind.Fallible) {
    return bindTypeParamFromNode(pc, pk[0], at.result, tpname)
  }
  return 0
}

// A call argument expression's node (unwrapping a named `Arg`), or 0.
function callArgNode(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  if (i >= len(args)) {
    return 0
  }
  let a = args[i]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  return a
}

// The declared type NODE of a call argument: an ident binding's recorded type
// node, or a composite literal's own `Pair<i64>` type. 0 if unknown.
function argTypeNode(c: Checker, argNode: int): int {
  if (argNode == 0) {
    return 0
  }
  let n = getNode(c.tree, argNode)
  if (n.tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    for (k, v) of c.declTypeNodes {
      if (k == name) {
        return v
      }
    }
    return 0
  }
  if (n.tag == Tag.CompositeLit) {
    return kidsOf(c.tree, argNode)[0]
  }
  return 0
}

// Binds `tpname` by structurally matching a parameter type NODE against an
// argument type NODE (both AST): a bare `T` binds to the arg node's type; a
// generic instance `Pair<T>` recurses into matching type-arg positions. Node-based
// because a generic-struct instance TYPE does not carry its type-args (carrying
// them would perturb the type-id parity). Returns 0 if unbound.
// `pnode` (the declared parameter) and `anode` (the call's argument) come from
// DIFFERENT trees whenever the generic was imported, so each side carries its
// own checker. Reading one against the other's tree is the whole bug class this
// exists to avoid.
function bindTypeParamNodeVsNode(pc: Checker, pnode: int, ac: Checker, anode: int, tpname: string): int {
  if (pnode == 0 || anode == 0) {
    return 0
  }
  let pt = getNode(pc.tree, pnode)
  if (pt.tag == Tag.Ident) {
    if (pc.source[pt.span.start:pt.span.end] == tpname) {
      return typeFromNode(ac, anode)
    }
    return 0
  }
  if (pt.tag == Tag.GenericInst && getNode(ac.tree, anode).tag == Tag.GenericInst) {
    let pta = kidsOf(pc.tree, kidsOf(pc.tree, pnode)[1])
    let ata = kidsOf(ac.tree, kidsOf(ac.tree, anode)[1])
    let i = 0
    while (i < len(pta) && i < len(ata)) {
      let b = bindTypeParamNodeVsNode(pc, pta[i], ac, ata[i], tpname)
      if (b != 0) {
        return b
      }
      i = i + 1
    }
  }
  return 0
}

// Binds `tpname` from the first call parameter whose type mentions it: a
// type-based structural match (`[]T`, `map<K,V>`, `T!`) or, for a generic-instance
// param (`Pair<T>`) whose arg type carries no type-args, a node-vs-node match.
// Returns 0 if no parameter binds it.
// `pc` declares the generic (its tree holds `params`); `ac` is the caller (its
// tree holds `callNode`). They are the same checker for a local generic.
function bindTypeParamAtCall(pc: Checker, ac: Checker, callNode: int, params: []int, tpname: string): int {
  let pi = 0
  while (pi < len(params)) {
    let pnode = kidsOf(pc.tree, params[pi])[1]
    let b = bindTypeParamFromNode(pc, pnode, defaultType(ac, checkArgType(ac, callNode, pi)), tpname)
    if (b == 0 && getNode(pc.tree, pnode).tag == Tag.GenericInst) {
      b = bindTypeParamNodeVsNode(pc, pnode, ac, argTypeNode(ac, callArgNode(ac, callNode, pi)), tpname)
    }
    if (b != 0) {
      return b
    }
    pi = pi + 1
  }
  return 0
}

// The concrete type arguments a generic call binds, one per type-parameter, in
// declaration order: each type-param is bound structurally from the first
// parameter whose type mentions it. A type-param bound by no parameter (rare)
// resolves to void.
function genericTypeArgs(c: Checker, name: string, callNode: int): []int {
  let out = []int(0)
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return out
  }
  // The decl's nodes belong to its own module's tree (see declOwner).
  let oc = declOwner(c, name)
  let dk = kidsOf(oc.tree, decl)
  let tps = kidsOf(oc.tree, dk[2])
  let params = kidsOf(oc.tree, dk[3])
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let bound = bindTypeParamAtCall(oc, c, callNode, params, tpname)
    if (bound == 0) {
      bound = c.ctx.voidId
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}

// Whether two type-arg lists are equal.
function typeArgsEqual(a: []int, b: []int): bool {
  if (len(a) != len(b)) {
    return false
  }
  let i = 0
  while (i < len(a)) {
    if (a[i] != b[i]) {
      return false
    }
    i = i + 1
  }
  return true
}

// The project-wide index of the (defining module, name, args) instantiation, or
// -1 if not recorded. The index IS the monomorphized suffix, so it must be the
// same number for every module that calls this generic with these arguments.
function instantiationIndexIn(ctx: TypeContext, mod: int, name: string, args: []int): int {
  let i = 0
  while (i < len(ctx.instantiations)) {
    let inst = ctx.instantiations[i]
    if (inst.module == mod && inst.name == name && typeArgsEqual(inst.args, args)) {
      return i
    }
    i = i + 1
  }
  return -1
}

// The index of `name`'s (args) instantiation as seen from `c` — resolving where
// the generic is actually declared, so a caller and the definer agree.
function instantiationIndex(c: Checker, name: string, args: []int): int {
  return instantiationIndexIn(c.ctx, declOwner(c, name).moduleId, declName2(c, name), args)
}

// Records a generic-function instantiation the first time its (module, name,
// args) combo is seen, preserving discovery order (the monomorphized index).
function recordInstantiation(c: Checker, name: string, args: []int) {
  if (instantiationIndex(c, name, args) == -1) {
    c.ctx.instantiations = append(c.ctx.instantiations,
      Instantiation{ module: declOwner(c, name).moduleId, name: declName2(c, name), args: args })
  }
}

function isUntyped(c: Checker, t: int): bool {
  return t == c.ctx.untypedIntId || t == c.ctx.untypedFloatId || t == c.ctx.untypedRuneId ||
    t == c.ctx.untypedBoolId || t == c.ctx.untypedStringId || t == c.ctx.untypedNilId
}

// The result type of a binary arithmetic/bitwise operator: an untyped operand
// takes the other's concrete type; matching types stay; otherwise the left one.
function mergeTypes(c: Checker, a: int, b: int): int {
  if (a == b) {
    return a
  }
  if (isUntyped(c, a) && !isUntyped(c, b)) {
    return b
  }
  if (isUntyped(c, b) && !isUntyped(c, a)) {
    return a
  }
  return a
}

function isComparisonOp(op: int): bool {
  return op == int(Kind.EqEq) || op == int(Kind.BangEq) || op == int(Kind.Lt) ||
    op == int(Kind.Gt) || op == int(Kind.LtEq) || op == int(Kind.GtEq) ||
    op == int(Kind.AmpAmp) || op == int(Kind.PipePipe)
}

// The prim-enum index for a predeclared type name, or -1 if not a primitive.
// Includes the size aliases (`int`/`uint`/`byte`/`rune`) that map onto a prim.
function primIndexByName(name: string): int {
  if (name == "i8") { return 0 }
  if (name == "i16") { return 1 }
  if (name == "i32") { return 2 }
  if (name == "i64") { return 3 }
  if (name == "u8") { return 4 }
  if (name == "u16") { return 5 }
  if (name == "u32") { return 6 }
  if (name == "u64") { return 7 }
  if (name == "f32") { return 8 }
  if (name == "f64") { return 9 }
  if (name == "bool") { return 10 }
  if (name == "string") { return 11 }
  if (name == "int") { return 3 }
  if (name == "uint") { return 7 }
  if (name == "byte") { return 4 }
  if (name == "rune") { return 2 }
  return -1
}

// The default concrete type of an untyped value (spec §15.4): int→i64, float→f64,
// rune→i32, bool→bool, string→string; anything else is unchanged.
function defaultType(c: Checker, ty: int): int {
  if (ty == c.ctx.untypedIntId) { return primType(c.ctx, 3) }
  if (ty == c.ctx.untypedFloatId) { return primType(c.ctx, 9) }
  if (ty == c.ctx.untypedRuneId) { return primType(c.ctx, 2) }
  if (ty == c.ctx.untypedBoolId) { return primType(c.ctx, 10) }
  if (ty == c.ctx.untypedStringId) { return primType(c.ctx, 11) }
  return ty
}

// Infers a type-annotation node to a TypeId. Primitives and simple composites
// (slice/array/map/chan) are handled here; named types need resolve and infer
// to invalid (0) for now.
function typeFromNode(c: Checker, node: int): int {
  if (node == 0) {
    return 0
  }
  let n = getNode(c.tree, node)
  let tag = n.tag
  if (tag == Tag.Ident) {
    let name = c.source[n.span.start:n.span.end]
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    // The predeclared `error` interface (§10.6) is a builtin, not a user type.
    if (name == "error") {
      return c.ctx.errorId
    }
    return resolveNamed(c, name)
  }
  let kids = kidsOf(c.tree, node)
  if (tag == Tag.SliceType) {
    return mkSlice(c.ctx, typeFromNode(c, kids[0]))
  }
  if (tag == Tag.ChanType) {
    return mkChan(c.ctx, typeFromNode(c, kids[0]))
  }
  if (tag == Tag.MapType) {
    return mkMap(c.ctx, typeFromNode(c, kids[0]), typeFromNode(c, kids[1]))
  }
  if (tag == Tag.ArrayType) {
    let sn = getNode(c.tree, kids[0])
    return mkArray(c.ctx, parseIntText(c.source[sn.span.start:sn.span.end]), typeFromNode(c, kids[1]))
  }
  if (tag == Tag.VoidType) {
    return c.ctx.voidId
  }
  // A generic instance `Name<...>` renders by its base name (the seed omits the
  // type arguments in --dump-types), so resolve to the base named type.
  if (tag == Tag.GenericInst) {
    return resolveNamed(c, typeNodeName(c, node))
  }
  // A fallible result `T!` / `T!E` — the error defaults to the `error` interface.
  if (tag == Tag.Fallible) {
    let errT = c.ctx.errorId
    if (kids[1] != 0) {
      errT = typeFromNode(c, kids[1])
    }
    return mkFallible(c.ctx, typeFromNode(c, kids[0]), errT)
  }
  // A function type `(P, Q) => R` (func_type `[type_list, result]`).
  if (tag == Tag.FuncType) {
    let params = []int(0)
    let plist = kidsOf(c.tree, kids[0])
    let pi = 0
    while (pi < len(plist)) {
      params = append(params, typeFromNode(c, plist[pi]))
      pi = pi + 1
    }
    return mkFunc(c.ctx, params, false, typeFromNode(c, kids[1]))
  }
  return 0
}

// The value of a digit char in a radix up to 16, or -1 if not a digit (so
// underscores and separators are skipped by the caller).
function digitValue(ch: u8): int {
  if (ch >= '0' && ch <= '9') {
    return int(ch) - 48
  }
  if (ch >= 'a' && ch <= 'f') {
    return int(ch) - 87
  }
  if (ch >= 'A' && ch <= 'F') {
    return int(ch) - 55
  }
  return -1
}

// Parses an integer literal's value, honoring a `0x`/`0b`/`0o` radix prefix and
// skipping `_` separators (§5.4). Used for array sizes and const_int lowering.
function parseIntText(s: string): int {
  let radix = 10
  let start = 0
  if (len(s) >= 2 && s[0] == '0') {
    let c = s[1]
    if (c == 'x' || c == 'X') {
      radix = 16
      start = 2
    } else if (c == 'b' || c == 'B') {
      radix = 2
      start = 2
    } else if (c == 'o' || c == 'O') {
      radix = 8
      start = 2
    }
  }
  let n = 0
  let i = start
  while (i < len(s)) {
    let d = digitValue(s[i])
    if (d >= 0 && d < radix) {
      n = n * radix + d
    }
    i = i + 1
  }
  return n
}

// The code point of a rune literal `'c'` (§5.4): a bare byte/UTF-8 sequence or a
// `\n`/`\x41`/`\u{1F600}`-style escape. Mirrors the seed's parseRuneLiteral.
function parseRuneText(s: string): int {
  if (len(s) < 3) {
    return 0
  }
  let c0 = int(s[1])
  if (s[1] != '\\') {
    // A bare code point: ASCII is one byte; a multi-byte UTF-8 lead byte
    // (110/1110/11110xxxx) is decoded with its continuation bytes.
    if (c0 < 0x80) {
      return c0
    }
    if (c0 >= 0xF0 && len(s) >= 6) {
      return (c0 - 0xF0) * 0x40000 + (int(s[2]) - 0x80) * 0x1000 + (int(s[3]) - 0x80) * 0x40 + (int(s[4]) - 0x80)
    }
    if (c0 >= 0xE0 && len(s) >= 5) {
      return (c0 - 0xE0) * 0x1000 + (int(s[2]) - 0x80) * 0x40 + (int(s[3]) - 0x80)
    }
    if (c0 >= 0xC0 && len(s) >= 4) {
      return (c0 - 0xC0) * 0x40 + (int(s[2]) - 0x80)
    }
    return c0
  }
  let e = s[2]
  if (e == 'n') { return 10 }
  if (e == 'r') { return 13 }
  if (e == 't') { return 9 }
  if (e == '\\') { return 92 }
  if (e == '\'') { return 39 }
  if (e == '"') { return 34 }
  if (e == '0') { return 0 }
  if (e == 'x' && len(s) >= 6) {
    return digitValue(s[3]) * 16 + digitValue(s[4])
  }
  if (e == 'u') {
    // `\u{HEX}`: the hex digits between the braces.
    let n = 0
    let i = 4
    while (i < len(s) && s[i] != '}') {
      let d = digitValue(s[i])
      if (d >= 0) {
        n = n * 16 + d
      }
      i = i + 1
    }
    return n
  }
  return 0
}

// The predeclared builtins that return void `()` (spec §5.3). Their call
// expressions type as the void id regardless of arguments.
function builtinReturnsVoid(name: string): bool {
  return name == "print" || name == "panic" || name == "assert" ||
    name == "close" || name == "delete"
}

// The result type of a runtime-primitive builtin (compiler/check.zig `prim_sigs`
// / the ABI runtime surface), or -1 for a non-builtin. Only the result matters
// for `--dump-types`; the argument prims are the codegen contract, not ours.
function builtinResultType(c: Checker, name: string): int {
  if (name == "fsReadAll" || name == "fsRead" || name == "fsListDir" ||
    name == "netRead" || name == "netUdpRecv" || name == "netUdpSenderHost" ||
    name == "netResolve" || name == "osArgAt" || name == "osEnv" ||
    name == "cryptoRandomBytes") {
    return primType(c.ctx, 11)
  }
  if (name == "fsOpen" || name == "fsWrite" || name == "fsClose" || name == "fsAppend" ||
    name == "fsMkdir" || name == "fsRemove" || name == "netListen" || name == "netLocalPort" ||
    name == "netAccept" || name == "netDial" || name == "netWrite" || name == "netUdpBind" ||
    name == "netUdpSend" || name == "netUdpSenderPort" || name == "timeMonoNs" ||
    name == "timeUnixNs" || name == "osArgc") {
    return primType(c.ctx, 3)
  }
  if (name == "fsExists" || name == "fsIsDir") {
    return primType(c.ctx, 10)
  }
  if (name == "fsqrt" || name == "ffloor" || name == "fceil" || name == "fround" ||
    name == "ftrunc" || name == "fpow" || name == "fatan2" || name == "flog" ||
    name == "flog2" || name == "flog10" || name == "parseFloat") {
    return primType(c.ctx, 9)
  }
  // fsChmod(path: string, mode: i64) -> i64 (0 ok, -1 err).
  if (name == "fsChmod") {
    return primType(c.ctx, 3)
  }
  // floatBits(v: f64) -> u64, float32Bits(v: f32) -> u32.
  if (name == "floatBits") {
    return primType(c.ctx, 7)
  }
  if (name == "float32Bits") {
    return primType(c.ctx, 6)
  }
  if (name == "timeSleepNs" || name == "osExit" || name == "cryptoSecureZero") {
    return c.ctx.voidId
  }
  return -1
}

// Infers a call expression's result type: a void builtin is `()`; a top-level
// function call is its declared result; `chan<T>(n)`/`map<K,V>{}`-style
// constructors are the constructed type. Unknown callees infer to invalid (0).
function checkCall(c: Checker, node: int): int {
  let callee = kidsOf(c.tree, node)[0]
  let cn = getNode(c.tree, callee)
  if (cn.tag == Tag.Ident) {
    let name = c.source[cn.span.start:cn.span.end]
    if (builtinReturnsVoid(name)) {
      return c.ctx.voidId
    }
    // `len`/`cap` always yield i64 regardless of argument.
    if (name == "len" || name == "cap") {
      return primType(c.ctx, 3)
    }
    // `append(slice, ...)` yields the slice's type (its first argument's).
    if (name == "append") {
      return checkArgType(c, node, 0)
    }
    // A runtime-primitive builtin (`cryptoRandomBytes`, `fsReadAll`, ...).
    let bt = builtinResultType(c, name)
    if (bt != -1) {
      return bt
    }
    // A generic call `identity(42)` whose result is a bare type parameter binds
    // that parameter from the matching argument's type.
    let g = genericResultAt(c, name, node)
    if (g != -1) {
      return g
    }
    let r = funcResultLookup(c, name)
    if (r != 0) {
      return r
    }
    // A primitive name used as a call is a conversion: `f64(x)` -> f64.
    let p = primIndexByName(name)
    if (p >= 0) {
      return primType(c.ctx, p)
    }
    // Calling a func-typed value `f(...)` yields the value's result type.
    let ev = envLookup(c, name)
    if (ev != 0 && c.ctx.types[ev].kind == TypeKind.Func) {
      return c.ctx.types[ev].result
    }
    return 0
  }
  // `chan<T>(n)` / `[]T(n)` / `map<K,V>()` — the callee is a type node, so the
  // result is that type.
  if (cn.tag == Tag.ChanType || cn.tag == Tag.SliceType || cn.tag == Tag.MapType || cn.tag == Tag.ArrayType) {
    return typeFromNode(c, callee)
  }
  if (cn.tag == Tag.Member) {
    let mk = kidsOf(c.tree, callee)
    // Enum variant constructor `Enum.Variant(...)` / `Enum<T>.Variant(...)`.
    let baseName = typeNodeName(c, mk[0])
    if (baseName != "") {
      let ut = userTypeLookup(c, baseName)
      if (ut != 0 && c.ctx.types[ut].kind == TypeKind.Enum) {
        return ut
      }
    }
    // Method call `recv.method(...)` -> the method's declared result. A
    // constrained type parameter dispatches through its constraint interface.
    let recvType = checkExprType(c, mk[0])
    if (recvType != 0) {
      let mn = getNode(c.tree, mk[1])
      let key = "${methodRecvType(c, recvType)}." + c.source[mn.span.start:mn.span.end]
      return methodResultLookup(c, key)
    }
  }
  return 0
}

// The inferred type of a call's `i`-th argument (unwrapping the `arg` node).
function checkArgType(c: Checker, callNode: int, i: int): int {
  let args = kidsOf(c.tree, kidsOf(c.tree, callNode)[2])
  if (i >= len(args)) {
    return 0
  }
  let a = args[i]
  if (getNode(c.tree, a).tag == Tag.Arg) {
    a = kidsOf(c.tree, a)[0]
  }
  return checkExprType(c, a)
}

// A receive `<-ch` yields the channel's element type; other unary operators
// (`-`/`+`/`~`) preserve the operand type, and `!` yields its (bool) operand.
function checkUnary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let ot = checkExprType(c, kidsOf(c.tree, node)[0])
  if (n.main == int(Kind.ArrowLeft)) {
    if (ot != 0 && c.ctx.types[ot].kind == TypeKind.Chan) {
      return c.ctx.types[ot].elem
    }
    return 0
  }
  return ot
}

// Arithmetic/bitwise binaries merge their operand types; comparisons and logical
// operators yield an (untyped) boolean.
function checkBinary(c: Checker, node: int): int {
  let n = getNode(c.tree, node)
  let kids = kidsOf(c.tree, node)
  let a = checkExprType(c, kids[0])
  let b = checkExprType(c, kids[1])
  if (isComparisonOp(n.main)) {
    return c.ctx.untypedBoolId
  }
  return mergeTypes(c, a, b)
}

// Infers an expression's (possibly untyped) type. Literals and void-builtin
// calls for now; every other construct infers to invalid (0) until its
// inference lands.
function checkExprType(c: Checker, node: int): int {
  let tag = getNode(c.tree, node).tag
  if (tag == Tag.IntLit) { return c.ctx.untypedIntId }
  if (tag == Tag.FloatLit) { return c.ctx.untypedFloatId }
  if (tag == Tag.RuneLit) { return c.ctx.untypedRuneId }
  if (tag == Tag.BoolLit) { return c.ctx.untypedBoolId }
  if (tag == Tag.StringLit || tag == Tag.RawStringLit) { return c.ctx.untypedStringId }
  if (tag == Tag.NilLit) { return c.ctx.untypedNilId }
  // A string interpolation `"...${x}..."` is a concrete string.
  if (tag == Tag.StrInterp) { return primType(c.ctx, 11) }
  if (tag == Tag.Ident) {
    let sp = getNode(c.tree, node).span
    let name = c.source[sp.start:sp.end]
    let e = envLookup(c, name)
    if (e != 0) {
      return e
    }
    // A bare reference to a top-level function is a first-class func value.
    return funcSigLookup(c, name)
  }
  if (tag == Tag.Unary) { return checkUnary(c, node) }
  if (tag == Tag.Binary) { return checkBinary(c, node) }
  if (tag == Tag.Call) { return checkCall(c, node) }
  if (tag == Tag.SliceLit) { return checkSliceLit(c, node) }
  // A composite literal `Name{...}` / `map<K,V>{...}` / `[]T{...}` has the type
  // of its type node.
  if (tag == Tag.CompositeLit) { return typeFromNode(c, kidsOf(c.tree, node)[0]) }
  if (tag == Tag.Index) { return checkIndex(c, node) }
  if (tag == Tag.Member) { return checkMember(c, node) }
  // A type assertion `x.(T)` yields the asserted type.
  if (tag == Tag.TypeAssert) { return typeFromNode(c, kidsOf(c.tree, node)[1]) }
  // A match expression's type is its arms' body type (all arms agree).
  if (tag == Tag.MatchStmt) { return checkMatch(c, node) }
  if (tag == Tag.SliceExpr) { return checkSliceExpr(c, node) }
  if (tag == Tag.ArrowFn) { return checkArrowFn(c, node) }
  // `e?` / `e catch d` / `e catch x { … }` all unwrap the operand's fallible
  // type `T!` to its success type `T`.
  if (tag == Tag.TryExpr || tag == Tag.CatchDefault || tag == Tag.CatchBind) {
    return unwrapFallible(c, checkExprType(c, kidsOf(c.tree, node)[0]))
  }
  return 0
}

// The success type of a fallible `T!`, or the type unchanged if not fallible.
function unwrapFallible(c: Checker, t: int): int {
  if (t != 0 && c.ctx.types[t].kind == TypeKind.Fallible) {
    return c.ctx.types[t].result
  }
  return t
}

// A closure `(x: T, ...) => body` has function type `(T, ...) => R`, R the
// (defaulted) type of its body. ponytail: annotated params only — an untyped
// param would need the expected-type context the seed threads through.
function checkArrowFn(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let params = []int(0)
  let ps = kidsOf(c.tree, kids[0])
  let i = 0
  while (i < len(ps)) {
    let pk = kidsOf(c.tree, ps[i])
    let pt = 0
    if (pk[1] != 0) {
      pt = typeFromNode(c, pk[1])
    }
    params = append(params, pt)
    i = i + 1
  }
  return mkFunc(c.ctx, params, false, checkExprType(c, kids[1]))
}

// `a[i:j]` preserves a slice/string type; slicing an array yields a slice of its
// element.
function checkSliceExpr(c: Checker, node: int): int {
  let rt = checkExprType(c, kidsOf(c.tree, node)[0])
  if (rt == 0) {
    return 0
  }
  let t = c.ctx.types[rt]
  if (t.kind == TypeKind.Slice) {
    return rt
  }
  if (t.kind == TypeKind.Array) {
    return mkSlice(c.ctx, t.elem)
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return rt
  }
  return 0
}

// Binds an identifier node's name to a type in the scope env.
function envBind(c: Checker, identNode: int, ty: int) {
  let n = getNode(c.tree, identNode)
  c.env[c.source[n.span.start:n.span.end]] = ty
}

// The element type yielded by iterating a value: a slice/array element, or a
// rune (i32) for a string. ponytail: rune-iteration is a guess — for-of binders
// are typed for env resolution only, never dumped, so a wrong string element
// cannot diverge the output unless the binder feeds a dumped call.
function elementType(c: Checker, iterT: int): int {
  if (iterT == 0) {
    return 0
  }
  let t = c.ctx.types[iterT]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
    return t.elem
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return primType(c.ctx, 2)
  }
  return 0
}

// Types a `for x of it` / `for (k, v) of it` loop binder into env so the loop
// body resolves it. A tuple binder over a map yields (key, value); over a
// slice/array it yields (index i64, element).
function typeForOfBinder(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let binder = kids[0]
  let iterT = checkExprType(c, kids[1])
  if (getNode(c.tree, binder).tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, binder)
    if (len(subs) == 2 && iterT != 0) {
      let t = c.ctx.types[iterT]
      if (t.kind == TypeKind.Map) {
        envBind(c, subs[0], t.mapKey)
        envBind(c, subs[1], t.mapVal)
      } else if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
        envBind(c, subs[0], primType(c.ctx, 3))
        envBind(c, subs[1], t.elem)
      }
    }
    return
  }
  envBind(c, binder, elementType(c, iterT))
}

// A match expression yields the type of its (first) arm's body.
function checkMatch(c: Checker, node: int): int {
  let arms = kidsOf(c.tree, kidsOf(c.tree, node)[1])
  if (len(arms) == 0) {
    return 0
  }
  return checkExprType(c, kidsOf(c.tree, arms[0])[1])
}

// `a[i]` yields the element/value type: slice/array element, map value, or a
// byte (u8) for a string.
function checkIndex(c: Checker, node: int): int {
  let rt = checkExprType(c, kidsOf(c.tree, node)[0])
  if (rt == 0) {
    return 0
  }
  let t = c.ctx.types[rt]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array) {
    return t.elem
  }
  if (t.kind == TypeKind.Map) {
    return t.mapVal
  }
  if (t.kind == TypeKind.Prim && t.prim == 11) {
    return primType(c.ctx, 4)
  }
  return 0
}

// `Enum.Variant` yields the enum type. Struct field access needs the field
// table (not yet stored) and infers to invalid.
function checkMember(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  let recv = kids[0]
  // Enum-variant access `Enum.Variant` / `Enum<T>.Variant` -> the enum type.
  let baseName = typeNodeName(c, recv)
  if (baseName != "") {
    let ut = userTypeLookup(c, baseName)
    if (ut != 0 && c.ctx.types[ut].kind == TypeKind.Enum) {
      return ut
    }
  }
  let rt = checkExprType(c, recv)
  if (rt != 0) {
    let mn = getNode(c.tree, kids[1])
    let mname = c.source[mn.span.start:mn.span.end]
    let recvKey = "${methodRecvType(c, rt)}"
    // Struct field access `value.field`.
    if (c.ctx.types[rt].kind == TypeKind.Struct) {
      let ft = structFieldLookup(c, recvKey + "." + mname)
      if (ft != 0) {
        return ft
      }
    }
    // An uncalled method value `value.method` -> the method's func type.
    return methodSigLookup(c, recvKey + "." + mname)
  }
  return 0
}

// Registers a struct/enum/interface declaration as a named type so references
// to it resolve. Called in a pre-pass (types may be referenced before their
// declaration, §9).
function registerNamedType(c: Checker, name: string, kind: TypeKind) {
  let t = leafType(kind)
  t.name = name
  t.hasName = true
  c.userTypes[name] = addType(c.ctx, t)
}

// The source text of a declaration's name (kid 0 is the name leaf).
function declName(c: Checker, node: int): string {
  let nm = getNode(c.tree, kidsOf(c.tree, node)[0])
  return c.source[nm.span.start:nm.span.end]
}

// An untyped slice literal `[a, b, ...]` is `[]E`, E the (defaulted) type of its
// first element. ponytail: first element only — a heterogeneous literal would
// need element unification, which the checker rejects anyway.
function checkSliceLit(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0) {
    return 0
  }
  let first = kids[0]
  if (getNode(c.tree, first).tag == Tag.Arg) {
    first = kidsOf(c.tree, first)[0]
  }
  return mkSlice(c.ctx, defaultType(c, checkExprType(c, first)))
}

// Types one `binding` node ([pat, annotation, init]): an explicit annotation
// wins; otherwise the initializer's type is defaulted to concrete. The pattern
// node carries the result so the dump reads it back.
// `let (v, ok) = <-ch` / `= m[k]` — the value binder gets the received/indexed
// element, the `ok` binder a bool.
function checkCommaOk(c: Checker, pat: int, init: int) {
  let binders = kidsOf(c.tree, pat)
  if (len(binders) != 2 || init == 0) {
    return
  }
  let inNode = getNode(c.tree, init)
  let valType = 0
  if (inNode.tag == Tag.Unary && inNode.main == int(Kind.ArrowLeft)) {
    let chT = checkExprType(c, kidsOf(c.tree, init)[0])
    if (chT != 0 && c.ctx.types[chT].kind == TypeKind.Chan) {
      valType = c.ctx.types[chT].elem
    }
  } else if (inNode.tag == Tag.Index) {
    valType = checkIndex(c, init)
  } else if (inNode.tag == Tag.TypeAssert) {
    // `let (v, ok) = x.(T)` narrows to T with a success flag.
    valType = typeFromNode(c, kidsOf(c.tree, init)[1])
  }
  c.nodeTypes[binders[0]] = valType
  c.nodeTypes[binders[1]] = primType(c.ctx, 10)
}

function checkBinding(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let pat = kids[0]
  let ann = kids[1]
  let init = kids[2]
  if (getNode(c.tree, pat).tag == Tag.TuplePat) {
    checkCommaOk(c, pat, init)
    return
  }
  let ty = 0
  if (ann != 0) {
    ty = typeFromNode(c, ann)
  } else if (init != 0) {
    ty = defaultType(c, checkExprType(c, init))
  }
  c.nodeTypes[pat] = ty
  // Record a simple-ident binding so later expressions resolve it.
  let pn = getNode(c.tree, pat)
  if (pn.tag == Tag.Ident) {
    let bname = c.source[pn.span.start:pn.span.end]
    c.env[bname] = ty
    // Record the binding's declared type NODE (annotation, or a composite
    // literal's `Pair<i64>` type) so a generic call passing this binding can
    // recover its type-args (`firstOf(p)` binds T from p's `Pair<i64>`).
    let tnode = ann
    if (tnode == 0 && init != 0 && getNode(c.tree, init).tag == Tag.CompositeLit) {
      tnode = kidsOf(c.tree, init)[0]
    }
    if (tnode != 0) {
      c.declTypeNodes[bname] = tnode
    }
  }
}

// Walks every node and types the bindings. (arrow-param and call typing land
// with expression inference; a flat arena walk catches bindings at any nesting.)
// Resolves a named-type reference, reserving+resolving it on first touch if it
// is a not-yet-seen forward reference (the seed's declTypeOf recursion). After
// the collect pass every named type is reserved, so this is a plain lookup.
function resolveNamed(c: Checker, name: string): int {
  let id = userTypeLookup(c, name)
  if (id != 0) {
    return id
  }
  if (c.typeDecls[name] != 0) {
    return declTypeOf(c, name)
  }
  return 0
}

// Registers a `<T, U: Bound>` list: every param name first (each a distinct
// named TypeParam), then each constraint interface — matching the seed's
// buildOwnGenericEnv two-loop order so ids line up.
function registerGenerics(c: Checker, genNode: int) {
  if (genNode == 0) {
    return
  }
  let ps = kidsOf(c.tree, genNode)
  let i = 0
  while (i < len(ps)) {
    let nm = getNode(c.tree, kidsOf(c.tree, ps[i])[0])
    // Each decl's type params are distinct ids (the seed's per-symbol
    // typeParamId), even when two decls share a param name — reusing an id would
    // undercount and shift a later named type. userTypes[name] is overwritten to
    // this decl's param, which is correct: members resolve against the decl being
    // built, and a template body's param id never reaches a dump (monomorphized).
    registerNamedType(c, c.source[nm.span.start:nm.span.end], TypeKind.TypeParam)
    i = i + 1
  }
  i = 0
  while (i < len(ps)) {
    let gk = kidsOf(c.tree, ps[i])
    if (gk[1] != 0) {
      let cons = kidsOf(c.tree, gk[1])
      if (len(cons) > 0) {
        let nm = getNode(c.tree, gk[0])
        c.typeParamConstraints[c.source[nm.span.start:nm.span.end]] = typeFromNode(c, cons[0])
      }
    }
    i = i + 1
  }
}

// Resolves a struct's field types into `structFields` (interning each in field
// order). An exported field is wrapped `export[field[name, type]]`.
function resolveStructFields(c: Checker, node: int, sname: string) {
  let fields = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let fi = 0
  while (fi < len(fields)) {
    let fld = fields[fi]
    if (getNode(c.tree, fld).tag == Tag.Export) {
      fld = kidsOf(c.tree, fld)[0]
    }
    let fk = kidsOf(c.tree, fld)
    let fnn = getNode(c.tree, fk[0])
    c.ctx.structFields["${userTypeLookup(c, sname)}." + c.source[fnn.span.start:fnn.span.end]] = typeFromNode(c, fk[1])
    fi = fi + 1
  }
}

// Interns an enum's variant payload types (in variant then payload order) for
// their id side effects — matching the seed's buildEnumTemplate — and records on
// the type whether any variant carries a payload (so the value is boxed), which
// codegen reads to classify GC references. Variant info itself is read from the
// decl node elsewhere, so nothing else is recorded here.
function resolveEnumPayloads(c: Checker, node: int, enumTy: int) {
  let vs = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let i = 0
  while (i < len(vs)) {
    let payload = kidsOf(c.tree, vs[i])[1]
    if (payload != 0) {
      c.ctx.types[enumTy].enumBoxed = true
      let types = kidsOf(c.tree, payload)
      let j = 0
      while (j < len(types)) {
        typeFromNode(c, types[j])
        j = j + 1
      }
    }
    i = i + 1
  }
}

// Resolves an interface's method results into methodResults, interning each
// sig's params (source order) then result — the seed's walk. The func-type sig
// wrapper is deferred to buildSignatures (see collectFuncDecl).
function resolveInterfaceSigs(c: Checker, node: int, iname: string) {
  let sigs = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let mi = 0
  while (mi < len(sigs)) {
    let mk = kidsOf(c.tree, sigs[mi])
    let mnn = getNode(c.tree, mk[0])
    paramTypeIds(c, mk[1])
    let mres = c.ctx.voidId
    if (mk[2] != 0) {
      mres = typeFromNode(c, mk[2])
    }
    c.ctx.methodResults["${userTypeLookup(c, iname)}." + c.source[mnn.span.start:mnn.span.end]] = mres
    mi = mi + 1
  }
}

// The seed's declTypeOf: reserves `name`'s TypeId (memoized via userTypes
// presence) BEFORE resolving its members, so members' composites/forward-named
// refs intern after it (source touch order) and self/mutual references
// terminate. An alias resolves transparently to its underlying (no reserved id).
function declTypeOf(c: Checker, name: string): int {
  let existing = userTypeLookup(c, name)
  if (existing != 0) {
    return existing
  }
  let node = c.typeDecls[name]
  if (node == 0) {
    return 0
  }
  let dn = getNode(c.tree, node)
  let k = kidsOf(c.tree, node)
  if (dn.tag == Tag.TypeAlias) {
    let u = typeFromNode(c, k[2])
    c.userTypes[name] = u
    return u
  }
  let kind = TypeKind.Struct
  if (dn.tag == Tag.EnumDecl) {
    kind = TypeKind.Enum
  } else if (dn.tag == Tag.InterfaceDecl) {
    kind = TypeKind.Interface
  }
  registerNamedType(c, name, kind)
  registerGenerics(c, k[1])
  if (dn.tag == Tag.StructDecl) {
    resolveStructFields(c, node, name)
  } else if (dn.tag == Tag.EnumDecl) {
    resolveEnumPayloads(c, node, userTypeLookup(c, name))
  } else if (dn.tag == Tag.InterfaceDecl) {
    resolveInterfaceSigs(c, node, name)
  }
  return userTypeLookup(c, name)
}

// The seed's collectFuncDecl: interns a function's signature composites in touch
// order — generics, then params (source order), then result, then (for a method)
// the receiver — and records its result + decl. The `(params)=>result` func-type
// id itself is NOT minted here (the seed stores a FuncShape, not a TypeId, so a
// sig wrapper would wrongly consume an id before later named types); it is built
// afterward by buildSignatures.
function collectFuncDecl(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name, generics, params, result, body]
  registerGenerics(c, kids[2])
  paramTypeIds(c, kids[3])
  let rty = c.ctx.voidId
  if (kids[4] != 0) {
    rty = typeFromNode(c, kids[4])
  }
  let nm = getNode(c.tree, kids[1])
  let fname = c.source[nm.span.start:nm.span.end]
  if (kids[0] != 0) {
    let recvType = typeNodeName(c, kidsOf(c.tree, kids[0])[1])
    resolveNamed(c, recvType)
    c.ctx.methodResults["${userTypeLookup(c, recvType)}.${fname}"] = rty
  } else {
    c.funcResults[fname] = rty
    c.funcDecls[fname] = node
  }
}

// Builds the `(params)=>result` func-type id for every free function, method, and
// interface method, filling funcSigs/methodSigs. Runs AFTER the collect pass so a
// sig wrapper's id lands past every named type (the seed mints these lazily, at
// the same relative position) — keeping named-type ids in touch order.
function buildSignatures(c: Checker) {
  let m = 1
  while (m < len(c.tree.nodes)) {
    let n = getNode(c.tree, m)
    if (n.tag == Tag.FuncDecl) {
      let kids = kidsOf(c.tree, m)
      let rty = c.ctx.voidId
      if (kids[4] != 0) {
        rty = typeFromNode(c, kids[4])
      }
      let sig = funcTypeFromParams(c, kids[3], rty)
      let nm = getNode(c.tree, kids[1])
      let fname = c.source[nm.span.start:nm.span.end]
      if (kids[0] != 0) {
        c.ctx.methodSigs["${userTypeLookup(c, typeNodeName(c, kidsOf(c.tree, kids[0])[1]))}.${fname}"] = sig
      } else {
        c.funcSigs[fname] = sig
      }
    } else if (n.tag == Tag.InterfaceDecl) {
      let iname = declName(c, m)
      let sigs = kidsOf(c.tree, kidsOf(c.tree, m)[2])
      let mi = 0
      while (mi < len(sigs)) {
        let mk = kidsOf(c.tree, sigs[mi])
        let mnn = getNode(c.tree, mk[0])
        let mres = c.ctx.voidId
        if (mk[2] != 0) {
          mres = typeFromNode(c, mk[2])
        }
        c.ctx.methodSigs["${userTypeLookup(c, iname)}." + c.source[mnn.span.start:mnn.span.end]] = funcTypeFromParams(c, mk[1], mres)
        mi = mi + 1
      }
    }
    m = m + 1
  }
}

function checkModule(c: Checker) {
  // The predeclared `error` interface's method `message(): string` (§10.6), so
  // `e.message()` on a caught error resolves like any interface method.
  c.ctx.methodResults["${c.ctx.errorId}.message"] = primType(c.ctx, 11)
  // Pre-scan: record every named type's decl node so a forward reference during
  // the collect pass can reserve+resolve it on first touch (§9: order-independent
  // top-level declarations).
  let t = 1
  while (t < len(c.tree.nodes)) {
    let dt = getNode(c.tree, t).tag
    if (dt == Tag.StructDecl || dt == Tag.EnumDecl || dt == Tag.InterfaceDecl || dt == Tag.TypeAlias) {
      c.typeDecls[declName(c, t)] = t
    }
    t = t + 1
  }
  // Collect pass: assign type ids in the seed's source touch order. A top-level
  // decl node's arena index falls between its own children and the next decl's,
  // so ascending iteration visits decls in source order. A type decl reserves its
  // id then resolves members inline (declTypeOf); a func decl interns its
  // signature (collectFuncDecl). Composites dedup; forward-named refs reserve on
  // first touch — reproducing the seed's declTypeOf/collectFuncDecl id order so
  // method-name mangling `name$t{recvId}` lines up.
  let m = 1
  while (m < len(c.tree.nodes)) {
    let mt = getNode(c.tree, m).tag
    if (mt == Tag.StructDecl || mt == Tag.EnumDecl || mt == Tag.InterfaceDecl || mt == Tag.TypeAlias) {
      declTypeOf(c, declName(c, m))
    } else if (mt == Tag.FuncDecl) {
      collectFuncDecl(c, m)
    }
    m = m + 1
  }
  // After every named/composite id is fixed, build the func-type sig wrappers
  // (their ids land past all named types, so they never perturb touch order).
  buildSignatures(c)
  // Pre-pass 3: type params and for-of loop binders into env before the main
  // sweep. A loop header sits *after* its body in arena order, so typing binders
  // in the main sweep would be too late; params precede their loops, so this
  // ascending sweep resolves a param-typed iterable before its loop.
  let p3 = 1
  while (p3 < len(c.tree.nodes)) {
    let pn = getNode(c.tree, p3)
    if (pn.tag == Tag.Param || pn.tag == Tag.Receiver) {
      // A param `(x: T)` or a method receiver `(s: S)`: bind its name to its
      // declared type so the body resolves it.
      let pk = kidsOf(c.tree, p3)
      let nm = getNode(c.tree, pk[0])
      c.env[c.source[nm.span.start:nm.span.end]] = typeFromNode(c, pk[1])
    } else if (pn.tag == Tag.ForOf) {
      typeForOfBinder(c, p3)
    } else if (pn.tag == Tag.CatchBind) {
      // `catch e { … }` binds the caught error as the `error` interface.
      envBind(c, kidsOf(c.tree, p3)[1], c.ctx.errorId)
    }
    p3 = p3 + 1
  }
  // Main pass, in arena (source) order so a param/binding is recorded before the
  // expressions that reference it.
  let i = 1
  while (i < len(c.tree.nodes)) {
    let tag = getNode(c.tree, i).tag
    if (tag == Tag.Param) {
      let kids = kidsOf(c.tree, i)
      let nm = getNode(c.tree, kids[0])
      c.env[c.source[nm.span.start:nm.span.end]] = typeFromNode(c, kids[1])
    } else if (tag == Tag.ArrowP) {
      // An annotated closure parameter: type it (and bind it so the body can
      // reference it). Children precede parents in arena order, so this runs
      // before the arrow body and enclosing binding are typed. An arrow
      // speculation that failed (a plain `(expr)`) leaves an orphan untyped
      // ArrowP in the arena; guard the env write so it cannot clobber a real
      // binding of the same name — its dump entry still renders `<error>`,
      // matching the seed.
      let kids = kidsOf(c.tree, i)
      let nm = getNode(c.tree, kids[0])
      let pt = 0
      if (kids[1] != 0) {
        pt = typeFromNode(c, kids[1])
      }
      c.nodeTypes[kids[0]] = pt
      if (pt != 0) {
        c.env[c.source[nm.span.start:nm.span.end]] = pt
      }
    } else if (tag == Tag.Binding) {
      checkBinding(c, i)
    } else if (tag == Tag.Call) {
      c.nodeTypes[i] = checkCall(c, i)
      // Record a generic-function call's instantiation in source order (its
      // monomorphized index), once, during the check pass.
      let callee = getNode(c.tree, kidsOf(c.tree, i)[0])
      if (callee.tag == Tag.Ident) {
        let cname = c.source[callee.span.start:callee.span.end]
        if (isGenericFunc(c, cname)) {
          recordInstantiation(c, cname, genericTypeArgs(c, cname, i))
        }
      }
    }
    i = i + 1
  }
}

// One `--dump-types` line's data: the name's start offset, its source text, type.
struct TypeEntry {
  start: int,
  text: string,
  ty: int,
}

// Appends a dump entry per name bound by `pat` (recursing tuple_pat), reading
// the already-typed pattern node (the seed's collectBindingIdents).
function collectBindingIdents(c: Checker, pat: int, entries: []TypeEntry): []TypeEntry {
  let n = getNode(c.tree, pat)
  if (n.tag == Tag.TuplePat) {
    let subs = kidsOf(c.tree, pat)
    let i = 0
    while (i < len(subs)) {
      entries = collectBindingIdents(c, subs[i], entries)
      i = i + 1
    }
    return entries
  }
  return append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[pat] })
}

// Insertion-sort dump entries by source offset (the seed sorts (file, start);
// one file here, so start alone). Bounded by the entry count.
function sortEntries(entries: []TypeEntry): []TypeEntry {
  let i = 1
  while (i < len(entries)) {
    let cur = entries[i]
    let j = i - 1
    while (j >= 0 && entries[j].start > cur.start) {
      entries[j + 1] = entries[j]
      j = j - 1
    }
    entries[j + 1] = cur
    i = i + 1
  }
  return entries
}

// Renders `--dump-types`: one `line:col: text: typename` line per binding name,
// arrow parameter, and call expression, sorted by source position — matching the
// seed's dumpTypesText.
function dumpTypesText(c: Checker): string {
  let entries = []TypeEntry(0)
  let i = 1
  while (i < len(c.tree.nodes)) {
    let n = getNode(c.tree, i)
    if (n.tag == Tag.Binding) {
      entries = collectBindingIdents(c, kidsOf(c.tree, i)[0], entries)
    } else if (n.tag == Tag.ArrowP) {
      let name = kidsOf(c.tree, i)[0]
      let nn = getNode(c.tree, name)
      entries = append(entries, TypeEntry{ start: nn.span.start, text: c.source[nn.span.start:nn.span.end], ty: c.nodeTypes[name] })
    } else if (n.tag == Tag.Call) {
      entries = append(entries, TypeEntry{ start: n.span.start, text: c.source[n.span.start:n.span.end], ty: c.nodeTypes[i] })
    }
    i = i + 1
  }
  entries = sortEntries(entries)
  let out = ""
  let k = 0
  while (k < len(entries)) {
    let e = entries[k]
    let lc = locateOffset(c.source, e.start)
    out = out + "${lc.line + 1}:${lc.col + 1}: " + e.text + ": " + typeName(c.ctx, e.ty) + "\n"
    k = k + 1
  }
  return out
}

// Parses `src`, type-checks it, and returns the `--dump-types` text.
function checkSourceDump(src: string): string {
  let tree = parseSource(src)
  let ctx = newTypeContext()
  let c = newChecker(tree, src, ctx)
  checkModule(c)
  return dumpTypesText(c)
}
