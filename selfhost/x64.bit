// Self-host Stage 3 (#1346): the x86-64 backend, ported from
// compiler/codegen/x64.zig. This first slice is the substrate — registers, the
// two calling conventions, and the low-level encoder every selector builds on.
//
// x86-64 differs from the AArch64 port (selfhost/arm64.bit) in three ways that
// shape everything here:
//   - Instructions are VARIABLE length, built from optional prefixes (REX), an
//     opcode, a ModRM byte, an optional SIB byte, and an optional displacement
//     or immediate. There is no fixed 32-bit word to compose, so the encoder is
//     a byte stream and every emitter must agree on the exact prefix rules.
//   - Register numbers 8..15 are unreachable without a REX prefix, and the REX
//     bit that extends a field depends on WHICH field the register sits in
//     (reg -> REX.R, rm/base -> REX.B, index -> REX.X). Getting that wrong
//     silently addresses the wrong register rather than failing to assemble.
//   - There are TWO conventions (SysV and Win64) with different argument
//     registers and different callee-saved sets, so `XCallConv` is threaded
//     everywhere the ABI shows through, unlike arm64's single AAPCS64.
//
// Every encoder here is checked against the system assembler's own bytes
// (`clang -c` on the equivalent .s), the same discipline the arm64 port used —
// an encoder that assembles to plausible-but-wrong bytes is the one bug class
// that reaches a running binary silently.

// Physical GPR, numbered exactly as the ModRM/REX encoding expects: the enum's
// ordinal IS the register number, so `xRegNum` is the identity. Reordering this
// silently re-targets every instruction.
enum XReg64 {
  Rax, Rcx, Rdx, Rbx, Rsp, Rbp, Rsi, Rdi, R8, R9, R10, R11, R12, R13, R14, R15,
}

// Physical XMM register, numbered the same way.
enum XmmReg {
  Xmm0, Xmm1, Xmm2, Xmm3, Xmm4, Xmm5, Xmm6, Xmm7,
  Xmm8, Xmm9, Xmm10, Xmm11, Xmm12, Xmm13, Xmm14, Xmm15,
}

enum XCallConv {
  SysV,
  Win64,
}

// The register number an enum ordinal stands for. The tables above are declared
// in encoding order, so this is the ordinal itself — asserted rather than
// assumed, because everything below indexes REX/ModRM fields with it.
function xRegNum(r: XReg64): int {
  return int(r)
}

function xmmNum(x: XmmReg): int {
  return int(x)
}

// The inverse of xRegNum/xmmNum: the register with encoding number `n`. A table
// rather than a cast, because Bit has no int->enum conversion. Needed where a
// register arrives as a raw number — the register allocator's results and the
// architecture-neutral PLoc both carry plain ints.
function xRegOf(n: int): XReg64 {
  assert(n >= 0 && n < 16)
  return [XReg64.Rax, XReg64.Rcx, XReg64.Rdx, XReg64.Rbx, XReg64.Rsp, XReg64.Rbp,
    XReg64.Rsi, XReg64.Rdi, XReg64.R8, XReg64.R9, XReg64.R10, XReg64.R11,
    XReg64.R12, XReg64.R13, XReg64.R14, XReg64.R15][n]
}

function xXmmOf(n: int): XmmReg {
  assert(n >= 0 && n < 16)
  return [XmmReg.Xmm0, XmmReg.Xmm1, XmmReg.Xmm2, XmmReg.Xmm3, XmmReg.Xmm4,
    XmmReg.Xmm5, XmmReg.Xmm6, XmmReg.Xmm7, XmmReg.Xmm8, XmmReg.Xmm9,
    XmmReg.Xmm10, XmmReg.Xmm11, XmmReg.Xmm12, XmmReg.Xmm13, XmmReg.Xmm14,
    XmmReg.Xmm15][n]
}

// Reserved codegen scratch — never allocatable, and never an argument or return
// register in either convention, so a selector may clobber one at any point
// without consulting the ABI.
function xScratch1(): XReg64 { return XReg64.R11 } // accumulator / setcc target / move-cycle temp
function xScratch2(): XReg64 { return XReg64.R10 } // rhs operand / base pointer
function xScratch3(): XReg64 { return XReg64.R12 } // index register (array indexing only)
function xFScratch1(): XmmReg { return XmmReg.Xmm14 } // float accumulator / move-cycle temp
function xFScratch2(): XmmReg { return XmmReg.Xmm15 } // secondary float operand

// The allocatable GPRs, in the seed's order — regalloc hands out indices into
// this, so the order is part of the contract, not a preference.
function xMasterGprs(): []XReg64 {
  return [XReg64.Rax, XReg64.Rcx, XReg64.Rdx, XReg64.Rbx, XReg64.Rsi, XReg64.Rdi, XReg64.R8, XReg64.R9,
    XReg64.R13, XReg64.R14, XReg64.R15]
}

function xMaxIntRegs(): int {
  return len(xMasterGprs())
}

// xmm0..xmm13; xmm14/xmm15 are the float scratch pair.
function xMaxFloatRegs(): int {
  return 14
}

// Integer argument registers, in order. SysV passes six, Win64 only four — and
// they are DIFFERENT registers, not a prefix of the same list.
function xIntArgRegs(cc: XCallConv): []XReg64 {
  if (cc == XCallConv.Win64) {
    return [XReg64.Rcx, XReg64.Rdx, XReg64.R8, XReg64.R9]
  }
  return [XReg64.Rdi, XReg64.Rsi, XReg64.Rdx, XReg64.Rcx, XReg64.R8, XReg64.R9]
}

// Whether `r` survives a call, so the frame must save it before use.
function xIsCalleeSavedInt(cc: XCallConv, r: XReg64): bool {
  if (r == XReg64.Rbx || r == XReg64.R13 || r == XReg64.R14 || r == XReg64.R15) {
    return true
  }
  // Win64 additionally preserves rsi/rdi — under SysV those are argument
  // registers and caller-saved.
  if (cc == XCallConv.Win64 && (r == XReg64.Rsi || r == XReg64.Rdi)) {
    return true
  }
  return false
}

// Whether `x` survives a call. SysV preserves no XMM at all; Win64 preserves
// xmm6..xmm15.
function xIsCalleeSavedFloat(cc: XCallConv, x: XmmReg): bool {
  if (cc == XCallConv.SysV) {
    return false
  }
  return xmmNum(x) >= 6
}

// ---------------------------------------------------------------------------
// Low-level encoder
// ---------------------------------------------------------------------------

// The REX prefix. W = 64-bit operand size; R/X/B extend the ModRM.reg,
// SIB.index and ModRM.rm/SIB.base fields to reach registers 8..15.
function xRex(w: bool, r: bool, x: bool, b: bool): int {
  let v = 0x40
  if (w) { v = v | 8 }
  if (r) { v = v | 4 }
  if (x) { v = v | 2 }
  if (b) { v = v | 1 }
  return v
}

// A register-direct ModRM byte (mod=11): `reg` is the opcode's reg field, `rm`
// the register operand. Only the low 3 bits of each land here — bit 3 travels
// in REX.R / REX.B.
function xModrmReg(regField: int, rm: int): int {
  return 0xC0 | (regField & 7) << 3 | rm & 7
}

// A memory ModRM byte for the given mod (0, 1 or 2).
function xModrmMem(mod: int, regField: int, rm: int): int {
  return (mod & 3) << 6 | (regField & 7) << 3 | rm & 7
}

// The SIB byte: scale (encoded), index and base registers.
function xSib(scale: int, index: int, base: int): int {
  return (xScaleBits(scale) & 3) << 6 | (index & 7) << 3 | base & 7
}

// The 2-bit scale field for an element width. Only 1/2/4/8 are encodable — a
// caller with any other width has an addressing mode x86 cannot express, so
// this asserts rather than silently scaling by 1.
function xScaleBits(scale: int): int {
  if (scale == 1) { return 0 }
  if (scale == 2) { return 1 }
  if (scale == 4) { return 2 }
  assert(scale == 8)
  return 3
}

// ---------------------------------------------------------------------------
// The emitter
// ---------------------------------------------------------------------------

// A growing code buffer with the encoder's byte-level helpers. Kept separate
// from the full per-function Ctx so the encoders can be tested on their own.
struct X64Buf {
  code: []u8,
}

function newX64Buf(): X64Buf {
  return X64Buf{ code: []u8(0) }
}

function xEmitByte(b: X64Buf, v: int) {
  b.code = append(b.code, u8(v & 0xFF))
}

function xEmitU32(b: X64Buf, v: int) {
  xEmitByte(b, v)
  xEmitByte(b, v >> 8)
  xEmitByte(b, v >> 16)
  xEmitByte(b, v >> 24)
}

function xEmitU64(b: X64Buf, v: int) {
  xEmitU32(b, v)
  // An arithmetic shift is fine here: only the low 32 bits of the result are
  // kept, and they are the same either way.
  xEmitU32(b, v >> 32)
}

// Emits a REX prefix only when one is needed. A prefix of 0x40 (all bits clear)
// is legal but wasted, EXCEPT where it is load-bearing for byte registers —
// those callers use `xRexForce`.
function xMaybeRex(b: X64Buf, w: bool, r: bool, x: bool, bb: bool) {
  if (w || r || x || bb) {
    xEmitByte(b, xRex(w, r, x, bb))
  }
}

// Emits a REX prefix unconditionally. Needed to reach spl/bpl/sil/dil: without
// ANY rex byte those encodings mean ah/ch/dh/bh instead — a silently different
// register, not an error.
function xRexForce(b: X64Buf, w: bool, r: bool, x: bool, bb: bool) {
  xEmitByte(b, xRex(w, r, x, bb))
}

// True when a register needs its REX extension bit set to be addressed at all.
function xNeedsRexBit(n: int): bool {
  return n >= 8
}

// `mov dst, src` (64-bit). A move to itself encodes nothing.
function xMovRR(b: X64Buf, dst: XReg64, src: XReg64) {
  if (dst == src) {
    return
  }
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(src)), false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(b, 0x89)
  xEmitByte(b, xModrmReg(xRegNum(src), xRegNum(dst)))
}

// `mov dst, imm` (64-bit). A value that fits in a sign-extended imm32 uses the
// 7-byte C7 form; anything else needs the 10-byte movabs. Picking the short
// form for a value that does NOT fit would sign-extend it into a different
// number.
function xMovRI(b: X64Buf, dst: XReg64, imm: int) {
  if (imm >= -2147483648 && imm <= 2147483647) {
    xMaybeRex(b, true, false, false, xNeedsRexBit(xRegNum(dst)))
    xEmitByte(b, 0xC7)
    xEmitByte(b, xModrmReg(0, xRegNum(dst)))
    xEmitU32(b, imm)
    return
  }
  xMaybeRex(b, true, false, false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(b, 0xB8 | xRegNum(dst) & 7)
  xEmitU64(b, imm)
}

// ---------------------------------------------------------------------------
// Memory operands
// ---------------------------------------------------------------------------
//
// Every memory operand is emitted mod=10 (disp32), even when the displacement
// is 0. That is deliberate and load-bearing: mod=00 has two special cases that
// mean something else entirely — a base of rbp/r13 (low 3 bits 101) encodes
// "no base, disp32 absolute", and a base of rsp/r12 (low 3 bits 100) is the
// escape that demands a SIB byte. Always emitting disp32 removes the first case
// completely and leaves only the second to handle, for a few extra bytes.
// ponytail: always disp32; shrink to disp8/disp0 if code size ever matters.

// Bit has no optionals, so an index register rides as a (has, reg) pair.
struct XMem {
  base: XReg64,
  hasIndex: bool,
  index: XReg64,
  scale: int,
  disp: int,
}

function xMemB(base: XReg64, disp: int): XMem {
  return XMem{ base: base, hasIndex: false, index: XReg64.Rax, scale: 1, disp: disp }
}

function xMemBI(base: XReg64, index: XReg64, scale: int, disp: int): XMem {
  return XMem{ base: base, hasIndex: true, index: index, scale: scale, disp: disp }
}

// True when this operand must carry a SIB byte: an index always needs one, and
// so does a base whose low 3 bits are 100 — that is rsp AND r12, since the
// ModRM rm field only sees the low 3 bits and 100 there is the SIB escape
// rather than a base register. Missing r12 is the classic version of this bug.
function xNeedsSib(m: XMem): bool {
  return m.hasIndex || xRegNum(m.base) & 7 == 4
}

// Emits the ModRM byte, the optional SIB, and the disp32.
function xMemModRM(b: X64Buf, regField: int, m: XMem) {
  let rm = xRegNum(m.base) & 7
  if (xNeedsSib(m)) {
    rm = 4 // the SIB escape
  }
  xEmitByte(b, xModrmMem(2, regField, rm))
  if (xNeedsSib(m)) {
    // index=100 in a SIB means "no index" — the slot rsp would occupy, which is
    // exactly why rsp can never be an index register.
    let idx = 4
    if (m.hasIndex) {
      idx = xRegNum(m.index) & 7
    }
    xEmitByte(b, (xScaleBits(m.scale) & 3) << 6 | (idx & 7) << 3 | xRegNum(m.base) & 7)
  }
  xEmitU32(b, m.disp)
}

// The three REX extension bits a memory operand needs: R for the reg field, X
// for the index, B for the base. Mixing these up addresses a different register
// rather than failing to encode.
function xMemRexR(regField: int): bool {
  return regField >= 8
}

function xMemRexX(m: XMem): bool {
  return m.hasIndex && xNeedsRexBit(xRegNum(m.index))
}

function xMemRexB(m: XMem): bool {
  return xNeedsRexBit(xRegNum(m.base))
}

// Loads [base + index*scale + disp] into `dst`, sign/zero-extending from
// `width` bytes per `signed`. The result is left WIDTH-CANONICAL in a full
// 64-bit register — bits above the type width match the type — which is the
// invariant every consumer (logical shift, signed/unsigned compare, division)
// reads without re-masking.
function xMovLoad(b: X64Buf, dst: XReg64, m: XMem, width: int, signed: bool) {
  let r = xMemRexR(xRegNum(dst))
  let x = xMemRexX(m)
  let bb = xMemRexB(m)
  if (width == 8) {
    xMaybeRex(b, true, r, x, bb)
    xEmitByte(b, 0x8B)
  } else if (width == 4) {
    if (signed) {
      xMaybeRex(b, true, r, x, bb) // movsxd — REX.W is what makes it 32->64
      xEmitByte(b, 0x63)
    } else {
      // A 32-bit mov zero-extends to 64 for free: no REX.W, no movzx needed.
      xMaybeRex(b, false, r, x, bb)
      xEmitByte(b, 0x8B)
    }
  } else if (width == 2) {
    xMaybeRex(b, true, r, x, bb)
    xEmitByte(b, 0x0F)
    if (signed) {
      xEmitByte(b, 0xBF)
    } else {
      xEmitByte(b, 0xB7)
    }
  } else {
    assert(width == 1)
    xMaybeRex(b, true, r, x, bb)
    xEmitByte(b, 0x0F)
    if (signed) {
      xEmitByte(b, 0xBE)
    } else {
      xEmitByte(b, 0xB6)
    }
  }
  xMemModRM(b, xRegNum(dst), m)
}

// `lea dst, [base + disp]` — forms an address without dereferencing it. Used
// for the interior pointer of an inline aggregate field.
function xLea(b: X64Buf, dst: XReg64, base: XReg64, disp: int) {
  let m = xMemB(base, disp)
  xMaybeRex(b, true, xMemRexR(xRegNum(dst)), false, xMemRexB(m))
  xEmitByte(b, 0x8D)
  xMemModRM(b, xRegNum(dst), m)
}

// Stores the low `width` bytes of `src` to [base + index*scale + disp].
//
// The 1-byte case forces a REX prefix even when every extension bit is clear.
// That bare 0x40 is not waste: without ANY rex byte, the encodings for
// sil/dil/bpl/spl instead name the legacy ah/ch/dh/bh — a different register,
// assembled happily, wrong at run time. With a src of cl the assembler omits
// it; with sil it emits `40`. Both are checked.
function xMovStore(b: X64Buf, m: XMem, src: XReg64, width: int) {
  let r = xMemRexR(xRegNum(src))
  let x = xMemRexX(m)
  let bb = xMemRexB(m)
  if (width == 8) {
    xMaybeRex(b, true, r, x, bb)
    xEmitByte(b, 0x89)
  } else if (width == 4) {
    xMaybeRex(b, false, r, x, bb)
    xEmitByte(b, 0x89)
  } else if (width == 2) {
    // The operand-size prefix must come BEFORE the REX byte, not after.
    xEmitByte(b, 0x66)
    xMaybeRex(b, false, r, x, bb)
    xEmitByte(b, 0x89)
  } else {
    assert(width == 1)
    xRexForce(b, false, r, x, bb)
    xEmitByte(b, 0x88)
  }
  xMemModRM(b, xRegNum(src), m)
}

// ---------------------------------------------------------------------------
// Integer arithmetic
// ---------------------------------------------------------------------------

// The group-1 ALU ops, in their `op rm, reg` (0x01-stride) encoding.
enum XArith {
  Add,
  Or,
  And,
  Sub,
  Xor,
  Cmp,
}

function xArithOpcode(op: XArith): int {
  if (op == XArith.Add) { return 0x01 }
  if (op == XArith.Or) { return 0x09 }
  if (op == XArith.And) { return 0x21 }
  if (op == XArith.Sub) { return 0x29 }
  if (op == XArith.Xor) { return 0x31 }
  assert(op == XArith.Cmp)
  return 0x39
}

// `dst <op>= src`. For Cmp, `dst` is unchanged and only flags are written.
//
// The destination is the rm field and the source the reg field, so REX.R
// extends SRC and REX.B extends DST. That is the OPPOSITE of imul below, whose
// destination IS the reg field — the single easiest thing to get backwards
// here, and it silently targets the wrong register.
function xArithRR(b: X64Buf, op: XArith, dst: XReg64, src: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(src)), false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(b, xArithOpcode(op))
  xEmitByte(b, xModrmReg(xRegNum(src), xRegNum(dst)))
}

// `test a, b` — flags only (`85 /r`).
function xTestRR(b: X64Buf, a: XReg64, bb: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(bb)), false, xNeedsRexBit(xRegNum(a)))
  xEmitByte(b, 0x85)
  xEmitByte(b, xModrmReg(xRegNum(bb), xRegNum(a)))
}

// `dst *= src` — two-operand IMUL (`0F AF /r`). Here the DESTINATION is the reg
// field and the source the rm field, so the REX bits are the reverse of
// xArithRR's.
function xImulRR(b: X64Buf, dst: XReg64, src: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0xAF)
  xEmitByte(b, xModrmReg(xRegNum(dst), xRegNum(src)))
}

// The group-3 unary/division ops (`F7 /digit`).
function xGroup3R(b: X64Buf, digit: int, r: XReg64) {
  xMaybeRex(b, true, false, false, xNeedsRexBit(xRegNum(r)))
  xEmitByte(b, 0xF7)
  xEmitByte(b, xModrmReg(digit, xRegNum(r)))
}

function xNegR(b: X64Buf, r: XReg64) { xGroup3R(b, 3, r) }
function xNotR(b: X64Buf, r: XReg64) { xGroup3R(b, 2, r) }
function xIdivR(b: X64Buf, r: XReg64) { xGroup3R(b, 7, r) }
function xDivR(b: X64Buf, r: XReg64) { xGroup3R(b, 6, r) }

// `cqo` — sign-extends rax into rdx:rax, priming SIGNED division. Unsigned
// division primes rdx with zero instead; using the wrong one gives a wildly
// wrong quotient for negative inputs rather than an error.
function xCqo(b: X64Buf) {
  xEmitByte(b, xRex(true, false, false, false))
  xEmitByte(b, 0x99)
}

// `xor r32, r32` — zeroes the full 64-bit register (a 32-bit write clears the
// upper half), the standard idiom to prime unsigned division. Both REX bits
// track the same register because it appears in both fields.
function xZero32(b: X64Buf, r: XReg64) {
  xMaybeRex(b, false, xNeedsRexBit(xRegNum(r)), false, xNeedsRexBit(xRegNum(r)))
  xEmitByte(b, 0x31)
  xEmitByte(b, xModrmReg(xRegNum(r), xRegNum(r)))
}

enum XShift {
  Shl,
  Shr,
  Sar,
}

// The ModRM opcode-extension digit each shift uses. Note shr=5 and sar=7 are
// NOT adjacent — a logical vs arithmetic mix-up here silently sign-extends (or
// fails to) on every right shift.
function xShiftDigit(op: XShift): int {
  if (op == XShift.Shl) { return 4 }
  if (op == XShift.Shr) { return 5 }
  assert(op == XShift.Sar)
  return 7
}

function xShiftImm(b: X64Buf, op: XShift, r: XReg64, amount: int) {
  xMaybeRex(b, true, false, false, xNeedsRexBit(xRegNum(r)))
  xEmitByte(b, 0xC1)
  xEmitByte(b, xModrmReg(xShiftDigit(op), xRegNum(r)))
  xEmitByte(b, amount & 63)
}

// Shift by `cl` — the low byte of rcx is x86-64's ONLY variable shift count,
// which is why a function containing a variable shift excludes rcx from
// allocation entirely.
function xShiftCl(b: X64Buf, op: XShift, r: XReg64) {
  xMaybeRex(b, true, false, false, xNeedsRexBit(xRegNum(r)))
  xEmitByte(b, 0xD3)
  xEmitByte(b, xModrmReg(xShiftDigit(op), xRegNum(r)))
}

// ---------------------------------------------------------------------------
// Condition codes, setcc, and stack ops
// ---------------------------------------------------------------------------

// x86 condition-code numbers. The SIGNED set (l/ge/le/g) and the UNSIGNED set
// (b/ae/be/a) are different encodings for the same english word — using `l`
// where `b` belongs compares 0xFFFFFFFFFFFFFFFF as -1 instead of as a huge
// positive, and nothing complains.
function ccE(): int { return 0x4 }
function ccNe(): int { return 0x5 }
function ccB(): int { return 0x2 }  // unsigned <
function ccAe(): int { return 0x3 } // unsigned >=
function ccBe(): int { return 0x6 } // unsigned <=
function ccA(): int { return 0x7 }  // unsigned >
function ccL(): int { return 0xC }  // signed <
function ccGe(): int { return 0xD } // signed >=
function ccLe(): int { return 0xE } // signed <=
function ccG(): int { return 0xF }  // signed >
function ccP(): int { return 0xA }  // parity: a float compare was UNORDERED
function ccNp(): int { return 0xB } // ordered

// `setcc r8` — writes 0 or 1 into the low byte of `r`. Always forces a REX
// prefix so the destination is the modern low-byte encoding: without one,
// registers 4..7 name ah/ch/dh/bh instead of spl/bpl/sil/dil.
function xSetcc(b: X64Buf, cc: int, r: XReg64) {
  xRexForce(b, false, false, false, xNeedsRexBit(xRegNum(r)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x90 | cc & 0xF)
  xEmitByte(b, xModrmReg(0, xRegNum(r)))
}

// `movzx dst64, src8` — widens a setcc result to a clean 0/1 across the whole
// register. This is why setcc does not need a zeroing `xor` first: an `xor`
// would clobber the very flags setcc has to read.
function xMovzxb(b: X64Buf, dst: XReg64, src: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0xB6)
  xEmitByte(b, xModrmReg(xRegNum(dst), xRegNum(src)))
}

// 8-bit `and`/`or`, for combining two setcc results (the float compares need
// both an equality and an orderedness test). REX forced, same low-byte reason.
function xAnd8(b: X64Buf, dst: XReg64, src: XReg64) {
  xRexForce(b, false, xNeedsRexBit(xRegNum(src)), false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(b, 0x20)
  xEmitByte(b, xModrmReg(xRegNum(src), xRegNum(dst)))
}

function xOr8(b: X64Buf, dst: XReg64, src: XReg64) {
  xRexForce(b, false, xNeedsRexBit(xRegNum(src)), false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(b, 0x08)
  xEmitByte(b, xModrmReg(xRegNum(src), xRegNum(dst)))
}

// push/pop take no REX.W — they are 64-bit by default in long mode; only the
// register-extension bit is ever needed.
function xPush(b: X64Buf, r: XReg64) {
  if (xNeedsRexBit(xRegNum(r))) {
    xEmitByte(b, xRex(false, false, false, true))
  }
  xEmitByte(b, 0x50 | xRegNum(r) & 7)
}

function xPop(b: X64Buf, r: XReg64) {
  if (xNeedsRexBit(xRegNum(r))) {
    xEmitByte(b, xRex(false, false, false, true))
  }
  xEmitByte(b, 0x58 | xRegNum(r) & 7)
}

function xRet(b: X64Buf) {
  xEmitByte(b, 0xC3)
}

// `ud2` — a guaranteed-invalid opcode. Emitted where control must never
// arrive, so a compiler bug traps immediately instead of running into whatever
// bytes follow.
function xUd2(b: X64Buf) {
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x0B)
}

// ---------------------------------------------------------------------------
// Scalar float (SSE2)
// ---------------------------------------------------------------------------
//
// Three DIFFERENT prefix schemes live here, and they are not interchangeable:
//   - scalar arithmetic and the conversions take F2 (double) or F3 (single),
//   - ucomis takes 66 for double and NOTHING for single,
//   - xorp takes 66 for double and NOTHING for single.
// Using the arithmetic scheme for ucomis encodes a completely different
// instruction rather than failing, so each is pinned to the assembler's bytes.

// The scalar-arithmetic prefix: the movsd family vs the movss family.
function xFPrefix(width: int): int {
  if (width == 8) {
    return 0xF2
  }
  return 0xF3
}

enum XFArith {
  FAdd,
  FSub,
  FMul,
  FDiv,
}

function xFArithOpcode(op: XFArith): int {
  if (op == XFArith.FAdd) { return 0x58 }
  if (op == XFArith.FSub) { return 0x5C }
  if (op == XFArith.FMul) { return 0x59 }
  assert(op == XFArith.FDiv)
  return 0x5E
}

// `dst <op>= src`, scalar double or single per `width`. The destination is the
// reg field (REX.R), the source the rm field (REX.B).
function xFArithRR(b: X64Buf, op: XFArith, dst: XmmReg, src: XmmReg, width: int) {
  xEmitByte(b, xFPrefix(width))
  xMaybeRex(b, false, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xmmNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, xFArithOpcode(op))
  xEmitByte(b, xModrmReg(xmmNum(dst), xmmNum(src)))
}

// `ucomisd`/`ucomiss` — an ordered compare setting ZF/PF/CF. PF (the parity
// flag) is set when either operand is NaN, which is what makes a float compare
// distinguish "unordered" from "not equal".
//
// Note the prefix: 66 for DOUBLE, none for single — the opposite shape from the
// arithmetic ops above, where double takes F2.
function xUcomis(b: X64Buf, a: XmmReg, bx: XmmReg, width: int) {
  if (width == 8) {
    xEmitByte(b, 0x66)
  }
  xMaybeRex(b, false, xNeedsRexBit(xmmNum(a)), false, xNeedsRexBit(xmmNum(bx)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x2E)
  xEmitByte(b, xModrmReg(xmmNum(a), xmmNum(bx)))
}

// `xorpd`/`xorps` — used to flip a float's sign bit (negation) and to zero a
// register.
function xXorp(b: X64Buf, dst: XmmReg, src: XmmReg, width: int) {
  if (width == 8) {
    xEmitByte(b, 0x66)
  }
  xMaybeRex(b, false, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xmmNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x57)
  xEmitByte(b, xModrmReg(xmmNum(dst), xmmNum(src)))
}

// `cvtsi2sd`/`cvtsi2ss` — a signed 64-bit int to a float. REX.W is what makes
// the SOURCE 64-bit; without it the conversion reads only 32 bits.
function xCvtI2F(b: X64Buf, dst: XmmReg, src: XReg64, fwidth: int) {
  xEmitByte(b, xFPrefix(fwidth))
  xMaybeRex(b, true, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x2A)
  xEmitByte(b, xModrmReg(xmmNum(dst), xRegNum(src)))
}

// `cvttsd2si`/`cvttss2si` — a float to a signed 64-bit int, TRUNCATING toward
// zero (SPEC §12.9). The double-t mnemonic is the truncating one; the single-t
// form rounds per the MXCSR mode instead, which is a different answer for every
// non-integral value.
function xCvtF2I(b: X64Buf, dst: XReg64, src: XmmReg, fwidth: int) {
  xEmitByte(b, xFPrefix(fwidth))
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(dst)), false, xNeedsRexBit(xmmNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x2C)
  xEmitByte(b, xModrmReg(xRegNum(dst), xmmNum(src)))
}

// `cvtsd2ss` (fromWidth 8) / `cvtss2sd` (fromWidth 4) — float to float. The
// prefix names the SOURCE width, not the destination's.
function xCvtF2F(b: X64Buf, dst: XmmReg, src: XmmReg, fromWidth: int) {
  xEmitByte(b, xFPrefix(fromWidth))
  xMaybeRex(b, false, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xmmNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x5A)
  xEmitByte(b, xModrmReg(xmmNum(dst), xmmNum(src)))
}

// ---------------------------------------------------------------------------
// Calls, jumps, and fixups
// ---------------------------------------------------------------------------
//
// Every PC-relative field on x86-64 is measured from the END of the
// instruction, not its start — a rel32 at byte `off` targeting `t` holds
// `t - (off + 4)`. Getting that 4 wrong is the classic x86 branch bug: it lands
// four bytes off, which is usually still a valid instruction.

// A pending intra-function jump: the rel32 field's byte offset, and the IR
// block it targets. Resolved once every block's start offset is known.
struct XJumpFixup {
  patchOffset: int,
  target: int,
}

// The encoder state for one function being compiled.
struct XCtx {
  buf: X64Buf,
  cc: XCallConv,
  relocs: []Reloc,
  fixups: []XJumpFixup,
  blockOffsets: []int,
  // Register allocation results and the register file they index into. `alloc`
  // hands out INDICES; intRegs/floatRegs map an index to a physical register,
  // and the file differs per function (see xBuildIntRegs).
  alloc: RegAllocResult,
  intRegs: []XReg64,
  floatRegs: []XmmReg,
  frame: XFrame,
  // The block currently being emitted — a jump target at or before it is a
  // back-edge and needs a safepoint poll.
  curBlock: int,
  // One code offset per safepoint, in the order buildIntervals collected them
  // (calls first-seen, then back-edge terminators) — emission re-encounters them
  // in exactly that order, so `nextSafepointIdx` walks the two lists in lockstep
  // and each stack map lands on its own return address. Preallocated to the
  // safepoint count so an emitter deep in the call tree can record without
  // threading a slice back out.
  safepointCodeOffsets: []int,
  nextSafepointIdx: int,
}

function newXCtx(cc: XCallConv): XCtx {
  return XCtx{ buf: newX64Buf(), cc: cc, relocs: []Reloc(0), fixups: []XJumpFixup(0),
    blockOffsets: []int(0),
    alloc: RegAllocResult{ locations: []RegLoc(0), numSpillSlots: 0,
      stackMaps: []StackMapEntry(0) },
    intRegs: []XReg64(0), floatRegs: []XmmReg(0),
    frame: XFrame{ savedGpr: []XReg64(0), savedXmm: []XmmReg(0), numSpillSlots: 0,
      frameSize: 0 },
    curBlock: 0, safepointCodeOffsets: []int(0), nextSafepointIdx: 0 }
}

// `call <symbol>` — `E8 rel32` with a zero placeholder and a relocation naming
// the target. Nothing needs to exist at codegen time; the linker fills it.
function xCallReloc(cx: XCtx, symbol: string) {
  xEmitByte(cx.buf, 0xE8)
  let off = len(cx.buf.code)
  xEmitU32(cx.buf, 0)
  cx.relocs = append(cx.relocs, Reloc{ offset: off, symbol: symbol, kind: RelocKind.Branch })
}

// `movabs dst, <symbol>` — loads a symbol's full 64-bit address, the linker
// filling the 8-byte immediate via an Abs64 relocation. This is where x86-64
// diverges from AArch64, which composes an address from adrp+add instead.
function xMovAbsSymbol(cx: XCtx, dst: XReg64, symbol: string) {
  xMaybeRex(cx.buf, true, false, false, xNeedsRexBit(xRegNum(dst)))
  xEmitByte(cx.buf, 0xB8 | xRegNum(dst) & 7)
  let off = len(cx.buf.code)
  xEmitU64(cx.buf, 0)
  cx.relocs = append(cx.relocs, Reloc{ offset: off, symbol: symbol, kind: RelocKind.Abs64 })
}

// `call r/m64` (`FF /2`) — an indirect call through a register, for closure
// dispatch. No REX.W: the operand is 64-bit by default in long mode.
function xCallReg(cx: XCtx, r: XReg64) {
  if (xNeedsRexBit(xRegNum(r))) {
    xEmitByte(cx.buf, xRex(false, false, false, true))
  }
  xEmitByte(cx.buf, 0xFF)
  xEmitByte(cx.buf, xModrmReg(2, xRegNum(r)))
}

// Emits a jump whose rel32 is a placeholder, recording a fixup for `target`.
// Always the rel32 form: rel8 would be shorter but cannot reach every block,
// and choosing between them needs a distance not yet known.
function xJumpFixup(cx: XCtx, opcodes: []int, target: int) {
  for o of opcodes {
    xEmitByte(cx.buf, o)
  }
  let off = len(cx.buf.code)
  xEmitU32(cx.buf, 0)
  cx.fixups = append(cx.fixups, XJumpFixup{ patchOffset: off, target: target })
}

function xJmpRel32(cx: XCtx, target: int) {
  xJumpFixup(cx, [0xE9], target)
}

function xJccRel32(cx: XCtx, cc: int, target: int) {
  xJumpFixup(cx, [0x0F, 0x80 | cc & 0xF], target)
}

// Writes a rel32 at `patchOffset` so control lands at `targetOff`. The
// displacement is measured from the END of the 4-byte field, hence the +4.
function xPatchRel32(cx: XCtx, patchOffset: int, targetOff: int) {
  let rel = targetOff - (patchOffset + 4)
  cx.buf.code[patchOffset] = u8(rel & 0xFF)
  cx.buf.code[patchOffset + 1] = u8(rel >> 8 & 0xFF)
  cx.buf.code[patchOffset + 2] = u8(rel >> 16 & 0xFF)
  cx.buf.code[patchOffset + 3] = u8(rel >> 24 & 0xFF)
}

// Patches a rel32 to land at the current end of the code — "jump to here",
// used for a br's skip-over once the not-taken path has been emitted.
function xPatchRel32Here(cx: XCtx, patchOffset: int) {
  xPatchRel32(cx, patchOffset, len(cx.buf.code))
}

// Resolves every recorded jump once all block offsets are known.
function xPatchJumpFixups(cx: XCtx) {
  for fx of cx.fixups {
    assert(fx.target >= 0 && fx.target < len(cx.blockOffsets))
    xPatchRel32(cx, fx.patchOffset, cx.blockOffsets[fx.target])
  }
}

// ---------------------------------------------------------------------------
// Frame layout
// ---------------------------------------------------------------------------
//
// The frame, downward from rbp:
//   rbp+8   return address
//   rbp+0   caller's rbp
//   rbp-8.. saved callee-saved GPRs, one per 8 bytes
//   then    spill slots, one per 8 bytes
//   then    saved callee-saved XMMs
// All offsets are rbp-relative, which is what lets the GC's stack walker stay
// architecture-neutral (runtime/ABI.md §4).

struct XFrame {
  savedGpr: []XReg64,
  savedXmm: []XmmReg,
  numSpillSlots: int,
  frameSize: int,
}

// Spill slot `slot` sits below the saved GPRs.
function xSpillOffset(f: XFrame, slot: int): int {
  return -(8 * len(f.savedGpr) + 8 * (slot + 1))
}

// Saved XMM `i` sits below the GPRs and the spill slots.
function xXmmSaveOffset(f: XFrame, i: int): int {
  return -(8 * len(f.savedGpr) + 8 * f.numSpillSlots + 8 * (i + 1))
}

// Rounds `raw` up so that, after `push rbp` (which itself leaves rsp
// 16-aligned) plus `savedCount` further 8-byte pushes, `sub rsp, <result>`
// leaves rsp 16-ALIGNED for any call in the body.
//
// This is not cosmetic. SysV requires rsp to be 16-aligned at a call, and the
// SSE instructions libc uses fault on a misaligned stack — so a frame that is
// off by 8 crashes inside someone else's code, far from the cause. An ODD
// number of saved pushes leaves rsp at 8 mod 16, so the frame must itself be
// 8 mod 16 to bring it back.
function xAlignFrame(raw: int, savedCount: int): int {
  let needed = 0
  if (savedCount % 2 != 0) {
    needed = 8
  }
  let rem = raw % 16
  if (rem == needed) {
    return raw
  }
  if (rem < needed) {
    return raw + (needed - rem)
  }
  return raw + (16 - (rem - needed))
}

// `rsp -= imm32` / `rsp += imm32` — group-1 /5 (sub) and /0 (add).
function xRspAddSub(b: X64Buf, isSub: bool, imm: int) {
  xEmitByte(b, xRex(true, false, false, false))
  xEmitByte(b, 0x81)
  let digit = 0
  if (isSub) {
    digit = 5
  }
  xEmitByte(b, xModrmReg(digit, xRegNum(XReg64.Rsp)))
  xEmitU32(b, imm)
}

// ---------------------------------------------------------------------------
// Float moves
// ---------------------------------------------------------------------------

// `movsd`/`movss` register-to-register (`0F 10 /r`). A self-move encodes nothing.
function xMovFRR(b: X64Buf, dst: XmmReg, src: XmmReg, width: int) {
  if (dst == src) {
    return
  }
  xEmitByte(b, xFPrefix(width))
  xMaybeRex(b, false, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xmmNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x10)
  xEmitByte(b, xModrmReg(xmmNum(dst), xmmNum(src)))
}

// Load: `0F 10` reads memory into the register.
function xMovFLoad(b: X64Buf, dst: XmmReg, m: XMem, width: int) {
  xEmitByte(b, xFPrefix(width))
  xMaybeRex(b, false, xMemRexR(xmmNum(dst)), xMemRexX(m), xMemRexB(m))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x10)
  xMemModRM(b, xmmNum(dst), m)
}

// Store: `0F 11` is the same instruction with the direction bit set — 0x10 here
// would read the destination instead of writing it.
function xMovFStore(b: X64Buf, m: XMem, src: XmmReg, width: int) {
  xEmitByte(b, xFPrefix(width))
  xMaybeRex(b, false, xMemRexR(xmmNum(src)), xMemRexX(m), xMemRexB(m))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x11)
  xMemModRM(b, xmmNum(src), m)
}

// ---------------------------------------------------------------------------
// Parallel moves
// ---------------------------------------------------------------------------
//
// PLoc/PMove/plocEq/swapRemoveMove are architecture-neutral and already defined
// by the arm64 backend; only the emitters below differ. A spill location is an
// rbp-relative offset here, exactly as it is x29-relative there.

// Emits one move. A mem->mem move has no single-instruction form, so it routes
// through the PRIMARY scratch — which is why a move CYCLE must rotate through
// the SECONDARY scratch instead (see xSequentializeAndEmit).
function xEmitMove(cx: XCtx, src: PLoc, dst: PLoc, class: RegClass) {
  if (class == RegClass.Int) {
    if (src.isReg && dst.isReg) {
      xMovRR(cx.buf, xRegOf(dst.v), xRegOf(src.v))
      return
    }
    if (src.isReg) {
      xMovStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xRegOf(src.v), 8)
      return
    }
    if (dst.isReg) {
      xMovLoad(cx.buf, xRegOf(dst.v), xMemB(XReg64.Rbp, src.v), 8, false)
      return
    }
    xMovLoad(cx.buf, xScratch1(), xMemB(XReg64.Rbp, src.v), 8, false)
    xMovStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xScratch1(), 8)
    return
  }
  if (src.isReg && dst.isReg) {
    xMovFRR(cx.buf, xXmmOf(dst.v), xXmmOf(src.v), 8)
    return
  }
  if (src.isReg) {
    xMovFStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xXmmOf(src.v), 8)
    return
  }
  if (dst.isReg) {
    xMovFLoad(cx.buf, xXmmOf(dst.v), xMemB(XReg64.Rbp, src.v), 8)
    return
  }
  xMovFLoad(cx.buf, xFScratch1(), xMemB(XReg64.Rbp, src.v), 8)
  xMovFStore(cx.buf, xMemB(XReg64.Rbp, dst.v), xFScratch1(), 8)
}

// Emits `movesIn` so every destination receives the value it would under
// true-parallel semantics, even when sources and destinations alias (register
// swaps and rotations). Two phases: drain everything nothing else reads, then
// break the remaining closed cycles through a scratch.
function xSequentializeAndEmit(cx: XCtx, movesIn: []PMove, class: RegClass) {
  let moves = []PMove(0)
  let k = 0
  while (k < len(movesIn)) {
    if (!plocEq(movesIn[k].src, movesIn[k].dst)) {
      moves = append(moves, movesIn[k])
    }
    k = k + 1
  }

  // Phase 1: emit every move whose destination no other pending move still
  // reads. Each pass either emits one or stops, so this is bounded.
  let changed = true
  while (changed) {
    changed = false
    let i = 0
    while (i < len(moves)) {
      if (anyReads(moves, i, moves[i].dst)) {
        i = i + 1
      } else {
        xEmitMove(cx, moves[i].src, moves[i].dst, class)
        moves = swapRemoveMove(moves, i)
        changed = true
      }
    }
  }

  // Phase 2: whatever remains forms closed cycles. Walk one backwards from an
  // arbitrary destination (each location is written exactly once, so the
  // predecessor is unique) and rotate it through a scratch register.
  while (len(moves) > 0) {
    let cycle = []PMove(0)
    let start = moves[0].dst
    let cur = start
    let guard = 0
    while (guard <= len(movesIn)) {
      let found = -1
      let j = 0
      while (j < len(moves)) {
        if (plocEq(moves[j].dst, cur)) {
          found = j
          j = len(moves)
        } else {
          j = j + 1
        }
      }
      assert(found >= 0) // invariant: what is left forms closed cycles
      let mv = moves[found]
      cycle = append(cycle, mv)
      moves = swapRemoveMove(moves, found)
      cur = mv.src
      if (plocEq(cur, start)) {
        guard = len(movesIn) + 1
      } else {
        guard = guard + 1
      }
    }

    // The cycle scratch holds one location's value across the WHOLE rotation,
    // so it must be a register xEmitMove never uses as its own temporary. A
    // mem->mem step inside the cycle routes through the PRIMARY scratch, so the
    // cycle must use the SECONDARY one — otherwise the first mem->mem step
    // overwrites the saved value and the cycle resolves to garbage. That is
    // #1235: a spilled loop-carried value swapped on a back-edge, silently
    // corrupted.
    let scratch = plocReg(xRegNum(xScratch2()))
    if (class == RegClass.Float) {
      scratch = plocReg(xmmNum(xFScratch2()))
    }
    xEmitMove(cx, cycle[0].dst, scratch, class) // save what is about to be overwritten
    let i = 0
    while (i + 1 < len(cycle)) {
      xEmitMove(cx, cycle[i].src, cycle[i].dst, class)
      i = i + 1
    }
    xEmitMove(cx, scratch, cycle[len(cycle) - 1].dst, class)
  }
}

// ---------------------------------------------------------------------------
// Argument marshalling
// ---------------------------------------------------------------------------

// The register argument `position` lands in, or -1 when it goes on the stack.
// `classOrdinal` counts only arguments of the same class seen so far.
//
// This is where the two ABIs genuinely diverge, and the difference is silent:
//   - SysV counts the integer and float banks INDEPENDENTLY, so f(int, float,
//     int) passes rdi, xmm0, rsi.
//   - Win64 indexes by POSITION, the banks SHARING slots, so the same call
//     passes rcx, xmm1, r8 — a float at position 1 consumes the slot rcx would
//     otherwise take.
// Using one rule under the other convention reads every argument after the
// first float from the wrong register.
function xArgReg(cc: XCallConv, class: RegClass, position: int, classOrdinal: int): int {
  let ord = classOrdinal
  if (cc == XCallConv.Win64) {
    ord = position
  }
  if (class == RegClass.Int) {
    let regs = xIntArgRegs(cc)
    if (ord < len(regs)) {
      return xRegNum(regs[ord])
    }
    return -1
  }
  // Floats go in xmm0.. in both conventions; only the count differs (SysV
  // takes eight, Win64 four).
  let maxF = 8
  if (cc == XCallConv.Win64) {
    maxF = 4
  }
  if (ord < maxF) {
    return ord
  }
  return -1
}

// One argument that did not fit in a register and must be stored to the
// outgoing stack area.
struct XStackArg {
  src: PLoc,
  class: RegClass,
  offset: int,
}

// Stores one overflow argument into the outgoing area at rsp+offset.
function xEmitStackArgStore(cx: XCtx, sa: XStackArg) {
  if (sa.class == RegClass.Int) {
    let r = xScratch1()
    if (sa.src.isReg) {
      r = xRegOf(sa.src.v)
    } else {
      xMovLoad(cx.buf, r, xMemB(XReg64.Rbp, sa.src.v), 8, false)
    }
    xMovStore(cx.buf, xMemB(XReg64.Rsp, sa.offset), r, 8)
    return
  }
  let f = xFScratch1()
  if (sa.src.isReg) {
    f = xXmmOf(sa.src.v)
  } else {
    xMovFLoad(cx.buf, f, xMemB(XReg64.Rbp, sa.src.v), 8)
  }
  xMovFStore(cx.buf, xMemB(XReg64.Rsp, sa.offset), f, 8)
}

// The outgoing stack area a call needs for `stackCount` overflow arguments,
// rounded up to keep rsp 16-aligned at the call.
function xStackReserve(stackCount: int): int {
  let raw = 8 * stackCount
  if (raw % 16 == 0) {
    return raw
  }
  return raw + (16 - raw % 16)
}

// Win64 requires 32 bytes of "shadow space" below the return address that the
// CALLER reserves and the callee may freely use to spill its four register
// arguments. Omitting it lets the callee scribble over the caller's own frame.
function xShadowSpace(cc: XCallConv): int {
  if (cc == XCallConv.Win64) {
    return 32
  }
  return 0
}

// ---------------------------------------------------------------------------
// Per-function register file and safepoints
// ---------------------------------------------------------------------------

// What one function needs, scanned before register allocation.
struct XFuncFlags {
  // Any call, allocation, or loop back-edge — i.e. any safepoint. Such a
  // function is restricted to callee-saved registers only.
  hasSafepoints: bool,
  // Contains a division: rax/rdx are fixed operands of idiv/div.
  needsRaxRdx: bool,
  // Contains a shift by a non-constant amount: cl is the only variable shift
  // count x86-64 has.
  needsRcx: bool,
}

// The allocatable GPRs for one function.
//
// When a function contains ANY safepoint, its register file shrinks to the
// callee-saved subset. That sidesteps caller-save spill/reload entirely — no
// vreg can ever live in a call-clobbered register, so a call needs no save
// sequence — at the cost of using fewer registers in such functions.
// ponytail: callee-saved-only across calls; add caller-save spill/reload if
// this measurably hurts codegen.
//
// The rax/rdx and rcx exclusions only apply on the OTHER branch, and that is
// not an oversight: no callee-saved register in either convention is rax, rdx
// or rcx, so the restricted file already excludes them.
function xBuildIntRegs(cc: XCallConv, flags: XFuncFlags): []XReg64 {
  let out = []XReg64(0)
  for r of xMasterGprs() {
    if (flags.hasSafepoints) {
      if (!xIsCalleeSavedInt(cc, r)) {
        continue
      }
    } else {
      if (flags.needsRaxRdx && (r == XReg64.Rax || r == XReg64.Rdx)) {
        continue
      }
      if (flags.needsRcx && r == XReg64.Rcx) {
        continue
      }
    }
    out = append(out, r)
  }
  return out
}

// The allocatable XMMs for one function. Under SysV a function with any
// safepoint gets NONE — SysV preserves no XMM at all, so every float vreg in
// such a function spills. Win64 preserves xmm6..xmm15, so those remain.
function xBuildFloatRegs(cc: XCallConv, hasSafepoints: bool): []XmmReg {
  let out = []XmmReg(0)
  if (!hasSafepoints) {
    let i = 0
    while (i < xMaxFloatRegs()) {
      out = append(out, xXmmOf(i))
      i = i + 1
    }
    return out
  }
  if (cc == XCallConv.SysV) {
    return out // empty: SysV preserves no XMM
  }
  let r = 6
  while (r < xMaxFloatRegs()) {
    out = append(out, xXmmOf(r))
    r = r + 1
  }
  return out
}

// ---------------------------------------------------------------------------
// Width canonicalization
// ---------------------------------------------------------------------------
//
// Every integer SSA value lives in a full 64-bit GPR held WIDTH-CANONICAL: the
// bits above its type width always match the type — zero for an unsigned type,
// a copy of the sign bit for a signed one. That is what lets every consumer
// (logical vs arithmetic shift, signed vs unsigned compare, division) read the
// register directly with no per-op masking.
//
// The invariant is restored at each definition site that can break it. Loads
// extend to width; narrow constants are in range by construction; and the ops
// that CAN push bits past the type width — add/sub/mul/shl, neg/bnot — re-narrow
// their result here. Bitwise and/or/xor and the right shifts carry canonical
// inputs to canonical outputs, so they add no mask. This is the SHA-256 /
// ChaCha20 prerequisite (#1158): without it a narrow add followed by a rotate
// leaks the overflow bits the add left above the type width.

// `movsx`/`movzx` through the 0F escape, register to register.
function xExt0F(b: X64Buf, opcode: int, dst: XReg64, src: XReg64) {
  xMaybeRex(b, true, xNeedsRexBit(xRegNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, opcode)
  xEmitByte(b, xModrmReg(xRegNum(dst), xRegNum(src)))
}

// Re-extends `reg` from `width` bytes to a canonical full 64 bits.
function xExtendReg(b: X64Buf, reg: XReg64, width: int, signed: bool) {
  if (width == 1) {
    if (signed) {
      xExt0F(b, 0xBE, reg, reg)
    } else {
      xExt0F(b, 0xB6, reg, reg)
    }
    return
  }
  if (width == 2) {
    if (signed) {
      xExt0F(b, 0xBF, reg, reg)
    } else {
      xExt0F(b, 0xB7, reg, reg)
    }
    return
  }
  if (width == 4) {
    if (signed) {
      xMaybeRex(b, true, xNeedsRexBit(xRegNum(reg)), false, xNeedsRexBit(xRegNum(reg)))
      xEmitByte(b, 0x63) // movsxd r64, r/m32
      xEmitByte(b, xModrmReg(xRegNum(reg), xRegNum(reg)))
      return
    }
    // `mov r32, r/m32` zero-extends the low 32 bits into the full 64 for free —
    // no movzx needed, and REX.W would defeat the point by keeping all 64.
    xMaybeRex(b, false, xNeedsRexBit(xRegNum(reg)), false, xNeedsRexBit(xRegNum(reg)))
    xEmitByte(b, 0x8B)
    xEmitByte(b, xModrmReg(xRegNum(reg), xRegNum(reg)))
    return
  }
  // 8 bytes: the register width already equals the type width.
  assert(width == 8)
}

// Restores the width-canonical invariant for a freshly-computed result. A no-op
// at 64 bits and for floats, where register width already equals type width.
function xCanonNarrow(b: X64Buf, reg: XReg64, w: Width) {
  if (w.class == RegClass.Int && w.bytes < 8) {
    xExtendReg(b, reg, w.bytes, w.signed)
  }
}

// ---------------------------------------------------------------------------
// Operand fetch and store
// ---------------------------------------------------------------------------
//
// Every selector materializes both operands into scratch registers, computes
// there, and writes the result back through these. That is more `mov`s than
// reusing an operand's own register would need, but it is uniform — and the
// register file is already restricted enough (callee-saved-only across calls)
// that the extra moves are not where the cost is.
// ponytail: always route through scratch; tighten if a hot path measures.

function xRegLocOf(cx: XCtx, vreg: int): RegLoc {
  assert(vreg >= 0 && vreg < len(cx.alloc.locations))
  return cx.alloc.locations[vreg]
}

// Reads `vreg` into a register: its own if it has one, else `scratch` after a
// reload from its spill slot. Returns whichever register now holds it.
function xGetInt(cx: XCtx, vreg: int, scratch: XReg64): XReg64 {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    return cx.intRegs[loc.index]
  }
  xMovLoad(cx.buf, scratch, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), 8, false)
  return scratch
}

// Writes `src` to wherever `vreg` lives.
function xPutInt(cx: XCtx, vreg: int, src: XReg64) {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    xMovRR(cx.buf, cx.intRegs[loc.index], src)
    return
  }
  xMovStore(cx.buf, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), src, 8)
}

function xGetFloat(cx: XCtx, vreg: int, scratch: XmmReg): XmmReg {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    return cx.floatRegs[loc.index]
  }
  xMovFLoad(cx.buf, scratch, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), 8)
  return scratch
}

function xPutFloat(cx: XCtx, vreg: int, src: XmmReg) {
  let loc = xRegLocOf(cx, vreg)
  if (!loc.isSpill) {
    xMovFRR(cx.buf, cx.floatRegs[loc.index], src, 8)
    return
  }
  xMovFStore(cx.buf, xMemB(XReg64.Rbp, xSpillOffset(cx.frame, loc.index)), src, 8)
}

// Where `vreg` lives, as the architecture-neutral PLoc the parallel-move
// sequencer works in. A spill becomes an rbp-relative offset.
function xPlocOf(cx: XCtx, vreg: int, class: RegClass): PLoc {
  let loc = xRegLocOf(cx, vreg)
  if (loc.isSpill) {
    return plocMem(xSpillOffset(cx.frame, loc.index))
  }
  if (class == RegClass.Int) {
    return plocReg(xRegNum(cx.intRegs[loc.index]))
  }
  return plocReg(xmmNum(cx.floatRegs[loc.index]))
}

// ---------------------------------------------------------------------------
// Integer selectors
// ---------------------------------------------------------------------------

// `dst = lhs <op> rhs` for the group-1 ALU ops.
function xEmitBinaryInt(cx: XCtx, op: XArith, dst: int, lhs: int, rhs: int, w: Width) {
  let l = xGetInt(cx, lhs, xScratch1())
  let r = xGetInt(cx, rhs, xScratch2())
  xMovRR(cx.buf, xScratch1(), l)
  xArithRR(cx.buf, op, xScratch1(), r)
  // add/sub can carry bits past the type width; the bitwise ops cannot — they
  // map canonical inputs to a canonical output, so they need no re-narrowing.
  if (op == XArith.Add || op == XArith.Sub) {
    xCanonNarrow(cx.buf, xScratch1(), w)
  }
  xPutInt(cx, dst, xScratch1())
}

function xEmitMulInt(cx: XCtx, dst: int, lhs: int, rhs: int, w: Width) {
  let l = xGetInt(cx, lhs, xScratch1())
  let r = xGetInt(cx, rhs, xScratch2())
  xMovRR(cx.buf, xScratch1(), l)
  xImulRR(cx.buf, xScratch1(), r)
  xCanonNarrow(cx.buf, xScratch1(), w) // a product overflows its width readily
  xPutInt(cx, dst, xScratch1())
}

// Which of the four division ops this is.
enum XDivOp {
  SDiv,
  UDiv,
  SRem,
  URem,
}

// `dst = lhs / rhs` or `lhs % rhs`.
//
// idiv/div are hardwired to rax (dividend low) and rdx (dividend high), and
// write the quotient to rax and the remainder to rdx. The function containing
// this was already forced to exclude rax/rdx from allocation (xBuildIntRegs'
// needsRaxRdx), so neither operand's register can alias them and the moves
// below cannot clobber a live value.
//
// The dividend's HIGH half must be primed correctly or the result is wildly
// wrong rather than faulting: sign-extend rax into rdx:rax for signed, zero rdx
// for unsigned.
function xEmitDivInt(cx: XCtx, op: XDivOp, dst: int, lhs: int, rhs: int) {
  let l = xGetInt(cx, lhs, xScratch1())
  let r = xGetInt(cx, rhs, xScratch2())
  xMovRR(cx.buf, XReg64.Rax, l)
  let signed = op == XDivOp.SDiv || op == XDivOp.SRem
  if (signed) {
    xCqo(cx.buf)
    xIdivR(cx.buf, r)
  } else {
    xZero32(cx.buf, XReg64.Rdx)
    xDivR(cx.buf, r)
  }
  // Quotient in rax, remainder in rdx.
  let result = XReg64.Rdx
  if (op == XDivOp.SDiv || op == XDivOp.UDiv) {
    result = XReg64.Rax
  }
  xPutInt(cx, dst, result)
}

// `dst = -operand` / `dst = ~operand`. Both set bits above the type width — neg
// is a two's-complement negate and bnot flips every bit — so both re-narrow.
function xEmitUnaryInt(cx: XCtx, isNeg: bool, dst: int, operand: int, w: Width) {
  let v = xGetInt(cx, operand, xScratch1())
  xMovRR(cx.buf, xScratch1(), v)
  if (isNeg) {
    xNegR(cx.buf, xScratch1())
  } else {
    xNotR(cx.buf, xScratch1())
  }
  xCanonNarrow(cx.buf, xScratch1(), w)
  xPutInt(cx, dst, xScratch1())
}

// ---------------------------------------------------------------------------
// Compare selectors
// ---------------------------------------------------------------------------

// `dst = lhs <cc> rhs` for integers. setcc must read the flags the cmp just
// set, so the destination is widened afterwards with movzx rather than zeroed
// beforehand — a zeroing xor between the compare and the setcc would clobber
// exactly the flags being read.
function xEmitIcmp(cx: XCtx, cc: int, dst: int, lhs: int, rhs: int) {
  let l = xGetInt(cx, lhs, xScratch1())
  let r = xGetInt(cx, rhs, xScratch2())
  xArithRR(cx.buf, XArith.Cmp, l, r)
  xSetcc(cx.buf, cc, xScratch1())
  xMovzxb(cx.buf, xScratch1(), xScratch1())
  xPutInt(cx, dst, xScratch1())
}

enum XFCmp {
  FEq,
  FNe,
  FLt,
  FLe,
  FGt,
  FGe,
}

// `dst = lhs <cc> rhs` for floats — IEEE semantics, which is why this is not
// just an icmp with different condition codes.
//
// ucomis sets ZF/PF/CF, and PF (parity) means UNORDERED — at least one operand
// is NaN. Three consequences:
//   - LT/LE cannot use the signed condition codes: those read TRUE on an
//     unordered result. Instead the operands are SWAPPED and the unsigned
//     above/above-equal codes used, which read false when unordered.
//   - EQ must be "equal AND ordered": ucomis sets ZF for equal AND for
//     unordered, so `sete` alone would make NaN == NaN true.
//   - NE must be "not-equal OR unordered", so NaN != NaN stays true.
function xEmitFcmp(cx: XCtx, op: XFCmp, dst: int, lhs: int, rhs: int, width: int) {
  let l = xGetFloat(cx, lhs, xFScratch1())
  let r = xGetFloat(cx, rhs, xFScratch2())
  if (op == XFCmp.FGt || op == XFCmp.FGe) {
    xUcomis(cx.buf, l, r, width)
    if (op == XFCmp.FGt) {
      xSetcc(cx.buf, ccA(), xScratch1())
    } else {
      xSetcc(cx.buf, ccAe(), xScratch1())
    }
  } else if (op == XFCmp.FLt || op == XFCmp.FLe) {
    // Swapped: `lhs < rhs` is `rhs > lhs`, letting the unordered-false codes do
    // the work.
    xUcomis(cx.buf, r, l, width)
    if (op == XFCmp.FLt) {
      xSetcc(cx.buf, ccA(), xScratch1())
    } else {
      xSetcc(cx.buf, ccAe(), xScratch1())
    }
  } else if (op == XFCmp.FEq) {
    xUcomis(cx.buf, l, r, width)
    xSetcc(cx.buf, ccNp(), xScratch2()) // ordered
    xSetcc(cx.buf, ccE(), xScratch1())  // equal
    xAnd8(cx.buf, xScratch1(), xScratch2())
  } else {
    assert(op == XFCmp.FNe)
    xUcomis(cx.buf, l, r, width)
    xSetcc(cx.buf, ccP(), xScratch2())  // unordered
    xSetcc(cx.buf, ccNe(), xScratch1()) // not equal
    xOr8(cx.buf, xScratch1(), xScratch2())
  }
  xMovzxb(cx.buf, xScratch1(), xScratch1())
  xPutInt(cx, dst, xScratch1())
}

// `dst = lhs <op> rhs` for floats.
function xEmitBinaryFloat(cx: XCtx, op: XFArith, dst: int, lhs: int, rhs: int, width: int) {
  let l = xGetFloat(cx, lhs, xFScratch1())
  let r = xGetFloat(cx, rhs, xFScratch2())
  xMovFRR(cx.buf, xFScratch1(), l, width)
  xFArithRR(cx.buf, op, xFScratch1(), r, width)
  xPutFloat(cx, dst, xFScratch1())
}

// `T(x)` numeric conversion (SPEC §12.9). An int operand is first canonicalized
// from its SOURCE width — recovering its true value — then re-canonicalized to
// the DESTINATION width. Doing both is what makes widening, narrowing, and
// same-size conversions all correct through one path.
function xEmitConvert(cx: XCtx, dst: int, src: int, sw: Width, dw: Width) {
  if (sw.class == RegClass.Int && dw.class == RegClass.Int) {
    let r = xGetInt(cx, src, xScratch1())
    xMovRR(cx.buf, xScratch1(), r)
    xExtendReg(cx.buf, xScratch1(), sw.bytes, sw.signed)
    xExtendReg(cx.buf, xScratch1(), dw.bytes, dw.signed)
    xPutInt(cx, dst, xScratch1())
    return
  }
  if (sw.class == RegClass.Int && dw.class == RegClass.Float) {
    let r = xGetInt(cx, src, xScratch1())
    xMovRR(cx.buf, xScratch1(), r)
    xExtendReg(cx.buf, xScratch1(), sw.bytes, sw.signed)
    xCvtI2F(cx.buf, xFScratch1(), xScratch1(), dw.bytes)
    xPutFloat(cx, dst, xFScratch1())
    return
  }
  if (sw.class == RegClass.Float && dw.class == RegClass.Int) {
    let x = xGetFloat(cx, src, xFScratch1())
    xCvtF2I(cx.buf, xScratch1(), x, sw.bytes)
    xExtendReg(cx.buf, xScratch1(), dw.bytes, dw.signed)
    xPutInt(cx, dst, xScratch1())
    return
  }
  let x = xGetFloat(cx, src, xFScratch1())
  if (sw.bytes == dw.bytes) {
    xMovFRR(cx.buf, xFScratch1(), x, sw.bytes)
  } else {
    xCvtF2F(cx.buf, xFScratch1(), x, sw.bytes)
  }
  xPutFloat(cx, dst, xFScratch1())
}

// ---------------------------------------------------------------------------
// Constants, shifts, and memory selectors
// ---------------------------------------------------------------------------

// `movq/movd xmm, r64/r32` — moves raw BITS from a GPR into an xmm, no
// conversion. REX.W is the whole difference between movq (64) and movd (32).
// This is how a float constant is materialized: build its bit pattern in a GPR,
// then move the bits across.
function xMovXG(b: X64Buf, dst: XmmReg, src: XReg64, width: int) {
  xEmitByte(b, 0x66)
  xMaybeRex(b, width == 8, xNeedsRexBit(xmmNum(dst)), false, xNeedsRexBit(xRegNum(src)))
  xEmitByte(b, 0x0F)
  xEmitByte(b, 0x6E)
  xEmitByte(b, xModrmReg(xmmNum(dst), xRegNum(src)))
}

function xEmitConstInt(cx: XCtx, dst: int, val: int) {
  xMovRI(cx.buf, xScratch1(), val)
  xPutInt(cx, dst, xScratch1())
}

// A float constant is materialized by its BITS, not by any conversion — the
// literal's exact IEEE encoding goes into a GPR and then across to an xmm.
function xEmitConstFloat(cx: XCtx, dst: int, bits: int, width: int) {
  xMovRI(cx.buf, xScratch1(), bits)
  xMovXG(cx.buf, xFScratch1(), xScratch1(), width)
  xPutFloat(cx, dst, xFScratch1())
}

// `dst = lhs << rhs` / `>> rhs`. `constAmt >= 0` selects the immediate form;
// otherwise the count goes through cl, x86-64's only variable shift count —
// which is why a function with a variable shift excludes rcx from allocation.
function xEmitShiftInt(cx: XCtx, op: XShift, dst: int, lhs: int, rhs: int, constAmt: int, w: Width) {
  let l = xGetInt(cx, lhs, xScratch1())
  xMovRR(cx.buf, xScratch1(), l)
  if (constAmt >= 0) {
    xShiftImm(cx.buf, op, xScratch1(), constAmt)
  } else {
    let r = xGetInt(cx, rhs, xScratch2())
    xMovRR(cx.buf, XReg64.Rcx, r)
    xShiftCl(cx.buf, op, xScratch1())
  }
  // Only a LEFT shift pushes bits past the type width. The right shifts carry a
  // canonical operand to a canonical result, so they need no re-narrowing —
  // and that is exactly why the canonical invariant is worth maintaining.
  if (op == XShift.Shl) {
    xCanonNarrow(cx.buf, xScratch1(), w)
  }
  xPutInt(cx, dst, xScratch1())
}

// `dst = base.field`. `base` is already the GC body pointer (runtime/ABI.md §1:
// codegen never sees the header), so `offset` is a plain byte offset with no
// header adjustment.
//
// `isArray` marks a fixed-size array field, which is INLINE storage: its value
// is the interior address `base + offset`, formed with lea — loading a word
// there would read the array's first element as if it were the array itself.
function xEmitFieldGet(cx: XCtx, dst: int, base: int, offset: int, w: Width, isArray: bool) {
  let baseReg = xGetInt(cx, base, xScratch2())
  if (isArray) {
    xLea(cx.buf, xScratch1(), baseReg, offset)
    xPutInt(cx, dst, xScratch1())
    return
  }
  if (w.class == RegClass.Int) {
    xMovLoad(cx.buf, xScratch1(), xMemB(baseReg, offset), w.bytes, w.signed)
    xPutInt(cx, dst, xScratch1())
    return
  }
  xMovFLoad(cx.buf, xFScratch1(), xMemB(baseReg, offset), w.bytes)
  xPutFloat(cx, dst, xFScratch1())
}

// `base.field = value`. The base is fetched into the SECONDARY scratch so the
// primary stays free for the value — fetching both into the same scratch would
// have the second overwrite the first.
function xEmitFieldSet(cx: XCtx, base: int, offset: int, value: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  if (w.class == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, xMemB(baseReg, offset), v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, xMemB(baseReg, offset), v, w.bytes)
}

// `dst = len(slice)` — the `len` word at offset 8 of a slice or string header
// (runtime/ABI.md §2). Shared by both, which is why one selector covers them.
function xEmitSliceLen(cx: XCtx, dst: int, base: int) {
  let baseReg = xGetInt(cx, base, xScratch2())
  xMovLoad(cx.buf, xScratch1(), xMemB(baseReg, 8), 8, false)
  xPutInt(cx, dst, xScratch1())
}

// `dst = base[index]` for a STATIC array only. A dynamic slice carries a
// header and goes through the bounds-checked slice_get runtime call instead, so
// lower.bit never emits index_get against one. The address is
// `base + index*width` — no header, a static length (lower.bit's array scheme).
function xEmitIndexGet(cx: XCtx, dst: int, base: int, index: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.class == RegClass.Int) {
    xMovLoad(cx.buf, xScratch1(), m, w.bytes, w.signed)
    xPutInt(cx, dst, xScratch1())
    return
  }
  xMovFLoad(cx.buf, xFScratch1(), m, w.bytes)
  xPutFloat(cx, dst, xFScratch1())
}

function xEmitIndexSet(cx: XCtx, base: int, index: int, value: int, w: Width) {
  let baseReg = xGetInt(cx, base, xScratch2())
  let idxReg = xGetInt(cx, index, xScratch3())
  let m = xMemBI(baseReg, idxReg, w.bytes, 0)
  if (w.class == RegClass.Int) {
    let v = xGetInt(cx, value, xScratch1())
    xMovStore(cx.buf, m, v, w.bytes)
    return
  }
  let v = xGetFloat(cx, value, xFScratch1())
  xMovFStore(cx.buf, m, v, w.bytes)
}

// ---------------------------------------------------------------------------
// Prologue and epilogue
// ---------------------------------------------------------------------------

// Establishes the frame: chain rbp, save the callee-saved GPRs, carve the
// frame, then stash the callee-saved XMMs into it.
//
// The XMM saves come AFTER `sub rsp` on purpose — they live inside the frame
// the sub just carved, so storing them first would write below rsp, into the
// red zone a signal handler may clobber.
function xEmitPrologue(cx: XCtx) {
  xPush(cx.buf, XReg64.Rbp)
  xMovRR(cx.buf, XReg64.Rbp, XReg64.Rsp)
  for r of cx.frame.savedGpr {
    xPush(cx.buf, r)
  }
  if (cx.frame.frameSize > 0) {
    xRspAddSub(cx.buf, true, cx.frame.frameSize)
  }
  let i = 0
  while (i < len(cx.frame.savedXmm)) {
    xMovFStore(cx.buf, xMemB(XReg64.Rbp, xXmmSaveOffset(cx.frame, i)), cx.frame.savedXmm[i], 8)
    i = i + 1
  }
}

// Tears it down in the exact mirror order. The GPR pops MUST run in reverse:
// the stack is LIFO, so popping in push order restores every register's value
// into the wrong register.
function xEmitEpilogue(cx: XCtx) {
  let i = 0
  while (i < len(cx.frame.savedXmm)) {
    xMovFLoad(cx.buf, cx.frame.savedXmm[i], xMemB(XReg64.Rbp, xXmmSaveOffset(cx.frame, i)), 8)
    i = i + 1
  }
  if (cx.frame.frameSize > 0) {
    xRspAddSub(cx.buf, false, cx.frame.frameSize)
  }
  let j = len(cx.frame.savedGpr)
  while (j > 0) {
    j = j - 1
    xPop(cx.buf, cx.frame.savedGpr[j])
  }
  xPop(cx.buf, XReg64.Rbp)
}

// ---------------------------------------------------------------------------
// Call selectors
// ---------------------------------------------------------------------------

// Records a safepoint at the CURRENT code offset. Called immediately after a
// call instruction, so the offset is the RETURN ADDRESS — which is what the
// collector's stack walker looks a frame up by (runtime/ABI.md §5). Recording
// the call's own offset instead would leave every lookup missing.
// Records the CURRENT code offset as the next safepoint's return address. Call
// it immediately AFTER the call instruction: the collector's stack walker looks a
// frame up by its return address (runtime/ABI.md §5), so recording the call's own
// offset leaves every lookup missing and the frame's live pointers invisible.
function xRecordSafepoint(cx: XCtx) {
  cx.safepointCodeOffsets[cx.nextSafepointIdx] = len(cx.buf.code)
  cx.nextSafepointIdx = cx.nextSafepointIdx + 1
}

// The register a call's first argument goes in — the one place the two
// conventions differ for a single-argument runtime call.
function xArg0(cc: XCallConv): XReg64 {
  if (cc == XCallConv.Win64) {
    return XReg64.Rcx
  }
  return XReg64.Rdi
}

// A closure value is a pointer to a 16-byte GC cell {code_ptr, env_ptr}: the
// code pointer at +0 (into .text, never a GC reference) and the captured
// environment at +8 (the cell's one GC field). Keeping a closure one word lets
// it flow through the register allocator like any other reference.
function xClosureCellSize(): int {
  return 16
}

function xClosureCellPtrOffsets(): []int {
  return [8]
}

// ---------------------------------------------------------------------------
// Value selectors: constants, fneg, allocation, closures
// ---------------------------------------------------------------------------

// `fneg`: x86-64 has no scalar float negate, so subtract from +0.0. Zeroing with
// xorps and subtracting is the whole trick — note 0.0 - x, NOT x - 0.0, which is
// the identity and would silently leave the value unchanged.
function xEmitFneg(cx: XCtx, dst: int, operand: int, width: int) {
  let v = xGetFloat(cx, operand, xFScratch2())
  xXorp(cx.buf, xFScratch1(), xFScratch1(), width)
  xFArithRR(cx.buf, XFArith.FSub, xFScratch1(), v, width)
  xPutFloat(cx, dst, xFScratch1())
}

// `const_string` loads the address of its static string header (`__bitstr_N`,
// N = the string-pool index) — the driver emits that header ({ptr,len} + the
// bytes) into .rodata under the same name. v1 string literals are static, so the
// value is a plain pointer and never a GC reference.
function xEmitConstString(cx: XCtx, dst: int, poolIdx: int) {
  xMovAbsSymbol(cx, xScratch1(), "__bitstr_${poolIdx}")
  xPutInt(cx, dst, xScratch1())
}

function xEmitConstBool(cx: XCtx, dst: int, val: bool) {
  let v = 0
  if (val) {
    v = 1
  }
  xMovRI(cx.buf, xScratch1(), v)
  xPutInt(cx, dst, xScratch1())
}

// `nil` is the null pointer. Zeroing via `xor r32, r32` is 2 bytes shorter than
// a mov of 0 and clears the full 64-bit register (a 32-bit write zero-extends).
function xEmitConstNil(cx: XCtx, dst: int) {
  xZero32(cx.buf, xScratch1())
  xPutInt(cx, dst, xScratch1())
}

// Calls `bit_rt_gc_alloc(typeinfo)` -> zeroed body pointer in rax. A real call
// and a GC point, so it records a safepoint at the RETURN address: a collection
// triggered by this very allocation must find the caller's live pointers in the
// stack map. buildIntervals counts gc_alloc as a safepoint site, so the slot
// exists to record into.
function xEmitGcAlloc(cx: XCtx, dst: int, disc: int, size: int, ptrOffsets: []int) {
  xMovAbsSymbol(cx, xArg0(cx.cc), typeInfoSymbol(disc, size, ptrOffsets))
  // Win64 requires 32 bytes of shadow space the callee may write, above the
  // return address; SysV has none.
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, "bit_rt_gc_alloc")
  xRecordSafepoint(cx)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  xPutInt(cx, dst, XReg64.Rax)
}

// `type_info`: materialize a named type's static TypeInfo address. NOT a call
// and NOT a GC point — the descriptor is a .rodata constant, and its non-
// reference result type keeps it out of the stack map.
function xEmitTypeInfo(cx: XCtx, dst: int, disc: int, size: int, ptrOffsets: []int) {
  xMovAbsSymbol(cx, XReg64.Rax, typeInfoSymbol(disc, size, ptrOffsets))
  xPutInt(cx, dst, XReg64.Rax)
}

// `make_closure`: allocate the {code, env} cell (a GC point, like gc_alloc), then
// store the target's address at +0 and the already-materialized environment at
// +8. The env load happens AFTER the call — rax holds the cell, and a value read
// before the call could have been in a caller-saved register the call clobbered.
function xEmitMakeClosure(cx: XCtx, dst: int, funcName: string, env: int, disc: int) {
  xMovAbsSymbol(cx, xArg0(cx.cc), typeInfoSymbol(disc, xClosureCellSize(), xClosureCellPtrOffsets()))
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, true, 32)
  }
  xCallReloc(cx, "bit_rt_gc_alloc")
  xRecordSafepoint(cx)
  if (cx.cc == XCallConv.Win64) {
    xRspAddSub(cx.buf, false, 32)
  }
  xMovAbsSymbol(cx, xScratch1(), funcName)
  xMovStore(cx.buf, xMemB(XReg64.Rax, 0), xScratch1(), 8)
  let envReg = xGetInt(cx, env, xScratch1())
  xMovStore(cx.buf, xMemB(XReg64.Rax, 8), envReg, 8)
  xPutInt(cx, dst, XReg64.Rax)
}

// `func_addr`: a function's code address via an absolute relocation to its own
// symbol — the same primitive make_closure fills a cell's code slot with, minus
// the cell. No call, no safepoint.
function xEmitFuncAddr(cx: XCtx, dst: int, funcName: string) {
  xMovAbsSymbol(cx, xScratch1(), funcName)
  xPutInt(cx, dst, xScratch1())
}
