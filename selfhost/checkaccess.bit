// selfhost/checkaccess.bit — split out of check.bit (#1809). Sibling of
// check.bit: same module, so this needs no imports and no call-site
// changes. Grouping follows the layout recorded at
// tag rescue/task-1689-stale-split.

// The link-level name for a function `base` declared in module `mod`, given the
// root module id. Mirrors the seed's `moduleQualified` exactly: the root keeps
// bare names (so `main` stays `main`, and a single-module build stays
// byte-identical), every other module gets an `m<id>$` prefix so two modules'
// same-named functions cannot collide in the object's flat symbol namespace.
function moduleQualified(mod: int, root: int, base: string): string {
  if (mod == root) {
    return base
  }
  return "m${mod}\$${base}"
}

// SPEC 11.7: the raw external symbol `name` binds to, or "" when `name` is not
// an `extern function`. Mirrors declOwner's local-shadows-import rule so the
// answer always comes from the module that actually declares the name.
function externSymbolOf(c: Checker, name: string): string {
  for (k, _) of c.funcDecls {
    if (k == name) {
      let (_, local) = c.externFns[name]
      if (local) {
        return name
      }
      return ""
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok || o.module < 0 || o.module >= len(c.mods)) {
    let (_, here) = c.externFns[name]
    if (here) {
      return name
    }
    return ""
  }
  let (_, remote) = c.mods[o.module].externFns[o.name]
  if (remote) {
    return o.name
  }
  return ""
}

// SPEC 11.9: the link name `name` is pinned to by `@symbol("...")`, or "" when
// it pins none. The decl NODE is read against declOwner's tree, never `c`'s: an
// imported function's node index only means anything inside its own tree.
function pinnedSymbolOf(c: Checker, name: string): string {
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return ""
  }
  return funcAttrArg(declOwner(c, name), decl, "symbol")
}

// The link name for a call to `name` from `c`: an imported name resolves to its
// DEFINING module's prefix under its ORIGINAL spelling, so neither the caller's
// module nor a local alias reaches the object file.
function callQualified(c: Checker, root: int, name: string): string {
  // SPEC 11.7: an extern symbol is NEVER module-qualified — the raw name is
  // precisely the symbol the linker must import from the dylib.
  let ext = externSymbolOf(c, name)
  if (ext != "") {
    return ext
  }
  // SPEC 11.9: a pinned function's DEFINITION is emitted under the pinned name
  // (lowerFuncNamed), bypassing module qualification, so a call to it must be
  // spelled the same way. Without this the definition lands as `bit_rt_f` while
  // the call emits `m<id>$f` — an unresolvable reference that fails far from its
  // cause: dead-stripped when unreferenced, a dyld abort at load on Darwin.
  // Checked AFTER extern so an `extern function` (which has no attribute list at
  // kid 6) never reaches funcAttrArg; §11.7 consumes a symbol, §11.9 produces
  // one, and the two are disjoint by construction.
  let pin = pinnedSymbolOf(c, name)
  if (pin != "") {
    return pin
  }
  // A locally-declared function shadows a same-named prelude/import (§17.5), so
  // it links against THIS module's symbol — the same prefix its definition gets
  // (they share a module). Consulting the import first mis-qualifies a local
  // `unwrapOr` to the prelude's `m0$unwrapOr` while its definition stays bare,
  // and the link fails on the unresolved symbol. Mirrors funcDeclLookup.
  for (k, v) of c.funcDecls {
    if (k == name) {
      return moduleQualified(c.moduleId, root, name)
    }
  }
  let (o, ok) = c.importedFrom[name]
  if (!ok) {
    return moduleQualified(c.moduleId, root, name)
  }
  return moduleQualified(o.module, root, o.name)
}

// The enum type-args a variant construction `Enum.Variant(args)` binds, inferred
// from the variant's bare-type-param payload slots and their argument types
// (`Opt.Some(9)` binds Opt's T from arg 9 -> i64). The decl is read from the
// module that declares the enum (see typeOwner); only the CALL node and its
// arguments belong to this module's tree.
function variantConstructionTypeArgs(c: Checker, callNode: int): []int {
  let out = []int(0)
  let mk = kidsOf(c.tree, kidsOf(c.tree, callNode)[0])
  let enumName = typeNodeName(c, mk[0])
  let vnn = getNode(c.tree, mk[1])
  let vname = c.source[vnn.span.start:vnn.span.end]
  let enumTy = userTypeLookup(c, enumName)
  if (enumTy == 0 || c.ctx.types[enumTy].kind != TypeKind.Enum) {
    return out
  }
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return out
  }
  let tps = kidsOf(oc.tree, kidsOf(oc.tree, decl)[1])
  // Locate this variant's payload type nodes.
  let vs = enumVariantNodes(oc, decl)
  let payloadNodes = []int(0)
  let vi = 0
  while (vi < len(vs)) {
    let vn2 = getNode(oc.tree, kidsOf(oc.tree, vs[vi])[0])
    if (oc.source[vn2.span.start:vn2.span.end] == vname) {
      let pl = kidsOf(oc.tree, vs[vi])[1]
      if (pl != 0) {
        payloadNodes = kidsOf(oc.tree, pl)
      }
      vi = len(vs)
    } else {
      vi = vi + 1
    }
  }
  let ti = 0
  while (ti < len(tps)) {
    let tpn = getNode(oc.tree, kidsOf(oc.tree, tps[ti])[0])
    let tpname = oc.source[tpn.span.start:tpn.span.end]
    let bound = c.ctx.voidId
    let pj = 0
    while (pj < len(payloadNodes)) {
      let pn2 = getNode(oc.tree, payloadNodes[pj])
      if (pn2.tag == Tag.Ident && oc.source[pn2.span.start:pn2.span.end] == tpname) {
        bound = defaultType(c, checkArgType(c, callNode, pj))
        pj = len(payloadNodes)
      } else {
        pj = pj + 1
      }
    }
    out = append(out, bound)
    ti = ti + 1
  }
  return out
}
