// In-Bit self-checks for lowering: method tables, escape decoding, UTF-8
// encoding. Split out of selfcheck.bit (#1503); sibling .bit files are the
// same module, so `selfcheck()` still calls these directly.

// Stage 2 gap (found while porting emit): per-type method tables. Nothing in the
// IR dump renders the TABLE, so no differential covers its structure — but its
// three fields are each transitively verified against the seed:
//   id       — the seed's dump prints `call_iface %0.0()` / `%14.1()`
//   func     — the seed's headers read `func read$t23` / `func tag$t23`
//   typeDisc — the same `$t23` mangling
// all inside the 121/122 IR differential. This pins the structure the emitter
// reads.
function checkMethodTables() {
  let src = "interface S {\n  read(): i64\n  tag(): i64\n}\n" +
    "struct Ok {\n  n: i64,\n}\n" +
    "function (o: Ok) read(): i64 {\n  return o.n\n}\n" +
    "function (o: Ok) tag(): i64 {\n  return 7\n}\n" +
    // Bad defines ONLY `tag` — deliberately not `read`. A dispatch id is global
    // per NAME (tag == 1, since read was seen first), not positional within a
    // table (where tag would be 0 as Bad's only method). A fixture where both
    // types declare the same method first cannot tell those apart.
    "struct Bad {\n  n: i64,\n}\n" +
    "function (b: Bad) tag(): i64 {\n  return 0\n}\n" +
    "function main() {\n  let o = Ok{ n: 1 }\n  let _ = o.read()\n}\n"
  let m = lowerSourceModule(src)

  // One table per distinct receiver, in first-seen order — Ok before Bad.
  assert(len(m.methodTables) == 2)
  let ok = m.methodTables[0]
  let bad = m.methodTables[1]
  assert(ok.typeDisc != bad.typeDisc)

  // Ok's methods in DECLARATION order, each mangled by its receiver.
  assert(len(ok.methods) == 2)
  assert(ok.methods[0].func == "read\$t${ok.typeDisc}")
  assert(ok.methods[1].func == "tag\$t${ok.typeDisc}")
  // A method NAME's dispatch id is global: Bad.tag carries the SAME id as Ok.tag
  // (1), not 0 — which is what makes call_iface resolve one name across types.
  assert(len(bad.methods) == 1)
  assert(bad.methods[0].id == ok.methods[1].id)
  assert(bad.methods[0].func == "tag\$t${bad.typeDisc}")
  // Distinct names get distinct ids.
  assert(ok.methods[0].id != ok.methods[1].id)

  // Lookup by discriminator is what the emitter does; an unknown type has none.
  assert(len(methodTableOf(m, ok.typeDisc).methods) == 2)
  assert(len(methodTableOf(m, 9999).methods) == 0)

  // A program with no methods builds no tables at all.
  let m2 = lowerSourceModule("function main() {\n}\n")
  assert(len(m2.methodTables) == 0)
}

// Stage 2 (#1345) the project loader's pure path/listing logic. The loading
// itself needs a real directory tree and is covered by the multi-module build
// tests; what is checked here is the part that silently produces the WRONG
// module if it is off by one component.

// Stage 2 (#1345) `\x` / `\u{…}` string escapes. These decide the BYTES of a
// string literal, so a wrong answer here is silently wrong output, never a
// crash — and the two compilers must agree exactly.

function checkEscapes() {
  // The plain escapes, unchanged.
  assert(decodeEscapes("\"a\\nb\"", 1, 5) == "a\nb")
  assert(decodeEscapes("\"\\t\\r\\0\"", 1, 7) == "\t\r\0")
  // A backslash before an ordinary char yields that char (the seed's `else`).
  assert(decodeEscapes("\"\\q\"", 1, 3) == "q")

  // `\xNN` is ONE RAW BYTE, not a codepoint: "\xff" must be a single 0xFF byte,
  // not the two bytes UTF-8 would use for U+00FF.
  assert(decodeEscapes("\"\\x41\"", 1, 5) == "A")
  let ff = decodeEscapes("\"\\xff\"", 1, 5)
  assert(len(ff) == 1 && ff[0] == u8(0xff))
  // Lower and upper hex digits both decode.
  assert(decodeEscapes("\"\\xAb\"", 1, 5) == decodeEscapes("\"\\xaB\"", 1, 5))
  // A malformed `\x` stops the decode where the seed's `catch break` does.
  assert(decodeEscapes("\"\\xzz\"", 1, 5) == "")
  assert(decodeEscapes("\"\\x4\"", 1, 4) == "") // truncated: needs two digits

  // `\u{…}` encodes UTF-8 at every boundary width.
  assert(decodeEscapes("\"\\u{41}\"", 1, 7) == "A")           // 1 byte
  assert(len(decodeEscapes("\"\\u{80}\"", 1, 7)) == 2)         // first 2-byte cp
  assert(len(decodeEscapes("\"\\u{7FF}\"", 1, 8)) == 2)        // last 2-byte cp
  assert(len(decodeEscapes("\"\\u{800}\"", 1, 8)) == 3)        // first 3-byte cp
  assert(len(decodeEscapes("\"\\u{FFFF}\"", 1, 9)) == 3)       // last 3-byte cp
  assert(len(decodeEscapes("\"\\u{10000}\"", 1, 10)) == 4)     // first 4-byte cp
  assert(len(decodeEscapes("\"\\u{10FFFF}\"", 1, 11)) == 4)    // last valid cp
  assert(decodeEscapes("\"\\u{3C0}\"", 1, 8) == "π")

  // A surrogate half is not encodable as UTF-8; encoding one would emit bytes no
  // decoder accepts, so it stops like the seed's utf8Encode error does.
  assert(decodeEscapes("\"\\u{D800}\"", 1, 9) == "")
  // Past U+10FFFF is not a codepoint at all.
  assert(decodeEscapes("\"\\u{110000}\"", 1, 11) == "")
  // Malformed forms stop the decode rather than guess.
  assert(decodeEscapes("\"\\u41\"", 1, 5) == "")   // no brace
  assert(decodeEscapes("\"\\u{}\"", 1, 5) == "")   // no digits
  assert(decodeEscapes("\"\\u{zz}\"", 1, 7) == "") // not hex

  // Escapes compose with literal text and each other.
  assert(decodeEscapes("\"a\\u{41}b\\x42c\"", 1, 14) == "aAbBc")
}

function checkUtf8Encode() {
  assert(utf8Append("", 0x41) == "A")
  assert(utf8Append("x", 0x41) == "xA")
  // Boundaries: the exact byte patterns, checked rather than just the length.
  let b2 = utf8Append("", 0x80)
  assert(len(b2) == 2 && b2[0] == u8(0xC2) && b2[1] == u8(0x80))
  let b3 = utf8Append("", 0x800)
  assert(len(b3) == 3 && b3[0] == u8(0xE0) && b3[1] == u8(0xA0) && b3[2] == u8(0x80))
  let b4 = utf8Append("", 0x10FFFF)
  assert(len(b4) == 4 && b4[0] == u8(0xF4) && b4[1] == u8(0x8F) &&
    b4[2] == u8(0xBF) && b4[3] == u8(0xBF))
  // π = U+03C0 -> CF 80.
  let pi = utf8Append("", 0x3C0)
  assert(len(pi) == 2 && pi[0] == u8(0xCF) && pi[1] == u8(0x80))

  assert(hexDigitVal('0') == 0 && hexDigitVal('9') == 9)
  assert(hexDigitVal('a') == 10 && hexDigitVal('f') == 15)
  assert(hexDigitVal('A') == 10 && hexDigitVal('F') == 15)
  assert(hexDigitVal('g') == -1 && hexDigitVal('/') == -1 && hexDigitVal(':') == -1)

  assert(isEncodableCodepoint(0) && isEncodableCodepoint(0x10FFFF))
  assert(!isEncodableCodepoint(0x110000) && !isEncodableCodepoint(-1))
  // The surrogate range is reserved for UTF-16 and must never be encoded.
  assert(!isEncodableCodepoint(0xD800) && !isEncodableCodepoint(0xDFFF))
  assert(isEncodableCodepoint(0xD7FF) && isEncodableCodepoint(0xE000))
}
