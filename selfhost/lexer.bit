// Self-host Stage 1 (#1334): the lexer, ported from compiler/lexer.zig. This
// first cut covers the string-free core — whitespace + comment trivia, automatic
// semicolons (§7), identifiers + keywords, decimal integers, and the full
// operator/delimiter set with maximal munch. Strings, interpolation, runes,
// floats, and non-decimal bases are deferred to a follow-up; scanToken emits
// `Invalid` for a string/rune opener until then. Spans and token kinds match the
// seed so `bitc2 --dump-tokens` can be diffed byte-for-byte once the driver lands.

enum Kind {
  Eof,
  Invalid,
  Ident,
  IntLit,
  FloatLit,
  StringLit,
  RawStringLit,
  RuneLit,
  BoolLit,
  NilLit,
  StrPart,
  InterpStart,
  InterpEnd,
  KwAs,
  KwBreak,
  KwCase,
  KwCatch,
  KwChan,
  KwConst,
  KwContinue,
  KwDefault,
  KwDefer,
  KwElse,
  KwEnum,
  KwExport,
  KwFail,
  KwFor,
  KwFrom,
  KwFunction,
  KwIf,
  KwImport,
  KwIn,
  KwInterface,
  KwLet,
  KwMap,
  KwMatch,
  KwOf,
  KwReturn,
  KwSelect,
  KwSpawn,
  KwStruct,
  KwSwitch,
  KwType,
  KwWhile,
  Plus,
  Minus,
  Star,
  Slash,
  Percent,
  Amp,
  Pipe,
  Caret,
  Shl,
  Shr,
  Tilde,
  AmpAmp,
  PipePipe,
  Bang,
  EqEq,
  BangEq,
  Lt,
  LtEq,
  Gt,
  GtEq,
  Eq,
  PlusEq,
  MinusEq,
  StarEq,
  SlashEq,
  PercentEq,
  AmpEq,
  PipeEq,
  CaretEq,
  ShlEq,
  ShrEq,
  PlusPlus,
  MinusMinus,
  LParen,
  RParen,
  LBracket,
  RBracket,
  LBrace,
  RBrace,
  Comma,
  Semicolon,
  Colon,
  Dot,
  Ellipsis,
  FatArrow,
  Question,
  ArrowLeft,
}

struct Token {
  kind: Kind,
  start: int,
  end: int,
}

struct Lexer {
  src: string,
  i: int,
  last: Kind,
}

function newLexer(src: string): Lexer {
  return Lexer{ src: src, i: 0, last: Kind.Eof }
}

function isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

function isIdentStart(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}

function isIdentCont(c: u8): bool {
  return isIdentStart(c) || isDigit(c)
}

// The byte `off` ahead of the cursor, or 0 past end (a sentinel that matches no
// real token character), mirroring the seed's peekAt.
function peekAt(lx: Lexer, off: int): u8 {
  let j = lx.i + off
  if (j < len(lx.src)) {
    return lx.src[j]
  }
  return 0
}

// A line ending after one of these tokens gets a synthesized `;` (§7). Uses enum
// `==`; see §14.6. `>`/`>>`/`!` are closers here (generic close, fallible marker),
// so they terminate — `>=`/`>>=` never close a type and are excluded.
function isTerminator(k: Kind): bool {
  return k == Kind.Ident || k == Kind.IntLit || k == Kind.FloatLit ||
    k == Kind.StringLit || k == Kind.RawStringLit || k == Kind.RuneLit ||
    k == Kind.BoolLit || k == Kind.NilLit || k == Kind.StrPart ||
    k == Kind.KwReturn || k == Kind.KwBreak || k == Kind.KwContinue ||
    k == Kind.KwFail || k == Kind.RParen || k == Kind.RBracket ||
    k == Kind.RBrace || k == Kind.Gt || k == Kind.Shr ||
    k == Kind.PlusPlus || k == Kind.MinusMinus || k == Kind.Question ||
    k == Kind.Bang
}

function keywordKind(word: string): Kind {
  if (word == "as") { return Kind.KwAs }
  if (word == "break") { return Kind.KwBreak }
  if (word == "case") { return Kind.KwCase }
  if (word == "catch") { return Kind.KwCatch }
  if (word == "chan") { return Kind.KwChan }
  if (word == "const") { return Kind.KwConst }
  if (word == "continue") { return Kind.KwContinue }
  if (word == "default") { return Kind.KwDefault }
  if (word == "defer") { return Kind.KwDefer }
  if (word == "else") { return Kind.KwElse }
  if (word == "enum") { return Kind.KwEnum }
  if (word == "export") { return Kind.KwExport }
  if (word == "fail") { return Kind.KwFail }
  if (word == "for") { return Kind.KwFor }
  if (word == "from") { return Kind.KwFrom }
  if (word == "function") { return Kind.KwFunction }
  if (word == "if") { return Kind.KwIf }
  if (word == "import") { return Kind.KwImport }
  if (word == "in") { return Kind.KwIn }
  if (word == "interface") { return Kind.KwInterface }
  if (word == "let") { return Kind.KwLet }
  if (word == "map") { return Kind.KwMap }
  if (word == "match") { return Kind.KwMatch }
  if (word == "of") { return Kind.KwOf }
  if (word == "return") { return Kind.KwReturn }
  if (word == "select") { return Kind.KwSelect }
  if (word == "spawn") { return Kind.KwSpawn }
  if (word == "struct") { return Kind.KwStruct }
  if (word == "switch") { return Kind.KwSwitch }
  if (word == "type") { return Kind.KwType }
  if (word == "while") { return Kind.KwWhile }
  if (word == "true") { return Kind.BoolLit }
  if (word == "false") { return Kind.BoolLit }
  if (word == "nil") { return Kind.NilLit }
  return Kind.Ident
}

// Advances the cursor by `n` and returns the token `[start, start+n)`.
function emit(lx: Lexer, start: int, n: int, k: Kind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

function scanIdent(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  return Token{ kind: keywordKind(lx.src[start:lx.i]), start: start, end: lx.i }
}

function scanNumber(lx: Lexer): Token {
  let start = lx.i
  while (lx.i < len(lx.src) && isDigit(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  return Token{ kind: Kind.IntLit, start: start, end: lx.i }
}

// The operator/delimiter dispatch, mirroring the seed's maximal munch.
function scanToken(lx: Lexer): Token {
  let start = lx.i
  let c = lx.src[start]

  if (isIdentStart(c)) { return scanIdent(lx) }
  if (isDigit(c)) { return scanNumber(lx) }

  if (c == '+') {
    if (peekAt(lx, 1) == '+') { return emit(lx, start, 2, Kind.PlusPlus) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PlusEq) }
    return emit(lx, start, 1, Kind.Plus)
  }
  if (c == '-') {
    if (peekAt(lx, 1) == '-') { return emit(lx, start, 2, Kind.MinusMinus) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.MinusEq) }
    return emit(lx, start, 1, Kind.Minus)
  }
  if (c == '*') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.StarEq) }
    return emit(lx, start, 1, Kind.Star)
  }
  if (c == '/') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.SlashEq) }
    return emit(lx, start, 1, Kind.Slash)
  }
  if (c == '%') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PercentEq) }
    return emit(lx, start, 1, Kind.Percent)
  }
  if (c == '&') {
    if (peekAt(lx, 1) == '&') { return emit(lx, start, 2, Kind.AmpAmp) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.AmpEq) }
    return emit(lx, start, 1, Kind.Amp)
  }
  if (c == '|') {
    if (peekAt(lx, 1) == '|') { return emit(lx, start, 2, Kind.PipePipe) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PipeEq) }
    return emit(lx, start, 1, Kind.Pipe)
  }
  if (c == '^') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.CaretEq) }
    return emit(lx, start, 1, Kind.Caret)
  }
  if (c == '~') { return emit(lx, start, 1, Kind.Tilde) }
  if (c == '!') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.BangEq) }
    return emit(lx, start, 1, Kind.Bang)
  }
  if (c == '=') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.EqEq) }
    if (peekAt(lx, 1) == '>') { return emit(lx, start, 2, Kind.FatArrow) }
    return emit(lx, start, 1, Kind.Eq)
  }
  if (c == '<') {
    if (peekAt(lx, 1) == '<') {
      if (peekAt(lx, 2) == '=') { return emit(lx, start, 3, Kind.ShlEq) }
      return emit(lx, start, 2, Kind.Shl)
    }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.LtEq) }
    if (peekAt(lx, 1) == '-') { return emit(lx, start, 2, Kind.ArrowLeft) }
    return emit(lx, start, 1, Kind.Lt)
  }
  if (c == '>') {
    if (peekAt(lx, 1) == '>') {
      if (peekAt(lx, 2) == '=') { return emit(lx, start, 3, Kind.ShrEq) }
      return emit(lx, start, 2, Kind.Shr)
    }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.GtEq) }
    return emit(lx, start, 1, Kind.Gt)
  }
  if (c == '(') { return emit(lx, start, 1, Kind.LParen) }
  if (c == ')') { return emit(lx, start, 1, Kind.RParen) }
  if (c == '[') { return emit(lx, start, 1, Kind.LBracket) }
  if (c == ']') { return emit(lx, start, 1, Kind.RBracket) }
  if (c == '{') { return emit(lx, start, 1, Kind.LBrace) }
  if (c == '}') { return emit(lx, start, 1, Kind.RBrace) }
  if (c == ',') { return emit(lx, start, 1, Kind.Comma) }
  if (c == ';') { return emit(lx, start, 1, Kind.Semicolon) }
  if (c == ':') { return emit(lx, start, 1, Kind.Colon) }
  if (c == '.') {
    if (peekAt(lx, 1) == '.' && peekAt(lx, 2) == '.') { return emit(lx, start, 3, Kind.Ellipsis) }
    return emit(lx, start, 1, Kind.Dot)
  }
  if (c == '?') { return emit(lx, start, 1, Kind.Question) }

  // Strings/runes/raw strings are deferred; anything else is invalid. Either
  // way, consume one byte so the scan always advances.
  return emit(lx, start, 1, Kind.Invalid)
}

function semiToken(lx: Lexer, at: int): Token {
  return Token{ kind: Kind.Semicolon, start: at, end: at }
}

function skipLineComment(lx: Lexer) {
  lx.i = lx.i + 2
  while (lx.i < len(lx.src) && lx.src[lx.i] != '\n') {
    lx.i = lx.i + 1
  }
}

// Consumes a non-nesting block comment; returns whether it held a newline (which
// counts as a newline for the semicolon rule).
function skipBlockComment(lx: Lexer): bool {
  lx.i = lx.i + 2
  let hadNl = false
  while (lx.i + 1 < len(lx.src)) {
    if (lx.src[lx.i] == '*' && lx.src[lx.i + 1] == '/') {
      lx.i = lx.i + 2
      return hadNl
    }
    if (lx.src[lx.i] == '\n') {
      hadNl = true
    }
    lx.i = lx.i + 1
  }
  // Unterminated: consume the tail (the seed also reports; diagnostics later).
  while (lx.i < len(lx.src)) {
    if (lx.src[lx.i] == '\n') {
      hadNl = true
    }
    lx.i = lx.i + 1
  }
  return hadNl
}

function atEof(lx: Lexer): Token {
  if (isTerminator(lx.last)) {
    return semiToken(lx, lx.i)
  }
  return Token{ kind: Kind.Eof, start: lx.i, end: lx.i }
}

function skipTriviaThenToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r') {
      lx.i = lx.i + 1
    } else if (c == '\n') {
      lx.i = lx.i + 1
      if (isTerminator(lx.last)) {
        return semiToken(lx, lx.i - 1)
      }
    } else if (c == '/' && peekAt(lx, 1) == '/') {
      skipLineComment(lx)
    } else if (c == '/' && peekAt(lx, 1) == '*') {
      let hadNl = skipBlockComment(lx)
      if (hadNl && isTerminator(lx.last)) {
        return semiToken(lx, lx.i - 1)
      }
    } else {
      return scanToken(lx)
    }
  }
  return atEof(lx)
}

// The next token; `Eof` at end. Advances the lexer and records `last` for ASI.
function nextToken(lx: Lexer): Token {
  let t = skipTriviaThenToken(lx)
  lx.last = t.kind
  return t
}

// All tokens including the final `Eof`. Bounded by twice the byte length (a
// semicolon can be synthesized per line) plus the terminal eof.
function lexAll(src: string): []Token {
  let lx = newLexer(src)
  let toks = []Token(0)
  let guard = 0
  let bound = len(src) * 2 + 2
  while (guard <= bound) {
    let t = nextToken(lx)
    toks = append(toks, t)
    if (t.kind == Kind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}
