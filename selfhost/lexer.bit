// Self-host Stage 1 (#1334): the lexer, ported from compiler/lexer.zig. This
// first cut covers the string-free core — whitespace + comment trivia, automatic
// semicolons (§7), identifiers + keywords, decimal integers, and the full
// operator/delimiter set with maximal munch. Strings, interpolation, runes,
// floats, and non-decimal bases are deferred to a follow-up; scanToken emits
// `Invalid` for a string/rune opener until then. Spans and token kinds match the
// seed so `bitc2 --dump-tokens` can be diffed byte-for-byte once the driver lands.

enum Kind {
  Eof,
  Invalid,
  Ident,
  IntLit,
  FloatLit,
  StringLit,
  RawStringLit,
  RuneLit,
  BoolLit,
  NilLit,
  StrPart,
  InterpStart,
  InterpEnd,
  KwAs,
  KwBreak,
  KwCase,
  KwCatch,
  KwChan,
  KwConst,
  KwContinue,
  KwDefault,
  KwDefer,
  KwElse,
  KwEnum,
  KwExport,
  KwFail,
  KwFor,
  KwFrom,
  KwFunction,
  KwIf,
  KwImport,
  KwIn,
  KwInterface,
  KwLet,
  KwMap,
  KwMatch,
  KwOf,
  KwReturn,
  KwSelect,
  KwSpawn,
  KwStruct,
  KwSwitch,
  KwType,
  KwWhile,
  Plus,
  Minus,
  Star,
  Slash,
  Percent,
  Amp,
  Pipe,
  Caret,
  Shl,
  Shr,
  Tilde,
  AmpAmp,
  PipePipe,
  Bang,
  EqEq,
  BangEq,
  Lt,
  LtEq,
  Gt,
  GtEq,
  Eq,
  PlusEq,
  MinusEq,
  StarEq,
  SlashEq,
  PercentEq,
  AmpEq,
  PipeEq,
  CaretEq,
  ShlEq,
  ShrEq,
  PlusPlus,
  MinusMinus,
  LParen,
  RParen,
  LBracket,
  RBracket,
  LBrace,
  RBrace,
  Comma,
  Semicolon,
  Colon,
  Dot,
  Ellipsis,
  FatArrow,
  Question,
  ArrowLeft,
}

struct Token {
  kind: Kind,
  start: int,
  end: int,
}

struct Lexer {
  src: string,
  i: int,
  last: Kind,
  // Interpolation plumbing (§5.7): a one-slot pending queue lets a string
  // segment emit `StrPart` now and `InterpStart` next; `resumeString` marks that
  // the token after an `InterpEnd` continues the string body; `interp` is the
  // brace-nesting depth inside each active interpolation, innermost last.
  hasPending: bool,
  pending: Token,
  resumeString: bool,
  interp: []int,
  // Diagnostic sink + the FileId spans are stamped with. `lexAll` supplies a
  // throwaway sink (tokens-only callers); `lexAllD` threads the caller's.
  file: int,
  diags: Diagnostics,
}

function newLexer(src: string): Lexer {
  let sm = newSourceManager()
  let f = addFile(sm, "", src)
  return newLexerD(src, f, newDiagnostics(sm))
}

function newLexerD(src: string, file: int, diags: Diagnostics): Lexer {
  return Lexer{
    src: src,
    i: 0,
    last: Kind.Eof,
    hasPending: false,
    pending: Token{ kind: Kind.Eof, start: 0, end: 0 },
    resumeString: false,
    interp: []int(0),
    file: file,
    diags: diags,
  }
}

// Records a lexer diagnostic at `[start, end)` in the lexer's file.
function lexReport(lx: Lexer, code: int, start: int, end: int, msg: string, hint: string) {
  report(lx.diags, code, Span{ file: lx.file, start: start, end: end }, msg, hint)
}

// A byte as two uppercase hex digits (for `unexpected byte 0x..`).
function hex2(b: u8): string {
  let digits = "0123456789ABCDEF"
  let hi = (b >> 4) & 15
  let lo = b & 15
  return digits[hi:hi + 1] + digits[lo:lo + 1]
}

function isDigit(c: u8): bool {
  return c >= '0' && c <= '9'
}

// A byte >= 0x80 is accepted as an identifier character (the seed does not decode
// UTF-8 to check XID tables — same ponytail shortcut, kept for byte-identical
// tokens on non-ASCII identifiers).
function isIdentStart(c: u8): bool {
  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c >= 128
}

function isUtf8Cont(c: u8): bool {
  return (c & 192) == 128
}

function isIdentCont(c: u8): bool {
  return isIdentStart(c) || isDigit(c)
}

// The byte `off` ahead of the cursor, or 0 past end (a sentinel that matches no
// real token character), mirroring the seed's peekAt.
function peekAt(lx: Lexer, off: int): u8 {
  let j = lx.i + off
  if (j < len(lx.src)) {
    return lx.src[j]
  }
  return 0
}

// A line ending after one of these tokens gets a synthesized `;` (§7). Uses enum
// `==`; see §14.6. `>`/`>>`/`!` are closers here (generic close, fallible marker),
// so they terminate — `>=`/`>>=` never close a type and are excluded.
function isTerminator(k: Kind): bool {
  return k == Kind.Ident || k == Kind.IntLit || k == Kind.FloatLit ||
    k == Kind.StringLit || k == Kind.RawStringLit || k == Kind.RuneLit ||
    k == Kind.BoolLit || k == Kind.NilLit || k == Kind.StrPart ||
    k == Kind.KwReturn || k == Kind.KwBreak || k == Kind.KwContinue ||
    k == Kind.KwFail || k == Kind.RParen || k == Kind.RBracket ||
    k == Kind.RBrace || k == Kind.Gt || k == Kind.Shr ||
    k == Kind.PlusPlus || k == Kind.MinusMinus || k == Kind.Question ||
    k == Kind.Bang
}

function keywordKind(word: string): Kind {
  if (word == "as") { return Kind.KwAs }
  if (word == "break") { return Kind.KwBreak }
  if (word == "case") { return Kind.KwCase }
  if (word == "catch") { return Kind.KwCatch }
  if (word == "chan") { return Kind.KwChan }
  if (word == "const") { return Kind.KwConst }
  if (word == "continue") { return Kind.KwContinue }
  if (word == "default") { return Kind.KwDefault }
  if (word == "defer") { return Kind.KwDefer }
  if (word == "else") { return Kind.KwElse }
  if (word == "enum") { return Kind.KwEnum }
  if (word == "export") { return Kind.KwExport }
  if (word == "fail") { return Kind.KwFail }
  if (word == "for") { return Kind.KwFor }
  if (word == "from") { return Kind.KwFrom }
  if (word == "function") { return Kind.KwFunction }
  if (word == "if") { return Kind.KwIf }
  if (word == "import") { return Kind.KwImport }
  if (word == "in") { return Kind.KwIn }
  if (word == "interface") { return Kind.KwInterface }
  if (word == "let") { return Kind.KwLet }
  if (word == "map") { return Kind.KwMap }
  if (word == "match") { return Kind.KwMatch }
  if (word == "of") { return Kind.KwOf }
  if (word == "return") { return Kind.KwReturn }
  if (word == "select") { return Kind.KwSelect }
  if (word == "spawn") { return Kind.KwSpawn }
  if (word == "struct") { return Kind.KwStruct }
  if (word == "switch") { return Kind.KwSwitch }
  if (word == "type") { return Kind.KwType }
  if (word == "while") { return Kind.KwWhile }
  if (word == "true") { return Kind.BoolLit }
  if (word == "false") { return Kind.BoolLit }
  if (word == "nil") { return Kind.NilLit }
  return Kind.Ident
}

// Advances the cursor by `n` and returns the token `[start, start+n)`.
function emit(lx: Lexer, start: int, n: int, k: Kind): Token {
  lx.i = start + n
  return Token{ kind: k, start: start, end: start + n }
}

function scanIdent(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
    lx.i = lx.i + 1
  }
  return Token{ kind: keywordKind(lx.src[start:lx.i]), start: start, end: lx.i }
}

enum DigitClass {
  Dec,
  Hex,
  Oct,
  Bin,
}

function classOf(c: u8, class: DigitClass): bool {
  if (class == DigitClass.Dec) { return c >= '0' && c <= '9' }
  if (class == DigitClass.Hex) {
    return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
  }
  if (class == DigitClass.Oct) { return c >= '0' && c <= '7' }
  return c == '0' || c == '1'
}

struct DigitRun {
  count: int,
  badSep: bool,
}

// Consumes a run of base-`class` digits with `_` separators; a `_` not flanked by
// two digits is a bad separator (§5.5). Bounded by the source length.
function digitRun(lx: Lexer, class: DigitClass): DigitRun {
  let count = 0
  let bad = false
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (classOf(c, class)) {
      count = count + 1
      lx.i = lx.i + 1
    } else if (c == '_') {
      let prevOk = count > 0 && classOf(lx.src[lx.i - 1], class)
      let nextOk = lx.i + 1 < len(lx.src) && classOf(lx.src[lx.i + 1], class)
      if (!prevOk || !nextOk) {
        bad = true
      }
      lx.i = lx.i + 1
    } else {
      break
    }
  }
  return DigitRun{ count: count, badSep: bad }
}

struct ExpResult {
  present: bool,
  bad: bool,
}

// An `e`/`E`/`p`/`P` exponent with optional sign; `bad` if the digit run is
// empty or has a bad separator.
function scanExponent(lx: Lexer): ExpResult {
  let c = peekAt(lx, 0)
  if (c != 'e' && c != 'E' && c != 'p' && c != 'P') {
    return ExpResult{ present: false, bad: false }
  }
  lx.i = lx.i + 1
  if (peekAt(lx, 0) == '+' || peekAt(lx, 0) == '-') {
    lx.i = lx.i + 1
  }
  let d = digitRun(lx, DigitClass.Dec)
  return ExpResult{ present: true, bad: d.count == 0 || d.badSep }
}

// A numeric literal (§5.4/§5.5): decimal, `0x`/`0o`/`0b` bases, and decimal or
// hex floats. Mirrors the seed's scanNumber including its badness rules
// (C-octal, empty base, `_` misuse, identifier abut). An invalid literal is a
// single `Invalid` token spanning the whole bad run.
function scanNumber(lx: Lexer): Token {
  let start = lx.i
  let c0 = lx.src[start]
  let isFloat = false
  let bad = false

  if (c0 == '0' && (peekAt(lx, 1) == 'x' || peekAt(lx, 1) == 'X')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Hex)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
    // A hex float needs a 'p' exponent; a bare '.' without one is bad (§5.5).
    if (peekAt(lx, 0) == '.' || peekAt(lx, 0) == 'p' || peekAt(lx, 0) == 'P') {
      isFloat = true
      if (peekAt(lx, 0) == '.') {
        lx.i = lx.i + 1
        if (digitRun(lx, DigitClass.Hex).badSep) {
          bad = true
        }
      }
      if (peekAt(lx, 0) == 'p' || peekAt(lx, 0) == 'P') {
        if (scanExponent(lx).bad) {
          bad = true
        }
      } else {
        bad = true
      }
    }
  } else if (c0 == '0' && (peekAt(lx, 1) == 'o' || peekAt(lx, 1) == 'O')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Oct)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
  } else if (c0 == '0' && (peekAt(lx, 1) == 'b' || peekAt(lx, 1) == 'B')) {
    lx.i = lx.i + 2
    let r = digitRun(lx, DigitClass.Bin)
    if (r.count == 0 || r.badSep) {
      bad = true
    }
  } else {
    if (c0 == '.') {
      isFloat = true
      lx.i = lx.i + 1
      let f = digitRun(lx, DigitClass.Dec)
      if (f.count == 0 || f.badSep) {
        bad = true
      }
    } else {
      let leadZero = c0 == '0'
      let r = digitRun(lx, DigitClass.Dec)
      if (r.badSep) {
        bad = true
      }
      // Leading 0 then more decimal digits is C-octal, forbidden (§5.4).
      if (leadZero && r.count > 1) {
        bad = true
      }
      if (peekAt(lx, 0) == '.') {
        isFloat = true
        lx.i = lx.i + 1
        if (digitRun(lx, DigitClass.Dec).badSep) {
          bad = true
        }
      }
    }
    if (peekAt(lx, 0) == 'e' || peekAt(lx, 0) == 'E') {
      isFloat = true
      if (scanExponent(lx).bad) {
        bad = true
      }
    }
  }

  // A valid numeric literal never abuts an identifier character.
  if (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
    bad = true
    while (lx.i < len(lx.src) && isIdentCont(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }

  if (bad) {
    return Token{ kind: Kind.Invalid, start: start, end: lx.i }
  }
  if (isFloat) {
    return Token{ kind: Kind.FloatLit, start: start, end: lx.i }
  }
  return Token{ kind: Kind.IntLit, start: start, end: lx.i }
}

// Consumes one escape sequence starting at `\` (§5.6), advancing exactly as the
// seed does so spans stay correct. Escape *validation* (bad-escape diagnostics)
// is deferred with the renderer; here we only consume.
function scanEscape(lx: Lexer) {
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src)) {
    return
  }
  let c = lx.src[lx.i]
  if (c == 'x') {
    lx.i = lx.i + 1
    let k = 0
    while (k < 2 && lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
      lx.i = lx.i + 1
      k = k + 1
    }
  } else if (c == 'u') {
    lx.i = lx.i + 1
    if (lx.i < len(lx.src) && lx.src[lx.i] == '{') {
      lx.i = lx.i + 1
      while (lx.i < len(lx.src) && classOf(lx.src[lx.i], DigitClass.Hex)) {
        lx.i = lx.i + 1
      }
      if (lx.i < len(lx.src) && lx.src[lx.i] == '}') {
        lx.i = lx.i + 1
      }
    }
  } else {
    lx.i = lx.i + 1
  }
}

// Interpolation nesting cap (Power of 10): deeper nesting degrades to a literal
// `$`, matching the seed's max_interp.
const maxInterp: int = 32

// One literal segment of an interpreted string (§5.7). `isHead` marks the
// opening `"`. A string with no `${` yields a single StringLit; otherwise a
// StrPart is emitted and an InterpStart is stashed as `pending`, and after the
// interpolation's `}` (see scanRBrace) the next segment resumes here with
// `isHead = false`. Escapes are consumed so `\"` doesn't close; a newline ends
// an unterminated string with the seed's recovery span.
function scanStringSegment(lx: Lexer, isHead: bool): Token {
  let open = lx.i
  if (isHead) {
    lx.i = lx.i + 1
  }
  let content = lx.i
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == '"') {
      let end = lx.i
      lx.i = lx.i + 1
      if (isHead) {
        return Token{ kind: Kind.StringLit, start: open, end: lx.i }
      }
      return Token{ kind: Kind.StrPart, start: content, end: end }
    }
    if (c == '\n') {
      if (isHead) {
        return Token{ kind: Kind.StringLit, start: open, end: lx.i }
      }
      return Token{ kind: Kind.StrPart, start: content, end: lx.i }
    }
    if (c == '\\') {
      scanEscape(lx)
    } else if (c == '$' && peekAt(lx, 1) == '{' && len(lx.interp) < maxInterp) {
      let dollar = lx.i
      let end = lx.i
      lx.i = lx.i + 2
      lx.interp = append(lx.interp, 0)
      lx.pending = Token{ kind: Kind.InterpStart, start: dollar, end: lx.i }
      lx.hasPending = true
      return Token{ kind: Kind.StrPart, start: content, end: end }
    } else {
      lx.i = lx.i + 1
    }
  }
  if (isHead) {
    return Token{ kind: Kind.StringLit, start: open, end: lx.i }
  }
  return Token{ kind: Kind.StrPart, start: content, end: lx.i }
}

// A `}`: closes the innermost interpolation (→ InterpEnd, and the next token
// resumes the string body) when that interpolation is at brace depth 0;
// otherwise it is a plain RBrace that pops one nesting level.
function scanRBrace(lx: Lexer): Token {
  let start = lx.i
  let n = len(lx.interp)
  if (n > 0) {
    if (lx.interp[n - 1] == 0) {
      lx.i = lx.i + 1
      lx.interp = lx.interp[0:n - 1]
      lx.resumeString = true
      return Token{ kind: Kind.InterpEnd, start: start, end: lx.i }
    }
    lx.interp[n - 1] = lx.interp[n - 1] - 1
  }
  lx.i = lx.i + 1
  return Token{ kind: Kind.RBrace, start: start, end: lx.i }
}

// A raw string `` `...` `` → RawStringLit; no escapes, closes at the next
// backtick (or EOF, unterminated — same recovery span as the seed).
function scanRawString(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  while (lx.i < len(lx.src) && lx.src[lx.i] != '`') {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src)) {
    lx.i = lx.i + 1
  }
  return Token{ kind: Kind.RawStringLit, start: start, end: lx.i }
}

// A malformed rune: consume to the closing quote / line end, yield Invalid.
function badRune(lx: Lexer, start: int): Token {
  while (lx.i < len(lx.src) && lx.src[lx.i] != '\'' && lx.src[lx.i] != '\n') {
    lx.i = lx.i + 1
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
  }
  return Token{ kind: Kind.Invalid, start: start, end: lx.i }
}

// A rune `'c'` → RuneLit: one escape or one UTF-8 code point, then a closing
// quote. Anything else recovers via badRune.
function scanRune(lx: Lexer): Token {
  let start = lx.i
  lx.i = lx.i + 1
  if (lx.i >= len(lx.src) || lx.src[lx.i] == '\n' || lx.src[lx.i] == '\'') {
    return badRune(lx, start)
  }
  if (lx.src[lx.i] == '\\') {
    scanEscape(lx)
  } else {
    lx.i = lx.i + 1
    while (lx.i < len(lx.src) && isUtf8Cont(lx.src[lx.i])) {
      lx.i = lx.i + 1
    }
  }
  if (lx.i < len(lx.src) && lx.src[lx.i] == '\'') {
    lx.i = lx.i + 1
    return Token{ kind: Kind.RuneLit, start: start, end: lx.i }
  }
  return badRune(lx, start)
}

// The operator/delimiter dispatch, mirroring the seed's maximal munch.
function scanToken(lx: Lexer): Token {
  let start = lx.i
  let c = lx.src[start]

  if (isIdentStart(c)) { return scanIdent(lx) }
  if (isDigit(c)) { return scanNumber(lx) }
  if (c == '.' && isDigit(peekAt(lx, 1))) { return scanNumber(lx) }
  if (c == '"') { return scanStringSegment(lx, true) }
  if (c == '`') { return scanRawString(lx) }
  if (c == '\'') { return scanRune(lx) }

  if (c == '+') {
    if (peekAt(lx, 1) == '+') { return emit(lx, start, 2, Kind.PlusPlus) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PlusEq) }
    return emit(lx, start, 1, Kind.Plus)
  }
  if (c == '-') {
    if (peekAt(lx, 1) == '-') { return emit(lx, start, 2, Kind.MinusMinus) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.MinusEq) }
    return emit(lx, start, 1, Kind.Minus)
  }
  if (c == '*') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.StarEq) }
    return emit(lx, start, 1, Kind.Star)
  }
  if (c == '/') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.SlashEq) }
    return emit(lx, start, 1, Kind.Slash)
  }
  if (c == '%') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PercentEq) }
    return emit(lx, start, 1, Kind.Percent)
  }
  if (c == '&') {
    if (peekAt(lx, 1) == '&') { return emit(lx, start, 2, Kind.AmpAmp) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.AmpEq) }
    return emit(lx, start, 1, Kind.Amp)
  }
  if (c == '|') {
    if (peekAt(lx, 1) == '|') { return emit(lx, start, 2, Kind.PipePipe) }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.PipeEq) }
    return emit(lx, start, 1, Kind.Pipe)
  }
  if (c == '^') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.CaretEq) }
    return emit(lx, start, 1, Kind.Caret)
  }
  if (c == '~') { return emit(lx, start, 1, Kind.Tilde) }
  if (c == '!') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.BangEq) }
    return emit(lx, start, 1, Kind.Bang)
  }
  if (c == '=') {
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.EqEq) }
    if (peekAt(lx, 1) == '>') { return emit(lx, start, 2, Kind.FatArrow) }
    return emit(lx, start, 1, Kind.Eq)
  }
  if (c == '<') {
    if (peekAt(lx, 1) == '<') {
      if (peekAt(lx, 2) == '=') { return emit(lx, start, 3, Kind.ShlEq) }
      return emit(lx, start, 2, Kind.Shl)
    }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.LtEq) }
    if (peekAt(lx, 1) == '-') { return emit(lx, start, 2, Kind.ArrowLeft) }
    return emit(lx, start, 1, Kind.Lt)
  }
  if (c == '>') {
    if (peekAt(lx, 1) == '>') {
      if (peekAt(lx, 2) == '=') { return emit(lx, start, 3, Kind.ShrEq) }
      return emit(lx, start, 2, Kind.Shr)
    }
    if (peekAt(lx, 1) == '=') { return emit(lx, start, 2, Kind.GtEq) }
    return emit(lx, start, 1, Kind.Gt)
  }
  if (c == '(') { return emit(lx, start, 1, Kind.LParen) }
  if (c == ')') { return emit(lx, start, 1, Kind.RParen) }
  if (c == '[') { return emit(lx, start, 1, Kind.LBracket) }
  if (c == ']') { return emit(lx, start, 1, Kind.RBracket) }
  if (c == '{') {
    // Track brace nesting inside the innermost interpolation so a `}` that
    // belongs to a block (not the interpolation) is a plain RBrace.
    let n = len(lx.interp)
    if (n > 0) {
      lx.interp[n - 1] = lx.interp[n - 1] + 1
    }
    return emit(lx, start, 1, Kind.LBrace)
  }
  if (c == '}') { return scanRBrace(lx) }
  if (c == ',') { return emit(lx, start, 1, Kind.Comma) }
  if (c == ';') { return emit(lx, start, 1, Kind.Semicolon) }
  if (c == ':') { return emit(lx, start, 1, Kind.Colon) }
  if (c == '.') {
    if (peekAt(lx, 1) == '.' && peekAt(lx, 2) == '.') { return emit(lx, start, 3, Kind.Ellipsis) }
    return emit(lx, start, 1, Kind.Dot)
  }
  if (c == '?') { return emit(lx, start, 1, Kind.Question) }

  // Any byte that starts no token is invalid: report it (E0001) and consume one
  // byte so the scan always advances. A printable byte is named as a character,
  // anything else as a hex byte (matching the seed).
  let bad = lx.src[start]
  let tok = emit(lx, start, 1, Kind.Invalid)
  let msg = "unexpected byte 0x" + hex2(bad)
  if (bad >= 32 && bad < 127) {
    msg = "unexpected character '" + lx.src[start:start + 1] + "'"
  }
  lexReport(lx, 1, tok.start, tok.end, msg, "remove this character")
  return tok
}

function semiToken(lx: Lexer, at: int): Token {
  return Token{ kind: Kind.Semicolon, start: at, end: at }
}

function skipLineComment(lx: Lexer) {
  lx.i = lx.i + 2
  while (lx.i < len(lx.src) && lx.src[lx.i] != '\n') {
    lx.i = lx.i + 1
  }
}

// Consumes a non-nesting block comment; returns whether it held a newline (which
// counts as a newline for the semicolon rule).
function skipBlockComment(lx: Lexer): bool {
  lx.i = lx.i + 2
  let hadNl = false
  while (lx.i + 1 < len(lx.src)) {
    if (lx.src[lx.i] == '*' && lx.src[lx.i + 1] == '/') {
      lx.i = lx.i + 2
      return hadNl
    }
    if (lx.src[lx.i] == '\n') {
      hadNl = true
    }
    lx.i = lx.i + 1
  }
  // Unterminated: consume the tail (the seed also reports; diagnostics later).
  while (lx.i < len(lx.src)) {
    if (lx.src[lx.i] == '\n') {
      hadNl = true
    }
    lx.i = lx.i + 1
  }
  return hadNl
}

function atEof(lx: Lexer): Token {
  if (isTerminator(lx.last)) {
    return semiToken(lx, lx.i)
  }
  return Token{ kind: Kind.Eof, start: lx.i, end: lx.i }
}

function skipTriviaThenToken(lx: Lexer): Token {
  while (lx.i < len(lx.src)) {
    let c = lx.src[lx.i]
    if (c == ' ' || c == '\t' || c == '\r') {
      lx.i = lx.i + 1
    } else if (c == '\n') {
      lx.i = lx.i + 1
      if (isTerminator(lx.last)) {
        return semiToken(lx, lx.i - 1)
      }
    } else if (c == '/' && peekAt(lx, 1) == '/') {
      skipLineComment(lx)
    } else if (c == '/' && peekAt(lx, 1) == '*') {
      let hadNl = skipBlockComment(lx)
      if (hadNl && isTerminator(lx.last)) {
        return semiToken(lx, lx.i - 1)
      }
    } else {
      return scanToken(lx)
    }
  }
  return atEof(lx)
}

// Dispatches the queued `InterpStart`, a resumed string body, or a fresh scan.
function produce(lx: Lexer): Token {
  if (lx.hasPending) {
    lx.hasPending = false
    return lx.pending
  }
  if (lx.resumeString) {
    lx.resumeString = false
    return scanStringSegment(lx, false)
  }
  return skipTriviaThenToken(lx)
}

// The next token; `Eof` at end. Advances the lexer and records `last` for ASI.
function nextToken(lx: Lexer): Token {
  let t = produce(lx)
  lx.last = t.kind
  return t
}

// The seed's `@tagName` for a Kind — the exact string `--dump-tokens` prints, so
// `bitc2 --dump-tokens` is byte-identical to `bitc --dump-tokens`.
function kindName(k: Kind): string {
  if (k == Kind.Eof) { return "eof" }
  if (k == Kind.Invalid) { return "invalid" }
  if (k == Kind.Ident) { return "ident" }
  if (k == Kind.IntLit) { return "int_lit" }
  if (k == Kind.FloatLit) { return "float_lit" }
  if (k == Kind.StringLit) { return "string_lit" }
  if (k == Kind.RawStringLit) { return "raw_string_lit" }
  if (k == Kind.RuneLit) { return "rune_lit" }
  if (k == Kind.BoolLit) { return "bool_lit" }
  if (k == Kind.NilLit) { return "nil_lit" }
  if (k == Kind.StrPart) { return "str_part" }
  if (k == Kind.InterpStart) { return "interp_start" }
  if (k == Kind.InterpEnd) { return "interp_end" }
  if (k == Kind.KwAs) { return "kw_as" }
  if (k == Kind.KwBreak) { return "kw_break" }
  if (k == Kind.KwCase) { return "kw_case" }
  if (k == Kind.KwCatch) { return "kw_catch" }
  if (k == Kind.KwChan) { return "kw_chan" }
  if (k == Kind.KwConst) { return "kw_const" }
  if (k == Kind.KwContinue) { return "kw_continue" }
  if (k == Kind.KwDefault) { return "kw_default" }
  if (k == Kind.KwDefer) { return "kw_defer" }
  if (k == Kind.KwElse) { return "kw_else" }
  if (k == Kind.KwEnum) { return "kw_enum" }
  if (k == Kind.KwExport) { return "kw_export" }
  if (k == Kind.KwFail) { return "kw_fail" }
  if (k == Kind.KwFor) { return "kw_for" }
  if (k == Kind.KwFrom) { return "kw_from" }
  if (k == Kind.KwFunction) { return "kw_function" }
  if (k == Kind.KwIf) { return "kw_if" }
  if (k == Kind.KwImport) { return "kw_import" }
  if (k == Kind.KwIn) { return "kw_in" }
  if (k == Kind.KwInterface) { return "kw_interface" }
  if (k == Kind.KwLet) { return "kw_let" }
  if (k == Kind.KwMap) { return "kw_map" }
  if (k == Kind.KwMatch) { return "kw_match" }
  if (k == Kind.KwOf) { return "kw_of" }
  if (k == Kind.KwReturn) { return "kw_return" }
  if (k == Kind.KwSelect) { return "kw_select" }
  if (k == Kind.KwSpawn) { return "kw_spawn" }
  if (k == Kind.KwStruct) { return "kw_struct" }
  if (k == Kind.KwSwitch) { return "kw_switch" }
  if (k == Kind.KwType) { return "kw_type" }
  if (k == Kind.KwWhile) { return "kw_while" }
  if (k == Kind.Plus) { return "plus" }
  if (k == Kind.Minus) { return "minus" }
  if (k == Kind.Star) { return "star" }
  if (k == Kind.Slash) { return "slash" }
  if (k == Kind.Percent) { return "percent" }
  if (k == Kind.Amp) { return "amp" }
  if (k == Kind.Pipe) { return "pipe" }
  if (k == Kind.Caret) { return "caret" }
  if (k == Kind.Shl) { return "shl" }
  if (k == Kind.Shr) { return "shr" }
  if (k == Kind.Tilde) { return "tilde" }
  if (k == Kind.AmpAmp) { return "amp_amp" }
  if (k == Kind.PipePipe) { return "pipe_pipe" }
  if (k == Kind.Bang) { return "bang" }
  if (k == Kind.EqEq) { return "eq_eq" }
  if (k == Kind.BangEq) { return "bang_eq" }
  if (k == Kind.Lt) { return "lt" }
  if (k == Kind.LtEq) { return "lt_eq" }
  if (k == Kind.Gt) { return "gt" }
  if (k == Kind.GtEq) { return "gt_eq" }
  if (k == Kind.Eq) { return "eq" }
  if (k == Kind.PlusEq) { return "plus_eq" }
  if (k == Kind.MinusEq) { return "minus_eq" }
  if (k == Kind.StarEq) { return "star_eq" }
  if (k == Kind.SlashEq) { return "slash_eq" }
  if (k == Kind.PercentEq) { return "percent_eq" }
  if (k == Kind.AmpEq) { return "amp_eq" }
  if (k == Kind.PipeEq) { return "pipe_eq" }
  if (k == Kind.CaretEq) { return "caret_eq" }
  if (k == Kind.ShlEq) { return "shl_eq" }
  if (k == Kind.ShrEq) { return "shr_eq" }
  if (k == Kind.PlusPlus) { return "plus_plus" }
  if (k == Kind.MinusMinus) { return "minus_minus" }
  if (k == Kind.LParen) { return "l_paren" }
  if (k == Kind.RParen) { return "r_paren" }
  if (k == Kind.LBracket) { return "l_bracket" }
  if (k == Kind.RBracket) { return "r_bracket" }
  if (k == Kind.LBrace) { return "l_brace" }
  if (k == Kind.RBrace) { return "r_brace" }
  if (k == Kind.Comma) { return "comma" }
  if (k == Kind.Semicolon) { return "semicolon" }
  if (k == Kind.Colon) { return "colon" }
  if (k == Kind.Dot) { return "dot" }
  if (k == Kind.Ellipsis) { return "ellipsis" }
  if (k == Kind.FatArrow) { return "fat_arrow" }
  if (k == Kind.Question) { return "question" }
  return "arrow_left"
}

// The token loop over a prepared lexer. Bounded by twice the byte length (a
// semicolon can be synthesized per line) plus the terminal eof.
function lexDrive(lx: Lexer): []Token {
  let toks = []Token(0)
  let guard = 0
  let bound = len(lx.src) * 2 + 2
  while (guard <= bound) {
    let t = nextToken(lx)
    toks = append(toks, t)
    if (t.kind == Kind.Eof) {
      break
    }
    guard = guard + 1
  }
  return toks
}

// All tokens including the final `Eof`, discarding any lexer diagnostics.
function lexAll(src: string): []Token {
  return lexDrive(newLexer(src))
}

// All tokens, reporting lexer diagnostics into `diags` (spans stamped `file`).
function lexAllD(src: string, file: int, diags: Diagnostics): []Token {
  return lexDrive(newLexerD(src, file, diags))
}
