// selfhost/pmcli.bit — `bit add` (#1734) and `bit up`/`bit update` (#1735,
// epic #1480). Wires together the pieces landed by the sibling package-manager
// tasks into two end-to-end commands:
//   - selfhost/pmfetch.bit (#1733): parses `gitHost/owner/repo@ref`, resolves
//     `ref` to a commit sha, fetches it into the content-addressed cache.
//   - selfhost/pmresolve.bit (#1731): Minimal Version Selection, used here to
//     confirm the version being added doesn't undercut something an existing
//     locked dependency already transitively requires.
//   - selfhost/pmlock.bit (#1732): reads/writes bit.lock.
//   - stdlib/json's CST edit layer (#1725/#1726, epic #1479): the ONLY way
//     bit.json is ever rewritten — cstParse -> cstSetStringPath -> cstPrint,
//     never a plain parse-modify-reserialize, so a user's comments and
//     formatting survive except the one entry actually changed.
// `bit up [name]` (alias `update`) re-resolves every dependency `bit.json`
// names (or, with an argument, just that one) against its CURRENT ref —
// picking up a moved branch/tag's new HEAD — and rewrites bit.lock with the
// refreshed commit and transitive requirements. `bit.json` itself is never
// touched: the ref an entry names only changes if the user edits it by hand.
// No code from a fetched dependency is ever executed: pmfetch.bit already
// refuses to run anything from a fetched checkout (no build/postinstall
// scripts), and nothing below adds a new execution path.
import { CstNode, cstParse, cstPrint, cstSetStringPath, Json, jsoncParse, jsonGet as jsonGetC, jsonAsString } from "std/json"

const pmCliDefaultTimeoutMs: int = 30000

// One dependency this run added or updated — enough to print a confirmation
// and to hand to both the bit.json rewrite and the bit.lock upsert.
struct AddResult { name: string, specRef: string, url: string, commit: string }

// ---- CLI entry --------------------------------------------------------

// `bit add <gitHost/owner/repo>[@ref] [--dir <path>]`. Returns the process
// exit code: 2 on a usage error, 1 on a fetch/resolve/write failure, 0 on
// success.
function addCmd(a: []string): int {
  if (len(a) < 3) {
    eprint("usage: bit add <gitHost/owner/repo>[@ref] [--dir <path>]\n")
    return 2
  }
  let specArg = a[2]
  let projectDir = "."
  let ai = 3
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else {
      eprint("bit add: unexpected argument '${a[ai]}'\n")
      return 2
    }
  }

  let hadRef = lastIndexByte(specArg, '@') >= 0
  let d = parseAddSpec(specArg) catch e {
    eprint("bit add: ${e.message()}\n")
    return 2
  }
  let url = "https://" + d.host + "/" + d.owner + "/" + d.repo + ".git"
  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  let result = addDependency(
    projectDir, cacheRoot, defaultGitBin,
    d.host, d.owner, d.repo, d.ref, hadRef, url,
    pmCliDefaultTimeoutMs,
  ) catch e {
    eprint("bit add: ${e.message()}\n")
    return 1
  }

  print("bit add: ${result.name} -> ${result.specRef} (${result.commit})\n")
  return 0
}

// `bit up [name] [--dir <path>]` / `bit update [name] [--dir <path>]` —
// `update` is an exact alias, both routed here by main.bit's dispatch. With
// no `name`, refreshes every dependency `bit.json` names; with one, restricts
// the refresh to that dependency alone. Returns the process exit code: 2 on a
// usage error, 1 on a fetch/resolve/write failure, 0 on success.
function upCmd(a: []string): int {
  let name = ""
  let projectDir = "."
  let ai = 2
  if (ai < len(a) && a[ai] != "--dir") {
    name = a[ai]
    ai = ai + 1
  }
  while (ai < len(a)) {
    if (a[ai] == "--dir" && ai + 1 < len(a)) {
      projectDir = a[ai + 1]
      ai = ai + 2
    } else {
      eprint("bit up: unexpected argument '${a[ai]}'\n")
      return 2
    }
  }

  let cacheRoot = defaultCacheRoot() catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let results = upDependencies(projectDir, cacheRoot, defaultGitBin, name, pmCliDefaultTimeoutMs) catch e {
    eprint("bit up: ${e.message()}\n")
    return 1
  }

  let i = 0
  while (i < len(results)) {
    print("bit up: ${results[i].name} -> ${results[i].ref} (${results[i].commit})\n")
    i = i + 1
  }
  return 0
}

// `gitHost/owner/repo[@ref]` — like pmfetch.bit's own `parseSpec`, but `ref`
// is OPTIONAL here (ticket #1734, step 1: default to the remote's default
// branch HEAD). `resolveDependencyRef` already knows how to resolve the
// pseudo-ref `"HEAD"` (`git ls-remote <url> HEAD`), so this is a thin wrapper
// around `parseSpec`, not a fork of its validation.
function parseAddSpec(spec: string): DepSpec! {
  if (lastIndexByte(spec, '@') >= 0) {
    return parseSpec(spec)?
  }
  return parseSpec(spec + "@HEAD")?
}

// ---- the add flow, independent of argv/exit codes ---------------------

// Steps (ticket #1734):
//  1. resolve `ref` to a commit sha (pmfetch.resolveDependencyRef). When
//     `refIsExplicit` is false (no `@ref` in the user's spec), the resolved
//     sha itself becomes the ref recorded in bit.json — spec §17.7 names
//     exactly three legal ref forms (tag / branch / bare sha), and a bare
//     sha is the only one of those that is already exactly what was
//     resolved, so this never invents a fourth "HEAD" spelling.
//  2. fetch that sha into the content-addressed cache (pmfetch.fetchSha).
//  3. read the fetched dependency's own bit.json requirements (if any) and
//     confirm this add doesn't undercut a version some existing locked
//     dependency already transitively requires (pmresolve.resolveMVS) — non-
//     version refs (a branch or bare sha) are not ordered versions and are
//     not run through it, matching spec §17.7 point 2.
//  4. rewrite bit.json's `dependencies.<name>` entry through the CST edit
//     layer, preserving every other byte.
//  5. regenerate bit.lock (pmlock.writeLock) with the resolved commit and the
//     fetched dependency's own transitive requirements.
//
// `url` is a plain parameter, not derived here — the same layering
// pmfetch.bit itself uses (its `DepSpec` never carries a url either) — so
// this is directly testable against a `file://` fixture (pmclicheck.bit)
// without needing a real `https://` remote. `addCmd` above always derives it
// as `https://<host>/<owner>/<repo>.git`, per SPEC §17.7's git-only registry
// model.
export function addDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  host: string, owner: string, repo: string, ref: string, refIsExplicit: bool,
  url: string, timeoutMs: int,
): AddResult! {
  let name = repo
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let entry = resolveDependency(cacheRoot, gitBin, name, host, owner, repo, ref, url, entries, timeoutMs)?

  let finalRef = ref
  if (!refIsExplicit) {
    finalRef = entry.commit
  }

  // bit.lock first, bit.json second: bit.lock is fully machine-owned and
  // regenerated on every add/up/remove (pmlock.bit's own contract), so a
  // failure right after this write is self-healing — the next run recomputes
  // it from whatever bit.json says. The reverse order would risk bit.json
  // claiming a dependency bit.lock never recorded, a silent mismatch with no
  // rollback.
  let updated = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires)
  writeLock(lockPath, updated)?

  let specRef = "${host}/${owner}/${repo}@${finalRef}"
  rewriteManifest(projectDir, name, specRef)?

  return AddResult{ name: name, specRef: specRef, url: url, commit: entry.commit }
}

// The fetch/resolve/MVS-check sequence `bit add` and `bit up` both need,
// kept in exactly one place (ticket #1735's hard constraint: never fork
// #1734's plumbing): re-resolve `ref` against `url` to a commit, fetch it into
// the cache, read its own transitive requirements, and re-run MVS
// (`checkVersionConflict`) against `existing`'s already-locked transitive
// requirements. Returns the fresh `LockEntry` without writing bit.lock —
// the caller (an add of one new dependency, or an up refreshing one already
// in bit.lock) decides how and when that gets written.
function resolveDependency(
  cacheRoot: string, gitBin: string,
  name: string, host: string, owner: string, repo: string, ref: string, url: string,
  existing: []LockEntry, timeoutMs: int,
): LockEntry! {
  let sha = resolveDependencyRef(gitBin, url, ref, timeoutMs)?
  let fetched = fetchSha(gitBin, cacheRoot, host, owner, repo, url, sha, timeoutMs)?
  let depManifest = readManifest(fetched.dir)?
  let depRequires = manifestRequires(depManifest)
  checkVersionConflict(existing, name, ref, depRequires)?
  return LockEntry{ name: name, url: url, commit: sha, requires: depRequires }
}

// ---- reading a fetched dependency's own requirements -------------------

// The `dependencies` object of a fetched dependency's `bit.json`
// (`d`, from pmfetch.bit's `readManifest`), as `[]LockRequire` — an absent
// manifest or an absent/malformed `dependencies` key is not an error, just
// no transitive requirements (`readManifest` already returns a well-formed,
// empty `JsonDoc` for a dependency with no manifest at all).
function manifestRequires(d: JsonDoc): []LockRequire {
  let out = []LockRequire(0)
  if (!jsonHas(d, d.root)) {
    return out
  }
  let depsId = jsonGet(d, d.root, "dependencies")
  if (depsId < 0 || jsonKindOf(d, depsId) != JsonKind.Obj) {
    return out
  }
  let n = jsonLen(d, depsId)
  let i = 0
  while (i < n) {
    let key = jsonKeyAt(d, depsId, i)
    out = append(out, LockRequire{ name: key, ref: jsonStrOf(d, jsonGet(d, depsId, key)) })
    i = i + 1
  }
  return out
}

// ---- Minimal Version Selection over just this one add ------------------

// An exact `vMAJOR.MINOR.PATCH` tag, or `(_, false)` for anything else (a
// branch name or a bare commit sha — spec §17.7 point 2: not an MVS-ordered
// version).
function parseVersionTag(ref: string): (Version, bool) {
  let zero = Version{ major: 0, minor: 0, patch: 0 }
  if (len(ref) < 2 || ref[0] != 'v') {
    return zero, false
  }
  let (major, i1, ok1) = pmScanUint(ref, 1)
  if (!ok1 || i1 >= len(ref) || ref[i1] != '.') {
    return zero, false
  }
  let (minor, i2, ok2) = pmScanUint(ref, i1 + 1)
  if (!ok2 || i2 >= len(ref) || ref[i2] != '.') {
    return zero, false
  }
  let (patch, i3, ok3) = pmScanUint(ref, i2 + 1)
  if (!ok3 || i3 != len(ref)) {
    return zero, false
  }
  return Version{ major: major, minor: minor, patch: patch }, true
}

// The decimal integer starting at `s[start]`, the index just past its last
// digit, and whether at least one digit was read.
function pmScanUint(s: string, start: int): (int, int, bool) {
  let i = start
  let n = 0
  let any = false
  while (i < len(s) && s[i] >= '0' && s[i] <= '9') {
    n = n * 10 + (int(s[i]) - int('0'))
    i = i + 1
    any = true
  }
  return n, i, any
}

// `[]LockRequire` (raw ref strings) narrowed to the version-shaped subset, as
// `pmresolve.bit`'s `Requirement`.
function pmToRequirements(rs: []LockRequire): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(rs)) {
    let (v, ok) = parseVersionTag(rs[i].ref)
    if (ok) {
      out = append(out, Requirement{ name: rs[i].name, min: v })
    }
    i = i + 1
  }
  return out
}

// Every version-shaped requirement any ALREADY-locked dependency's own
// transitive `requires` states for `name` — the other half of "the current
// project's requirements" ticket #1734 step 3 asks to feed the resolver,
// alongside the dependency being added itself.
function pmExistingRequirementsFor(entries: []LockEntry, name: string): []Requirement {
  let out = []Requirement(0)
  let i = 0
  while (i < len(entries)) {
    let j = 0
    while (j < len(entries[i].requires)) {
      let r = entries[i].requires[j]
      if (r.name == name) {
        let (v, ok) = parseVersionTag(r.ref)
        if (ok) {
          out = append(out, Requirement{ name: name, min: v })
        }
      }
      j = j + 1
    }
    i = i + 1
  }
  return out
}

// Fails if some already-locked dependency's own transitive requirements
// demand a HIGHER version of `name` than `ref` — MVS's rule (spec §17.7 point
// 2: the resolved version is never lower than the highest of all
// requirements). A non-version `ref` (branch/sha) has nothing for MVS to
// arbitrate and always passes. Takes the project's already-read `[]LockEntry`
// rather than a path, so `addDependency` reads bit.lock once per run instead
// of once here and once again to build the upsert list.
function checkVersionConflict(
  existing: []LockEntry,
  name: string,
  ref: string,
  depRequires: []LockRequire,
): ()! {
  let (reqVersion, isVersion) = parseVersionTag(ref)
  if (!isVersion) {
    return
  }
  let transitive = pmExistingRequirementsFor(existing, name)

  let graph = ReqGraph{
    rootRequires: append(transitive, Requirement{ name: name, min: reqVersion }),
    modules: [ModuleReqs{ name: name, version: reqVersion, requires: pmToRequirements(depRequires) }],
  }
  let resolved = resolveMVS(graph)
  let (finalVer, found) = resolved[name]
  if (found && versionLess(reqVersion, finalVer)) {
    fail newError("pmcli: ${name}@${ref} conflicts with a higher transitive requirement (v${finalVer.major}.${finalVer.minor}.${finalVer.patch} needed) — pick that version instead")
  }
}

// ---- bit.json / bit.lock writes -----------------------------------------

// Rewrites `<projectDir>/bit.json`'s `dependencies.<name>` entry to
// `specRef`, through the CST edit layer only — every other byte of the file
// (comments, formatting, every other entry) survives untouched. Fails rather
// than guessing if the project has no `bit.json` at all: `bit add` adds TO a
// project, it does not scaffold one (that is `bit init`'s job, out of scope
// here).
function rewriteManifest(projectDir: string, name: string, specRef: string): ()! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit add: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let root = cstParse(src)?
  let updated = cstSetStringPath(root, ["dependencies", name], specRef)?
  writeFile(path, cstPrint(updated))?
}

// `entries` with `name`'s entry replaced (or appended, if absent) by a fresh
// one built from this run's fetch — bit.lock is fully machine-owned, so the
// whole entry is regenerated rather than patched field-by-field.
function upsertLockEntry(
  entries: []LockEntry,
  name: string,
  url: string,
  commit: string,
  requires: []LockRequire,
): []LockEntry {
  let out = []LockEntry(0)
  let replaced = false
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      out = append(out, LockEntry{ name: name, url: url, commit: commit, requires: requires })
      replaced = true
    } else {
      out = append(out, entries[i])
    }
    i = i + 1
  }
  if (!replaced) {
    out = append(out, LockEntry{ name: name, url: url, commit: commit, requires: requires })
  }
  return out
}

// ---- the up flow, independent of argv/exit codes -----------------------

// One dependency `bit up`/`bit update` refreshed — enough to print a
// confirmation, mirroring `AddResult`.
struct UpResult { name: string, ref: string, url: string, commit: string }

// One `bit.json` `dependencies` entry, decoded.
struct DepSpecNamed { name: string, spec: DepSpec }

// Every dependency `<projectDir>/bit.json` names, decoded through
// `jsoncParse` (std/json) — unlike `readManifest` (pmfetch.bit), which reads
// a FETCHED dependency's manifest through the strict local JSON parser, this
// reads the PROJECT's OWN bit.json, which routinely carries the user's
// comments (JSONC, not plain JSON — same format the CST edit layer preserves
// for `bit add`). Each value is decoded through pmfetch.bit's own `parseSpec`
// — the identical `host/owner/repo@ref` shape `bit add` already validates —
// so a malformed entry fails the same way it would on `add`. Fails if the
// project has no `bit.json` at all: `bit up` refreshes an existing project,
// it does not scaffold one.
function projectDeps(projectDir: string): []DepSpecNamed! {
  let path = pmJoin(projectDir, "bit.json")
  if (!exists(path)) {
    fail newError("bit up: ${path} does not exist — run inside a project with a bit.json")
  }
  let src = readFile(path)?
  let doc = jsoncParse(src)?
  let depsField = jsonGetC(doc, "dependencies")
  match (depsField) {
    Some(deps) => return projectDepsOf(deps)?
    None => return []DepSpecNamed(0)
  }
}

function projectDepsOf(deps: Json): []DepSpecNamed! {
  let out = []DepSpecNamed(0)
  match (deps) {
    JsonObject(entries) => {
      for e of entries {
        let refStr = jsonAsString(e.value)
        match (refStr) {
          Some(specRef) => {
            let spec = parseSpec(specRef)?
            out = append(out, DepSpecNamed{ name: e.key, spec: spec })
          }
          None => fail newError("bit up: bit.json dependency '${e.key}' is not a string")
        }
      }
    }
    JsonNull => {}
    JsonBool(b) => {}
    JsonInt(n) => {}
    JsonFloat(f) => {}
    JsonString(s) => {}
    JsonArray(a) => {}
  }
  return out
}

// `deps` narrowed to the single entry named `name`. Fails if there is none —
// `bit up <name>` on a dependency `bit.json` doesn't name is a usage error,
// not a silent no-op.
function onlyNamed(deps: []DepSpecNamed, name: string): []DepSpecNamed! {
  let i = 0
  while (i < len(deps)) {
    if (deps[i].name == name) {
      return [deps[i]]
    }
    i = i + 1
  }
  fail newError("bit up: no such dependency '${name}' in bit.json")
}

// `name`'s already-locked `url`, or `fallbackUrl` when bit.lock has no entry
// for it yet (a dependency added to bit.json by hand, never yet `add`ed or
// `up`ed) — `bit up` reuses the URL a dependency was ORIGINALLY fetched from
// rather than re-deriving it, so a non-standard-https remote (recorded once,
// at `add` time) survives every later refresh unchanged.
function existingUrlFor(entries: []LockEntry, name: string, fallbackUrl: string): string {
  let i = 0
  while (i < len(entries)) {
    if (entries[i].name == name) {
      return entries[i].url
    }
    i = i + 1
  }
  return fallbackUrl
}

// Refreshes one dependency already named in `bit.json`: re-resolves `ref`
// against `url` (a moved branch/tag re-fetches its new HEAD; an already-
// pinned sha is unchanged, `resolveDependencyRef`'s own rule) and rewrites
// just that name's `bit.lock` entry with the refreshed commit and the
// refreshed manifest's own transitive requirements. Shares
// `resolveDependency`/`upsertLockEntry`/`writeLock` with `addDependency` —
// ticket #1735's hard constraint: reuse #1734's plumbing, never fork it.
function upDependency(
  projectDir: string, cacheRoot: string, gitBin: string,
  name: string, host: string, owner: string, repo: string, ref: string,
  url: string, timeoutMs: int,
): UpResult! {
  let lockPath = pmJoin(projectDir, "bit.lock")
  let entries = readLock(lockPath)?
  let entry = resolveDependency(cacheRoot, gitBin, name, host, owner, repo, ref, url, entries, timeoutMs)?
  let updated = upsertLockEntry(entries, name, entry.url, entry.commit, entry.requires)
  writeLock(lockPath, updated)?
  return UpResult{ name: name, ref: ref, url: entry.url, commit: entry.commit }
}

// `bit up`'s/`bit update`'s core: every dependency `bit.json` names (or, when
// `only` is non-empty, just that one) refreshed and rewritten into bit.lock.
// `bit.json` itself is never touched here — its `ref` per entry is exactly
// what was already there; only bit.lock's resolved commit and transitive
// requirements move.
export function upDependencies(
  projectDir: string, cacheRoot: string, gitBin: string, only: string, timeoutMs: int,
): []UpResult! {
  let deps = projectDeps(projectDir)?
  if (len(only) > 0) {
    deps = onlyNamed(deps, only)?
  }

  let lockPath = pmJoin(projectDir, "bit.lock")
  let locked = readLock(lockPath)?

  let out = []UpResult(0)
  let i = 0
  while (i < len(deps)) {
    let d = deps[i]
    let fallbackUrl = "https://" + d.spec.host + "/" + d.spec.owner + "/" + d.spec.repo + ".git"
    let url = existingUrlFor(locked, d.name, fallbackUrl)
    let r = upDependency(
      projectDir, cacheRoot, gitBin, d.name, d.spec.host, d.spec.owner, d.spec.repo, d.spec.ref,
      url, timeoutMs,
    )?
    out = append(out, r)
    i = i + 1
  }
  return out
}
