// Self-host Stage 3 (#1346): the x86-64 backend, instruction dispatch and driver.
// Split out of selfhost/x64.bit; same module, so nothing here is imported.

// ---------------------------------------------------------------------------
// Instruction dispatch
// ---------------------------------------------------------------------------

// The x86 condition code an integer compare sets its result from. Signed and
// unsigned are DIFFERENT codes for the same relation (l/ge vs b/ae): reading a
// signed compare with an unsigned code silently reorders negative values.
function xCcForIcmp(op: Op): int {
  if (op == Op.ICmpEq) { return ccE() }
  if (op == Op.ICmpNe) { return ccNe() }
  if (op == Op.ICmpSlt) { return ccL() }
  if (op == Op.ICmpSle) { return ccLe() }
  if (op == Op.ICmpSgt) { return ccG() }
  if (op == Op.ICmpSge) { return ccGe() }
  if (op == Op.ICmpUlt) { return ccB() }
  if (op == Op.ICmpUle) { return ccBe() }
  if (op == Op.ICmpUgt) { return ccA() }
  assert(op == Op.ICmpUge)
  return ccAe()
}

function xArithForOp(op: Op): XArith {
  if (op == Op.Sub) { return XArith.Sub }
  if (op == Op.BAnd) { return XArith.And }
  if (op == Op.BOr) { return XArith.Or }
  if (op == Op.BXor) { return XArith.Xor }
  assert(op == Op.Add)
  return XArith.Add
}

function xDivOpForOp(op: Op): XDivOp {
  if (op == Op.UDiv) { return XDivOp.UDiv }
  if (op == Op.SRem) { return XDivOp.SRem }
  if (op == Op.URem) { return XDivOp.URem }
  assert(op == Op.SDiv)
  return XDivOp.SDiv
}

function xShiftForOp(op: Op): XShift {
  if (op == Op.LShr) { return XShift.Shr }
  if (op == Op.AShr) { return XShift.Sar }
  assert(op == Op.Shl)
  return XShift.Shl
}

function xFArithForOp(op: Op): XFArith {
  if (op == Op.FSub) { return XFArith.FSub }
  if (op == Op.FMul) { return XFArith.FMul }
  if (op == Op.FDiv) { return XFArith.FDiv }
  assert(op == Op.FAdd)
  return XFArith.FAdd
}

function xFCmpForOp(op: Op): XFCmp {
  if (op == Op.FCmpNe) { return XFCmp.FNe }
  if (op == Op.FCmpLt) { return XFCmp.FLt }
  if (op == Op.FCmpLe) { return XFCmp.FLe }
  if (op == Op.FCmpGt) { return XFCmp.FGt }
  if (op == Op.FCmpGe) { return XFCmp.FGe }
  assert(op == Op.FCmpEq)
  return XFCmp.FEq
}

// The bit pattern a float constant is materialized from. An f32 constant must be
// NARROWED first and its 32-bit pattern used — feeding the f64 bits to a 4-byte
// movd loads the wrong half of the value.
function xFloatConstBits(val: f64, width: int): int {
  if (width == 4) {
    return i64(u64(float32Bits(f32(val))))
  }
  return i64(floatBits(val))
}

// A void-typed instruction has no result to bind; -1 says so.
// Inline assembly (§11.6): move each `input` value into its fixed register
// (excluded from the allocatable file for the whole function), emit the x64
// sub-block's pre-encoded bytes verbatim, then read the `result` register (if
// any) into the instruction's result vreg. `dst` is -1 for a result-less block.
function xEmitAsm(cx: XCtx, dst: int, block: int, inVals: []int) {
  let blk = cx.module.asmBlocks[block]
  let i = 0
  while (i < len(inVals)) {
    let src = xGetInt(cx, inVals[i], xScratch1())
    xMovRR(cx.buf, xRegOf(blk.inX64[i]), src)
    i = i + 1
  }
  i = 0
  while (i < len(blk.x64Bytes)) {
    xEmitByte(cx.buf, blk.x64Bytes[i])
    i = i + 1
  }
  if (dst >= 0) {
    xPutInt(cx, dst, xRegOf(blk.resultX64))
  }
}

// Raw Linux syscall (§11.8): move each argument into its kernel-ABI register,
// the number into rax, emit the two-byte `syscall` opcode, then read the
// kernel's return value out of rax. Every register involved is excluded from
// the allocatable file for the whole function (xCollectReserved), so the moves
// cannot clobber a live value and can run in plain sequence.
function xEmitSyscall(cx: XCtx, dst: int, nr: int, args: []int) {
  let regs = xSyscallArgRegs()
  let i = 0
  while (i < len(args)) {
    let src = xGetInt(cx, args[i], xScratch1())
    xMovRR(cx.buf, regs[i], src)
    i = i + 1
  }
  let nrSrc = xGetInt(cx, nr, xScratch1())
  xMovRR(cx.buf, XReg64.Rax, nrSrc)
  xEmitByte(cx.buf, 0x0F) // syscall
  xEmitByte(cx.buf, 0x05)
  xPutInt(cx, dst, XReg64.Rax)
}

// Every x64 register pinned by an `asm` block (`input`/`result`/clobber) or by
// a `syscall` in `f`, indexed by ModRM register number 0..15. The `memory`
// sentinel (254) falls outside the array and is skipped.
function xCollectReserved(module: IrModule, f: IrFunc): []bool {
  let reserved = []bool(16)
  let i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    // §11.8: the number/return register, the six kernel argument registers, and
    // rcx/r11 — which the `syscall` instruction itself overwrites with the
    // return address and saved rflags. r10/r11 are codegen scratch and never
    // allocatable anyway; marking them keeps the set self-documenting.
    if (ins.op == Op.Syscall) {
      reserved[xRegNum(XReg64.Rax)] = true
      reserved[xRegNum(XReg64.Rcx)] = true
      reserved[xRegNum(XReg64.R11)] = true
      let regs = xSyscallArgRegs()
      let k = 0
      while (k < len(regs)) {
        reserved[xRegNum(regs[k])] = true
        k = k + 1
      }
    }
    if (ins.op == Op.Asm) {
      let blk = module.asmBlocks[ins.ival]
      if (blk.hasResult && blk.resultX64 < 16) {
        reserved[blk.resultX64] = true
      }
      let j = 0
      while (j < len(blk.inX64)) {
        if (blk.inX64[j] < 16) {
          reserved[blk.inX64[j]] = true
        }
        j = j + 1
      }
      j = 0
      while (j < len(blk.clobX64)) {
        if (blk.clobX64[j] < 16) {
          reserved[blk.clobX64[j]] = true
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return reserved
}

function xDstOrNone(cx: XCtx, i: int, ty: int): int {
  if (ty == cx.ctx.voidId) {
    return -1
  }
  return i
}

// Emits one instruction. Returns false when the construct is unsupported (a
// multi-value ret), which fails the whole compile rather than emitting something
// that computes the wrong thing.
function xEmitInst(cx: XCtx, i: int): bool {
  let ins = cx.f.instrs[i]
  let op = ins.op
  let ty = ins.ty
  // The RESULT width — it drives narrow re-canonicalization. A compare's own
  // result is a bool, so the float path re-reads its OPERAND width below.
  let iw = widthOf(cx.ctx, ty)

  if (op == Op.ConstInt) { xEmitConstInt(cx, i, ins.ival); return true }
  if (op == Op.ConstBool) { xEmitConstBool(cx, i, ins.bval); return true }
  if (op == Op.ConstNil) { xEmitConstNil(cx, i); return true }
  if (op == Op.ConstFloat) { xEmitConstFloat(cx, i, xFloatConstBits(ins.fval, iw.bytes), iw.bytes); return true }
  if (op == Op.ConstString) { xEmitConstString(cx, i, ins.ival); return true }
  if (op == Op.Add || op == Op.Sub || op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    xEmitBinaryInt(cx, xArithForOp(op), i, ins.lhs, ins.rhs, iw)
    return true
  }
  if (op == Op.Mul) { xEmitMulInt(cx, i, ins.lhs, ins.rhs, iw); return true }
  if (op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem) {
    xEmitDivInt(cx, xDivOpForOp(op), i, ins.lhs, ins.rhs)
    return true
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    xEmitShiftInt(cx, xShiftForOp(op), i, ins.lhs, ins.rhs, xConstShiftAmount(cx.f, ins.rhs), iw)
    return true
  }
  if (isIcmp(op)) { xEmitIcmp(cx, xCcForIcmp(op), i, ins.lhs, ins.rhs); return true }
  if (op == Op.FAdd || op == Op.FSub || op == Op.FMul || op == Op.FDiv) {
    xEmitBinaryFloat(cx, xFArithForOp(op), i, ins.lhs, ins.rhs, iw.bytes)
    return true
  }
  if (isFcmp(op)) {
    // A float compare's operand width comes from the OPERANDS — its own result is
    // a bool, so `iw` would say 1 and compare the wrong half of the register.
    xEmitFcmp(cx, xFCmpForOp(op), i, ins.lhs, ins.rhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.Neg || op == Op.BNot) { xEmitUnaryInt(cx, op == Op.Neg, i, ins.lhs, iw); return true }
  if (op == Op.Convert) {
    xEmitConvert(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty), iw)
    return true
  }
  if (op == Op.FNeg) {
    xEmitFneg(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.FSqrt) {
    xEmitFsqrt(cx, i, ins.lhs, widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes)
    return true
  }
  if (op == Op.Bitcast) {
    // The width always comes from the FLOAT side — the integer view of an f32
    // is 4 bytes wide whichever direction the transfer runs, and only one of
    // the two types carries a float width to read.
    let dstIsFloat = iw.class == RegClass.Float
    let bw = widthOf(cx.ctx, cx.f.instrs[ins.lhs].ty).bytes
    if (dstIsFloat) { bw = iw.bytes }
    xEmitBitcast(cx, i, ins.lhs, bw, dstIsFloat)
    return true
  }
  if (op == Op.FFloor) { xEmitFRound(cx, i, ins.lhs, XRoundMode.Floor); return true }
  if (op == Op.FCeil) { xEmitFRound(cx, i, ins.lhs, XRoundMode.Ceil); return true }
  if (op == Op.FTrunc) { xEmitFRound(cx, i, ins.lhs, XRoundMode.Trunc); return true }
  if (op == Op.FRound) { xEmitFRound(cx, i, ins.lhs, XRoundMode.Round); return true }
  if (op == Op.Jump) { xEmitJump(cx, ins.ival, ins.args); return true }
  if (op == Op.Br) { xEmitBr(cx, ins.lhs, ins.ival, ins.thenArgs, ins.ival2, ins.elseArgs); return true }
  if (op == Op.Ret) { return xEmitRet(cx, ins.args) }
  if (op == Op.Unreachable) { xUd2(cx.buf); return true }
  if (op == Op.Call) {
    xEmitCallLike(cx, ins.name, ins.args, ty != cx.ctx.voidId, i, ty)
    return true
  }
  if (op == Op.RtCall) {
    xEmitCallLike(cx, rtSymbol(ins.name), ins.args, ty != cx.ctx.voidId, i, ty)
    return true
  }
  if (op == Op.CallValue) { xEmitCallValue(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.args); return true }
  if (op == Op.CallIface) {
    xEmitCallIface(cx, xDstOrNone(cx, i, ty), ty, ins.lhs, ins.ival, ins.args)
    return true
  }
  if (op == Op.GcAlloc) { xEmitGcAlloc(cx, i, ty, ins.ival, ins.offsets); return true }
  if (op == Op.TypeInfo) { xEmitTypeInfo(cx, i, ins.ival, ins.ival2, ins.offsets); return true }
  if (op == Op.MakeClosure) { xEmitMakeClosure(cx, i, ins.name, ins.lhs, ty); return true }
  if (op == Op.FuncAddr) { xEmitFuncAddr(cx, i, ins.name); return true }
  if (op == Op.GlobalAddr) { xEmitGlobalAddr(cx, i, ins.name); return true }
  if (op == Op.Asm) {
    xEmitAsm(cx, xDstOrNone(cx, i, ty), ins.ival, ins.args)
    return true
  }
  if (op == Op.Syscall) {
    xEmitSyscall(cx, i, ins.lhs, ins.args)
    return true
  }
  if (op == Op.FieldGet) {
    xEmitFieldGet(cx, i, ins.lhs, ins.ival, iw, cx.ctx.types[ty].kind == TypeKind.Array,
      cx.ctx.types[cx.f.instrs[ins.lhs].ty].kind == TypeKind.Slice)
    return true
  }
  if (op == Op.FieldSet) {
    xEmitFieldSet(cx, ins.lhs, ins.ival, ins.rhs, widthOf(cx.ctx, cx.f.instrs[ins.rhs].ty))
    return true
  }
  if (op == Op.IndexGet) { xEmitIndexGet(cx, i, ins.lhs, ins.rhs, iw); return true }
  if (op == Op.IndexSet) {
    // index_set keeps its VALUE operand in ival — rhs is the INDEX.
    xEmitIndexSet(cx, ins.lhs, ins.rhs, ins.ival, widthOf(cx.ctx, cx.f.instrs[ins.ival].ty))
    return true
  }
  if (op == Op.SliceLen) { xEmitSliceLen(cx, i, ins.lhs); return true }
  if (op == Op.AtomicLoad) { xEmitAtomicLoad(cx, i, ins.lhs, iw); return true }
  if (op == Op.AtomicStore) {
    xEmitAtomicStore(cx, ins.lhs, ins.rhs, widthOf(cx.ctx, cx.f.instrs[ins.rhs].ty))
    return true
  }
  if (op == Op.AtomicCmpxchg) {
    xEmitAtomicCmpxchg(cx, i, ins.lhs, ins.rhs, ins.ival)
    return true
  }
  if (opIsAtomicRmw(op)) {
    xEmitAtomicRmw(cx, op, i, ins.lhs, ins.rhs, iw)
    return true
  }
  // block_param is never reached: every emission loop starts past a block's
  // params.
  assert(op != Op.BlockParam)
  return false
}

// ---------------------------------------------------------------------------
// Top-level driver
// ---------------------------------------------------------------------------

// Compiles one function to x86-64 machine code for `cc`. Runs register
// allocation itself (intervals and safepoints come from the shared
// buildIntervals), lays out the frame, then emits the prologue, every block in
// f.blocks order — which back-edge detection assumes is the original builder/RPO
// order (see isBackEdge) — and finally patches the jump targets.
//
// Returns a FuncCode with an empty name when the function contains a construct
// this backend refuses (a multi-value ret): the caller must not emit a binary.
function xCompileFunction(module: IrModule, f: IrFunc, cc: XCallConv): FuncCode {
  let ctx = module.ctx
  let flags = xScanFuncFlags(f)
  let intRegs = xBuildIntRegs(cc, flags)
  let floatRegs = xBuildFloatRegs(cc, flags.hasSafepoints)

  // Registers an `asm` block pins (`input`/`result`/clobber, §11.6) or a
  // `syscall` pins (number/argument/clobber, §11.8) leave the allocatable file
  // for the whole function — the same exclusion the needsRaxRdx/needsRcx flags
  // apply for div/shift, generalized to an arbitrary set. Neither construct
  // leaves `intRegs` exactly as `xBuildIntRegs` returned.
  let reserved = xCollectReserved(module, f)
  let allocRegs = []XReg64(0)
  let ri = 0
  while (ri < len(intRegs)) {
    if (!reserved[xRegNum(intRegs[ri])]) {
      allocRegs = append(allocRegs, intRegs[ri])
    }
    ri = ri + 1
  }
  intRegs = allocRegs

  // §10.3.1 @naked: the prologue never runs, so a callee-saved register would be
  // clobbered without ever being saved. Restrict a naked function to the volatile
  // file. If that is not enough registers, regalloc spills instead — and the frame
  // check below refuses the function loudly rather than letting it silently
  // corrupt its caller.
  if (f.isNaked) {
    let nakedInt = []XReg64(0)
    let ni = 0
    while (ni < len(intRegs)) {
      if (!xIsCalleeSavedInt(cc, intRegs[ni])) { nakedInt = append(nakedInt, intRegs[ni]) }
      ni = ni + 1
    }
    intRegs = nakedInt
    let nakedFloat = []XmmReg(0)
    let nf = 0
    while (nf < len(floatRegs)) {
      if (!xIsCalleeSavedFloat(cc, floatRegs[nf])) { nakedFloat = append(nakedFloat, floatRegs[nf]) }
      nf = nf + 1
    }
    floatRegs = nakedFloat
  }

  let built = buildIntervals(ctx, f)
  let result = allocate(TargetRegs{
    intRegs: RegFile{ count: len(intRegs), calleeSaved: xCalleeSavedIntMask(cc, intRegs) },
    floatRegs: RegFile{ count: len(floatRegs), calleeSaved: xCalleeSavedFloatMask(cc, floatRegs) },
  }, built.intervals, built.safepoints)

  let savedGpr = xBuildSavedGpr(cc, intRegs)
  let savedXmm = xBuildSavedXmm(cc, floatRegs)
  // The XMMs live inside the carved frame alongside the spill slots; the GPRs are
  // pushed, so they are NOT part of frameSize — only its alignment (an odd number
  // of pushes leaves rsp 8 off).
  let rawFrame = 8 * (result.numSpillSlots + len(savedXmm))
  let frame = XFrame{ savedGpr: savedGpr, savedXmm: savedXmm,
    numSpillSlots: result.numSpillSlots, frameSize: xAlignFrame(rawFrame, len(savedGpr)) }

  // §10.3.1 @naked safety net: a spill slot is the only *per-function* frame need
  // a naked function can develop. savedGpr/savedXmm are derived from the
  // allocatable pool, not from what this function used, so they are a constant of
  // the target (all four SysV callee-saved GPRs) and say nothing about this
  // function. Naked functions allocate out of the volatile file above, so a spill
  // here means the body outgrew what a prologue-less function can hold.
  if (f.isNaked && result.numSpillSlots != 0) {
    return FuncCode{ name: "", code: []u8(0), relocs: []Reloc(0),
      safepoints: []SafepointView(0), savedRegs: []SavedReg(0), frameSize: 0 }
  }

  let cx = newXCtx(cc)
  cx.module = module
  cx.ctx = ctx
  cx.f = f
  cx.alloc = result
  cx.intRegs = intRegs
  cx.floatRegs = floatRegs
  cx.frame = frame
  cx.blockOffsets = []int(len(f.blocks))
  cx.safepointCodeOffsets = []int(len(built.safepoints))

  // §10.3.1 @naked: no prologue — the function runs on its caller's frame.
  if (!f.isNaked) {
    xEmitPrologue(cx)
  }
  xBindIncomingArgs(cx)

  let ok = true
  let bi = 0
  while (bi < len(f.blocks)) {
    cx.curBlock = bi
    cx.blockOffsets[bi] = len(cx.buf.code)
    let b = f.blocks[bi]
    let i = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (i < end) {
      if (!xEmitInst(cx, i)) {
        ok = false
      }
      i = i + 1
    }
    bi = bi + 1
  }
  xPatchJumpFixups(cx)

  if (!ok) {
    return FuncCode{ name: "", code: []u8(0), relocs: []Reloc(0),
      safepoints: []SafepointView(0), savedRegs: []SavedReg(0), frameSize: 0 }
  }

  // Every safepoint the interval builder predicted must have been reached during
  // emission, or the stack maps below pair with the wrong return addresses.
  assert(cx.nextSafepointIdx == len(built.safepoints))

  // Pair each allocator stack map with the code offset emission recorded for it —
  // the two lists are in the same order by construction.
  let safepoints = []SafepointView(0)
  let si = 0
  while (si < len(result.stackMaps)) {
    let sm = result.stackMaps[si]
    let regs = []int(0)
    for r of sm.regs {
      regs = append(regs, xRegNum(intRegs[r]))
    }
    let slots = []int(0)
    for s of sm.slots {
      slots = append(slots, xSpillOffset(frame, s))
    }
    safepoints = append(safepoints, SafepointView{ retOffset: cx.safepointCodeOffsets[si],
      slots: slots, regs: regs })
    si = si + 1
  }

  // Register-recovery slots: the prologue does `push rbp; mov rbp,rsp; push
  // savedGpr[i]...`, so the caller's savedGpr[i] lands at rbp - 8*(i+1) —
  // frame-pointer-relative, matching SafepointView's own offsets.
  let savedRegs = []SavedReg(0)
  let gi = 0
  while (gi < len(savedGpr)) {
    savedRegs = append(savedRegs, SavedReg{ reg: xRegNum(savedGpr[gi]), fpOff: -8 * (gi + 1) })
    gi = gi + 1
  }

  return FuncCode{ name: f.name, code: cx.buf.code, relocs: cx.relocs,
    safepoints: safepoints, savedRegs: savedRegs, frameSize: frame.frameSize }
}
