// In-Bit self-checks for project path resolution and import loading. Split out
// of selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

function checkProjectPaths() {
  // Bytewise order, and a prefix sorts before its extension.
  assert(strCompare("a", "b") < 0)
  assert(strCompare("b", "a") > 0)
  assert(strCompare("ab", "ab") == 0)
  assert(strCompare("ab", "abc") < 0)
  assert(strCompare("abc", "ab") > 0)
  // High bytes compare unsigned: 0x80 is ABOVE 'z', not below it. Signed
  // comparison here would order a UTF-8 filename before an ASCII one.
  assert(strCompare("z", "\u{80}") < 0)

  // Sorting matches the seed's insertion sort, so both compilers see a module's
  // files in the same order — which fixes declaration order, hence IR order.
  let names = ["main.bit", "a.bit", "zz.bit", "Ab.bit"]
  let sorted = sortStrings(names)
  assert(sorted[0] == "Ab.bit") // uppercase sorts first: 'A' (65) < 'a' (97)
  assert(sorted[1] == "a.bit")
  assert(sorted[2] == "main.bit")
  assert(sorted[3] == "zz.bit")

  assert(isBitFile("x.bit") && isBitFile(".bit"))
  assert(!isBitFile("x.bits") && !isBitFile("bit") && !isBitFile(""))

  assert(startsWith("std/fs", "std/") && !startsWith("stdio", "std/"))
  // A prefix longer than the string must not read past its end.
  assert(!startsWith("s", "std/"))
}

function checkProjectResolve() {
  assert(pathResolve("/a/b") == "/a/b")
  assert(pathResolve("/a//b") == "/a/b")
  assert(pathResolve("/a/./b") == "/a/b")
  assert(pathResolve("/a/b/../c") == "/a/c")
  assert(pathResolve("/a/b/../../c") == "/c")
  assert(pathResolve("/a/b/") == "/a/b")
  assert(pathResolve("/") == "/")
  // ".." can never escape the root.
  assert(pathResolve("/../../a") == "/a")

  // A relative path stays relative.
  assert(pathResolve("a/b") == "a/b")
  assert(pathResolve("./a") == "a")
  assert(pathResolve(".") == ".")
  // A LEADING ".." on a relative path has nothing to pop, so it must survive —
  // collapsing "../x" to "x" would name a different directory entirely.
  assert(pathResolve("../x") == "../x")
  assert(pathResolve("../../x") == "../../x")
  // ...but a ".." after a real component still pops it.
  assert(pathResolve("a/../x") == "x")
  assert(pathResolve("../a/../x") == "../x")

  assert(pathJoinResolve("/root", "sub") == "/root/sub")
  assert(pathJoinResolve("/root/mod", "../other") == "/root/other")
  // An absolute second piece wins outright.
  assert(pathJoinResolve("/root", "/abs") == "/abs")
}

function checkProjectImports() {
  // Import paths come back in declaration order, deduped, without their quotes.
  let src = "import { a } from \"std/os\"\nimport { b } from \"./sib\"\n" +
    "import { c } from \"std/os\"\nfunction main() {}\n"
  let tree = parseSource(src)
  let paths = moduleImportPaths(tree, src)
  assert(len(paths) == 2) // the second "std/os" is a duplicate
  assert(paths[0] == "std/os")
  assert(paths[1] == "./sib")

  // An import is only recognized at the top level, and the module's own later
  // files' imports count too — which is the whole reason concatenation works.
  let two = "function a() {}\nimport { z } from \"std/fs\"\nfunction b() {}\n"
  let t2 = parseSource(two)
  let p2 = moduleImportPaths(t2, two)
  assert(len(p2) == 1 && p2[0] == "std/fs")

  // Resolution: std/* goes under the std root, ./ and ../ against the importer,
  // a bare name is not a module path.
  let lw = Loader{ mods: []SrcModule(0), resolved: map<string, int>{},
    loading: map<string, bool>{}, stdRoot: "/sr", prelude: -1 }
  assert(resolveImportDir(lw, "/p/mod", "std/fs") == "/sr/fs")
  assert(resolveImportDir(lw, "/p/mod", "./sib") == "/p/mod/sib")
  assert(resolveImportDir(lw, "/p/mod", "../other") == "/p/other")
  assert(resolveImportDir(lw, "/p/mod", "bare") == "")
  // With no stdlib, a std/* import resolves nowhere rather than to "/fs".
  let nostd = Loader{ mods: []SrcModule(0), resolved: map<string, int>{},
    loading: map<string, bool>{}, stdRoot: "", prelude: -1 }
  assert(resolveImportDir(nostd, "/p/mod", "std/fs") == "")
}

function checkProjectFileOf() {
  // Concatenation makes spans module-global; fileOf maps one back. Boundaries
  // are what break here: an offset AT a file's start belongs to that file.
  let starts = [0, 10, 25]
  let l0 = fileOf(starts, 0)
  assert(l0.fileIdx == 0 && l0.offset == 0)
  let l1 = fileOf(starts, 9)
  assert(l1.fileIdx == 0 && l1.offset == 9)
  let l2 = fileOf(starts, 10) // exactly at b.bit's first byte
  assert(l2.fileIdx == 1 && l2.offset == 0)
  let l3 = fileOf(starts, 24)
  assert(l3.fileIdx == 1 && l3.offset == 14)
  let l4 = fileOf(starts, 25)
  assert(l4.fileIdx == 2 && l4.offset == 0)
  let l5 = fileOf(starts, 100)
  assert(l5.fileIdx == 2 && l5.offset == 75)
}
