// In-Bit self-checks for project path resolution and import loading. Split out
// of selfcheck.bit (#1503); sibling .bit files are the same module, so
// `selfcheck()` still calls these directly.

function checkProjectPaths() {
  // Bytewise order, and a prefix sorts before its extension.
  assert(strCompare("a", "b") < 0)
  assert(strCompare("b", "a") > 0)
  assert(strCompare("ab", "ab") == 0)
  assert(strCompare("ab", "abc") < 0)
  assert(strCompare("abc", "ab") > 0)
  // High bytes compare unsigned: 0x80 is ABOVE 'z', not below it. Signed
  // comparison here would order a UTF-8 filename before an ASCII one.
  assert(strCompare("z", "\u{80}") < 0)

  // Sorting matches the seed's insertion sort, so both compilers see a module's
  // files in the same order — which fixes declaration order, hence IR order.
  let names = ["main.bit", "a.bit", "zz.bit", "Ab.bit"]
  let sorted = sortStrings(names)
  assert(sorted[0] == "Ab.bit") // uppercase sorts first: 'A' (65) < 'a' (97)
  assert(sorted[1] == "a.bit")
  assert(sorted[2] == "main.bit")
  assert(sorted[3] == "zz.bit")

  assert(isBitFile("x.bit") && isBitFile(".bit"))
  assert(!isBitFile("x.bits") && !isBitFile("bit") && !isBitFile(""))

  assert(startsWith("std/fs", "std/") && !startsWith("stdio", "std/"))
  // A prefix longer than the string must not read past its end.
  assert(!startsWith("s", "std/"))
}

function checkProjectResolve() {
  assert(pathResolve("/a/b") == "/a/b")
  assert(pathResolve("/a//b") == "/a/b")
  assert(pathResolve("/a/./b") == "/a/b")
  assert(pathResolve("/a/b/../c") == "/a/c")
  assert(pathResolve("/a/b/../../c") == "/c")
  assert(pathResolve("/a/b/") == "/a/b")
  assert(pathResolve("/") == "/")
  // ".." can never escape the root.
  assert(pathResolve("/../../a") == "/a")

  // A relative path stays relative.
  assert(pathResolve("a/b") == "a/b")
  assert(pathResolve("./a") == "a")
  assert(pathResolve(".") == ".")
  // A LEADING ".." on a relative path has nothing to pop, so it must survive —
  // collapsing "../x" to "x" would name a different directory entirely.
  assert(pathResolve("../x") == "../x")
  assert(pathResolve("../../x") == "../../x")
  // ...but a ".." after a real component still pops it.
  assert(pathResolve("a/../x") == "x")
  assert(pathResolve("../a/../x") == "../x")

  assert(pathJoinResolve("/root", "sub") == "/root/sub")
  assert(pathJoinResolve("/root/mod", "../other") == "/root/other")
  // An absolute second piece wins outright.
  assert(pathJoinResolve("/root", "/abs") == "/abs")
}

function checkProjectImports() {
  // Import paths come back in declaration order, deduped, without their quotes.
  let src = "import { a } from \"std/os\"\nimport { b } from \"./sib\"\n" +
    "import { c } from \"std/os\"\nfunction main() {}\n"
  let tree = parseSource(src)
  let paths = moduleImportPaths(tree, src)
  assert(len(paths) == 2) // the second "std/os" is a duplicate
  assert(paths[0] == "std/os")
  assert(paths[1] == "./sib")

  // An import is only recognized at the top level, and the module's own later
  // files' imports count too — which is the whole reason concatenation works.
  let two = "function a() {}\nimport { z } from \"std/fs\"\nfunction b() {}\n"
  let t2 = parseSource(two)
  let p2 = moduleImportPaths(t2, two)
  assert(len(p2) == 1 && p2[0] == "std/fs")

  // Resolution: std/* goes under the std root, ./ and ../ against the importer.
  let lw = Loader{ mods: []SrcModule(0), resolved: map<string, int>{},
    loading: map<string, bool>{}, stdRoot: "/sr", prelude: -1,
    pkgDirCache: map<string, string>{}, pkgDetailCache: map<string, string>{} }
  let (stdDir, stdDetail) = resolveImportDir(lw, "/p/mod", "std/fs")
  assert(stdDir == "/sr/fs" && stdDetail == "")
  let (sibDir, sibDetail) = resolveImportDir(lw, "/p/mod", "./sib")
  assert(sibDir == "/p/mod/sib" && sibDetail == "")
  let (parentDir, parentDetail) = resolveImportDir(lw, "/p/mod", "../other")
  assert(parentDir == "/p/other" && parentDetail == "")
  // A bare name is a package name (#1737): with no bit.lock entry for it, it
  // resolves nowhere and carries a detail naming `bit add` as the fix.
  let (bareDir, bareDetail) = resolveImportDir(lw, "/p/mod", "bare")
  assert(bareDir == "")
  assert(bareDetail == "not declared in bit.lock — run `bit add <gitHost/owner/repo>[@ref]` to add \"bare\" as a dependency")
  // With no stdlib, a std/* import resolves nowhere rather than to "/fs" — and,
  // unlike a package name, carries no detail: this is the pre-#1737 generic
  // "cannot find module" path, not a bit.lock lookup.
  let nostd = Loader{ mods: []SrcModule(0), resolved: map<string, int>{},
    loading: map<string, bool>{}, stdRoot: "", prelude: -1,
    pkgDirCache: map<string, string>{}, pkgDetailCache: map<string, string>{} }
  let (noStdDir, noStdDetail) = resolveImportDir(nostd, "/p/mod", "std/fs")
  assert(noStdDir == "" && noStdDetail == "")
}

// `pkgUrlHostOwnerRepo` is the inverse of pmcli.bit's `addCmd` url construction
// (`"https://" + host + "/" + owner + "/" + repo + ".git"`) — only that exact
// shape decodes; a bit.lock this file cannot parse is refused, not guessed at.
function checkProjectPkgUrlParse() {
  let (h, o, r, ok) = pkgUrlHostOwnerRepo("https://github.com/byteink/quicwire.git")
  assert(ok && h == "github.com" && o == "byteink" && r == "quicwire")

  let (_, _, _, sshOk) = pkgUrlHostOwnerRepo("git@github.com:byteink/quicwire.git")
  assert(!sshOk) // not the https form pmcli.bit ever writes

  let (_, _, _, noSuffixOk) = pkgUrlHostOwnerRepo("https://github.com/byteink/quicwire")
  assert(!noSuffixOk) // missing ".git"

  let (_, _, _, wrongCountOk) = pkgUrlHostOwnerRepo("https://github.com/quicwire.git")
  assert(!wrongCountOk) // wrong segment count
}

// A minimal, bounded substring search — this file has no stdlib import, and a
// diagnostic's rendered text embeds a scratch-dir absolute path, so an EXACT
// match (the style every other selfcheck sibling uses) is impractical here.
function pkgTestContains(s: string, sub: string): bool {
  let n = len(sub)
  if (n == 0) {
    return true
  }
  let i = 0
  while (i + n <= len(s)) {
    if (s[i:i + n] == sub) {
      return true
    }
    i = i + 1
  }
  return false
}

// End-to-end (#1737): a project whose `bit.lock` names a locked, WARM-cache
// dependency resolves its import to the cached source and type-checks clean,
// and does so without ever dialing the lock entry's `url` — proven by giving
// that entry a url pointing at a host this test never fetches, deriving the
// SAME cache directory the warm-up step populated via a real local `file://`
// fetch. `fetchSha`'s cache-hit branch (pmfetch.bit) never reads `url` at all,
// so if the loader took any path other than that local verify, this would
// either fail outright or take far longer than the elapsed-time bound below.
function checkProjectPackageImportsWarmCache() {
  let root = pmCheckScratchDir()
  mkdirAll(root) catch e { panic("projectcheck: cannot create scratch dir: " + e.message()) }

  let srcDir = root + "/pkgsrc"
  let mkInit = runGit(defaultGitBin, ["init", "--quiet", "-b", "main", srcDir], pmCheckTimeoutMs) catch e {
    panic("projectcheck: git init failed: " + e.message())
    pmDeadGitRun()
  }
  assert(!mkInit.timedOut && mkInit.exitCode == 0)
  runGit(defaultGitBin, ["-C", srcDir, "config", "user.email", "projectcheck@example.com"], pmCheckTimeoutMs) catch e {
    panic("projectcheck: git config user.email failed: " + e.message())
    pmDeadGitRun()
  }
  runGit(defaultGitBin, ["-C", srcDir, "config", "user.name", "projectcheck"], pmCheckTimeoutMs) catch e {
    panic("projectcheck: git config user.name failed: " + e.message())
    pmDeadGitRun()
  }
  writeFile(srcDir + "/greet.bit", "export function greet(): string {\n  return \"hi from pkg\"\n}\n") catch e {
    panic("projectcheck: cannot write fixture module: " + e.message())
  }
  runGit(defaultGitBin, ["-C", srcDir, "add", "greet.bit"], pmCheckTimeoutMs) catch e {
    panic("projectcheck: git add failed: " + e.message())
    pmDeadGitRun()
  }
  let commit = runGit(defaultGitBin, ["-C", srcDir, "commit", "--quiet", "-m", "pkg fixture"], pmCheckTimeoutMs) catch e {
    panic("projectcheck: git commit failed: " + e.message())
    pmDeadGitRun()
  }
  assert(!commit.timedOut && commit.exitCode == 0)
  let sha = revParseHead(defaultGitBin, srcDir, pmCheckTimeoutMs) catch e {
    panic("projectcheck: cannot read fixture HEAD: " + e.message())
    ""
  }

  let cacheRoot = root + "/cache"
  let host = "example.invalid" // never dialed; see the function comment
  let owner = "acme"
  let repo = "pkg"
  let wantDir = cacheRoot + "/" + host + "/" + owner + "/" + repo + "/" + sha

  // Warm the cache directly, fetching from the real local fixture — simulating
  // a prior successful `bit add`/build, never the entry's own `url`.
  let warmed = fetchSha(defaultGitBin, cacheRoot, host, owner, repo, "file://" + srcDir, sha, pmCheckTimeoutMs) catch e {
    panic("projectcheck: warming the cache failed: " + e.message())
    pmDeadFetchResult()
  }
  assert(!warmed.cacheHit)
  assert(warmed.dir == wantDir)

  let lockEntry = LockEntry{ name: "pkg", url: "https://${host}/${owner}/${repo}.git",
    commit: sha, requires: []LockRequire(0) }

  // Direct call: resolvePackageImport alone. `host` resolves nowhere (it is
  // reserved by RFC 2606 and never dialed here), so a `detail`-carrying
  // failure would show up immediately — proving no fetch was even attempted,
  // not merely a fast one — while a clean, correct `dir` proves the warm-cache
  // verify (a local `git rev-parse HEAD`, `fetchSha`'s cache-hit branch) is
  // what actually ran.
  let lw = Loader{ lockEntries: map<string, LockEntry>{ "pkg": lockEntry }, cacheRoot: cacheRoot,
    pkgDirCache: map<string, string>{}, pkgDetailCache: map<string, string>{} }
  let (dir, detail) = resolvePackageImport(lw, "pkg")
  assert(detail == "")
  assert(dir == wantDir)

  // End to end through the real recursive loader: a project directory whose
  // `main.bit` imports "pkg" must resolve it to the cached module and
  // type-check a call against its export. Built directly on `Loader`/
  // `loadModuleAt` rather than `loadProjectOverlay` (as `checkProjectImports`
  // above already does) so the test controls `cacheRoot` itself instead of
  // the real `~/.bit/pkg` `loadProjectOverlay` would resolve via
  // `defaultCacheRoot` — this is exactly `loadProjectOverlay`'s own body,
  // minus the parts that would reach outside this test's scratch tree.
  let projDir = root + "/proj"
  mkdirAll(projDir) catch e { panic("projectcheck: cannot create project dir: " + e.message()) }
  writeLock(projDir + "/bit.lock", [lockEntry]) catch e {
    panic("projectcheck: writeLock failed: " + e.message())
  }
  writeFile(projDir + "/main.bit",
    "import { greet } from \"pkg\"\nfunction main() {\n  print(greet())\n}\n") catch e {
    panic("projectcheck: cannot write main.bit: " + e.message())
  }

  let sm2 = newSourceManager()
  let lw2 = Loader{ mods: []SrcModule(0), resolved: map<string, int>{}, loading: map<string, bool>{},
    stdRoot: "", prelude: -1, sm: sm2, diags: newDiagnostics(sm2), overlays: map<string, string>{},
    lockEntries: map<string, LockEntry>{ "pkg": lockEntry }, cacheRoot: cacheRoot,
    pkgDirCache: map<string, string>{}, pkgDetailCache: map<string, string>{} }
  let rootId = loadModuleAt(lw2, projDir, "")
  let p = Project{ mods: lw2.mods, root: rootId, prelude: lw2.prelude, sm: sm2, diags: lw2.diags }
  assert(p.root >= 0)
  let mods = resolveProject(p)
  checkResolved(p, mods)
  assert(!hasErrors(p.diags))
  let rootMod = p.mods[p.root]
  let (pkgModId, hasPkg) = rootMod.imports["pkg"]
  assert(hasPkg && pkgModId >= 0)
  // `loadModuleAt` canonicalizes every module's `dir` with `pathResolve`
  // (collapsing e.g. a double slash from a `TMPDIR` that already ends in one);
  // `wantDir` above is a plain concatenation, so it needs the same treatment
  // to compare equal.
  assert(p.mods[pkgModId].dir == pathResolve(wantDir))

  // Memoization (#1737 review): a second lookup for the SAME name on the SAME
  // Loader (`lw`, still holding its first successful result) must not re-run
  // the warm-cache verify. Proven by breaking the cache's `.git/HEAD` — a
  // live `git rev-parse HEAD` would now fail, so a second call still
  // succeeding means it returned the cached result rather than re-verifying.
  // Last in this function: nothing after it depends on `wantDir` being intact.
  remove(wantDir + "/.git/HEAD") catch e { panic("projectcheck: cannot corrupt fixture .git/HEAD: " + e.message()) }
  let (dir2, detail2) = resolvePackageImport(lw, "pkg")
  assert(detail2 == "")
  assert(dir2 == wantDir)
}

// A missing bit.lock entry (#1737): `bit check`/`bit build`/`bit run` must
// refuse the import outright, naming the dependency and pointing at `bit add`
// — never attempting a fetch for a name bit.lock never locked.
function checkProjectPackageImportsMissingLock() {
  let root = pmCheckScratchDir()
  let projDir = root + "/proj"
  mkdirAll(projDir) catch e { panic("projectcheck: cannot create project dir: " + e.message()) }
  // No bit.lock at all: `readLock` treats that as zero entries, not an error.
  writeFile(projDir + "/main.bit", "import { x } from \"nope\"\nfunction main() {}\n") catch e {
    panic("projectcheck: cannot write main.bit: " + e.message())
  }

  let p = loadProjectOverlay(projDir, "", "", map<string, string>{})
  resolveProject(p)
  assert(hasErrors(p.diags))
  let rendered = renderDiags(p.diags)
  assert(pkgTestContains(rendered, "cannot find module \"nope\""))
  assert(pkgTestContains(rendered, "not declared in bit.lock"))
  assert(pkgTestContains(rendered, "bit add"))
}

function checkProjectFileOf() {
  // Concatenation makes spans module-global; fileOf maps one back. Boundaries
  // are what break here: an offset AT a file's start belongs to that file.
  let starts = [0, 10, 25]
  let l0 = fileOf(starts, 0)
  assert(l0.fileIdx == 0 && l0.offset == 0)
  let l1 = fileOf(starts, 9)
  assert(l1.fileIdx == 0 && l1.offset == 9)
  let l2 = fileOf(starts, 10) // exactly at b.bit's first byte
  assert(l2.fileIdx == 1 && l2.offset == 0)
  let l3 = fileOf(starts, 24)
  assert(l3.fileIdx == 1 && l3.offset == 14)
  let l4 = fileOf(starts, 25)
  assert(l4.fileIdx == 2 && l4.offset == 0)
  let l5 = fileOf(starts, 100)
  assert(l5.fileIdx == 2 && l5.offset == 75)
}
