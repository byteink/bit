// Self-host Stage 1 (#1335): the parser, ported from compiler/parser.zig. This
// first cut is a minimal-but-real recursive-descent slice — top-level `const`/
// `let` bindings and `function` declarations, block bodies of let/return/
// expression statements, and the full precedence-climbing expression grammar
// (binary, unary, postfix call/member, primary literals/idents/parens). It
// builds the same node tags + child order as the seed, so `bitc2 --dump-ast` is
// byte-identical for programs in this subset. Structs/enums/interfaces/control
// flow/generics/slices/maps and error recovery are follow-ups.
//
// The parser runs over a pre-lexed token array (lexAll), including the lexer's
// ASI semicolons. Only leaf nodes need exact spans (the dump renders their
// source text); interior-node spans are irrelevant to the dump, so they use a
// dummy point span.

struct Parser {
  toks: []Token,
  src: string,
  pos: int,
  tree: Tree,
  // Suppresses a `T{...}` composite literal at the top of a `for..of`/`for..in`
  // iterable, where the `{` opens the loop body (§13.1).
  noComposite: bool,
}

function newParser(src: string): Parser {
  return Parser{ toks: lexAll(src), src: src, pos: 0, tree: newTree(), noComposite: false }
}

function peekTok(p: Parser): Token {
  return p.toks[p.pos]
}

function peekKind(p: Parser): Kind {
  return p.toks[p.pos].kind
}

// The kind `n` tokens ahead (Eof past the end).
function peekKindAt(p: Parser, n: int): Kind {
  let j = p.pos + n
  if (j < len(p.toks)) {
    return p.toks[j].kind
  }
  return Kind.Eof
}

// A call/slice-literal item: `...expr` spread or a plain `expr` argument.
function parseArgItem(p: Parser): int {
  if (accept(p, Kind.Ellipsis)) {
    return mkNode(p, Tag.ArgSpread, 0, [parseExpr(p)])
  }
  return mkNode(p, Tag.Arg, 0, [parseExpr(p)])
}

function advance(p: Parser) {
  if (p.pos + 1 < len(p.toks)) {
    p.pos = p.pos + 1
  }
}

function accept(p: Parser, k: Kind): bool {
  if (peekKind(p) == k) {
    advance(p)
    return true
  }
  return false
}

// Consume `k` if present. This minimal parser assumes well-formed input; real
// error recovery lands with the diagnostics renderer.
function expect(p: Parser, k: Kind) {
  if (peekKind(p) == k) {
    advance(p)
  }
}

function skipSemis(p: Parser) {
  while (peekKind(p) == Kind.Semicolon) {
    advance(p)
  }
}

// A leaf node from the current token (with its exact span), then advance.
function leaf(p: Parser, tag: Tag): int {
  let t = peekTok(p)
  let node = addLeaf(p.tree, tag, Span{ file: 0, start: t.start, end: t.end })
  advance(p)
  return node
}

// An interior node with a dummy span (the dump ignores interior spans).
function mkNode(p: Parser, tag: Tag, main: int, kids: []int): int {
  return addNode(p.tree, tag, pointSpan(0, 0), main, kids)
}

// ---- expressions -----------------------------------------------------------

function precedenceOf(k: Kind): int {
  if (k == Kind.Star || k == Kind.Slash || k == Kind.Percent || k == Kind.Shl ||
    k == Kind.Shr || k == Kind.Amp) {
    return 6
  }
  if (k == Kind.Plus || k == Kind.Minus || k == Kind.Pipe || k == Kind.Caret) {
    return 5
  }
  if (k == Kind.EqEq || k == Kind.BangEq || k == Kind.Lt || k == Kind.LtEq ||
    k == Kind.Gt || k == Kind.GtEq) {
    return 4
  }
  if (k == Kind.AmpAmp) {
    return 3
  }
  if (k == Kind.PipePipe) {
    return 2
  }
  return 0
}

function canStartType(k: Kind): bool {
  return k == Kind.Ident || k == Kind.LBracket || k == Kind.KwMap ||
    k == Kind.KwChan || k == Kind.LParen
}

// A `[`-led primary: a `[]T`/`[N]T` type used as a value (conversion/composite
// callee, e.g. `[]byte(x)`), or a slice literal `[a, b, c]`. Uses lookahead
// rather than the seed's speculation: `[]` opens a slice type, `[N]T` (int, `]`,
// type-start) an array type, else it is a slice literal.
function parseBracketPrimary(p: Parser): int {
  if (peekKindAt(p, 1) == Kind.RBracket) {
    advance(p)
    advance(p)
    return mkNode(p, Tag.SliceType, 0, [parseType(p)])
  }
  if (peekKindAt(p, 1) == Kind.IntLit && peekKindAt(p, 2) == Kind.RBracket &&
    canStartType(peekKindAt(p, 3))) {
    advance(p)
    let size = leaf(p, Tag.IntLit)
    advance(p)
    return mkNode(p, Tag.ArrayType, 0, [size, parseType(p)])
  }
  advance(p)
  let items = []int(0)
  while (peekKind(p) != Kind.RBracket && peekKind(p) != Kind.Eof) {
    items = append(items, parseArgItem(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RBracket)
  return mkNode(p, Tag.SliceLit, 0, items)
}

// `field_init = name ":" expression`.
function parseFieldInit(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  expect(p, Kind.Colon)
  let e = parseExpr(p)
  return mkNode(p, Tag.FieldInit, 0, [name, e])
}

// `T{ x: 1, y: 2 }` — a struct composite literal `[type, field_inits]`.
function parseCompositeLit(p: Parser, typeNode: int): int {
  advance(p)
  let items = []int(0)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    items = append(items, parseFieldInit(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RBrace)
  let inits = mkNode(p, Tag.FieldInits, 0, items)
  return mkNode(p, Tag.CompositeLit, 0, [typeNode, inits])
}

// `str_interp = str_part { interp_start expression interp_end str_part }`.
function parseInterpString(p: Parser): int {
  let parts = []int(0)
  let guard = 0
  while (guard < 4096) {
    parts = append(parts, leaf(p, Tag.StrPart))
    if (!accept(p, Kind.InterpStart)) {
      break
    }
    parts = append(parts, parseExpr(p))
    expect(p, Kind.InterpEnd)
    guard = guard + 1
  }
  return mkNode(p, Tag.StrInterp, 0, parts)
}

// `recv[i]` index or `recv[lo:hi]` slice (either bound optional).
function parseIndexOrSlice(p: Parser, recv: int): int {
  advance(p)
  let lo = 0
  if (peekKind(p) != Kind.Colon) {
    lo = parseExpr(p)
  }
  if (accept(p, Kind.Colon)) {
    let hi = 0
    if (peekKind(p) != Kind.RBracket) {
      hi = parseExpr(p)
    }
    expect(p, Kind.RBracket)
    return mkNode(p, Tag.SliceExpr, 0, [recv, lo, hi])
  }
  expect(p, Kind.RBracket)
  return mkNode(p, Tag.Index, 0, [recv, lo])
}

function parsePrimary(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.StrPart) { return parseInterpString(p) }
  if (k == Kind.IntLit) { return leaf(p, Tag.IntLit) }
  if (k == Kind.FloatLit) { return leaf(p, Tag.FloatLit) }
  if (k == Kind.StringLit) { return leaf(p, Tag.StringLit) }
  if (k == Kind.RawStringLit) { return leaf(p, Tag.RawStringLit) }
  if (k == Kind.RuneLit) { return leaf(p, Tag.RuneLit) }
  if (k == Kind.BoolLit) { return leaf(p, Tag.BoolLit) }
  if (k == Kind.NilLit) { return leaf(p, Tag.NilLit) }
  if (k == Kind.Ident) { return leaf(p, Tag.Ident) }
  if (k == Kind.KwMatch) { return parseMatch(p, true) }
  if (k == Kind.KwChan) { return parseChanType(p) }
  if (k == Kind.KwMap) { return parseMapType(p) }
  if (k == Kind.LBracket) { return parseBracketPrimary(p) }
  if (k == Kind.LParen) {
    // Speculate a parenthesized arrow `(a, b) => body` / `(a: T) => body`; on
    // failure reset and parse a plain parenthesized expression (transparent).
    let mark = p.pos
    advance(p)
    let ok = true
    let params = []int(0)
    if (peekKind(p) != Kind.RParen) {
      let done = false
      while (!done) {
        if (peekKind(p) != Kind.Ident) {
          ok = false
          done = true
        } else {
          let name = leaf(p, Tag.Ident)
          let ty = 0
          if (accept(p, Kind.Colon)) {
            ty = parseType(p)
          }
          params = append(params, mkNode(p, Tag.ArrowP, 0, [name, ty]))
          if (!accept(p, Kind.Comma)) {
            done = true
          }
        }
      }
    }
    if (ok && peekKind(p) == Kind.RParen) {
      advance(p)
      if (accept(p, Kind.FatArrow)) {
        let ap = mkNode(p, Tag.ArrowParams, 0, params)
        let body = 0
        if (peekKind(p) == Kind.LBrace) {
          body = parseBlock(p)
        } else {
          body = parseExpr(p)
        }
        return mkNode(p, Tag.ArrowFn, 0, [ap, body])
      }
    }
    p.pos = mark
    advance(p)
    let inner = parseExpr(p)
    expect(p, Kind.RParen)
    return inner
  }
  // Poison: consume one token so parsing always advances.
  return leaf(p, Tag.NilLit)
}

// Postfix chain: `f(a, b)` calls and `.name` member access. `call` is
// `[callee, type_args_or_none, args]`; `args` holds `arg` nodes each `[expr]`;
// `member` is `[recv, name]`.
function parsePostfix(p: Parser): int {
  let expr = parsePrimary(p)
  let bareName = getNode(p.tree, expr).tag == Tag.Ident
  let guard = 0
  while (guard < 4096) {
    let k = peekKind(p)
    if (k == Kind.LParen) {
      advance(p)
      let argNodes = []int(0)
      while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
        argNodes = append(argNodes, parseArgItem(p))
        if (!accept(p, Kind.Comma)) {
          break
        }
      }
      expect(p, Kind.RParen)
      let args = mkNode(p, Tag.Args, 0, argNodes)
      expr = mkNode(p, Tag.Call, 0, [expr, 0, args])
      bareName = false
    } else if (k == Kind.LBrace && bareName && !p.noComposite) {
      // `T{...}` composite literal — only right after a bare type name, and not
      // when the `{` belongs to a for-loop body (noComposite).
      expr = parseCompositeLit(p, expr)
      bareName = false
    } else if (k == Kind.LBracket) {
      expr = parseIndexOrSlice(p, expr)
      bareName = false
    } else if (k == Kind.Question) {
      advance(p)
      expr = mkNode(p, Tag.TryExpr, 0, [expr])
      bareName = false
    } else if (k == Kind.Dot) {
      advance(p)
      if (accept(p, Kind.LParen)) {
        // `.(T)` type assertion.
        let ty = parseType(p)
        expect(p, Kind.RParen)
        expr = mkNode(p, Tag.TypeAssert, 0, [expr, ty])
      } else if (peekKind(p) == Kind.IntLit) {
        // `.N` tuple index.
        let idx = leaf(p, Tag.IntLit)
        expr = mkNode(p, Tag.TupleIndex, 0, [expr, idx])
      } else {
        let name = leaf(p, Tag.Ident)
        expr = mkNode(p, Tag.Member, 0, [expr, name])
      }
      bareName = false
    } else {
      break
    }
    guard = guard + 1
  }
  return expr
}

function parseUnary(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Bang || k == Kind.Minus || k == Kind.Plus || k == Kind.Tilde ||
    k == Kind.ArrowLeft) {
    advance(p)
    let operand = parseUnary(p)
    return mkNode(p, Tag.Unary, int(k), [operand])
  }
  return parsePostfix(p)
}

// Left-associative precedence climbing (§12).
function parseBinary(p: Parser, minPrec: int): int {
  let lhs = parseUnary(p)
  let guard = 0
  while (guard < 4096) {
    let k = peekKind(p)
    let prec = precedenceOf(k)
    if (prec == 0 || prec < minPrec) {
      break
    }
    advance(p)
    let rhs = parseBinary(p, prec + 1)
    lhs = mkNode(p, Tag.Binary, int(k), [lhs, rhs])
    guard = guard + 1
  }
  return lhs
}

// `catch_expr = binary [ "catch" ( IDENT block | expression ) ]`. `catch e {…}`
// binds the error and runs a block (catch_bind); `catch <expr>` supplies a
// default value (catch_default).
function parseCatchExpr(p: Parser): int {
  let expr = parseBinary(p, 1)
  if (peekKind(p) != Kind.KwCatch) {
    return expr
  }
  advance(p)
  if (peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.LBrace) {
    let name = leaf(p, Tag.Ident)
    let block = parseBlock(p)
    return mkNode(p, Tag.CatchBind, 0, [expr, name, block])
  }
  let def = parseExpr(p)
  return mkNode(p, Tag.CatchDefault, 0, [expr, def])
}

function parseExpr(p: Parser): int {
  // Single-identifier arrow `x => body` — one token of lookahead past the ident.
  // The parenthesized form `(a, b) => body` is a follow-up (needs speculation).
  if (peekKind(p) == Kind.Ident && peekKindAt(p, 1) == Kind.FatArrow) {
    let name = leaf(p, Tag.Ident)
    advance(p)
    let param = mkNode(p, Tag.ArrowP, 0, [name, 0])
    let params = mkNode(p, Tag.ArrowParams, 0, [param])
    let body = 0
    if (peekKind(p) == Kind.LBrace) {
      body = parseBlock(p)
    } else {
      body = parseExpr(p)
    }
    return mkNode(p, Tag.ArrowFn, 0, [params, body])
  }
  return parseCatchExpr(p)
}

// ---- types, params, statements, declarations -------------------------------

// Closes a generic list, splitting the `>` hiding at the front of `>>`/`>>=`/
// `>=` by rewriting the current token in place to the remainder (mirrors the
// seed's expectGenericClose; slice element writes make this possible).
function expectGenericClose(p: Parser) {
  let k = peekKind(p)
  if (k == Kind.Shr || k == Kind.ShrEq || k == Kind.GtEq) {
    let t = peekTok(p)
    let rest = Kind.Gt
    if (k == Kind.ShrEq) { rest = Kind.GtEq }
    if (k == Kind.GtEq) { rest = Kind.Eq }
    p.toks[p.pos] = Token{ kind: rest, start: t.start + 1, end: t.end }
    return
  }
  expect(p, Kind.Gt)
}

function parseSliceOrArrayType(p: Parser): int {
  expect(p, Kind.LBracket)
  if (accept(p, Kind.RBracket)) {
    return mkNode(p, Tag.SliceType, 0, [parseType(p)])
  }
  let size = 0
  if (peekKind(p) == Kind.IntLit) {
    size = leaf(p, Tag.IntLit)
  }
  expect(p, Kind.RBracket)
  return mkNode(p, Tag.ArrayType, 0, [size, parseType(p)])
}

function parseMapType(p: Parser): int {
  advance(p)
  expect(p, Kind.Lt)
  let key = parseType(p)
  expect(p, Kind.Comma)
  let val = parseType(p)
  expectGenericClose(p)
  return mkNode(p, Tag.MapType, 0, [key, val])
}

function parseChanType(p: Parser): int {
  advance(p)
  expect(p, Kind.Lt)
  let elem = parseType(p)
  expectGenericClose(p)
  return mkNode(p, Tag.ChanType, 0, [elem])
}

// A type (§11): a name (optionally a `T<A, B>` generic instantiation), a slice/
// array `[]T`/`[N]T`, `map<K,V>`, or `chan<T>`. Tuple/function types are
// follow-ups.
function parseType(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Ident) {
    let name = leaf(p, Tag.Ident)
    if (peekKind(p) != Kind.Lt) {
      return name
    }
    advance(p)
    let items = []int(0)
    while (peekKind(p) != Kind.Eof) {
      items = append(items, parseType(p))
      if (!accept(p, Kind.Comma)) {
        break
      }
    }
    let targs = mkNode(p, Tag.TypeArgs, 0, items)
    expectGenericClose(p)
    return mkNode(p, Tag.GenericInst, 0, [name, targs])
  }
  if (k == Kind.LBracket) { return parseSliceOrArrayType(p) }
  if (k == Kind.KwMap) { return parseMapType(p) }
  if (k == Kind.KwChan) { return parseChanType(p) }
  if (k == Kind.LParen) { return parseParenType(p) }
  return leaf(p, Tag.Ident)
}

// `(...)` in type position: `() => R` / `(P, Q) => R` function types
// (func_type `[type_list, result]`), `()` unit (void_type), a transparent
// parenthesized `(T)`, or a `(T, U)` tuple type.
function parseParenType(p: Parser): int {
  expect(p, Kind.LParen)
  if (accept(p, Kind.RParen)) {
    if (!accept(p, Kind.FatArrow)) {
      return mkNode(p, Tag.VoidType, 0, []int(0))
    }
    let result = parseResultType(p)
    let list = mkNode(p, Tag.TypeList, 0, []int(0))
    return mkNode(p, Tag.FuncType, 0, [list, result])
  }
  let items = []int(0)
  items = append(items, parseType(p))
  while (accept(p, Kind.Comma)) {
    if (peekKind(p) == Kind.RParen) {
      break
    }
    items = append(items, parseType(p))
  }
  expect(p, Kind.RParen)
  if (accept(p, Kind.FatArrow)) {
    let result = parseResultType(p)
    let list = mkNode(p, Tag.TypeList, 0, items)
    return mkNode(p, Tag.FuncType, 0, [list, result])
  }
  if (len(items) == 1) {
    return items[0]
  }
  return mkNode(p, Tag.TupleType, 0, items)
}

// `T!` / `T!E` fallible result, else a plain type.
function parseResultType(p: Parser): int {
  let ty = parseType(p)
  if (!accept(p, Kind.Bang)) {
    return ty
  }
  let err = 0
  let k = peekKind(p)
  if (k == Kind.Ident || k == Kind.LBracket || k == Kind.KwMap || k == Kind.KwChan) {
    err = parseType(p)
  }
  return mkNode(p, Tag.Fallible, 0, [ty, err])
}

// `constraint = type_name { "&" type_name }`.
function parseConstraint(p: Parser): int {
  let items = []int(0)
  items = append(items, leaf(p, Tag.Ident))
  while (accept(p, Kind.Amp)) {
    items = append(items, leaf(p, Tag.Ident))
  }
  return mkNode(p, Tag.Constraint, 0, items)
}

function parseGenericParam(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let constraint = 0
  if (accept(p, Kind.Colon)) {
    constraint = parseConstraint(p)
  }
  return mkNode(p, Tag.GenericParam, 0, [name, constraint])
}

// Optional `<T, U: Bound>` after a type/function name; `0` (none) when absent.
function maybeGenericParams(p: Parser): int {
  if (peekKind(p) != Kind.Lt) {
    return 0
  }
  advance(p)
  let items = []int(0)
  while (peekKind(p) != Kind.Gt && peekKind(p) != Kind.Eof) {
    items = append(items, parseGenericParam(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.Gt)
  return mkNode(p, Tag.GenericParams, 0, items)
}

function parseParam(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  expect(p, Kind.Colon)
  let ty = parseType(p)
  return mkNode(p, Tag.Param, 0, [name, ty])
}

function parseParams(p: Parser): int {
  expect(p, Kind.LParen)
  let items = []int(0)
  while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
    items = append(items, parseParam(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RParen)
  return mkNode(p, Tag.Params, 0, items)
}

// `binding = [pattern, type_or_none, init_or_none]` (simple ident pattern; a
// tuple pattern is a follow-up).
function parseOneBinding(p: Parser): int {
  let name = parsePat(p)
  let ty = 0
  if (accept(p, Kind.Colon)) {
    ty = parseType(p)
  }
  let init = 0
  if (accept(p, Kind.Eq)) {
    init = parseExpr(p)
  }
  return mkNode(p, Tag.Binding, 0, [name, ty, init])
}

// `const`/`let` — one or more comma-separated bindings.
function parseValueDecl(p: Parser, declTag: Tag): int {
  advance(p)
  let items = []int(0)
  items = append(items, parseOneBinding(p))
  while (accept(p, Kind.Comma)) {
    items = append(items, parseOneBinding(p))
  }
  return mkNode(p, declTag, 0, items)
}

// A struct field `[export] name: type` (export wraps the field node).
function parseField(p: Parser): int {
  let exported = accept(p, Kind.KwExport)
  let name = leaf(p, Tag.Ident)
  expect(p, Kind.Colon)
  let ty = parseType(p)
  let node = mkNode(p, Tag.Field, 0, [name, ty])
  if (!exported) {
    return node
  }
  return mkNode(p, Tag.Export, 0, [node])
}

function parseStructDecl(p: Parser): int {
  advance(p)
  let name = leaf(p, Tag.Ident)
  let generics = maybeGenericParams(p)
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    items = append(items, parseField(p))
    if (!accept(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
  }
  expect(p, Kind.RBrace)
  let fields = mkNode(p, Tag.FieldList, 0, items)
  return mkNode(p, Tag.StructDecl, 0, [name, generics, fields])
}

// `V` or `V(T, U)` — a variant with an optional parenthesized payload type list.
function parseVariant(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let payload = 0
  if (accept(p, Kind.LParen)) {
    let tys = []int(0)
    while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
      tys = append(tys, parseType(p))
      if (!accept(p, Kind.Comma)) {
        break
      }
    }
    expect(p, Kind.RParen)
    payload = mkNode(p, Tag.TypeList, 0, tys)
  }
  return mkNode(p, Tag.EnumVariant, 0, [name, payload])
}

function parseEnumDecl(p: Parser): int {
  advance(p)
  let name = leaf(p, Tag.Ident)
  let generics = maybeGenericParams(p)
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    items = append(items, parseVariant(p))
    if (!accept(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
  }
  expect(p, Kind.RBrace)
  let variants = mkNode(p, Tag.VariantList, 0, items)
  return mkNode(p, Tag.EnumDecl, 0, [name, generics, variants])
}

// `method_sig = [name, params, result_or_none]`.
function parseMethodSig(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let params = parseParams(p)
  let result = 0
  if (accept(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  return mkNode(p, Tag.MethodSig, 0, [name, params, result])
}

function parseInterfaceDecl(p: Parser): int {
  advance(p)
  let name = leaf(p, Tag.Ident)
  let generics = maybeGenericParams(p)
  expect(p, Kind.LBrace)
  let items = []int(0)
  skipSemis(p)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    items = append(items, parseMethodSig(p))
    if (!accept(p, Kind.Comma)) {
      skipSemis(p)
    }
    skipSemis(p)
  }
  expect(p, Kind.RBrace)
  let sigs = mkNode(p, Tag.MethodSigList, 0, items)
  return mkNode(p, Tag.InterfaceDecl, 0, [name, generics, sigs])
}

function parseTypeAlias(p: Parser): int {
  advance(p)
  let name = leaf(p, Tag.Ident)
  let generics = maybeGenericParams(p)
  expect(p, Kind.Eq)
  let ty = parseType(p)
  return mkNode(p, Tag.TypeAlias, 0, [name, generics, ty])
}

function parseImportItem(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let alias = 0
  if (accept(p, Kind.KwAs)) {
    alias = leaf(p, Tag.Ident)
  }
  return mkNode(p, Tag.ImportItem, 0, [name, alias])
}

function parseImportBody(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.Ident) {
    return mkNode(p, Tag.ImportNs, 0, [leaf(p, Tag.Ident)])
  }
  if (k == Kind.Star) {
    advance(p)
    expect(p, Kind.KwAs)
    return mkNode(p, Tag.ImportStar, 0, [leaf(p, Tag.Ident)])
  }
  // `{ a, b as c }`
  expect(p, Kind.LBrace)
  let items = []int(0)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    items = append(items, parseImportItem(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RBrace)
  return mkNode(p, Tag.ImportGroup, 0, items)
}

function parseImportDecl(p: Parser): int {
  advance(p)
  let body = parseImportBody(p)
  expect(p, Kind.KwFrom)
  let path = 0
  if (peekKind(p) == Kind.StringLit) {
    path = leaf(p, Tag.StringLit)
  }
  return mkNode(p, Tag.ImportDecl, 0, [body, path])
}

// A pattern: `_`/IDENT (both lex as ident) or a nested tuple pattern.
function parsePat(p: Parser): int {
  if (peekKind(p) == Kind.LParen) {
    return parseTuplePat(p)
  }
  return leaf(p, Tag.Ident)
}

// `( pat, pat, ... )` — a tuple destructuring pattern.
function parseTuplePat(p: Parser): int {
  expect(p, Kind.LParen)
  let items = []int(0)
  while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
    items = append(items, parsePat(p))
    if (!accept(p, Kind.Comma)) {
      break
    }
  }
  expect(p, Kind.RParen)
  return mkNode(p, Tag.TuplePat, 0, items)
}

// A variant pattern `V` or `V(a, b)` — `[name, binders_or_none]`, binders an
// expr_list of ident leaves.
function parseVariantPat(p: Parser): int {
  let name = leaf(p, Tag.Ident)
  let binders = 0
  if (accept(p, Kind.LParen)) {
    let ids = []int(0)
    while (peekKind(p) != Kind.RParen && peekKind(p) != Kind.Eof) {
      ids = append(ids, leaf(p, Tag.Ident))
      if (!accept(p, Kind.Comma)) {
        break
      }
    }
    expect(p, Kind.RParen)
    binders = mkNode(p, Tag.ExprList, 0, ids)
  }
  return mkNode(p, Tag.VariantPat, 0, [name, binders])
}

// `pat => body` — the body is an expression (match expression) or a statement
// (match statement).
function parseMatchArm(p: Parser, asExpr: bool): int {
  let pat = parseVariantPat(p)
  expect(p, Kind.FatArrow)
  let body = 0
  if (asExpr) {
    body = parseExpr(p)
  } else {
    body = parseStatement(p)
  }
  return mkNode(p, Tag.MatchArm, 0, [pat, body])
}

// `match (subject) { arm , arm ; ... }` — arms separate on `,`/`;` (ASI at a
// newline). One shared node for the statement and expression forms.
function parseMatch(p: Parser, asExpr: bool): int {
  advance(p)
  expect(p, Kind.LParen)
  let subject = parseExpr(p)
  expect(p, Kind.RParen)
  expect(p, Kind.LBrace)
  let arms = []int(0)
  let guard = 0
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof && guard < 100000) {
    if (accept(p, Kind.Semicolon) || accept(p, Kind.Comma)) {
      guard = guard + 1
      continue
    }
    arms = append(arms, parseMatchArm(p, asExpr))
    let atBoundary = peekKind(p) == Kind.RBrace || peekKind(p) == Kind.Eof
    if (!accept(p, Kind.Semicolon) && !accept(p, Kind.Comma) && !atBoundary) {
      advance(p)
    }
    guard = guard + 1
  }
  expect(p, Kind.RBrace)
  let armList = mkNode(p, Tag.ArmList, 0, arms)
  return mkNode(p, Tag.MatchStmt, 0, [subject, armList])
}

function canStartExpression(k: Kind): bool {
  return k == Kind.Ident || k == Kind.IntLit || k == Kind.FloatLit ||
    k == Kind.StringLit || k == Kind.StrPart || k == Kind.RawStringLit ||
    k == Kind.RuneLit || k == Kind.BoolLit || k == Kind.NilLit ||
    k == Kind.LParen || k == Kind.LBracket || k == Kind.KwMap ||
    k == Kind.KwChan || k == Kind.KwMatch || k == Kind.Bang ||
    k == Kind.Minus || k == Kind.Plus || k == Kind.Tilde || k == Kind.ArrowLeft
}

// `return [ expr { "," expr } ]` — a grouped return carries several exprs.
function parseReturn(p: Parser): int {
  advance(p)
  if (!canStartExpression(peekKind(p))) {
    return mkNode(p, Tag.ReturnStmt, 0, []int(0))
  }
  let items = []int(0)
  items = append(items, parseExpr(p))
  while (accept(p, Kind.Comma)) {
    items = append(items, parseExpr(p))
  }
  return mkNode(p, Tag.ReturnStmt, 0, items)
}

function isAssignOp(k: Kind): bool {
  return k == Kind.Eq || k == Kind.PlusEq || k == Kind.MinusEq ||
    k == Kind.StarEq || k == Kind.SlashEq || k == Kind.PercentEq ||
    k == Kind.AmpEq || k == Kind.PipeEq || k == Kind.CaretEq ||
    k == Kind.ShlEq || k == Kind.ShrEq
}

// `assign | inc | dec | send | expr` statement. The assign op (or `=`) is stored
// in `Node.main`; lhs/rhs are comma lists (lhs_list / expr_list).
function parseSimpleStmt(p: Parser): int {
  let first = parseExpr(p)
  let k = peekKind(p)
  if (k == Kind.PlusPlus) {
    advance(p)
    return mkNode(p, Tag.IncStmt, 0, [first])
  }
  if (k == Kind.MinusMinus) {
    advance(p)
    return mkNode(p, Tag.DecStmt, 0, [first])
  }
  if (k == Kind.ArrowLeft) {
    advance(p)
    return mkNode(p, Tag.SendStmt, 0, [first, parseExpr(p)])
  }
  if (k == Kind.Comma || isAssignOp(k)) {
    let lhss = []int(0)
    lhss = append(lhss, first)
    while (accept(p, Kind.Comma)) {
      lhss = append(lhss, parseExpr(p))
    }
    if (!isAssignOp(peekKind(p))) {
      return mkNode(p, Tag.ExprStmt, 0, [first])
    }
    let op = peekKind(p)
    advance(p)
    let rhss = []int(0)
    rhss = append(rhss, parseExpr(p))
    while (accept(p, Kind.Comma)) {
      rhss = append(rhss, parseExpr(p))
    }
    let lhsList = mkNode(p, Tag.LhsList, 0, lhss)
    let rhsList = mkNode(p, Tag.ExprList, 0, rhss)
    return mkNode(p, Tag.Assign, int(op), [lhsList, rhsList])
  }
  return mkNode(p, Tag.ExprStmt, 0, [first])
}

function parseIfStmt(p: Parser): int {
  advance(p)
  expect(p, Kind.LParen)
  let cond = parseExpr(p)
  expect(p, Kind.RParen)
  let thenBlk = parseBlock(p)
  let elseBlk = 0
  if (accept(p, Kind.KwElse)) {
    if (peekKind(p) == Kind.KwIf) {
      elseBlk = parseIfStmt(p)
    } else {
      elseBlk = parseBlock(p)
    }
  }
  return mkNode(p, Tag.IfStmt, 0, [cond, thenBlk, elseBlk])
}

function parseWhileStmt(p: Parser): int {
  advance(p)
  expect(p, Kind.LParen)
  let cond = parseExpr(p)
  expect(p, Kind.RParen)
  let body = parseBlock(p)
  return mkNode(p, Tag.WhileStmt, 0, [cond, body])
}

// A `for..of`/`for..in` iterable has composite literals suppressed at its top
// level (the `{` after it opens the loop body).
function parseIterExpr(p: Parser): int {
  let saved = p.noComposite
  p.noComposite = true
  let e = parseExpr(p)
  p.noComposite = saved
  return e
}

// `for ( init ; cond ; post ) block` — each clause optional.
function parseForC(p: Parser): int {
  expect(p, Kind.LParen)
  let init = 0
  let k = peekKind(p)
  if (k == Kind.KwLet) {
    init = parseValueDecl(p, Tag.LetDecl)
  } else if (k == Kind.KwConst) {
    init = parseValueDecl(p, Tag.ConstDecl)
  } else if (k != Kind.Semicolon) {
    init = parseSimpleStmt(p)
  }
  expect(p, Kind.Semicolon)
  let cond = 0
  if (peekKind(p) != Kind.Semicolon) {
    cond = parseExpr(p)
  }
  expect(p, Kind.Semicolon)
  let post = 0
  if (peekKind(p) != Kind.RParen) {
    post = parseSimpleStmt(p)
  }
  expect(p, Kind.RParen)
  let body = parseBlock(p)
  return mkNode(p, Tag.ForC, 0, [init, cond, post, body])
}

// `for x of iter`, `for x in iter`, `for (init; cond; post)`, or `for {}`. The
// tuple binder form `for (k, v) of m` needs speculation and is a follow-up.
function parseForStmt(p: Parser): int {
  advance(p)
  let k = peekKind(p)
  if (k == Kind.LParen) {
    // `for (k, v) of m` — a tuple binder. Speculate a tuple pattern followed by
    // `of`; on failure, reset (orphaned nodes are harmless — the dump walks only
    // from the root) and take the C-style `for (init; cond; post)`.
    let mark = p.pos
    let binder = parseTuplePat(p)
    if (len(kidsOf(p.tree, binder)) >= 2 && peekKind(p) == Kind.KwOf) {
      advance(p)
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForOf, 0, [binder, iter, parseBlock(p)])
    }
    p.pos = mark
    return parseForC(p)
  }
  if (k == Kind.Ident) {
    let name = leaf(p, Tag.Ident)
    if (accept(p, Kind.KwOf)) {
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForOf, 0, [name, iter, parseBlock(p)])
    }
    if (accept(p, Kind.KwIn)) {
      let iter = parseIterExpr(p)
      return mkNode(p, Tag.ForIn, 0, [name, iter, parseBlock(p)])
    }
    return mkNode(p, Tag.ForInf, 0, [parseBlock(p)])
  }
  return mkNode(p, Tag.ForInf, 0, [parseBlock(p)])
}

function parseStatement(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.KwLet) { return parseValueDecl(p, Tag.LetDecl) }
  if (k == Kind.KwConst) { return parseValueDecl(p, Tag.ConstDecl) }
  if (k == Kind.KwIf) { return parseIfStmt(p) }
  if (k == Kind.KwWhile) { return parseWhileStmt(p) }
  if (k == Kind.KwFor) { return parseForStmt(p) }
  if (k == Kind.KwMatch) { return parseMatch(p, false) }
  if (k == Kind.KwReturn) { return parseReturn(p) }
  if (k == Kind.KwFail) {
    advance(p)
    return mkNode(p, Tag.FailStmt, 0, [parseExpr(p)])
  }
  if (k == Kind.KwBreak) {
    advance(p)
    return mkNode(p, Tag.BreakStmt, 0, []int(0))
  }
  if (k == Kind.KwContinue) {
    advance(p)
    return mkNode(p, Tag.ContinueStmt, 0, []int(0))
  }
  if (k == Kind.KwSpawn) {
    advance(p)
    return mkNode(p, Tag.SpawnStmt, 0, [parsePostfix(p)])
  }
  if (k == Kind.KwDefer) {
    advance(p)
    return mkNode(p, Tag.DeferStmt, 0, [parsePostfix(p)])
  }
  if (k == Kind.LBrace) { return parseBlock(p) }
  return parseSimpleStmt(p)
}

function parseBlock(p: Parser): int {
  expect(p, Kind.LBrace)
  let stmts = []int(0)
  skipSemis(p)
  while (peekKind(p) != Kind.RBrace && peekKind(p) != Kind.Eof) {
    stmts = append(stmts, parseStatement(p))
    skipSemis(p)
  }
  expect(p, Kind.RBrace)
  return mkNode(p, Tag.Block, 0, stmts)
}

// `func_decl = [recv_or_none, name, generics_or_none, params, result_or_none,
// body]`. Receiver (method) support is a follow-up (always none here).
function parseFuncDecl(p: Parser): int {
  advance(p)
  // Optional method receiver `(name: Type)`. The receiver type is a bare name
  // (generic-struct receivers are unimplemented in the seed too, #1325).
  let recv = 0
  if (peekKind(p) == Kind.LParen) {
    advance(p)
    let rname = leaf(p, Tag.Ident)
    expect(p, Kind.Colon)
    let rty = leaf(p, Tag.Ident)
    recv = mkNode(p, Tag.Receiver, 0, [rname, rty])
    expect(p, Kind.RParen)
  }
  let name = leaf(p, Tag.Ident)
  let generics = maybeGenericParams(p)
  let params = parseParams(p)
  let result = 0
  if (accept(p, Kind.Colon)) {
    result = parseResultType(p)
  }
  let body = parseBlock(p)
  return mkNode(p, Tag.FuncDecl, 0, [recv, name, generics, params, result, body])
}

// Every non-import declaration that may follow `export`.
function parseExportableDecl(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.KwConst) { return parseValueDecl(p, Tag.ConstDecl) }
  if (k == Kind.KwLet) { return parseValueDecl(p, Tag.LetDecl) }
  if (k == Kind.KwFunction) { return parseFuncDecl(p) }
  if (k == Kind.KwStruct) { return parseStructDecl(p) }
  if (k == Kind.KwInterface) { return parseInterfaceDecl(p) }
  if (k == Kind.KwEnum) { return parseEnumDecl(p) }
  if (k == Kind.KwType) { return parseTypeAlias(p) }
  advance(p)
  return 0
}

function parseTopDecl(p: Parser): int {
  let k = peekKind(p)
  if (k == Kind.KwImport) { return parseImportDecl(p) }
  if (k == Kind.KwExport) {
    advance(p)
    let inner = parseExportableDecl(p)
    if (inner == 0) {
      return 0
    }
    return mkNode(p, Tag.Export, 0, [inner])
  }
  return parseExportableDecl(p)
}

function parseProgram(p: Parser): int {
  let decls = []int(0)
  skipSemis(p)
  let guard = 0
  while (peekKind(p) != Kind.Eof && guard < 100000) {
    let d = parseTopDecl(p)
    if (d != 0) {
      decls = append(decls, d)
    }
    skipSemis(p)
    guard = guard + 1
  }
  return mkNode(p, Tag.Program, 0, decls)
}

// Parses `src` into a Tree whose root is the `program` node.
function parseSource(src: string): Tree {
  let p = newParser(src)
  p.tree.root = parseProgram(p)
  return p.tree
}
