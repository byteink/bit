// Self-host Stage 3 (#1340): backend-agnostic codegen core, ported from
// compiler/codegen/common.zig. Kept deliberately tiny — only logic with zero
// dependency on a physical register file or instruction encoding belongs here;
// everything else (register lists, calling-convention argument mapping, the
// instruction encoder, frame layout) is inherently per-ISA and stays in its own
// backend file. Divergence between backends in code that COULD live here is a
// design smell; extract more here only once a second concrete user demonstrates
// the logic is truly identical, not merely similar.

// One physical register file's class (the seed's regalloc.Class).
enum RegClass {
  Int,
  Float,
}

// A scalar's storage width and class. Mirrors lower.bit's object-layout scheme:
// every scalar prim is stored at its natural width; every other shape is one
// boxed 8-byte handle.
struct Width {
  bytes: int,
  class: RegClass,
  signed: bool,
}

function mkWidth(bytes: int, class: RegClass, signed: bool): Width {
  return Width{ bytes: bytes, class: class, signed: signed }
}

// Depends only on the TypeContext, never on a physical register — identical for
// every backend. Prim indices: 0=i8 1=i16 2=i32 3=i64 4=u8 5=u16 6=u32 7=u64
// 8=f32 9=f64 10=bool 11=string.
function widthOf(ctx: TypeContext, ty: int): Width {
  if (ctx.types[ty].kind != TypeKind.Prim) {
    return mkWidth(8, RegClass.Int, false) // uniform boxed handle
  }
  let p = ctx.types[ty].prim
  if (p == 0) { return mkWidth(1, RegClass.Int, true) }
  if (p == 4) { return mkWidth(1, RegClass.Int, false) }
  if (p == 1) { return mkWidth(2, RegClass.Int, true) }
  if (p == 5) { return mkWidth(2, RegClass.Int, false) }
  if (p == 2) { return mkWidth(4, RegClass.Int, true) }
  if (p == 6) { return mkWidth(4, RegClass.Int, false) }
  if (p == 3) { return mkWidth(8, RegClass.Int, true) }
  if (p == 7) { return mkWidth(8, RegClass.Int, false) }
  if (p == 8) { return mkWidth(4, RegClass.Float, false) }
  if (p == 9) { return mkWidth(8, RegClass.Float, false) }
  if (p == 10) { return mkWidth(1, RegClass.Int, false) }
  return mkWidth(8, RegClass.Int, false) // string
}

function regClassOf(ctx: TypeContext, ty: int): RegClass {
  return widthOf(ctx, ty).class
}

// Whether a value of type `ty` is a GC reference (lower.bit's fieldLayout
// `isPtr`, re-derived here for codegen's own use).
function isRefType(ctx: TypeContext, ty: int): bool {
  let k = ctx.types[ty].kind
  if (k == TypeKind.Prim) {
    return ctx.types[ty].prim == 11 // string
  }
  // A raw pointer `*T` (§11.4) is a word the GC must never follow.
  if (k == TypeKind.Void || k == TypeKind.UntypedInt || k == TypeKind.UntypedFloat ||
    k == TypeKind.UntypedRune || k == TypeKind.UntypedBool || k == TypeKind.UntypedString ||
    k == TypeKind.UntypedNil || k == TypeKind.Invalid || k == TypeKind.TypeParam ||
    k == TypeKind.Fallible || k == TypeKind.Ptr) {
    return false
  }
  if (k == TypeKind.Enum) {
    // A bare tag word, or a boxed {tag, payloadPtr} if it has payloads.
    return ctx.types[ty].enumBoxed
  }
  return true // slice/array/map/tuple/chan/struct/interface/func
}

// What an object writer must patch into the field a Reloc names. x86-64 only
// ever emits Branch (its `movabs` needs no relocation to name an address);
// ARM64 has no wide-immediate address-of, so it names a static symbol with an
// ADRP/ADD pair — Page21 patches the ADRP's page number, PageOff12 the ADD's
// in-page offset.
enum RelocKind {
  // A PC-relative call/branch immediate: AArch64's BL (26-bit), x86-64's
  // `E8 rel32` (4 bytes). Both name a target symbol the linker resolves.
  Branch,
  // AArch64 address materialization: adrp's 21-bit page number, then the
  // add/ldr's 12-bit page offset.
  Page21,
  PageOff12,
  // A full 64-bit absolute address, written into an 8-byte field. x86-64 needs
  // this where AArch64 uses the Page21/PageOff12 pair — a `movabs` loads a
  // symbol's address in one instruction rather than composing it from a page
  // and an offset.
  Abs64,
}

// A relocation: `offset` names the byte, within a function's code, of the field
// an object writer must patch to point at `symbol` (a Bit function's own name,
// or a runtime symbol). The width and meaning of that field is
// architecture-specific (x86-64: a 4-byte `E8 rel32`; ARM64: a `BL`'s 26-bit
// immediate) — the object writer is already relocation-type-aware per target, so
// only the offset/symbol/kind triple is common.
struct Reloc {
  offset: int,
  symbol: string,
  kind: RelocKind,
}

// ===========================================================================
// GC stack-map table (runtime/ABI.md §4)
//
// The precise collector walks each Bit frame at a safepoint and needs, per
// return address, which stack slots and callee-saved registers hold a live GC
// reference — plus, to unwind past a frame, where that frame stashed the
// caller's callee-saved registers. Each backend computes this per function;
// `writeStackMaps` serializes the whole module into one blob the runtime reads
// at collection time via the `bit_stack_maps` symbol.
//
// All offsets are FRAME-POINTER-relative (rbp on x86-64, x29 on AArch64),
// normalized by each backend so the runtime walker is arch-neutral. Both arches
// chain frames identically: *(fp) is the caller's fp and *(fp+8) is the return
// address.
// ===========================================================================

// One callee-saved register a function preserves in its prologue, and the
// frame-relative slot where it stashed the CALLER's value. Unwinding past this
// frame, the walker restores the register from *(fp + fpOff).
struct SavedReg {
  reg: int,
  fpOff: int,
}

// The live-reference set at one safepoint (a call/back-edge return address).
struct SafepointView {
  // Return address = the function's code address + this offset.
  retOffset: int,
  // Frame-pointer-relative offsets of stack slots holding a live reference.
  slots: []int,
  // Physical register numbers holding a live reference at this point.
  regs: []int,
}

// One function's contribution to the module stack-map table.
struct FuncStackMap {
  codeSize: int,
  saved: []SavedReg,
  safepoints: []SafepointView,
}

// A growable byte buffer (the seed passes a *std.ArrayList(u8)); structs are
// reference types, so callees append in place.
struct ByteBuf {
  bytes: []u8,
}

function newByteBuf(): ByteBuf {
  return ByteBuf{ bytes: []u8(0) }
}

// Little-endian appends. The runtime reads the table with unaligned reads, so
// everything is tightly packed.
function appendU16(out: ByteBuf, v: int) {
  out.bytes = append(out.bytes, u8(v & 255))
  out.bytes = append(out.bytes, u8((v >> 8) & 255))
}

function appendU32(out: ByteBuf, v: int) {
  appendU16(out, v & 65535)
  appendU16(out, (v >> 16) & 65535)
}

function appendU64(out: ByteBuf, v: int) {
  appendU32(out, v & 4294967295)
  appendU32(out, (v >> 32) & 4294967295)
}

// Serializes the module stack-map table (runtime/ABI.md §4) by appending its
// blob to `out`. Returns, for each function in order, the byte offset within
// `out` of that function's 8-byte code-address field — the object writer
// relocates each to the function's own symbol so the runtime reads a real code
// address. Offsets are section-relative because `out` already holds everything
// emitted before the table.
//
// Layout (little-endian, tightly packed): `u32 numFuncs`, then per function
// `u64 codeAddr`, `u32 codeSize`, `u16 numSaved` x `{u16 reg, i32 fpOff}`,
// `u16 numSafepoints` x `{u32 retOffset, u16 numSlots x i32, u16 numRegs x u16}`.
function writeStackMaps(out: ByteBuf, funcs: []FuncStackMap): []int {
  let relocOffsets = []int(0)
  appendU32(out, len(funcs))
  let fi = 0
  while (fi < len(funcs)) {
    let fsm = funcs[fi]
    relocOffsets = append(relocOffsets, len(out.bytes))
    appendU64(out, 0) // codeAddr — filled by the reloc
    appendU32(out, fsm.codeSize)
    appendU16(out, len(fsm.saved))
    let si = 0
    while (si < len(fsm.saved)) {
      appendU16(out, fsm.saved[si].reg)
      appendU32(out, fsm.saved[si].fpOff)
      si = si + 1
    }
    appendU16(out, len(fsm.safepoints))
    let pi = 0
    while (pi < len(fsm.safepoints)) {
      let sp = fsm.safepoints[pi]
      appendU32(out, sp.retOffset)
      appendU16(out, len(sp.slots))
      let i = 0
      while (i < len(sp.slots)) {
        appendU32(out, sp.slots[i])
        i = i + 1
      }
      appendU16(out, len(sp.regs))
      i = 0
      while (i < len(sp.regs)) {
        appendU16(out, sp.regs[i])
        i = i + 1
      }
      pi = pi + 1
    }
    fi = fi + 1
  }
  return relocOffsets
}

// The runtime symbol implementing an rt_call. The IR names the primitive the way
// the seed's RtFn tag does, and every runtime export is that tag prefixed with
// `bit_rt_` — except the two error-slot accessors, whose symbols read
// verb-first. A primitive that broke the convention without an entry here would
// fail loudly at link time (undefined symbol), never miscompile.
function rtSymbol(rt: string): string {
  if (rt == "err_set") {
    return "bit_rt_set_err"
  }
  if (rt == "err_get") {
    return "bit_rt_get_err"
  }
  return "bit_rt_${rt}"
}

function safepointSymbol(): string {
  return "bit_rt_safepoint"
}

// ===========================================================================
// Live-interval construction (feeds regalloc.bit's `allocate`)
//
// Backend-agnostic by nature: liveness is a property of the IR's CFG and the
// TypeContext, never of a physical register file or an encoding. The seed keeps
// a private copy per backend (x64.zig's own comment blames a ticket boundary,
// not a technical one) and the two drifted apart — arm64.zig never grew the
// `extendParamsToPreds` guard x64.zig needed. That divergence is exactly the
// design smell this file's header warns about, so with x64 as the second
// concrete user the logic lives here once, guard included.
// ===========================================================================

// Under the RPO block order every block is emitted after the blocks that can
// branch forward to it, so a target at or before the branching block can only be
// closing a loop. A back-edge gets a safepoint poll, so an allocation-free loop
// still yields to the collector (runtime/ABI.md §5).
function isBackEdge(curBlock: int, target: int): bool {
  return target <= curBlock
}

function extendOne(intervals: []LiveInterval, usePos: int, operand: int) {
  if (intervals[operand].end < usePos) {
    intervals[operand].end = usePos
  }
}

function extendList(intervals: []LiveInterval, usePos: int, operands: []int) {
  let i = 0
  while (i < len(operands)) {
    extendOne(intervals, usePos, operands[i])
    i = i + 1
  }
}

// Extends each operand's live interval to reach this instruction. Every op that
// READS a value must be listed — an omission ends a value's interval early and
// the allocator hands its register to someone else while it is still live.
function extendUses(intervals: []LiveInterval, usePos: int, ins: IrInstr) {
  let op = ins.op
  if (op == Op.BlockParam || op == Op.ConstInt || op == Op.ConstFloat ||
    op == Op.ConstBool || op == Op.ConstString || op == Op.ConstNil ||
    op == Op.Unreachable || op == Op.GcAlloc || op == Op.TypeInfo ||
    op == Op.FuncAddr) {
    return // no value operands
  }
  if (op == Op.Jump || op == Op.Ret || op == Op.Call || op == Op.RtCall) {
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.Br) {
    extendOne(intervals, usePos, ins.lhs)
    extendList(intervals, usePos, ins.thenArgs)
    extendList(intervals, usePos, ins.elseArgs)
    return
  }
  if (op == Op.CallValue || op == Op.CallIface) {
    extendOne(intervals, usePos, ins.lhs) // callee / receiver
    extendList(intervals, usePos, ins.args)
    return
  }
  if (op == Op.FieldGet || op == Op.SliceLen || op == Op.MakeClosure ||
    op == Op.Neg || op == Op.BNot || op == Op.Convert || op == Op.FNeg) {
    extendOne(intervals, usePos, ins.lhs)
    return
  }
  if (op == Op.FieldSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    return
  }
  if (op == Op.IndexSet) {
    extendOne(intervals, usePos, ins.lhs)
    extendOne(intervals, usePos, ins.rhs)
    extendOne(intervals, usePos, ins.ival) // the value operand
    return
  }
  // Everything else is a two-operand value op (bin/index_get).
  extendOne(intervals, usePos, ins.lhs)
  extendOne(intervals, usePos, ins.rhs)
}

// All of a block's params are live simultaneously at block entry — the
// predecessor edge's parallel move writes every one before the jump. A param that
// is never read afterward would otherwise keep its initial empty [i, i] interval
// and could be coalesced onto a live sibling param's register, so the edge move
// clobbers one param with another (a returned value coming back as some other
// incoming argument). Extend every param's interval to its block's last param
// position so all params of a block mutually interfere and land in distinct
// registers.
function forceParamInterference(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let blk = f.blocks[bi]
    if (blk.paramCount > 0) {
      let lastParam = blk.instsStart + blk.paramCount - 1
      let p = blk.instsStart
      while (p < blk.instsStart + blk.paramCount) {
        if (intervals[p].end < lastParam) {
          intervals[p].end = lastParam
        }
        p = p + 1
      }
    }
    bi = bi + 1
  }
}

function extendBlockParams(intervals: []LiveInterval, f: IrFunc, target: int, edgePos: int) {
  let blk = f.blocks[target]
  let p = blk.instsStart
  let end = blk.instsStart + blk.paramCount
  while (p < end) {
    if (intervals[p].start > edgePos) {
      intervals[p].start = edgePos
    }
    p = p + 1
  }
}

// A block param's storage is written by each predecessor's edge move, which runs
// at the predecessor's TERMINATOR. Under RPO a forward branch targets a block
// emitted later, so that write happens well before the param's own instruction
// index. Extend every param's start back to its earliest predecessor terminator
// so the param is live across the gap and interferes with anything live there;
// otherwise a value that dies in the gap is handed the param's register or spill
// slot and the edge move clobbers it — the caller silently reads the wrong value
// (an early `return` out of a loop reading a spilled loop-carried local). A
// back-edge predecessor sits at a HIGHER position than the param, so it never
// lowers the start.
//
// Only x64 has ever been observed to need this: a safepoint-bearing function is
// restricted to 4 allocatable callee-saved GPRs and spills, while arm64's ~10
// never forced the collision. arm64 dodged the bug by register count, not by
// correctness — so the guard runs for both rather than waiting for arm64 to grow
// a spill and fail silently.
function extendParamsToPreds(intervals: []LiveInterval, f: IrFunc) {
  let bi = 0
  while (bi < len(f.blocks)) {
    let pblk = f.blocks[bi]
    // A well-formed block always ends in a terminator; guard anyway so malformed
    // IR cannot index out of bounds behind our backs.
    if (pblk.instsLen > 0) {
      let termPos = pblk.instsStart + pblk.instsLen - 1
      let ins = f.instrs[termPos]
      if (ins.op == Op.Jump) {
        extendBlockParams(intervals, f, ins.ival, termPos)
      }
      if (ins.op == Op.Br) {
        extendBlockParams(intervals, f, ins.ival, termPos)
        extendBlockParams(intervals, f, ins.ival2, termPos)
      }
    }
    bi = bi + 1
  }
}

function isSafepointOp(op: Op): bool {
  return op == Op.Call || op == Op.RtCall || op == Op.GcAlloc ||
    op == Op.MakeClosure || op == Op.CallValue || op == Op.CallIface
}

// buildIntervals produces two things at once; a slice appended to inside a callee
// does not grow the caller's, so both come back in one struct.
struct IntervalBuild {
  intervals: []LiveInterval,
  safepoints: []int,
}

// One LiveInterval per instruction slot (dense 0..len(instrs), matching
// regalloc.bit's dense-vreg contract). Non-value instructions (terminators,
// field_set/index_set) get a trivial, never-referenced [i,i] interval; harmless
// filler, never looked up. Also collects safepoint positions in the exact order
// they will be re-encountered during emission (calls first-seen, then back-edge
// terminators) so a backend can match each stack map back to its call by cursor
// position — arm64 consumes this; x64 records its safepoints during emission and
// reads only `intervals`.
function buildIntervals(ctx: TypeContext, f: IrFunc): IntervalBuild {
  let safepoints = []int(0)
  let intervals = []LiveInterval(0)
  let i = 0
  while (i < len(f.instrs)) {
    let w = widthOf(ctx, f.instrs[i].ty)
    intervals = append(intervals, LiveInterval{ vreg: i, class: w.class, start: i, end: i,
      isRef: w.class == RegClass.Int && isRefType(ctx, f.instrs[i].ty) })
    i = i + 1
  }

  let bi = 0
  while (bi < len(f.blocks)) {
    let b = f.blocks[bi]
    let idx = b.instsStart + b.paramCount
    let end = b.instsStart + b.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      if (isSafepointOp(ins.op)) {
        safepoints = append(safepoints, idx)
      }
      extendUses(intervals, idx, ins)
      if (ins.op == Op.Jump && isBackEdge(bi, ins.ival)) {
        safepoints = append(safepoints, idx)
      }
      if (ins.op == Op.Br) {
        if (isBackEdge(bi, ins.ival)) {
          safepoints = append(safepoints, idx)
        }
        if (isBackEdge(bi, ins.ival2)) {
          safepoints = append(safepoints, idx)
        }
      }
      idx = idx + 1
    }
    bi = bi + 1
  }
  extendParamsToPreds(intervals, f)
  forceParamInterference(intervals, f)
  return IntervalBuild{ intervals: intervals, safepoints: safepoints }
}
