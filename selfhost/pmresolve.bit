// Minimal Version Selection over a dependency requirement graph (#1731).
// Implements the rule spec/SPEC.md §17.7 records for `bit.lock` resolution:
// for every module reachable from the root's requirements, pick the MAXIMUM
// of all stated minimum versions for it. One worklist pass, no backtracking,
// no SAT search — see the seed's `go.mod` analogue for the algorithm this
// mirrors.
//
// Scope: pure in-memory graph resolution. The requirement graph (root
// requirements + every transitively-reached module's own requirement list) is
// handed in as data — fetching it from `bit.lock`/git is selfhost/pmfetch.bit's
// job, a separate task. This file never touches the network or filesystem.
//
// Non-version refs (a branch or a bare commit SHA, per §17.7) are not ordered
// versions and are out of scope here too: pmfetch resolves those to a commit
// before a module ever reaches this resolver, so every version this file
// compares is a real `MAJOR.MINOR.PATCH`.

// An exact `vMAJOR.MINOR.PATCH` version (§17.7). Bit has no tuple ordering
// operator, so comparisons are field-by-field, most significant first.
struct Version {
  major: int,
  minor: int,
  patch: int,
}

function versionLess(a: Version, b: Version): bool {
  if (a.major != b.major) { return a.major < b.major }
  if (a.minor != b.minor) { return a.minor < b.minor }
  return a.patch < b.patch
}

function versionEq(a: Version, b: Version): bool {
  return a.major == b.major && a.minor == b.minor && a.patch == b.patch
}

function versionMax(a: Version, b: Version): Version {
  if (versionLess(a, b)) { return b }
  return a
}

// One edge in the requirement graph: the requirer needs `name` at at least
// `min`.
struct Requirement {
  name: string,
  min: Version,
}

// One module version's own requirement list — a `bit.lock` transitive entry
// (§17.7's `requires` field). Distinct versions of the same module can carry
// distinct requirement lists, so identity is (name, version), not name alone.
struct ModuleReqs {
  name: string,
  version: Version,
  requires: []Requirement,
}

// The full input: the root module's direct requirements plus every
// transitively-reached module version's own requirements. pmfetch assembles
// this from `bit.lock`; this resolver only ever reads it.
struct ReqGraph {
  rootRequires: []Requirement,
  modules: []ModuleReqs,
}

// The resolver's output for one module name: the maximum version required by
// any requirer that reached it.
struct Resolved {
  name: string,
  version: Version,
}

// The `graph.modules` entry for (name, version), or none via `ok`. Linear scan
// bounded by `len(graph.modules)` — the graph is small (a project's dependency
// count), and this runs once per worklist item, so the total work stays
// bounded by (edges * modules), both fixed by the input.
function findModuleReqs(graph: ReqGraph, name: string, version: Version): (ModuleReqs, bool) {
  let i = 0
  while (i < len(graph.modules)) {
    let m = graph.modules[i]
    if (m.name == name && versionEq(m.version, version)) {
      return m, true
    }
    i = i + 1
  }
  return ModuleReqs{ name: "", version: Version{ major: 0, minor: 0, patch: 0 },
    requires: []Requirement(0) }, false
}

// Resolves `graph` by Minimal Version Selection: every module reachable from
// `rootRequires` maps to the maximum version any requirer stated for it.
//
// Algorithm: an iterative worklist of requirement edges, FIFO via a growing
// array and a read cursor (no removal, so no shifting). Seed it with the
// root's requirements; expanding a module version's own requirements enqueues
// more edges. A `(name, version)` pair is expanded at most once — the
// `visited` set both bounds the walk (total enqueues <= total edges in the
// input graph, since every enqueue comes from a fixed requirement list read
// at most once) and stops a cycle or self-dependency from looping forever.
function resolveMVS(graph: ReqGraph): map<string, Version> {
  let resolved = map<string, Version>{}
  let visited = map<string, bool>{}
  let queue = []Requirement(0)
  let i = 0
  while (i < len(graph.rootRequires)) {
    queue = append(queue, graph.rootRequires[i])
    i = i + 1
  }

  let qi = 0
  while (qi < len(queue)) {
    let req = queue[qi]
    qi = qi + 1

    let (prior, hasPrior) = resolved[req.name]
    if (hasPrior) {
      resolved[req.name] = versionMax(prior, req.min)
    } else {
      resolved[req.name] = req.min
    }

    let key = "${req.name}@${req.min.major}.${req.min.minor}.${req.min.patch}"
    let (_, seen) = visited[key]
    if (seen) {
      continue
    }
    visited[key] = true

    let (mr, found) = findModuleReqs(graph, req.name, req.min)
    if (!found) {
      continue
    }
    let j = 0
    while (j < len(mr.requires)) {
      queue = append(queue, mr.requires[j])
      j = j + 1
    }
  }

  return resolved
}
