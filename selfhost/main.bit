// bitc2 — the Bit-in-Bit compiler (self-host).
//
// Early driver. Two modes:
//   `bitc2 --dump-tokens <file>` — lex the file and print the token stream in
//     the seed's exact format, so `bitc2 --dump-tokens` diffs byte-for-byte
//     against `bitc --dump-tokens` (the differential harness, #1332).
//   `bitc2` (no args) — self-test the ported modules (selfhost/selfcheck.bit).
//     A failed assert panics (exit 2), so `zig build test` / the gate catches a
//     regression in any ported subsystem.
// The real front/middle/back ends land under this directory per the epic.
import { args } from "std/os"
import { readFile } from "std/fs"

// `--dump-tokens`: one line per token, `<kind> <start>..<end>`, including the
// synthesized ASI/eof semicolons and the final eof — matching the seed's
// tokensReport exactly.
function dumpTokens(path: string) {
  let src = readFile(path) catch e {
    print("bitc2: cannot read ")
    print(path)
    print("\n")
    return
  }
  let toks = lexAll(src)
  let i = 0
  while (i < len(toks)) {
    let t = toks[i]
    print("${kindName(t.kind)} ${t.start}..${t.end}\n")
    i = i + 1
  }
}

// `--dump-ast`: the parsed tree as an s-expression, matching the seed's
// `ast.dump` byte-for-byte (no trailing newline).
function dumpAstCmd(path: string) {
  let src = readFile(path) catch e {
    print("bitc2: cannot read ")
    print(path)
    print("\n")
    return
  }
  let tree = parseSource(src)
  print(dumpAst(tree, src))
}

// `--dump-diags`: run the front-end (lex + parse) and print the rendered
// diagnostics — empty for a clean file — matching the seed's frontend
// diagnostic output for the self-host error differential.
function dumpDiagsCmd(path: string) {
  let src = readFile(path) catch e {
    print("bitc2: cannot read ")
    print(path)
    print("\n")
    return
  }
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  parseSourceD(src, f, d)
  print(renderDiags(d))
}

// `--dump-types`: parse + type-check the file and print the binding/param/call
// type dump, matching the seed's `bitc --dump-types` for the self-host Stage-2
// differential.
function dumpTypesCmd(path: string) {
  let src = readFile(path) catch e {
    print("bitc2: cannot read ")
    print(path)
    print("\n")
    return
  }
  print(checkSourceDump(src))
}

// `--dump-ir`: parse + check + lower the file and print the SSA IR text,
// matching the seed's `bitc --dump-ir` for the self-host Stage-2 differential.
function dumpIrCmd(path: string) {
  let src = readFile(path) catch e {
    print("bitc2: cannot read ")
    print(path)
    print("\n")
    return
  }
  print(lowerSourceDump(src))
}

function main() {
  let a = args()
  // a[0] is the program name.
  if (len(a) >= 3 && a[1] == "--dump-tokens") {
    dumpTokens(a[2])
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-types") {
    dumpTypesCmd(a[2])
    return
  }
  // `--dump-ir` and `--dump-ir-pre` both render the raw lowering: bitc2 has no
  // optimizer yet, so pre- and post-opt IR are identical. The lowering
  // differential diffs `bitc2 --dump-ir-pre` against the seed's pre-opt IR.
  if (len(a) >= 3 && (a[1] == "--dump-ir" || a[1] == "--dump-ir-pre")) {
    dumpIrCmd(a[2])
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-ast") {
    dumpAstCmd(a[2])
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-diags") {
    dumpDiagsCmd(a[2])
    return
  }
  selfcheck()
  print("bitc2 (self-host, seed-built) ")
  print(selfhostVersion)
  print(" — selfcheck OK\n")
}
