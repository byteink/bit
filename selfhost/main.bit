// bit — the Bit-in-Bit compiler (self-host).
//
// Early driver. Two modes:
//   `bit --dump-tokens <file>` — lex the file and print the token stream in
//     the seed's exact format, so `bit --dump-tokens` diffs byte-for-byte
//     against `bit --dump-tokens` (the differential harness, #1332).
//   `bit build <file.bit> [-o out]` — compile a Bit program to a native,
//     ad-hoc-signed aarch64-macos executable, using nothing but this compiler:
//     parse -> check -> lower -> opt -> arm64 codegen -> Mach-O object -> link
//     -> sign. No seed compiler, no system toolchain.
//   `bit` (no args) — self-test the ported modules (selfhost/selfcheck.bit).
//     A failed assert panics (exit 2), so `zig build test` / the gate catches a
//     regression in any ported subsystem.
// The real front/middle/back ends land under this directory per the epic.
import { args, exit, envOr } from "std/os"
import { readFile, writeFile } from "std/fs"

// `--dump-tokens`: one line per token, `<kind> <start>..<end>`, including the
// synthesized ASI/eof semicolons and the final eof — matching the seed's
// tokensReport exactly.
function dumpTokens(path: string) {
  let src = readFile(path) catch e {
    print("bit: cannot read ")
    print(path)
    print("\n")
    return
  }
  let toks = lexAll(src)
  let i = 0
  while (i < len(toks)) {
    let t = toks[i]
    print("${kindName(t.kind)} ${t.start}..${t.end}\n")
    i = i + 1
  }
}

// `--dump-ast`: the parsed tree as an s-expression, matching the seed's
// `ast.dump` byte-for-byte (no trailing newline).
function dumpAstCmd(path: string) {
  let src = readFile(path) catch e {
    print("bit: cannot read ")
    print(path)
    print("\n")
    return
  }
  let tree = parseSource(src)
  print(dumpAst(tree, src))
}

// `--dump-diags`: run the front-end (lex + parse) and print the rendered
// diagnostics — empty for a clean file — matching the seed's frontend
// diagnostic output for the self-host error differential.
function dumpDiagsCmd(path: string) {
  let src = readFile(path) catch e {
    print("bit: cannot read ")
    print(path)
    print("\n")
    return
  }
  let sm = newSourceManager()
  let f = addFile(sm, path, src)
  let d = newDiagnostics(sm)
  parseSourceD(src, f, d)
  print(renderDiags(d))
}

// `check <file|dir>`: the front end only — load, parse, type-check, validate,
// and render any diagnostics to stderr, matching `bit check` byte for byte (the
// check differential diffs the two). Exit 1 iff anything was reported; silence
// and exit 0 for a clean module.
//
// The same pipeline `build` uses, deliberately: `check` IS build's front end, so
// anything it accepts or rejects here must be what a build would. A file and a
// directory are both modules (SPEC §17.1); a file's module is that one file.
function checkCmd(path: string): bool {
  let rootDir = path
  let rootOnly = ""
  if (!fsIsDir(path)) {
    rootDir = pathDir(path)
    rootOnly = pathBase(path)
  }
  let p = loadProject(rootDir, rootOnly, stdRootPath())
  if (p.root < 0 || len(p.mods) == 0) {
    eprint("bit check: not a module: ${path}\n")
    return false
  }
  // Parse errors first and alone — the checker would read a recovered tree's
  // holes as real nodes and pile noise on top of the cause.
  if (reportCheckErrors(p.diags)) {
    return false
  }
  checkProject(p)
  return !reportCheckErrors(p.diags)
}

// `--dump-types`: parse + type-check the file and print the binding/param/call
// type dump, matching the seed's `bit --dump-types` for the self-host Stage-2
// differential.
function dumpTypesCmd(path: string) {
  let src = readFile(path) catch e {
    print("bit: cannot read ")
    print(path)
    print("\n")
    return
  }
  print(checkSourceDump(src))
}

// `--dump-ir`: parse + check + lower the file and print the SSA IR text,
// matching the seed's `bit --dump-ir` for the self-host Stage-2 differential.
function dumpIrCmd(path: string, optimize: bool) {
  let src = readFile(path) catch e {
    print("bit: cannot read ")
    print(path)
    print("\n")
    return
  }
  if (optimize) {
    print(lowerSourceDumpOpt(src))
    return
  }
  print(lowerSourceDump(src))
}

function main() {
  let a = args()
  // a[0] is the program name.
  if (len(a) >= 3 && a[1] == "check") {
    if (checkCmd(a[2])) {
      return
    }
    exit(1)
    return
  }
  if (len(a) >= 3 && a[1] == "run") {
    exit(runCmd(a[2]))
    return
  }
  if (len(a) >= 3 && a[1] == "test") {
    exit(testCmd(a[2]))
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-tokens") {
    dumpTokens(a[2])
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-types") {
    dumpTypesCmd(a[2])
    return
  }
  // `--dump-ir-pre` renders the raw lowering; `--dump-ir` renders it after the
  // optimizer, matching the seed's two surfaces (#1338 / #1339 differentials).
  if (len(a) >= 3 && a[1] == "--dump-ir-pre") {
    dumpIrCmd(a[2], false)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-ir") {
    dumpIrCmd(a[2], true)
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-ast") {
    dumpAstCmd(a[2])
    return
  }
  if (len(a) >= 3 && a[1] == "--dump-diags") {
    dumpDiagsCmd(a[2])
    return
  }
  if (len(a) >= 2 && a[1] == "ar") {
    if (len(a) < 3) {
      print("usage: bit ar <out.a> <obj.o...> [--target x86_64-linux|aarch64-linux|aarch64-macos]\n")
      exit(2)
      return
    }
    if (!arCmd(a)) {
      exit(1)
    }
    return
  }
  if (len(a) >= 3 && a[1] == "build") {
    // Parse: one positional <src>, plus `-o <out>`, `--emit-obj` and
    // `--target <t>` in any order after it.
    let out = ""
    let emitObj = false
    let target = hostBuildTarget()
    let ai = 3
    while (ai < len(a)) {
      if (a[ai] == "-o" && ai + 1 < len(a)) {
        out = a[ai + 1]
        ai = ai + 2
      } else if (a[ai] == "--emit-obj" || a[ai] == "-c") {
        emitObj = true
        ai = ai + 1
      } else if ((a[ai] == "--target" || a[ai] == "-t") && ai + 1 < len(a)) {
        let ti = parseBuildTarget(a[ai + 1])
        if (ti < 0) {
          print("bit: unknown target '${a[ai + 1]}' (x86_64-linux | aarch64-linux | aarch64-macos)\n")
          exit(1)
          return
        }
        target = buildTargetOf(ti)
        ai = ai + 2
      } else {
        print("bit: unexpected argument '${a[ai]}'\n")
        exit(1)
        return
      }
    }
    if (out == "") {
      out = pathStem(a[2])
      if (emitObj) {
        out = out + ".o"
      }
    }
    let ok = false
    if (emitObj) {
      ok = buildObjCmd(a[2], out, target)
    } else {
      ok = buildCmd(a[2], out, target)
    }
    if (ok) {
      return
    }
    exit(1)
    return
  }
  selfcheck()
  print("bit (self-host, seed-built) ")
  print(selfhostVersion)
  print(" — selfcheck OK\n")
}

// A path's directory, or "." when it names a bare file in the cwd.
// "examples/hello.bit" -> "examples", "a.bit" -> ".". Mirrors the seed's
// `std.fs.path.dirname(src) orelse "."`.
function pathDir(path: string): string {
  let b = []byte(path)
  let cut = -1
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      cut = i
    }
    i = i + 1
  }
  if (cut < 0) {
    return "."
  }
  if (cut == 0) {
    return "/" // a path rooted at "/" has "/" as its directory
  }
  return path[0:cut]
}

// A path's final component. "examples/hello.bit" -> "hello.bit".
function pathBase(path: string): string {
  let b = []byte(path)
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      start = i + 1
    }
    i = i + 1
  }
  return path[start:len(path)]
}

// The module name / default output: a path's basename without its extension.
// "examples/hello.bit" -> "hello", "a.bit" -> "a".
function pathStem(path: string): string {
  let b = []byte(path)
  let start = 0
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(47)) { // '/'
      start = i + 1
    }
    i = i + 1
  }
  let end = len(b)
  i = start
  while (i < len(b)) {
    if (b[i] == u8(46)) { // '.'
      end = i
    }
    i = i + 1
  }
  return string(b[start:end])
}

// The native binary target `build` produces. `--target` cross-produces the
// others, which only their own host can execute.
enum BuildTarget {
  X86_64Linux,
  Aarch64Linux,
  Aarch64Macos,
}

// The BuildTarget named by a triple, or -1. Bit has no int->enum cast, so this
// returns an ordinal that buildTargetOf maps back (see elfLoKindIndex for the
// same shape); the round-trip is asserted in selfcheck.
function parseBuildTarget(s: string): int {
  if (s == "x86_64-linux") { return 0 }
  if (s == "aarch64-linux" || s == "arm64-linux") { return 1 }
  if (s == "aarch64-macos" || s == "arm64-macos") { return 2 }
  return -1
}

function buildTargetOf(i: int): BuildTarget {
  if (i == 0) { return BuildTarget.X86_64Linux }
  if (i == 1) { return BuildTarget.Aarch64Linux }
  return BuildTarget.Aarch64Macos
}

function buildTargetIndex(t: BuildTarget): int {
  if (t == BuildTarget.X86_64Linux) { return 0 }
  if (t == BuildTarget.Aarch64Linux) { return 1 }
  return 2
}

// The default `build` target: the host this bit binary runs on. Bit has no
// compile-time `builtin.target` (the seed's source), so the ordinal comes from
// `hostTarget()` — a runtime primitive baked into the per-target libbitrt this
// binary is linked against. Correct on any host, so `bit build` needs no
// `--target` on its native platform (the #365 requirement).
function hostBuildTarget(): BuildTarget {
  return buildTargetOf(hostTarget())
}

function isMachoTarget(t: BuildTarget): bool {
  return t == BuildTarget.Aarch64Macos
}

// The ELF target for a Linux BuildTarget. Only ever called for one.
function elfTargetOf(t: BuildTarget): ElfTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfTarget.X86_64
  }
  return ElfTarget.Aarch64
}

function elfLinkTargetOf(t: BuildTarget): ElfLinkTarget {
  if (t == BuildTarget.X86_64Linux) {
    return ElfLinkTarget.X86_64Linux
  }
  return ElfLinkTarget.Aarch64Linux
}

function buildTargetName(t: BuildTarget): string {
  if (t == BuildTarget.X86_64Linux) { return "x86_64-linux" }
  if (t == BuildTarget.Aarch64Linux) { return "aarch64-linux" }
  return "aarch64-macos"
}

// Builds `src`'s IR. A directory and a lone file are both modules (SPEC §17.1),
// so both take the same project pipeline and both get the stdlib and its
// prelude; a file differs only in that its module holds exactly that one file,
// never its siblings. Mirrors the seed's `runBuild` — building a lone file as a
// self-contained module instead is what made `println` undefined there.
// E0078 (§11.7): an `extern function` resolves against a dylib at load time, and
// only the aarch64-macos output links against one — the Linux output is fully
// static, so an undefined symbol there is an unresolvable link failure. Reject it
// up front with a real diagnostic instead of failing deep inside the linker.
//
// The gate lives here rather than in the checker because the checker is
// deliberately target-independent (it runs once and its output feeds every
// backend); this is the first point where the selected target and the AST are
// both in hand. Mirrors the seed's rejectExternForTarget.
function rejectExternForTarget(p: Project, target: BuildTarget): bool {
  if (target == BuildTarget.Aarch64Macos) { return false }
  let found = false
  let mi = 0
  while (mi < len(p.mods)) {
    let m = p.mods[mi]
    // A module's files are concatenated, so every tree span is module-global.
    // Mark the sink, report, then map this module's new spans back onto the file
    // each one's text actually came from — exactly what the loader does.
    let before = len(p.diags.list)
    for top of kidsOf(m.tree, m.tree.root) {
      if (top == 0) { continue }
      let inner = top
      if (getNode(m.tree, top).tag == Tag.Export) {
        inner = kidsOf(m.tree, top)[0]
      }
      if (getNode(m.tree, inner).tag != Tag.ExternFnDecl) { continue }
      report(p.diags, ecExternUnsupportedTarget, getNode(m.tree, inner).span,
        "'extern function' is not supported for target ${buildTargetName(target)}",
        "only aarch64-macos links against a dylib; the Linux output is fully static")
      found = true
    }
    remapDiags(p.diags, before, m.files, m.fileStarts)
    mi = mi + 1
  }
  return found
}

function buildIr(src: string, target: BuildTarget): IrModule! {
  let rootDir = src
  let rootOnly = ""
  if (!fsIsDir(src)) {
    rootDir = pathDir(src)
    rootOnly = pathBase(src)
  }
  let p = loadProject(rootDir, rootOnly, stdRootPath())
  if (p.root < 0 || len(p.mods) == 0) {
    fail newError("not a module: ${src}")
  }
  // Lex/parse errors first and alone: a tree the parser recovered through has
  // holes the checker reads as real nodes, so its errors would be noise on top
  // of the ones that caused them. The seed stops here for the same reason.
  if (reportCheckErrors(p.diags)) {
    fail newError("check failed")
  }
  let mods = checkProject(p)
  // The target gate reports into the same sink, so an E0078 renders beside any
  // check error rather than after a second, separate failure.
  rejectExternForTarget(p, target)
  if (reportCheckErrors(p.diags)) {
    fail newError("check failed")
  }
  return lowerProject(mods, p.root)
}

// Compiles `src` to a relocatable OBJECT at `out` (#1397): no `main` required,
// no entry trampoline, no runtime archive read, nothing linked. This is the
// half of the toolchain that feeds `bit ar`. Returns false on any failure
// (already reported).
function buildObjCmd(src: string, out: string, target: BuildTarget): bool {
  let module = buildIr(src) catch e {
    print("bit: ${src}: ${e.message()}\n")
    return false
  }
  // Same refusal as writeModuleExe: a signature-only stub computes nothing, so
  // an object containing one would silently link into a wrong program.
  if (len(module.stubbed) > 0) {
    print("bit: ${src}: cannot lower ${len(module.stubbed)} function(s); refusing to emit an object\n")
    for nm of module.stubbed {
      print("  ${nm}\n")
    }
    return false
  }
  let obj = []u8(0)
  if (isMachoTarget(target)) {
    obj = emitMachoObject(module, false) catch e {
      print("bit: ${src}: ${e.message()}\n")
      return false
    }
  } else {
    obj = emitElfObject(module, elfTargetOf(target), false) catch e {
      print("bit: ${src}: ${e.message()}\n")
      return false
    }
  }
  writeFile(out, string(obj)) catch e {
    print("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  return true
}

// Compiles `src` (a file or a project directory) to a native executable at
// `out`. Returns false on any failure (already reported).
function buildCmd(src: string, out: string, target: BuildTarget): bool {
  let module = buildIr(src, target) catch e {
    print("bit: ${src}: ${e.message()}\n")
    return false
  }
  return writeModuleExe(module, src, out, target)
}

// Emits, links, and writes a lowered module to a native executable at `out`.
// Split out of buildCmd so `bit test` can inject its synthetic `main` into the
// module first. Returns false on any failure (already reported).
function writeModuleExe(module: IrModule, src: string, out: string, target: BuildTarget): bool {
  let rt = readFile(libbitrtPath(target)) catch e {
    print("bit: runtime archive ${libbitrtPath(target)}: ${e.message()}\n")
    return false
  }
  // A signature-only stub computes nothing and returns garbage. Emitting one
  // would hand back a binary that silently gives wrong answers, so refuse — the
  // construct it choked on has to be reported, not shipped.
  if (len(module.stubbed) > 0) {
    print("bit: ${src}: cannot lower ${len(module.stubbed)} function(s); refusing to emit a binary\n")
    for nm of module.stubbed {
      print("  ${nm}\n")
    }
    return false
  }
  // Mach-O and ELF differ in every layer below here: the object format, the
  // static-data placement (dyld-rebased __data vs read-only .rodata), and the
  // linker's image. The backend follows the target too — an ELF x86_64-linux
  // build is what drives x64.bit.
  let exe = []u8(0)
  if (isMachoTarget(target)) {
    let obj = emitMachoObject(module, true) catch e {
      print("bit: ${src}: ${e.message()}\n")
      return false
    }
    exe = linkMacho([meObjectInput(obj), meArchiveInput([]byte(rt))],
      pathStem(out)) catch e {
      print("bit: link ${out}: ${e.message()}\n")
      return false
    }
  } else {
    let obj = emitElfObject(module, elfTargetOf(target), true) catch e {
      print("bit: ${src}: ${e.message()}\n")
      return false
    }
    exe = linkElfExecutable(elfLinkTargetOf(target),
      [ElfLinkInput{ isArchive: false, bytes: obj },
       ElfLinkInput{ isArchive: true, bytes: []byte(rt) }]) catch e {
      print("bit: link ${out}: ${e.message()}\n")
      return false
    }
  }
  writeFile(out, string(exe)) catch e {
    print("bit: cannot write ${out}: ${e.message()}\n")
    return false
  }
  // A binary the kernel refuses to exec is not a build. writeFile leaves 0o644.
  if (fsChmod(out, 493) != 0) { // 0o755
    print("bit: cannot make ${out} executable\n")
    return false
  }
  return true
}

// `bit run <src>`: build for the host, launch the binary, and exit with its
// exit code. Builds to a fixed /tmp path keyed by the source stem (the seed's
// scheme); two concurrent runs of a same-named file would collide, which no
// build ever does. Returns the child's exit code, or 1 if the build failed.
function runCmd(src: string): int {
  let tmp = "/tmp/bit-run-${pathStem(src)}"
  if (!buildCmd(src, tmp, hostBuildTarget())) {
    return 1
  }
  let code = osRun(tmp)
  // Best-effort cleanup; a leftover temp binary is harmless, so ignore errors.
  fsRemove(tmp)
  if (code < 0) {
    print("bit: could not run ${tmp}\n")
    return 1
  }
  return code
}

// `bit test <file|dir>`: discover the root module's `test_*` functions, build a
// single binary whose synthetic `main` dispatches by BIT_TEST_INDEX, then exec it
// once per test (a failing `assert` panics and takes its process, so one process
// per test keeps the failure attributable). Prints ok/FAIL per test + a summary;
// exit 0 iff every test passed. Always builds for the host — a cross-compiled
// test binary could not be run here. Output format matches the seed's runTest.
function testCmd(src: string): int {
  // Always the host target: a cross-compiled test binary could not be run here.
  let module = buildIr(src, hostBuildTarget()) catch e {
    print("bit: ${src}: ${e.message()}\n")
    return 1
  }
  if (len(module.stubbed) > 0) {
    print("bit: ${src}: cannot lower ${len(module.stubbed)} function(s); refusing to run tests\n")
    return 1
  }
  let names = injectTestMain(module)
  if (len(names) == 0) {
    print("no tests in ${src} (a test is a top-level `function test_<name>()`)\n")
    return 0
  }
  let tmp = "/tmp/bit-test-${pathStem(src)}"
  if (!writeModuleExe(module, src, tmp, hostBuildTarget())) {
    return 1
  }
  let passed = 0
  let i = 0
  while (i < len(names)) {
    let code = osRunTest(tmp, i)
    if (code == 0) {
      passed = passed + 1
      print("ok   ${names[i]}\n")
    } else {
      print("FAIL ${names[i]}\n")
    }
    i = i + 1
  }
  fsRemove(tmp)
  let failed = len(names) - passed
  let plural = "s"
  if (len(names) == 1) {
    plural = ""
  }
  print("\n${len(names)} test${plural}: ${passed} passed, ${failed} failed\n")
  if (failed == 0) {
    return 0
  }
  return 1
}

// `bit ar <out.a> <obj...> [--target t]`: bundles already-emitted relocatable
// objects into an `ar` archive (#1398) — the `ar rcs` half of the toolchain
// that `bit build --emit-obj` feeds. The name encoding follows the target's own
// convention (BSD for Mach-O, GNU for ELF), which is what parseArchive and every
// platform `ar` expect. Each member is named by its file's basename. `a` is the
// whole argv, so a[2] is the output and a[3..] the inputs.
function arCmd(a: []string): bool {
  let out = a[2]
  let members = []ArMember(0)
  let target = hostBuildTarget()
  let ai = 3
  while (ai < len(a)) {
    if ((a[ai] == "--target" || a[ai] == "-t") && ai + 1 < len(a)) {
      let ti = parseBuildTarget(a[ai + 1])
      if (ti < 0) {
        print("bit ar: unknown target '${a[ai + 1]}'\n")
        return false
      }
      target = buildTargetOf(ti)
      ai = ai + 2
      continue
    }
    let data = readFile(a[ai]) catch e {
      print("bit ar: ${a[ai]}: ${e.message()}\n")
      return false
    }
    members = append(members, ArMember{ name: pathBase(a[ai]), data: []byte(data) })
    ai = ai + 1
  }
  if (len(members) == 0) {
    print("bit ar: no input objects\n")
    return false
  }
  let format = arFormatGnu()
  if (isMachoTarget(target)) {
    format = arFormatBsd()
  }
  writeFile(out, string(writeArchive(members, format))) catch e {
    print("bit ar: cannot write ${out}: ${e.message()}\n")
    return false
  }
  return true
}

// The runtime archive this compiler links against, per target. Overridable so a
// build tree that keeps it elsewhere still works, matching the seed's
// BIT_LIBBITRT — though an override names ONE archive, so it only makes sense
// alongside a matching --target.
function libbitrtPath(target: BuildTarget): string {
  return envOr("BIT_LIBBITRT", "zig-out/lib/${buildTargetName(target)}/libbitrt.a")
}

// Where `std/*` imports resolve. ponytail: cwd-relative dev-build path, the same
// bargain (and the same fix) as libbitrtPath — resolve against the binary's
// install prefix once packaging lands. The seed's `stdlib_dir` is identical, so
// both compilers find the same stdlib when run from the project root.
function stdRootPath(): string {
  return envOr("BIT_STDLIB", "stdlib")
}
