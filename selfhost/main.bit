// bitc2 — the Bit-in-Bit compiler (self-host).
//
// Stub driver: it only proves the seed `bitc` compiles and runs a selfhost/
// project end-to-end (multi-file module + prelude). The real front-end, middle-
// end, and backend land under this directory per the self-host epic (#1333+),
// each differential-tested byte-for-byte against the Zig compiler.
function main() {
  // Until the real driver lands (#1345), bitc2 self-tests the ported modules:
  // a failed assert panics (exit 2), so `zig build test` / the gate catches any
  // regression in a ported subsystem.
  selfcheck()
  print("bitc2 (self-host, seed-built) ")
  print(selfhostVersion)
  print(" — selfcheck OK\n")
}
