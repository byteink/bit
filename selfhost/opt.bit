// Self-host Stage 2 (#1339): optimizer passes, ported from compiler/opt.zig.
// Runs immediately before codegen; `bit2 --dump-ir` renders the result and must
// byte-match the seed's optimized `bit --dump-ir`.
//
// ## Rebuild, don't mutate
//
// `IrFunc`'s core invariant — instruction index == value id, and each block's
// instructions are contiguous in emission order — makes deleting an instruction
// in place illegal: it would shift every later index and silently corrupt every
// operand reference that follows. Every pass instead REBUILDS the function
// through the lowering builder, walking the old function once (already
// def-before-use) and translating each surviving value through an old-index ->
// new-id `remap` table, exactly the construction lower.bit itself uses.
//
// ## Passes
//
// - `foldConstantsAndPrune`: one forward sweep records each value's
//   compile-time constant (propagating through folded arithmetic/compares); a
//   bounded BFS then uses constant branch conditions to find the reachable
//   blocks; the rebuild reserves only reachable blocks and turns a resolved `br`
//   into a plain `jump`. Folding, propagation, and dead-branch/dead-block
//   pruning all fall out of the one rebuild.
//
// Every pass is one bounded, non-recursive walk over already-known-size arrays;
// no pass loops to a fixpoint.

// A value known at compile time. `ival` holds the raw 64-bit pattern exactly as
// `IrInstr.ival` stores it — width and signedness come from the value's own
// type, not from here (the IR's "store bits, reinterpret per type" convention).
// Bit has no tagged union, so `known`/`isFloat`/`isBool` discriminate.
struct ConstVal {
  known: bool,
  isFloat: bool,
  isBool: bool,
  ival: int,
  fval: f64,
  bval: bool,
}

function noConst(): ConstVal {
  return ConstVal{ known: false, isFloat: false, isBool: false, ival: 0, fval: 0.0, bval: false }
}

function intConst(v: int): ConstVal {
  return ConstVal{ known: true, isFloat: false, isBool: false, ival: v, fval: 0.0, bval: false }
}

function floatConst(v: f64): ConstVal {
  return ConstVal{ known: true, isFloat: true, isBool: false, ival: 0, fval: v, bval: false }
}

function boolConst(v: bool): ConstVal {
  return ConstVal{ known: true, isFloat: false, isBool: true, ival: 0, fval: 0.0, bval: v }
}

// The prim index of a type, or -1 when it is not a primitive.
function primOfType(ctx: TypeContext, ty: int): int {
  if (ctx.types[ty].kind != TypeKind.Prim) {
    return -1
  }
  return ctx.types[ty].prim
}

// Prim indices: 0=i8 1=i16 2=i32 3=i64 4=u8 5=u16 6=u32 7=u64 8=f32 9=f64
// 10=bool 11=string.
function primBits(p: int): int {
  if (p == 0 || p == 4) { return 8 }
  if (p == 1 || p == 5) { return 16 }
  if (p == 2 || p == 6) { return 32 }
  return 64
}

function isSignedPrim(p: int): bool {
  return p >= 0 && p <= 3
}

function isIntPrim(p: int): bool {
  return p >= 0 && p <= 7
}

function isFloatPrim(p: int): bool {
  return p == 8 || p == 9
}

function minI64(): int {
  // Written as MAX-negated-minus-one: the literal -9223372036854775808 would
  // have to parse its magnitude as a positive i64 first, which overflows.
  return -9223372036854775807 - 1
}

function maxI64(): int {
  return 9223372036854775807
}

// Keeps only the low `bits` bits of `raw`, zeroing the rest — the IR's canonical
// unsigned storage form for a `bits`-wide value.
function maskTo(raw: int, bits: int): int {
  if (bits >= 64) {
    return raw
  }
  return raw & ((1 << bits) - 1)
}

// Reinterprets `raw`'s low `bits` bits as a signed, sign-extended value. `>>` on
// a signed int is an arithmetic shift, which does the extension.
function signExtend(raw: int, bits: int): int {
  if (bits >= 64) {
    return raw
  }
  let shift = 64 - bits
  return (raw << shift) >> shift
}

// Whether `a + b` would overflow a signed 64-bit result. Checked BEFORE the add
// so the addition itself never overflows (§13.5 leaves signed overflow
// build-mode dependent; the optimizer must never rely on it).
function addOverflows64(a: int, b: int): bool {
  if (b > 0 && a > maxI64() - b) {
    return true
  }
  return b < 0 && a < minI64() - b
}

function subOverflows64(a: int, b: int): bool {
  if (b < 0 && a > maxI64() + b) {
    return true
  }
  return b > 0 && a < minI64() + b
}

function mulOverflows64(a: int, b: int): bool {
  if (a == 0 || b == 0) {
    return false
  }
  // MIN * -1 is the one product whose magnitude escapes the range symmetrically;
  // check it before any division (MIN / -1 would itself overflow).
  if (a == -1) {
    return b == minI64()
  }
  if (b == -1) {
    return a == minI64()
  }
  if (a > 0) {
    if (b > 0) {
      return a > maxI64() / b
    }
    return b < minI64() / a
  }
  if (b > 0) {
    return a < minI64() / b
  }
  return a < maxI64() / b
}

// Folds `add`/`sub`/`mul`. Unsigned always wraps modularly (§13.5: no trap
// possible). Signed only folds when the exact result fits the type's range — an
// out-of-range result is left as a runtime op so it keeps trapping in debug /
// wrapping in release exactly as before (folding never changes behavior).
function foldAddSubMul(op: Op, bits: int, signed: bool, aRaw: int, bRaw: int): ConstVal {
  if (!signed) {
    // Wrap in u64 (modular, never traps), then narrow to the type's width.
    let ua = u64(maskTo(aRaw, bits))
    let ub = u64(maskTo(bRaw, bits))
    let r = ua + ub
    if (op == Op.Sub) {
      r = ua - ub
    } else if (op == Op.Mul) {
      r = ua * ub
    }
    return intConst(maskTo(i64(r), bits))
  }
  let a = signExtend(aRaw, bits)
  let b = signExtend(bRaw, bits)
  // A sub-64-bit operand pair can never overflow the i64 the math runs in, so
  // only the range check below applies; at 64 bits the op itself could overflow,
  // so it is pre-checked and left unfolded.
  if (bits >= 64) {
    if (op == Op.Add && addOverflows64(a, b)) {
      return noConst()
    }
    if (op == Op.Sub && subOverflows64(a, b)) {
      return noConst()
    }
    if (op == Op.Mul && mulOverflows64(a, b)) {
      return noConst()
    }
  }
  let wide = a + b
  if (op == Op.Sub) {
    wide = a - b
  } else if (op == Op.Mul) {
    wide = a * b
  }
  if (bits < 64) {
    let lim = 1 << (bits - 1)
    if (wide < -lim || wide > lim - 1) {
      return noConst()
    }
  }
  return intConst(maskTo(wide, bits))
}

// Folds `sdiv`/`srem`. Divide-by-zero and `MIN / -1` (the one signed division
// that overflows) both always panic (§13.5) — left unfolded so the trap still
// happens at runtime.
function foldSignedDivRem(op: Op, bits: int, aRaw: int, bRaw: int): ConstVal {
  let a = signExtend(aRaw, bits)
  let b = signExtend(bRaw, bits)
  if (b == 0) {
    return noConst()
  }
  let minVal = minI64()
  if (bits < 64) {
    minVal = -(1 << (bits - 1))
  }
  if (op == Op.SDiv && a == minVal && b == -1) {
    return noConst()
  }
  if (op == Op.SDiv) {
    return intConst(maskTo(a / b, bits))
  }
  return intConst(maskTo(a % b, bits))
}

// Folds `udiv`/`urem`. Divide-by-zero always panics (§13.5) — left unfolded;
// every other unsigned division is total, no trap possible.
function foldUnsignedDivRem(op: Op, bits: int, aRaw: int, bRaw: int): ConstVal {
  let a = u64(maskTo(aRaw, bits))
  let b = u64(maskTo(bRaw, bits))
  if (b == u64(0)) {
    return noConst()
  }
  if (op == Op.UDiv) {
    return intConst(i64(a / b))
  }
  return intConst(i64(a % b))
}

// Folds `shl`/`lshr`/`ashr`. Always total: §13.5 defines the shift count as
// taken modulo the operand bit width, so no trap is ever possible.
function foldShift(op: Op, bits: int, aRaw: int, bRaw: int): ConstVal {
  // The count is the raw operand mod the width; it is a bit pattern, so read it
  // unsigned before the modulo.
  let shift = i64(u64(bRaw) % u64(bits))
  if (op == Op.Shl) {
    return intConst(maskTo(maskTo(aRaw, bits) << shift, bits))
  }
  if (op == Op.LShr) {
    // Logical: `>>` on u64 does not sign-extend.
    return intConst(i64(u64(maskTo(aRaw, bits)) >> u64(shift)))
  }
  return intConst(maskTo(signExtend(aRaw, bits) >> shift, bits))
}

function foldBinaryArith(ctx: TypeContext, op: Op, ty: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let p = primOfType(ctx, ty)
  if (p < 0) {
    return noConst()
  }
  if (isFloatPrim(p)) {
    if (op == Op.FAdd) { return floatConst(lhs.fval + rhs.fval) }
    if (op == Op.FSub) { return floatConst(lhs.fval - rhs.fval) }
    if (op == Op.FMul) { return floatConst(lhs.fval * rhs.fval) }
    if (op == Op.FDiv) { return floatConst(lhs.fval / rhs.fval) }
    return noConst()
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  let signed = isSignedPrim(p)
  if (op == Op.Add || op == Op.Sub || op == Op.Mul) {
    return foldAddSubMul(op, bits, signed, lhs.ival, rhs.ival)
  }
  if (op == Op.SDiv || op == Op.SRem) {
    if (!signed) {
      return noConst()
    }
    return foldSignedDivRem(op, bits, lhs.ival, rhs.ival)
  }
  if (op == Op.UDiv || op == Op.URem) {
    if (signed) {
      return noConst()
    }
    return foldUnsignedDivRem(op, bits, lhs.ival, rhs.ival)
  }
  if (op == Op.BAnd || op == Op.BOr || op == Op.BXor) {
    let a = maskTo(lhs.ival, bits)
    let b = maskTo(rhs.ival, bits)
    if (op == Op.BAnd) { return intConst(maskTo(a & b, bits)) }
    if (op == Op.BOr) { return intConst(maskTo(a | b, bits)) }
    return intConst(maskTo(a ^ b, bits))
  }
  if (op == Op.Shl || op == Op.LShr || op == Op.AShr) {
    return foldShift(op, bits, lhs.ival, rhs.ival)
  }
  return noConst()
}

// Compares fold against the OPERAND's type (the result is always bool).
function foldCompare(ctx: TypeContext, op: Op, operandTy: int, lhs: ConstVal, rhs: ConstVal): ConstVal {
  let p = primOfType(ctx, operandTy)
  if (p < 0) {
    return noConst()
  }
  if (p == 10) {
    if (op == Op.ICmpEq) { return boolConst(lhs.bval == rhs.bval) }
    if (op == Op.ICmpNe) { return boolConst(lhs.bval != rhs.bval) }
    return noConst()
  }
  if (isFloatPrim(p)) {
    if (op == Op.FCmpEq) { return boolConst(lhs.fval == rhs.fval) }
    if (op == Op.FCmpNe) { return boolConst(lhs.fval != rhs.fval) }
    if (op == Op.FCmpLt) { return boolConst(lhs.fval < rhs.fval) }
    if (op == Op.FCmpLe) { return boolConst(lhs.fval <= rhs.fval) }
    if (op == Op.FCmpGt) { return boolConst(lhs.fval > rhs.fval) }
    if (op == Op.FCmpGe) { return boolConst(lhs.fval >= rhs.fval) }
    return noConst()
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  if (isSignedPrim(p)) {
    let a = signExtend(lhs.ival, bits)
    let b = signExtend(rhs.ival, bits)
    if (op == Op.ICmpEq) { return boolConst(a == b) }
    if (op == Op.ICmpNe) { return boolConst(a != b) }
    if (op == Op.ICmpSlt) { return boolConst(a < b) }
    if (op == Op.ICmpSle) { return boolConst(a <= b) }
    if (op == Op.ICmpSgt) { return boolConst(a > b) }
    if (op == Op.ICmpSge) { return boolConst(a >= b) }
    return noConst()
  }
  let a = u64(maskTo(lhs.ival, bits))
  let b = u64(maskTo(rhs.ival, bits))
  if (op == Op.ICmpEq) { return boolConst(a == b) }
  if (op == Op.ICmpNe) { return boolConst(a != b) }
  if (op == Op.ICmpUlt) { return boolConst(a < b) }
  if (op == Op.ICmpUle) { return boolConst(a <= b) }
  if (op == Op.ICmpUgt) { return boolConst(a > b) }
  if (op == Op.ICmpUge) { return boolConst(a >= b) }
  return noConst()
}

function foldUnary(ctx: TypeContext, op: Op, ty: int, v: ConstVal): ConstVal {
  let p = primOfType(ctx, ty)
  if (p < 0) {
    return noConst()
  }
  if (op == Op.FNeg) {
    return floatConst(-v.fval)
  }
  if (!isIntPrim(p)) {
    return noConst()
  }
  let bits = primBits(p)
  if (op == Op.BNot) {
    return intConst(maskTo(~maskTo(v.ival, bits), bits))
  }
  if (op != Op.Neg) {
    return noConst()
  }
  if (isSignedPrim(p)) {
    let a = signExtend(v.ival, bits)
    let minVal = minI64()
    if (bits < 64) {
      minVal = -(1 << (bits - 1))
    }
    // Negating MIN overflows: preserve the trap.
    if (a == minVal) {
      return noConst()
    }
    return intConst(maskTo(-a, bits))
  }
  return intConst(maskTo(i64(u64(0) - u64(maskTo(v.ival, bits))), bits))
}

function opIsCompare(op: Op): bool {
  return int(op) >= int(Op.ICmpEq) && int(op) <= int(Op.FCmpGe)
}

function opIsArith(op: Op): bool {
  return int(op) >= int(Op.Add) && int(op) <= int(Op.LShr)
}

// Single forward sweep over every instruction: records each constant literal,
// then folds each binary/unary op whose operands are already known — cascading
// propagation for free, since the flat order guarantees an operand's def index
// is always less than its use's.
function analyzeConsts(ctx: TypeContext, f: IrFunc): []ConstVal {
  let known = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    known = append(known, noConst())
    i = i + 1
  }
  i = 0
  while (i < len(f.instrs)) {
    let ins = f.instrs[i]
    let op = ins.op
    if (op == Op.ConstInt) {
      known[i] = intConst(ins.ival)
    } else if (op == Op.ConstFloat) {
      known[i] = floatConst(ins.fval)
    } else if (op == Op.ConstBool) {
      known[i] = boolConst(ins.bval)
    } else if (opIsArith(op) || opIsCompare(op)) {
      let lv = known[ins.lhs]
      let rv = known[ins.rhs]
      if (lv.known && rv.known) {
        if (opIsCompare(op)) {
          known[i] = foldCompare(ctx, op, f.instrs[ins.lhs].ty, lv, rv)
        } else {
          known[i] = foldBinaryArith(ctx, op, ins.ty, lv, rv)
        }
      }
    } else if (op == Op.Neg || op == Op.FNeg || op == Op.BNot) {
      let v = known[ins.lhs]
      if (v.known) {
        known[i] = foldUnary(ctx, op, ins.ty, v)
      }
    }
    i = i + 1
  }
  return known
}

// Bounded BFS from the entry block (the worklist is sized to the block count and
// each block is enqueued at most once). A `br` whose condition folded to a known
// constant only follows the taken edge — this is what prunes an unreachable
// branch's whole block, not just its instructions.
function computeReachable(f: IrFunc, known: []ConstVal): []bool {
  let n = len(f.blocks)
  let reachable = []bool(0)
  let i = 0
  while (i < n) {
    reachable = append(reachable, false)
    i = i + 1
  }
  if (n == 0) {
    return reachable
  }
  // The entry block is block 0 (lowering opens it first, so it starts at 0).
  let queue = [0]
  reachable[0] = true
  let head = 0
  while (head < len(queue)) {
    let b = f.blocks[queue[head]]
    let term = f.instrs[b.instsStart + b.instsLen - 1]
    if (term.op == Op.Jump) {
      if (!reachable[term.ival]) {
        reachable[term.ival] = true
        queue = append(queue, term.ival)
      }
    } else if (term.op == Op.Br) {
      let cond = known[term.lhs]
      if (cond.known) {
        let target = term.ival2
        if (cond.bval) {
          target = term.ival
        }
        if (!reachable[target]) {
          reachable[target] = true
          queue = append(queue, target)
        }
      } else {
        if (!reachable[term.ival]) {
          reachable[term.ival] = true
          queue = append(queue, term.ival)
        }
        if (!reachable[term.ival2]) {
          reachable[term.ival2] = true
          queue = append(queue, term.ival2)
        }
      }
    }
    head = head + 1
  }
  return reachable
}

// Translates a value-id list through `remap`.
function trList(remap: []int, olds: []int): []int {
  let out = []int(0)
  let i = 0
  while (i < len(olds)) {
    out = append(out, remap[olds[i]])
    i = i + 1
  }
  return out
}

// Emits a constant instruction for an already-known value.
function emitConst(b: IrBuilder, kv: ConstVal, ty: int): int {
  if (kv.isBool) {
    let ins = mkInstr(Op.ConstBool, ty)
    ins.bval = kv.bval
    return builderEmit(b, ins)
  }
  if (kv.isFloat) {
    let ins = mkInstr(Op.ConstFloat, ty)
    ins.fval = kv.fval
    return builderEmit(b, ins)
  }
  let ins = mkInstr(Op.ConstInt, ty)
  ins.ival = kv.ival
  return builderEmit(b, ins)
}

// Emits instruction `idx` of `f` into `b`, translating operands through `remap`
// (old value id -> new) and block targets through `blockMap`. A known value
// emits the equivalent constant instead of the original op (constant folding); a
// `br` whose condition is known collapses to a `jump` on the taken edge
// (dead-branch pruning).
function emitTranslated(b: IrBuilder, f: IrFunc, known: []ConstVal, remap: []int,
  blockMap: []int, idx: int) {
  let ins = f.instrs[idx]
  let op = ins.op
  if (known[idx].known) {
    remap[idx] = emitConst(b, known[idx], ins.ty)
    return
  }
  // A terminator carries no result, so it is emitted (never remapped) below.
  if (op == Op.Jump) {
    let j = mkInstr(Op.Jump, ins.ty)
    j.ival = blockMap[ins.ival]
    j.args = trList(remap, ins.args)
    builderEmit(b, j)
    return
  }
  if (op == Op.Br) {
    let cond = known[ins.lhs]
    if (cond.known) {
      let target = ins.ival2
      let targs = ins.elseArgs
      if (cond.bval) {
        target = ins.ival
        targs = ins.thenArgs
      }
      let j = mkInstr(Op.Jump, ins.ty)
      j.ival = blockMap[target]
      j.args = trList(remap, targs)
      builderEmit(b, j)
      return
    }
    let br = mkInstr(Op.Br, ins.ty)
    br.lhs = remap[ins.lhs]
    br.ival = blockMap[ins.ival]
    br.thenArgs = trList(remap, ins.thenArgs)
    br.ival2 = blockMap[ins.ival2]
    br.elseArgs = trList(remap, ins.elseArgs)
    builderEmit(b, br)
    return
  }
  // Every other op: copy the record, translating the fields its shape uses.
  let n = mkInstr(op, ins.ty)
  n.ival = ins.ival
  n.ival2 = ins.ival2
  n.fval = ins.fval
  n.bval = ins.bval
  n.sval = ins.sval
  n.name = ins.name
  n.offsets = ins.offsets
  n.args = trList(remap, ins.args)
  if (opUsesLhs(op)) {
    n.lhs = remap[ins.lhs]
  }
  if (opUsesRhs(op)) {
    n.rhs = remap[ins.rhs]
  }
  // `index_set %base[%index] = %value` is the one op whose `ival` holds a VALUE
  // id rather than an immediate, so it needs translating too.
  if (op == Op.IndexSet) {
    n.ival = remap[ins.ival]
  }
  remap[idx] = builderEmit(b, n)
}

// Ops that can trap, allocate, or write observable state — never dead, and the
// roots of the liveness sweep along with terminators and block params. `index_get`
// is included: its bounds check can panic.
function isSideEffecting(op: Op): bool {
  return op == Op.Call || op == Op.CallValue || op == Op.CallIface || op == Op.RtCall ||
    op == Op.FieldSet || op == Op.IndexSet || op == Op.IndexGet || op == Op.GcAlloc ||
    op == Op.MakeClosure || op == Op.SDiv || op == Op.UDiv || op == Op.SRem || op == Op.URem ||
    opIsTerminator(op)
}

function opIsTerminator(op: Op): bool {
  return op == Op.Jump || op == Op.Br || op == Op.Ret || op == Op.Unreachable
}

// Marks every value `id` reads as live. Consts, block params, gc_alloc,
// type_info and func_addr read nothing (their operands are all immediates).
function markOperandsLive(f: IrFunc, live: []bool, id: int) {
  let ins = f.instrs[id]
  let op = ins.op
  if (opIsBinary(op)) {
    live[ins.lhs] = true
    live[ins.rhs] = true
    return
  }
  if (op == Op.Neg || op == Op.FNeg || op == Op.BNot || op == Op.Convert ||
    op == Op.FieldGet || op == Op.SliceLen || op == Op.MakeClosure) {
    live[ins.lhs] = true
    return
  }
  if (op == Op.Jump || op == Op.Ret || op == Op.Call || op == Op.RtCall) {
    markListLive(live, ins.args)
    return
  }
  if (op == Op.Br) {
    live[ins.lhs] = true
    markListLive(live, ins.thenArgs)
    markListLive(live, ins.elseArgs)
    return
  }
  if (op == Op.CallValue || op == Op.CallIface) {
    live[ins.lhs] = true
    markListLive(live, ins.args)
    return
  }
  if (op == Op.FieldSet || op == Op.IndexGet) {
    live[ins.lhs] = true
    live[ins.rhs] = true
    return
  }
  if (op == Op.IndexSet) {
    live[ins.lhs] = true
    live[ins.rhs] = true
    live[ins.ival] = true
  }
}

function markListLive(live: []bool, ids: []int) {
  let i = 0
  while (i < len(ids)) {
    live[ids[i]] = true
    i = i + 1
  }
}

// One backward sweep marks every value transitively reachable from a root
// (side-effecting instruction, terminator, or block param) live. Correct in a
// single descending pass because every operand's def index is always less than
// its use's, so by the time the sweep reaches a definition every later
// instruction that could mark it live has already run.
function computeLive(f: IrFunc): []bool {
  let live = []bool(0)
  let i = 0
  while (i < len(f.instrs)) {
    live = append(live, false)
    i = i + 1
  }
  i = len(f.instrs)
  while (i > 0) {
    i = i - 1
    let op = f.instrs[i].op
    if (op == Op.BlockParam) {
      live[i] = true
      continue
    }
    if (!live[i] && !isSideEffecting(op)) {
      continue
    }
    live[i] = true
    markOperandsLive(f, live, i)
  }
  return live
}

// Pass 2: dead code elimination — drop every pure instruction no live root
// reads. No folding and no block pruning here, so the rebuild is a faithful
// translate-and-copy of what survives.
function deadCodeElim(f: IrFunc): IrFunc {
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    noFold = append(noFold, noConst())
    i = i + 1
  }
  let reachAll = []bool(0)
  i = 0
  while (i < len(f.blocks)) {
    reachAll = append(reachAll, true)
    i = i + 1
  }
  return rebuild(f, noFold, reachAll, computeLive(f))
}

// Which ops read `lhs` / `rhs` as a value operand (rather than leaving them 0).
// `ival`-carried immediates (offsets, block ids, sizes) are copied verbatim.
function opUsesLhs(op: Op): bool {
  if (opIsBinary(op)) {
    return true
  }
  return op == Op.Neg || op == Op.FNeg || op == Op.BNot || op == Op.Convert ||
    op == Op.FieldGet || op == Op.FieldSet || op == Op.IndexGet || op == Op.IndexSet ||
    op == Op.SliceLen || op == Op.CallValue || op == Op.CallIface || op == Op.MakeClosure
}

function opUsesRhs(op: Op): bool {
  if (opIsBinary(op)) {
    return true
  }
  return op == Op.FieldSet || op == Op.IndexGet || op == Op.IndexSet
}

// Rebuilds `f`, keeping only blocks marked in `blockReachable` and, within each
// kept block, only instructions marked in `instKeep` (block params are always
// emitted; terminators survive because the liveness sweep always marks them).
// Blocks are
// visited in their original emission order (ascending `instsStart`), not block-id
// order: lowering emits a valid linear schedule (an RPO) that the x64 linear-scan
// allocator's interval numbering assumes, and a loop's exit block is ID'd before
// the body's inner blocks but emitted after them — iterating by id would move it
// back into the middle of the loop. `instsStart` is unique per block, so the
// order is deterministic.
function rebuild(f: IrFunc, known: []ConstVal, blockReachable: []bool, instKeep: []bool): IrFunc {
  let n = len(f.blocks)
  let blockMap = []int(0)
  let remap = []int(0)
  let i = 0
  while (i < n) {
    blockMap = append(blockMap, 0)
    i = i + 1
  }
  i = 0
  while (i < len(f.instrs)) {
    remap = append(remap, 0)
    i = i + 1
  }
  // Insertion sort of block ids by ascending instsStart (n is small).
  let order = []int(0)
  i = 0
  while (i < n) {
    let j = len(order)
    order = append(order, i)
    while (j > 0 && f.blocks[order[j - 1]].instsStart > f.blocks[i].instsStart) {
      order[j] = order[j - 1]
      order[j - 1] = i
      j = j - 1
    }
    i = i + 1
  }
  let b = newBuilder()
  i = 0
  while (i < n) {
    if (blockReachable[order[i]]) {
      blockMap[order[i]] = builderNewBlock(b)
    }
    i = i + 1
  }
  i = 0
  while (i < n) {
    let bi = order[i]
    if (!blockReachable[bi]) {
      i = i + 1
      continue
    }
    let blk = f.blocks[bi]
    builderBeginBlock(b, blockMap[bi])
    let idx = blk.instsStart
    let paramsEnd = blk.instsStart + blk.paramCount
    while (idx < paramsEnd) {
      remap[idx] = builderAddParam(b, f.instrs[idx].ty)
      idx = idx + 1
    }
    let end = blk.instsStart + blk.instsLen
    while (idx < end) {
      if (instKeep[idx]) {
        emitTranslated(b, f, known, remap, blockMap, idx)
      }
      idx = idx + 1
    }
    builderEndBlock(b)
    i = i + 1
  }
  return IrFunc{ name: f.name, paramTypes: f.paramTypes, result: f.result,
    blocks: b.blocks, instrs: b.instrs, isFallible: f.isFallible }
}

// ponytail: size-budget heuristic — small leaf helpers only; retune once a real
// corpus shows the right number.
function maxInlineInsts(): int {
  return 8
}

// The index of the function named `name`, or -1. The seed keys calls by FuncId;
// selfhost resolves the callee name into `IrInstr.name`, so the lookup is here.
function funcIndexByName(m: IrModule, name: string): int {
  let i = 0
  while (i < len(m.funcs)) {
    if (m.funcs[i].name == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// A callee is inlinable when it is straight-line code under budget: exactly one
// block (no branches to re-target, so splicing needs no CFG surgery), terminated
// by a plain `ret` (not `unreachable`, so there is always a value to substitute),
// not fallible (keeps error propagation out of this pass), and not the caller
// itself (never inline a self-call).
function inlineEligible(m: IrModule, callerIdx: int, calleeIdx: int): bool {
  if (calleeIdx < 0 || calleeIdx == callerIdx) {
    return false
  }
  let g = m.funcs[calleeIdx]
  if (len(g.blocks) != 1 || g.isFallible) {
    return false
  }
  let b = g.blocks[0]
  if (g.instrs[b.instsStart + b.instsLen - 1].op != Op.Ret) {
    return false
  }
  return b.instsLen - b.paramCount - 1 <= maxInlineInsts()
}

// Splices `g`'s single block into `b`'s currently open block: `g`'s params bind
// directly to the already-translated call `args`, its body is emitted in place
// (no folding, no block retargeting — `g` has exactly one block and its only
// terminator is the `ret`, which is read separately rather than spliced).
// Returns the value the call site now yields.
function spliceCallee(b: IrBuilder, g: IrFunc, args: []int): int {
  let blk = g.blocks[0]
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(g.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  // Never indexed: inlineEligible guarantees the only terminator is the `ret`
  // excluded below, so no jump/br inside the spliced range reads this.
  let dummyBlockMap = [0]
  let idx = blk.instsStart
  let paramsEnd = blk.instsStart + blk.paramCount
  let p = 0
  while (idx < paramsEnd) {
    remap[idx] = args[p]
    p = p + 1
    idx = idx + 1
  }
  let last = blk.instsStart + blk.instsLen - 1
  while (idx < last) {
    emitTranslated(b, g, noFold, remap, dummyBlockMap, idx)
    idx = idx + 1
  }
  let ret = g.instrs[last]
  if (len(ret.args) == 0) {
    return 0 // void callee: the result is never a usable value, never read
  }
  return remap[ret.args[0]]
}

// Pass 3: simple size-budgeted inlining. Blocks are walked in id order, which is
// emission order here — every preceding pass rebuilds with ids assigned in
// ascending instsStart.
function inlineCalls(m: IrModule, fidx: int): IrFunc {
  let f = m.funcs[fidx]
  let n = len(f.blocks)
  let blockMap = []int(0)
  let remap = []int(0)
  let noFold = []ConstVal(0)
  let i = 0
  while (i < len(f.instrs)) {
    remap = append(remap, 0)
    noFold = append(noFold, noConst())
    i = i + 1
  }
  let b = newBuilder()
  i = 0
  while (i < n) {
    blockMap = append(blockMap, builderNewBlock(b))
    i = i + 1
  }
  let bi = 0
  while (bi < n) {
    let blk = f.blocks[bi]
    builderBeginBlock(b, blockMap[bi])
    let idx = blk.instsStart
    let paramsEnd = blk.instsStart + blk.paramCount
    while (idx < paramsEnd) {
      remap[idx] = builderAddParam(b, f.instrs[idx].ty)
      idx = idx + 1
    }
    let end = blk.instsStart + blk.instsLen
    while (idx < end) {
      let ins = f.instrs[idx]
      let handled = false
      if (ins.op == Op.Call) {
        let calleeIdx = funcIndexByName(m, ins.name)
        if (inlineEligible(m, fidx, calleeIdx)) {
          remap[idx] = spliceCallee(b, m.funcs[calleeIdx], trList(remap, ins.args))
          handled = true
        }
      }
      if (!handled) {
        emitTranslated(b, f, noFold, remap, blockMap, idx)
      }
      idx = idx + 1
    }
    builderEndBlock(b)
    bi = bi + 1
  }
  return IrFunc{ name: f.name, paramTypes: f.paramTypes, result: f.result,
    blocks: b.blocks, instrs: b.instrs, isFallible: f.isFallible }
}

// Pass 1: constant folding + propagation, dead-branch/dead-block pruning.
function foldConstantsAndPrune(ctx: TypeContext, f: IrFunc): IrFunc {
  let known = analyzeConsts(ctx, f)
  let keepAll = []bool(0)
  let i = 0
  while (i < len(f.instrs)) {
    keepAll = append(keepAll, true)
    i = i + 1
  }
  return rebuild(f, known, computeReachable(f, known), keepAll)
}

// Runs the optimizer over every function in `m`, in place. Mirrors the seed's
// `-O1` pipeline — a fixed 5 steps (fold, DCE, inline, fold, DCE) so a
// constant-argument call collapses after inlining exposes it, without ever
// looping to a fixpoint. Each step writes back before the next reads, since
// inlining resolves callees out of the module.
function optimizeModule(m: IrModule) {
  let i = 0
  while (i < len(m.funcs)) {
    m.funcs[i] = foldConstantsAndPrune(m.ctx, m.funcs[i])
    m.funcs[i] = deadCodeElim(m.funcs[i])
    m.funcs[i] = inlineCalls(m, i)
    m.funcs[i] = foldConstantsAndPrune(m.ctx, m.funcs[i])
    m.funcs[i] = deadCodeElim(m.funcs[i])
    i = i + 1
  }
}
