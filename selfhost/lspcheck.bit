// bit lsp (#1547) — in-Bit self-checks for the ported language server, run from
// `selfcheck()` under `zig build test`. A failed `assert` panics (exit 2), so a
// regression in the LSP substrate fails the build. These cover the pure layer
// (position math, URI mapping, JSON-RPC framing) — the parts testable without a
// project on disk; the end-to-end behaviour (9 methods over stdio) is gated by
// the scripted transcript in scripts/lsp-transcript.sh, which drives the real
// `bit lsp` binary.

// Position <-> byte-offset round-trips, ASCII and a codepoint above U+FFFF (2
// UTF-16 units). Mirrors seed/lsp.zig's "utf16 position <-> byte offset" test.
function checkLspPositions() {
  let src = "let x = 1\nlet yy = 2\n"
  let pos = byteToLspPos(src, 14) // the 'y' of "yy"
  assert(pos.line == 1)
  assert(pos.character == 4)
  assert(lspPosToByte(src, pos) == 14)

  // A 4-byte UTF-8 codepoint (U+1F600) costs 2 UTF-16 units: the byte after it
  // is at character 3 (1 for 'a' + 2 for the emoji), not 2.
  let wide = "a" + utf8Append("", 0x1F600) + "b"
  let bpos = byteToLspPos(wide, 5) // start of "b"; emoji occupies bytes 1..4
  assert(bpos.line == 0)
  assert(bpos.character == 3)
  assert(lspPosToByte(wide, bpos) == 5)

  // Line/char (0,0) is byte 0; a position past the line's end clamps at the
  // newline rather than crossing into the next line.
  assert(lspPosToByte(src, LspPos{ line: 0, character: 0 }) == 0)
  assert(lspPosToByte(src, LspPos{ line: 0, character: 99 }) == 9) // clamps at '\n'
}

// URI <-> path round-trip, matching seed/lsp.zig's "uriToPath / pathToUri" test:
// a space encodes as %20, and the round-trip is the identity.
function checkLspUri() {
  let path = lspUriToPath("file:///tmp/a%20b/x.bit")
  assert(path == "/tmp/a b/x.bit")
  let uri = lspPathToUri(path)
  assert(uri == "file:///tmp/a%20b/x.bit")

  // A non-file scheme is rejected (empty sentinel).
  assert(lspUriToPath("http://x/y") == "")
  // A stray '%' with no valid hex pair passes through literally.
  assert(lspPercentDecode("a%zz") == "a%zz")
  assert(lspPercentDecode("a%2") == "a%2")
}

// `Content-Length` framing: readMessage extracts exactly the declared body, and
// writeFramed prepends the correct header. Mirrors seed/lsp.zig's "readMessage
// parses Content-Length framing" test, driven over an in-memory Reader.
function checkLspFraming() {
  let body = "{\"a\":\"body!\"}"
  let framed = "Content-Length: 13\r\n\r\n" + body
  let r = lspReaderOverString(framed)
  let msg = lspReadMessage(r)
  assert(msg.ok)
  assert(msg.body == body)

  // A second read past the single message reports end-of-stream, not a phantom.
  let msg2 = lspReadMessage(r)
  assert(!msg2.ok)

  // Extra ignored headers before the blank line are tolerated.
  let framed2 = "Content-Type: x\r\nContent-Length: 2\r\n\r\n{}"
  let m3 = lspReadMessage(lspReaderOverString(framed2))
  assert(m3.ok)
  assert(m3.body == "{}")

  // The framed output carries the byte count of the body, then the body.
  assert(lspFrame("{}") == "Content-Length: 2\r\n\r\n{}")
}

function checkLsp() {
  checkLspPositions()
  checkLspUri()
  checkLspFraming()
}
