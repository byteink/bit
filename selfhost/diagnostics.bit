// Self-host Stage 1 (#1333): the diagnostics + source-manager substrate, ported
// from compiler/diagnostics.zig. This is what the ported lexer/parser build on —
// spans into source, and offset→line/column mapping for diagnostics. Structs are
// reference types in Bit, so the source manager mutates in place (no Zig-style
// `*SourceManager` needed).

// A byte range `[start, end)` in the file identified by `file` (a FileId index).
struct Span {
  file: int,
  start: int,
  end: int,
}

// A zero-width span at `at` — for point diagnostics (EOF, an inserted token).
function pointSpan(file: int, at: int): Span {
  return Span{ file: file, start: at, end: at }
}

// A byte offset resolved to a human position: 0-based line and column, plus the
// full text of the containing line (for the `N | ...` diagnostic gutter).
struct Location {
  line: int,
  column: int,
  lineText: string,
}

struct SrcFile {
  path: string,
  source: string,
}

// Registry of source files. `addFile` returns a FileId (the file's index).
struct SourceManager {
  files: []SrcFile,
}

function newSourceManager(): SourceManager {
  return SourceManager{ files: []SrcFile(0) }
}

// Registers a file and returns its handle. Path and source are borrowed. The
// append persists to the caller because a struct is a reference.
function addFile(sm: SourceManager, path: string, source: string): int {
  let id = len(sm.files)
  sm.files = append(sm.files, SrcFile{ path: path, source: source })
  return id
}

function filePath(sm: SourceManager, file: int): string {
  return sm.files[file].path
}

function fileSource(sm: SourceManager, file: int): string {
  return sm.files[file].source
}

// Maps a byte offset to 0-based line/column and the containing line's text.
// `offset` may equal len(source) (points just past the end, e.g. EOF). Both
// loops are bounded by the source length.
function locate(sm: SourceManager, file: int, offset: int): Location {
  let source = sm.files[file].source
  let line = 0
  let lineStart = 0
  let i = 0
  while (i < offset) {
    if (source[i] == '\n') {
      line = line + 1
      lineStart = i + 1
    }
    i = i + 1
  }
  let lineEnd = lineStart
  while (lineEnd < len(source) && source[lineEnd] != '\n') {
    lineEnd = lineEnd + 1
  }
  return Location{ line: line, column: offset - lineStart, lineText: source[lineStart:lineEnd] }
}
