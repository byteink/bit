// Self-host Stage 3 (#1345): IR module -> Mach-O relocatable object, ported from
// compiler/emit.zig's emitMachoObject. The last link in the chain: everything
// before this produces an IrModule; this turns it into an object the linker
// (machoexec.bit) can consume.
//
// Layout decisions worth stating, because they are not arbitrary:
//   __text   every function's machine code, plus the _bit_main trampoline.
//   __const  string bytes, ptr_offsets arrays, type-name strings — read-only.
//   __data   everything holding an ABSOLUTE pointer: the string {ptr,len}
//            headers, the TypeInfo blobs, the method tables, the stack-map
//            table. Under macOS's PIE model dyld only rebases a pointer that
//            lives in a WRITABLE segment; in __const it would keep its unslid
//            link-time value — a wild pointer into the unmapped pre-slide image.
//
// Every symbol is `_`-prefixed: the Mach-O C ABI mangling the runtime's own
// exports use.

// One distinct TypeInfo blob the runtime's bit_rt_gc_alloc reads (runtime/gc.zig).
// `disc` is the type discriminator (the allocation's result type id) — descriptors
// are per TYPE, not per layout, so each type's method table attaches to the right
// one. `size` is the body size; `ptrOffsets` the byte offsets of pointer fields
// the GC scans.
struct TypeInfoLayout {
  disc: int,
  size: int,
  ptrOffsets: []int,
}

// A function-pointer relocation site inside a method table: patch `off` to the
// absolute address of the __text symbol `sym`.
struct EmFnReloc {
  off: int,
  sym: string,
}

// A type's emitted method table (ABI.md §2.1): the local array symbol, its
// placement, and the per-entry fn relocation sites. `sym` is empty for a type
// with no methods.
struct EmittedMethods {
  sym: string,
  off: int,
  size: int,
  relocs: []EmFnReloc,
}

function emStackmapsSymbol(): string {
  return "bit_stack_maps"
}

// The Mach-O C ABI's leading underscore.
function emMac(name: string): string {
  return "_" + name
}

// The seed converts its arch-specific SafepointEntry into a common SafepointView
// here; this port's compileFunction already produces SafepointViews, so this only
// gathers them with the code size.
function emStackMapOf(fc: FuncCode): FuncStackMap {
  return FuncStackMap{ codeSize: len(fc.code), saved: fc.savedRegs,
    safepoints: fc.safepoints }
}

// §17.6: does this function belong in a freestanding object? A freestanding
// emit keeps only the ROOT module's own code, so an imported module's functions
// are left out and calls into them stay undefined relocations the linker
// resolves against that module's own object. Mirrors the seed's emitsFunction;
// selfhost emits no IrFunc at all for an `extern` decl, so there is no
// is_extern arm to mirror here.
function emitsFunction(f: IrFunc, freestanding: bool): bool {
  return f.inRootModule || !freestanding
}

// §17.6: may this function go into a freestanding object? A freestanding object
// carries no bit_stack_maps, so the collector could not scan the frame of a
// function it holds — sound only for one that can never be on the stack when a
// collection starts.
//
// The test is the DECLARATION, not the emitted safepoint list. Codegen records
// a safepoint at every surviving call (a callee may collect in general);
// @nosplit suppresses only the back-edge one. So "has no safepoints" is true of
// almost nothing that calls anything, and testing it would reject a runtime
// module the moment it called a sibling — the entire case this mode exists for.
// What makes the missing stack map sound is §10.3's standing obligation on
// @nosplit: it may not allocate and may not reach a safepoint.
function freestandingEligible(f: IrFunc): bool {
  return f.isNosplit || f.isNaked
}

// §17.6: refuses a module needing the managed runtime's whole-program tables,
// which a freestanding object cannot carry — a TypeInfo descriptor is a global
// symbol every sibling member describing the same layout would also define, and
// there is exactly one bit_stack_maps per link. Runs before codegen so that
// allocating is diagnosed as allocating, rather than as the @nosplit violation
// it usually also causes.
function refuseManagedMetadata(module: IrModule): ()! {
  if (len(collectTypeInfos(module, true)) > 0) {
    fail newError("--freestanding: this module allocates on the managed heap (a struct, slice, string or closure value)")
  }
}

// True if `name` is a §11.9 pinned symbol rather than a compiler-mangled one.
//
// Exact, not a heuristic, because the two spellings are disjoint by
// construction: every name lowering synthesizes for a non-root function carries
// a '$' — an imported module's functions are qualified `m<id>$f`, generic
// instantiations and methods append `$<n>`/`$t<n>`, and closures and
// trampolines are `closure$<n>`-shaped — while E0079 restricts a pin to a C
// identifier, which cannot contain '$'. Mirrors the seed's isPinnedName.
function isPinnedName(name: string): bool {
  let b = []byte(name)
  let i = 0
  while (i < len(b)) {
    if (b[i] == u8(36)) { // '$'
      return false
    }
    i = i + 1
  }
  return true
}

// True if this freestanding object defines `name` itself, so a reference to it
// resolves inside the object and never reaches the linker.
function definesName(module: IrModule, name: string): bool {
  let i = 0
  while (i < len(module.funcs)) {
    let f = module.funcs[i]
    if (emitsFunction(f, true) && f.name == name) {
      return true
    }
    i = i + 1
  }
  return false
}

// §17.6 + §11.9: the first mangled symbol this object would reference without
// defining, or "" when every outbound reference is resolvable.
//
// The invariant is a property of the OBJECT, not of the call graph: a
// freestanding object may emit an undefined reference only under a name some
// sibling object can actually define. A cross-module call is emitted under the
// callee's LOWERED name, and for an unpinned import that is `m<id>$f` — where
// `<id>` is an ordinal THIS build assigned to the module. The sibling's own
// freestanding object emits the same function bare, because there it is the
// root, so the two spellings can never match and the reference stays undefined
// forever. A pin is the only name both builds agree on, which is what makes
// @symbol load-bearing for a multi-module runtime (ABI.md §9).
//
// Stated over names rather than over inRootModule deliberately. The two agree on
// a correct lowering, but the name test also catches a LOWERING that emits a
// reference matching no definition at all — silent wrongness the inRootModule
// form cannot see. A bit_rt_* runtime symbol and a §11.7 extern both pass for
// the same reason a pin does: their names carry no '$'. Mirrors the seed's
// firstUnpinnedImport; selfhost's Call/FuncAddr already carry the callee NAME.
function firstUnpinnedImport(module: IrModule): string {
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    if (!emitsFunction(f, true)) {
      fi = fi + 1
      continue
    }
    let i = 0
    while (i < len(f.instrs)) {
      let ins = f.instrs[i]
      if (ins.op == Op.Call || ins.op == Op.FuncAddr) {
        if (!isPinnedName(ins.name) && !definesName(module, ins.name)) {
          return ins.name
        }
      }
      i = i + 1
    }
    fi = fi + 1
  }
  return ""
}

function refuseUnpinnedImports(module: IrModule): ()! {
  let nm = firstUnpinnedImport(module)
  if (nm != "") {
    fail newError("--freestanding: this module references '${nm}', a mangled cross-module symbol no sibling object can define; every runtime function another module calls must be pinned with @symbol (SPEC §11.9, ABI.md §9)")
  }
}

// Every distinct TypeInfo in the module, deduped by its symbol name (so a type
// allocated at many sites shares one blob).
function collectTypeInfos(module: IrModule, freestanding: bool): []TypeInfoLayout {
  let seen = map<string, bool>{}
  let out = []TypeInfoLayout(0)
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: a descriptor is only needed for code this object emits.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    let i = 0
    while (i < len(f.instrs)) {
      let ins = f.instrs[i]
      let has = true
      let layout = TypeInfoLayout{ disc: 0, size: 0, ptrOffsets: []int(0) }
      if (ins.op == Op.GcAlloc) {
        layout = TypeInfoLayout{ disc: ins.ty, size: ins.ival, ptrOffsets: ins.offsets }
      } else if (ins.op == Op.MakeClosure) {
        // A make_closure allocates the fixed 16-byte {code, env} cell; its env
        // pointer at +8 is the one GC field.
        layout = TypeInfoLayout{ disc: ins.ty, size: 16, ptrOffsets: [8] }
      } else if (ins.op == Op.TypeInfo) {
        // A type assertion references a descriptor without allocating one, so its
        // target's blob must be emitted here too — the target may never be
        // gc_alloc'd in this module.
        layout = TypeInfoLayout{ disc: ins.ival, size: ins.ival2, ptrOffsets: ins.offsets }
      } else {
        has = false
      }
      if (has) {
        let name = typeInfoSymbol(layout.disc, layout.size, layout.ptrOffsets)
        let (_, dup) = seen[name]
        if (!dup) {
          seen[name] = true
          out = append(out, layout)
        }
      }
      i = i + 1
    }
    fi = fi + 1
  }
  return out
}

function emPadTo8(buf: ByteBuf) {
  while (len(buf.bytes) % 8 != 0) {
    buf.bytes = append(buf.bytes, u8(0))
  }
}

// Appends a type's method table as Method[] ({u64 id, u64 fn} each) and returns
// its placement plus the fn reloc sites. The byte layout is format-neutral; the
// caller turns `relocs` into its own format's records.
function emitMethodTable(module: IrModule, data: ByteBuf, disc: int, tiSymbol: string): EmittedMethods {
  let mt = methodTableOf(module, disc)
  if (len(mt.methods) == 0) {
    return EmittedMethods{ sym: "", off: 0, size: 0, relocs: []EmFnReloc(0) }
  }
  emPadTo8(data)
  let base = len(data.bytes)
  let relocs = []EmFnReloc(0)
  let i = 0
  while (i < len(mt.methods)) {
    appendU64(data, mt.methods[i].id)
    relocs = append(relocs, EmFnReloc{ off: len(data.bytes), sym: mt.methods[i].func })
    appendU64(data, 0) // fn — filled by the reloc
    i = i + 1
  }
  return EmittedMethods{ sym: tiSymbol + "_methods", off: base,
    size: len(mt.methods) * 16, relocs: relocs }
}

// Emits `module` as an aarch64 Mach-O relocatable object. With `withEntry` the
// module's `main` becomes the runtime entry, via the _bit_main trampoline;
// otherwise no `main` is required and no trampoline is emitted (#1397 — the
// plain relocatable an archive member is made of).
// Where one module-level variable (§11.11) landed in a data blob.
struct GlobalPlacement {
  name: string,
  offset: int,
  size: int,
}

// Appends every module-level variable's static image to `buf`, honouring each
// one's alignment, and returns where each landed. The caller turns these into
// its own object format's symbols.
//
// These cells are writable and NEVER scanned by the collector: the checker has
// proved each one's type untraced, so the blob needs no pointer map and no root
// registration. See SPEC §11.11.
function placeGlobals(module: IrModule, buf: ByteBuf): []GlobalPlacement {
  let out = []GlobalPlacement(0)
  let i = 0
  while (i < len(module.globals)) {
    let g = module.globals[i]
    while (len(buf.bytes) % g.align != 0) {
      buf.bytes = append(buf.bytes, u8(0))
    }
    let off = len(buf.bytes)
    let j = 0
    while (j < len(g.bytes)) {
      buf.bytes = append(buf.bytes, u8(g.bytes[j]))
      j = j + 1
    }
    out = append(out, GlobalPlacement{ name: g.name, offset: off, size: len(g.bytes) })
    i = i + 1
  }
  return out
}

function emitMachoObject(module: IrModule, withEntry: bool, freestanding: bool): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let data = newByteBuf()
  let symbols = []MachoSymbol(0)
  let relocs = []MachoRelocation(0)
  let defined = map<string, bool>{}
  let stackmaps = []FuncStackMap(0)
  let emittedNames = []string(0)
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
  }

  // §11.8: `syscall()` is Linux-only. The arm64 backend is shared with
  // aarch64-linux, so the target-specific rejection belongs here, on the Mach-O
  // path — the one place that knows the OS. Rejecting before any code is
  // emitted keeps the failure a clean diagnostic rather than a partly written
  // object.
  let sf = 0
  while (sf < len(module.funcs)) {
    let sfn = module.funcs[sf]
    // §17.6: only code this object emits can carry the instruction — rejecting
    // on a module not being emitted would fail a valid freestanding build over
    // a sibling's Linux-only code.
    if (!emitsFunction(sfn, freestanding)) {
      sf = sf + 1
      continue
    }
    let si = 0
    while (si < len(sfn.instrs)) {
      if (sfn.instrs[si].op == Op.Syscall) {
        fail newError("'syscall' is not supported on aarch64-macos: Darwin publishes no stable syscall numbers (SPEC §11.8)")
      }
      si = si + 1
    }
    sf = sf + 1
  }

  // ---- every function -> one __text symbol + its relocations -------------
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    if (freestanding && !freestandingEligible(f)) {
      fail newError("--freestanding: '${f.name}' is neither @nosplit nor @naked; freestanding code carries no GC stack maps (SPEC §10.3)")
    }
    let fc = compileFunction(module, f)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    symbols = append(symbols, MachoSymbol{ name: emMac(f.name), hasSection: true,
      section: MachoSectionKind.Text, offset: off, size: len(fc.code),
      binding: MachoBinding.Global })
    defined[emMac(f.name)] = true
    let r = 0
    while (r < len(fc.relocs)) {
      relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Text,
        offset: off + fc.relocs[r].offset, symbol: emMac(fc.relocs[r].symbol),
        kind: emRelocKind(fc.relocs[r].kind) })
      r = r + 1
    }
    stackmaps = append(stackmaps, emStackMapOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  if (withEntry) {
    if (!haveMain) {
      fail newError("NoMain")
    }

    // ---- _bit_main entry trampoline (AArch64) ----------------------------
    // The runtime calls _bit_main (runtime/root.zig's boot runs it as a green
    // thread); a void `main` still has to return an exit code, so the
    // trampoline supplies 0.
    let tramp = len(code.bytes)
    emitWord(code, 0xA9BF7BFD) // stp x29, x30, [sp, #-16]!
    let callField = len(code.bytes)
    emitWord(code, 0x94000000) // bl _main (placeholder)
    relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Text,
      offset: callField, symbol: "_main", kind: MachoRelocKind.Branch })
    if (mainVoid) {
      emitWord(code, 0x52800000) // movz w0, #0
    }
    emitWord(code, 0xA8C17BFD) // ldp x29, x30, [sp], #16
    emitWord(code, 0xD65F03C0) // ret
    symbols = append(symbols, MachoSymbol{ name: "_bit_main", hasSection: true,
      section: MachoSectionKind.Text, offset: tramp, size: len(code.bytes) - tramp,
      binding: MachoBinding.Global })
    defined["_bit_main"] = true
  }

  // ---- string pool -> read-only bytes + a writable {ptr,len} header ------
  let si = 0
  while (si < len(module.stringPool)) {
    let s = module.stringPool[si]
    let dataOff = len(rodata.bytes)
    appendBytes(rodata, []byte(s))
    let dataName = "___bitstr_${si}_data"
    symbols = append(symbols, MachoSymbol{ name: dataName, hasSection: true,
      section: MachoSectionKind.Rodata, offset: dataOff, size: len([]byte(s)),
      binding: MachoBinding.Local })
    defined[dataName] = true

    emPadTo8(data)
    let hdrOff = len(data.bytes)
    appendU64(data, 0)             // ptr — filled by the reloc, rebased by dyld
    appendU64(data, len([]byte(s))) // len
    let hdrName = "___bitstr_${si}"
    // §17.6: local in a freestanding object — see emitElfBlobs.
    let hdrBinding = MachoBinding.Global
    if (freestanding) {
      hdrBinding = MachoBinding.Local
    }
    symbols = append(symbols, MachoSymbol{ name: hdrName, hasSection: true,
      section: MachoSectionKind.Data, offset: hdrOff, size: 16,
      binding: hdrBinding })
    defined[hdrName] = true
    relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
      offset: hdrOff, symbol: dataName, kind: MachoRelocKind.Unsigned64 })
    si = si + 1
  }

  // ---- gc_alloc TypeInfo blobs -------------------------------------------
  // §17.6: empty on the freestanding path — see refuseManagedMetadata.
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    let t = tis[ti]
    let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
    let offsName = ""
    if (len(t.ptrOffsets) > 0) {
      emPadTo8(rodata)
      let offsOff = len(rodata.bytes)
      let k = 0
      while (k < len(t.ptrOffsets)) {
        appendU64(rodata, t.ptrOffsets[k])
        k = k + 1
      }
      offsName = emMac(name + "_offs")
      symbols = append(symbols, MachoSymbol{ name: offsName, hasSection: true,
        section: MachoSectionKind.Rodata, offset: offsOff,
        size: len(t.ptrOffsets) * 8, binding: MachoBinding.Local })
      defined[offsName] = true
    }
    // The type's display name. The seed reads a display_names side table; this
    // port keeps the name on the Type itself.
    let tname = ""
    if (module.ctx.types[t.disc].hasName) {
      tname = module.ctx.types[t.disc].name
    }
    let nameSym = ""
    if (len([]byte(tname)) > 0) {
      let nmOff = len(rodata.bytes)
      appendBytes(rodata, []byte(tname))
      nameSym = emMac(name + "_name")
      symbols = append(symbols, MachoSymbol{ name: nameSym, hasSection: true,
        section: MachoSectionKind.Rodata, offset: nmOff, size: len([]byte(tname)),
        binding: MachoBinding.Local })
      defined[nameSym] = true
    }
    // The method table holds absolute fn pointers, so it lives in writable
    // __data too.
    let methods = emitMethodTable(module, data, t.disc, name)
    let methodsName = ""
    if (methods.sym != "") {
      methodsName = emMac(methods.sym)
      symbols = append(symbols, MachoSymbol{ name: methodsName, hasSection: true,
        section: MachoSectionKind.Data, offset: methods.off, size: methods.size,
        binding: MachoBinding.Local })
      defined[methodsName] = true
      let mr = 0
      while (mr < len(methods.relocs)) {
        relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
          offset: methods.relocs[mr].off, symbol: emMac(methods.relocs[mr].sym),
          kind: MachoRelocKind.Unsigned64 })
        mr = mr + 1
      }
    }

    emPadTo8(data)
    let tiOff = len(data.bytes)
    appendU64(data, t.size)              // size
    appendU64(data, 0)                   // ptr_offsets_ptr (rebased if any)
    appendU64(data, len(t.ptrOffsets))   // ptr_offsets_len
    appendU64(data, 0)                   // name_ptr (rebased if any)
    appendU64(data, len([]byte(tname)))  // name_len
    appendU64(data, 0)                   // methods_ptr (rebased if any)
    appendU64(data, methods.size / 16)   // methods_len
    let tiName = emMac(name)
    symbols = append(symbols, MachoSymbol{ name: tiName, hasSection: true,
      section: MachoSectionKind.Data, offset: tiOff, size: 56,
      binding: MachoBinding.Global })
    defined[tiName] = true
    if (len(t.ptrOffsets) > 0) {
      relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
        offset: tiOff + 8, symbol: offsName, kind: MachoRelocKind.Unsigned64 })
    }
    if (nameSym != "") {
      relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
        offset: tiOff + 24, symbol: nameSym, kind: MachoRelocKind.Unsigned64 })
    }
    if (methods.sym != "") {
      relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
        offset: tiOff + 40, symbol: methodsName, kind: MachoRelocKind.Unsigned64 })
    }
    ti = ti + 1
  }

  // ---- GC stack-map table (runtime/ABI.md §4) ----------------------------
  // Each entry holds an absolute code pointer, so this lives in writable __data
  // too; the runtime reads it via _bit_stack_maps.
  // §17.6: a whole-program table under a fixed name — never an archive
  // member's to define. See emitElfBlobs.
  assert(len(emittedNames) == len(stackmaps))
  if (!freestanding) {
    let blobOff = len(data.bytes)
    let codeRelocs = writeStackMaps(data, stackmaps)
    let smSym = emMac(emStackmapsSymbol())
    symbols = append(symbols, MachoSymbol{ name: smSym, hasSection: true,
      section: MachoSectionKind.Data, offset: blobOff,
      size: len(data.bytes) - blobOff, binding: MachoBinding.Global })
    defined[smSym] = true
    // writeStackMaps records offsets against `data` itself — already
    // section-relative, so no blobOff adjustment.
    let ci = 0
    while (ci < len(codeRelocs)) {
      relocs = append(relocs, MachoRelocation{ section: MachoSectionKind.Data,
        offset: codeRelocs[ci], symbol: emMac(emittedNames[ci]),
        kind: MachoRelocKind.Unsigned64 })
      ci = ci + 1
    }
  }

  // ---- module-level state (§11.11) -> the same writable __data ----------
  let mgs = placeGlobals(module, data)
  let gi = 0
  while (gi < len(mgs)) {
    let gsym = emMac(mgs[gi].name)
    symbols = append(symbols, MachoSymbol{ name: gsym, hasSection: true,
      section: MachoSectionKind.Data, offset: mgs[gi].offset,
      size: mgs[gi].size, binding: MachoBinding.Global })
    defined[gsym] = true
    gi = gi + 1
  }

  // ---- undefined externals for runtime symbols ---------------------------
  // Anything a relocation names that this object does not define is a runtime
  // import the linker resolves.
  let externs = map<string, bool>{}
  let ri = 0
  while (ri < len(relocs)) {
    let sym = relocs[ri].symbol
    let (_, isDef) = defined[sym]
    let (_, isExt) = externs[sym]
    if (!isDef && !isExt) {
      externs[sym] = true
      symbols = append(symbols, MachoSymbol{ name: sym, hasSection: false,
        section: MachoSectionKind.Text, offset: 0, size: 0,
        binding: MachoBinding.Global })
    }
    ri = ri + 1
  }

  let sections = [MachoSection{ kind: MachoSectionKind.Text, data: code.bytes,
    size: 0, alignment: 4 }]
  if (len(rodata.bytes) > 0) {
    sections = append(sections, MachoSection{ kind: MachoSectionKind.Rodata,
      data: rodata.bytes, size: 0, alignment: 8 })
  }
  if (len(data.bytes) > 0) {
    sections = append(sections, MachoSection{ kind: MachoSectionKind.Data,
      data: data.bytes, size: 0, alignment: 8 })
  }
  return writeMacho(MachoTarget.Aarch64, MachoObject{ sections: sections,
    symbols: symbols, relocations: relocs })?
}

// codegen's Reloc kinds map 1:1 onto the object writer's.
function emRelocKind(k: RelocKind): MachoRelocKind {
  if (k == RelocKind.Branch) {
    return MachoRelocKind.Branch
  }
  if (k == RelocKind.Page21) {
    return MachoRelocKind.Page21
  }
  assert(k == RelocKind.PageOff12)
  return MachoRelocKind.Pageoff12
}

// ---- ELF object emission (#345: the Linux path) ---------------------------

// Emits the arch-independent ELF data — string-pool headers, gc_alloc TypeInfo
// blobs (ABI.md §2.1), and the GC stack-map table — all into `.rodata` with
// abs64 pointer relocations, then declares an undefined extern for every
// referenced-but-undefined symbol (the runtime's bit_rt_* calls). Shared by both
// ELF targets; their only differences (codegen, the entry trampoline, the code
// relocation kinds) are handled by the caller before this runs.
//
// Note the contrast with emitMachoObject above, which puts these blobs in
// WRITABLE __data: Mach-O output is PIE and dyld rebases each pointer at load.
// An ELF link here is non-PIE and static, so the addresses are known at link
// time and the blobs are read-only.
struct EmElfBlobs {
  symbols: []ElfSymbol,
  relocs: []ElfRelocation,
}

function emElfSym(name: string, kind: ElfSectionKind, off: int, size: int,
  binding: ElfBinding, sk: ElfSymKind): ElfSymbol {
  return ElfSymbol{ name: name, hasSection: true, section: kind, offset: off,
    size: size, binding: binding, kind: sk }
}

function emElfAbs64(off: int, sym: string): ElfRelocation {
  return ElfRelocation{ section: ElfSectionKind.Rodata, offset: off, symbol: sym,
    kind: ElfRelocKind.Abs64, addend: 0 }
}

function emitElfBlobs(module: IrModule, rodata: ByteBuf, symbols: []ElfSymbol,
  relocs: []ElfRelocation, defined: map<string, bool>,
  stackmaps: []FuncStackMap, emittedNames: []string,
  freestanding: bool): EmElfBlobs {
  assert(len(emittedNames) == len(stackmaps))
  // §17.6: a freestanding object is one archive member among many, so every
  // symbol it defines globally is one a sibling member may define too. A string
  // literal has no external linkage — nothing outside this object ever names
  // __bitstr_N — so the header goes local and two members' literals stop
  // colliding at link.
  //
  // NOT REACHABLE TODAY, and deliberately kept: §10.3's @nosplit whitelist
  // admits no string operation, so a freestanding module's string pool is always
  // empty. Kept because that whitelist must widen for #1363/#1364, and the day a
  // literal becomes reachable a global binding would surface as a __bitstr_0
  // duplicate between two members.
  let blobBinding = ElfBinding.Global
  if (freestanding) {
    blobBinding = ElfBinding.Local
  }
  // ---- string pool -> .rodata bytes + a {ptr,len} header -----------------
  let si = 0
  while (si < len(module.stringPool)) {
    let s = module.stringPool[si]
    let dataOff = len(rodata.bytes)
    appendBytes(rodata, []byte(s))
    let dataName = "__bitstr_${si}_data"
    symbols = append(symbols, emElfSym(dataName, ElfSectionKind.Rodata, dataOff,
      len([]byte(s)), ElfBinding.Local, ElfSymKind.Object))
    defined[dataName] = true

    emPadTo8(rodata)
    let hdrOff = len(rodata.bytes)
    appendU64(rodata, 0)              // ptr — filled by the reloc below
    appendU64(rodata, len([]byte(s))) // len
    let hdrName = "__bitstr_${si}"
    symbols = append(symbols, emElfSym(hdrName, ElfSectionKind.Rodata, hdrOff, 16,
      blobBinding, ElfSymKind.Object))
    defined[hdrName] = true
    relocs = append(relocs, emElfAbs64(hdrOff, dataName))
    si = si + 1
  }

  // ---- gc_alloc TypeInfo blobs -> .rodata --------------------------------
  // §17.6: empty on the freestanding path — see refuseManagedMetadata.
  let tis = collectTypeInfos(module, freestanding)
  let ti = 0
  while (ti < len(tis)) {
    let t = tis[ti]
    let name = typeInfoSymbol(t.disc, t.size, t.ptrOffsets)
    let offsName = ""
    if (len(t.ptrOffsets) > 0) {
      emPadTo8(rodata)
      let offsOff = len(rodata.bytes)
      let k = 0
      while (k < len(t.ptrOffsets)) {
        appendU64(rodata, t.ptrOffsets[k])
        k = k + 1
      }
      offsName = name + "_offs"
      symbols = append(symbols, emElfSym(offsName, ElfSectionKind.Rodata, offsOff,
        len(t.ptrOffsets) * 8, ElfBinding.Local, ElfSymKind.Object))
      defined[offsName] = true
    }
    let tname = ""
    if (module.ctx.types[t.disc].hasName) {
      tname = module.ctx.types[t.disc].name
    }
    let nameSym = ""
    if (len([]byte(tname)) > 0) {
      let nmOff = len(rodata.bytes)
      appendBytes(rodata, []byte(tname))
      nameSym = name + "_name"
      symbols = append(symbols, emElfSym(nameSym, ElfSectionKind.Rodata, nmOff,
        len([]byte(tname)), ElfBinding.Local, ElfSymKind.Object))
      defined[nameSym] = true
    }
    let methods = emitMethodTable(module, rodata, t.disc, name)
    if (methods.sym != "") {
      symbols = append(symbols, emElfSym(methods.sym, ElfSectionKind.Rodata,
        methods.off, methods.size, ElfBinding.Local, ElfSymKind.Object))
      defined[methods.sym] = true
    }

    emPadTo8(rodata)
    let tiOff = len(rodata.bytes)
    appendU64(rodata, t.size)             // size
    appendU64(rodata, 0)                  // ptr_offsets_ptr (reloc below if any)
    appendU64(rodata, len(t.ptrOffsets))  // ptr_offsets_len
    appendU64(rodata, 0)                  // name_ptr (reloc below if any)
    appendU64(rodata, len([]byte(tname))) // name_len
    appendU64(rodata, 0)                  // methods_ptr (reloc below if any)
    appendU64(rodata, methods.size / 16)  // methods_len
    symbols = append(symbols, emElfSym(name, ElfSectionKind.Rodata, tiOff, 56,
      ElfBinding.Global, ElfSymKind.Object))
    defined[name] = true
    if (len(t.ptrOffsets) > 0) {
      relocs = append(relocs, emElfAbs64(tiOff + 8, offsName))
    }
    if (nameSym != "") {
      relocs = append(relocs, emElfAbs64(tiOff + 24, nameSym))
    }
    if (methods.sym != "") {
      relocs = append(relocs, emElfAbs64(tiOff + 40, methods.sym))
      let mr = 0
      while (mr < len(methods.relocs)) {
        relocs = append(relocs, emElfAbs64(methods.relocs[mr].off, methods.relocs[mr].sym))
        mr = mr + 1
      }
    }
    ti = ti + 1
  }

  // ---- GC stack-map table (runtime/ABI.md §4) -> .rodata -----------------
  // §17.6: bit_stack_maps is a whole-PROGRAM table under one fixed name the
  // runtime reads, so exactly one object in a link may define it — never an
  // archive member. A freestanding object emits none, and refuses any function
  // that would need an entry, so nothing is silently lost.
  if (!freestanding) {
    let blobOff = len(rodata.bytes)
    let codeRelocs = writeStackMaps(rodata, stackmaps)
    symbols = append(symbols, emElfSym(emStackmapsSymbol(), ElfSectionKind.Rodata,
      blobOff, len(rodata.bytes) - blobOff, ElfBinding.Global, ElfSymKind.Object))
    defined[emStackmapsSymbol()] = true
    // writeStackMaps records offsets against `rodata` itself — already
    // section-relative, so no blobOff adjustment. `emittedNames` is indexed in
    // stackmap order, which is NOT module.funcs order once anything is skipped.
    let ci = 0
    while (ci < len(codeRelocs)) {
      relocs = append(relocs, emElfAbs64(codeRelocs[ci], emittedNames[ci]))
      ci = ci + 1
    }
  }

  // ---- undefined externals (the runtime's bit_rt_* symbols) --------------
  let externs = map<string, bool>{}
  let ri = 0
  while (ri < len(relocs)) {
    let sym = relocs[ri].symbol
    let (_, isDef) = defined[sym]
    let (_, isExt) = externs[sym]
    if (!isDef && !isExt) {
      externs[sym] = true
      symbols = append(symbols, ElfSymbol{ name: sym, hasSection: false,
        section: ElfSectionKind.Text, offset: 0, size: 0,
        binding: ElfBinding.Global, kind: ElfSymKind.Notype })
    }
    ri = ri + 1
  }
  return EmElfBlobs{ symbols: symbols, relocs: relocs }
}

// x86-64 codegen's Reloc kinds mapped onto the ELF writer's. A `call rel32`'s
// field is measured from its own start, so the -4 bias the encoder assumes is
// carried as the relocation's addend (the seed does exactly this).
function emElfRelocX64(k: RelocKind): ElfRelocKind {
  if (k == RelocKind.Abs64) {
    return ElfRelocKind.Abs64
  }
  assert(k == RelocKind.Branch)
  return ElfRelocKind.Pc32
}

function emElfAddendX64(k: RelocKind): int {
  if (k == RelocKind.Branch) {
    return -4
  }
  return 0
}

// Each per-arch mapper below asserts its OWN arch's kind set, so the dispatch
// has to happen before the call — evaluating both sides would trip the other
// arch's assert on a kind it never emits.
function emCompileFor(module: IrModule, f: IrFunc, isX64: bool): FuncCode {
  if (isX64) {
    return xCompileFunction(module, f, XCallConv.SysV)
  }
  return compileFunction(module, f)
}

function emElfRelocFor(k: RelocKind, isX64: bool): ElfRelocKind {
  if (isX64) {
    return emElfRelocX64(k)
  }
  return emElfRelocArm64(k)
}

function emElfAddendFor(k: RelocKind, isX64: bool): int {
  if (isX64) {
    return emElfAddendX64(k)
  }
  return 0
}

function emElfRelocArm64(k: RelocKind): ElfRelocKind {
  if (k == RelocKind.Branch) {
    return ElfRelocKind.Call26
  }
  if (k == RelocKind.Page21) {
    return ElfRelocKind.AdrPrelPgHi21
  }
  assert(k == RelocKind.PageOff12)
  return ElfRelocKind.AddAbsLo12Nc
}

// Emits `module` as a relocatable ELF object for `target`. One entry point for
// both architectures: the arch-specific parts are the backend, the code
// relocation kinds, and the bit_main trampoline's encoding.
function emitElfObject(module: IrModule, target: ElfTarget, withEntry: bool, freestanding: bool): []u8! {
  let code = newByteBuf()
  let rodata = newByteBuf()
  let symbols = []ElfSymbol(0)
  let relocs = []ElfRelocation(0)
  let defined = map<string, bool>{}
  let stackmaps = []FuncStackMap(0)
  let emittedNames = []string(0)
  let isX64 = target == ElfTarget.X86_64
  if (freestanding) {
    refuseManagedMetadata(module)?
    refuseUnpinnedImports(module)?
  }

  // ---- every function -> one .text symbol + its relocations --------------
  let mainVoid = false
  let haveMain = false
  let fi = 0
  while (fi < len(module.funcs)) {
    let f = module.funcs[fi]
    // §17.6: an imported module's function belongs to its own object.
    if (!emitsFunction(f, freestanding)) {
      fi = fi + 1
      continue
    }
    if (freestanding && !freestandingEligible(f)) {
      fail newError("--freestanding: '${f.name}' is neither @nosplit nor @naked; freestanding code carries no GC stack maps (SPEC §10.3)")
    }
    let fc = emCompileFor(module, f, isX64)
    let off = len(code.bytes)
    appendBytes(code, fc.code)
    symbols = append(symbols, emElfSym(f.name, ElfSectionKind.Text, off,
      len(fc.code), ElfBinding.Global, ElfSymKind.Func))
    defined[f.name] = true
    let r = 0
    while (r < len(fc.relocs)) {
      relocs = append(relocs, ElfRelocation{ section: ElfSectionKind.Text,
        offset: off + fc.relocs[r].offset, symbol: fc.relocs[r].symbol,
        kind: emElfRelocFor(fc.relocs[r].kind, isX64),
        addend: emElfAddendFor(fc.relocs[r].kind, isX64) })
      r = r + 1
    }
    stackmaps = append(stackmaps, emStackMapOf(fc))
    emittedNames = append(emittedNames, f.name)
    if (f.name == "main") {
      haveMain = true
      mainVoid = module.ctx.types[f.result].kind == TypeKind.Void
    }
    fi = fi + 1
  }
  if (withEntry) {
    if (!haveMain) {
      fail newError("NoMain")
    }

    // ---- bit_main entry trampoline ---------------------------------------
    // The runtime calls bit_main (runtime/root.zig's boot runs it as a green
    // thread); a void `main` still owes an exit code, so the trampoline
    // supplies 0.
    let tramp = len(code.bytes)
    let callField = 0
    if (isX64) {
      // On entry rsp%16==8 (the call into bit_main pushed a return address); a
      // single `sub rsp,8` re-aligns it so the SysV call below is 16-aligned.
      //   sub rsp,8 ; call main ; [xor eax,eax if void] ; add rsp,8 ; ret
      appendBytes(code, [u8(0x48), u8(0x83), u8(0xEC), u8(0x08)])
      code.bytes = append(code.bytes, u8(0xE8))
      callField = len(code.bytes)
      appendZeros(code, 4)
      relocs = append(relocs, ElfRelocation{ section: ElfSectionKind.Text,
        offset: callField, symbol: "main", kind: ElfRelocKind.Pc32, addend: -4 })
      if (mainVoid) {
        appendBytes(code, [u8(0x31), u8(0xC0)]) // xor eax, eax
      }
      appendBytes(code, [u8(0x48), u8(0x83), u8(0xC4), u8(0x08), u8(0xC3)])
    } else {
      //   stp x29,x30,[sp,#-16]! ; bl main ; [movz w0,#0 if void] ; ldp ; ret
      emitWord(code, 0xA9BF7BFD)
      callField = len(code.bytes)
      emitWord(code, 0x94000000) // bl main (placeholder)
      relocs = append(relocs, ElfRelocation{ section: ElfSectionKind.Text,
        offset: callField, symbol: "main", kind: ElfRelocKind.Call26, addend: 0 })
      if (mainVoid) {
        emitWord(code, 0x52800000) // movz w0, #0
      }
      emitWord(code, 0xA8C17BFD) // ldp x29, x30, [sp], #16
      emitWord(code, 0xD65F03C0) // ret
    }
    symbols = append(symbols, emElfSym("bit_main", ElfSectionKind.Text, tramp,
      len(code.bytes) - tramp, ElfBinding.Global, ElfSymKind.Func))
    defined["bit_main"] = true
  }

  // ---- module-level state (§11.11) -> writable .data ---------------------
  // Placed BEFORE emitElfBlobs: that call ends with the undefined-extern
  // sweep, which declares an extern for every relocation naming a symbol not
  // yet in `defined`. A global's own load/store relocations name it, so
  // registering these after the sweep emits each cell twice — once undefined,
  // once defined — and the ELF writer rejects that as DuplicateSymbol. The
  // seed's two ELF emitters place globals before the sweep for this reason.
  let gdata = newByteBuf()
  let egs = placeGlobals(module, gdata)
  let egi = 0
  while (egi < len(egs)) {
    symbols = append(symbols, emElfSym(egs[egi].name, ElfSectionKind.Data,
      egs[egi].offset, egs[egi].size, ElfBinding.Global, ElfSymKind.Object))
    defined[egs[egi].name] = true
    egi = egi + 1
  }

  let blobs = emitElfBlobs(module, rodata, symbols, relocs, defined, stackmaps,
    emittedNames, freestanding)
  symbols = blobs.symbols
  relocs = blobs.relocs

  let sections = [ElfSection{ kind: ElfSectionKind.Text, data: code.bytes,
    size: 0, alignment: 16 }]
  if (len(rodata.bytes) > 0) {
    sections = append(sections, ElfSection{ kind: ElfSectionKind.Rodata,
      data: rodata.bytes, size: 0, alignment: 8 })
  }
  if (len(gdata.bytes) > 0) {
    sections = append(sections, ElfSection{ kind: ElfSectionKind.Data,
      data: gdata.bytes, size: 0, alignment: 8 })
  }
  return writeElfObject(target, ElfObject{ sections: sections, symbols: symbols,
    relocations: relocs })?
}
