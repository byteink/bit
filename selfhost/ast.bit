// Self-host Stage 1 (#1333): the AST node arena, ported from compiler/ast.zig.
// Same index-based design — nodes live in one growable array, their children in
// a shared `extra` pool referenced by (kidsStart, kidsLen); index 0 is the
// reserved `none` sentinel (an absent optional child). Node.main is a tag-
// specific scalar (the operator's Kind for binary/unary, else 0).
//
// Tag is a representative subset for now; it grows as the parser ports (#1335).
// Span comes from selfhost/diagnostics.bit (same module).

enum Tag {
  None,
  // leaves
  Ident,
  IntLit,
  FloatLit,
  StringLit,
  RawStringLit,
  RuneLit,
  BoolLit,
  NilLit,
  // declarations
  Program,
  ConstDecl,
  LetDecl,
  Binding,
  FuncDecl,
  Params,
  Param,
  // statements
  Block,
  ReturnStmt,
  ExprStmt,
  // expressions
  Binary,
  Unary,
  Call,
  Args,
  Arg,
  Member,
  // more declarations
  Export,
  ImportDecl,
  ImportNs,
  ImportStar,
  ImportGroup,
  ImportItem,
  TypeAlias,
  StructDecl,
  FieldList,
  Field,
  EnumDecl,
  VariantList,
  EnumVariant,
  TypeList,
  InterfaceDecl,
  MethodSigList,
  MethodSig,
  // generics + types
  GenericParams,
  GenericParam,
  Constraint,
  GenericInst,
  TypeArgs,
  SliceType,
  ArrayType,
  MapType,
  ChanType,
  Fallible,
  // more expressions
  StrPart,
  StrInterp,
  TryExpr,
  Index,
  SliceExpr,
  TypeAssert,
  TupleIndex,
  ArgSpread,
  SliceLit,
  CompositeLit,
  FieldInits,
  FieldInit,
  CatchBind,
  CatchDefault,
  // statements / control flow
  IfStmt,
  WhileStmt,
  ForOf,
  ForIn,
  ForC,
  ForInf,
  BreakStmt,
  ContinueStmt,
  FailStmt,
  SpawnStmt,
  DeferStmt,
  IncStmt,
  DecStmt,
  SendStmt,
  Assign,
  LhsList,
  ExprList,
  // match + patterns
  MatchStmt,
  ArmList,
  MatchArm,
  VariantPat,
  TuplePat,
}

struct Node {
  tag: Tag,
  span: Span,
  main: int,
  kidsStart: int,
  kidsLen: int,
}

struct Tree {
  nodes: []Node,
  extra: []int,
  root: int,
}

// A fresh tree with the reserved `none` node installed at index 0, so every real
// node has a nonzero index and 0 reads as "absent".
function newTree(): Tree {
  let none = Node{ tag: Tag.None, span: pointSpan(0, 0), main: 0, kidsStart: 0, kidsLen: 0 }
  return Tree{ nodes: append([]Node(0), none), extra: []int(0), root: 0 }
}

// Appends a node whose children are `kids`, returning its index. The children
// are copied into the shared `extra` pool. Tree is a reference, so both slices
// grow in place.
function addNode(t: Tree, tag: Tag, span: Span, main: int, kids: []int): int {
  let start = len(t.extra)
  let i = 0
  while (i < len(kids)) {
    t.extra = append(t.extra, kids[i])
    i = i + 1
  }
  let id = len(t.nodes)
  t.nodes = append(t.nodes, Node{ tag: tag, span: span, main: main, kidsStart: start, kidsLen: len(kids) })
  return id
}

// A leaf node (no children); the text is the source slice under `span`.
function addLeaf(t: Tree, tag: Tag, span: Span): int {
  return addNode(t, tag, span, 0, []int(0))
}

function getNode(t: Tree, idx: int): Node {
  return t.nodes[idx]
}

// The child indices of node `idx`, a view into the `extra` pool.
function kidsOf(t: Tree, idx: int): []int {
  let n = t.nodes[idx]
  return t.extra[n.kidsStart:n.kidsStart + n.kidsLen]
}

// ---- s-expression dump (matches compiler/ast.zig's ast.dump) ---------------

// The seed's @tagName for a non-leaf node.
function tagName(tag: Tag): string {
  if (tag == Tag.Program) { return "program" }
  if (tag == Tag.ConstDecl) { return "const_decl" }
  if (tag == Tag.LetDecl) { return "let_decl" }
  if (tag == Tag.Binding) { return "binding" }
  if (tag == Tag.FuncDecl) { return "func_decl" }
  if (tag == Tag.Params) { return "params" }
  if (tag == Tag.Param) { return "param" }
  if (tag == Tag.Block) { return "block" }
  if (tag == Tag.ReturnStmt) { return "return_stmt" }
  if (tag == Tag.ExprStmt) { return "expr_stmt" }
  if (tag == Tag.Binary) { return "binary" }
  if (tag == Tag.Unary) { return "unary" }
  if (tag == Tag.Call) { return "call" }
  if (tag == Tag.Args) { return "args" }
  if (tag == Tag.Arg) { return "arg" }
  if (tag == Tag.Member) { return "member" }
  if (tag == Tag.Export) { return "export" }
  if (tag == Tag.ImportDecl) { return "import_decl" }
  if (tag == Tag.ImportNs) { return "import_ns" }
  if (tag == Tag.ImportStar) { return "import_star" }
  if (tag == Tag.ImportGroup) { return "import_group" }
  if (tag == Tag.ImportItem) { return "import_item" }
  if (tag == Tag.TypeAlias) { return "type_alias" }
  if (tag == Tag.StructDecl) { return "struct_decl" }
  if (tag == Tag.FieldList) { return "field_list" }
  if (tag == Tag.Field) { return "field" }
  if (tag == Tag.EnumDecl) { return "enum_decl" }
  if (tag == Tag.VariantList) { return "variant_list" }
  if (tag == Tag.EnumVariant) { return "enum_variant" }
  if (tag == Tag.TypeList) { return "type_list" }
  if (tag == Tag.InterfaceDecl) { return "interface_decl" }
  if (tag == Tag.MethodSigList) { return "method_sig_list" }
  if (tag == Tag.MethodSig) { return "method_sig" }
  if (tag == Tag.GenericParams) { return "generic_params" }
  if (tag == Tag.GenericParam) { return "generic_param" }
  if (tag == Tag.Constraint) { return "constraint" }
  if (tag == Tag.GenericInst) { return "generic_inst" }
  if (tag == Tag.TypeArgs) { return "type_args" }
  if (tag == Tag.SliceType) { return "slice_type" }
  if (tag == Tag.ArrayType) { return "array_type" }
  if (tag == Tag.MapType) { return "map_type" }
  if (tag == Tag.ChanType) { return "chan_type" }
  if (tag == Tag.Fallible) { return "fallible" }
  if (tag == Tag.StrInterp) { return "str_interp" }
  if (tag == Tag.TryExpr) { return "try_expr" }
  if (tag == Tag.Index) { return "index" }
  if (tag == Tag.SliceExpr) { return "slice_expr" }
  if (tag == Tag.TypeAssert) { return "type_assert" }
  if (tag == Tag.TupleIndex) { return "tuple_index" }
  if (tag == Tag.ArgSpread) { return "arg_spread" }
  if (tag == Tag.SliceLit) { return "slice_lit" }
  if (tag == Tag.CompositeLit) { return "composite_lit" }
  if (tag == Tag.FieldInits) { return "field_inits" }
  if (tag == Tag.FieldInit) { return "field_init" }
  if (tag == Tag.CatchBind) { return "catch_bind" }
  if (tag == Tag.CatchDefault) { return "catch_default" }
  if (tag == Tag.IfStmt) { return "if_stmt" }
  if (tag == Tag.WhileStmt) { return "while_stmt" }
  if (tag == Tag.ForOf) { return "for_of" }
  if (tag == Tag.ForIn) { return "for_in" }
  if (tag == Tag.ForC) { return "for_c" }
  if (tag == Tag.ForInf) { return "for_inf" }
  if (tag == Tag.BreakStmt) { return "break_stmt" }
  if (tag == Tag.ContinueStmt) { return "continue_stmt" }
  if (tag == Tag.FailStmt) { return "fail_stmt" }
  if (tag == Tag.SpawnStmt) { return "spawn_stmt" }
  if (tag == Tag.DeferStmt) { return "defer_stmt" }
  if (tag == Tag.IncStmt) { return "inc_stmt" }
  if (tag == Tag.DecStmt) { return "dec_stmt" }
  if (tag == Tag.SendStmt) { return "send_stmt" }
  if (tag == Tag.Assign) { return "assign" }
  if (tag == Tag.LhsList) { return "lhs_list" }
  if (tag == Tag.ExprList) { return "expr_list" }
  if (tag == Tag.MatchStmt) { return "match_stmt" }
  if (tag == Tag.ArmList) { return "arm_list" }
  if (tag == Tag.MatchArm) { return "match_arm" }
  if (tag == Tag.VariantPat) { return "variant_pat" }
  if (tag == Tag.TuplePat) { return "tuple_pat" }
  return "?"
}

// True for a leaf that renders as its source text (not `(tag ...)`).
function isLeafTag(tag: Tag): bool {
  return tag == Tag.Ident || tag == Tag.IntLit || tag == Tag.FloatLit ||
    tag == Tag.StringLit || tag == Tag.RawStringLit || tag == Tag.RuneLit ||
    tag == Tag.BoolLit || tag == Tag.NilLit
}

// The glyph for a binary/unary operator, whose Kind (§lexer) is stored as an int
// in `Node.main`. Compared against `int(Kind.X)` (C-like enum -> int, §12.9).
function opSymbol(m: int): string {
  if (m == int(Kind.Plus)) { return "+" }
  if (m == int(Kind.Minus)) { return "-" }
  if (m == int(Kind.Star)) { return "*" }
  if (m == int(Kind.Slash)) { return "/" }
  if (m == int(Kind.Percent)) { return "%" }
  if (m == int(Kind.Amp)) { return "&" }
  if (m == int(Kind.Pipe)) { return "|" }
  if (m == int(Kind.Caret)) { return "^" }
  if (m == int(Kind.Shl)) { return "<<" }
  if (m == int(Kind.Shr)) { return ">>" }
  if (m == int(Kind.Tilde)) { return "~" }
  if (m == int(Kind.AmpAmp)) { return "&&" }
  if (m == int(Kind.PipePipe)) { return "||" }
  if (m == int(Kind.Bang)) { return "!" }
  if (m == int(Kind.EqEq)) { return "==" }
  if (m == int(Kind.BangEq)) { return "!=" }
  if (m == int(Kind.Lt)) { return "<" }
  if (m == int(Kind.LtEq)) { return "<=" }
  if (m == int(Kind.Gt)) { return ">" }
  if (m == int(Kind.GtEq)) { return ">=" }
  if (m == int(Kind.ArrowLeft)) { return "<-" }
  return "?"
}

// Recursively renders node `idx`: `_` for none, source text for a leaf, else
// `(tag kids...)` with the operator glyph after `binary`/`unary`.
function dumpNode(t: Tree, src: string, idx: int): string {
  if (idx == 0) {
    return "_"
  }
  let n = getNode(t, idx)
  if (isLeafTag(n.tag)) {
    return src[n.span.start:n.span.end]
  }
  // A str_part renders quoted so empty chunks (`""`) are visible.
  if (n.tag == Tag.StrPart) {
    return "\"" + src[n.span.start:n.span.end] + "\""
  }
  let out = "(" + tagName(n.tag)
  if (n.tag == Tag.Binary || n.tag == Tag.Unary) {
    out = out + " " + opSymbol(n.main)
  }
  let kids = kidsOf(t, idx)
  let i = 0
  while (i < len(kids)) {
    out = out + " " + dumpNode(t, src, kids[i])
    i = i + 1
  }
  return out + ")"
}

// The whole tree as one s-expression (no trailing newline), matching the seed's
// `ast.dump` byte-for-byte.
function dumpAst(t: Tree, src: string): string {
  return dumpNode(t, src, t.root)
}
