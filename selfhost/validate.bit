// Self-host: the checker's VALIDATION layer, ported from the parts of
// compiler/check.zig that REJECT a program — as opposed to the parts in
// check.bit that infer its types. Until this landed, bit2 was a type
// INFERENCER with no validator: it compiled `function f(): i32 { return "hi" }`
// to a binary that prints the string's raw pointer.
//
// Why the entry point is a hook in `checkModule`'s sweep rather than a pass of
// its own: `env` is flat (one map, no per-function scoping) and `nodeTypes` is
// only cached for Binding/Call/ArrowP, so a validator that ran afterwards would
// read whichever function bound a name LAST — typing `a`'s `return x` with
// `b`'s `x`. Children precede parents in arena order, so when the sweep reaches
// a FuncDecl node its whole body is already swept and `env` holds exactly that
// function's params and locals, with no later function's yet. Validating there
// gets the seed's scoping for free (§9). The one rule this owes the sweep: read
// types, never reorder them — the arena's id order reproduces the seed's touch
// order, which method-name mangling (`name$t{id}`) and the stage3==stage4 fixed
// point both depend on.
//
// The safety rule throughout: a validator that misses an error leaves a gap, but
// one that invents an error breaks a working build. Every predicate here is
// permissive when it cannot decide — `invalid` (TypeId 0, which is also what an
// un-inferred node holds) is assignable in both directions, and any construct
// not yet walked reports nothing.

// Diagnostic codes, matching compiler/diagnostics.zig's `Code` values — the
// numbers `E%04d` renders. Named rather than inline (the parser writes its two
// bare) because the checker's registry spans 40–73.
const ecTypeMismatch = 41
const ecArgCount = 50
const ecInvalidOperand = 53
const ecMissingReturn = 55
const ecInvalidBreakContinue = 56
const ecFailOutsideFallible = 60
const ecTryOutsideFallible = 61
const ecNotCallable = 49
const ecUnknownVariant = 70
const ecNonExhaustive = 71
const ecNotIndexable = 54
const ecTupleIndexOutOfRange = 59
const ecInvalidSpread = 63
const ecNotStringable = 73
const ecMissingMethod = 51
const ecCannotInfer = 68
const ecUnknownMember = 57
const ecNakedFnInvalid = 74
const ecNosplitCallsAllocating = 75
const ecUnknownAttribute = 76
const ecExternFnInvalid = 77
const ecExternUnsupportedTarget = 78
const ecSymbolAttrInvalid = 79
const ecDuplicateSymbol = 80
const ecEntryOfInvalid = 81
const ecNonConstantExpr = 64
const ecModuleStateInvalid = 82
const ecInvalidExprStatement = 65
const ecExpectedCallExpr = 66
const ecCatchBlockIncomplete = 67

// A literal's value, or `ok: false` when the node is not one. Bit has no
// optional and no tuple return; a two-field struct is the whole story.
struct VLit {
  ok: bool,
  value: int,
}

// A folded compile-time constant (§15.4). `kind` is one of `vcInt`/`vcFloat`/
// `vcBool` and selects which payload is live — the seed's `ConstVal` union in
// the form Bit spells it. `ok: false` means "not a constant expression", which
// is the only signal §11.11 needs.
struct VConst {
  ok: bool,
  kind: int,
  ival: int,
  fval: f64,
}

// A node's span, mapped from module-global offsets back to the file the text
// came from. A module is its files CONCATENATED, so every span the parser
// produced is module-global and would otherwise render against the wrong file
// and line.
function vSpan(c: Checker, node: int): Span {
  let sp = getNode(c.tree, node).span
  let loc = fileOf(c.fileStarts, sp.start)
  return Span{ file: c.files[loc.fileIdx], start: loc.offset, end: loc.offset + (sp.end - sp.start) }
}

// ---- prim predicates (compiler/check.zig's Prim methods) --------------------
// Indexed by the seed's Prim order: 0..3 i8/i16/i32/i64, 4..7 u8/u16/u32/u64,
// 8..9 f32/f64, 10 bool, 11 string.

function vPrimIsInt(p: int): bool {
  return p >= 0 && p <= 7
}

function vPrimIsFloat(p: int): bool {
  return p == 8 || p == 9
}

// Inclusive representable range for an integer prim (§15.4). Callers must gate
// on `vPrimIsInt` — a float/bool/string prim has no range (the seed's
// `unreachable`).
function vPrimMin(p: int): int {
  if (p == 0) { return 0 - 128 }
  if (p == 1) { return 0 - 32768 }
  if (p == 2) { return 0 - 2147483648 }
  if (p == 3) { return 0 - 9223372036854775807 - 1 }
  return 0
}

function vPrimMax(p: int): int {
  if (p == 0) { return 127 }
  if (p == 1) { return 32767 }
  if (p == 2) { return 2147483647 }
  if (p == 4) { return 255 }
  if (p == 5) { return 65535 }
  if (p == 6) { return 4294967295 }
  return 9223372036854775807
}

// ---- assignability (§14.2) -------------------------------------------------

// May `nil` occupy a slot of type `ty` (§13.4)? A bare type parameter cannot:
// only structs can satisfy a `<T: I>` bound (§10.4, methods attach to
// structs/aliases), and a struct's zero value is never `nil`.
// A raw pointer's zero value is the null pointer (§11.4), so `nil` seeds it —
// the only literal that produces a `*T` value.
function vIsNilable(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  return k == TypeKind.Slice || k == TypeKind.Map || k == TypeKind.Chan ||
    k == TypeKind.Func || k == TypeKind.Interface || k == TypeKind.Ptr
}

// Does `ty` mention `invalid` anywhere inside it?
//
// A composite whose COMPONENT failed to infer is just as undecidable as a bare
// `invalid`, and the top-level id alone does not show it: an arrow function
// whose parameter type did not resolve interns as a perfectly real func type
// `(<error>) => <error>`, whose id is non-zero and compares unequal to every
// concrete `(i64) => []u8`. Reporting that is a false positive on code the seed
// accepts — the gap is bit2's inference, not the program. Same contract as a
// bare invalid, one level down.
//
// Named types (struct/enum/interface) are NOT descended into: they are nominal,
// so a struct with an un-inferred field is still exactly that struct, and two
// mentions of it are still the same type. Descending would make every named type
// containing one bad field permanently unverifiable.
function vMentionsInvalid(c: Checker, ty: int, depth: int): bool {
  if (ty == 0) {
    return true
  }
  // Bounded like typeNameDepth: a recursive generic can cycle through its own
  // instantiation, and this must terminate (Power of 10). Undecided at the
  // bottom means "no" — the outer levels already answered for anything real.
  if (depth >= 32) {
    return false
  }
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.Invalid) {
    return true
  }
  if (k == TypeKind.Slice || k == TypeKind.Array || k == TypeKind.Chan) {
    return vMentionsInvalid(c, t.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vMentionsInvalid(c, t.mapKey, depth + 1) || vMentionsInvalid(c, t.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vMentionsInvalid(c, t.result, depth + 1) || vMentionsInvalid(c, t.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    for m of t.members {
      if (vMentionsInvalid(c, m, depth + 1)) {
        return true
      }
    }
    if (k == TypeKind.Func) {
      return vMentionsInvalid(c, t.result, depth + 1)
    }
    return false
  }
  return false
}

// Structural assignability with no source-literal awareness: identity, `nil`
// into a nilable type, or an untyped constant whose DEFAULT type matches `dst`
// exactly.
function vAssignable(c: Checker, src: int, dst: int): bool {
  // `invalid` suppresses cascades — and is the id an un-inferred node still
  // holds, so this is also what keeps an inference gap from becoming a false
  // error.
  if (src == 0 || dst == 0) { return true }
  if (src == dst) { return true }
  // An `invalid` buried inside a composite is the same undecidable as a bare
  // one — see vMentionsInvalid. Checked after the identity test so two mentions
  // of the same broken type still compare equal rather than recursing.
  if (vMentionsInvalid(c, src, 0) || vMentionsInvalid(c, dst, 0)) { return true }
  // `nil` is answered before the interface branch: an interface is a reference
  // type, so `nil` is its zero value, but `nil` has no method set and would fail
  // a satisfaction test against any non-empty interface.
  if (src == c.ctx.untypedNilId) { return vIsNilable(c, dst) }
  // An interface target: the value must be storable behind an interface (a
  // struct, another interface, or nil — §14.3) AND satisfy its method set.
  // Mirrors check.zig's `assignable` interface branch. `nil` and `invalid` were
  // already answered above, so this only decides real value types.
  if (c.ctx.types[dst].kind == TypeKind.Interface) {
    return vStorableInInterface(c, src) && vSatisfies(c, src, dst)
  }
  // A type parameter on either side is accepted unchecked. Two decls that each
  // declare `<T>` get two distinct TypeParam ids, and `userTypes` keys them by
  // BARE NAME, so the last `<T>` in the module wins and an earlier decl's `T`
  // resolves to the wrong id — `expected 'T', found 'T'` on
  // tests/cases/run_generic_nested.bit, where `Opt<T>` and `Box<T>` coexist.
  // Real fix is per-decl type-param scoping; until then the ids cannot be
  // compared and the only sound answer is yes.
  if (c.ctx.types[src].kind == TypeKind.TypeParam || c.ctx.types[dst].kind == TypeKind.TypeParam) {
    return true
  }
  if (isUntyped(c, src)) {
    if (defaultType(c, src) == dst) { return true }
    // A float constant is representable in either float width. An int/rune
    // constant is range-checked by `vAssignableNode` when the source literal is
    // in hand; here, with no node, only exact-width float widening is safe.
    if (src == c.ctx.untypedFloatId && c.ctx.types[dst].kind == TypeKind.Prim) {
      return vPrimIsFloat(c.ctx.types[dst].prim)
    }
    return false
  }
  return false
}

// Is `value` representable in `dst` (§15.4)?
function vRepresentable(c: Checker, value: int, dst: int): bool {
  let t = c.ctx.types[dst]
  if (t.kind != TypeKind.Prim) { return false }
  if (vPrimIsFloat(t.prim)) { return true } // int constant widened to float
  if (!vPrimIsInt(t.prim)) { return false }
  // ponytail: u64 goes unchecked. `int` is i64 here, so a u64 literal above
  // i64::max has already wrapped in `parseIntText` and would range-check as
  // negative — rejecting the crypto tables' 0xFFFFFFFFFFFFFFFF masks. Costs the
  // `let x: u64 = -1` diagnostic; needs an i128 literal path to do properly.
  if (t.prim == 7) { return true }
  return value >= vPrimMin(t.prim) && value <= vPrimMax(t.prim)
}

// Peels at most one leading unary `+`/`-` and reports the literal value beneath,
// for range-checking a directly-written literal against a sized target (§15.4).
// Not a constant folder: a compound constant expression default-types instead,
// matching the seed's deliberately narrow `literalValue`.
function vLiteralValue(c: Checker, node: int): VLit {
  let n = node
  let negate = false
  if (getNode(c.tree, n).tag == Tag.Unary) {
    let op = getNode(c.tree, n).main
    if (op != int(Kind.Minus) && op != int(Kind.Plus)) { return VLit{ ok: false, value: 0 } }
    negate = op == int(Kind.Minus)
    n = kidsOf(c.tree, n)[0]
  }
  let nn = getNode(c.tree, n)
  let tag = nn.tag
  if (tag != Tag.IntLit && tag != Tag.RuneLit) { return VLit{ ok: false, value: 0 } }
  let text = c.source[nn.span.start:nn.span.end]
  let v = parseIntText(text)
  if (tag == Tag.RuneLit) { v = parseRuneText(text) }
  if (negate) { v = 0 - v }
  return VLit{ ok: true, value: v }
}

// ---- module-state constant folding (§15.4) --------------------------------
//
// A faithful port of seed/check.zig's `constEval`, and it must STAY faithful:
// this decides both what §11.11 accepts and what byte image lowering renders,
// so any expression the seed folds and this does not becomes a `bit check`
// pass followed by a `bit build` failure (#1430).
//
// Deliberately NOT `vLiteralValue`, which peels one sign off a literal for
// range-checking and nothing more. That narrowness is right there and wrong
// here: `let x: i64 = 0 - 1` is a constant expression by §15.4 ("constant
// expressions are evaluated at compile time"), so refusing to fold it rejects a
// legal program rather than an illegal one.

const vcInt = 0
const vcFloat = 1
const vcBool = 2
const vConstMaxDepth = 64

function vConstNone(): VConst {
  return VConst{ ok: false, kind: vcInt, ival: 0, fval: 0.0 }
}

// The initializer node of the module-level `const` named `name` in THIS module,
// or 0 when there is none. Single-module by design: the seed's `constEval`
// refuses cross-module folding outright ("out of scope" there), so resolving an
// imported `const` here would fold what the seed leaves alone and put the two
// compilers' images out of step. Bounded by the node arena, per Power-of-10.
function vConstInitNode(c: Checker, name: string): int {
  let i = 1
  while (i < len(c.tree.nodes)) {
    if (getNode(c.tree, i).tag == Tag.ConstDecl) {
      let binds = kidsOf(c.tree, i)
      let j = 0
      while (j < len(binds)) {
        let bk = kidsOf(c.tree, binds[j])
        let pat = getNode(c.tree, bk[0])
        if (pat.tag == Tag.Ident && bk[2] != 0 &&
            c.source[pat.span.start:pat.span.end] == name) {
          return bk[2]
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return 0
}

// Folds `node` to a compile-time value, or `ok: false` when it is not constant.
function vConstEval(c: Checker, node: int, depth: int): VConst {
  if (node == 0 || depth >= vConstMaxDepth) { return vConstNone() }
  let n = getNode(c.tree, node)
  let tag = n.tag
  let text = c.source[n.span.start:n.span.end]

  if (tag == Tag.IntLit) {
    return VConst{ ok: true, kind: vcInt, ival: parseIntText(text), fval: 0.0 }
  }
  if (tag == Tag.RuneLit) {
    return VConst{ ok: true, kind: vcInt, ival: parseRuneText(text), fval: 0.0 }
  }
  if (tag == Tag.FloatLit) {
    return VConst{ ok: true, kind: vcFloat, ival: 0, fval: parseFloat(text) }
  }
  if (tag == Tag.BoolLit) {
    let b = 0
    if (text == "true") { b = 1 }
    return VConst{ ok: true, kind: vcBool, ival: b, fval: 0.0 }
  }

  if (tag == Tag.Unary) {
    let v = vConstEval(c, kidsOf(c.tree, node)[0], depth + 1)
    if (!v.ok) { return vConstNone() }
    let op = n.main
    if (op == int(Kind.Plus)) { return v }
    if (op == int(Kind.Minus)) {
      if (v.kind == vcInt) { return VConst{ ok: true, kind: vcInt, ival: 0 - v.ival, fval: 0.0 } }
      if (v.kind == vcFloat) { return VConst{ ok: true, kind: vcFloat, ival: 0, fval: 0.0 - v.fval } }
      return vConstNone()
    }
    if (op == int(Kind.Bang)) {
      if (v.kind != vcBool) { return vConstNone() }
      let b = 1
      if (v.ival != 0) { b = 0 }
      return VConst{ ok: true, kind: vcBool, ival: b, fval: 0.0 }
    }
    return vConstNone()
  }

  if (tag == Tag.Binary) {
    let k = kidsOf(c.tree, node)
    let a = vConstEval(c, k[0], depth + 1)
    if (!a.ok) { return vConstNone() }
    let b = vConstEval(c, k[1], depth + 1)
    if (!b.ok) { return vConstNone() }
    // Integer operands only — the seed folds no float binary either, and
    // matching it matters more than folding more.
    if (a.kind != vcInt || b.kind != vcInt) { return vConstNone() }
    let op = n.main
    let x = a.ival
    let y = b.ival
    if (op == int(Kind.Plus)) { return vConstInt(x + y) }
    if (op == int(Kind.Minus)) { return vConstInt(x - y) }
    if (op == int(Kind.Star)) { return vConstInt(x * y) }
    if (op == int(Kind.Slash)) {
      if (y == 0) { return vConstNone() }
      return vConstInt(x / y)
    }
    if (op == int(Kind.Percent)) {
      if (y == 0) { return vConstNone() }
      return vConstInt(x % y)
    }
    if (op == int(Kind.Amp)) { return vConstInt(x & y) }
    if (op == int(Kind.Pipe)) { return vConstInt(x | y) }
    if (op == int(Kind.Caret)) { return vConstInt(x ^ y) }
    if (op == int(Kind.Shl)) {
      if (y < 0 || y > 127) { return vConstNone() }
      return vConstInt(x << y)
    }
    if (op == int(Kind.Shr)) {
      if (y < 0 || y > 127) { return vConstNone() }
      return vConstInt(x >> y)
    }
    return vConstNone()
  }

  if (tag == Tag.Ident) {
    let init = vConstInitNode(c, text)
    if (init == 0) { return vConstNone() }
    return vConstEval(c, init, depth + 1)
  }

  return vConstNone()
}

function vConstInt(v: int): VConst {
  return VConst{ ok: true, kind: vcInt, ival: v, fval: 0.0 }
}

// The real assignability entry point: `node` is the source expression being
// assigned or returned, used to range-check a direct integer literal against a
// sized target; falls back to `vAssignable` otherwise.
function vAssignableNode(c: Checker, node: int, src: int, dst: int): bool {
  if (src == 0 || dst == 0) { return true }
  if (src == c.ctx.untypedIntId || src == c.ctx.untypedRuneId) {
    if (c.ctx.types[dst].kind == TypeKind.Prim) {
      let lit = vLiteralValue(c, node)
      if (lit.ok) { return vRepresentable(c, lit.value, dst) }
    }
  }
  return vAssignable(c, src, dst)
}

// Only a struct (or another interface value, or nil) can be the concrete type
// behind an interface — an interface value IS the receiver's object pointer
// (ABI.md §2.1, §14.3), so a scalar has nothing to point to. Mirrors check.zig's
// storableInInterface.
function vStorableInInterface(c: Checker, src: int): bool {
  if (src == 0 || src == c.ctx.untypedNilId) {
    return true
  }
  let k = c.ctx.types[src].kind
  return k == TypeKind.Struct || k == TypeKind.Interface || k == TypeKind.Invalid
}

// Emits E0041 with rendered expected/found type names. Every assignability
// failure funnels through here, so this is the one place that explains the
// struct-only interface rule (§14.3) — mirroring check.zig's `mismatch`, whose
// generic "expected 'Any', found 'i64'" reads as nonsense for an empty interface
// a scalar structurally "fits".
function vMismatch(c: Checker, node: int, expected: int, found: int) {
  let en = typeName(c.ctx, expected)
  let fnd = typeName(c.ctx, found)
  if (c.ctx.types[expected].kind == TypeKind.Interface && !vStorableInInterface(c, found)) {
    report(c.diags, ecTypeMismatch, vSpan(c, node),
      "cannot store '${fnd}' in interface '${en}': only a struct can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a non-struct has nothing to point to (§14.3)")
    return
  }
  reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node), "expected '${en}', found '${fnd}'")
}

// Checks `node`'s type `ty` against `target`, emitting E0041 on failure.
// `target == 0` (invalid) means "no expectation" and is always a no-op, matching
// invalid's cascade-suppression contract.
function vExpect(c: Checker, node: int, ty: int, target: int) {
  if (target == 0) { return }
  if (!vAssignableNode(c, node, ty, target)) {
    vMismatch(c, node, target, ty)
  }
}

// ---- expressions -----------------------------------------------------------

// A binary operator whose operands do not admit it (§14.2, E0053).
//
// Reported HERE and not in `checkBinary`, because `checkExprType` is a recompute
// rather than a cache: the sweep runs it at every Binding/Call node and this walk
// runs it again, so an emit down there would fire twice for one expression. The
// seed can emit inline only because its single recursive walk visits each node
// exactly once.
//
// The whole rule lives in check.bit (`joinOperandTypes` / `numericBinaryOk`) and
// is asked, not restated — one operator rule, two callers: the type it yields and
// the error it justifies must never disagree.
function vBinary(c: Checker, node: int) {
  let n = getNode(c.tree, node)
  let kids = kidsOf(c.tree, node)
  let a = checkExprType(c, kids[0])
  let b = checkExprType(c, kids[1])
  // An operand that did not infer is bit2's gap, not the program's — and the
  // seed suppresses here too (`if (lty == .invalid or rty == .invalid)`).
  if (a == 0 || b == 0) { return }
  if (vMentionsInvalid(c, a, 0) || vMentionsInvalid(c, b, 0)) { return }
  // ponytail: comparisons (`==`, `<`, `&&`) are not checked yet — the seed gates
  // them on `comparable`/`hasOrdering`/bool operands, none of which are ported.
  // Arithmetic and bitwise are, and they are where E0053 actually fires.
  if (isComparisonOp(n.main)) { return }
  if (n.main == int(Kind.Plus) && stringish(c, a) && stringish(c, b)) { return }
  // Pointer arithmetic (§11.4): `p + n` / `p - n` advance a `*T` by
  // `n * sizeOf(T)` bytes and yield a `*T`. Carved out before the numeric path,
  // exactly as string concatenation is above.
  if ((n.main == int(Kind.Plus) || n.main == int(Kind.Minus)) &&
      c.ctx.types[a].kind == TypeKind.Ptr && isIntegerOperand(c, b)) { return }
  let joined = joinOperandTypes(c, kids[0], kids[1], a, b)
  if (numericBinaryOk(c, joined, isBitwiseOp(n.main))) { return }
  let ln = typeName(c.ctx, a)
  let rn = typeName(c.ctx, b)
  reportNoHint(c.diags, ecInvalidOperand, vSpan(c, node),
    "operator not defined for '${ln}' and '${rn}'")
}

// ---- the statement walk ----------------------------------------------------

// `return` (§16.2) against the enclosing function's declared result.
function vReturn(c: Checker, result: int, node: int) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0) {
    if (result != c.ctx.voidId && result != 0) {
      reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node),
        "'return' needs a value: this function's result is not void")
    }
    return
  }
  if (len(kids) == 1) {
    vExpect(c, kids[0], checkExprType(c, kids[0]), result)
    return
  }
  // ponytail: `return a, b` builds a tuple result (§13.1), unvalidated. The seed
  // interns the tuple to compare against; interning a type here would append ids
  // the seed does not have at this point, and the id order is the fixed point's.
}

// Validates a call's argument COUNT against a plain free function's declared
// parameter count (E0050). Deliberately permissive — the seed's full call check
// also covers builtins, conversions, type constructors, variadics, and generic
// arity, each with its own rule; porting only the common fixed-arity free-call
// case keeps FALSEPOS at 0 by SKIPPING everything undecidable here:
//   - a non-identifier callee (method/member/computed call);
//   - a name that is not a known free function (builtin, constructor, or a
//     local variable holding a function value — a call_value, not a decl);
//   - a name shadowed by a local binding (the call targets the value, not the
//     free function of the same name);
//   - a generic function (kids[2] present) — the seed resolves its arity
//     through instantiation, not a bare parameter count.
// `print` (fd 1) and `eprint` (fd 2) share one signature: exactly one `string`
// argument, void result (seed check.zig ~2659, ABI.md §12). This is the one
// builtin arg-type check bit needs — the rest of vCall punts on builtins on
// purpose. Guards on a bit2 inference gap (arg type 0 / mentions-invalid) so it
// never becomes a false positive; the assignability itself is vExpect's, so
// `print("x")` (untyped string) and interpolations pass while `print(x)` for a
// non-string x is E0041 with the seed's exact text.
function vPrintCall(c: Checker, node: int, name: string) {
  let args = kidsOf(c.tree, kidsOf(c.tree, node)[2])
  let got = len(args)
  if (got != 1) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'${name}' takes exactly 1 argument, found ${got}")
  }
  if (got >= 1) {
    let a = args[0]
    if (getNode(c.tree, a).tag == Tag.Arg) { a = kidsOf(c.tree, a)[0] }
    let t = checkExprType(c, a)
    if (t == 0 || vMentionsInvalid(c, t, 0)) { return }
    vExpect(c, a, t, primType(c.ctx, 11))
  }
}

function vCall(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) { return }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]
  if (envLookup(c, name) != 0) { return } // a local shadows the free function
  // PRECEDENCE: a user declaration shadows the predeclared name (SPEC 17.5), so
  // the declaration is consulted BEFORE the `print`/`eprint` arity+type rule.
  // Checked the other way round, a program declaring its own `print(x: int)` was
  // validated against the BUILTIN's `(string)` signature and rejected with a
  // spurious E0041. Matches the precedence checkCall and lowerCall now use.
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    if (name == "print" || name == "eprint") { vPrintCall(c, node, name); return }
    return // builtin / constructor / not a free function
  }
  // The decl's params live in its OWNING module's tree (declOwner), which is
  // `c` itself for a local function and the exporter for an imported one.
  let owner = declOwner(c, name)
  // Reads the param list through declParamListNode so a §11.7 extern — three
  // kids, params at 1 — is measured against its own shape rather than a
  // FuncDecl's.
  let plist = declParamListNode(owner, decl)
  if (plist < 0) { return } // generic: arity resolved by instantiation
  let params = kidsOf(owner.tree, plist)
  let want = len(params)
  let args = kidsOf(c.tree, kids[2])
  let got = len(args)
  // A variadic `...xs: T` absorbs every argument past the fixed ones, so only
  // the fixed prefix has an exact arity (§12.4). Mirrors the seed's three cases.
  let variadic = want > 0 &&
    getNode(owner.tree, params[want - 1]).tag == Tag.ParamRest
  let fixed = want
  if (variadic) {
    fixed = want - 1
  }
  // `f(...xs)` spreads a slice into the variadic slot and must sit exactly after
  // the fixed arguments; the spread itself is one argument, not a count of them.
  // E0063 rejects a spread that is duplicated, aimed at a non-variadic callee,
  // or not final — reported at the spread argument, as the seed does. A bad
  // spread still falls through to the arity check below: the seed emits both.
  let spreadAt = -1
  let ai = 0
  while (ai < got) {
    if (getNode(c.tree, args[ai]).tag == Tag.ArgSpread) {
      if (spreadAt >= 0 || !variadic || ai != got - 1) {
        reportNoHint(c.diags, ecInvalidSpread, vSpan(c, args[ai]),
          "'...' spread is only valid as the final argument of a variadic call")
      }
      spreadAt = ai
    }
    ai = ai + 1
  }
  if (spreadAt >= 0) {
    if (spreadAt != fixed) {
      reportNoHint(c.diags, ecArgCount, vSpan(c, node),
        "expected ${fixed} argument(s) before '...', found ${spreadAt}")
    }
    return
  }
  if (variadic) {
    if (got < fixed) {
      reportNoHint(c.diags, ecArgCount, vSpan(c, node),
        "expected at least ${fixed} argument(s), found ${got}")
    }
    return
  }
  if (want != got) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "expected ${want} argument(s), found ${got}")
  }
}

// Whether a node opens a `break`-able construct (for/while/switch/select) and,
// separately, a `continue`-able one (for/while only) — the seed's two counters.
// ---- E0065 invalid-expr-statement / E0066 expected-call-expr ---------------
// Both are pure AST-SHAPE rules — they read only the statement's kid tag, never
// a type — so neither can be confused by the flat env, and neither needs the
// permissive escape hatch the type-directed checks carry.

// A statement-position expression whose result may be discarded (§18.3).
// `catch` is legal for the same reason a bare call is: at statement position it
// is deliberate error handling, not an accidentally-unused value. Ported from
// check.zig `checkExprStmt`; the list must stay in step with it.
function vLegalExprStmt(c: Checker, inner: int): bool {
  let n = getNode(c.tree, inner)
  if (n.tag == Tag.Call || n.tag == Tag.TryExpr || n.tag == Tag.CatchDefault ||
    n.tag == Tag.CatchBind || n.tag == Tag.AsmStmt) {
    return true
  }
  // A channel receive `<-c` is a unary whose operator is `<-`.
  return n.tag == Tag.Unary && n.main == int(Kind.ArrowLeft)
}

function vExprStmt(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0 || kids[0] == 0) { return }
  if (vLegalExprStmt(c, kids[0])) { return }
  reportNoHint(c.diags, ecInvalidExprStatement, vSpan(c, node),
    "expression result unused; only a call, channel receive, '?' chain, or 'catch' is a valid statement")
}

// `spawn`/`defer` take a call and nothing else (check.zig `checkSpawnDefer`).
// A `catch e { … }` block's LAST statement, when it is a bare expression, is
// the block's VALUE — not a discarded result — so E0065 must not fire on it
// (check.zig `checkCatchBlock` type-checks it against the ok type instead of
// routing it through `checkExprStmt`). vStmt is a generic tag-dispatch walk, so
// without this it visited that tail like any other statement: 80 FALSEPOS, all
// of them working `catch` blocks.
//
// Handling the block here rather than through a shared exempt-set keeps the
// exemption local to the one construct that has it. `catch <expr>` (CatchDefault)
// has no block and needs nothing.
//
// E0067 rides along because the seed derives it from the same walk: a block that
// neither ends in a value expression nor diverts control is incomplete.
function vCatchBind(c: Checker, result: int, node: int, brk: int, loop: int, fallible: bool) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) < 3) { return }
  let block = kids[2]
  vStmt(c, result, kids[0], brk, loop, fallible)
  if (block == 0) { return }
  let stmts = kidsOf(c.tree, block)
  if (len(stmts) == 0) {
    reportNoHint(c.diags, ecCatchBlockIncomplete, vSpan(c, block),
      "'catch' block must produce a value or divert control (return/fail/panic/break/continue)")
    return
  }
  let last = stmts[len(stmts) - 1]
  let i = 0
  while (i < len(stmts) - 1) {
    vStmt(c, result, stmts[i], brk, loop, fallible)
    i = i + 1
  }
  if (getNode(c.tree, last).tag == Tag.ExprStmt) {
    // The value expression: validate what is INSIDE it, never the statement
    // wrapper (that wrapper is what E0065 judges).
    let inner = kidsOf(c.tree, last)
    if (len(inner) > 0) {
      vStmt(c, result, inner[0], brk, loop, fallible)
    }
    return
  }
  vStmt(c, result, last, brk, loop, fallible)
  if (!vDiverges(c, last, true)) {
    reportNoHint(c.diags, ecCatchBlockIncomplete, vSpan(c, block),
      "'catch' block must produce a value or divert control (return/fail/panic/break/continue)")
  }
}

function vSpawnDefer(c: Checker, node: int, word: string) {
  let kids = kidsOf(c.tree, node)
  if (len(kids) == 0 || kids[0] == 0) { return }
  if (getNode(c.tree, kids[0]).tag == Tag.Call) { return }
  reportNoHint(c.diags, ecExpectedCallExpr, vSpan(c, node),
    "'${word}' requires a call expression")
}

function vIsLoop(t: Tag): bool {
  return t == Tag.ForC || t == Tag.ForOf || t == Tag.ForIn || t == Tag.ForInf || t == Tag.WhileStmt
}
function vIsBreakable(t: Tag): bool {
  return vIsLoop(t) || t == Tag.SwitchStmt || t == Tag.SelectStmt
}

// Walks `node` validating statements, carrying the enclosing function's declared
// result type plus the loop/fallible context the seed tracks: `brk` counts
// break-able constructs, `loop` counts for/while (continue targets those only),
// and `fallible` is set inside a `T!` function. Descends every child; a node
// with nothing to check falls through.
function vStmt(c: Checker, result: int, node: int, brk: int, loop: int, fallible: bool) {
  if (node == 0) { return }
  let t = getNode(c.tree, node).tag
  // An arrow function has its own result AND its own loop/fallible context, so
  // nothing inside it is validated against THIS function. ponytail: skipping it
  // under-reports; descending would judge it against the wrong context.
  if (t == Tag.ArrowFn) { return }
  if (t == Tag.Binary) { vBinary(c, node) }
  if (t == Tag.ReturnStmt) { vReturn(c, result, node) }
  if (t == Tag.Call) { vCall(c, node) }
  if (t == Tag.Call) { vNotCallable(c, node) }
  if (t == Tag.Call) { vVariantArity(c, node) }
  if (t == Tag.Call) { vGenericBound(c, node) }
  if (t == Tag.Call) { vUnmanagedBuiltin(c, node) }
  if (t == Tag.StrInterp) { vInterp(c, node) }
  if (t == Tag.Index) { vIndex(c, node) }
  if (t == Tag.TupleIndex) { vTupleIndex(c, node) }
  if (t == Tag.Member) { vMember(c, node) }
  if (t == Tag.TypeAssert) { vTypeAssert(c, node) }
  if (t == Tag.Assign) { vDestructure(c, node) }
  if (t == Tag.Assign) { vAssignIface(c, node) }
  if (t == Tag.Binding) { vInferEnum(c, node) }
  if (t == Tag.Binding) { vBindingIface(c, node) }
  if (t == Tag.CompositeLit) { vCompositeIface(c, node) }
  if (t == Tag.Call) { vCallArgIface(c, node) }
  if (t == Tag.SendStmt) { vSendIface(c, node) }
  if (t == Tag.AsmStmt) { vAsm(c, node) }
  if (t == Tag.MatchStmt) { vMatch(c, node) }
  if (t == Tag.MatchStmt) { vMatchExpr(c, node) }
  if (t == Tag.ExprStmt) { vExprStmt(c, node) }
  if (t == Tag.SpawnStmt) { vSpawnDefer(c, node, "spawn") }
  if (t == Tag.DeferStmt) { vSpawnDefer(c, node, "defer") }
  // Owns its own kid recursion (its block's tail is a value, not a statement).
  if (t == Tag.CatchBind) {
    vCatchBind(c, result, node, brk, loop, fallible)
    return
  }
  if (t == Tag.BreakStmt && brk == 0) {
    reportNoHint(c.diags, ecInvalidBreakContinue, vSpan(c, node),
      "'break' outside a for/while/switch/select")
  }
  if (t == Tag.ContinueStmt && loop == 0) {
    reportNoHint(c.diags, ecInvalidBreakContinue, vSpan(c, node),
      "'continue' outside a for/while loop")
  }
  if (t == Tag.FailStmt && !fallible) {
    reportNoHint(c.diags, ecFailOutsideFallible, vSpan(c, node),
      "'fail' is only valid inside a fallible function")
  }
  if (t == Tag.TryExpr && !fallible) {
    reportNoHint(c.diags, ecTryOutsideFallible, vSpan(c, node),
      "'?' is only valid inside a fallible function")
  }
  let cbrk = brk
  let cloop = loop
  if (vIsLoop(t)) {
    cbrk = brk + 1
    cloop = loop + 1
  } else if (vIsBreakable(t)) {
    cbrk = brk + 1
  }
  for k of kidsOf(c.tree, node) {
    vStmt(c, result, k, cbrk, cloop, fallible)
  }
}

// ---- E0055 missing-return: control-flow divergence (§10.3) -----------------
// Ported from check.zig `diverges`. The rule: a non-void function whose body is
// not proven to always divert control (return / fail / panic / infinite loop /
// exhaustive all-arms-diverge) is missing a return. Conservative TOWARD NOT
// EMITTING — any construct that cannot be proven to fall through is treated as
// diverging — because a missed missing_return is a harmless gap (the seed still
// gates) but a spurious one rejects a valid build. The corpus is code the seed
// accepts, so every non-void body must read as diverging here or the diffcheck
// FALSEPOS gate fires; that gate is what proves this port faithful.

// The while-condition is the literal `true`. bit2 has no const-evaluator, so a
// const that folds to true is not recognised (under-detects vs the seed's
// constEval — but that only under-reports, never false-positives; `for {}` is
// the idiomatic infinite loop and is handled exactly via ForInf).
function vIsTrueLit(c: Checker, node: int): bool {
  if (node == 0 || getNode(c.tree, node).tag != Tag.BoolLit) { return false }
  let sp = getNode(c.tree, node).span
  return c.source[sp.start:sp.end] == "true"
}

// A call to the builtin `panic` (diverges). Mirrors the seed's isPanicCall: the
// callee is the bare name `panic`, shadowed by neither a local value nor a user
// function (the same permissiveness vCall uses to identify a builtin).
function vIsPanicCall(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.Call) { return false }
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) { return false }
  let cn = getNode(c.tree, callee)
  let name = c.source[cn.span.start:cn.span.end]
  return name == "panic" && envLookup(c, name) == 0 && funcDeclLookup(c, name) == 0
}

// Does `node` (a loop body) contain a `break` targeting THIS loop — i.e. one not
// shadowed by a nested loop/switch/select? Bounded depth, mirrors the seed.
function vContainsOwnBreak(c: Checker, node: int, depth: int): bool {
  if (node == 0 || depth >= 64) { return false }
  let t = getNode(c.tree, node).tag
  if (t == Tag.BreakStmt) { return true }
  if (t == Tag.ForC || t == Tag.ForOf || t == Tag.ForIn || t == Tag.ForInf ||
      t == Tag.WhileStmt || t == Tag.SwitchStmt || t == Tag.SelectStmt) { return false }
  if (t == Tag.Block || t == Tag.StmtList) {
    for s of kidsOf(c.tree, node) {
      if (vContainsOwnBreak(c, s, depth + 1)) { return true }
    }
    return false
  }
  if (t == Tag.IfStmt) {
    let k = kidsOf(c.tree, node) // [cond, then, else]
    if (vContainsOwnBreak(c, k[1], depth + 1)) { return true }
    if (k[2] != 0) { return vContainsOwnBreak(c, k[2], depth + 1) }
    return false
  }
  return false
}

// Any statement in a block/stmt-list diverges.
function vBlockDiverges(c: Checker, node: int, countBrk: bool): bool {
  for s of kidsOf(c.tree, node) {
    if (vDiverges(c, s, countBrk)) { return true }
  }
  return false
}

// Does executing `node` guarantee control never falls through past it? (§10.3)
function vDiverges(c: Checker, node: int, countBrk: bool): bool {
  if (node == 0) { return false }
  let t = getNode(c.tree, node).tag
  if (t == Tag.ReturnStmt || t == Tag.FailStmt) { return true }
  if (t == Tag.BreakStmt || t == Tag.ContinueStmt) { return countBrk }
  if (t == Tag.Block) { return vBlockDiverges(c, node, countBrk) }
  if (t == Tag.ExprStmt) { return vIsPanicCall(c, kidsOf(c.tree, node)[0]) }
  if (t == Tag.IfStmt) {
    let k = kidsOf(c.tree, node) // [cond, then, else]
    if (k[2] == 0) { return false }
    return vDiverges(c, k[1], countBrk) && vDiverges(c, k[2], countBrk)
  }
  if (t == Tag.WhileStmt) {
    let k = kidsOf(c.tree, node) // [cond, body]
    if (vIsTrueLit(c, k[0])) { return !vContainsOwnBreak(c, k[1], 0) }
    return false
  }
  if (t == Tag.ForInf) { return !vContainsOwnBreak(c, kidsOf(c.tree, node)[0], 0) }
  if (t == Tag.ForC || t == Tag.ForOf || t == Tag.ForIn) { return false }
  if (t == Tag.SwitchStmt) {
    let k = kidsOf(c.tree, node) // [subject, case_list]
    let hasDefault = false
    let all = true
    for cse of kidsOf(c.tree, k[1]) {
      let ct = getNode(c.tree, cse).tag
      if (ct == Tag.SwitchCase) {
        if (!vBlockDiverges(c, kidsOf(c.tree, cse)[1], countBrk)) { all = false }
      } else if (ct == Tag.SwitchDefault) {
        hasDefault = true
        if (!vBlockDiverges(c, kidsOf(c.tree, cse)[0], countBrk)) { all = false }
      }
    }
    return hasDefault && all
  }
  if (t == Tag.MatchStmt) {
    let k = kidsOf(c.tree, node) // [subject, arm_list]
    let arms = kidsOf(c.tree, k[1])
    if (len(arms) == 0) { return false }
    for arm of arms {
      if (!vDiverges(c, kidsOf(c.tree, arm)[1], countBrk)) { return false }
    }
    return true
  }
  if (t == Tag.SelectStmt) {
    let clauses = kidsOf(c.tree, node)
    if (len(clauses) == 0) { return true } // `select {}` blocks forever
    for cl of clauses {
      let clt = getNode(c.tree, cl).tag
      let body = 0
      if (clt == Tag.CommCase) {
        body = kidsOf(c.tree, cl)[1]
      } else if (clt == Tag.CommDefault) {
        body = kidsOf(c.tree, cl)[0]
      } else {
        continue
      }
      if (!vBlockDiverges(c, body, countBrk)) { return false }
    }
    return true
  }
  return false
}

// ---- E0073 not-stringable: string interpolation operands (§5.7) ------------

// Whether `ty` has a `show(): string` method. Struct and interface method sets
// are keyed uniformly as `"${typeId}.method"`, so one lookup covers both; a
// wrong-shaped `show` (any parameters, or a non-string result) does not count.
function vHasShow(c: Checker, ty: int): bool {
  let sig = methodSigLookup(c, "${ty}.show")
  if (sig == 0) { return false }
  let st = c.ctx.types[sig]
  return len(st.members) == 0 && st.result == primType(c.ctx, 11)
}

// §5.7: a value interpolates iff it is a primitive or has a `show(): string`
// method. The caller defaults untyped constants first (they adopt a prim), so
// only untyped nil, void, composites, and show-less named types reach false.
function vStringConvertible(c: Checker, ty: int): bool {
  if (c.ctx.types[ty].kind == TypeKind.Prim) { return true }
  return vHasShow(c, ty)
}

// Does `ty` still mention a rigid type parameter, at any depth? A generic body
// is checked once against its own `T`, so an operand naming `T` cannot be judged
// here — the seed defers it to each monomorphization (which bit2 does not
// re-check). Skipping such operands leaves the generic interpolation MISSING
// (safe) instead of judging it against the un-substituted `T`.
function vHasTypeParam(c: Checker, ty: int, depth: int): bool {
  if (depth >= 32) { return true } // undecided -> skip, never invent an error
  let t = c.ctx.types[ty]
  let k = t.kind
  if (k == TypeKind.TypeParam) { return true }
  if (k == TypeKind.Slice || k == TypeKind.Chan || k == TypeKind.Array) {
    return vHasTypeParam(c, t.elem, depth + 1)
  }
  if (k == TypeKind.Map) {
    return vHasTypeParam(c, t.mapKey, depth + 1) || vHasTypeParam(c, t.mapVal, depth + 1)
  }
  if (k == TypeKind.Fallible) {
    return vHasTypeParam(c, t.result, depth + 1) || vHasTypeParam(c, t.errTy, depth + 1)
  }
  if (k == TypeKind.Tuple || k == TypeKind.Func) {
    for m of t.members {
      if (vHasTypeParam(c, m, depth + 1)) { return true }
    }
    if (k == TypeKind.Func) { return vHasTypeParam(c, t.result, depth + 1) }
    return false
  }
  return false
}

// Validates a `"...${expr}..."` interpolation: every operand part must convert to
// string. Parts alternate literal `StrPart` chunks and operand expressions.
function vInterp(c: Checker, node: int) {
  for p of kidsOf(c.tree, node) {
    if (p == 0 || getNode(c.tree, p).tag == Tag.StrPart) { continue }
    // Prefer the type the SWEEP already cached for this node: it is the
    // authoritative one (it feeds --dump-types and matches the seed), and it is
    // present because the operand's node precedes this FuncDecl in arena order.
    // A fresh checkExprType recompute can diverge on a nested generic call —
    // genericResultAt re-binds a type param the cached pass left unbound, so
    // `unwrap(Opt<Opt<i64>>): i64` recomputes as 'Opt'. Fall back to a recompute
    // only for operands the sweep does not cache (a bare ident use).
    let ty = c.nodeTypes[p]
    if (ty == 0) { ty = checkExprType(c, p) }
    ty = defaultType(c, ty)
    // Undecidable operands are skipped (the safety rule): an inference gap
    // (`invalid`, bare or nested) or an open type param must never become a
    // spurious diagnostic on code the seed accepts.
    if (ty == 0 || vMentionsInvalid(c, ty, 0) || vHasTypeParam(c, ty, 0)) { continue }
    if (!vStringConvertible(c, ty)) {
      report(c.diags, ecNotStringable, vSpan(c, p),
        "cannot interpolate a value of type '${typeName(c.ctx, ty)}'",
        "only primitives and types with a 'show(): string' method convert to string")
    }
  }
}

// ---- E0050 variant-construction arity (§13.7) ------------------------------

// Checks `Enum.Variant(args)` builds the variant with the right number of
// payload values. Only a member callee whose base names an enum type and whose
// variant exists is judged (unknown variants are E0070's concern elsewhere); the
// span is the whole call, matching the seed. Method calls skip here — their base
// is a value, not a type, so userTypeLookup misses.
function vVariantArity(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(c.tree, callee) // [base, name]
  let baseName = typeNodeName(c, mk[0])
  if (baseName == "") {
    return
  }
  let ut = userTypeLookup(c, baseName)
  if (ut == 0 || c.ctx.types[ut].kind != TypeKind.Enum) {
    return
  }
  let vn = getNode(c.tree, mk[1])
  let vname = c.source[vn.span.start:vn.span.end]
  if (vIndexOfName(vEnumVariantNames(c, ut), vname) < 0) {
    return
  }
  let want = len(variantPayloadTypes(c, ut, vname))
  let got = len(kidsOf(c.tree, kids[2]))
  if (want != got) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "variant '${vname}' takes ${want} argument(s), found ${got}")
  }
}

// ---- E0051 generic bound violation (§15.3) ---------------------------------

// Checks a generic free-function call's inferred type arguments against each
// type parameter's interface bound (E0051) — ported from check.zig's
// `instantiateFunc`. The bound is read straight off the decl's type-param node
// (not the flat `typeParamConstraints`, which the last `<T: I>` in the module
// clobbers), and the arg comes from the same `genericTypeArgs` the sweep records
// instantiations with, so the pairing matches the seed's env exactly. The safety
// rule gates every judgement: only a confidently-concrete arg against a
// concrete, non-generic interface bound is tested — an unbound (void) or
// un-inferred arg is skipped so an inference gap never becomes a false positive
// (the seed emits E0068 for those, elsewhere). Method-call / member callees are
// left alone; only a bare-ident free generic reaches here.
function vGenericBound(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]
  if (envLookup(c, name) != 0) {
    return // a local value shadows the free function
  }
  if (!isGenericFunc(c, name)) {
    return
  }
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return
  }
  // The decl's type-param and constraint nodes live in its OWNING module's tree.
  let oc = declOwner(c, name)
  let dk = kidsOf(oc.tree, decl) // [recv, name, generics, params, result, body]
  let tps = kidsOf(oc.tree, dk[2])
  let args = genericTypeArgs(c, name, node)
  if (len(args) != len(tps)) {
    return
  }
  let i = 0
  while (i < len(tps)) {
    let gk = kidsOf(oc.tree, tps[i]) // [name, constraint_group?]
    if (gk[1] != 0) {
      let cons = kidsOf(oc.tree, gk[1])
      if (len(cons) > 0) {
        let boundIface = typeFromNode(oc, cons[0])
        let arg = args[i]
        if (arg != 0 && arg != c.ctx.voidId && !vMentionsInvalid(c, arg, 0) &&
            !vHasTypeParam(c, arg, 0) && boundIface != 0 &&
            !vMentionsInvalid(c, boundIface, 0) && !vHasTypeParam(c, boundIface, 0) &&
            c.ctx.types[boundIface].kind == TypeKind.Interface &&
            !vSatisfies(c, arg, boundIface)) {
          report(c.diags, ecMissingMethod, vSpan(c, node),
            "type argument ${i} does not satisfy its interface bound",
            "check the interface's method set against this type")
        }
      }
    }
    i = i + 1
  }
}

// ---- E0068 cannot-infer enum type arguments (§14.7) ------------------------

// The number of `<...>` type parameters on an enum's declaration (0 for a plain
// enum). The generics node is kid 1 of the EnumDecl, in the declaring module's
// tree.
function vEnumGenericArity(c: Checker, enumTy: int): int {
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return 0
  }
  return len(kidsOf(oc.tree, kidsOf(oc.tree, decl)[1]))
}

// Emits E0068 for `let x = Enum.Variant` where `Enum` is GENERIC and `Variant`
// carries no payload — ported from check.zig's `checkVariantRef`/`enumInstance`.
// A bare no-payload variant reference carries no argument to solve the enum's
// type parameters, so without an annotated target the instantiation is
// unsolvable. Restricted to the un-annotated binding context precisely because
// that is the one place `expected` is provably absent: an annotation, a return
// target, or a call-argument slot all supply it, and check.bit does not thread
// that expectation, so judging any other context risks a false positive. A
// payload variant is a constructor CALL (handled elsewhere, and it can infer
// from its args); an unknown variant name is E0070's concern; a plain (non-
// generic) enum's variant is already concrete.
function vInferEnum(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  if (kids[1] != 0) {
    return // annotated: the target type supplies the arguments
  }
  let init = kids[2]
  if (init == 0 || getNode(c.tree, init).tag != Tag.Member) {
    return
  }
  let mk = kidsOf(c.tree, init) // [base, name]
  // A turbofish base `Opt<i64>.None` (a GenericInst) supplies the type arguments
  // explicitly — the seed resolves it via `enumTurbofish` before ever reaching
  // the cannot-infer path. Only a BARE enum name has nothing to solve `T` with.
  if (getNode(c.tree, mk[0]).tag != Tag.Ident) {
    return
  }
  let baseName = typeNodeName(c, mk[0])
  if (baseName == "") {
    return
  }
  let ut = userTypeLookup(c, baseName)
  if (ut == 0 || c.ctx.types[ut].kind != TypeKind.Enum) {
    return
  }
  if (vEnumGenericArity(c, ut) == 0) {
    return // a plain enum's variant is already concrete
  }
  let vn = getNode(c.tree, mk[1])
  let vname = c.source[vn.span.start:vn.span.end]
  if (vIndexOfName(vEnumVariantNames(c, ut), vname) < 0) {
    return // not a real variant — E0070's concern, elsewhere
  }
  if (len(variantPayloadTypes(c, ut, vname)) != 0) {
    return // a payload variant is a constructor call, which infers from its args
  }
  reportNoHint(c.diags, ecCannotInfer, vSpan(c, mk[1]),
    "cannot infer type arguments for '${baseName}'; annotate the target type")
}

// ---- E0070 / E0071: enum match arms (§13.8) --------------------------------

// The declared variant names of an enum, in declaration order. Variant nodes and
// their names live in the DECLARING module's tree, reached via typeOwner.
function vEnumVariantNames(c: Checker, enumTy: int): []string {
  let out = []string(0)
  let oc = typeOwner(c, enumTy)
  let decl = enumDeclOf(c, enumTy)
  if (decl == 0) {
    return out
  }
  for v of enumVariantNodes(oc, decl) {
    let vn = getNode(oc.tree, kidsOf(oc.tree, v)[0])
    out = append(out, oc.source[vn.span.start:vn.span.end])
  }
  return out
}

function vIndexOfName(names: []string, name: string): int {
  let i = 0
  while (i < len(names)) {
    if (names[i] == name) {
      return i
    }
    i = i + 1
  }
  return -1
}

// E0041 (§13.8): in a `match` expression every arm's body must yield one common
// type — the first arm fixes it (defaulted), the rest must be assignable. Runs
// for every match: a statement match's arm bodies are `expr_stmt`/`block` nodes,
// which `checkExprType` types as invalid (0), so `result` stays 0 and vExpect is
// a no-op — only a value-yielding expression match is judged. No position
// tracking needed.
function vMatchExpr(c: Checker, node: int) {
  let arms = kidsOf(c.tree, kidsOf(c.tree, node)[1])
  let result = 0
  let i = 0
  while (i < len(arms)) {
    let body = kidsOf(c.tree, arms[i])[1]
    let got = checkExprType(c, body)
    if (result == 0) {
      result = defaultType(c, got)
    } else {
      vExpect(c, body, got, result)
    }
    i = i + 1
  }
}

// Validates a `match` over an enum: every arm names a real variant (E0070) and
// every variant is handled (E0071). The subject type is required to be a
// confidently-known enum — an open type param or an un-inferred component is
// skipped (safety rule). Every arm pattern is a VariantPat[name, binders], so the
// name extraction is uniform. E0070 anchors on the arm pattern, E0071 on the
// subject, and unhandled variants are reported in declaration order — matching
// the seed's checkMatch.
function vMatch(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [subject, arm_list]
  let subjectTy = defaultType(c, checkExprType(c, k[0]))
  if (subjectTy == 0 || vMentionsInvalid(c, subjectTy, 0) || vHasTypeParam(c, subjectTy, 0)) {
    return
  }
  if (c.ctx.types[subjectTy].kind != TypeKind.Enum) {
    return
  }
  let variants = vEnumVariantNames(c, subjectTy)
  if (len(variants) == 0) {
    return
  }
  let seen = []bool(len(variants))
  for arm of kidsOf(c.tree, k[1]) {
    let pat = kidsOf(c.tree, arm)[0]
    if (getNode(c.tree, pat).tag != Tag.VariantPat) {
      continue
    }
    let nameNode = getNode(c.tree, kidsOf(c.tree, pat)[0])
    let vname = c.source[nameNode.span.start:nameNode.span.end]
    let idx = vIndexOfName(variants, vname)
    if (idx < 0) {
      reportNoHint(c.diags, ecUnknownVariant, vSpan(c, pat), "no variant '${vname}' on this enum")
    } else {
      seen[idx] = true
    }
  }
  let i = 0
  while (i < len(variants)) {
    if (!seen[i]) {
      reportNoHint(c.diags, ecNonExhaustive, vSpan(c, k[0]),
        "non-exhaustive 'match': variant '${variants[i]}' is not handled")
    }
    i = i + 1
  }
}

// ---- E0049 not-callable: call target (§18.1) -------------------------------

// A predeclared builtin function name (§5.3) — callable but not a user decl.
function vIsBuiltinFunc(name: string): bool {
  for f of predeclaredFuncs() {
    if (f == name) {
      return true
    }
  }
  return false
}

// Emits E0049 when `x()` calls a value that is not a function. Only a bare-ident
// callee is judged. Every callable SPELLING is checked before the env probe — a
// user function, a first-class function value's name, a primitive conversion, a
// type used as a constructor, or a builtin — because bit2's env is flat: a param
// named `rounds` in one function would otherwise read back over a `function
// rounds`, inventing an error. Only a name that is none of those AND binds to a
// concrete non-func value reaches the emit. Member / type-node callees (method
// calls, `Enum.Variant(..)`, `chan<T>(..)`) are left to the checker's own paths.
function vNotCallable(c: Checker, node: int) {
  let callee = kidsOf(c.tree, node)[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let cn = getNode(c.tree, callee)
  let name = c.source[cn.span.start:cn.span.end]
  if (funcDeclLookup(c, name) != 0 || funcSigLookup(c, name) != 0) {
    return // a user function (possibly imported) or first-class function value
  }
  if (primIndexByName(name) >= 0 || userTypeLookup(c, name) != 0 || vIsBuiltinFunc(name)) {
    return // a conversion `i64(x)`, a type constructor, or a builtin
  }
  let ev = envLookup(c, name)
  if (ev == 0 || vMentionsInvalid(c, ev, 0) || vHasTypeParam(c, ev, 0)) {
    return
  }
  if (c.ctx.types[ev].kind == TypeKind.Func) {
    return // a func-typed local value is callable
  }
  reportNoHint(c.diags, ecNotCallable, vSpan(c, callee), "value is not callable")
}

// ---- E0054 not-indexable: index receiver (§16.1) ---------------------------

// Only a slice, array, map, or string can be indexed (§16.1); the receiver type
// is used AS-IS, never defaulted, so `1[0]` reads 'untyped int' just as the seed
// renders it.
function vIsIndexable(c: Checker, ty: int): bool {
  let t = c.ctx.types[ty]
  if (t.kind == TypeKind.Slice || t.kind == TypeKind.Array || t.kind == TypeKind.Map) {
    return true
  }
  return t.kind == TypeKind.Prim && t.prim == 11
}

// Emits E0054 at the receiver when `recv[i]` indexes a non-indexable value. The
// span is the receiver (kids[0]), matching the seed's one-caret anchor. An open
// type param is skipped (permissive): a bare `T` receiver is undecidable here.
function vIndex(c: Checker, node: int) {
  let recv = kidsOf(c.tree, node)[0]
  let rt = checkExprType(c, recv)
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  if (!vIsIndexable(c, rt)) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, recv), "'${typeName(c.ctx, rt)}' cannot be indexed")
  }
}

// `t.N` (§13.4) needs a tuple receiver and an in-range index. Mirrors the seed's
// checkTupleIndex, including its two anchors: the receiver for a non-tuple
// (E0054, sharing vIndex's wording), the index leaf for out-of-range (E0059).
// An un-inferred or type-param receiver is skipped — permissive when undecided.
function vTupleIndex(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node)
  let rt = checkExprType(c, kids[0])
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  let t = c.ctx.types[rt]
  if (t.kind != TypeKind.Tuple) {
    reportNoHint(c.diags, ecNotIndexable, vSpan(c, kids[0]),
      "'${typeName(c.ctx, rt)}' cannot be indexed")
    return
  }
  let n = getNode(c.tree, kids[1])
  let i = parseIntText(c.source[n.span.start:n.span.end])
  if (i < 0 || i >= len(t.members)) {
    reportNoHint(c.diags, ecTupleIndexOutOfRange, vSpan(c, kids[1]),
      "tuple index ${i} out of range for a ${len(t.members)}-element tuple")
  }
}

// ---- E0057 unknown member (§13.4) ------------------------------------------

// Levenshtein distance between two names, ported from check.zig `editDistance`.
// The 64-byte cap is the seed's: longer names return the cap, which exceeds the
// distance-3 hint threshold, so an over-long name simply yields no hint. Two
// rolling rows rather than a full matrix, exactly as the seed does.
function vEditDistance(a: string, b: string): int {
  let maxLen = 64
  if (len(a) > maxLen || len(b) > maxLen) {
    return maxLen
  }
  let prev = []int(maxLen + 1)
  let cur = []int(maxLen + 1)
  let j = 0
  while (j <= len(b)) {
    prev[j] = j
    j = j + 1
  }
  let i = 1
  while (i <= len(a)) {
    cur[0] = i
    j = 1
    while (j <= len(b)) {
      let cost = 1
      if (a[i - 1] == b[j - 1]) {
        cost = 0
      }
      let best = cur[j - 1] + 1
      if (prev[j] + 1 < best) {
        best = prev[j] + 1
      }
      if (prev[j - 1] + cost < best) {
        best = prev[j - 1] + cost
      }
      cur[j] = best
      j = j + 1
    }
    // Swap the rows. Both are fully rewritten above before being read again, so
    // sharing the backing arrays by reference is safe.
    let tmp = prev
    prev = cur
    cur = tmp
    i = i + 1
  }
  return prev[len(b)]
}

// Is `key` PRESENT in a member table, whatever type it maps to? The lookups in
// check.bit answer "what type", conflating an absent member with one whose type
// did not resolve; judging by absence needs the distinction.
function vHasMember(table: map<string, int>, key: string): bool {
  for (k, v) of table {
    if (k == key) {
      return true
    }
  }
  return false
}

// The method name on `recvTy` closest to `wanted`, or "" when none is within
// edit distance 3 (check.zig `closestMethodName`). Ties go to the first key
// visited, matching the seed's strictly-less-than comparison over its method
// bucket. `methodResults` is the complete method set for a type — it carries the
// predeclared `error.message` that `methodSigs` omits.
function vClosestMethodName(c: Checker, recvTy: int, wanted: string): string {
  let prefix = "${recvTy}."
  let best = ""
  let bestDist = 64 + 1
  for (k, v) of c.ctx.methodResults {
    if (len(k) > len(prefix) && k[0:len(prefix)] == prefix) {
      let name = k[len(prefix):len(k)]
      let d = vEditDistance(name, wanted)
      if (d < bestDist) {
        bestDist = d
        best = name
      }
    }
  }
  if (bestDist > 3) {
    return "" // too far apart to be a useful hint
  }
  return best
}

// Emits E0057 when `recv.name` is neither a field of the receiver nor a method
// on it (check.zig `checkMember`'s tail).
//
// The safety rule bites hard here — this validator judges by ABSENCE, so every
// gap in the member tables reads as an error. It fires only when the receiver's
// type is confidently concrete AND is a shape whose members are fully known:
//   - an unresolved receiver (0), one mentioning `invalid`, or one carrying an
//     unbound type param is skipped (the seed dispatches a type param through
//     its constraint; a template body is re-checked per monomorphization);
//   - a receiver that is a MODULE NAMESPACE or an enum TYPE name is not a value
//     at all — `strings.trim` / `Color.Red` are resolved elsewhere and carry
//     their own diagnostics (E0067 unexported_name, E0057 unknown variant);
//   - only Struct and Interface receivers are judged. Every other kind (slice,
//     map, prim, chan, fallible, func) reaches members exclusively through
//     methods, and a builtin method the tables do not model would false-positive.
function vMember(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, name]
  let recv = kids[0]
  // `Enum.Variant` / a namespace member: the base names a TYPE or MODULE, not a
  // value. `checkMember` resolves those separately.
  if (typeNodeName(c, recv) != "" && userTypeLookup(c, typeNodeName(c, recv)) != 0) {
    return
  }
  if (vIsNamespaceRef(c, recv)) {
    return
  }
  if (!vDeclRooted(c, recv, 0)) {
    return
  }
  let rt = checkExprType(c, recv)
  if (rt == 0 || vMentionsInvalid(c, rt, 0) || vHasTypeParam(c, rt, 0)) {
    return
  }
  let kind = c.ctx.types[rt].kind
  if (kind != TypeKind.Struct && kind != TypeKind.Interface) {
    return
  }
  let mn = getNode(c.tree, kids[1])
  let mname = c.source[mn.span.start:mn.span.end]
  let key = "${methodRecvType(c, rt)}." + mname
  // PRESENCE, not a non-zero type. A member whose own type failed to resolve —
  // `cipher: AesCipher` when the module declaring AesCipher is not loaded, which
  // is every single-file check of a multi-file stdlib module — is recorded with
  // type 0, which a `!= 0` lookup cannot tell apart from "no such member". That
  // read turned a cascade into 13 invented E0057s across stdlib/crypto and tls.
  if (vHasMember(c.ctx.structFields, key) || vHasMember(c.ctx.methodResults, key) ||
    vHasMember(c.ctx.methodSigs, key)) {
    return
  }
  let hint = vClosestMethodName(c, methodRecvType(c, rt), mname)
  if (hint == "") {
    reportNoHint(c.diags, ecUnknownMember, vSpan(c, kids[1]),
      "no field or method '${mname}' on this type")
    return
  }
  report(c.diags, ecUnknownMember, vSpan(c, kids[1]),
    "no field or method '${mname}' on this type", "did you mean '${hint}'?")
}

// Does this expression's type trace back to a DECL the resolver resolved, rather
// than to the module-wide flat `env`? Judging a member by ABSENCE is only sound
// on a receiver whose type is trustworthy, and the flat-env fallback is not: a
// name it cannot resolve reads back as whatever same-named local another
// function left behind, so a perfectly valid `e.extType` gets judged against an
// unrelated struct.
//
// Binder-bound names (for-of, match-arm payload, catch, comma-ok) are
// deliberately absent from `declTypes` — they are typed best-effort in pre-pass 3
// (see `envBind`) — so they read as not-decl-rooted and are skipped. That
// under-reports E0057 inside loop and match-arm bodies, which is the correct
// trade: the seed still gates, and this validator must never invent. Coverage
// widens on its own once binders move onto the decl-path too.
//
// Depth-bounded: a receiver chain is walked to its base ident.
function vDeclRooted(c: Checker, node: int, depth: int): bool {
  if (node == 0 || depth > 16) {
    return false
  }
  let t = getNode(c.tree, node).tag
  if (t == Tag.Ident) {
    return declRefType(c, node) != 0
  }
  // An explicit type node fixes the type outright.
  if (t == Tag.CompositeLit || t == Tag.TypeAssert) {
    return true
  }
  if (t == Tag.Member || t == Tag.Index || t == Tag.Call || t == Tag.TryExpr) {
    return vDeclRooted(c, kidsOf(c.tree, node)[0], depth + 1)
  }
  return false
}

// Is `node` a bare reference to an imported MODULE namespace (`strings` in
// `strings.trim(s)`)? A namespace is not a value, so its member access must not
// be judged as a field/method lookup. Answered from the resolver's symbol table;
// without a resolver (the bare dump entry points) this returns false and the
// receiver's unresolved type (0) skips the check anyway.
function vIsNamespaceRef(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.Ident) {
    return false
  }
  if (node < 0 || node >= len(c.nodeSymbols)) {
    return false
  }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) {
    return false
  }
  let k = c.symbols[sid].kind
  return k == SymbolKind.ImportNamespace || k == SymbolKind.StructType ||
    k == SymbolKind.EnumType || k == SymbolKind.InterfaceType ||
    k == SymbolKind.TypeAlias || k == SymbolKind.BuiltinType
}

// ---- E0041 impossible type assertion (§14.4) -------------------------------

// Does candidate type `cand` satisfy interface `iface` — i.e. carry every one of
// its methods with a matching signature (§14.3)? Both a struct method and an
// interface method intern their `(params) => result` shape into methodSigs, and
// interning dedups, so equal ids mean equal shapes. Non-generic interfaces only
// (a Self-parameterised one is skipped by the type-param guard at the call site).
function vSatisfies(c: Checker, cand: int, iface: int): bool {
  if (cand == 0 || iface == 0) {
    return true // cascade suppression
  }
  if (c.ctx.types[iface].kind != TypeKind.Interface) {
    return cand == iface
  }
  let prefix = "${iface}."
  for (k, sig) of c.ctx.methodSigs {
    if (len(k) > len(prefix) && k[0:len(prefix)] == prefix) {
      let name = k[len(prefix):len(k)]
      let have = methodSigLookup(c, "${cand}." + name)
      if (have == 0 || have != sig) {
        return false
      }
    }
  }
  return true
}

// Emits E0041 when `iface.(T)` asserts a target that can never be the dynamic
// type held in the interface — T does not satisfy the interface, so the assertion
// is false forever (§14.4). Only fires for a confidently-known interface receiver
// and concrete target; the span covers the whole `recv.(T)`.
function vTypeAssert(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [recv, typeNode]
  let recvTy = checkExprType(c, kids[0])
  let target = typeFromNode(c, kids[1])
  if (recvTy == 0 || target == 0) {
    return
  }
  if (vMentionsInvalid(c, recvTy, 0) || vMentionsInvalid(c, target, 0)) {
    return
  }
  if (vHasTypeParam(c, recvTy, 0) || vHasTypeParam(c, target, 0)) {
    return
  }
  if (c.ctx.types[recvTy].kind != TypeKind.Interface) {
    return
  }
  if (!vSatisfies(c, target, recvTy)) {
    reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node),
      "impossible type assertion: '${typeName(c.ctx, target)}' does not satisfy '${typeName(c.ctx, recvTy)}'")
  }
}

// ---- E0041 destructuring assignment needs a two-result form (§12.6) --------

// A parenthesized two-target assignment `(a, b) = rhs` only type-checks when the
// right side is a two-result form — `m[k]`, `<- c`, or `iface.(T)` (§12.6/§14.4/
// §16.2). The parser folds `(a, b)` into a single `tuple_pat` lhs item, so the
// plain arity check waves it through; this catches an rhs that is none of those.
// Conservative: any of the three two-result tags is skipped (a slice `m[k]` that
// the seed would still reject stays MISSING, never a false positive).
function vDestructure(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [lhs_list, rhs_list]
  let lhsItems = kidsOf(c.tree, k[0])
  let rhsItems = kidsOf(c.tree, k[1])
  if (len(lhsItems) != 1 || len(rhsItems) != 1) {
    return
  }
  let lhs0 = lhsItems[0]
  if (getNode(c.tree, lhs0).tag != Tag.TuplePat || len(kidsOf(c.tree, lhs0)) != 2) {
    return
  }
  let rhs = rhsItems[0]
  let rn = getNode(c.tree, rhs)
  if (rn.tag == Tag.Index || rn.tag == Tag.TypeAssert) {
    return
  }
  if (rn.tag == Tag.Unary && rn.main == int(Kind.ArrowLeft)) {
    return // `<- c` receive
  }
  reportNoHint(c.diags, ecTypeMismatch, vSpan(c, node),
    "destructuring assignment needs a two-result form on the right: 'm[k]', '<- c', or 'iface.(T)'")
}

// ---- E0041 interface-scalar store: every path a value reaches an interface ---
// slot (§14.3). The `return` site is already caught by vExpect (vAssignable now
// gates an interface target on storable+satisfies); these walkers cover the
// other slots the seed checks with the same `expect` — an annotated binding, a
// plain assignment, a call argument, a struct/map/slice literal element, and a
// channel send. Each stays NARROW: it fires only for a confidently-concrete,
// non-storable (scalar) value against a confirmed interface target, emitting the
// one special "cannot store" message. A storable-but-non-satisfying value is
// left to vExpect's path, never re-judged here — porting general satisfaction
// into every slot would risk the false positives vSatisfies edge cases invite.

function vIfaceStore(c: Checker, valueNode: int, target: int) {
  if (target == 0 || c.ctx.types[target].kind != TypeKind.Interface) {
    return
  }
  let v = valueNode
  if (getNode(c.tree, v).tag == Tag.Arg) {
    v = kidsOf(c.tree, v)[0]
  }
  let ty = checkExprType(c, v)
  if (ty == 0 || vMentionsInvalid(c, ty, 0) || vHasTypeParam(c, ty, 0)) {
    return
  }
  if (!vStorableInInterface(c, ty)) {
    report(c.diags, ecTypeMismatch, vSpan(c, v),
      "cannot store '${typeName(c.ctx, ty)}' in interface '${typeName(c.ctx, target)}': only a struct can be the concrete type behind an interface value",
      "an interface value is the receiver's object pointer, so a non-struct has nothing to point to (§14.3)")
  }
}

// An annotated binding: a direct interface target `let a: Any = 5`, or a slice
// literal's elements against a `[]Iface` annotation's element type.
function vBindingIface(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [pat, annotation, init]
  let ann = kids[1]
  let init = kids[2]
  if (ann == 0 || init == 0 || getNode(c.tree, kids[0]).tag == Tag.TuplePat) {
    return
  }
  let target = typeFromNode(c, ann)
  if (target == 0) {
    return
  }
  let tk = c.ctx.types[target].kind
  if (tk == TypeKind.Interface) {
    vIfaceStore(c, init, target)
    return
  }
  if (tk == TypeKind.Slice && getNode(c.tree, init).tag == Tag.SliceLit) {
    let elem = c.ctx.types[target].elem
    for a of kidsOf(c.tree, init) {
      vIfaceStore(c, a, elem)
    }
  }
}

// A composite literal `S{...}` / `map<K,V>{...}` / `[]T{...}`: each field / map
// entry / element value against its declared slot type.
function vCompositeIface(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [type, init]
  let target = typeFromNode(c, kids[0])
  if (target == 0) {
    return
  }
  let init = kids[1]
  let tk = c.ctx.types[target].kind
  if (tk == TypeKind.Struct) {
    for fi of kidsOf(c.tree, init) {
      if (getNode(c.tree, fi).tag != Tag.FieldInit) {
        continue
      }
      let fk = kidsOf(c.tree, fi) // [name, expr]
      let fnn = getNode(c.tree, fk[0])
      let fname = c.source[fnn.span.start:fnn.span.end]
      vIfaceStore(c, fk[1], structFieldLookup(c, "${target}." + fname))
    }
    return
  }
  if (tk == TypeKind.Map) {
    let keyTy = c.ctx.types[target].mapKey
    let valTy = c.ctx.types[target].mapVal
    for me of kidsOf(c.tree, init) {
      if (getNode(c.tree, me).tag != Tag.MapEntry) {
        continue
      }
      let mk = kidsOf(c.tree, me) // [key, val]
      vIfaceStore(c, mk[0], keyTy)
      vIfaceStore(c, mk[1], valTy)
    }
    return
  }
  if (tk == TypeKind.Slice || tk == TypeKind.Array) {
    let elem = c.ctx.types[target].elem
    for a of kidsOf(c.tree, init) {
      vIfaceStore(c, a, elem)
    }
  }
}

// A plain `=` assignment: each rhs against its lhs slot's type. Compound
// assignments (`+=`, ...) are numeric and never store into an interface; the
// two-result `(a, b) = ...` form is vDestructure's.
function vAssignIface(c: Checker, node: int) {
  if (getNode(c.tree, node).main != int(Kind.Eq)) {
    return
  }
  let k = kidsOf(c.tree, node) // [lhs_list, rhs_list]
  let lhs = kidsOf(c.tree, k[0])
  let rhs = kidsOf(c.tree, k[1])
  if (len(lhs) != len(rhs)) {
    return
  }
  let i = 0
  while (i < len(lhs)) {
    if (getNode(c.tree, lhs[i]).tag != Tag.TuplePat) {
      let lty = checkExprType(c, lhs[i])
      if (lty != 0 && c.ctx.types[lty].kind == TypeKind.Interface) {
        vIfaceStore(c, rhs[i], lty)
      }
    }
    i = i + 1
  }
}

// A free-function call's arguments against interface-typed parameters. Mirrors
// vCall's resolution: a bare-ident, non-shadowed, non-generic user function
// only — a generic's params carry bare `T` (skipped), and member/builtin callees
// are the checker's own paths.
function vCallArgIface(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  let callee = kids[0]
  if (getNode(c.tree, callee).tag != Tag.Ident) {
    return
  }
  let sp = getNode(c.tree, callee).span
  let name = c.source[sp.start:sp.end]
  if (envLookup(c, name) != 0) {
    return
  }
  let decl = funcDeclLookup(c, name)
  if (decl == 0) {
    return
  }
  let owner = declOwner(c, name)
  let plist = declParamListNode(owner, decl)
  if (plist < 0) {
    return // generic: param types carry bare `T`
  }
  let params = kidsOf(owner.tree, plist)
  let args = kidsOf(c.tree, kids[2])
  let i = 0
  while (i < len(params) && i < len(args)) {
    vIfaceStore(c, args[i], typeFromNode(owner, kidsOf(owner.tree, params[i])[1]))
    i = i + 1
  }
}

// A channel send `ch <- v`: the sent value against the channel's element type.
function vSendIface(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [chan_expr, value_expr]
  let chanTy = checkExprType(c, k[0])
  if (chanTy == 0 || c.ctx.types[chanTy].kind != TypeKind.Chan) {
    return
  }
  vIfaceStore(c, k[1], c.ctx.types[chanTy].elem)
}

// ---- §11.5 atomics and ptrOf -----------------------------------------------

// Argument count for an atomic builtin (§11.5), or -1 when `name` is not one:
// load takes `(p)`, store and the rmw family `(p, v)`, cmpxchg `(p, old, new)`.
function vAtomicArity(name: string): int {
  if (name == "atomicLoad") { return 1 }
  if (name == "atomicStore") { return 2 }
  if (name == "atomicCmpxchg") { return 3 }
  if (name == "atomicAdd" || name == "atomicSub" || name == "atomicAnd" ||
      name == "atomicOr" || name == "atomicXchg") { return 2 }
  return -1
}

// True when `name` is a builtin NUMERIC prim type, including the aliases
// (§11.1: `int`=i64, `uint`=u64, `byte`=u8, `rune`=i32). Used by the `@nosplit`
// callee rule (§10.3.1): a call on one of these names is a conversion (§12.9)
// that lowers to register work, never an allocation or a safepoint. `bool`,
// `string` and `error` are deliberately absent — `string(x)` allocates.
//
// Mirrors the seed's `builtinTypeId` + `Prim.isNumeric` test in
// seed/check.zig's `nosplitWalk`. Kept as an explicit name list because the
// self-hosted validator has no prim-name table to derive it from; if a numeric
// prim is ever added to §11.1, it must be added here too.
function vIsNumericPrimName(name: string): bool {
  if (name == "i8" || name == "i16" || name == "i32" || name == "i64") { return true }
  if (name == "u8" || name == "u16" || name == "u32" || name == "u64") { return true }
  if (name == "f32" || name == "f64") { return true }
  return name == "int" || name == "uint" || name == "byte" || name == "rune"
}

// An integer prim — the only element type the atomics and `ptrOf` accept.
function vIsIntegerPrim(c: Checker, ty: int): bool {
  if (ty == 0) { return false }
  let t = c.ctx.types[ty]
  return t.kind == TypeKind.Prim && vPrimIsInt(t.prim)
}

// The first argument must be a `*T` over an integer `T`; every remaining
// argument is checked against `T` (§11.5). check.bit only INFERS the result from
// the pointer's element, so without this a wrong target reached lowering.
function vAtomicCall(c: Checker, node: int, name: string, arity: int, args: []int) {
  if (len(args) == 0) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'${name}' takes a '*T' pointer as its first argument")
    return
  }
  let ptrTy = checkExprType(c, kidsOf(c.tree, args[0])[0])
  if (ptrTy == 0 || c.ctx.types[ptrTy].kind != TypeKind.Ptr) {
    // An un-inferred argument (0) is bit2's gap, not the program's — the seed
    // suppresses on `.invalid` here for the same reason.
    if (ptrTy != 0) {
      let pn = typeName(c.ctx, ptrTy)
      reportNoHint(c.diags, ecInvalidOperand, vSpan(c, args[0]),
        "'${name}' requires a '*T' pointer, found '${pn}'")
    }
    return
  }
  let elem = c.ctx.types[ptrTy].elem
  let elemOk = vIsIntegerPrim(c, elem)
  if (!elemOk) {
    let en = typeName(c.ctx, elem)
    reportNoHint(c.diags, ecInvalidOperand, vSpan(c, args[0]),
      "'${name}' requires an integer target, found '*${en}'")
  }
  if (len(args) != arity) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'${name}' takes exactly ${arity} argument(s), found ${len(args)}")
  }
  // Every value argument (all but the pointer) is checked against `T`.
  let i = 1
  while (i < len(args)) {
    let inner = kidsOf(c.tree, args[i])[0]
    let t = checkExprType(c, inner)
    if (elemOk) { vExpect(c, inner, t, elem) }
    i = i + 1
  }
}

// True iff a value of `ty` is UNTRACED — a word (or block of words) the
// collector never follows: integers, floats, bools, raw `*T` (§11.4), and fixed
// `[N]U` arrays of those. Mirrors the seed's `untracedType`.
//
// Deliberately a whitelist, not the negation of "is a reference": a type this
// does not recognize must fall on the safe side (rejected), because the cost of
// a wrong "yes" is a GC reference living in memory the collector never scans — a
// silently dangling pointer, not a compile error.
function vUntracedType(c: Checker, ty: int, depth: int): bool {
  if (depth > 8) { return false }   // bounded: refuse rather than recurse forever
  let t = c.ctx.types[ty]
  if (t.kind == TypeKind.Prim) { return t.prim != 11 }   // 11 = string
  if (t.kind == TypeKind.Ptr) { return true }
  if (t.kind == TypeKind.Array) { return vUntracedType(c, t.elem, depth + 1) }
  return false
}

// Module-level mutable state (§11.11). Three rules, enforced HERE in the
// checker rather than at lowering, so an invalid program gets a real diagnostic
// instead of a late `cannot lower` build failure:
//
//   1. The type must be untraced. Module state is emitted as a static `.data`
//      cell that no root scanner walks, so a reference stored in one would be
//      invisible to the collector and freed while still reachable.
//   2. The initializer must be a compile-time constant. The cell ships as a byte
//      image in the object file; there is no run-time init pass, so there is
//      also no initialization-order question to get wrong.
//   3. The pattern must be a single name — destructuring a module-level `let`
//      has no meaning for a statically laid out cell.
function vModuleState(c: Checker, binding: int) {
  if (c.resolveFailed) { return }
  let k = kidsOf(c.tree, binding)   // [pattern, type_or_none, init_or_none]
  let pat = k[0]
  if (getNode(c.tree, pat).tag != Tag.Ident) {
    report(c.diags, ecModuleStateInvalid, vSpan(c, pat),
      "module-level 'let' must bind a single name",
      "destructuring is not available at module scope")
    return
  }
  let ty = c.nodeTypes[pat]
  if (ty == 0) { return }   // already diagnosed upstream; don't pile on
  // A type that mentions `invalid` anywhere is a guess built on an earlier
  // error (an un-inferrable arrow parameter, say). Reporting against it invents
  // an error the seed does not raise — stay permissive, per this file's header.
  if (vMentionsInvalid(c, ty, 0)) { return }
  if (!vUntracedType(c, ty, 0)) {
    let n = typeName(c.ctx, ty)
    report(c.diags, ecModuleStateInvalid, vSpan(c, pat),
      "module-level 'let' cannot hold '${n}': only untraced types may live at module scope",
      "module state is not scanned by the collector, so it may hold integers, floats, bools, raw '*T' pointers, or fixed arrays of those — but never a reference (§11.11)")
    return
  }
  if (k[2] == 0) { return }
  // An array global is zero-valued only: rendering `[N]T{...}` into a static
  // image needs a per-element constant evaluator that does not exist, and no
  // consumer wants one (§11.11).
  if (c.ctx.types[ty].kind == TypeKind.Array) {
    report(c.diags, ecModuleStateInvalid, vSpan(c, pat),
      "module-level array 'let' cannot have an initializer",
      "a module-level array is zero-valued; assign its elements at run time")
    return
  }
  // Decided by the SAME folder lowering renders the byte image with, so the two
  // stages cannot disagree (#1430). The old test was a tag blacklist: it caught
  // `foo()` but passed `0 - 1`, which lowering then could not render, so the
  // build failed naming whichever FUNCTION referenced the cell rather than the
  // declaration that was actually at fault.
  //
  // Rejecting on a failed fold rather than on a syntactic guess stays within
  // this file's permissive rule because the folder is a faithful port of the
  // seed's `constEval`: what it refuses, the seed refuses too.
  if (!vConstEval(c, k[2], 0).ok) {
    report(c.diags, ecNonConstantExpr, vSpan(c, k[2]),
      "module-level 'let' initializer must be a compile-time constant expression",
      "module state is emitted as a static byte image, so there is no run-time initializer")
  }
}

// `ptrOf(s: []T): *T` (§11.5): the address of `s`'s element 0, the only bridge
// from a traced slice to a raw `*T` (Bit has no `&`). `T` must be an integer
// prim — the same targets the atomics accept.
function vPtrOfCall(c: Checker, node: int, args: []int) {
  if (len(args) != 1) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'ptrOf' takes exactly 1 argument, found ${len(args)}")
    return
  }
  let inner = kidsOf(c.tree, args[0])[0]
  let sliceTy = checkExprType(c, inner)
  // Module-level state (§11.11) is addressable: its cell has a static address,
  // so this is the addressability the atomic builtins need. Restricted to
  // module scope on purpose — a local has no stable address to hand out, which
  // is exactly why `&` stays reserved.
  if (vIsModuleStateRef(c, inner)) {
    let mel = sliceTy
    if (mel != 0 && c.ctx.types[mel].kind == TypeKind.Array) {
      mel = c.ctx.types[mel].elem
    }
    if (!vIsIntegerPrim(c, mel)) {
      let mn = typeName(c.ctx, mel)
      reportNoHint(c.diags, ecInvalidOperand, vSpan(c, args[0]),
        "'ptrOf' requires an integer element, found '${mn}'")
    }
    return
  }
  if (sliceTy == 0 || c.ctx.types[sliceTy].kind != TypeKind.Slice) {
    if (sliceTy != 0) {
      let sn = typeName(c.ctx, sliceTy)
      reportNoHint(c.diags, ecInvalidOperand, vSpan(c, args[0]),
        "'ptrOf' requires a slice '[]T' or module-level state, found '${sn}'")
    }
    return
  }
  let elem = c.ctx.types[sliceTy].elem
  if (!vIsIntegerPrim(c, elem)) {
    let en = typeName(c.ctx, elem)
    reportNoHint(c.diags, ecInvalidOperand, vSpan(c, args[0]),
      "'ptrOf' requires an integer element, found '[]${en}'")
  }
}

// E0081 (§11.10): `entryOf(f)` requires a direct reference to a named function
// declaration, and that restriction is the design rather than an implementation
// limit. A bare entry address is only meaningful when it denotes one fixed body
// the linker can relocate against:
//
//   - a CLOSURE is a (code, env) pair, and the captured environment is exactly
//     what makes calling it mean anything. Handing back the code half alone
//     yields an address that would run against somebody else's environment, or
//     none — no honest answer exists, so this refuses to invent one;
//   - a GENERIC has no single body until instantiated, so no one address;
//   - an EXTERN function's body lives in another image (§11.7).
//
// Rejected HERE rather than in lowering, so an offending program gets a
// diagnostic instead of passing `bit check` and failing to emit. Mirrors the
// seed's checkEntryOf.
function vEntryOfCall(c: Checker, node: int, args: []int) {
  if (len(args) != 1) {
    reportNoHint(c.diags, ecArgCount, vSpan(c, node),
      "'entryOf' takes exactly 1 argument, found ${len(args)}")
    return
  }
  let inner = kidsOf(c.tree, args[0])[0]
  let argTy = checkExprType(c, inner)
  if (getNode(c.tree, inner).tag != Tag.Ident) {
    if (argTy != 0) {
      report(c.diags, ecEntryOfInvalid, vSpan(c, args[0]),
        "'entryOf' requires a named function",
        "the operand must name a function declaration, not a value")
    }
    return
  }
  let name = vIdentText(c, inner)
  // A local binding shadows the declaration, so the name no longer denotes it —
  // the same guard vUnmanagedBuiltin applies to the builtin name itself.
  let shadowed = envLookup(c, name) != 0
  if (shadowed || funcDeclLookup(c, name) == 0) {
    if (argTy != 0) {
      let detail = "the operand must name a function declaration, not a value"
      if (c.ctx.types[argTy].kind == TypeKind.Func) {
        detail = "a closure carries a captured environment, so its code address alone would not be callable"
      }
      report(c.diags, ecEntryOfInvalid, vSpan(c, args[0]),
        "'entryOf' requires a named function", detail)
    }
    return
  }
  if (isGenericFunc(c, name)) {
    report(c.diags, ecEntryOfInvalid, vSpan(c, args[0]),
      "'entryOf' cannot take the address of generic function '${name}'",
      "a generic has no single body until it is instantiated, so there is no one entry address")
    return
  }
  if (externSymbolOf(c, name) != "") {
    report(c.diags, ecEntryOfInvalid, vSpan(c, args[0]),
      "'entryOf' cannot take the address of extern function '${name}'",
      "an extern function's body lives in another image; only a call to it is expressible (§11.7)")
  }
}

// True iff `node` is a bare reference to a module-level `let` (§11.11) — the
// one thing besides a slice that `ptrOf` accepts.
function vIsModuleStateRef(c: Checker, node: int): bool {
  if (getNode(c.tree, node).tag != Tag.Ident) { return false }
  if (node < 0 || node >= len(c.nodeSymbols)) { return false }
  let sid = c.nodeSymbols[node]
  if (sid <= 0 || sid >= len(c.symbols)) { return false }
  let sym = c.symbols[sid]
  return sym.kind == SymbolKind.LetBinding && sym.moduleScoped
}

// Dispatches the §11.5 builtins. Separate from vCall, which returns early on a
// builtin (it resolves no decl); the local-shadow guard is the same one.
function vUnmanagedBuiltin(c: Checker, node: int) {
  let kids = kidsOf(c.tree, node) // [callee, generic_args, arg_list]
  if (getNode(c.tree, kids[0]).tag != Tag.Ident) { return }
  let name = vIdentText(c, kids[0])
  if (envLookup(c, name) != 0) { return } // a local shadows the builtin
  // ...and so does a user declaration of the same name (SPEC 17.5), which is
  // legal — E0048 is only a warning. Without this a program declaring its own
  // `ptrOf`/`entryOf`/`atomicAdd` was validated against the BUILTIN's operand
  // rules and rejected. Same precedence vCall, checkCall and lowerCall use.
  if (funcDeclLookup(c, name) != 0) { return }
  let args = kidsOf(c.tree, kids[2])
  let arity = vAtomicArity(name)
  if (arity >= 0) {
    vAtomicCall(c, node, name, arity, args)
    return
  }
  if (name == "ptrOf") { vPtrOfCall(c, node, args) }
  if (name == "entryOf") { vEntryOfCall(c, node, args) }
}

// ---- §11.6 inline assembly -------------------------------------------------

// An `asm` operand type (§11.6): an integer or a raw pointer — exactly what fits
// in a register.
function vIsAsmOperandType(c: Checker, ty: int): bool {
  return isIntegerOperand(c, ty) || c.ctx.types[ty].kind == TypeKind.Ptr
}

// One register-name ident against its arch's static table (§11.6). The tables are
// check.bit's, shared with lowering so the two can never disagree; -1 = unknown.
function vAsmReg(c: Checker, ident: int, isArm64: bool) {
  let name = vIdentText(c, ident)
  let arch = "x64"
  let known = asmRegX64(name) >= 0
  if (isArm64) {
    arch = "arm64"
    known = asmRegArm64(name) >= 0
  }
  if (!known) {
    reportNoHint(c.diags, ecInvalidOperand, vSpan(c, ident),
      "unknown ${arch} register '${name}'")
  }
}

function vAsmRegList(c: Checker, list: int, isArm64: bool) {
  for r of kidsOf(c.tree, list) {
    vAsmReg(c, r, isArm64)
  }
}

// One target's pre-encoded payload: an x64 line is a single byte (0..255), an
// arm64 line a 32-bit instruction word.
function vAsmCode(c: Checker, code: int, isWord: bool) {
  let limit = 255
  let what = "byte"
  if (isWord) {
    limit = 4294967295
    what = "word"
  }
  for lit of kidsOf(c.tree, code) {
    let v = parseIntText(vIdentText(c, lit))
    if (v < 0 || v > limit) {
      reportNoHint(c.diags, ecInvalidOperand, vSpan(c, lit),
        "asm ${what} literal out of range")
    }
  }
}

// E0053 (§11.6): an `asm` block's register names, payload ranges, and input
// operand types. checkAsm only INFERS the block's type; these are the rules, and
// without them a malformed block reached codegen undiagnosed.
//
// Validation is target-independent — each arch's names are checked against its
// own table regardless of which target this build selects.
function vAsm(c: Checker, node: int) {
  let k = kidsOf(c.tree, node) // [x64_code, arm64_code, result?, clob_x64, clob_arm64, input...]
  if (k[0] != 0) { vAsmCode(c, k[0], false) }
  if (k[1] != 0) { vAsmCode(c, k[1], true) }
  if (k[3] != 0) { vAsmRegList(c, k[3], false) }
  if (k[4] != 0) { vAsmRegList(c, k[4], true) }
  let i = 5
  while (i < len(k)) {
    let ik = kidsOf(c.tree, k[i]) // [arm64_reg, x64_reg, value]
    vAsmReg(c, ik[0], true)
    vAsmReg(c, ik[1], false)
    let vty = checkExprType(c, ik[2])
    if (vty != 0 && !vIsAsmOperandType(c, vty)) {
      let tn = typeName(c.ctx, vty)
      reportNoHint(c.diags, ecInvalidOperand, vSpan(c, ik[2]),
        "asm input must be an integer or pointer, found '${tn}'")
    }
    i = i + 1
  }
  if (k[2] != 0) {
    let rk = kidsOf(c.tree, k[2]) // [arm64_reg, x64_reg, type]
    vAsmReg(c, rk[0], true)
    vAsmReg(c, rk[1], false)
  }
}

// ---- §11.7 external functions ----------------------------------------------

// A C-representable type (§11.7): any prim but `string` (prim 11), or a raw
// pointer. Every other Bit type is GC-managed or carries a header the C ABI has
// no way to express.
function vIsCAbiType(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Prim) { return c.ctx.types[ty].prim != 11 }
  return k == TypeKind.Ptr
}

// E0077 (§11.7): an `extern function` binds a Bit name to a C symbol, so every
// type crossing that boundary must be C-representable. The node is
// [name, params, result_or_none].
//
// The third rule — `cannot be variadic` — became reachable when parseParam
// learned `...name: T` (#1418); before that the grammar could not express it.
function vExternFnDecl(c: Checker, node: int) {
  let k = kidsOf(c.tree, node)
  let name = vIdentText(c, k[0])
  let params = kidsOf(c.tree, k[1])
  let i = 0
  while (i < len(params)) {
    let pk = kidsOf(c.tree, params[i]) // [name, type]
    let pt = typeFromNode(c, pk[1])
    // A variadic C function (printf) needs per-call ABI classification this path
    // does not implement; a Bit `...T` would silently pass a slice header. The
    // seed reports at the whole param node and skips the C-ABI check for it.
    if (getNode(c.tree, params[i]).tag == Tag.ParamRest) {
      reportNoHint(c.diags, ecExternFnInvalid, vSpan(c, params[i]),
        "extern function '${name}' cannot be variadic")
    } else if (pt != 0 && !vIsCAbiType(c, pt)) {
      // An unresolved type (0) is bit2's inference gap, not the program's —
      // reporting it would be a false positive on code the seed accepts.
      report(c.diags, ecExternFnInvalid, vSpan(c, pk[1]),
        "extern function '${name}' parameter must be a scalar or a raw pointer",
        "the C ABI has no representation for a GC-managed Bit value")
    }
    i = i + 1
  }
  if (k[2] != 0) {
    let rt = typeFromNode(c, k[2])
    if (rt != 0 && !vIsCAbiType(c, rt)) {
      reportNoHint(c.diags, ecExternFnInvalid, vSpan(c, k[2]),
        "extern function '${name}' must return void, a scalar, or a raw pointer")
    }
  }
}

// ---- §10.3.1 function attributes -------------------------------------------

// The source text of an identifier node, read from THIS module's source.
function vIdentText(c: Checker, node: int): string {
  let n = getNode(c.tree, node)
  return c.source[n.span.start:n.span.end]
}

// A scalar value type (§10.3.1): any prim but `string` (prim 11), or a bare type
// parameter. Exactly the results a naked function can hand back in a register.
function vIsScalarValue(c: Checker, ty: int): bool {
  let k = c.ctx.types[ty].kind
  if (k == TypeKind.Prim) { return c.ctx.types[ty].prim != 11 }
  return k == TypeKind.TypeParam
}

// The attr list of a FuncDecl, or 0 when the decl carries none. The 7th child is
// elided when absent, so both kid widths are well-formed (parser.bit).
function vAttrList(c: Checker, node: int): int {
  let kids = kidsOf(c.tree, node)
  if (len(kids) <= 6) { return 0 }
  return kids[6]
}

// §11.9: a name C can actually refer to — a letter or '_', then letters, digits
// or '_'. Deliberately narrower than what ELF/Mach-O permit: a name outside this
// set assembles fine but cannot be spelled from C, which defeats the point of a
// pin, and '$' in particular is how this compiler's own mangling is written.
// Strict ASCII, so this cannot reuse the lexer's `isIdentStart` (which admits
// every byte >= 0x80 to keep non-ASCII identifiers lexing).
function vIsValidSymbolName(s: string): bool {
  if (len(s) == 0) { return false }
  let f = s[0]
  if (!((f >= 'a' && f <= 'z') || (f >= 'A' && f <= 'Z') || f == '_')) { return false }
  let i = 1
  while (i < len(s)) {
    let ch = s[i]
    if (!((ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') ||
          (ch >= '0' && ch <= '9') || ch == '_')) {
      return false
    }
    i = i + 1
  }
  return true
}

// Resolves the attr list, reporting E0076 (§10.3.1) for any name other than
// @naked/@nosplit/@symbol and E0079 (§11.9) for a malformed argument, and
// returns the pinned symbol name ("" when the decl pins none). Mirrors the
// seed's collectAttrs, which likewise reports as it resolves and yields the pin
// only once the argument has passed both rules — so a malformed pin never also
// draws the signature diagnostics below.
function vAttrNames(c: Checker, node: int): string {
  let list = vAttrList(c, node)
  if (list == 0) { return "" }
  let pin = ""
  let attrs = kidsOf(c.tree, list)
  let i = 0
  while (i < len(attrs)) {
    let ak = kidsOf(c.tree, attrs[i]) // [name_ident, arg_string_lit?]
    let nameNode = ak[0]
    let name = vIdentText(c, nameNode)
    // The argument child is ELIDED when absent, so an attr-with-no-argument
    // keeps the exact 1-kid shape it had before arguments existed (parser.bit).
    let arg = 0
    if (len(ak) > 1) { arg = ak[1] }
    if (name == "symbol") {
      if (arg == 0) {
        report(c.diags, ecSymbolAttrInvalid, vSpan(c, nameNode),
          "attribute '@symbol' requires a string argument",
          "write @symbol(\"the_exported_name\")")
      } else {
        // The raw literal minus its quotes. A symbol name has no use for
        // escapes, and every escape introduces a '\', which vIsValidSymbolName
        // rejects — so no unescaping is needed.
        let raw = vIdentText(c, arg)
        let text = raw[1:len(raw) - 1]
        if (!vIsValidSymbolName(text)) {
          report(c.diags, ecSymbolAttrInvalid, vSpan(c, arg),
            "'${text}' is not a valid symbol name",
            "a symbol name must be a C identifier: a letter or '_' followed by letters, digits or '_'")
        } else {
          pin = text
        }
      }
    } else {
      if (arg != 0) {
        reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, arg),
          "attribute '@${name}' does not take an argument")
      }
      if (name != "naked" && name != "nosplit") {
        report(c.diags, ecUnknownAttribute, vSpan(c, nameNode),
          "unknown attribute '@${name}'",
          "the recognized attributes are @naked, @nosplit and @symbol")
      }
    }
    i = i + 1
  }
  return pin
}

// E0079/E0080 (§11.9): validates a `@symbol("name")` pin and claims the name
// project-wide. A pinned function DEFINES the C symbol `name`, so its signature
// has to be one the C ABI can actually carry — the same `vIsCAbiType` §11.7
// applies in the consuming direction, since both use the one shared C-ABI
// marshaller and neither marshals anything else.
//
// The `cannot be variadic` rule became reachable when parseParam learned
// `...name: T` (#1418), for the same reason it did in vExternFnDecl.
function vPinnedSymbol(c: Checker, node: int, sym: string) {
  let k = kidsOf(c.tree, node) // [recv, name, generics, params, result, body, attrs]
  let name = vIdentText(c, k[1])
  // A generic function has no single body to give a single symbol: it is emitted
  // once per instantiation, each needing a distinct name.
  if (k[2] != 0) {
    report(c.diags, ecSymbolAttrInvalid, vSpan(c, k[1]),
      "generic function '${name}' cannot pin a symbol name",
      "each instantiation would need its own symbol")
    return
  }
  let params = kidsOf(c.tree, k[3])
  let i = 0
  while (i < len(params)) {
    let pk = kidsOf(c.tree, params[i]) // [name, type]
    let pt = typeFromNode(c, pk[1])
    // A pinned symbol is called across the C ABI, which cannot carry a Bit
    // variadic. Reported at the whole param node, and it replaces the C-ABI
    // check for that parameter — the seed's else-if.
    if (getNode(c.tree, params[i]).tag == Tag.ParamRest) {
      reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, params[i]),
        "function '${name}' pinning a symbol cannot be variadic")
    } else if (pt != 0 && !vIsCAbiType(c, pt)) {
      // An unresolved type (0) is bit2's inference gap, not the program's —
      // reporting it would be a false positive on code the seed accepts.
      report(c.diags, ecSymbolAttrInvalid, vSpan(c, pk[1]),
        "parameter of '${name}' must be a scalar or a raw pointer to pin a symbol",
        "the C ABI has no representation for a GC-managed Bit value")
    }
    i = i + 1
  }
  // The RAW result node is what is checked, so a fallible `T!E` fails this too —
  // it returns through the thread-local error slot, not the C return register,
  // and is neither a prim nor a ptr.
  if (k[4] != 0) {
    let rt = typeFromNode(c, k[4])
    if (rt != 0 && !vIsCAbiType(c, rt)) {
      reportNoHint(c.diags, ecSymbolAttrInvalid, vSpan(c, k[4]),
        "'${name}' must return void, a scalar, or a raw pointer to pin a symbol")
    }
  }
  // Claim the name. The identity packs the declaring module with the decl node:
  // node indices only mean something inside their own tree, so the module id is
  // what keeps two modules' node 7 apart. Re-registering the same decl is a
  // no-op, which is what makes a repeated `checkModule` over one tree safe.
  let owner = c.moduleId * 4294967296 + node
  let (prev, seen) = c.ctx.pinnedSymbols[sym]
  if (seen && prev != owner) {
    report(c.diags, ecDuplicateSymbol, vSpan(c, k[6]),
      "symbol '${sym}' is already pinned by another declaration",
      "each pinned symbol name must be defined exactly once")
    return
  }
  c.ctx.pinnedSymbols[sym] = owner
}

// E0074 (§10.3.1) @naked: a restricted signature (no generics or parameters,
// void or scalar result) and a return-only body — there is no prologue, so a
// local, a spill, or control flow has nowhere to live.
function vNakedFn(c: Checker, node: int, result: int) {
  let k = kidsOf(c.tree, node)
  let name = vIdentText(c, k[1])
  if (k[2] != 0) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' cannot be generic")
  }
  if (len(kidsOf(c.tree, k[3])) != 0) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' cannot take parameters")
  }
  // An unresolved result (0) is skipped: an inference gap is bit2's, not the
  // program's, and reporting it would be a false positive on code the seed takes.
  if (result != c.ctx.voidId && result != 0 && !vIsScalarValue(c, result)) {
    reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, k[1]),
      "naked function '${name}' must return void or a scalar value")
  }
  let body = kidsOf(c.tree, k[5])
  let i = 0
  while (i < len(body)) {
    if (getNode(c.tree, body[i]).tag != Tag.ReturnStmt) {
      reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, body[i]),
        "a naked function body may contain only 'return' statements")
    }
    i = i + 1
  }
}

// Matches the seed's nosplit_max_depth: a malformed or over-deep tree stops here
// rather than recursing without bound (Power of 10).
const vNosplitMaxDepth = 256

// The one-hop callee rule. A nosplit body may call only a named function that is
// itself @nosplit — Power of 10: indirection limited to what is statically known.
// A non-ident callee is a slice/map/type constructor (which allocates) or a
// value/interface/method call (unknowable statically).
function vNosplitCall(c: Checker, node: int, caller: string, depth: int) {
  let ck = kidsOf(c.tree, node) // [callee, type_args, args]
  if (getNode(c.tree, ck[0]).tag != Tag.Ident) {
    report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
      "nosplit function '${caller}' may not allocate or call indirectly here",
      "nosplit bodies allow only calls to other nosplit functions")
    return
  }
  let callee = vIdentText(c, ck[0])
  let decl = funcDeclLookup(c, callee)
  let ok = false
  if (decl != 0) {
    // A decl node index only means something inside its own tree, so the attr
    // scan must read the OWNER's source — declOwner and funcDeclLookup agree on
    // which tree that is. Reading `c` for an imported callee would slice the
    // wrong file. A user function shadowing a builtin lands here and is judged
    // on its own attribute, exactly as it is everywhere else.
    ok = funcHasAttr(declOwner(c, callee), decl, "nosplit")
  } else {
    // No declaration resolves, so this is a predeclared builtin. Of that set
    // only the atomics (§11.5) are safe here: they lower to inline machine
    // instructions rather than a call, so they can neither allocate nor reach a
    // safepoint. Every other builtin may do both and stays rejected. Without
    // this carve-out the unmanaged subset contradicts itself — a lock is
    // precisely the machinery `@nosplit` exists to protect, yet could not be
    // written with `@nosplit`.
    //
    // `entryOf` (§11.10) joins them on the same footing and on the same PROOF:
    // it lowers to one inline address materialization (FuncAddr) against a
    // link-time constant, so it can neither allocate nor reach a safepoint. The
    // scheduler's `initialContext` is nosplit-by-nature and needs exactly this
    // address to build a task's saved register state.
    //
    // `ptrOf` (§11.5) qualifies on the same proof, and the proof covers BOTH of
    // its forms — neither emits a call: on module state (§11.11) it is
    // `global_addr` plus a retype, a link-time constant address of exactly the
    // shape `entryOf` is admitted for; on a slice it is two field reads and an
    // add, both already on this allowlist in their own right. The atomics are
    // unusable inside `@nosplit` without it — they take a `*T` and `ptrOf` is
    // the only bridge to one. Widening stops at the address: the ARGUMENT is
    // still walked below, so `ptrOf` over an allocating expression stays E0075.
    //
    // `fsqrt`/`floatBits`/`float32Bits` join on the same proof, and the proof
    // is the reason rather than the convenience: each lowers to a single inline
    // machine instruction (Op.FSqrt / Op.Bitcast, never an RtCall), so like the
    // atomics it can neither allocate nor reach a safepoint. Refusing them
    // would repeat the contradiction this carve-out exists to avoid — the
    // runtime's own float helpers are nosplit-by-nature, and these primitives
    // are exactly what implements them. `ffloor`/`fceil`/`ftrunc`/`fround`
    // join on the same proof: on x86-64 they expand to a short SSE2 sequence
    // rather than one `roundsd` (SSE4.1), but an expansion still neither
    // allocates nor reaches a safepoint, which is the only property this
    // carve-out rests on.
    //
    // A builtin TYPE name in callee position is a conversion (§12.9), not a
    // call, and a NUMERIC prim conversion — including `int(p)`, a raw pointer's
    // address (§11.4) — is pure register work that allocates nothing and
    // reaches no safepoint. `string(x)` allocates and stays rejected.
    ok = vAtomicArity(callee) >= 0 || callee == "entryOf" || callee == "ptrOf" ||
      callee == "fsqrt" || callee == "floatBits" || callee == "float32Bits" ||
      callee == "ffloor" || callee == "fceil" || callee == "ftrunc" ||
      callee == "fround" ||
      vIsNumericPrimName(callee)
  }
  if (!ok) {
    report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
      "nosplit function '${caller}' calls '${callee}', which is not marked nosplit",
      "mark the callee @nosplit or inline it")
    return
  }
  vNosplitWalk(c, ck[2], caller, depth + 1) // args
}

// E0075 (§10.3.1) @nosplit: a default-deny allowlist over the body. Every
// construct that could allocate or reach a safepoint (composite/slice/map
// literals, indexing, `append`, `spawn`, closures, string interpolation, and
// channel ops) falls through to the catch-all and is rejected. An `asm` block is
// admitted on the author's assertion (§10.3.1); its operands are still walked.
function vNosplitWalk(c: Checker, node: int, caller: string, depth: int) {
  if (node == 0) { return }
  if (depth >= vNosplitMaxDepth) { return }
  let t = getNode(c.tree, node).tag
  // Safe leaves: a name or a literal reads a register or a static const.
  if (t == Tag.Ident || t == Tag.IntLit || t == Tag.FloatLit || t == Tag.StringLit ||
      t == Tag.RawStringLit || t == Tag.RuneLit || t == Tag.BoolLit ||
      t == Tag.NilLit || t == Tag.BreakStmt || t == Tag.ContinueStmt) {
    return
  }
  // Pure operators, control flow, and statement wrappers: recurse into their
  // value children (the guarded set only).
  if (t == Tag.Binary || t == Tag.Unary || t == Tag.ExprStmt || t == Tag.ReturnStmt ||
      t == Tag.Assign || t == Tag.LhsList || t == Tag.ExprList || t == Tag.Args ||
      t == Tag.Arg || t == Tag.Block || t == Tag.IfStmt || t == Tag.WhileStmt ||
      t == Tag.ForC || t == Tag.LetDecl || t == Tag.ConstDecl) {
    let kids = kidsOf(c.tree, node)
    let i = 0
    while (i < len(kids)) {
      vNosplitWalk(c, kids[i], caller, depth + 1)
      i = i + 1
    }
    return
  }
  if (t == Tag.Binding) {
    // [pattern, type_or_none, init_or_none]: only the initializer is an
    // evaluated expression; the type annotation is not code.
    let bk = kidsOf(c.tree, node)
    if (len(bk) >= 3) { vNosplitWalk(c, bk[2], caller, depth + 1) }
    return
  }
  if (t == Tag.Member) {
    // Field access on a value already in hand is safe; recurse only the base.
    vNosplitWalk(c, kidsOf(c.tree, node)[0], caller, depth + 1)
    return
  }
  if (t == Tag.Call) {
    vNosplitCall(c, node, caller, depth)
    return
  }
  if (t == Tag.AsmStmt) {
    // §10.3.1: an `asm` payload is pre-encoded machine code, opaque to every
    // compiler pass. It is admitted on the author's assertion, not on proof —
    // `asm` is already the unmanaged-subset marker (§11.6), so no second marker
    // is required. The operand expressions are ordinary Bit code the compiler
    // *can* inspect, so they stay subject to the allowlist: only the opaque
    // part is taken on trust.
    let ak = kidsOf(c.tree, node) // [x64, arm64, result?, clob_x64, clob_arm64, input...]
    let i = 5
    while (i < len(ak)) {
      vNosplitWalk(c, kidsOf(c.tree, ak[i])[2], caller, depth + 1)
      i = i + 1
    }
    return
  }
  report(c.diags, ecNosplitCallsAllocating, vSpan(c, node),
    "nosplit function '${caller}' may not allocate or reach a safepoint here",
    "nosplit bodies allow only non-allocating arithmetic, control flow, and calls to other nosplit functions")
}

// Validates one function's body. Called src `checkModule`'s sweep as it reaches
// the FuncDecl node — see this file's header for why that is the only point
// where `env` holds this function's bindings and no other's.
function vFuncDecl(c: Checker, node: int) {
  // [recv, name, generics, params, result, body(, attrs)] — the 7th child is
  // elided when the decl carries no `@attr` (parser.bit), so both widths are
  // well-formed and every kid this function reads sits at a fixed index below 6.
  let kids = kidsOf(c.tree, node)
  assert(len(kids) == 6 || len(kids) == 7)
  if (kids[5] == 0) { return }
  // The declared result, unwrapped for a fallible function: `return x` in a
  // `(): T!` produces the OK type, never the boxed `!` wrapper (§18.2).
  let result = c.ctx.voidId
  let fallible = false
  if (kids[4] != 0) {
    let declared = typeFromNode(c, kids[4])
    fallible = c.ctx.types[declared].kind == TypeKind.Fallible
    result = unwrapFallible(c, declared)
  }
  // §10.3.1/§11.9 attributes. E0076/E0079-argument first (an unknown name
  // resolves to no flag, and a malformed pin yields no name), then the three
  // rule sets. v1 attaches attributes to free functions only, so a receiver is
  // rejected outright and the body rules are skipped for a method.
  let pin = vAttrNames(c, node)
  let naked = funcHasAttr(c, node, "naked")
  let nosplit = funcHasAttr(c, node, "nosplit")
  if (kids[0] != 0) {
    if (naked) {
      reportNoHint(c.diags, ecNakedFnInvalid, vSpan(c, kids[1]),
        "naked function '${vIdentText(c, kids[1])}' cannot be a method")
    }
    if (nosplit) {
      reportNoHint(c.diags, ecNosplitCallsAllocating, vSpan(c, kids[1]),
        "nosplit function '${vIdentText(c, kids[1])}' cannot be a method")
    }
    if (pin != "") {
      report(c.diags, ecSymbolAttrInvalid, vSpan(c, kids[1]),
        "method '${vIdentText(c, kids[1])}' cannot pin a symbol name",
        "@symbol applies to free functions only")
    }
  } else {
    // The pin is validated before the body rules, mirroring the seed, where it
    // is collect-phase work and @naked/@nosplit body walks are not.
    if (pin != "") { vPinnedSymbol(c, node, pin) }
  }
  vStmt(c, result, kids[5], 0, 0, fallible)
  // v1 attaches attributes to free functions only: the seed's body-rule pass
  // reads its attribute set from the free-function table, so a method's @naked
  // is inert there (it is already rejected outright above).
  let nakedFree = naked && kids[0] == 0
  // E0055 (§10.3): a non-void function must return on every path. `result` is
  // already the unwrapped ok type; an unresolved result (0) is skipped so an
  // inference gap never becomes a spurious diagnostic. A @naked function is held
  // to the rule even when void (§10.3.1): lowering emits no implicit `ret` for
  // one, so falling off the end silently builds an object with no `ret` at all.
  if ((result != c.ctx.voidId || nakedFree) && result != 0 && !vDiverges(c, kids[5], false)) {
    reportNoHint(c.diags, ecMissingReturn, vSpan(c, kids[1]),
      "missing return: not every path returns a value")
  }
  // The seed runs the @naked/@nosplit body rules after the body walk and E0055;
  // diagnostics render in emission order, so a function tripping several of them
  // must emit them in the seed's sequence.
  if (kids[0] == 0) {
    if (naked) { vNakedFn(c, node, result) }
    if (nosplit) { vNosplitWalk(c, kids[5], vIdentText(c, kids[1]), 0) }
  }
}
